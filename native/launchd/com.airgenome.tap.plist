<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
                       "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.airgenome.tap</string>

    <key>ProgramArguments</key>
    <array>
        <string>/Applications/airgenome.app/Contents/MacOS/airgenome</string>
    </array>

    <key>RunAtLoad</key>
    <true/>

    <key>KeepAlive</key>
    <dict>
        <!-- only restart on crash, not when we kill it manually -->
        <key>SuccessfulExit</key>
        <false/>
    </dict>

    <key>ThrottleInterval</key>
    <integer>10</integer>

    <key>StandardOutPath</key>
    <string>__LOG_DIR__/airgenome.log</string>

    <key>StandardErrorPath</key>
    <string>__LOG_DIR__/airgenome.err</string>

    <key>ProcessType</key>
    <string>Interactive</string>

    <!-- raw 240 § B C4: in-process harvest/forecast/label dispatcher.
         AIRG_TAP_LOOP=1 (default 활성) → 60s/300s/3600s timer + posix_spawn 자식.
         AIRG_TAP_LOOP=0              → tap 만 동작, dispatch 비활성, 자식 spawn 0.
         단일 binary, 단일 plist (com.airgenome.tap), 단일 TCC client 정책 보존.
         7 안전망 (interval 60s 컴파일 상수, flock NB, watchdog SIGTERM→SIGKILL,
         KeepAlive=crash-only, StartInterval 미설정, ProcessType=Interactive,
         자식 fd redirect+CLOEXEC) 활성. 비활성화는 본 키 0 으로 변경 후
         `launchctl kickstart -k gui/$(id -u)/com.airgenome.tap`. -->
    <key>EnvironmentVariables</key>
    <dict>
        <key>AIRG_TAP_LOOP</key>
        <string>1</string>
        <!-- Safari 통합 wave (F45/F64/F65/F66) — default OFF (보수적).
             enable: <string>0</string> → <string>1</string> + launchctl kickstart -k.
             4 추가 timer (60s/60s/120s/60s, 모두 raw 242 7 안전망 충족). -->
        <key>AIRG_TAP_LOOP_SAFARI</key>
        <string>0</string>
    </dict>
</dict>
</plist>
