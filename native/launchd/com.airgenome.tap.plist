<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
                       "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.airgenome.tap</string>

    <key>ProgramArguments</key>
    <array>
        <string>/Applications/airgenome.app/Contents/MacOS/airgenome</string>
    </array>

    <key>RunAtLoad</key>
    <true/>

    <key>KeepAlive</key>
    <dict>
        <!-- only restart on crash, not when we kill it manually -->
        <key>SuccessfulExit</key>
        <false/>
    </dict>

    <key>ThrottleInterval</key>
    <integer>10</integer>

    <key>StandardOutPath</key>
    <string>__LOG_DIR__/airgenome.log</string>

    <key>StandardErrorPath</key>
    <string>__LOG_DIR__/airgenome.err</string>

    <key>ProcessType</key>
    <string>Interactive</string>
</dict>
</plist>
