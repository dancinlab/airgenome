<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
                       "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleName</key>
    <string>airgenome</string>
    <key>CFBundleDisplayName</key>
    <string>airgenome</string>
    <key>CFBundleIdentifier</key>
    <string>com.airgenome.tap</string>
    <key>CFBundleExecutable</key>
    <string>airgenome</string>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    <key>CFBundleVersion</key>
    <string>1.0.0</string>
    <key>CFBundleShortVersionString</key>
    <string>1.0.0</string>
    <key>LSMinimumSystemVersion</key>
    <string>11.0</string>
    <!-- LSUIElement 재 ENABLED 2026-05-01 — Dock 아이콘 제거 (menubar daemon).
         이전 2026-04-30 제거 사유는 launcher Ctrl+S NSPanel 포커스 이슈.
         재발 시 별도 해결 (e.g., NSApplicationActivationPolicyRegular 으로
         show / Accessory 으로 hide 명시 transition).
         Dock 아이콘은 .exe Finder dispatch 시에도 불필요 — application:openFile:
         delegate 는 LSUIElement=true 에서도 정상 동작. -->
    <key>LSUIElement</key>
    <true/>
    <key>CFBundleIconFile</key>
    <string>AppIcon</string>
    <key>NSHighResolutionCapable</key>
    <true/>
    <key>NSSupportsAutomaticTermination</key>
    <true/>
    <key>NSSupportsSuddenTermination</key>
    <true/>
    <key>NSAccessibilityUsageDescription</key>
    <string>airgenome listens to mouse + drag events to provide mouse-button 4/5 navigation, mouse-wheel scroll inversion, and 8-zone drag-to-edge window snapping. Native macOS tiling is temporarily disabled while running and restored on exit.</string>
    <!-- hive raw 209 launcher: env vars LaunchServices applies on `open -a`. -->
    <!-- launchctl bootstrap also reads these via LaunchAgent plist override. -->
    <key>LSEnvironment</key>
    <dict>
        <key>AIRG_TAP_LAUNCHER</key>
        <string>1</string>
        <key>AIRG_TAP_LAUNCHER_HOTKEY</key>
        <string>ctrl+s</string>
    </dict>

    <!-- .exe Finder dispatch — 단일 bundle, 별도 helper app 0.
         Finder 가 .exe 더블클릭 시 LaunchServices 가 com.airgenome.tap 선택,
         이미 실행 중인 instance 의 application:openFile: 으로 path 전달.
         airgenome_tap.m 의 AirgenomeExeHandlerDelegate 가 처리. -->
    <key>CFBundleDocumentTypes</key>
    <array>
        <dict>
            <key>CFBundleTypeName</key>
            <string>Windows Executable</string>
            <key>CFBundleTypeRole</key>
            <string>Viewer</string>
            <key>LSHandlerRank</key>
            <string>Owner</string>
            <key>LSItemContentTypes</key>
            <array>
                <string>com.microsoft.windows-executable</string>
            </array>
            <key>CFBundleTypeExtensions</key>
            <array>
                <string>exe</string>
            </array>
        </dict>
    </array>
</dict>
</plist>
