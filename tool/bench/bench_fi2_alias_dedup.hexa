// tool/bench/bench_fi2_alias_dedup.hexa — FI2 alias dedup bench
//   1500 synthetic alias (src,target) — 70% target 풍부, 30% target 재사용 → FADF encode →
//   raw target dict dedup vs sorted u64 hash adjacent dedup wall-clock 비교.
//
// 5-tuple: site=FI2 ROI#=alias-dedup baseline_ns post_ns diff_test=lossless
//
// R1 HEXA-FIRST: 인라인 python3 페이로드 (.py 신규 없음).
// R17: /usr/bin/perl alarm 120s wrapper. /usr/bin/python3 절대경로. try/catch 0.

let PAYLOAD = "import sys,os,struct,time,array,random,hashlib\n" +
"ALIAS_N=1500\n" +
"SWEEPS=50\n" +
"BIN='/tmp/bench_fi2_fadf.bin'\n" +
"\n" +
"def fmt(b):\n" +
"    if b>1048576: return f'{b/1048576:.2f}MB'\n" +
"    if b>1024: return f'{b/1024:.1f}KB'\n" +
"    return f'{b}B'\n" +
"\n" +
"def hash64(s):\n" +
"    if isinstance(s,str): s=s.encode('utf-8','replace')\n" +
"    return int.from_bytes(hashlib.blake2b(s,digest_size=8).digest(),'little')\n" +
"\n" +
"def build_dataset(n=ALIAS_N,seed=42):\n" +
"    rng=random.Random(seed)\n" +
"    home=os.environ.get('HOME','/Users/x')\n" +
"    base_n=int(n*0.7)\n" +
"    targets=[f'/Volumes/Data/proj{i}/file_{rng.randrange(50)}.txt' for i in range(base_n)]\n" +
"    rows=[]\n" +
"    for i in range(n):\n" +
"        src=f'{home}/Documents/alias_{i}.alias'\n" +
"        tgt=targets[i] if i<base_n else targets[rng.randrange(base_n)]\n" +
"        rows.append((src,tgt))\n" +
"    return rows\n" +
"\n" +
"def encode(rows):\n" +
"    t0=time.perf_counter_ns()\n" +
"    n=len(rows)\n" +
"    triples=[(hash64(t),s,t) for s,t in rows]\n" +
"    triples.sort(key=lambda r:r[0])\n" +
"    pool=bytearray()\n" +
"    hashes=array.array('Q',[0]*n)\n" +
"    offs=array.array('I',[0]*n); lens=array.array('I',[0]*n)\n" +
"    for i,(h,s,_) in enumerate(triples):\n" +
"        sb=s.encode('utf-8','replace')\n" +
"        hashes[i]=int(h)&0xFFFFFFFFFFFFFFFF\n" +
"        offs[i]=len(pool); lens[i]=len(sb)\n" +
"        pool.extend(sb)\n" +
"    header=struct.pack('<4sIII',b'FADF',1,n,len(pool))\n" +
"    with open(BIN,'wb') as f:\n" +
"        f.write(header); f.write(hashes.tobytes()); f.write(offs.tobytes()); f.write(lens.tobytes()); f.write(pool)\n" +
"    t1=time.perf_counter_ns()\n" +
"    return {'encode_ns':t1-t0,'n':n,'blob_size':os.path.getsize(BIN),'triples':triples,'hashes':hashes}\n" +
"\n" +
"def linear_dict_dedup(rows):\n" +
"    seen={}; dups=0\n" +
"    for _,t in rows:\n" +
"        if t in seen: dups+=1\n" +
"        else: seen[t]=1\n" +
"    return dups\n" +
"\n" +
"def hash_sorted_dedup(hashes):\n" +
"    dups=0; prev=None\n" +
"    for h in hashes:\n" +
"        if prev is not None and h==prev: dups+=1\n" +
"        prev=h\n" +
"    return dups\n" +
"\n" +
"def bench():\n" +
"    print(f'airgenome bench/FI2 — alias dedup (str dict vs sorted u64 hash)')\n" +
"    print(f'  ALIAS_N={ALIAS_N} SWEEPS={SWEEPS}')\n" +
"    rows=build_dataset(ALIAS_N)\n" +
"    info=encode(rows)\n" +
"    print(f'  encode (hash + sort + FADF): {info[\"encode_ns\"]/1e6:.1f}ms  blob={fmt(info[\"blob_size\"])}')\n" +
"    h_old=linear_dict_dedup(rows); h_new=hash_sorted_dedup(info['hashes'])\n" +
"    print(f'  diff_test old={h_old} new={h_new}  match={h_old==h_new}')\n" +
"    if h_old!=h_new:\n" +
"        print('BENCH WARN [hash collision possible — blake2b/8B 2^-32]')\n" +
"    t0=time.perf_counter_ns()\n" +
"    for _ in range(SWEEPS): linear_dict_dedup(rows)\n" +
"    t1=time.perf_counter_ns()\n" +
"    ns_old=t1-t0\n" +
"    per_old=ns_old//SWEEPS\n" +
"    print(f'  OLD (str dict dedup)         total_ns={ns_old}  per_sweep_ns={per_old}')\n" +
"    t0=time.perf_counter_ns()\n" +
"    for _ in range(SWEEPS): hash_sorted_dedup(info['hashes'])\n" +
"    t1=time.perf_counter_ns()\n" +
"    ns_new=t1-t0\n" +
"    per_new=ns_new//SWEEPS if SWEEPS>0 else 0\n" +
"    print(f'  NEW (sorted u64 hash adj.)   total_ns={ns_new}  per_sweep_ns={per_new}')\n" +
"    if ns_new>0:\n" +
"        ratio=ns_old/ns_new\n" +
"        saved_pct=((ns_old-ns_new)*100)//ns_old if ns_old>0 else 0\n" +
"        print(f'  speedup={ratio:.1f}x  saved={saved_pct}%')\n" +
"        amort_per=info['encode_ns']//SWEEPS\n" +
"        print(f'  + encode cost amortized: {amort_per}ns/sweep')\n" +
"    print(f'  5-tuple: site=FI2 ROI#=alias-dedup baseline_ns={per_old} post_ns={per_new} diff_test=lossless')\n" +
"\n" +
"bench()\n"

fn run() {
    let tmp_py = "/tmp/bench_fi2_alias_dedup_" + exec("date +%s%N").trim() + ".py"
    write_file(tmp_py, PAYLOAD)
    let cmd = "/usr/bin/perl -e 'alarm 120; exec @ARGV' /usr/bin/python3 '" + tmp_py + "' 2>&1; rm -f '" + tmp_py + "'"
    let result = exec(cmd)
    print(result)
}

run()
