// tool/bench/bench_ix3_recent_documents_global.hexa — IX3 RDGL bench
//   raw 240 V2 V4-cand (400/400). 합성 dataset 결정성 + real-probe optional.
//
// 모드:
//   bench (default) — N synth (app,path,mtime) 생성 → RDGL encode
//                     → groupby + prefix + recent linear vs RDGL u8/bisect.
//   real            — real ~/Library/Application Support/com.apple.sharedfilelist 추가 probe.
//
// 5-tuple: site=IX3 ROI#=IX3_RDGL baseline_ns post_ns diff_test=lossless
//
// R1 HEXA-FIRST: 인라인 python3 페이로드 (.py 신규 없음).
// R17: /usr/bin/perl alarm 120s wrapper. /usr/bin/python3 절대경로. try/catch 0.

let PAYLOAD = "import sys,os,struct,time,bisect,array,random,glob,re,json,plistlib\n" +
"mode=sys.argv[1] if len(sys.argv)>1 else 'bench'\n" +
"BIN='/tmp/bench_ix3_rdgl.bin'\n" +
"N=4000\n" +
"\n" +
"def fmt(b):\n" +
"    if b>1048576: return f'{b/1048576:.2f}MB'\n" +
"    if b>1024: return f'{b/1024:.1f}KB'\n" +
"    return f'{b}B'\n" +
"\n" +
"APPS=['com.apple.dt.xcode','com.apple.Safari','com.apple.TextEdit','com.apple.Terminal','com.apple.Preview','com.microsoft.VSCode','app.soulver.appstore.mac','com.apple.dt.Instruments','com.apple.iWork.Pages','com.apple.iWork.Keynote']\n" +
"ROOTS=['/Users/ghost/Documents/','/Users/ghost/Downloads/','/Users/ghost/src/','/Applications/','/Library/']\n" +
"\n" +
"def synth(n,seed=7):\n" +
"    rng=random.Random(seed)\n" +
"    rows=[]; ts0=int(time.time())\n" +
"    for i in range(n):\n" +
"        a=APPS[rng.randrange(len(APPS))]\n" +
"        r=ROOTS[rng.randrange(len(ROOTS))]\n" +
"        rows.append((a,f'{r}item_{i:05d}.txt',ts0-rng.randrange(0,86400*60)))\n" +
"    return rows\n" +
"\n" +
"def encode_blob(rows):\n" +
"    t0=time.perf_counter_ns()\n" +
"    counts={}\n" +
"    for a,_,_ in rows: counts[a]=counts.get(a,0)+1\n" +
"    top=[k for k,_ in sorted(counts.items(),key=lambda kv:(-kv[1],kv[0]))[:255]]\n" +
"    apps_sorted=sorted(top)\n" +
"    app_idx={a:i for i,a in enumerate(apps_sorted)}\n" +
"    n_app=len(apps_sorted)\n" +
"    seen=set(); rows2=[]\n" +
"    for a,s,mt in rows:\n" +
"        if (a,s) in seen: continue\n" +
"        seen.add((a,s)); rows2.append((a,s,mt))\n" +
"    n=len(rows2)\n" +
"    app_pool=bytearray(); app_offs=array.array('I',[0]*n_app); app_lens=array.array('H',[0]*n_app)\n" +
"    for i,a in enumerate(apps_sorted):\n" +
"        ab=a.encode('utf-8','replace')\n" +
"        app_offs[i]=len(app_pool); app_lens[i]=len(ab); app_pool.extend(ab)\n" +
"    rows2.sort(key=lambda r:r[1])\n" +
"    idx_col=bytearray(n)\n" +
"    path_offs=array.array('I',[0]*n); path_lens=array.array('H',[0]*n)\n" +
"    mtime_col=array.array('I',[0]*n)\n" +
"    path_pool=bytearray()\n" +
"    for i,(a,s,mt) in enumerate(rows2):\n" +
"        idx_col[i]=app_idx.get(a,255)\n" +
"        sb=s.encode('utf-8','replace'); path_offs[i]=len(path_pool); path_lens[i]=len(sb); path_pool.extend(sb)\n" +
"        mtime_col[i]=mt & 0xffffffff\n" +
"    out=bytearray(); out.extend(b'RDGL')\n" +
"    out.extend(struct.pack('<IIIII',1,n_app,n,len(app_pool),len(path_pool)))\n" +
"    out.extend(app_offs.tobytes()); out.extend(app_lens.tobytes())\n" +
"    out.extend(app_pool)\n" +
"    out.extend(idx_col)\n" +
"    out.extend(path_offs.tobytes()); out.extend(path_lens.tobytes())\n" +
"    out.extend(mtime_col.tobytes())\n" +
"    out.extend(path_pool)\n" +
"    out.extend(struct.pack('<Q',0xcbf29ce484222325))\n" +
"    with open(BIN,'wb') as f: f.write(bytes(out))\n" +
"    t1=time.perf_counter_ns()\n" +
"    return {'n':n,'n_app':n_app,'blob_size':len(out),'encode_ns':t1-t0}\n" +
"\n" +
"def linear_groupby_app(rows):\n" +
"    g={}\n" +
"    for a,_,_ in rows: g[a]=g.get(a,0)+1\n" +
"    return g\n" +
"def linear_count_prefix(rows,prefix): return sum(1 for _,s,_ in rows if s.startswith(prefix))\n" +
"def linear_count_recent(rows,since):  return sum(1 for _,_,mt in rows if mt>=since)\n" +
"\n" +
"def blob_load():\n" +
"    with open(BIN,'rb') as f: blob=f.read()\n" +
"    assert blob[:4]==b'RDGL'\n" +
"    ver,n_app,n,app_sz,path_sz=struct.unpack_from('<IIIII',blob,4)\n" +
"    p=4+5*4\n" +
"    ao=array.array('I'); ao.frombytes(blob[p:p+n_app*4]); p+=n_app*4\n" +
"    al=array.array('H'); al.frombytes(blob[p:p+n_app*2]); p+=n_app*2\n" +
"    ap=blob[p:p+app_sz]; p+=app_sz\n" +
"    ic=blob[p:p+n]; p+=n\n" +
"    po=array.array('I'); po.frombytes(blob[p:p+n*4]); p+=n*4\n" +
"    pl=array.array('H'); pl.frombytes(blob[p:p+n*2]); p+=n*2\n" +
"    mc=array.array('I'); mc.frombytes(blob[p:p+n*4]); p+=n*4\n" +
"    pp=blob[p:p+path_sz]\n" +
"    return (ao,al,ap,ic,po,pl,mc,pp,n,n_app)\n" +
"\n" +
"def blob_groupby_app():\n" +
"    ao,al,ap,ic,po,pl,mc,pp,n,na=blob_load()\n" +
"    counts=[0]*256\n" +
"    for b in ic: counts[b]+=1\n" +
"    out={}\n" +
"    for i in range(na):\n" +
"        a=bytes(ap[ao[i]:ao[i]+al[i]]).decode('utf-8','replace')\n" +
"        out[a]=counts[i]\n" +
"    return out\n" +
"\n" +
"def blob_count_prefix(prefix):\n" +
"    ao,al,ap,ic,po,pl,mc,pp,n,na=blob_load()\n" +
"    pb=prefix.encode('utf-8','replace')\n" +
"    lo,hi=0,n\n" +
"    while lo<hi:\n" +
"        mid=(lo+hi)//2\n" +
"        s=bytes(pp[po[mid]:po[mid]+pl[mid]])\n" +
"        if s<pb: lo=mid+1\n" +
"        else: hi=mid\n" +
"    cnt=0; i=lo\n" +
"    while i<n:\n" +
"        s=bytes(pp[po[i]:po[i]+pl[i]])\n" +
"        if not s.startswith(pb): break\n" +
"        cnt+=1; i+=1\n" +
"    return cnt\n" +
"\n" +
"def blob_count_recent(since):\n" +
"    ao,al,ap,ic,po,pl,mc,pp,n,na=blob_load()\n" +
"    return sum(1 for v in mc if v>=since)\n" +
"\n" +
"P=['/Users/','/Applications/','/Library/','/Volumes/','/System/']\n" +
"\n" +
"def bench_synth():\n" +
"    rows=synth(N)\n" +
"    info=encode_blob(rows)\n" +
"    print(f'[encode] n_path={info[\"n\"]} n_app={info[\"n_app\"]} blob={fmt(info[\"blob_size\"])} encode={info[\"encode_ns\"]/1e6:.1f}ms')\n" +
"    since=int(time.time())-86400*7\n" +
"    # dedup rows for fair compare with blob\n" +
"    seen=set(); urows=[]\n" +
"    for a,s,mt in rows:\n" +
"        if (a,s) in seen: continue\n" +
"        seen.add((a,s)); urows.append((a,s,mt))\n" +
"    t0=time.perf_counter_ns()\n" +
"    base=0\n" +
"    g=linear_groupby_app(urows); base+=sum(g.values())\n" +
"    for q in P: base+=linear_count_prefix(urows,q)\n" +
"    base+=linear_count_recent(urows,since)\n" +
"    t1=time.perf_counter_ns()\n" +
"    base_ns=t1-t0\n" +
"    t2=time.perf_counter_ns()\n" +
"    post=0\n" +
"    g2=blob_groupby_app(); post+=sum(g2.values())\n" +
"    for q in P: post+=blob_count_prefix(q)\n" +
"    post+=blob_count_recent(since)\n" +
"    t3=time.perf_counter_ns()\n" +
"    post_ns=t3-t2\n" +
"    diff='lossless' if base==post else f'mismatch base={base} post={post}'\n" +
"    sp=base_ns/max(post_ns,1)\n" +
"    print(f'[bench synth] N={len(urows)} groupby+{len(P)}prefix+recent7d')\n" +
"    print(f'  baseline (linear)        : {base_ns/1000:10.1f} us  hits={base}')\n" +
"    print(f'  RDGL (u8 col + bisect)   : {post_ns/1000:10.1f} us  hits={post}')\n" +
"    print(f'  speedup                  : {sp:6.1f}x')\n" +
"    row={'site':'IX3','roi':'IX3_RDGL_synth','baseline_ns':base_ns,'post_ns':post_ns,'diff_test':diff,'speedup_x':round(sp,2),'n':len(urows)}\n" +
"    print('[5tuple] '+json.dumps(row,ensure_ascii=False))\n" +
"    return base==post\n" +
"\n" +
"PATH_RE=re.compile(rb'(?:/Users/|/Applications/|/Volumes/|/System/|/Library/|/opt/|/usr/local/)[\\w\\-./ ]{2,300}')\n" +
"\n" +
"def real_probe():\n" +
"    root=os.path.expanduser('~/Library/Application Support/com.apple.sharedfilelist')\n" +
"    if not os.path.isdir(root):\n" +
"        print('[real] sharedfilelist dir absent; skip'); return True\n" +
"    sources=[]\n" +
"    for nm in ('com.apple.LSSharedFileList.RecentDocuments.sfl4','com.apple.LSSharedFileList.RecentApplications.sfl4','com.apple.LSSharedFileList.iCloudItems.sfl4'):\n" +
"        p=os.path.join(root,nm)\n" +
"        if os.path.isfile(p): sources.append(('macOS',p))\n" +
"    sub=os.path.join(root,'ApplicationRecentDocuments')\n" +
"    if os.path.isdir(sub):\n" +
"        for ext in ('*.sfl3','*.sfl4'):\n" +
"            for p in glob.glob(os.path.join(sub,ext)):\n" +
"                bn=os.path.basename(p)\n" +
"                app=bn[:-5] if (bn.endswith('.sfl3') or bn.endswith('.sfl4')) else bn\n" +
"                sources.append((app,p))\n" +
"    if not sources:\n" +
"        print('[real] no sources; skip'); return True\n" +
"    rows=[]; seen=set()\n" +
"    for app,p in sources:\n" +
"        try:\n" +
"            with open(p,'rb') as f: data=f.read()\n" +
"        except Exception: continue\n" +
"        try:\n" +
"            d=plistlib.loads(data); objs=d.get('$objects',[]) if isinstance(d,dict) else []\n" +
"        except Exception: objs=[]\n" +
"        try: mt=int(os.path.getmtime(p))\n" +
"        except Exception: mt=0\n" +
"        if objs and isinstance(objs,list):\n" +
"            for entry in objs:\n" +
"                if isinstance(entry,(bytes,bytearray)):\n" +
"                    for m in PATH_RE.finditer(bytes(entry)):\n" +
"                        s=m.group(0).decode('utf-8','replace')\n" +
"                        k=(app,s)\n" +
"                        if k in seen: continue\n" +
"                        seen.add(k); rows.append((app,s,mt))\n" +
"                elif isinstance(entry,str):\n" +
"                    for m in PATH_RE.finditer(entry.encode('utf-8','replace')):\n" +
"                        s=m.group(0).decode('utf-8','replace')\n" +
"                        k=(app,s)\n" +
"                        if k in seen: continue\n" +
"                        seen.add(k); rows.append((app,s,mt))\n" +
"        else:\n" +
"            for m in PATH_RE.finditer(data):\n" +
"                s=m.group(0).decode('utf-8','replace')\n" +
"                k=(app,s)\n" +
"                if k in seen: continue\n" +
"                seen.add(k); rows.append((app,s,mt))\n" +
"    if not rows:\n" +
"        print(f'[real] {len(sources)} sources but 0 paths extracted; skip'); return True\n" +
"    info=encode_blob(rows)\n" +
"    print(f'[real encode] n_path={info[\"n\"]} n_app={info[\"n_app\"]} blob={fmt(info[\"blob_size\"])} sources={len(sources)}')\n" +
"    since=int(time.time())-86400*7\n" +
"    t0=time.perf_counter_ns()\n" +
"    base=sum(linear_groupby_app(rows).values())+sum(linear_count_prefix(rows,q) for q in P)+linear_count_recent(rows,since)\n" +
"    t1=time.perf_counter_ns()\n" +
"    t2=time.perf_counter_ns()\n" +
"    post=sum(blob_groupby_app().values())+sum(blob_count_prefix(q) for q in P)+blob_count_recent(since)\n" +
"    t3=time.perf_counter_ns()\n" +
"    diff='lossless' if base==post else f'mismatch base={base} post={post}'\n" +
"    sp=(t1-t0)/max(t3-t2,1)\n" +
"    print(f'[real bench] base={(t1-t0)/1000:.1f}us hits={base}  post={(t3-t2)/1000:.1f}us hits={post}  speedup={sp:.1f}x')\n" +
"    row={'site':'IX3','roi':'IX3_RDGL_real','baseline_ns':t1-t0,'post_ns':t3-t2,'diff_test':diff,'speedup_x':round(sp,2),'n':len(rows)}\n" +
"    print('[5tuple] '+json.dumps(row,ensure_ascii=False))\n" +
"    return base==post\n" +
"\n" +
"if mode=='real':\n" +
"    ok1=bench_synth(); ok2=real_probe()\n" +
"    print(f'[result] synth={ok1} real={ok2}')\n" +
"    sys.exit(0 if (ok1 and ok2) else 1)\n" +
"else:\n" +
"    ok=bench_synth()\n" +
"    sys.exit(0 if ok else 1)\n"

fn run() {
    let argv = args()
    let mut mode = "bench"
    let mut i = 0
    while i < len(argv) {
        let v = argv[i]
        let is_hexa_bin = v.contains("/hexa-lang/") || v == "hexa" || v == "hexa.real"
        let is_self     = v.contains("bench_ix3_recent_documents_global")
        if is_hexa_bin == false && is_self == false {
            if v == "real" || v == "bench" { mode = v }
        }
        i = i + 1
    }
    let tmp_py = "/tmp/bench_ix3_recent_documents_global_" + exec("date +%s%N").trim() + ".py"
    write_file(tmp_py, PAYLOAD)
    let cmd = "/usr/bin/perl -e 'alarm 120; exec @ARGV' /usr/bin/python3 '" + tmp_py + "' '" + mode + "' 2>&1; rm -f '" + tmp_py + "'"
    let result = exec(cmd)
    print(result)
}

run()
