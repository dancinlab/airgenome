// tool/bench/bench_site8.hexa — own 6 site-8 baseline (forecast append_out per-prediction exec vs batch)
//
// forecast/module/forecast.hexa#append_out 는 per-prediction exec("printf '%s\n' LINE >> OUT") 호출.
// run_forecast 의 keys 루프에서 prediction 마다 append_out 호출 (~30 fork/cycle TOP_N_PIDS=30).
// 직접 적용: keys 루프 안에서 buffer 누적 → 루프 종료 후 1회 append_file (0 fork).
// own 5 site-3 (harvest append_ring) 의 검증된 패턴 직접 이식.

use "../../airgenome/core/airgenome"

let BENCH_FILE_OLD = "/tmp/airgenome_bench_site8_old.jsonl"
let BENCH_FILE_NEW = "/tmp/airgenome_bench_site8_new.jsonl"
let LINES_PER_RUN = 30  // run_forecast TOP_N_PIDS = 30 prediction lines/cycle
let K = 5

fn now_ns() -> str {
    return exec("gdate +%s%N").trim()
}

fn ns_diff(t0: str, t1: str) -> int {
    return to_int(t1) - to_int(t0)
}

fn make_pred_line(n: int) -> str {
    return "{\"ts\":\"2026-04-30T00:00:00Z\",\"pid\":\"" + to_string(1000 + n) + "\",\"host\":\"mac\",\"horizon\":\"1step\",\"pred_cpu\":" + to_string(n) + ",\"pred_ram\":" + to_string(n) + ",\"samples\":8}"
}

// OLD: per-prediction exec(printf >>) — forecast/module/forecast.hexa#append_out L220-222
fn old_append_out(path: str, line: str) -> void {
    let _ = exec("printf '%s\\n' '" + line + "' >> '" + path + "'")
}

// NEW: buffer build + single append_file
fn new_append_batch(path: str, lines: list) -> void {
    let mut buf = ""
    let mut i = 0
    while i < len(lines) {
        buf = buf + lines[i] + "\n"
        i = i + 1
    }
    if buf != "" {
        append_file(path, buf)
    }
}

fn run_old() -> void {
    let _rm = exec("rm -f '" + BENCH_FILE_OLD + "'")
    let mut k = 0
    while k < K {
        let mut n = 0
        while n < LINES_PER_RUN {
            old_append_out(BENCH_FILE_OLD, make_pred_line(n))
            n = n + 1
        }
        k = k + 1
    }
}

fn run_new() -> void {
    let _rm = exec("rm -f '" + BENCH_FILE_NEW + "'")
    let mut k = 0
    while k < K {
        let mut lines = []
        let mut n = 0
        while n < LINES_PER_RUN {
            lines = lines + [make_pred_line(n)]
            n = n + 1
        }
        new_append_batch(BENCH_FILE_NEW, lines)
        k = k + 1
    }
}

fn diff_test() -> int {
    let cmp = exec("cmp -s '" + BENCH_FILE_OLD + "' '" + BENCH_FILE_NEW + "' && echo OK || echo DIFF").trim()
    if cmp == "OK" { return 0 }
    return 1
}

fn main() -> void {
    println("airgenome bench/site-8 — forecast append_out (per-prediction exec vs batch)")
    println("  files=[" + BENCH_FILE_OLD + ", " + BENCH_FILE_NEW + "]  LINES_PER_RUN=" + to_string(LINES_PER_RUN) + "  K=" + to_string(K))

    let t0_old = now_ns()
    run_old()
    let t1_old = now_ns()
    let ns_old = ns_diff(t0_old, t1_old)
    let writes_old = K * LINES_PER_RUN
    println("  OLD (per-pred exec)     total_ns=" + to_string(ns_old) + "  per_call_ns=" + to_string(ns_old / writes_old) + "  forks=" + to_string(writes_old))

    let t0_new = now_ns()
    run_new()
    let t1_new = now_ns()
    let ns_new = ns_diff(t0_new, t1_new)
    let writes_new = K
    println("  NEW (append_file batch) total_ns=" + to_string(ns_new) + "  per_batch_ns=" + to_string(ns_new / writes_new) + "  per_line_ns=" + to_string(ns_new / writes_old) + "  forks=0")

    let mm = diff_test()
    println("  diff_test (cmp -s files): " + to_string(mm))
    if mm != 0 { panic("BENCH FAIL [byte-level diff between OLD and NEW output]") }

    if ns_new > 0 {
        let ratio = ns_old / ns_new
        let saved_pct = ((ns_old - ns_new) * 100) / ns_old
        println("  speedup=" + to_string(ratio) + "x  saved=" + to_string(saved_pct) + "%")
    }
}
