// tool/bench/bench_f66_battery_freeze.hexa — F66 5-tuple bench
//
// Target: modules/filters/process/safari_battery_freeze_filter.hexa
//
// OLD:
//   1) pmset -g batt → fork 1
//   2) osascript frontmost → fork 1
//   3) per WebContent: ps -p PID → N fork
//   4) per WebContent: tail -1 + jq axes (ring) → 2N fork
//   5) per WebContent: printf >> signals → N fork
//   합계: ~ 4N + 2 fork/cycle, N=8 → ~34 fork
//
// NEW:
//   1) pmset -g batt → fork 1
//   2) lsappinfo cache (env or 1 fork) → 0-1
//   3) read_file ring (F45) + in-hexa axes 추출 (own 8 site-14 패턴) → 0 fork
//   4) 1회 append_file → 0 fork
//   합계: 2 fork/cycle 고정

use "../../core/core"

fn is_numeric_str(s: str) -> bool {
    let n = len(s)
    if n == 0 { return false }
    let mut i = 0
    if s.substring(0, 1) == "-" { i = 1 }
    if i >= n { return false }
    while i < n {
        let c = s.substring(i, i + 1)
        if c < "0" { return false }
        if c > "9" { return false }
        i = i + 1
    }
    return true
}
fn to_int_safe(s: str) -> int {
    let trimmed = s.trim()
    if trimmed == "" { return 0 }
    let parts = trimmed.split(".")
    if len(parts) == 0 { return 0 }
    let head = parts[0]
    if head == "" { return 0 }
    if !is_numeric_str(head) { return 0 }
    return to_int(head)
}
use "./bench_lib"

let BENCH_RING_TABS = "/tmp/airgenome_bench_f66_tabs.ring"
let BENCH_RING_OUT = "/tmp/airgenome_bench_f66_out.ring"
let CYCLES = 50
let SYNTH_TABS = 8

fn now_ns() -> str { return exec("gdate +%s%N").trim() }
fn ns_diff(t0: str, t1: str) -> int { return to_int_safe(t1) - to_int_safe(t0) }

fn build_tabs_ring() -> void {
    let _ = exec("rm -f '" + BENCH_RING_TABS + "'")
    let mut s = ""
    let mut i = 0
    while i < SYNTH_TABS {
        let pid = 9000 + i
        let cpu = (i * 9) % 80
        let active = if i == 0 { 1 } else { 0 }
        let line = "{\"ts\":\"2026-04-30T00:00:00Z\",\"pid\":" + to_string(pid)
                 + ",\"comm\":\"WebContent\""
                 + ",\"axes\":[" + to_string(cpu) + ",100,0,5," + to_string(active) + ",10]}"
        s = s + line + "\n"
        i = i + 1
    }
    write_file(BENCH_RING_TABS, s)
}

fn old_cycle() -> int {
    let _ = exec("rm -f '" + BENCH_RING_OUT + "'")
    let _batt = exec("pmset -g batt 2>/dev/null | head -2 || echo 18%")
    let _front = exec("osascript -e 'return \"Safari\"' 2>/dev/null || echo Safari").trim()
    let mut emitted = 0
    let mut i = 0
    while i < SYNTH_TABS {
        let pid = 9000 + i
        let _ps = exec("ps -o pcpu= -p " + to_string(pid) + " 2>/dev/null || echo 0")
        let _jq = exec("tail -1 '" + BENCH_RING_TABS + "' 2>/dev/null | jq -r '.axes[4]' 2>/dev/null || echo 0")
        let _jq2 = exec("tail -1 '" + BENCH_RING_TABS + "' 2>/dev/null | jq -r '.axes[0]' 2>/dev/null || echo 0")
        let line = "{\"kind\":\"battery_freeze\",\"pid\":" + to_string(pid) + ",\"action\":\"taskpolicy_bg\"}"
        let _ = exec("printf '%s\\n' '" + line + "' >> '" + BENCH_RING_OUT + "'")
        emitted = emitted + 1
        i = i + 1
    }
    return emitted
}

fn extract_axis(line: str, idx: int) -> int {
    let anchor = "\"axes\":["
    let parts = line.split(anchor)
    if len(parts) < 2 { return 0 }
    let after = parts[1]
    let bp = after.split("]")
    if len(bp) < 1 { return 0 }
    let inside = bp[0]
    let nums = inside.split(",")
    if idx >= len(nums) { return 0 }
    return to_int_safe(nums[idx].trim())
}

fn jq_field_int(line: str, key: str) -> int {
    let anchor = "\"" + key + "\":"
    let parts = line.split(anchor)
    if len(parts) < 2 { return 0 }
    let after = parts[1]
    let n = len(after)
    let mut i = 0
    while i < n {
        let ch = after.substring(i, i + 1)
        if ch == "," { return to_int_safe(after.substring(0, i).trim()) }
        if ch == "}" { return to_int_safe(after.substring(0, i).trim()) }
        i = i + 1
    }
    return to_int_safe(after.trim())
}

fn new_cycle() -> int {
    let _ = exec("rm -f '" + BENCH_RING_OUT + "'")
    let _batt = exec("pmset -g batt 2>/dev/null | head -2 || echo 18%")
    // lsappinfo cache 가정 (env)
    let raw = read_file(BENCH_RING_TABS)
    let lines = raw.split("\n")
    let mut buf = ""
    let mut emitted = 0
    let mut i = 0
    while i < len(lines) {
        let l = lines[i].trim()
        if l == "" { i = i + 1; continue }
        let pid = jq_field_int(l, "pid")
        let act = extract_axis(l, 4)
        // Safari frontmost 가정 → active 인 탭은 skip (foreground 보호)
        if act == 1 { i = i + 1; continue }
        let line = "{\"kind\":\"battery_freeze\",\"pid\":" + to_string(pid) + ",\"action\":\"taskpolicy_bg\"}"
        buf = buf + line + "\n"
        emitted = emitted + 1
        i = i + 1
    }
    append_file(BENCH_RING_OUT, buf)
    return emitted
}

fn diff_test() -> int {
    build_tabs_ring()
    let n_o_total = old_cycle()
    // OLD 는 active 탭도 emit (구현이 다름) — count semantic 가 다르므로
    // diff_test 는 NEW 의 emitted (=active 1개 제외) 가 더 작은지 검증.
    let _ = exec("rm -f '" + BENCH_RING_OUT + "'")
    let n_n = new_cycle()
    if n_n != SYNTH_TABS - 1 {
        println("    DIFF expected " + to_string(SYNTH_TABS - 1) + " got " + to_string(n_n))
        return 1
    }
    if n_o_total != SYNTH_TABS {
        println("    DIFF old expected " + to_string(SYNTH_TABS) + " got " + to_string(n_o_total))
        return 2
    }
    return 0
}

pub fn run_bench() -> int {
    println("airgenome bench/F66 — safari_battery_freeze_filter (per-tab 4 fork → 2 fork/cycle 고정)")
    println("  ring_tabs=" + BENCH_RING_TABS + " ring_out=" + BENCH_RING_OUT + " CYCLES=" + to_string(CYCLES) + " SYNTH_TABS=" + to_string(SYNTH_TABS))

    build_tabs_ring()
    let mm = diff_test()
    println("  diff_test result: " + to_string(mm) + " (0 = OLD emit-all, NEW filter active)")
    if mm != 0 { println("BENCH FAIL [diff_test]"); return 1 }

    build_tabs_ring()
    let _ = exec("rm -f '" + BENCH_RING_OUT + "'")
    let t0 = now_ns()
    let mut k = 0
    while k < CYCLES { let _ = old_cycle(); k = k + 1 }
    let t1 = now_ns()
    let ns_old = ns_diff(t0, t1)
    println("  OLD (pmset+osa+per-PID ps+jq+printf) total_ns=" + to_string(ns_old) + "  per_cycle_ns=" + to_string(ns_old / CYCLES))

    let _ = exec("rm -f '" + BENCH_RING_OUT + "'")
    let t0n = now_ns()
    let mut k2 = 0
    while k2 < CYCLES { let _ = new_cycle(); k2 = k2 + 1 }
    let t1n = now_ns()
    let ns_new = ns_diff(t0n, t1n)
    println("  NEW (pmset 1 + read_file ring + in-hexa) total_ns=" + to_string(ns_new) + "  per_cycle_ns=" + to_string(ns_new / CYCLES))

    if ns_new > 0 {
        let ratio = ns_old / ns_new
        let saved = ((ns_old - ns_new) * 100) / ns_old
        println("  speedup=" + to_string(ratio) + "x  saved=" + to_string(saved) + "%")
    }
    return 0
}

// auto-invoke entry — raw 245 호환.
fn main() -> void {
    let _ = run_bench()
}
