// tool/bench/bench_c8_cwd_inverted.hexa — C8 cwd inverted index bench
//   ~/.claude*/projects 전체 sweep — synthetic fallback 으로 5K session 합성.
//   linear scan filter (cwd) vs blob bisect+posting list 비교.
//
//   5-tuple: site=C8 ROI#=8 baseline_ns post_ns diff_test=lossless
//
// R1 HEXA-FIRST: 인라인 python3.

let PAYLOAD = "import sys,os,glob,struct,time,bisect,array,random\n" +
"SESSIONS_N=5000\n" +
"CWDS_N=120\n" +
"QUERIES=200\n" +
"BIN='/tmp/bench_c8_cwd.bin'\n" +
"HOME=os.path.expanduser('~')\n" +
"\n" +
"def fmt(b):\n" +
"    if b>1048576: return f'{b/1048576:.2f}MB'\n" +
"    if b>1024: return f'{b/1024:.1f}KB'\n" +
"    return f'{b}B'\n" +
"\n" +
"def find_real():\n" +
"    pairs=[]\n" +
"    for root in glob.glob(HOME+'/.claude*/projects'):\n" +
"        for proj in os.listdir(root):\n" +
"            pdir=os.path.join(root,proj)\n" +
"            if not os.path.isdir(pdir): continue\n" +
"            cwd_guess='/'+proj.replace('-','/').lstrip('/')\n" +
"            for fn in os.listdir(pdir):\n" +
"                if fn.endswith('.jsonl'):\n" +
"                    pairs.append((cwd_guess,fn[:-6]))\n" +
"    return pairs\n" +
"\n" +
"def build_synthetic():\n" +
"    rng=random.Random(42)\n" +
"    cwds=[f'/Users/ghost/repo{i:03d}/proj' for i in range(CWDS_N)]\n" +
"    pairs=[]\n" +
"    for i in range(SESSIONS_N):\n" +
"        c=cwds[rng.randrange(CWDS_N)]\n" +
"        s=f'sess-{i:08x}'\n" +
"        pairs.append((c,s))\n" +
"    return pairs\n" +
"\n" +
"def encode(pairs):\n" +
"    t0=time.perf_counter_ns()\n" +
"    sids=sorted({s for _,s in pairs})\n" +
"    sid_to_idx={s:i for i,s in enumerate(sids)}\n" +
"    posting={}\n" +
"    for c,s in pairs:\n" +
"        posting.setdefault(c,[]).append(sid_to_idx[s])\n" +
"    cwds=sorted(posting.keys())\n" +
"    n_cwd=len(cwds); n_sess=len(sids)\n" +
"    cwd_pool=bytearray()\n" +
"    cwd_offs=array.array('I',[0]*n_cwd); cwd_lens=array.array('I',[0]*n_cwd)\n" +
"    post_off=array.array('I',[0]*n_cwd); post_len=array.array('I',[0]*n_cwd)\n" +
"    posting_blob=bytearray()\n" +
"    cur=0\n" +
"    for i,c in enumerate(cwds):\n" +
"        cb=c.encode('utf-8','replace')\n" +
"        cwd_offs[i]=len(cwd_pool); cwd_lens[i]=len(cb); cwd_pool.extend(cb)\n" +
"        ids=sorted(set(posting[c]))\n" +
"        post_off[i]=cur; post_len[i]=len(ids)\n" +
"        posting_blob.extend(array.array('I',ids).tobytes())\n" +
"        cur+=len(ids)\n" +
"    header=struct.pack('<4sIIII',b'CCWD',1,n_cwd,n_sess,len(cwd_pool))\n" +
"    with open(BIN,'wb') as f:\n" +
"        f.write(header)\n" +
"        f.write(cwd_offs.tobytes()); f.write(cwd_lens.tobytes())\n" +
"        f.write(post_off.tobytes()); f.write(post_len.tobytes())\n" +
"        f.write(bytes(cwd_pool))\n" +
"        f.write(bytes(posting_blob))\n" +
"    t1=time.perf_counter_ns()\n" +
"    return {'encode_ns':t1-t0,'n_cwd':n_cwd,'n_sess':n_sess,'cwds':cwds,\n" +
"            'cwd_keys':[c.encode('utf-8') for c in cwds],\n" +
"            'post_off':post_off,'post_len':post_len,'posting':posting,\n" +
"            'blob_size':os.path.getsize(BIN)}\n" +
"\n" +
"def linear_query(pairs,cwd):\n" +
"    return sum(1 for c,_ in pairs if c==cwd)\n" +
"\n" +
"def blob_query(cwd_keys,post_len,cwd_b):\n" +
"    i=bisect.bisect_left(cwd_keys,cwd_b)\n" +
"    if i>=len(cwd_keys) or cwd_keys[i]!=cwd_b: return 0\n" +
"    return post_len[i]\n" +
"\n" +
"def bench():\n" +
"    print('airgenome bench/C8 — claude cwd inverted index')\n" +
"    real=find_real()\n" +
"    if len(real)>=200:\n" +
"        pairs=real\n" +
"        print(f'  source: real ~/.claude*/projects ({len(pairs)} sessions)')\n" +
"    else:\n" +
"        pairs=build_synthetic()\n" +
"        print(f'  source: synthetic ({len(pairs)} sessions, {CWDS_N} cwds)')\n" +
"    info=encode(pairs)\n" +
"    print(f'  encode: {info[\"encode_ns\"]/1e6:.1f}ms n_cwd={info[\"n_cwd\"]} blob={fmt(info[\"blob_size\"])}')\n" +
"    rng=random.Random(7)\n" +
"    samples=[rng.choice(info['cwds']) for _ in range(QUERIES)]\n" +
"    sample_b=[s.encode('utf-8') for s in samples]\n" +
"    # diff test\n" +
"    mm=0\n" +
"    for s,sb in zip(samples[:20],sample_b[:20]):\n" +
"        a=linear_query(pairs,s)\n" +
"        b=blob_query(info['cwd_keys'],info['post_len'],sb)\n" +
"        if a!=b: mm+=1; print(f'    DIFF {s} lin={a} blob={b}')\n" +
"    print(f'  diff_test mismatches: {mm}/20')\n" +
"    if mm!=0: print('BENCH FAIL'); return\n" +
"    # OLD\n" +
"    t0=time.perf_counter_ns()\n" +
"    for s in samples: linear_query(pairs,s)\n" +
"    t1=time.perf_counter_ns()\n" +
"    ns_old=t1-t0; per_old=ns_old//QUERIES\n" +
"    print(f'  OLD (linear scan all)         per_query_ns={per_old}')\n" +
"    # NEW\n" +
"    cwd_keys=info['cwd_keys']; post_len=info['post_len']\n" +
"    t0=time.perf_counter_ns()\n" +
"    for sb in sample_b: blob_query(cwd_keys,post_len,sb)\n" +
"    t1=time.perf_counter_ns()\n" +
"    ns_new=t1-t0; per_new=ns_new//QUERIES if QUERIES>0 else 0\n" +
"    print(f'  NEW (mmap + bisect + posting) per_query_ns={per_new}')\n" +
"    if ns_new>0:\n" +
"        ratio=ns_old/ns_new; saved=((ns_old-ns_new)*100)//max(ns_old,1)\n" +
"        print(f'  speedup={ratio:.1f}x saved={saved}%')\n" +
"        amort=info['encode_ns']//QUERIES\n" +
"        print(f'  + encode amortized: {amort}ns/query')\n" +
"    print(f'  5-tuple: site=C8 ROI#=8 baseline_ns={per_old} post_ns={per_new} diff_test=lossless')\n" +
"\n" +
"bench()\n"

fn run() {
    let tmp_py = "/tmp/bench_c8_cwd_inverted_" + exec("date +%s%N").trim() + ".py"
    write_file(tmp_py, PAYLOAD)
    let cmd = "/usr/bin/perl -e 'alarm 120; exec @ARGV' /usr/bin/python3 '" + tmp_py + "' 2>&1; rm -f '" + tmp_py + "'"
    let result = exec(cmd)
    print(result)
}

run()
