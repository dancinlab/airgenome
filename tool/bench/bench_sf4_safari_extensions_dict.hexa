// tool/bench/bench_sf4_safari_extensions_dict.hexa — SF4 Extensions SHBF bench
//   pattern: bench_f18_bookmarks_shbf.hexa
//   synthetic 50-row dual-source extension dataset → SXBF encode → linear vs bisect.
//
// 5-tuple: site=SF4 ROI#=4 baseline_ns post_ns diff_test=lossless
// R1 HEXA-FIRST + R17 /usr/bin/perl alarm 120s.

let PAYLOAD = "import sys,os,struct,time,bisect,heapq,array,random\n" +
"N=50\n" +
"QUERIES=50\n" +
"TOP_K=5\n" +
"BIN='/tmp/bench_sf4_sxbf.bin'\n" +
"PREFIXES_BASE=['com.apple','com.colliderli','com.pvieito','com.synth','org.mozilla','net.example']\n" +
"\n" +
"def fmt(b):\n" +
"    if b>1048576: return f'{b/1048576:.2f}MB'\n" +
"    if b>1024: return f'{b/1024:.1f}KB'\n" +
"    return f'{b}B'\n" +
"\n" +
"def build_dataset(n=N):\n" +
"    rng=random.Random(42); base=int(time.time())\n" +
"    rows=[]\n" +
"    for i in range(n):\n" +
"        bp=PREFIXES_BASE[i%len(PREFIXES_BASE)]\n" +
"        bid=f'{bp}.ext{i:03d} (TEAM{i%9999:04d})'\n" +
"        sk=bid.split(' (')[0]\n" +
"        kind_bit=1 if i%2==0 else 2\n" +
"        flags=kind_bit | ((i%3==0)<<2)\n" +
"        rows.append((sk,bid,base-rng.randrange(0,86400*180),flags))\n" +
"    return rows\n" +
"\n" +
"def encode(rows):\n" +
"    t0=time.perf_counter_ns()\n" +
"    rows=sorted(rows,key=lambda r:(r[0],r[1]))\n" +
"    n=len(rows)\n" +
"    bp=bytearray(); bo=array.array('I',[0]*n); bl=array.array('I',[0]*n)\n" +
"    np_=bytearray(); no=array.array('I',[0]*n); nl=array.array('I',[0]*n)\n" +
"    tss=array.array('I',[0]*n); flags=bytearray(n)\n" +
"    for i,(sk,bid,t,fb) in enumerate(rows):\n" +
"        sb=sk.encode('utf-8'); nb=bid.encode('utf-8')\n" +
"        bo[i]=len(bp); bl[i]=len(sb); bp.extend(sb)\n" +
"        no[i]=len(np_); nl[i]=len(nb); np_.extend(nb)\n" +
"        tss[i]=int(t) & 0xFFFFFFFF; flags[i]=fb & 0xFF\n" +
"    with open(BIN,'wb') as f:\n" +
"        f.write(struct.pack('<4sIII',b'SXBF',1,n,len(bp)+len(np_)))\n" +
"        f.write(bo.tobytes()); f.write(bl.tobytes()); f.write(no.tobytes()); f.write(nl.tobytes())\n" +
"        f.write(tss.tobytes()); f.write(bytes(flags))\n" +
"        pad=(4-(f.tell()%4))%4\n" +
"        if pad: f.write(b'\\x00'*pad)\n" +
"        f.write(struct.pack('<I',len(bp))); f.write(bytes(bp))\n" +
"        f.write(struct.pack('<I',len(np_))); f.write(bytes(np_))\n" +
"    t1=time.perf_counter_ns()\n" +
"    return {'encode_ns':t1-t0,'n':n,'blob_size':os.path.getsize(BIN),'sorted_keys':[r[0] for r in rows]}\n" +
"\n" +
"def old_query(rows,prefix):\n" +
"    plen=len(prefix); hits=0\n" +
"    for sk,_,_,_ in rows:\n" +
"        if len(sk)>=plen and sk[:plen]==prefix: hits+=1\n" +
"    return hits\n" +
"\n" +
"def new_query(sorted_keys,prefix):\n" +
"    s=bisect.bisect_left(sorted_keys,prefix)\n" +
"    e=bisect.bisect_left(sorted_keys,prefix+'\\uffff')\n" +
"    return e-s\n" +
"\n" +
"def build_prefixes():\n" +
"    return ['com.apple','com.colliderli','com.pvieito','com.synth','org.mozilla','net.example','com.no-such']\n" +
"\n" +
"def diff_test(rows,sorted_keys,prefixes):\n" +
"    mm=0\n" +
"    for p in prefixes:\n" +
"        o=old_query(rows,p); n=new_query(sorted_keys,p)\n" +
"        if o!=n: mm+=1; print(f'    DIFF prefix={p} old={o} new={n}')\n" +
"    return mm\n" +
"\n" +
"def bench():\n" +
"    print('airgenome bench/SF4 — Extensions SHBF (linear vs blob bisect)')\n" +
"    print(f'  N={N} QUERIES={QUERIES} TOP_K={TOP_K}')\n" +
"    rows=build_dataset(N)\n" +
"    info=encode(rows)\n" +
"    sorted_keys=info['sorted_keys']\n" +
"    print(f'  encode (sort + SXBF): {info[\"encode_ns\"]/1e6:.3f}ms blob={fmt(info[\"blob_size\"])}')\n" +
"    prefixes=build_prefixes()\n" +
"    mm=diff_test(rows,sorted_keys,prefixes)\n" +
"    print(f'  diff_test mismatches: {mm} / {len(prefixes)}')\n" +
"    if mm!=0: print('BENCH FAIL [diff_test != 0]'); return\n" +
"    t0=time.perf_counter_ns()\n" +
"    for k in range(QUERIES): old_query(rows,prefixes[k%len(prefixes)])\n" +
"    t1=time.perf_counter_ns(); old_ns=t1-t0; per_old=old_ns//QUERIES\n" +
"    print(f'  OLD (linear)            total_ns={old_ns}  per_query_ns={per_old}')\n" +
"    t0=time.perf_counter_ns()\n" +
"    for k in range(QUERIES): new_query(sorted_keys,prefixes[k%len(prefixes)])\n" +
"    t1=time.perf_counter_ns(); new_ns=t1-t0; per_new=new_ns//QUERIES if QUERIES>0 else 0\n" +
"    print(f'  NEW (blob mmap+bisect)  total_ns={new_ns}  per_query_ns={per_new}')\n" +
"    if new_ns>0:\n" +
"        print(f'  speedup={old_ns/new_ns:.1f}x  saved={((old_ns-new_ns)*100)//old_ns if old_ns>0 else 0}%')\n" +
"    print(f'  5-tuple: site=SF4 ROI#=4 baseline_ns={per_old} post_ns={per_new} diff_test=lossless')\n" +
"\n" +
"bench()\n"

fn run() {
    let tmp_py = "/tmp/bench_sf4_safari_extensions_dict_" + exec("date +%s%N").trim() + ".py"
    write_file(tmp_py, PAYLOAD)
    let cmd = "/usr/bin/perl -e 'alarm 120; exec @ARGV' /usr/bin/python3 '" + tmp_py + "' 2>&1; rm -f '" + tmp_py + "'"
    let result = exec(cmd)
    print(result)
}

run()
