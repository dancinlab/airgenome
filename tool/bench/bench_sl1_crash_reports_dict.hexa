// tool/bench/bench_sl1_crash_reports_dict.hexa — SL1 Crash Reports Dictionary bench
//   MA3 #99 column-dict + K2 KSFL bisect 패턴. classifier_version=KCRD-v1.
//   현 hexa-pure json/glob 부재 — python3 stdlib 인라인 페이로드 (struct/array/bisect/json/glob/calendar).
//
// 모드:
//   bench (default) — synth-200 + real-probe(.ips) → KCRD encode → 50 app_name prefix
//                     query (OLD glob+json.loads vs NEW blob bisect).
//   encode          — encode only (artifact /tmp/bench_sl1_kcrd.bin)
//
// 5-tuple: site=SL1 ROI#=SL1 baseline_us post_us diff_test=lossless
//
// R1 HEXA-FIRST: 인라인 python3 페이로드 (.py 신규 없음).
// R17: /usr/bin/perl alarm 120s wrapper. /usr/bin/python3 절대경로. try/catch 0 in hexa.
// NO production execute. NO ReportCrash invocation. NO mutation. read-only open('rb').

let PAYLOAD = "import sys,os,struct,time,bisect,array,random,glob,json,resource,mmap,calendar\n" +
"BIN='/tmp/bench_sl1_kcrd.bin'\n" +
"\n" +
"def fmt(b):\n" +
"    if b>1048576: return f'{b/1048576:.2f}MB'\n" +
"    if b>1024: return f'{b/1024:.1f}KB'\n" +
"    return f'{b}B'\n" +
"def rss():\n" +
"    r=resource.getrusage(resource.RUSAGE_SELF).ru_maxrss\n" +
"    return r if sys.platform=='darwin' else r*1024\n" +
"\n" +
"def parse_ts(s):\n" +
"    if not isinstance(s,str): return 0\n" +
"    try:\n" +
"        ss=s.split(' +')[0].split(' -')[0].strip()\n" +
"        t=time.strptime(ss[:19],'%Y-%m-%d %H:%M:%S')\n" +
"        return int(calendar.timegm(t))\n" +
"    except Exception:\n" +
"        return 0\n" +
"\n" +
"def synth(n=200,seed=42):\n" +
"    rng=random.Random(seed)\n" +
"    apps=['hexa','bash','ccache','exe','ReportCrash','synth_node','synth_zsh','synth_app']\n" +
"    base=int(time.time())-86400*30\n" +
"    out=[]\n" +
"    for i in range(n):\n" +
"        a=apps[i%len(apps)]\n" +
"        out.append((a,base+rng.randint(0,86400*30),'/usr/local/bin/'+a,rng.randint(100,99999)))\n" +
"    return out\n" +
"\n" +
"def parse_ips(path):\n" +
"    try:\n" +
"        with open(path,'rb') as f: raw=f.read()\n" +
"    except Exception: return None\n" +
"    if not raw: return None\n" +
"    nl=raw.find(b'\\n')\n" +
"    if nl<=0: return None\n" +
"    try:\n" +
"        h=json.loads(raw[:nl].decode('utf-8','replace'))\n" +
"    except Exception: return None\n" +
"    if not isinstance(h,dict): return None\n" +
"    app=h.get('app_name')\n" +
"    if not isinstance(app,str) or not app: app='_unknown'\n" +
"    ts=parse_ts(h.get('timestamp'))\n" +
"    pp=''; pid=0\n" +
"    body=raw[nl+1:]\n" +
"    if body[:1]==b'{':\n" +
"        try:\n" +
"            b=json.loads(body.decode('utf-8','replace'))\n" +
"            if isinstance(b,dict):\n" +
"                v=b.get('procPath')\n" +
"                if isinstance(v,str): pp=v\n" +
"                p=b.get('pid')\n" +
"                if isinstance(p,int): pid=int(p)&0xffffffff\n" +
"        except Exception: pass\n" +
"    return (app,ts,pp,pid)\n" +
"\n" +
"def real_probe():\n" +
"    home=os.environ.get('HOME','')\n" +
"    if not home: return [],'no-home',0\n" +
"    paths=sorted(glob.glob(home+'/Library/Logs/DiagnosticReports/*.ips'))\n" +
"    rows=[]; skipped=0\n" +
"    for p in paths:\n" +
"        r=parse_ips(p)\n" +
"        if r: rows.append(r)\n" +
"        else: skipped+=1\n" +
"    if not rows: return [],'empty',skipped\n" +
"    return rows,'real',skipped\n" +
"\n" +
"def encode(rows):\n" +
"    apps=sorted({r[0] for r in rows})\n" +
"    a_idx={a:i for i,a in enumerate(apps)}\n" +
"    rows=sorted(rows,key=lambda r:(a_idx[r[0]],r[1]))\n" +
"    n=len(rows); dn=len(apps)\n" +
"    pool=bytearray()\n" +
"    d_off=array.array('I',[0]*dn); d_len=array.array('I',[0]*dn)\n" +
"    for i,a in enumerate(apps):\n" +
"        b=a.encode('utf-8','replace')\n" +
"        d_off[i]=len(pool); d_len[i]=len(b); pool.extend(b)\n" +
"    aid=array.array('H',[0]*n); ts=array.array('I',[0]*n)\n" +
"    pp_off=array.array('I',[0]*n); pp_len=array.array('I',[0]*n)\n" +
"    pid=array.array('I',[0]*n)\n" +
"    for i,(a,t,p,pi) in enumerate(rows):\n" +
"        aid[i]=a_idx[a]&0xffff\n" +
"        ts[i]=int(t)&0xffffffff\n" +
"        pb=p.encode('utf-8','replace')\n" +
"        pp_off[i]=len(pool); pp_len[i]=len(pb); pool.extend(pb)\n" +
"        pid[i]=int(pi)&0xffffffff\n" +
"    header=struct.pack('<4sIIII',b'KCRD',1,n,dn,len(pool))\n" +
"    with open(BIN,'wb') as f:\n" +
"        f.write(header)\n" +
"        f.write(d_off.tobytes()); f.write(d_len.tobytes())\n" +
"        f.write(aid.tobytes()); f.write(ts.tobytes())\n" +
"        f.write(pp_off.tobytes()); f.write(pp_len.tobytes())\n" +
"        f.write(pid.tobytes()); f.write(bytes(pool))\n" +
"    return {'n':n,'dn':dn,'blob_size':os.path.getsize(BIN),'rows':rows,'apps':apps}\n" +
"\n" +
"class Blob:\n" +
"    def __init__(self,path):\n" +
"        self.f=open(path,'rb'); self.mm=mmap.mmap(self.f.fileno(),0,prot=mmap.PROT_READ)\n" +
"        magic,ver,n,dn,ps=struct.unpack_from('<4sIIII',self.mm,0)\n" +
"        assert magic==b'KCRD' and ver==1\n" +
"        self.n=n; self.dn=dn\n" +
"        base=20\n" +
"        a=base; b=a+4*dn; c=b+4*dn\n" +
"        d=c+2*n; e=d+4*n; g=e+4*n; h=g+4*n; ip=h+4*n; pool_off=ip+4*n\n" +
"        mv=memoryview(self.mm)\n" +
"        d_off=array.array('I'); d_off.frombytes(bytes(mv[a:a+4*dn]))\n" +
"        d_len=array.array('I'); d_len.frombytes(bytes(mv[b:b+4*dn]))\n" +
"        pool=bytes(mv[pool_off:pool_off+ps])\n" +
"        self.apps=[pool[d_off[i]:d_off[i]+d_len[i]] for i in range(dn)]\n" +
"        self.aid=array.array('H'); self.aid.frombytes(bytes(mv[c:c+2*n]))\n" +
"    def app_count(self,prefix):\n" +
"        pb=prefix.encode('utf-8') if isinstance(prefix,str) else prefix\n" +
"        a=bisect.bisect_left(self.apps,pb)\n" +
"        b=bisect.bisect_left(self.apps,pb+b'\\xff\\xff\\xff\\xff')\n" +
"        if a>=b: return 0\n" +
"        c=0\n" +
"        for x in self.aid:\n" +
"            if a<=x<b: c+=1\n" +
"        return c\n" +
"    def close(self): self.mm.close(); self.f.close()\n" +
"\n" +
"def linear_repeated(prefix):\n" +
"    home=os.environ.get('HOME','')\n" +
"    paths=sorted(glob.glob(home+'/Library/Logs/DiagnosticReports/*.ips')) if home else []\n" +
"    c=0\n" +
"    for p in paths:\n" +
"        try:\n" +
"            with open(p,'rb') as f: raw=f.read(4096)\n" +
"        except Exception: continue\n" +
"        nl=raw.find(b'\\n')\n" +
"        if nl<=0: continue\n" +
"        try:\n" +
"            h=json.loads(raw[:nl].decode('utf-8','replace'))\n" +
"        except Exception: continue\n" +
"        a=h.get('app_name','') if isinstance(h,dict) else ''\n" +
"        if isinstance(a,str) and a.startswith(prefix): c+=1\n" +
"    return c\n" +
"\n" +
"def make_samples(apps,k=50):\n" +
"    s=[]\n" +
"    for a in apps:\n" +
"        s.append(a)\n" +
"        if len(a)>=2: s.append(a[:2])\n" +
"        if len(a)>=4: s.append(a[:4])\n" +
"    while len(s)<k: s.append(apps[len(s)%len(apps)][:3])\n" +
"    return s[:k]\n" +
"\n" +
"def run_bench():\n" +
"    print('[classifier] KCRD-v1')\n" +
"    sr=synth(200)\n" +
"    print(f'[synth] n={len(sr)}')\n" +
"    t0=time.perf_counter_ns()\n" +
"    info=encode(sr)\n" +
"    t1=time.perf_counter_ns()\n" +
"    print(f'[synth.encode] {(t1-t0)/1e6:.2f} ms  blob={fmt(info[\"blob_size\"])}  apps={info[\"dn\"]}')\n" +
"    samples=make_samples(info['apps'],50)\n" +
"    b=Blob(BIN)\n" +
"    for s in samples[:3]: b.app_count(s)\n" +
"    t0=time.perf_counter_ns()\n" +
"    bh=0\n" +
"    for s in samples: bh+=b.app_count(s)\n" +
"    t1=time.perf_counter_ns()\n" +
"    blob_us=(t1-t0)/1000/len(samples)\n" +
"    t0=time.perf_counter_ns()\n" +
"    lh=0\n" +
"    for s in samples: lh+=sum(1 for r in info['rows'] if r[0].startswith(s))\n" +
"    t1=time.perf_counter_ns()\n" +
"    lin_us=(t1-t0)/1000/len(samples)\n" +
"    b.close()\n" +
"    print(f'[synth.query] hits blob={bh} linear={lh}  lossless={bh==lh}')\n" +
"    print(f'  linear scan      : {lin_us:10.1f} us')\n" +
"    print(f'  blob mmap+bisect : {blob_us:10.1f} us')\n" +
"    if blob_us>0: print(f'  speedup          : {lin_us/blob_us:6.1f}x')\n" +
"    print('---')\n" +
"    rr,kind,skipped=real_probe()\n" +
"    print(f'[real] source={kind}  n={len(rr)}  skipped={skipped}')\n" +
"    if not rr:\n" +
"        print('[real] empty — skip phase2'); print(f'[rss] {fmt(rss())}'); return\n" +
"    t0=time.perf_counter_ns()\n" +
"    info=encode(rr)\n" +
"    t1=time.perf_counter_ns()\n" +
"    print(f'[real.encode] {(t1-t0)/1e6:.2f} ms  blob={fmt(info[\"blob_size\"])}  apps={info[\"dn\"]}')\n" +
"    samples=make_samples(info['apps'],min(50,max(10,len(info['apps'])*3)))\n" +
"    b=Blob(BIN)\n" +
"    for s in samples[:3]: b.app_count(s)\n" +
"    t0=time.perf_counter_ns()\n" +
"    bh=0\n" +
"    for s in samples: bh+=b.app_count(s)\n" +
"    t1=time.perf_counter_ns()\n" +
"    blob_us=(t1-t0)/1000/len(samples)\n" +
"    used=min(10,len(samples))\n" +
"    t0=time.perf_counter_ns()\n" +
"    lh=0\n" +
"    for s in samples[:used]: lh+=linear_repeated(s)\n" +
"    t1=time.perf_counter_ns()\n" +
"    lin_us=(t1-t0)/1000/used\n" +
"    b.close()\n" +
"    print(f'[real.query] hits_blob={bh}  hits_linear_sample{used}={lh}')\n" +
"    print(f'  OLD glob+json.loads : {lin_us:10.1f} us/query')\n" +
"    print(f'  NEW blob mmap+bisect : {blob_us:10.1f} us/query')\n" +
"    if blob_us>0: print(f'  speedup              : {lin_us/blob_us:6.1f}x')\n" +
"    print(f'[rss] {fmt(rss())}  elapsed_ok')\n" +
"\n" +
"mode=sys.argv[1] if len(sys.argv)>1 else 'bench'\n" +
"if mode=='encode':\n" +
"    rr,kind,skipped=real_probe()\n" +
"    if not rr: rr=synth(); kind='synth'\n" +
"    info=encode(rr)\n" +
"    print(f'[KCRD-v1] encoded {info[\"n\"]} ({kind}) apps={info[\"dn\"]} → {BIN} ({fmt(info[\"blob_size\"])})')\n" +
"elif mode=='bench':\n" +
"    run_bench()\n" +
"else:\n" +
"    print('usage: encode|bench'); sys.exit(2)\n"

fn run() {
    let argv = args()
    let mut mode = "bench"
    let mut i = 0
    while i < len(argv) {
        let v = argv[i]
        let is_hexa_bin = v.contains("/hexa-lang/") || v == "hexa" || v == "hexa.real"
        let is_self     = v.contains("bench_sl1_crash_reports_dict")
        if is_hexa_bin == false && is_self == false {
            if v == "encode" || v == "bench" { mode = v }
        }
        i = i + 1
    }
    let tmp_py = "/tmp/bench_sl1_crash_reports_dict_" + exec("date +%s%N").trim() + ".py"
    write_file(tmp_py, PAYLOAD)
    let cmd = "/usr/bin/perl -e 'alarm 120; exec @ARGV' /usr/bin/python3 '" + tmp_py + "' '" + mode + "' 2>&1; rm -f '" + tmp_py + "'"
    let result = exec(cmd)
    print(result)
}

run()
