// tool/bench/bench_c5_hook_tail.hexa — C5 hook-bus tail filter bench
//   OLD: exec("/usr/bin/tail -N file")  — fork + page cache full
//   NEW: in-process fd seek + posix_fadvise SEQUENTIAL (head bytes 0-touch)
//
//   synthetic ring 5MB jsonl (10000-line × ~500B). N=100 last-line read.
//   K=20 cycles → wall_ns + bytes_read 비교.
//
// 5-tuple: site=C5 ROI#=hookbus baseline_ns post_ns diff_test=lossless

let PAYLOAD = "import sys,os,time,subprocess\n" +
"BUS='/tmp/airgenome_bench_c5.ring.jsonl'\n" +
"LINES=10000; PER_LINE=500; N=100; K=20\n" +
"def fmt(b):\n" +
"    if b>1048576: return f'{b/1048576:.2f}MB'\n" +
"    if b>1024: return f'{b/1024:.1f}KB'\n" +
"    return f'{b}B'\n" +
"def build_ring():\n" +
"    if os.path.exists(BUS): os.remove(BUS)\n" +
"    pad='x'*(PER_LINE-80)\n" +
"    with open(BUS,'w') as f:\n" +
"        for i in range(LINES):\n" +
"            f.write(f'{{\"ts\":\"2026-04-30T00:00:00Z\",\"i\":{i},\"e\":\"hook\",\"p\":\"{pad}\"}}\\n')\n" +
"    return os.path.getsize(BUS)\n" +
"def old_tail():\n" +
"    r=subprocess.run(['/usr/bin/tail','-n',str(N),BUS],capture_output=True)\n" +
"    return r.stdout\n" +
"def new_tail(chunk=8192):\n" +
"    sz=os.path.getsize(BUS)\n" +
"    fd=os.open(BUS,os.O_RDONLY)\n" +
"    if hasattr(os,'posix_fadvise') and hasattr(os,'POSIX_FADV_SEQUENTIAL'):\n" +
"        start=max(0,sz-chunk*8)\n" +
"        os.posix_fadvise(fd,start,sz-start,os.POSIX_FADV_SEQUENTIAL)\n" +
"    pos=sz; buf=b''; lines=[]\n" +
"    while pos>0 and len(lines)<=N:\n" +
"        rsz=min(chunk,pos); pos-=rsz\n" +
"        os.lseek(fd,pos,0)\n" +
"        b=os.read(fd,rsz); buf=b+buf\n" +
"        lines=buf.split(b'\\n')\n" +
"    os.close(fd)\n" +
"    out=[ln for ln in lines if ln][-N:]\n" +
"    return b'\\n'.join(out)+b'\\n' if out else b''\n" +
"def diff_test():\n" +
"    o=old_tail(); n=new_tail()\n" +
"    return 0 if o==n else 1, len(o), len(n)\n" +
"def main():\n" +
"    print(f'airgenome bench/C5 — hook-bus tail-only (tail vs in-process seek+fadvise)')\n" +
"    print(f'  BUS={BUS} LINES={LINES} N={N} K={K}')\n" +
"    sz=build_ring()\n" +
"    print(f'  ring built: {fmt(sz)}')\n" +
"    mm,lo,ln=diff_test()\n" +
"    print(f'  diff_test: mm={mm} old_bytes={lo} new_bytes={ln}')\n" +
"    if mm!=0:\n" +
"        print('BENCH FAIL [diff_test != 0]'); return\n" +
"    # warmup\n" +
"    old_tail(); new_tail()\n" +
"    t0=time.perf_counter_ns()\n" +
"    for _ in range(K): old_tail()\n" +
"    t1=time.perf_counter_ns()\n" +
"    ns_old=t1-t0\n" +
"    t0=time.perf_counter_ns()\n" +
"    for _ in range(K): new_tail()\n" +
"    t1=time.perf_counter_ns()\n" +
"    ns_new=t1-t0\n" +
"    per_old=ns_old//K; per_new=ns_new//K\n" +
"    print(f'  OLD (tail fork) total_ns={ns_old}  per_op_ns={per_old}')\n" +
"    print(f'  NEW (fd seek)   total_ns={ns_new}  per_op_ns={per_new}')\n" +
"    if per_new>0:\n" +
"        ratio=per_old/per_new\n" +
"        saved_pct=((per_old-per_new)*100)//per_old if per_old>0 else 0\n" +
"        print(f'  speedup={ratio:.1f}x  saved={saved_pct}%')\n" +
"    print(f'  5-tuple: site=C5 ROI#=hookbus baseline_ns={per_old} post_ns={per_new} diff_test=lossless')\n" +
"main()\n"

fn run() {
    let tmp_py = "/tmp/bench_c5_hook_tail_" + exec("date +%s%N").trim() + ".py"
    write_file(tmp_py, PAYLOAD)
    let cmd = "/usr/bin/perl -e 'alarm 120; exec @ARGV' /usr/bin/python3 '" + tmp_py + "' 2>&1; rm -f '" + tmp_py + "'"
    let result = exec(cmd)
    print(result)
}

run()
