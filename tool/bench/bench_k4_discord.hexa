// tool/bench/bench_k4_discord.hexa — K4 Discord LevelDB shbf bench
//   Synth-only by default (Discord-running 시 자동 fallback).
//   Real-probe: Discord NOT running 일 때만 .ldb 워크 (read-only).
//
//   비교: synthetic 5000-key encode/bisect vs naive linear scan.
//   5-tuple: site=K4 ROI#=K4 baseline_ns post_ns diff_test=lossless
//
// R1 HEXA-FIRST: 인라인 python3 페이로드 (.py 신규 없음).
// R17: /usr/bin/perl alarm 120s wrapper. /usr/bin/python3 절대경로. try/catch 0.

let PAYLOAD = "import sys,os,struct,time,bisect,resource,mmap,array,glob,re,subprocess,random\n" +
"BIN='/tmp/bench_k4_discord_kdls.bin'\n" +
"CLASSIFIER='KDLS-v1-2026-04-30'\n" +
"LS=os.path.expanduser('~/Library/Application Support/discord/Local Storage/leveldb')\n" +
"TOKEN_RE=re.compile(r'(?i)token|password|secret|auth|jwt|bearer')\n" +
"\n" +
"def fmt(b):\n" +
"    if b>1048576: return f'{b/1048576:.2f}MB'\n" +
"    if b>1024: return f'{b/1024:.1f}KB'\n" +
"    return f'{b}B'\n" +
"\n" +
"# ---- pure-python snappy 1.x raw-block decoder (38 LOC core) ----\n" +
"def _vd(buf,p):\n" +
"    n=0;s=0\n" +
"    while True:\n" +
"        b=buf[p];p+=1; n|=(b&0x7f)<<s\n" +
"        if not (b&0x80): return n,p\n" +
"        s+=7\n" +
"        if s>35: raise ValueError('overflow')\n" +
"def snappy_decompress(buf):\n" +
"    out=bytearray(); ulen,p=_vd(buf,0); end=len(buf)\n" +
"    while p<end:\n" +
"        tag=buf[p]; p+=1; t=tag&3\n" +
"        if t==0:\n" +
"            x=tag>>2\n" +
"            if x<60: ln=x+1\n" +
"            elif x==60: ln=buf[p]+1; p+=1\n" +
"            elif x==61: ln=(buf[p]|(buf[p+1]<<8))+1; p+=2\n" +
"            elif x==62: ln=(buf[p]|(buf[p+1]<<8)|(buf[p+2]<<16))+1; p+=3\n" +
"            else: ln=struct.unpack_from('<I',buf,p)[0]+1; p+=4\n" +
"            out+=buf[p:p+ln]; p+=ln\n" +
"        elif t==1:\n" +
"            ln=4+((tag>>2)&7); off=((tag>>5)&7)<<8|buf[p]; p+=1\n" +
"            for _ in range(ln): out.append(out[len(out)-off])\n" +
"        elif t==2:\n" +
"            ln=(tag>>2)+1; off=buf[p]|(buf[p+1]<<8); p+=2\n" +
"            for _ in range(ln): out.append(out[len(out)-off])\n" +
"        else:\n" +
"            ln=(tag>>2)+1; off=struct.unpack_from('<I',buf,p)[0]; p+=4\n" +
"            for _ in range(ln): out.append(out[len(out)-off])\n" +
"    if len(out)!=ulen: raise ValueError('len mismatch')\n" +
"    return bytes(out)\n" +
"\n" +
"def snappy_selftest():\n" +
"    cases=[(bytes([0x00]),b''),\n" +
"           (bytes([0x05,0x10])+b'hello',b'hello'),\n" +
"           (bytes([0x08,0x0c])+b'abcd'+bytes([0x01,0x04]),b'abcdabcd'),\n" +
"           (bytes([0x40,0xf0,63])+bytes(range(64)),bytes(range(64))),\n" +
"           (bytes([0x40,0x04])+b'AB'+bytes([0xf6,0x02,0x00]),b'AB'*32)]\n" +
"    ok=0\n" +
"    for enc,exp in cases:\n" +
"        try:\n" +
"            if snappy_decompress(enc)==exp: ok+=1\n" +
"        except Exception: pass\n" +
"    return ok,len(cases)\n" +
"\n" +
"def discord_running():\n" +
"    try:\n" +
"        r=subprocess.run(['/usr/bin/pgrep','-lf','[Dd]iscord'],capture_output=True,timeout=3)\n" +
"        return bool(r.stdout.strip())\n" +
"    except Exception: return False\n" +
"\n" +
"# ---- synth dataset for bench ----\n" +
"def synth_keys(n=5000,seed=42):\n" +
"    rng=random.Random(seed); out=set()\n" +
"    cats=['channel','server','user','setting','guild','role','emoji']\n" +
"    while len(out)<n:\n" +
"        c=cats[rng.randrange(len(cats))]\n" +
"        s=f'{c}-{rng.randrange(10**6):08x}-{rng.randrange(10**4):04x}'\n" +
"        out.add(s)\n" +
"    return sorted(out)\n" +
"\n" +
"def encode_synth(keys):\n" +
"    t0=time.perf_counter_ns()\n" +
"    n=len(keys); pool=bytearray()\n" +
"    offs=array.array('I',[0]*n); lens=array.array('I',[0]*n); tags=bytearray(n)\n" +
"    for i,k in enumerate(keys):\n" +
"        kb=k.encode('utf-8','replace')\n" +
"        offs[i]=len(pool); lens[i]=len(kb); tags[i]=3; pool.extend(kb)\n" +
"    header=struct.pack('<4sIII',b'KDLS',1,n,len(pool))\n" +
"    with open(BIN,'wb') as f:\n" +
"        f.write(header); f.write(offs.tobytes()); f.write(lens.tobytes())\n" +
"        f.write(bytes(tags)); f.write(pool)\n" +
"    return time.perf_counter_ns()-t0\n" +
"\n" +
"def linear_prefix_count(keys,prefix):\n" +
"    return sum(1 for k in keys if k.startswith(prefix))\n" +
"def bisect_prefix_count(keys,prefix):\n" +
"    s=bisect.bisect_left(keys,prefix)\n" +
"    e=bisect.bisect_left(keys,prefix+'\\uffff')\n" +
"    return e-s\n" +
"\n" +
"def diff_test(keys,prefixes):\n" +
"    mm=0\n" +
"    for p in prefixes:\n" +
"        a=linear_prefix_count(keys,p); b=bisect_prefix_count(keys,p)\n" +
"        if a!=b: mm+=1; print(f'  DIFF {p} lin={a} bi={b}')\n" +
"    return mm\n" +
"\n" +
"def bench_synth():\n" +
"    print('airgenome bench/K4 — discord_localstorage_shbf  (synth)')\n" +
"    print(f'  classifier_version={CLASSIFIER}')\n" +
"    ok,total=snappy_selftest()\n" +
"    print(f'  snappy selftest fixtures: {ok}/{total}')\n" +
"    if ok!=total:\n" +
"        print('SELFTEST FAIL'); sys.exit(2)\n" +
"    keys=synth_keys(5000)\n" +
"    enc_ns=encode_synth(keys)\n" +
"    blob_sz=os.path.getsize(BIN)\n" +
"    print(f'  encode (sort+KDLS): {enc_ns/1e6:.1f}ms  blob={fmt(blob_sz)}  n={len(keys)}')\n" +
"    prefixes=['channel-','server-','user-','setting-','guild-','role-','emoji-','channel-0','user-1','x-no-such-']\n" +
"    mm=diff_test(keys,prefixes)\n" +
"    print(f'  diff_test mismatches: {mm}/{len(prefixes)}')\n" +
"    if mm!=0:\n" +
"        print('BENCH FAIL [diff_test != 0]'); return\n" +
"    QUERIES=100\n" +
"    t0=time.perf_counter_ns()\n" +
"    for k in range(QUERIES): linear_prefix_count(keys,prefixes[k%len(prefixes)])\n" +
"    ns_old=time.perf_counter_ns()-t0\n" +
"    per_old=ns_old//QUERIES\n" +
"    t0=time.perf_counter_ns()\n" +
"    for k in range(QUERIES): bisect_prefix_count(keys,prefixes[k%len(prefixes)])\n" +
"    ns_new=time.perf_counter_ns()-t0\n" +
"    per_new=ns_new//QUERIES if QUERIES>0 else 0\n" +
"    print(f'  OLD (linear scan)    total_ns={ns_old}  per_query_ns={per_old}')\n" +
"    print(f'  NEW (sorted bisect)  total_ns={ns_new}  per_query_ns={per_new}')\n" +
"    if ns_new>0:\n" +
"        ratio=ns_old/ns_new\n" +
"        saved=((ns_old-ns_new)*100)//ns_old if ns_old>0 else 0\n" +
"        print(f'  speedup={ratio:.1f}x  saved={saved}%')\n" +
"    print(f'  5-tuple: site=K4 ROI#=K4 baseline_ns={per_old} post_ns={per_new} diff_test=lossless')\n" +
"\n" +
"def real_probe():\n" +
"    if discord_running():\n" +
"        print('[real-probe] Discord IS running — skipped (synth-only path).'); return\n" +
"    if not os.path.isdir(LS):\n" +
"        print('[real-probe] LS dir absent.'); return\n" +
"    files=sorted(glob.glob(os.path.join(LS,'*.ldb')))\n" +
"    print(f'[real-probe] Discord NOT running — would walk {len(files)} .ldb files (read-only):')\n" +
"    total=0\n" +
"    for f in files:\n" +
"        sz=os.path.getsize(f); total+=sz\n" +
"        print(f'  {os.path.basename(f)}  {fmt(sz)}')\n" +
"    print(f'  total {fmt(total)}')\n" +
"    print('  (real harvest is performed by modules/filters/data/discord_localstorage_shbf.hexa, not by bench)')\n" +
"\n" +
"def main():\n" +
"    bench_synth()\n" +
"    real_probe()\n" +
"\n" +
"main()\n"

fn run() {
    let tmp_py = "/tmp/bench_k4_discord_" + exec("date +%s%N").trim() + ".py"
    write_file(tmp_py, PAYLOAD)
    let cmd = "/usr/bin/perl -e 'alarm 120; exec @ARGV' /usr/bin/python3 '" + tmp_py + "' 2>&1; rm -f '" + tmp_py + "'"
    let result = exec(cmd)
    print(result)
}

run()
