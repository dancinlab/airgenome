// tool/bench/bench_site10.hexa — own 7 site-10 baseline (label load_rules 8-call vs 1-pass)
//
// site-9 이후 jq_field 는 이미 0-fork (in-hexa anchor split). site-10 의 잔여 ROI 는:
// parse_rule 에서 같은 rule 라인을 8번 split → 1번 walk 로 줄이는 구조 개선뿐.
//
// 측정: post-site-9 의 8× new_jq_field call (현재 상태) vs 단일 split(",") + key 매칭
// 단일 패스. RULES 7 rules × cycles. raw 91 honest C3 — 측정 후 결정 (구현 가치 < 2× 면
// 사이트 close, ledger 에 N/A 사유 명시).

use "../../core/core"

let LINES_SAMPLE = [
    "{\"label\":\"CPU_SPIKE\",\"axis\":0,\"op\":\"gt\",\"threshold\":80,\"desc\":\"x\"}",
    "{\"label\":\"MEM_LEAK\",\"axis\":1,\"op\":\"gt\",\"threshold\":50,\"desc\":\"x\"}",
    "{\"label\":\"FORK_BOMB\",\"axis\":0,\"op\":\"gt\",\"threshold\":50,\"and_axis\":1,\"and_op\":\"gt\",\"and_threshold\":20,\"desc\":\"x\"}",
    "{\"label\":\"IO_STORM\",\"axis\":5,\"op\":\"gt\",\"threshold\":50,\"desc\":\"x\"}",
    "{\"label\":\"GPU_HOG\",\"axis\":2,\"op\":\"gt\",\"threshold\":80,\"desc\":\"x\"}",
    "{\"label\":\"REMOTE_UBU_CPU\",\"axis\":0,\"op\":\"gt\",\"threshold\":85,\"host\":\"ubu\",\"desc\":\"x\"}",
    "{\"label\":\"REMOTE_HTZ_CPU\",\"axis\":0,\"op\":\"gt\",\"threshold\":85,\"host\":\"htz\",\"desc\":\"x\"}"
]
let K = 5000  // realistic cycles (load_rules 는 cycle 마다 호출)

// label.hexa#jq_field 정확 복제 (post-site-9 in-hexa).
fn old_jq_field(line: str, expr: str) -> str {
    if line == "" { return "" }
    if len(expr) < 2 { return "" }
    let key = expr.substring(1, len(expr))
    let anchor = "\"" + key + "\":"
    let parts = line.split(anchor)
    if len(parts) < 2 { return "" }
    let after = parts[1]
    if len(after) == 0 { return "" }
    let c0 = after.substring(0, 1)
    if c0 == "\"" {
        let body = after.substring(1, len(after))
        let end_split = body.split("\"")
        if len(end_split) < 1 { return "" }
        return end_split[0]
    }
    let mut i = 0
    let n = len(after)
    while i < n {
        let ch = after.substring(i, i + 1)
        if ch == "," { return after.substring(0, i).trim() }
        if ch == "}" { return after.substring(0, i).trim() }
        if ch == "]" { return after.substring(0, i).trim() }
        i = i + 1
    }
    return after.trim()
}

fn old_to_int_safe(s: str) -> int {
    if s == "" { return 0 }
    let parts = s.split(".")
    if len(parts) == 0 { return 0 }
    if parts[0] == "" { return 0 }
    return to_int(parts[0])
}

// OLD: 8 separate jq_field calls (현재 label.hexa#parse_rule).
fn old_parse_rule(line: str) -> int {
    let label = old_jq_field(line, ".label")
    let axis = old_to_int_safe(old_jq_field(line, ".axis"))
    let op = old_jq_field(line, ".op")
    let threshold = old_to_int_safe(old_jq_field(line, ".threshold"))
    let aaxis_s = old_jq_field(line, ".and_axis")
    let and_axis = old_to_int_safe(aaxis_s)
    let and_op = old_jq_field(line, ".and_op")
    let and_threshold = old_to_int_safe(old_jq_field(line, ".and_threshold"))
    let host_filter = old_jq_field(line, ".host")
    // total = sum of lens, used as side effect to defeat DCE
    let mut t = len(label) + axis + len(op) + threshold + and_axis
    t = t + len(and_op) + and_threshold + len(host_filter)
    return t
}

// NEW: 단일 split(",") 후 key prefix 매칭으로 모든 8 필드 1패스 추출.
// rule 라인은 단순 형식 (값에 ',' 포함 안함 — 모든 desc 도 ASCII 순수). 안전.
fn new_parse_rule(line: str) -> int {
    if line == "" { return 0 }
    // strip leading { and trailing }
    let n = len(line)
    if n < 2 { return 0 }
    let inner = line.substring(1, n - 1)  // drop { }
    let pairs = inner.split(",")
    let mut label = ""
    let mut axis = 0
    let mut op = ""
    let mut threshold = 0
    let mut and_axis = 0
    let mut and_op = ""
    let mut and_threshold = 0
    let mut host_filter = ""
    let mut i = 0
    while i < len(pairs) {
        let kv = pairs[i]
        // kv = "\"key\":value" or "\"key\":\"value\""
        let colon = kv.split(":")
        if len(colon) >= 2 {
            let k_raw = colon[0]
            let v_raw = colon[1]
            // strip quotes from key
            let mut k = k_raw
            if len(k) >= 2 {
                let k0 = k.substring(0, 1)
                if k0 == "\"" {
                    k = k.substring(1, len(k))
                    let kn = len(k)
                    if kn >= 1 {
                        let kl = k.substring(kn - 1, kn)
                        if kl == "\"" { k = k.substring(0, kn - 1) }
                    }
                }
            }
            // strip quotes from value if string
            let mut v = v_raw
            if len(v) >= 2 {
                let v0 = v.substring(0, 1)
                if v0 == "\"" {
                    v = v.substring(1, len(v))
                    let vn = len(v)
                    if vn >= 1 {
                        let vl = v.substring(vn - 1, vn)
                        if vl == "\"" { v = v.substring(0, vn - 1) }
                    }
                }
            }
            if k == "label" { label = v }
            if k == "axis" { axis = old_to_int_safe(v) }
            if k == "op" { op = v }
            if k == "threshold" { threshold = old_to_int_safe(v) }
            if k == "and_axis" { and_axis = old_to_int_safe(v) }
            if k == "and_op" { and_op = v }
            if k == "and_threshold" { and_threshold = old_to_int_safe(v) }
            if k == "host" { host_filter = v }
        }
        i = i + 1
    }
    let mut t = len(label) + axis + len(op) + threshold + and_axis
    t = t + len(and_op) + and_threshold + len(host_filter)
    return t
}

fn run_old(lines: list) -> int {
    let mut total = 0
    let mut k = 0
    while k < K {
        let mut p = 0
        while p < len(lines) {
            total = total + old_parse_rule(lines[p])
            p = p + 1
        }
        k = k + 1
    }
    return total
}

fn run_new(lines: list) -> int {
    let mut total = 0
    let mut k = 0
    while k < K {
        let mut p = 0
        while p < len(lines) {
            total = total + new_parse_rule(lines[p])
            p = p + 1
        }
        k = k + 1
    }
    return total
}

fn diff_test(lines: list) -> int {
    let mut mismatches = 0
    let mut p = 0
    while p < len(lines) {
        let o = old_parse_rule(lines[p])
        let n = new_parse_rule(lines[p])
        if o != n {
            mismatches = mismatches + 1
            if mismatches <= 3 {
                println("    DIFF p=" + to_string(p) + " old=" + to_string(o) + " new=" + to_string(n))
            }
        }
        p = p + 1
    }
    return mismatches
}

fn now_ns() -> str {
    return exec("gdate +%s%N").trim()
}

fn ns_diff(t0: str, t1: str) -> int {
    return to_int(t1) - to_int(t0)
}

fn main() -> void {
    println("airgenome bench/site-10 — label parse_rule (8-call vs 1-pass)")
    println("  rules=" + to_string(len(LINES_SAMPLE)) + " K=" + to_string(K))

    let mm = diff_test(LINES_SAMPLE)
    let total = len(LINES_SAMPLE)
    println("  diff_test mismatches: " + to_string(mm) + " / " + to_string(total))
    if mm != 0 {
        println("BENCH FAIL [diff_test mismatches > 0]")
        return
    }

    let t0_old = now_ns()
    let _o = run_old(LINES_SAMPLE)
    let t1_old = now_ns()
    let ns_old = ns_diff(t0_old, t1_old)
    let calls = K * len(LINES_SAMPLE)
    println("  OLD (8-call)     total_ns=" + to_string(ns_old) + "  per_call_ns=" + to_string(ns_old / calls))

    let t0_new = now_ns()
    let _n = run_new(LINES_SAMPLE)
    let t1_new = now_ns()
    let ns_new = ns_diff(t0_new, t1_new)
    println("  NEW (1-pass)     total_ns=" + to_string(ns_new) + "  per_call_ns=" + to_string(ns_new / calls))

    if ns_new > 0 {
        let ratio = ns_old / ns_new
        let saved_pct = ((ns_old - ns_new) * 100) / ns_old
        println("  speedup=" + to_string(ratio) + "x  saved=" + to_string(saved_pct) + "%")
    }
}
