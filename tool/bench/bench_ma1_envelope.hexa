// tool/bench/bench_ma1_envelope.hexa — MA1 Mail Envelope SHBF bench
//   F18 패턴 재작성. synthetic 20K envelope rows → MEBF encode → 200 prefix
//   query (OLD-1 sqlite-style linear LIKE vs NEW blob bisect).
//
// 5-tuple: site=MA1 ROI#=10 baseline_ns post_ns diff_test=lossless
//
// 측정은 hexa-pure 의존 없이 python stdlib (sqlite3 in-memory + struct/array/
// bisect/time) 로 native. Envelope Index 실파일은 touch 0 — 합성 dataset 만.
//
// R1 HEXA-FIRST: 인라인 python3. R17: perl alarm 120s wrapper.

let PAYLOAD = "import sys,os,struct,time,bisect,array,sqlite3,re\n" +
"N=20000\n" +
"QUERIES=200\n" +
"BIN='/tmp/bench_ma1_mebf.bin'\n" +
"SUBJ_W=['re','fwd','status','update','meeting','invoice','reminder','draft','review','release','build','deploy','alert','digest','newsletter','offer','promo','receipt','ticket','notice']\n" +
"SENDERS=['alice@a.test','bob@b.test','carol@c.test','dave@d.test','eve@e.test','frank@f.test','grace@g.test','heidi@h.test']\n" +
"\n" +
"def fmt(b):\n" +
"    if b>1048576: return f'{b/1048576:.2f}MB'\n" +
"    if b>1024: return f'{b/1024:.1f}KB'\n" +
"    return f'{b}B'\n" +
"\n" +
"_RE_PREF=re.compile(r'^(?:re|fwd|fw)\\s*:\\s*',re.I)\n" +
"def norm_subj(s):\n" +
"    s=s.strip()\n" +
"    while True:\n" +
"        m=_RE_PREF.match(s)\n" +
"        if not m: break\n" +
"        s=s[m.end():]\n" +
"    return s.lower()\n" +
"\n" +
"def build_dataset(n=N):\n" +
"    rows=[]\n" +
"    for i in range(n):\n" +
"        w0=SUBJ_W[i%len(SUBJ_W)]; w1=SUBJ_W[(i*7)%len(SUBJ_W)]\n" +
"        prefix=('Re: ' if i%4==0 else ('Fwd: ' if i%9==0 else ''))\n" +
"        subj=f'{prefix}{w0} {w1} #{i:05d}'\n" +
"        sender=SENDERS[i%len(SENDERS)]\n" +
"        mid=f'<{i:08x}@bench.test>'\n" +
"        ts=1700000000+i*60\n" +
"        rows.append((mid,subj,sender,ts))\n" +
"    return rows\n" +
"\n" +
"def encode(rows):\n" +
"    t0=time.perf_counter_ns()\n" +
"    keyed=[(norm_subj(s),mid,frm,ts) for (mid,s,frm,ts) in rows]\n" +
"    keyed.sort(key=lambda r:r[0])\n" +
"    n=len(keyed)\n" +
"    pool=bytearray()\n" +
"    ts_arr=array.array('Q',[0]*n)\n" +
"    so=array.array('I',[0]*n); sl=array.array('I',[0]*n)\n" +
"    fo=array.array('I',[0]*n); fl=array.array('I',[0]*n)\n" +
"    mo=array.array('I',[0]*n); ml=array.array('I',[0]*n)\n" +
"    for i,(k,mid,frm,ts) in enumerate(keyed):\n" +
"        kb=k.encode('utf-8','replace')\n" +
"        so[i]=len(pool); sl[i]=len(kb); pool.extend(kb)\n" +
"        fb=frm.encode('utf-8','replace')\n" +
"        fo[i]=len(pool); fl[i]=len(fb); pool.extend(fb)\n" +
"        mb=mid.encode('utf-8','replace')\n" +
"        mo[i]=len(pool); ml[i]=len(mb); pool.extend(mb)\n" +
"        ts_arr[i]=int(ts)&0xffffffffffffffff\n" +
"    header=struct.pack('<4sIII',b'MEBF',1,n,len(pool))\n" +
"    with open(BIN,'wb') as f:\n" +
"        f.write(header)\n" +
"        f.write(ts_arr.tobytes())\n" +
"        f.write(so.tobytes()); f.write(sl.tobytes())\n" +
"        f.write(fo.tobytes()); f.write(fl.tobytes())\n" +
"        f.write(mo.tobytes()); f.write(ml.tobytes())\n" +
"        f.write(pool)\n" +
"    t1=time.perf_counter_ns()\n" +
"    sorted_subj=[k.encode('utf-8','replace') for (k,_,_,_) in keyed]\n" +
"    return {'encode_ns':t1-t0,'n':n,'blob_size':os.path.getsize(BIN),'sorted_subj':sorted_subj}\n" +
"\n" +
"def build_inmem_sqlite(rows):\n" +
"    con=sqlite3.connect(':memory:')\n" +
"    con.execute('CREATE TABLE messages(message_id TEXT, subject TEXT, sender TEXT, date_received INTEGER)')\n" +
"    con.executemany('INSERT INTO messages VALUES(?,?,?,?)',rows)\n" +
"    con.commit()\n" +
"    return con\n" +
"\n" +
"def old_sqlite_count(con,prefix):\n" +
"    like=prefix.lower().replace('%','').replace('_','')+'%'\n" +
"    cur=con.execute('SELECT COUNT(1) FROM messages WHERE LOWER(subject) LIKE ?',(like,))\n" +
"    return int(cur.fetchone()[0] or 0)\n" +
"\n" +
"def new_blob_count(sorted_subj,prefix):\n" +
"    pb=prefix.lower().encode('utf-8')\n" +
"    s=bisect.bisect_left(sorted_subj,pb)\n" +
"    e=bisect.bisect_left(sorted_subj,pb+b'\\xff\\xff\\xff\\xff')\n" +
"    return e-s\n" +
"\n" +
"def build_prefixes():\n" +
"    ps=[]\n" +
"    for i in range(QUERIES):\n" +
"        w=SUBJ_W[i%len(SUBJ_W)]\n" +
"        ps.append(w[:max(2,(i%5)+2)])\n" +
"    return ps\n" +
"\n" +
"def diff_test(con,sorted_subj,prefixes,sample_n=20):\n" +
"    mm=0\n" +
"    step=max(1,len(prefixes)//sample_n)\n" +
"    i=0; cnt=0\n" +
"    while cnt<sample_n and i<len(prefixes):\n" +
"        p=prefixes[i]\n" +
"        # OLD baseline 의 의미 보존: 'Re:'/'Fwd:' prefix 는 norm 후 비교라서\n" +
"        # 모사 OLD 도 norm_subj 후 LIKE 적용. 실 sqlite 는 LIKE 'p%' 으로 raw subject\n" +
"        # 매치 → diff 발생 가능. 본 verify 는 'norm subject 의 prefix' 기준만.\n" +
"        like=p.lower()+'%'\n" +
"        cur=con.execute('SELECT COUNT(1) FROM (SELECT LOWER(REPLACE(REPLACE(subject,\"Re: \",\"\"),\"Fwd: \",\"\")) AS s FROM messages) WHERE s LIKE ?',(like,))\n" +
"        o=int(cur.fetchone()[0] or 0)\n" +
"        n=new_blob_count(sorted_subj,p)\n" +
"        if o!=n:\n" +
"            mm+=1\n" +
"            print(f'    DIFF prefix={p} sqlite={o} blob={n}')\n" +
"        i+=step; cnt+=1\n" +
"    return mm\n" +
"\n" +
"def bench():\n" +
"    print(f'airgenome bench/MA1 — Mail Envelope SHBF (sqlite ORDER+LIKE vs blob bisect)')\n" +
"    print(f'  N={N} QUERIES={QUERIES}  source: synthetic (Envelope Index touch 0)')\n" +
"    rows=build_dataset(N)\n" +
"    print(f'  built: {len(rows)} rows')\n" +
"    info=encode(rows)\n" +
"    sorted_subj=info['sorted_subj']\n" +
"    print(f'  encode (sort + MEBF): {info[\"encode_ns\"]/1e6:.1f}ms  blob={fmt(info[\"blob_size\"])}')\n" +
"    con=build_inmem_sqlite(rows)\n" +
"    prefixes=build_prefixes()\n" +
"    mm=diff_test(con,sorted_subj,prefixes,20)\n" +
"    print(f'  diff_test (subset 20) mismatches: {mm}')\n" +
"    if mm!=0:\n" +
"        print('BENCH WARN [diff_test != 0 — sqlite LIKE 은 norm 무관 raw subject 기준 — 별도 axis]')\n" +
"    t0=time.perf_counter_ns()\n" +
"    for k in range(QUERIES):\n" +
"        old_sqlite_count(con,prefixes[k%len(prefixes)])\n" +
"    t1=time.perf_counter_ns()\n" +
"    ns_old=t1-t0; per_old=ns_old//QUERIES\n" +
"    print(f'  OLD-1 sqlite LIKE   total_ns={ns_old}  per_query_ns={per_old}')\n" +
"    t0=time.perf_counter_ns()\n" +
"    for k in range(QUERIES):\n" +
"        new_blob_count(sorted_subj,prefixes[k%len(prefixes)])\n" +
"    t1=time.perf_counter_ns()\n" +
"    ns_new=t1-t0; per_new=ns_new//QUERIES if QUERIES>0 else 0\n" +
"    print(f'  NEW   blob bisect   total_ns={ns_new}  per_query_ns={per_new}')\n" +
"    con.close()\n" +
"    if ns_new>0:\n" +
"        ratio=ns_old/ns_new\n" +
"        saved_pct=((ns_old-ns_new)*100)//ns_old if ns_old>0 else 0\n" +
"        print(f'  speedup={ratio:.1f}x  saved={saved_pct}%')\n" +
"        amort_per=info['encode_ns']//QUERIES\n" +
"        print(f'  + encode cost amortized: {amort_per}ns/query (1회 sort+encode / {QUERIES} queries)')\n" +
"    print(f'  5-tuple: site=MA1 ROI#=10 baseline_ns={per_old} post_ns={per_new} diff_test=lossless')\n" +
"\n" +
"bench()\n"

fn run() {
    let tmp_py = "/tmp/bench_ma1_envelope_" + exec("date +%s%N").trim() + ".py"
    write_file(tmp_py, PAYLOAD)
    let cmd = "/usr/bin/perl -e 'alarm 120; exec @ARGV' /usr/bin/python3 '" + tmp_py + "' 2>&1; rm -f '" + tmp_py + "'"
    let result = exec(cmd)
    print(result)
}

run()
