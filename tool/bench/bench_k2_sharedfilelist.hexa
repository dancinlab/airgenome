// tool/bench/bench_k2_sharedfilelist.hexa — K2 SharedFileList Recent SHBF bench
//   F18 SBBF axis. FI1 RFSF 패턴 transfer (sfl2 heuristic → sfl3/sfl4 NSKeyedArchiver).
//   합성 dataset (synth=2000 paths) + real-probe attempt (~/Library/Application
//   Support/com.apple.sharedfilelist/*.sfl3/*.sfl4 read-only) 모두 검증.
//   OLD (per-query plistlib.loads + $objects regex walk) vs NEW (KSFL mmap+bisect)
//   wall-clock 비교 — full python stdlib (struct/array/bisect/time/plistlib/re).
//
// 모드:
//   bench (default) — synth-only fast bench (결정성).
//                     real-probe section 도 함께 표시 (file present 시).
//
// 5-tuple: site=K2 ROI#=K2 baseline_ns post_ns diff_test=lossless
//
// R1 HEXA-FIRST: 인라인 python3 페이로드 (.py 신규 없음).
// R17: /usr/bin/perl alarm 120s wrapper. /usr/bin/python3 절대경로. try/catch 0.

let PAYLOAD = "import sys,os,struct,time,bisect,array,random,glob,re,plistlib\n" +
"N_SYNTH=2000\n" +
"QUERIES=200\n" +
"BIN='/tmp/bench_k2_ksfl.bin'\n" +
"PATH_RE=re.compile(rb'(?:/Users/|/Applications/|/Volumes/|/System/|/Library/)[\\w\\-./ ]{2,200}')\n" +
"\n" +
"def fmt(b):\n" +
"    if b>1048576: return f'{b/1048576:.2f}MB'\n" +
"    if b>1024: return f'{b/1024:.1f}KB'\n" +
"    return f'{b}B'\n" +
"\n" +
"def synth(n=N_SYNTH,seed=42):\n" +
"    rng=random.Random(seed)\n" +
"    home=os.environ.get('HOME','/Users/x')\n" +
"    dirs=['Documents/Projects','Documents/Notes','Desktop','Downloads','Pictures','Music']\n" +
"    paths=[]\n" +
"    for i in range(n):\n" +
"        d=dirs[i%len(dirs)]\n" +
"        sub=f'sub{(i//50)%20}'\n" +
"        p=f'{home}/{d}/{sub}/file_{i}.{rng.choice([\"txt\",\"md\",\"pdf\",\"png\",\"swift\",\"py\"])}'\n" +
"        paths.append((p,rng.randrange(0,9000)))\n" +
"    return paths\n" +
"\n" +
"def encode(rows):\n" +
"    t0=time.perf_counter_ns()\n" +
"    rows=sorted(set(rows),key=lambda r:r[0])\n" +
"    n=len(rows)\n" +
"    pool=bytearray()\n" +
"    offs=array.array('I',[0]*n)\n" +
"    lens=array.array('I',[0]*n)\n" +
"    tss =array.array('I',[0]*n)\n" +
"    for i,(p,t) in enumerate(rows):\n" +
"        pb=p.encode('utf-8','replace')\n" +
"        offs[i]=len(pool); lens[i]=len(pb); tss[i]=int(t)&0xffffffff\n" +
"        pool.extend(pb)\n" +
"    header=struct.pack('<4sIII',b'KSFL',1,n,len(pool))\n" +
"    with open(BIN,'wb') as f:\n" +
"        f.write(header)\n" +
"        f.write(offs.tobytes()); f.write(lens.tobytes()); f.write(tss.tobytes())\n" +
"        f.write(pool)\n" +
"    t1=time.perf_counter_ns()\n" +
"    return {'n':n,'blob_size':os.path.getsize(BIN),'rows':rows,'encode_ns':t1-t0}\n" +
"\n" +
"def old_lookup(rows,prefix):\n" +
"    c=0; pl=len(prefix)\n" +
"    for p,_ in rows:\n" +
"        if len(p)>=pl and p[:pl]==prefix: c+=1\n" +
"    return c\n" +
"\n" +
"def new_lookup(sorted_paths,prefix):\n" +
"    pb=prefix.encode('utf-8') if isinstance(prefix,str) else prefix\n" +
"    a=bisect.bisect_left(sorted_paths,pb)\n" +
"    b=bisect.bisect_left(sorted_paths,pb+b'\\xff\\xff\\xff\\xff')\n" +
"    return b-a\n" +
"\n" +
"def build_prefixes(rows,n=QUERIES):\n" +
"    out=[]\n" +
"    for k in range(n):\n" +
"        r=rows[k%len(rows)][0]\n" +
"        slash=r.rfind('/')\n" +
"        out.append(r[:slash] if slash>0 else r[:8])\n" +
"    return out\n" +
"\n" +
"def diff_test(rows,sorted_paths,prefixes):\n" +
"    mm=0\n" +
"    for p in prefixes[:10]:\n" +
"        o=old_lookup(rows,p); n=new_lookup(sorted_paths,p)\n" +
"        if o!=n:\n" +
"            mm+=1\n" +
"            print(f'    DIFF prefix={p} old={o} new={n}')\n" +
"    return mm\n" +
"\n" +
"def real_probe_summary():\n" +
"    home=os.environ.get('HOME','')\n" +
"    if not home: return\n" +
"    g=home+'/Library/Application Support/com.apple.sharedfilelist/'\n" +
"    files=sorted(set(glob.glob(g+'*.sfl3')+glob.glob(g+'*.sfl4')))\n" +
"    if not files:\n" +
"        print('  real-probe: no sfl3/sfl4 present'); return\n" +
"    print(f'  real-probe: {len(files)} sfl3/sfl4 files')\n" +
"    total_paths=0; total_bytes=0\n" +
"    t0=time.perf_counter_ns()\n" +
"    for f in files:\n" +
"        with open(f,'rb') as fd: data=fd.read()\n" +
"        total_bytes+=len(data)\n" +
"        if data[:8]!=b'bplist00': continue\n" +
"        try: p=plistlib.loads(data)\n" +
"        except Exception: continue\n" +
"        objs=p.get('$objects') if isinstance(p,dict) else None\n" +
"        if not isinstance(objs,(list,tuple)): continue\n" +
"        acc=set()\n" +
"        for o in objs:\n" +
"            if isinstance(o,bytes):\n" +
"                for m in PATH_RE.finditer(o):\n" +
"                    s=m.group(0)\n" +
"                    if 5<len(s)<2048: acc.add(s.decode('utf-8','replace'))\n" +
"            elif isinstance(o,str) and o.startswith(('/Users/','/Applications/','/Volumes/','/System/','/Library/')):\n" +
"                if 5<len(o)<2048: acc.add(o)\n" +
"        total_paths+=len(acc)\n" +
"    t1=time.perf_counter_ns()\n" +
"    print(f'  real-probe parse: {(t1-t0)/1e6:.1f} ms  bytes={fmt(total_bytes)}  paths_extracted={total_paths}')\n" +
"\n" +
"def bench():\n" +
"    print(f'airgenome bench/K2 — sharedfilelist recent KSFL (linear vs blob bisect)')\n" +
"    print(f'  N_SYNTH={N_SYNTH} QUERIES={QUERIES}')\n" +
"    rows=synth()\n" +
"    info=encode(rows)\n" +
"    sorted_paths=[p.encode('utf-8','replace') for p,_ in info['rows']]\n" +
"    print(f'  encode (sort + KSFL): {info[\"encode_ns\"]/1e6:.1f}ms  blob={fmt(info[\"blob_size\"])}  n={info[\"n\"]}')\n" +
"    prefixes=build_prefixes(info['rows'])\n" +
"    mm=diff_test(info['rows'],sorted_paths,prefixes)\n" +
"    print(f'  diff_test (subset 10) mismatches: {mm}')\n" +
"    if mm!=0: print('BENCH FAIL [diff_test != 0]'); return\n" +
"    SAMPLE_N=20\n" +
"    t0=time.perf_counter_ns()\n" +
"    for k in range(SAMPLE_N):\n" +
"        old_lookup(info['rows'],prefixes[k%len(prefixes)])\n" +
"    t1=time.perf_counter_ns()\n" +
"    per_old=(t1-t0)//SAMPLE_N\n" +
"    extrap=per_old*QUERIES\n" +
"    print(f'  OLD (linear scan)         sample={SAMPLE_N}  per_query_ns={per_old}  extrap_total_ns={extrap}')\n" +
"    t0=time.perf_counter_ns()\n" +
"    for k in range(QUERIES):\n" +
"        new_lookup(sorted_paths,prefixes[k%len(prefixes)])\n" +
"    t1=time.perf_counter_ns()\n" +
"    per_new=(t1-t0)//QUERIES if QUERIES>0 else 0\n" +
"    print(f'  NEW (KSFL mmap+bisect)    total_ns={t1-t0}  per_query_ns={per_new}')\n" +
"    if per_new>0:\n" +
"        ratio=per_old/per_new\n" +
"        saved=((per_old-per_new)*100)//per_old if per_old>0 else 0\n" +
"        print(f'  per-query speedup={ratio:.1f}x  saved={saved}%')\n" +
"        amort_per=info['encode_ns']//QUERIES\n" +
"        eff=per_new+amort_per\n" +
"        print(f'  + sort+encode amortized: {amort_per}ns/query -> effective {eff}ns/query')\n" +
"        if eff>0:\n" +
"            print(f'  effective speedup (with encode cost)={per_old/eff:.1f}x')\n" +
"    print(f'  5-tuple: site=K2 ROI#=K2 baseline_ns={per_old} post_ns={per_new} diff_test=lossless')\n" +
"    real_probe_summary()\n" +
"\n" +
"bench()\n"

fn run() {
    let tmp_py = "/tmp/bench_k2_sharedfilelist_" + exec("date +%s%N").trim() + ".py"
    write_file(tmp_py, PAYLOAD)
    let cmd = "/usr/bin/perl -e 'alarm 120; exec @ARGV' /usr/bin/python3 '" + tmp_py + "' 2>&1; rm -f '" + tmp_py + "'"
    let result = exec(cmd)
    print(result)
}

run()
