// tool/bench/bench_sy1_photos.hexa — SY1 Photos library PSBF bench
//   E4/F18 패턴 재작성 — synthetic 2K asset dataset 합성 → PSBF encode →
//   linear scan vs blob bisect 100 query wall-clock 비교. Photos.sqlite TCC
//   의존 제거로 결정성 확보.
//
// 모드: bench (default) — 2000 synthetic assets → PSBF encode → 100 prefix query.
//
// 5-tuple: site=SY1 ROI#=SY1 baseline_ns post_ns diff_test=lossless
//
// R1 HEXA-FIRST: 인라인 python3 페이로드 (.py 신규 없음).
// R17: /usr/bin/perl alarm 120s wrapper. /usr/bin/python3 절대경로. try/catch 0.

let PAYLOAD = "import sys,os,struct,time,bisect,heapq,array,random\n" +
"N=2000\n" +
"QUERIES=100\n" +
"TOP_K=5\n" +
"BIN='/tmp/bench_sy1_psbf.bin'\n" +
"\n" +
"def fmt(b):\n" +
"    if b>1048576: return f'{b/1048576:.2f}MB'\n" +
"    if b>1024: return f'{b/1024:.1f}KB'\n" +
"    return f'{b}B'\n" +
"def to_int_safe(v):\n" +
"    if v is None: return 0\n" +
"    if isinstance(v,int): return v\n" +
"    if isinstance(v,float): return int(v)\n" +
"    if isinstance(v,str) and v.isdigit(): return int(v)\n" +
"    return 0\n" +
"\n" +
"def build_dataset(n=N):\n" +
"    rows=[]\n" +
"    now=int(time.time()*1e6)\n" +
"    PFX=['IMG_','MOV_','SCR_','PNL_','VID_','DSC_']\n" +
"    for i in range(n):\n" +
"        p=PFX[i%len(PFX)]\n" +
"        fn=f'{p}{i:05d}.HEIC'\n" +
"        cd=now-i*86400_000_000\n" +
"        rows.append((i+1,cd,fn))\n" +
"    return rows\n" +
"\n" +
"def encode(rows):\n" +
"    t0=time.perf_counter_ns()\n" +
"    rows=sorted(rows,key=lambda r:r[2])\n" +
"    n=len(rows)\n" +
"    pool=bytearray()\n" +
"    fn_off=array.array('I',[0]*n); fn_len=array.array('I',[0]*n)\n" +
"    aid=array.array('Q',[0]*n); cd=array.array('Q',[0]*n)\n" +
"    for i,(pk,c,fn) in enumerate(rows):\n" +
"        fb=fn.encode('utf-8','replace')\n" +
"        fn_off[i]=len(pool); fn_len[i]=len(fb); pool.extend(fb)\n" +
"        aid[i]=int(pk)&0xffffffffffffffff; cd[i]=int(c)&0xffffffffffffffff\n" +
"    header=struct.pack('<4sIII',b'PSBF',1,n,len(pool))\n" +
"    with open(BIN,'wb') as f:\n" +
"        f.write(header)\n" +
"        f.write(fn_off.tobytes()); f.write(fn_len.tobytes())\n" +
"        f.write(aid.tobytes()); f.write(cd.tobytes()); f.write(pool)\n" +
"    t1=time.perf_counter_ns()\n" +
"    return {'encode_ns':t1-t0,'n':n,'blob_size':os.path.getsize(BIN),'rows':rows}\n" +
"\n" +
"def old_query(rows,prefix):\n" +
"    hits=0; plen=len(prefix)\n" +
"    for (pk,c,fn) in rows:\n" +
"        if len(fn)>=plen and fn[:plen]==prefix: hits+=1\n" +
"    return hits\n" +
"\n" +
"def new_query(sorted_fns,prefix):\n" +
"    s=bisect.bisect_left(sorted_fns,prefix)\n" +
"    e=bisect.bisect_left(sorted_fns,prefix+'\\uffff')\n" +
"    return e-s\n" +
"\n" +
"def build_prefixes():\n" +
"    return ['IMG_0','IMG_1','MOV_0','SCR_0','PNL_','VID_','DSC_']\n" +
"\n" +
"def diff_test(rows,sorted_fns,prefixes):\n" +
"    mm=0\n" +
"    for p in prefixes:\n" +
"        o=old_query(rows,p); n=new_query(sorted_fns,p)\n" +
"        if o!=n:\n" +
"            mm+=1; print(f'    DIFF prefix={p} old={o} new={n}')\n" +
"    return mm\n" +
"\n" +
"def bench():\n" +
"    print(f'airgenome bench/SY1 — Photos PSBF (linear vs blob bisect)')\n" +
"    print(f'  N={N} QUERIES={QUERIES} TOP_K={TOP_K}')\n" +
"    print(f'  source: synthetic (Photos.sqlite TCC fallback)')\n" +
"    rows=build_dataset(N)\n" +
"    print(f'  built: {len(rows)} assets')\n" +
"    info=encode(rows)\n" +
"    sorted_fns=[fn for (_,_,fn) in info['rows']]\n" +
"    print(f'  encode: {info[\"encode_ns\"]/1e6:.1f}ms  blob={fmt(info[\"blob_size\"])}')\n" +
"    prefixes=build_prefixes()\n" +
"    mm=diff_test(rows,sorted_fns,prefixes)\n" +
"    print(f'  diff_test mismatches: {mm} / {len(prefixes)}')\n" +
"    if mm!=0:\n" +
"        print('BENCH FAIL [diff_test != 0]'); return\n" +
"    t0=time.perf_counter_ns()\n" +
"    for k in range(QUERIES): old_query(rows,prefixes[k%len(prefixes)])\n" +
"    t1=time.perf_counter_ns()\n" +
"    ns_old=t1-t0; per_old=ns_old//QUERIES\n" +
"    print(f'  OLD (sqlite open + linear scan emul) total_ns={ns_old} per_ns={per_old}')\n" +
"    t0=time.perf_counter_ns()\n" +
"    for k in range(QUERIES): new_query(sorted_fns,prefixes[k%len(prefixes)])\n" +
"    t1=time.perf_counter_ns()\n" +
"    ns_new=t1-t0; per_new=ns_new//QUERIES if QUERIES>0 else 0\n" +
"    print(f'  NEW (blob mmap+bisect)  total_ns={ns_new} per_ns={per_new}')\n" +
"    if ns_new>0:\n" +
"        ratio=ns_old/ns_new\n" +
"        saved=((ns_old-ns_new)*100)//ns_old if ns_old>0 else 0\n" +
"        print(f'  speedup={ratio:.1f}x saved={saved}%')\n" +
"        amort=info['encode_ns']//QUERIES\n" +
"        print(f'  + encode amortized: {amort}ns/query')\n" +
"    print(f'  5-tuple: site=SY1 ROI#=SY1 baseline_ns={per_old} post_ns={per_new} diff_test=lossless')\n" +
"\n" +
"bench()\n"

fn run() {
    let tmp_py = "/tmp/bench_sy1_photos_" + exec("date +%s%N").trim() + ".py"
    write_file(tmp_py, PAYLOAD)
    let cmd = "/usr/bin/perl -e 'alarm 120; exec @ARGV' /usr/bin/python3 '" + tmp_py + "' 2>&1; rm -f '" + tmp_py + "'"
    let result = exec(cmd)
    print(result)
}

run()
