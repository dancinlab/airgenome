// tool/bench/bench_c12_session_metric.hexa — C12 5-tuple bench
//
// Target: filters/module/data/claude_session_statusline_metric.hexa
// Pattern: F45 Safari tabs 변종 — per-session jq-multi-fork → awk 1 fork
//
// OLD (per session):
//   1) jq -r '.type' <jsonl> | wc -l                            → 2 fork
//   2) jq -r '.message.content[]?.type'  | grep -c tool_use     → 2 fork
//   3) jq -r '.message.usage.input_tokens // 0'  | awk sum      → 2 fork
//   4) jq -r '... output_tokens'                                → 2 fork
//   5) jq -r '... cache_creation_input_tokens'                  → 2 fork
//   6) jq -r '.toolUseResult.is_error // false' | grep -c true  → 2 fork
//   7) jq -r '.timestamp' | head -1                             → 2 fork
//   8) jq -r '.timestamp' | tail -1                             → 2 fork
//   9) jq -r '... file_path' | sort -u | wc -l                  → 3 fork
//   합계: ~19 fork/session × N session.
//
// NEW (per session):
//   1) awk 1 fork: msg/tool/token/error/min_ts/max_ts/cwd 동시 추출
//   2) awk 1 fork: file_touched (sort -u | wc -l)
//   3) gdate 2 fork: epoch diff (wall_min)
//   합계: ~5 fork/session 고정.
//
// 측정 환경: HEXA_RESOLVER_NO_REROUTE=1 HEXA_SHIM_NO_DARWIN_LANDING=1, gdate.

use "../../airgenome/core/airgenome"

fn is_numeric_str(s: str) -> bool {
    let n = len(s)
    if n == 0 { return false }
    let mut i = 0
    if s.substring(0, 1) == "-" { i = 1 }
    if i >= n { return false }
    while i < n {
        let c = s.substring(i, i + 1)
        if c < "0" { return false }
        if c > "9" { return false }
        i = i + 1
    }
    return true
}
fn to_int_safe(s: str) -> int {
    let trimmed = s.trim()
    if trimmed == "" { return 0 }
    let parts = trimmed.split(".")
    if len(parts) == 0 { return 0 }
    let head = parts[0]
    if head == "" { return 0 }
    if !is_numeric_str(head) { return 0 }
    return to_int(head)
}

let SAMPLE_JSONL = "/Users/ghost/.claude-claude1/projects/-Users-ghost-core-airgenome/0546427f-3c43-464e-af6a-034b9a268214.jsonl"
let SYNTH_JSONL = "/tmp/airgenome_bench_c12.jsonl"
let SYNTH_LINES = 200
let CYCLES = 3       // 동일 file 3회 — 평균치

fn now_ns() -> str { return exec("gdate +%s%N").trim() }
fn ns_diff(t0: str, t1: str) -> int { return to_int_safe(t1) - to_int_safe(t0) }

fn build_synth() -> void {
    let _ = exec("rm -f '" + SYNTH_JSONL + "'")
    let cmd = "awk 'BEGIN { for (i=0;i<" + to_string(SYNTH_LINES) + ";i++) { it=100+(i%900); cc=200+(i*3%5000); cr=1000+(i*7%20000); ot=20+(i%200); ttype=(i%4==0)?\"tool_use\":\"text\"; printf \"{\\\"type\\\":\\\"assistant\\\",\\\"uuid\\\":\\\"u%d\\\",\\\"timestamp\\\":\\\"2026-04-30T00:%02d:%02dZ\\\",\\\"cwd\\\":\\\"/Users/ghost/core/airgenome\\\",\\\"message\\\":{\\\"content\\\":[{\\\"type\\\":\\\"%s\\\",\\\"name\\\":\\\"Edit\\\",\\\"input\\\":{\\\"file_path\\\":\\\"/tmp/f%d.txt\\\"}}],\\\"usage\\\":{\\\"input_tokens\\\":%d,\\\"cache_creation_input_tokens\\\":%d,\\\"cache_read_input_tokens\\\":%d,\\\"output_tokens\\\":%d}}}\\n\", i, i/60, i%60, ttype, i%20, it, cc, cr, ot } }' > '" + SYNTH_JSONL + "'"
    let _ = exec(cmd)
}

fn pick_target() -> str {
    if file_exists(SAMPLE_JSONL) { return SAMPLE_JSONL }
    build_synth()
    return SYNTH_JSONL
}

// OLD: 9개 jq fork 시뮬
fn old_session(path: str) -> int {
    let _msg = exec("jq -r '.type' '" + path + "' 2>/dev/null | wc -l").trim()
    let _tool = exec("jq -r '.message.content[]?.type // \"\"' '" + path + "' 2>/dev/null | grep -c tool_use").trim()
    let _it = exec("jq -r '.message.usage.input_tokens // 0' '" + path + "' 2>/dev/null | awk '{s+=$1}END{print s}'").trim()
    let _ot = exec("jq -r '.message.usage.output_tokens // 0' '" + path + "' 2>/dev/null | awk '{s+=$1}END{print s}'").trim()
    let _cc = exec("jq -r '.message.usage.cache_creation_input_tokens // 0' '" + path + "' 2>/dev/null | awk '{s+=$1}END{print s}'").trim()
    let _err = exec("jq -r '.toolUseResult.is_error // false' '" + path + "' 2>/dev/null | grep -c true").trim()
    let _min = exec("jq -r '.timestamp // empty' '" + path + "' 2>/dev/null | head -1").trim()
    let _max = exec("jq -r '.timestamp // empty' '" + path + "' 2>/dev/null | tail -1").trim()
    let _f = exec("jq -r '.message.content[]? | select(.name==\"Edit\" or .name==\"Write\" or .name==\"Read\") | .input.file_path // empty' '" + path + "' 2>/dev/null | sort -u | wc -l").trim()
    return to_int_safe(_msg)
}

// NEW: awk 1 fork + file_touched 1 fork
fn new_session(path: str) -> int {
    let awk_prog = "BEGIN{ msg=0; tools=0; tok=0; err=0; min_ts=\"\"; max_ts=\"\"; cwd=\"\" } " +
        "{ msg++; " +
        "  n=split($0,_,\"\\\"type\\\":\\\"tool_use\\\"\"); if (n>1) tools+=(n-1); " +
        "  n=split($0,_,\"\\\"input_tokens\\\":\"); if (n>1) { for(k=2;k<=n;k++){ s=_[k]; m=0; v=0; while(m<length(s)){ ch=substr(s,m+1,1); if (ch>=\"0\" && ch<=\"9\") { v=v*10+(ch+0); m++ } else break } tok+=v } } " +
        "  n=split($0,_,\"\\\"output_tokens\\\":\"); if (n>1) { for(k=2;k<=n;k++){ s=_[k]; m=0; v=0; while(m<length(s)){ ch=substr(s,m+1,1); if (ch>=\"0\" && ch<=\"9\") { v=v*10+(ch+0); m++ } else break } tok+=v } } " +
        "  n=split($0,_,\"\\\"cache_creation_input_tokens\\\":\"); if (n>1) { for(k=2;k<=n;k++){ s=_[k]; m=0; v=0; while(m<length(s)){ ch=substr(s,m+1,1); if (ch>=\"0\" && ch<=\"9\") { v=v*10+(ch+0); m++ } else break } tok+=v } } " +
        "  if (index($0,\"\\\"is_error\\\":true\")) err++; " +
        "  p=index($0,\"\\\"timestamp\\\":\\\"\"); if (p>0) { rest=substr($0,p+14); q=index(rest,\"\\\"\"); if (q>0) { t=substr(rest,1,q-1); if (min_ts==\"\" || t<min_ts) min_ts=t; if (t>max_ts) max_ts=t } } " +
        "} END{ printf \"%d|%d|%d|%d|%s|%s\", msg, tools, tok, err, min_ts, max_ts }"
    let cmd = "awk '" + awk_prog.replace("'", "'\\''") + "' '" + path + "' 2>/dev/null"
    let raw = exec(cmd).trim()
    let parts = raw.split("|")
    let msg = if len(parts) >= 1 { to_int_safe(parts[0]) } else { 0 }
    let _f = exec("awk '/\"name\":\"(Edit|Write|Read)\"/{ p=index($0,\"\\\"file_path\\\":\\\"\"); if (p>0) { rest=substr($0,p+14); q=index(rest,\"\\\"\"); if (q>0) print substr(rest,1,q-1) } }' '" + path + "' 2>/dev/null | sort -u | wc -l").trim()
    return msg
}

fn diff_test(path: str) -> int {
    let no = old_session(path)
    let nn = new_session(path)
    if no != nn {
        println("    DIFF msg_count old=" + to_string(no) + " new=" + to_string(nn))
        return 1
    }
    return 0
}

pub fn run_bench() -> int {
    println("airgenome bench/C12 — claude_session_statusline_metric (per-session 9 jq fork → awk 2 fork)")
    let target = pick_target()
    println("  target=" + target + " CYCLES=" + to_string(CYCLES))
    let n_lines = exec("wc -l < '" + target + "'").trim()
    let n_bytes = exec("wc -c < '" + target + "'").trim()
    println("  jsonl lines=" + n_lines + " bytes=" + n_bytes)

    let mm = diff_test(target)
    println("  diff_test (msg_count parity): " + to_string(mm))
    if mm != 0 { println("BENCH WARN [msg_count differs] — possibly multi-line content (acceptable for parity check)") }

    // OLD: per-session 9 jq fork
    let t0 = now_ns()
    let mut k = 0
    while k < CYCLES { let _ = old_session(target); k = k + 1 }
    let t1 = now_ns()
    let ns_old = ns_diff(t0, t1)
    println("  OLD (9 jq fork ×" + to_string(CYCLES) + ") total_ns=" + to_string(ns_old) + "  per_session_ns=" + to_string(ns_old / CYCLES))

    // NEW: per-session awk 2 fork
    let t0n = now_ns()
    let mut k2 = 0
    while k2 < CYCLES { let _ = new_session(target); k2 = k2 + 1 }
    let t1n = now_ns()
    let ns_new = ns_diff(t0n, t1n)
    println("  NEW (awk 2 fork ×" + to_string(CYCLES) + ") total_ns=" + to_string(ns_new) + "  per_session_ns=" + to_string(ns_new / CYCLES))

    if ns_new > 0 {
        let ratio = ns_old / ns_new
        let saved = ((ns_old - ns_new) * 100) / ns_old
        println("  speedup=" + to_string(ratio) + "x  saved=" + to_string(saved) + "%")
    }
    return 0
}

fn main() -> void {
    let _ = run_bench()
}
