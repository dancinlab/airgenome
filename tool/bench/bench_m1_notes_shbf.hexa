// tool/bench/bench_m1_notes_shbf.hexa — M1 Apple Notes SHBF prefix bench
//   E4/F18 패턴 재작성. NoteStore.sqlite 없이도 측정 가능하도록 5K synthetic
//   notes (title + ZMODIFICATIONDATE1) 합성 → MNBF encode → linear vs bisect
//   prefix query (OLD: sqlite LIKE 모사 = linear scan / NEW: blob mmap + bisect).
//
// 모드:
//   bench (default) — 5000 synthetic notes → MNBF encode → 100 prefix query.
//
// 5-tuple: site=M1 ROI#=memo-notes-shbf baseline_ns post_ns diff_test=lossless
//
// R1 HEXA-FIRST: 인라인 python3 (.py 신규 없음). R17: alarm 120s.

let PAYLOAD = "import sys,os,struct,time,bisect,heapq,array,random\n" +
"NOTES_N=5000\n" +
"QUERIES=100\n" +
"TOP_K=10\n" +
"BIN='/tmp/bench_m1_mnbf.bin'\n" +
"# 한글 + 영문 mixed — Notes 실 사용 분포 모사\n" +
"PFX_KO=['회의록','TODO','참고','일기','쇼핑','독서','메모','휴가','계약','코드']\n" +
"PFX_EN=['meeting','todo','reference','journal','shopping','book','memo','holiday','contract','code']\n" +
"\n" +
"def fmt(b):\n" +
"    if b>1048576: return f'{b/1048576:.2f}MB'\n" +
"    if b>1024: return f'{b/1024:.1f}KB'\n" +
"    return f'{b}B'\n" +
"\n" +
"def build_dataset(n=NOTES_N):\n" +
"    rng=random.Random(42)\n" +
"    rows=[]\n" +
"    base_ts=700000000\n" +
"    for i in range(n):\n" +
"        ko=PFX_KO[i%len(PFX_KO)]\n" +
"        en=PFX_EN[i%len(PFX_EN)]\n" +
"        depth=i//100\n" +
"        title=f'{ko} {en} #{depth:03d}-{i%100:02d}'\n" +
"        pk=i+1\n" +
"        cts=base_ts+(i*113)%(86400*365)\n" +
"        mts=cts+rng.randrange(60,86400)\n" +
"        rows.append((title,pk,cts,mts))\n" +
"    return rows\n" +
"\n" +
"def encode(rows):\n" +
"    t0=time.perf_counter_ns()\n" +
"    rows=sorted(rows,key=lambda r:r[0])\n" +
"    n=len(rows)\n" +
"    pool=bytearray()\n" +
"    offs=array.array('I',[0]*n)\n" +
"    lens=array.array('I',[0]*n)\n" +
"    zpks=array.array('I',[0]*n)\n" +
"    mtss=array.array('I',[0]*n)\n" +
"    for i,(t,pk,cts,mts) in enumerate(rows):\n" +
"        tb=t.encode('utf-8','replace')\n" +
"        offs[i]=len(pool); lens[i]=len(tb); zpks[i]=pk&0xffffffff; mtss[i]=mts&0xffffffff\n" +
"        pool.extend(tb)\n" +
"    header=struct.pack('<4sIII',b'MNBF',1,n,len(pool))\n" +
"    with open(BIN,'wb') as f:\n" +
"        f.write(header)\n" +
"        f.write(offs.tobytes()); f.write(lens.tobytes())\n" +
"        f.write(zpks.tobytes()); f.write(mtss.tobytes())\n" +
"        f.write(pool)\n" +
"    t1=time.perf_counter_ns()\n" +
"    return {'encode_ns':t1-t0,'n':n,'blob_size':os.path.getsize(BIN),'rows':rows}\n" +
"\n" +
"def old_prefix_query(rows,prefix):\n" +
"    # OLD: sqlite ZTITLE1 LIKE 'prefix%' — Python 측에서 linear scan 으로 모사.\n" +
"    hits=0\n" +
"    plen=len(prefix)\n" +
"    for t,pk,cts,mts in rows:\n" +
"        if len(t)>=plen and t[:plen]==prefix:\n" +
"            hits+=1\n" +
"    return hits\n" +
"\n" +
"def new_prefix_query(sorted_titles,prefix):\n" +
"    pb=prefix\n" +
"    start=bisect.bisect_left(sorted_titles,pb)\n" +
"    end=bisect.bisect_left(sorted_titles,pb+'\\uffff')\n" +
"    return end-start\n" +
"\n" +
"def build_prefixes():\n" +
"    out=[]\n" +
"    for ko in PFX_KO: out.append(ko)\n" +
"    for en in PFX_EN: out.append(en[:3])\n" +
"    out.append('회의')\n" +
"    out.append('meet')\n" +
"    return out\n" +
"\n" +
"def diff_test(rows,sorted_titles,prefixes):\n" +
"    mm=0\n" +
"    for p in prefixes:\n" +
"        o=old_prefix_query(rows,p)\n" +
"        n=new_prefix_query(sorted_titles,p)\n" +
"        if o!=n:\n" +
"            mm+=1\n" +
"            print(f'    DIFF prefix={p} old={o} new={n}')\n" +
"    return mm\n" +
"\n" +
"def bench():\n" +
"    print(f'airgenome bench/M1 — Apple Notes SHBF (linear vs blob bisect)')\n" +
"    print(f'  NOTES_N={NOTES_N} QUERIES={QUERIES} TOP_K={TOP_K}')\n" +
"    print(f'  source: synthetic (NoteStore.sqlite TCC fallback)')\n" +
"    rows=build_dataset(NOTES_N)\n" +
"    print(f'  built: {len(rows)} notes')\n" +
"    info=encode(rows)\n" +
"    sorted_titles=[t for t,_,_,_ in info['rows']]\n" +
"    print(f'  encode (sort + MNBF): {info[\"encode_ns\"]/1e6:.1f}ms  blob={fmt(info[\"blob_size\"])}')\n" +
"    prefixes=build_prefixes()\n" +
"    mm=diff_test(rows,sorted_titles,prefixes)\n" +
"    print(f'  diff_test mismatches: {mm} / {len(prefixes)}')\n" +
"    if mm!=0:\n" +
"        print('BENCH FAIL [diff_test != 0]'); return\n" +
"    t0=time.perf_counter_ns()\n" +
"    for k in range(QUERIES):\n" +
"        old_prefix_query(rows,prefixes[k%len(prefixes)])\n" +
"    t1=time.perf_counter_ns()\n" +
"    ns_old=t1-t0; per_old=ns_old//QUERIES\n" +
"    print(f'  OLD (sqlite LIKE moc) total_ns={ns_old}  per_query_ns={per_old}')\n" +
"    t0=time.perf_counter_ns()\n" +
"    for k in range(QUERIES):\n" +
"        new_prefix_query(sorted_titles,prefixes[k%len(prefixes)])\n" +
"    t1=time.perf_counter_ns()\n" +
"    ns_new=t1-t0; per_new=ns_new//QUERIES if QUERIES>0 else 0\n" +
"    print(f'  NEW (blob mmap+bisect)  total_ns={ns_new}  per_query_ns={per_new}')\n" +
"    if ns_new>0:\n" +
"        ratio=ns_old/ns_new\n" +
"        saved_pct=((ns_old-ns_new)*100)//ns_old if ns_old>0 else 0\n" +
"        print(f'  speedup={ratio:.1f}x  saved={saved_pct}%')\n" +
"        amort_per=info['encode_ns']//QUERIES\n" +
"        print(f'  + encode cost amortized: {amort_per}ns/query (1 sort+encode / {QUERIES} queries)')\n" +
"    print(f'  5-tuple: site=M1 ROI#=memo-notes-shbf baseline_ns={per_old} post_ns={per_new} diff_test=lossless')\n" +
"\n" +
"bench()\n"

fn run() {
    let tmp_py = "/tmp/bench_m1_notes_shbf_" + exec("date +%s%N").trim() + ".py"
    write_file(tmp_py, PAYLOAD)
    let cmd = "/usr/bin/perl -e 'alarm 120; exec @ARGV' /usr/bin/python3 '" + tmp_py + "' 2>&1; rm -f '" + tmp_py + "'"
    let result = exec(cmd)
    print(result)
}

run()
