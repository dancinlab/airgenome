// tool/bench/bench_f58_autocomplete.hexa — F58 autocomplete prefix match bench
//   E4 패턴 재작성 (commit 04193c6a 동일 PAYLOAD inline).
//   현 hexa-pure 구현이 hexa list O(n²) — 100K dataset 에서 timeout (URLS_N=100000).
//   해결: 100K synthetic URLs + APBF encode + 1000 prefix query (linear vs bisect)
//         전체를 python stdlib (struct/array/bisect/time) 로 native 수행.
//
// 모드:
//   bench (default) — 100K synthetic URLs → APBF encode → 1000 prefix query
//                     (linear vs bisect on sorted blob).
//
// 5-tuple: site=F58 ROI#=58 baseline_ns post_ns diff_test=lossless
//
// R1 HEXA-FIRST: 인라인 python3 페이로드 (.py 신규 없음).
// R17: /usr/bin/perl alarm 120s wrapper. /usr/bin/python3 절대경로. try/catch 0.

let PAYLOAD = "import sys,os,struct,time,bisect,heapq,array\n" +
"URLS_N=100000\n" +
"QUERIES=1000\n" +
"TOP_K=10\n" +
"SAMPLE_N=50  # OLD linear extrapolation 표본 (full 1000 은 1억 ops — 비싸)\n" +
"BIN='/tmp/bench_f58_apbf.bin'\n" +
"DOMAINS=['github.com','google.com','stackoverflow.com','youtube.com','wikipedia.org','reddit.com','developer.mozilla.org','docs.python.org','news.ycombinator.com','twitter.com','apple.com','anthropic.com','openai.com','arxiv.org','medium.com','linkedin.com','amazon.com','netflix.com','spotify.com','dropbox.com']\n" +
"\n" +
"def fmt(b):\n" +
"    if b>1048576: return f'{b/1048576:.2f}MB'\n" +
"    if b>1024: return f'{b/1024:.1f}KB'\n" +
"    return f'{b}B'\n" +
"\n" +
"def build_dataset(n=URLS_N):\n" +
"    out=[]\n" +
"    for i in range(n):\n" +
"        d=DOMAINS[i%len(DOMAINS)]\n" +
"        path=f'/path{i}/page{i%137}'\n" +
"        out.append((f'https://{d}{path}',(i*7)%1000))\n" +
"    return out\n" +
"\n" +
"def encode(rows):\n" +
"    t0=time.perf_counter_ns()\n" +
"    rows=sorted(rows,key=lambda r:r[0])\n" +
"    n=len(rows)\n" +
"    pool=bytearray()\n" +
"    offs=array.array('I',[0]*n)\n" +
"    lens=array.array('I',[0]*n)\n" +
"    scs =array.array('I',[0]*n)\n" +
"    for i,(s,sc) in enumerate(rows):\n" +
"        sb=s.encode('utf-8','replace')\n" +
"        offs[i]=len(pool); lens[i]=len(sb); scs[i]=int(sc)&0xffffffff\n" +
"        pool.extend(sb)\n" +
"    header=struct.pack('<4sIII',b'APBF',1,n,len(pool))\n" +
"    with open(BIN,'wb') as f:\n" +
"        f.write(header)\n" +
"        f.write(offs.tobytes()); f.write(lens.tobytes()); f.write(scs.tobytes())\n" +
"        f.write(pool)\n" +
"    t1=time.perf_counter_ns()\n" +
"    return {'encode_ns':t1-t0,'n':n,'blob_size':os.path.getsize(BIN),'rows':rows}\n" +
"\n" +
"def old_prefix_query(rows,prefix):\n" +
"    # OLD: 매 query 마다 linear scan over rows.\n" +
"    hits=0\n" +
"    plen=len(prefix)\n" +
"    for u,_ in rows:\n" +
"        if len(u)>=plen and u[:plen]==prefix:\n" +
"            hits+=1\n" +
"    return hits\n" +
"\n" +
"def new_prefix_query(sorted_urls,prefix):\n" +
"    pb=prefix\n" +
"    start=bisect.bisect_left(sorted_urls,pb)\n" +
"    end=bisect.bisect_left(sorted_urls,pb+'\\uffff')\n" +
"    return end-start\n" +
"\n" +
"def build_prefixes():\n" +
"    ps=[]\n" +
"    for i in range(QUERIES):\n" +
"        d=DOMAINS[i%len(DOMAINS)]\n" +
"        kind=i%4\n" +
"        if kind==0: ps.append(f'https://{d}')\n" +
"        elif kind==1: ps.append(f'https://{d}/path{i%100}')\n" +
"        elif kind==2: ps.append(f'https://{d}/path')\n" +
"        else: ps.append(f'https://{d}/path1')\n" +
"    return ps\n" +
"\n" +
"def diff_test(rows,sorted_urls,prefixes,sample_n=20):\n" +
"    mm=0\n" +
"    step=max(1,len(prefixes)//sample_n)\n" +
"    i=0\n" +
"    cnt=0\n" +
"    while cnt<sample_n and i<len(prefixes):\n" +
"        p=prefixes[i]\n" +
"        o=old_prefix_query(rows,p)\n" +
"        n=new_prefix_query(sorted_urls,p)\n" +
"        if o!=n:\n" +
"            mm+=1\n" +
"            print(f'    DIFF prefix={p} old={o} new={n}')\n" +
"        i+=step; cnt+=1\n" +
"    return mm\n" +
"\n" +
"def bench():\n" +
"    print(f'airgenome bench/F58 — autocomplete prefix match (linear vs bisect)')\n" +
"    print(f'  URLS_N={URLS_N} QUERIES={QUERIES} TOP_K={TOP_K}')\n" +
"    t0=time.perf_counter_ns()\n" +
"    rows=build_dataset(URLS_N)\n" +
"    t1=time.perf_counter_ns()\n" +
"    print(f'  built: {len(rows)} urls in {(t1-t0)//1_000_000}ms')\n" +
"    info=encode(rows)\n" +
"    sorted_urls=[u for u,_ in info['rows']]\n" +
"    print(f'  encode (sort + APBF): {info[\"encode_ns\"]/1e6:.1f}ms  blob={fmt(info[\"blob_size\"])}')\n" +
"    print(f'  sorted len: {len(sorted_urls)}')\n" +
"    prefixes=build_prefixes()\n" +
"    print(f'  prefixes built: {len(prefixes)}')\n" +
"    mm=diff_test(rows,sorted_urls,prefixes,20)\n" +
"    print(f'  diff_test (subset 20) mismatches: {mm}')\n" +
"    if mm!=0:\n" +
"        print('BENCH FAIL [diff_test != 0]'); return\n" +
"    # OLD: linear scan SAMPLE_N → extrapolate. 100K * 1000 = 1억 ops 회피.\n" +
"    t0=time.perf_counter_ns()\n" +
"    for k in range(SAMPLE_N):\n" +
"        old_prefix_query(rows,prefixes[k%len(prefixes)])\n" +
"    t1=time.perf_counter_ns()\n" +
"    ns_old_sample=t1-t0\n" +
"    per_old=ns_old_sample//SAMPLE_N\n" +
"    extrap=per_old*QUERIES\n" +
"    print(f'  OLD (linear scan) sample={SAMPLE_N}  per_query_ns={per_old}  extrap_total_ns={extrap}')\n" +
"    # NEW: bisect 1000 query 전체.\n" +
"    t0=time.perf_counter_ns()\n" +
"    for k in range(QUERIES):\n" +
"        new_prefix_query(sorted_urls,prefixes[k%len(prefixes)])\n" +
"    t1=time.perf_counter_ns()\n" +
"    ns_new=t1-t0\n" +
"    per_new=ns_new//QUERIES if QUERIES>0 else 0\n" +
"    print(f'  NEW (bisect)      total_ns={ns_new}  per_query_ns={per_new}')\n" +
"    if per_new>0:\n" +
"        ratio=per_old/per_new\n" +
"        saved_pct=((per_old-per_new)*100)//per_old if per_old>0 else 0\n" +
"        print(f'  per-query speedup={ratio:.1f}x  saved={saved_pct}%')\n" +
"        amort_per=info['encode_ns']//QUERIES\n" +
"        amort_eff=per_new+amort_per\n" +
"        print(f'  + sort+encode amortized: {amort_per}ns/query → effective {amort_eff}ns/query')\n" +
"        if amort_eff>0:\n" +
"            print(f'  effective speedup (with encode cost)={per_old/amort_eff:.1f}x')\n" +
"    print(f'  5-tuple: site=F58 ROI#=58 baseline_ns={per_old} post_ns={per_new} diff_test=lossless')\n" +
"\n" +
"bench()\n"

fn run() {
    let tmp_py = "/tmp/bench_f58_autocomplete_" + exec("date +%s%N").trim() + ".py"
    write_file(tmp_py, PAYLOAD)
    // /usr/bin/python3 + perl alarm 120s. /usr/bin/perl 절대경로. try/catch 0.
    let cmd = "/usr/bin/perl -e 'alarm 120; exec @ARGV' /usr/bin/python3 '" + tmp_py + "' 2>&1; rm -f '" + tmp_py + "'"
    let result = exec(cmd)
    print(result)
}

run()
