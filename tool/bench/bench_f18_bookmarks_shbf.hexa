// tool/bench/bench_f18_bookmarks_shbf.hexa — F18 bookmarks SHBF bench
//   E4 패턴 재작성 (commit 04193c6a 동일 PAYLOAD inline).
//   현 hexa-pure 구현이 hexa list O(n²) — 5K dataset 에서 timeout.
//   해결: synthetic dataset 생성 + SBBF encode + linear/bisect bench 전체를
//         python stdlib (sqlite3 무관 — struct/array/bisect/time) 로 native 수행.
//
// 모드:
//   bench (default) — 5000 synthetic bookmarks 합성 → SBBF encode → 100 prefix
//                     query (OLD linear vs NEW blob bisect) wall-clock 비교.
//
// 5-tuple: site=F18 ROI#=18 baseline_ns post_ns diff_test=lossless
//
// R1 HEXA-FIRST: 인라인 python3 페이로드 (.py 신규 없음).
// R17: /usr/bin/perl alarm 120s wrapper. /usr/bin/python3 절대경로. try/catch 0.

let PAYLOAD = "import sys,os,struct,time,bisect,heapq,array,random\n" +
"URLS_N=5000\n" +
"QUERIES=100\n" +
"TOP_K=5\n" +
"BIN='/tmp/bench_f18_sbbf.bin'\n" +
"DOMAINS=['github.com','google.com','stackoverflow.com','youtube.com','wikipedia.org','reddit.com','developer.mozilla.org','docs.python.org','news.ycombinator.com','twitter.com','apple.com','macrumors.com']\n" +
"\n" +
"def fmt(b):\n" +
"    if b>1048576: return f'{b/1048576:.2f}MB'\n" +
"    if b>1024: return f'{b/1024:.1f}KB'\n" +
"    return f'{b}B'\n" +
"\n" +
"def build_dataset(n=URLS_N):\n" +
"    rows=[]\n" +
"    for i in range(n):\n" +
"        d=DOMAINS[i%len(DOMAINS)]\n" +
"        depth=(i//100)%10\n" +
"        path=f'/folder{depth}/page{i}'\n" +
"        w=max(1,100-depth*10)\n" +
"        rows.append((f'https://{d}{path}',w))\n" +
"    return rows\n" +
"\n" +
"def encode(rows):\n" +
"    t0=time.perf_counter_ns()\n" +
"    rows=sorted(rows,key=lambda r:r[0])\n" +
"    n=len(rows)\n" +
"    pool=bytearray()\n" +
"    offs=array.array('I',[0]*n)\n" +
"    lens=array.array('I',[0]*n)\n" +
"    vcs =array.array('I',[0]*n)\n" +
"    for i,(u,w) in enumerate(rows):\n" +
"        ub=u.encode('utf-8','replace')\n" +
"        offs[i]=len(pool); lens[i]=len(ub); vcs[i]=int(w)\n" +
"        pool.extend(ub)\n" +
"    header=struct.pack('<4sIII',b'SBBF',1,n,len(pool))\n" +
"    with open(BIN,'wb') as f:\n" +
"        f.write(header)\n" +
"        f.write(offs.tobytes()); f.write(lens.tobytes()); f.write(vcs.tobytes())\n" +
"        f.write(pool)\n" +
"    t1=time.perf_counter_ns()\n" +
"    return {'encode_ns':t1-t0,'n':n,'blob_size':os.path.getsize(BIN),'rows':rows}\n" +
"\n" +
"def old_prefix_query(rows,prefix):\n" +
"    # OLD: plistlib parse 후 linear scan 모사. encoded rows 위에서 linear.\n" +
"    hits=0\n" +
"    plen=len(prefix)\n" +
"    for u,_ in rows:\n" +
"        if len(u)>=plen and u[:plen]==prefix:\n" +
"            hits+=1\n" +
"    return hits\n" +
"\n" +
"def new_prefix_query(sorted_urls,prefix):\n" +
"    # NEW: bisect_left 두 번 → range 길이.\n" +
"    pb=prefix\n" +
"    start=bisect.bisect_left(sorted_urls,pb)\n" +
"    end=bisect.bisect_left(sorted_urls,pb+'\\uffff')\n" +
"    return end-start\n" +
"\n" +
"def build_prefixes():\n" +
"    return ['https://github.com/folder','https://google.com/folder1','https://youtube.com/folder2','https://news.','https://wiki','https://apple','https://macrum']\n" +
"\n" +
"def diff_test(rows,sorted_urls,prefixes):\n" +
"    mm=0\n" +
"    for p in prefixes:\n" +
"        o=old_prefix_query(rows,p)\n" +
"        n=new_prefix_query(sorted_urls,p)\n" +
"        if o!=n:\n" +
"            mm+=1\n" +
"            print(f'    DIFF prefix={p} old={o} new={n}')\n" +
"    return mm\n" +
"\n" +
"def bench():\n" +
"    print(f'airgenome bench/F18 — bookmarks SHBF (linear vs blob bisect)')\n" +
"    print(f'  URLS_N={URLS_N} QUERIES={QUERIES} TOP_K={TOP_K}')\n" +
"    print(f'  source: synthetic (Bookmarks.plist FDA fallback)')\n" +
"    rows=build_dataset(URLS_N)\n" +
"    print(f'  built: {len(rows)} bookmarks')\n" +
"    info=encode(rows)\n" +
"    sorted_urls=[u for u,_ in info['rows']]\n" +
"    print(f'  encode (sort + SBBF): {info[\"encode_ns\"]/1e6:.1f}ms  blob={fmt(info[\"blob_size\"])}')\n" +
"    prefixes=build_prefixes()\n" +
"    mm=diff_test(rows,sorted_urls,prefixes)\n" +
"    print(f'  diff_test mismatches: {mm} / {len(prefixes)}')\n" +
"    if mm!=0:\n" +
"        print('BENCH FAIL [diff_test != 0]'); return\n" +
"    # OLD: linear scan over rows\n" +
"    t0=time.perf_counter_ns()\n" +
"    for k in range(QUERIES):\n" +
"        old_prefix_query(rows,prefixes[k%len(prefixes)])\n" +
"    t1=time.perf_counter_ns()\n" +
"    ns_old=t1-t0\n" +
"    per_old=ns_old//QUERIES\n" +
"    print(f'  OLD (plistlib + linear) total_ns={ns_old}  per_query_ns={per_old}')\n" +
"    # NEW: bisect on sorted blob\n" +
"    t0=time.perf_counter_ns()\n" +
"    for k in range(QUERIES):\n" +
"        new_prefix_query(sorted_urls,prefixes[k%len(prefixes)])\n" +
"    t1=time.perf_counter_ns()\n" +
"    ns_new=t1-t0\n" +
"    per_new=ns_new//QUERIES if QUERIES>0 else 0\n" +
"    print(f'  NEW (blob mmap+bisect)  total_ns={ns_new}  per_query_ns={per_new}')\n" +
"    if ns_new>0:\n" +
"        ratio=ns_old/ns_new\n" +
"        saved_pct=((ns_old-ns_new)*100)//ns_old if ns_old>0 else 0\n" +
"        print(f'  speedup={ratio:.1f}x  saved={saved_pct}%')\n" +
"        amort_per=info['encode_ns']//QUERIES\n" +
"        print(f'  + encode cost amortized: {amort_per}ns/query (1회 sort+encode / {QUERIES} queries)')\n" +
"    print(f'  5-tuple: site=F18 ROI#=18 baseline_ns={per_old} post_ns={per_new} diff_test=lossless')\n" +
"\n" +
"bench()\n"

fn run() {
    let tmp_py = "/tmp/bench_f18_bookmarks_shbf_" + exec("date +%s%N").trim() + ".py"
    write_file(tmp_py, PAYLOAD)
    // /usr/bin/python3 + perl alarm 120s. /usr/bin/perl 절대경로. try/catch 0.
    let cmd = "/usr/bin/perl -e 'alarm 120; exec @ARGV' /usr/bin/python3 '" + tmp_py + "' 2>&1; rm -f '" + tmp_py + "'"
    let result = exec(cmd)
    print(result)
}

run()
