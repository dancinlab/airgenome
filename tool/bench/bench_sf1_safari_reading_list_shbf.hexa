// tool/bench/bench_sf1_safari_reading_list_shbf.hexa — SF1 Reading List SHBF bench
//   pattern: bench_f18_bookmarks_shbf.hexa
//   synthetic 200-row Reading List dataset → SRLF encode → linear vs bisect.
//
// 5-tuple: site=SF1 ROI#=1 baseline_ns post_ns diff_test=lossless
// R1 HEXA-FIRST + R17 /usr/bin/perl alarm 120s.

let PAYLOAD = "import sys,os,struct,time,bisect,heapq,array,random\n" +
"N=200\n" +
"QUERIES=50\n" +
"TOP_K=5\n" +
"BIN='/tmp/bench_sf1_srlf.bin'\n" +
"DOMAINS=['arxiv.org','medium.com','blog.cloudflare.com','rust-lang.org','python.org','news.ycombinator.com']\n" +
"\n" +
"def fmt(b):\n" +
"    if b>1048576: return f'{b/1048576:.2f}MB'\n" +
"    if b>1024: return f'{b/1024:.1f}KB'\n" +
"    return f'{b}B'\n" +
"\n" +
"def build_dataset(n=N):\n" +
"    rng=random.Random(42); base=int(time.time())\n" +
"    rows=[]\n" +
"    for i in range(n):\n" +
"        d=DOMAINS[i%len(DOMAINS)]\n" +
"        rows.append((f'https://{d}/article-{i:05d}',base-rng.randrange(0,86400*365)))\n" +
"    return rows\n" +
"\n" +
"def encode(rows):\n" +
"    t0=time.perf_counter_ns()\n" +
"    rows=sorted(rows,key=lambda r:r[0])\n" +
"    n=len(rows); pool=bytearray()\n" +
"    offs=array.array('I',[0]*n); lens=array.array('I',[0]*n); tss=array.array('I',[0]*n)\n" +
"    for i,(u,t) in enumerate(rows):\n" +
"        ub=u.encode('utf-8','replace')\n" +
"        offs[i]=len(pool); lens[i]=len(ub); tss[i]=int(t) & 0xFFFFFFFF\n" +
"        pool.extend(ub)\n" +
"    header=struct.pack('<4sIII',b'SRLF',1,n,len(pool))\n" +
"    with open(BIN,'wb') as f:\n" +
"        f.write(header); f.write(offs.tobytes()); f.write(lens.tobytes()); f.write(tss.tobytes()); f.write(pool)\n" +
"    t1=time.perf_counter_ns()\n" +
"    return {'encode_ns':t1-t0,'n':n,'blob_size':os.path.getsize(BIN),'rows':rows}\n" +
"\n" +
"def old_query(rows,prefix):\n" +
"    plen=len(prefix); hits=0\n" +
"    for u,_ in rows:\n" +
"        if len(u)>=plen and u[:plen]==prefix: hits+=1\n" +
"    return hits\n" +
"\n" +
"def new_query(sorted_urls,prefix):\n" +
"    s=bisect.bisect_left(sorted_urls,prefix)\n" +
"    e=bisect.bisect_left(sorted_urls,prefix+'\\uffff')\n" +
"    return e-s\n" +
"\n" +
"def build_prefixes():\n" +
"    return ['https://arxiv','https://medium.com/article','https://blog.','https://rust','https://python','https://news.','https://no-such']\n" +
"\n" +
"def diff_test(rows,sorted_urls,prefixes):\n" +
"    mm=0\n" +
"    for p in prefixes:\n" +
"        o=old_query(rows,p); n=new_query(sorted_urls,p)\n" +
"        if o!=n: mm+=1; print(f'    DIFF prefix={p} old={o} new={n}')\n" +
"    return mm\n" +
"\n" +
"def bench():\n" +
"    print(f'airgenome bench/SF1 — Reading List SHBF (linear vs blob bisect)')\n" +
"    print(f'  N={N} QUERIES={QUERIES} TOP_K={TOP_K}')\n" +
"    print(f'  source: synthetic (Bookmarks.plist Reading List subset typically empty)')\n" +
"    rows=build_dataset(N)\n" +
"    info=encode(rows)\n" +
"    sorted_urls=[u for u,_ in info['rows']]\n" +
"    print(f'  encode (sort + SRLF): {info[\"encode_ns\"]/1e6:.2f}ms blob={fmt(info[\"blob_size\"])}')\n" +
"    prefixes=build_prefixes()\n" +
"    mm=diff_test(rows,sorted_urls,prefixes)\n" +
"    print(f'  diff_test mismatches: {mm} / {len(prefixes)}')\n" +
"    if mm!=0: print('BENCH FAIL [diff_test != 0]'); return\n" +
"    t0=time.perf_counter_ns()\n" +
"    for k in range(QUERIES): old_query(rows,prefixes[k%len(prefixes)])\n" +
"    t1=time.perf_counter_ns(); ns_old=t1-t0; per_old=ns_old//QUERIES\n" +
"    print(f'  OLD (linear)            total_ns={ns_old}  per_query_ns={per_old}')\n" +
"    t0=time.perf_counter_ns()\n" +
"    for k in range(QUERIES): new_query(sorted_urls,prefixes[k%len(prefixes)])\n" +
"    t1=time.perf_counter_ns(); ns_new=t1-t0; per_new=ns_new//QUERIES if QUERIES>0 else 0\n" +
"    print(f'  NEW (blob mmap+bisect)  total_ns={ns_new}  per_query_ns={per_new}')\n" +
"    if ns_new>0:\n" +
"        ratio=ns_old/ns_new\n" +
"        saved_pct=((ns_old-ns_new)*100)//ns_old if ns_old>0 else 0\n" +
"        print(f'  speedup={ratio:.1f}x  saved={saved_pct}%')\n" +
"    print(f'  5-tuple: site=SF1 ROI#=1 baseline_ns={per_old} post_ns={per_new} diff_test=lossless')\n" +
"\n" +
"bench()\n"

fn run() {
    let tmp_py = "/tmp/bench_sf1_safari_reading_list_shbf_" + exec("date +%s%N").trim() + ".py"
    write_file(tmp_py, PAYLOAD)
    let cmd = "/usr/bin/perl -e 'alarm 120; exec @ARGV' /usr/bin/python3 '" + tmp_py + "' 2>&1; rm -f '" + tmp_py + "'"
    let result = exec(cmd)
    print(result)
}

run()
