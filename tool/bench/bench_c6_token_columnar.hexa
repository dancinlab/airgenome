// tool/bench/bench_c6_token_columnar.hexa — C6 5-tuple bench
//
// Target: filters/module/data/claude_token_columnar.hexa
// Pattern: jq full-scan + sum vs columnar projection sum (P3 columnar 변종)
//
// OLD (per query):
//   1) jq -r '<usage 4축 array>' <jsonl> | awk sum → 1 fork (jq) + 1 fork (awk)
//      jsonl 전체 스캔 + json parse 모든 레코드 (msg/content 등 무관 필드까지).
//
// NEW (1회 prep + N query):
//   1) prep: jq -r '@csv 4축' <jsonl> > .tokens.col → 1 fork (jq), 1회만.
//   2) query: awk sum < .tokens.col → 1 fork (awk), 컬럼만 스캔.
//   col 파일 size = ~3-5% raw.jsonl. 후속 sum/avg/percentile 모두 hit.
//
// 측정 환경: HEXA_RESOLVER_NO_REROUTE=1 HEXA_SHIM_NO_DARWIN_LANDING=1, gdate.

use "../../airgenome/core/airgenome"

fn is_numeric_str(s: str) -> bool {
    let n = len(s)
    if n == 0 { return false }
    let mut i = 0
    if s.substring(0, 1) == "-" { i = 1 }
    if i >= n { return false }
    while i < n {
        let c = s.substring(i, i + 1)
        if c < "0" { return false }
        if c > "9" { return false }
        i = i + 1
    }
    return true
}
fn to_int_safe(s: str) -> int {
    let trimmed = s.trim()
    if trimmed == "" { return 0 }
    let parts = trimmed.split(".")
    if len(parts) == 0 { return 0 }
    let head = parts[0]
    if head == "" { return 0 }
    if !is_numeric_str(head) { return 0 }
    return to_int(head)
}

let SAMPLE_JSONL = "/Users/ghost/.claude-claude1/projects/-Users-ghost-core-airgenome/0546427f-3c43-464e-af6a-034b9a268214.jsonl"
let SYNTH_JSONL = "/tmp/airgenome_bench_c6.jsonl"
let COL_PATH = "/tmp/airgenome_bench_c6.tokens.col"
let SYNTH_LINES = 400
let QUERIES = 5     // 동일 jsonl 에 sum 5회 — typical statusline reload

fn now_ns() -> str { return exec("gdate +%s%N").trim() }
fn ns_diff(t0: str, t1: str) -> int { return to_int_safe(t1) - to_int_safe(t0) }

// ── synthetic jsonl 생성 (실 sample 부재 fallback) ────────────────────
fn build_synth() -> void {
    let _ = exec("rm -f '" + SYNTH_JSONL + "'")
    let cmd = "awk 'BEGIN { for (i=0;i<" + to_string(SYNTH_LINES) + ";i++) { it=100+(i%900); cc=200+(i*3%5000); cr=1000+(i*7%20000); ot=20+(i%200); printf \"{\\\"type\\\":\\\"assistant\\\",\\\"uuid\\\":\\\"u%d\\\",\\\"timestamp\\\":\\\"2026-04-30T00:00:%02dZ\\\",\\\"message\\\":{\\\"content\\\":\\\"\\\",\\\"usage\\\":{\\\"input_tokens\\\":%d,\\\"cache_creation_input_tokens\\\":%d,\\\"cache_read_input_tokens\\\":%d,\\\"output_tokens\\\":%d}}}\\n\", i, i%60, it, cc, cr, ot } }' > '" + SYNTH_JSONL + "'"
    let _ = exec(cmd)
}

fn pick_target() -> str {
    if file_exists(SAMPLE_JSONL) { return SAMPLE_JSONL }
    build_synth()
    return SYNTH_JSONL
}

// OLD: jq full-scan + awk sum
fn old_query(jsonl_path: str) -> str {
    let jq_expr = "[(.message.usage.input_tokens // 0), (.message.usage.cache_creation_input_tokens // 0), (.message.usage.cache_read_input_tokens // 0), (.message.usage.output_tokens // 0)] | @csv"
    let cmd = "jq -r '" + jq_expr + "' '" + jsonl_path + "' 2>/dev/null | awk -F, '{a+=$1; b+=$2; c+=$3; d+=$4} END{printf \"%d %d %d %d\", a, b, c, d}'"
    return exec(cmd).trim()
}

// NEW prep: jq → csv col file
fn new_prep(jsonl_path: str) -> int {
    let _ = exec("rm -f '" + COL_PATH + "'")
    let jq_expr = "(.message.usage // {}) | [(.input_tokens // 0), (.cache_creation_input_tokens // 0), (.cache_read_input_tokens // 0), (.output_tokens // 0)] | @csv"
    let t0 = now_ns()
    let _ = exec("jq -r '" + jq_expr + "' '" + jsonl_path + "' > '" + COL_PATH + "' 2>/dev/null")
    let t1 = now_ns()
    return ns_diff(t0, t1)
}

// NEW query: awk sum on col
fn new_query() -> str {
    let cmd = "awk -F, '{a+=$1; b+=$2; c+=$3; d+=$4} END{printf \"%d %d %d %d\", a, b, c, d}' '" + COL_PATH + "'"
    return exec(cmd).trim()
}

fn diff_test(jsonl_path: str) -> int {
    let _ = new_prep(jsonl_path)
    let so = old_query(jsonl_path)
    let sn = new_query()
    if so != sn {
        println("    DIFF old=[" + so + "] new=[" + sn + "]")
        return 1
    }
    return 0
}

pub fn run_bench() -> int {
    println("airgenome bench/C6 — claude_token_columnar (jq full-scan + sum → col + sum)")
    let target = pick_target()
    println("  target=" + target + " QUERIES=" + to_string(QUERIES))
    let n_lines = exec("wc -l < '" + target + "'").trim()
    let n_bytes = exec("wc -c < '" + target + "'").trim()
    println("  jsonl lines=" + n_lines + " bytes=" + n_bytes)

    let mm = diff_test(target)
    println("  diff_test result: " + to_string(mm) + " (0 = lossless)")
    if mm != 0 { println("BENCH FAIL [diff_test]"); return 1 }

    // OLD: QUERIES 회 jq full-scan
    let t0 = now_ns()
    let mut k = 0
    while k < QUERIES { let _ = old_query(target); k = k + 1 }
    let t1 = now_ns()
    let ns_old = ns_diff(t0, t1)
    println("  OLD (jq+awk full-scan ×" + to_string(QUERIES) + ") total_ns=" + to_string(ns_old) + "  per_query_ns=" + to_string(ns_old / QUERIES))

    // NEW: 1회 prep + QUERIES 회 awk on col
    let prep_ns = new_prep(target)
    let col_bytes = exec("wc -c < '" + COL_PATH + "'").trim()
    println("  NEW prep_ns=" + to_string(prep_ns) + "  col_bytes=" + col_bytes)
    let t0n = now_ns()
    let mut k2 = 0
    while k2 < QUERIES { let _ = new_query(); k2 = k2 + 1 }
    let t1n = now_ns()
    let ns_new_q = ns_diff(t0n, t1n)
    let ns_new_total = prep_ns + ns_new_q
    println("  NEW (col query ×" + to_string(QUERIES) + ") query_ns=" + to_string(ns_new_q) + "  per_query_ns=" + to_string(ns_new_q / QUERIES))
    println("  NEW total (prep + queries) = " + to_string(ns_new_total))

    if ns_new_q > 0 {
        let ratio_q = (ns_old / QUERIES) / (ns_new_q / QUERIES)
        println("  per-query speedup=" + to_string(ratio_q) + "x  (col vs jq-full-scan)")
    }
    if ns_new_total > 0 {
        let ratio_t = ns_old / ns_new_total
        let saved = ((ns_old - ns_new_total) * 100) / ns_old
        println("  total speedup (incl prep) =" + to_string(ratio_t) + "x  saved=" + to_string(saved) + "%")
    }
    return 0
}

fn main() -> void {
    let _ = run_bench()
}
