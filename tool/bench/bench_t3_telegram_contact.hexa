// tool/bench/bench_t3_telegram_contact.hexa — T3 telegram_contact_apbf bench
//   F58 직접 이식. raw 9 hexa-only / try/catch 0 / top-level main 0.
//
//   8000 synthetic contact (first+last name) → APBF encode → 200 prefix query
//   (linear vs bisect on sorted blob).
//
// 5-tuple: site=T3 ROI#=T3 baseline_ns post_ns diff_test=lossless
//
// R1 HEXA-FIRST: 인라인 python3. R17: alarm 120s.

let PAYLOAD = "import sys,os,struct,time,bisect,array,random\n" +
"CONTACTS_N=8000\n" +
"QUERIES=200\n" +
"TOP_K=10\n" +
"BIN='/tmp/bench_t3_apbf.bin'\n" +
"FIRST=['alex','ben','chris','dan','emma','frank','grace','helen','ivan','julia','kim','liam','mia','noah','olivia','peter','quinn','ryan','sam','tina','uma','victor','wendy','xena','yuri','zoe','aaron','beth','carl','diana','ethan','fiona','gabe','hugo','iris','jake','kate','leo','maya','nick','owen','piper','quincy','ruth','seth','troy','umar','vera','will','xavier','yuna']\n" +
"LAST=['kim','lee','park','choi','jung','han','seo','yoon','lim','jang','smith','jones','brown','davis','miller','wilson','moore','taylor','anderson','thomas','jackson','white','harris','martin','thompson','garcia','martinez','robinson','clark','rodriguez','lewis','walker','hall','allen','young','hernandez','king','wright','lopez','hill','scott','green','adams','baker']\n" +
"\n" +
"def fmt(b):\n" +
"    if b>1048576: return f'{b/1048576:.2f}MB'\n" +
"    if b>1024: return f'{b/1024:.1f}KB'\n" +
"    return f'{b}B'\n" +
"\n" +
"def build_dataset(n=CONTACTS_N,seed=23):\n" +
"    rng=random.Random(seed)\n" +
"    rows={}\n" +
"    for i in range(n):\n" +
"        f=FIRST[rng.randrange(len(FIRST))]\n" +
"        l=LAST[rng.randrange(len(LAST))]\n" +
"        sfx=str(rng.randrange(99)) if rng.random()<0.3 else ''\n" +
"        nm=f+' '+l+sfx\n" +
"        rows[nm]=rows.get(nm,0)+rng.randrange(1,50)\n" +
"    return list(rows.items())\n" +
"\n" +
"def encode(rows):\n" +
"    t0=time.perf_counter_ns()\n" +
"    rows=sorted(rows,key=lambda r:r[0])\n" +
"    n=len(rows)\n" +
"    pool=bytearray()\n" +
"    offs=array.array('I',[0]*n)\n" +
"    lens=array.array('I',[0]*n)\n" +
"    scs =array.array('I',[0]*n)\n" +
"    for i,(nm,sc) in enumerate(rows):\n" +
"        nb=nm.encode('utf-8','replace')\n" +
"        offs[i]=len(pool); lens[i]=len(nb); scs[i]=int(sc)&0xffffffff\n" +
"        pool.extend(nb)\n" +
"    header=struct.pack('<4sIII',b'APBF',1,n,len(pool))\n" +
"    with open(BIN,'wb') as f:\n" +
"        f.write(header)\n" +
"        f.write(offs.tobytes()); f.write(lens.tobytes()); f.write(scs.tobytes())\n" +
"        f.write(pool)\n" +
"    t1=time.perf_counter_ns()\n" +
"    return {'encode_ns':t1-t0,'n':n,'blob_size':os.path.getsize(BIN),'rows':rows}\n" +
"\n" +
"def old_prefix_query(rows,prefix):\n" +
"    hits=0\n" +
"    plen=len(prefix)\n" +
"    for nm,_ in rows:\n" +
"        if len(nm)>=plen and nm[:plen]==prefix: hits+=1\n" +
"    return hits\n" +
"\n" +
"def new_prefix_query(sorted_names,prefix):\n" +
"    pb=prefix\n" +
"    start=bisect.bisect_left(sorted_names,pb)\n" +
"    end=bisect.bisect_left(sorted_names,pb+'\\uffff')\n" +
"    return end-start\n" +
"\n" +
"def build_prefixes(rows,n=QUERIES,seed=31):\n" +
"    rng=random.Random(seed)\n" +
"    out=[]\n" +
"    for _ in range(n):\n" +
"        nm=rows[rng.randrange(len(rows))][0]\n" +
"        plen=rng.choice([1,2,3,4,5])\n" +
"        out.append(nm[:plen])\n" +
"    return out\n" +
"\n" +
"def diff_test(rows,sorted_names,prefixes,sample_n=20):\n" +
"    mm=0\n" +
"    step=max(1,len(prefixes)//sample_n)\n" +
"    i=0; cnt=0\n" +
"    while cnt<sample_n and i<len(prefixes):\n" +
"        p=prefixes[i]\n" +
"        o=old_prefix_query(rows,p); n=new_prefix_query(sorted_names,p)\n" +
"        if o!=n:\n" +
"            mm+=1; print(f'    DIFF prefix={p} old={o} new={n}')\n" +
"        i+=step; cnt+=1\n" +
"    return mm\n" +
"\n" +
"def bench():\n" +
"    print(f'airgenome bench/T3 — telegram_contact APBF (linear vs blob bisect)')\n" +
"    print(f'  CONTACTS_N={CONTACTS_N} QUERIES={QUERIES} TOP_K={TOP_K}')\n" +
"    print(f'  source: synthetic (Telegram contact list — name+score)')\n" +
"    rows=build_dataset(CONTACTS_N)\n" +
"    print(f'  built: {len(rows)} contacts')\n" +
"    info=encode(rows)\n" +
"    sorted_names=[r[0] for r in info['rows']]\n" +
"    print(f'  encode (sort + APBF): {info[\"encode_ns\"]/1e6:.1f}ms  blob={fmt(info[\"blob_size\"])}')\n" +
"    prefixes=build_prefixes(rows,QUERIES)\n" +
"    mm=diff_test(rows,sorted_names,prefixes,20)\n" +
"    print(f'  diff_test (subset 20) mismatches: {mm}')\n" +
"    if mm!=0:\n" +
"        print('BENCH FAIL [diff_test != 0]'); return\n" +
"    t0=time.perf_counter_ns()\n" +
"    for k in range(QUERIES):\n" +
"        old_prefix_query(rows,prefixes[k%len(prefixes)])\n" +
"    t1=time.perf_counter_ns()\n" +
"    ns_old=t1-t0; per_old=ns_old//QUERIES\n" +
"    print(f'  OLD (linear scan) total_ns={ns_old}  per_query_ns={per_old}')\n" +
"    t0=time.perf_counter_ns()\n" +
"    for k in range(QUERIES):\n" +
"        new_prefix_query(sorted_names,prefixes[k%len(prefixes)])\n" +
"    t1=time.perf_counter_ns()\n" +
"    ns_new=t1-t0; per_new=ns_new//QUERIES if QUERIES>0 else 0\n" +
"    print(f'  NEW (blob mmap+bisect) total_ns={ns_new}  per_query_ns={per_new}')\n" +
"    if ns_new>0:\n" +
"        ratio=ns_old/ns_new\n" +
"        saved_pct=((ns_old-ns_new)*100)//ns_old if ns_old>0 else 0\n" +
"        print(f'  speedup={ratio:.1f}x  saved={saved_pct}%')\n" +
"        amort_per=info['encode_ns']//QUERIES\n" +
"        print(f'  + encode cost amortized: {amort_per}ns/query')\n" +
"    print(f'  5-tuple: site=T3 ROI#=T3 baseline_ns={per_old} post_ns={per_new} diff_test=lossless')\n" +
"\n" +
"bench()\n"

fn run() {
    let tmp_py = "/tmp/bench_t3_telegram_contact_" + exec("date +%s%N").trim() + ".py"
    write_file(tmp_py, PAYLOAD)
    let cmd = "/usr/bin/perl -e 'alarm 120; exec @ARGV' /usr/bin/python3 '" + tmp_py + "' 2>&1; rm -f '" + tmp_py + "'"
    let result = exec(cmd)
    print(result)
}

run()
