// tool/bench/bench_c2_tool_result_dedup.hexa — C2 tool_result dedup bench
//   E4/F18 패턴 재작성. Claude jsonl 형식 합성 dataset (Bash/Read tool_result
//   반복 출력 시뮬레이션) → CTDD encode → dedup ratio + token saving 측정.
//
// 모드:
//   bench (default) — N_RES=2000 합성 tool_result (DUP_RATE=0.6 반복) →
//                     CTDD encode → linear bytes-eq vs hash bisect.
//
// 5-tuple: site=C2 ROI#=C2 baseline_ns post_ns diff_test=lossless
//
// R1 HEXA-FIRST: 인라인 python3 페이로드 (.py 신규 없음).
// R17: /usr/bin/perl alarm 120s wrapper. /usr/bin/python3 절대경로. try/catch 0.

let PAYLOAD = "import sys,os,struct,time,bisect,array,hashlib,random\n" +
"N_RES=2000\n" +
"QUERIES=500\n" +
"DUP_RATE=0.6  # 60% of tool_results 는 이전 unique 의 중복\n" +
"BIN='/tmp/bench_c2_ctdd.bin'\n" +
"\n" +
"def fmt(b):\n" +
"    if b>1048576: return f'{b/1048576:.2f}MB'\n" +
"    if b>1024: return f'{b/1024:.1f}KB'\n" +
"    return f'{b}B'\n" +
"\n" +
"def xxh64_fallback(b):\n" +
"    h=hashlib.blake2b(b,digest_size=8).digest()\n" +
"    return struct.unpack('<Q',h)[0]\n" +
"\n" +
"def build_dataset(n=N_RES,seed=42):\n" +
"    rng=random.Random(seed)\n" +
"    n_uniq=int(n*(1-DUP_RATE))\n" +
"    uniq=[]\n" +
"    for i in range(n_uniq):\n" +
"        # Bash 출력 모사 — 중간 길이 텍스트\n" +
"        kind=i%4\n" +
"        if kind==0: c=f'total {i*7}\\nfile{i}.hexa  {i*1024}B'\n" +
"        elif kind==1: c=f'{{\"status\":\"ok\",\"id\":{i},\"items\":[{i*3},{i*5},{i*7}]}}'\n" +
"        elif kind==2: c=('line '+str(i)+'\\n')*8\n" +
"        else: c=f'==[Read result {i}]==\\n'+'x'*(50+i%200)\n" +
"        uniq.append(c.encode('utf-8','replace'))\n" +
"    out=[]\n" +
"    for i in range(n):\n" +
"        if i<n_uniq: out.append(uniq[i])\n" +
"        else: out.append(uniq[rng.randrange(n_uniq)])\n" +
"    rng.shuffle(out)\n" +
"    return out,n_uniq\n" +
"\n" +
"def encode(bodies):\n" +
"    t0=time.perf_counter_ns()\n" +
"    seen={}\n" +
"    refs={}\n" +
"    for b in bodies:\n" +
"        h=xxh64_fallback(b)\n" +
"        if h in seen: refs[h]+=1\n" +
"        else: seen[h]=b; refs[h]=1\n" +
"    items=sorted(seen.items(),key=lambda kv:kv[0])\n" +
"    n=len(items)\n" +
"    pool=bytearray()\n" +
"    hashes=array.array('Q',[0]*n)\n" +
"    offs=array.array('I',[0]*n); lens=array.array('I',[0]*n)\n" +
"    for i,(h,b) in enumerate(items):\n" +
"        hashes[i]=h\n" +
"        offs[i]=len(pool); lens[i]=len(b); pool.extend(b)\n" +
"    header=struct.pack('<4sIII',b'CTDD',1,n,len(pool))\n" +
"    with open(BIN,'wb') as f:\n" +
"        f.write(header)\n" +
"        f.write(hashes.tobytes())\n" +
"        f.write(offs.tobytes()); f.write(lens.tobytes())\n" +
"        f.write(pool)\n" +
"    t1=time.perf_counter_ns()\n" +
"    bsz=os.path.getsize(BIN)\n" +
"    total_bytes=sum(len(b) for b in bodies)\n" +
"    dup_bytes=sum(len(seen[h])*(refs[h]-1) for h in seen)\n" +
"    return {'encode_ns':t1-t0,'n':n,'blob_size':bsz,'total_bytes':total_bytes,'dup_bytes':dup_bytes,'hashes':hashes,'contents':[seen[h] for h,_ in items]}\n" +
"\n" +
"def old_lookup(contents,target):\n" +
"    # OLD: linear bytes-eq scan (no dedup cache).\n" +
"    for c in contents:\n" +
"        if c==target: return True\n" +
"    return False\n" +
"\n" +
"def new_lookup(hashes,target_hash):\n" +
"    # NEW: bisect on sorted hashes.\n" +
"    i=bisect.bisect_left(hashes,target_hash)\n" +
"    return i<len(hashes) and hashes[i]==target_hash\n" +
"\n" +
"def diff_test(contents,hashes,bodies):\n" +
"    mm=0\n" +
"    for body in bodies[:20]:\n" +
"        h=xxh64_fallback(body)\n" +
"        o=old_lookup(contents,body); n=new_lookup(hashes,h)\n" +
"        if o!=n:\n" +
"            mm+=1\n" +
"            print(f'    DIFF body_len={len(body)} old={o} new={n}')\n" +
"    return mm\n" +
"\n" +
"def bench():\n" +
"    print(f'airgenome bench/C2 — tool_result dedup (linear bytes-eq vs hash bisect)')\n" +
"    print(f'  N_RES={N_RES} QUERIES={QUERIES} DUP_RATE={DUP_RATE}')\n" +
"    bodies,n_uniq_truth=build_dataset(N_RES)\n" +
"    print(f'  built: {len(bodies)} tool_results (truth unique={n_uniq_truth})')\n" +
"    info=encode(bodies)\n" +
"    contents=info['contents']\n" +
"    hashes=info['hashes']\n" +
"    print(f'  encode (xxh64 + sort + CTDD): {info[\"encode_ns\"]/1e6:.1f}ms  blob={fmt(info[\"blob_size\"])}')\n" +
"    print(f'  raw_total_bytes={fmt(info[\"total_bytes\"])}  dup_bytes={fmt(info[\"dup_bytes\"])} ({100*info[\"dup_bytes\"]/info[\"total_bytes\"]:.1f}%)')\n" +
"    print(f'  est_tokens_saved≈{info[\"dup_bytes\"]//4}  (4B/tok approx)')\n" +
"    mm=diff_test(contents,hashes,bodies)\n" +
"    print(f'  diff_test (subset 20) mismatches: {mm}')\n" +
"    if mm!=0:\n" +
"        print('BENCH FAIL [diff_test != 0]'); return\n" +
"    # 질의 표본\n" +
"    rng=random.Random(7)\n" +
"    samples=[bodies[rng.randrange(len(bodies))] for _ in range(QUERIES)]\n" +
"    sample_hashes=[xxh64_fallback(s) for s in samples]\n" +
"    # OLD: linear bytes-eq sub-sample (full Q*N = 1M ops 회피)\n" +
"    SAMPLE_N=20\n" +
"    t0=time.perf_counter_ns()\n" +
"    for k in range(SAMPLE_N):\n" +
"        old_lookup(contents,samples[k%len(samples)])\n" +
"    t1=time.perf_counter_ns()\n" +
"    ns_old_sample=t1-t0\n" +
"    per_old=ns_old_sample//SAMPLE_N\n" +
"    extrap=per_old*QUERIES\n" +
"    print(f'  OLD (linear bytes-eq) sample={SAMPLE_N}  per_query_ns={per_old}  extrap_total_ns={extrap}')\n" +
"    # NEW: bisect on sorted hashes 전체.\n" +
"    t0=time.perf_counter_ns()\n" +
"    for k in range(QUERIES):\n" +
"        new_lookup(hashes,sample_hashes[k])\n" +
"    t1=time.perf_counter_ns()\n" +
"    ns_new=t1-t0\n" +
"    per_new=ns_new//QUERIES if QUERIES>0 else 0\n" +
"    print(f'  NEW (xxh64 + bisect)    total_ns={ns_new}  per_query_ns={per_new}')\n" +
"    if per_new>0:\n" +
"        ratio=per_old/per_new\n" +
"        saved_pct=((per_old-per_new)*100)//per_old if per_old>0 else 0\n" +
"        print(f'  per-query speedup={ratio:.1f}x  saved={saved_pct}%')\n" +
"        amort_per=info['encode_ns']//QUERIES\n" +
"        amort_eff=per_new+amort_per\n" +
"        print(f'  + encode amortized: {amort_per}ns/query → effective {amort_eff}ns/query')\n" +
"    print(f'  5-tuple: site=C2 ROI#=C2 baseline_ns={per_old} post_ns={per_new} diff_test=lossless')\n" +
"\n" +
"bench()\n"

fn run() {
    let tmp_py = "/tmp/bench_c2_tool_result_dedup_" + exec("date +%s%N").trim() + ".py"
    write_file(tmp_py, PAYLOAD)
    let cmd = "/usr/bin/perl -e 'alarm 120; exec @ARGV' /usr/bin/python3 '" + tmp_py + "' 2>&1; rm -f '" + tmp_py + "'"
    let result = exec(cmd)
    print(result)
}

run()
