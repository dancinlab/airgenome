// tool/bench/bench_t2_telegram_media.hexa — T2 telegram_media_dedup bench
//   #65 wyhash-flavored content hash + #41 dedup cache.
//   raw 9 hexa-only / try/catch 0 / top-level main 0.
//
//   8000 synthetic media (30% planted duplicates) → blake2b digest_size=8 hash
//   → sorted hashes blob → 1000 hash lookup (linear vs bisect).
//
// 5-tuple: site=T2 ROI#=T2 baseline_ns post_ns diff_test=lossless
//
// R1 HEXA-FIRST: 인라인 python3. R17: alarm 120s.

let PAYLOAD = "import sys,os,struct,time,bisect,array,hashlib,random\n" +
"FILES_N=8000\n" +
"DUP_RATE=0.30\n" +
"QUERIES=1000\n" +
"BIN='/tmp/bench_t2_tmdd.bin'\n" +
"\n" +
"def fmt(b):\n" +
"    if b>1073741824: return f'{b/1073741824:.2f}GB'\n" +
"    if b>1048576: return f'{b/1048576:.2f}MB'\n" +
"    if b>1024: return f'{b/1024:.1f}KB'\n" +
"    return f'{b}B'\n" +
"\n" +
"def wyh64(b,sz):\n" +
"    h=hashlib.blake2b(b,digest_size=8,key=struct.pack('<Q',sz&0xffffffffffffffff)).digest()\n" +
"    return struct.unpack('<Q',h)[0]\n" +
"\n" +
"def build_dataset(n=FILES_N,seed=11):\n" +
"    rng=random.Random(seed)\n" +
"    out=[]\n" +
"    for i in range(n):\n" +
"        if i>0 and rng.random()<DUP_RATE:\n" +
"            j=rng.randrange(i); out.append(out[j])\n" +
"        else:\n" +
"            sz=rng.choice([512,2048,8192,16384,32768,65536])\n" +
"            payload=bytes(rng.randrange(256) for _ in range(min(sz,256)))\n" +
"            out.append((sz,payload))\n" +
"    return out\n" +
"\n" +
"def encode(files):\n" +
"    t0=time.perf_counter_ns()\n" +
"    seen={}\n" +
"    total_bytes=0\n" +
"    for sz,payload in files:\n" +
"        h=wyh64(payload[:65536],sz)\n" +
"        total_bytes+=sz\n" +
"        cur=seen.get(h)\n" +
"        if cur is None: seen[h]=[sz,1]\n" +
"        else: cur[1]+=1\n" +
"    items=sorted(seen.items(), key=lambda kv:kv[0])\n" +
"    n=len(items)\n" +
"    hashes=array.array('Q',[h for h,_ in items])\n" +
"    sizes =array.array('I',[m[0]&0xffffffff for _,m in items])\n" +
"    dups  =array.array('I',[m[1]&0xffffffff for _,m in items])\n" +
"    header=struct.pack('<4sIII',b'TMDD',1,n,0)\n" +
"    with open(BIN,'wb') as f:\n" +
"        f.write(header)\n" +
"        f.write(hashes.tobytes()); f.write(sizes.tobytes()); f.write(dups.tobytes())\n" +
"    t1=time.perf_counter_ns()\n" +
"    saving=sum(sizes[i]*(dups[i]-1) for i in range(n))\n" +
"    return {'encode_ns':t1-t0,'n_total':len(files),'n_uniq':n,'total_bytes':total_bytes,'saving':saving,'blob_size':os.path.getsize(BIN),'hashes':hashes,'sizes':sizes,'dups':dups}\n" +
"\n" +
"def old_lookup_linear(hashes,h):\n" +
"    for i in range(len(hashes)):\n" +
"        if hashes[i]==h: return i\n" +
"    return -1\n" +
"\n" +
"def new_lookup_bisect(hashes,h):\n" +
"    i=bisect.bisect_left(hashes,h)\n" +
"    if i<len(hashes) and hashes[i]==h: return i\n" +
"    return -1\n" +
"\n" +
"def diff_test(hashes,queries,sample_n=20):\n" +
"    mm=0\n" +
"    step=max(1,len(queries)//sample_n)\n" +
"    i=0; cnt=0\n" +
"    while cnt<sample_n and i<len(queries):\n" +
"        q=queries[i]\n" +
"        o=old_lookup_linear(hashes,q); n=new_lookup_bisect(hashes,q)\n" +
"        # both should resolve to same hash equivalence (positions may differ if duplicate hash kept once — here uniq)\n" +
"        if (o<0)!=(n<0): mm+=1\n" +
"        elif o>=0 and hashes[o]!=hashes[n]: mm+=1\n" +
"        i+=step; cnt+=1\n" +
"    return mm\n" +
"\n" +
"def bench():\n" +
"    print(f'airgenome bench/T2 — telegram_media TMDD (linear vs blob bisect, #65+#41)')\n" +
"    print(f'  FILES_N={FILES_N} DUP_RATE={DUP_RATE} QUERIES={QUERIES}')\n" +
"    print(f'  source: synthetic (postbox/media — 30% planted duplicates)')\n" +
"    files=build_dataset(FILES_N)\n" +
"    print(f'  built: {len(files)} synth media')\n" +
"    info=encode(files)\n" +
"    print(f'  encode (hash + sort + TMDD): {info[\"encode_ns\"]/1e6:.1f}ms  blob={fmt(info[\"blob_size\"])}')\n" +
"    dup_pct=100*(info['n_total']-info['n_uniq'])/info['n_total']\n" +
"    sav_pct=100*info['saving']/max(info['total_bytes'],1)\n" +
"    print(f'  dedup uniq={info[\"n_uniq\"]} dups={info[\"n_total\"]-info[\"n_uniq\"]} ({dup_pct:.1f}%)  total={fmt(info[\"total_bytes\"])} saving={fmt(info[\"saving\"])} ({sav_pct:.1f}%)')\n" +
"    rng=random.Random(13)\n" +
"    queries=[int(info['hashes'][rng.randrange(info['n_uniq'])]) for _ in range(QUERIES)]\n" +
"    mm=diff_test(info['hashes'],queries,20)\n" +
"    print(f'  diff_test (subset 20) mismatches: {mm}')\n" +
"    if mm!=0:\n" +
"        print('BENCH FAIL [diff_test != 0]'); return\n" +
"    t0=time.perf_counter_ns()\n" +
"    for q in queries:\n" +
"        old_lookup_linear(info['hashes'],q)\n" +
"    t1=time.perf_counter_ns()\n" +
"    ns_old=t1-t0; per_old=ns_old//QUERIES\n" +
"    print(f'  OLD (linear scan) total_ns={ns_old}  per_query_ns={per_old}')\n" +
"    t0=time.perf_counter_ns()\n" +
"    for q in queries:\n" +
"        new_lookup_bisect(info['hashes'],q)\n" +
"    t1=time.perf_counter_ns()\n" +
"    ns_new=t1-t0; per_new=ns_new//QUERIES if QUERIES>0 else 0\n" +
"    print(f'  NEW (blob mmap+bisect) total_ns={ns_new}  per_query_ns={per_new}')\n" +
"    if ns_new>0:\n" +
"        ratio=ns_old/ns_new\n" +
"        saved_pct=((ns_old-ns_new)*100)//ns_old if ns_old>0 else 0\n" +
"        print(f'  speedup={ratio:.1f}x  saved={saved_pct}%')\n" +
"        amort_per=info['encode_ns']//QUERIES\n" +
"        print(f'  + encode cost amortized: {amort_per}ns/query')\n" +
"    print(f'  5-tuple: site=T2 ROI#=T2 baseline_ns={per_old} post_ns={per_new} diff_test=lossless')\n" +
"\n" +
"bench()\n"

fn run() {
    let tmp_py = "/tmp/bench_t2_telegram_media_" + exec("date +%s%N").trim() + ".py"
    write_file(tmp_py, PAYLOAD)
    let cmd = "/usr/bin/perl -e 'alarm 120; exec @ARGV' /usr/bin/python3 '" + tmp_py + "' 2>&1; rm -f '" + tmp_py + "'"
    let result = exec(cmd)
    print(result)
}

run()
