// tool/bench/bench_c9_tool_name_dict.hexa — C9 tool name dict column bench
//   synthetic 50K tool_use occurrences (12 distinct names, Zipf-ish dist).
//   raw string column (json line bytes) vs u8 enum column 비교.
//   - size ratio
//   - count-by-name scan (Counter on str list vs u8 array tally)
//
//   5-tuple: site=C9 ROI#=9 baseline_ns post_ns diff_test=lossless
//
// R1 HEXA-FIRST: 인라인 python3.

let PAYLOAD = "import sys,os,struct,time,array,random\n" +
"USES_N=50000\n" +
"BIN='/tmp/bench_c9_tool.bin'\n" +
"NAMES=['Read','Edit','Write','Bash','Grep','Glob','Task','WebFetch','WebSearch','Skill','TodoWrite','NotebookEdit']\n" +
"WEIGHTS=[35,18,8,22,4,3,2,2,1,2,2,1]\n" +
"\n" +
"def fmt(b):\n" +
"    if b>1048576: return f'{b/1048576:.2f}MB'\n" +
"    if b>1024: return f'{b/1024:.1f}KB'\n" +
"    return f'{b}B'\n" +
"\n" +
"def build():\n" +
"    rng=random.Random(42)\n" +
"    cum=[]; s=0\n" +
"    for w in WEIGHTS: s+=w; cum.append(s)\n" +
"    total=cum[-1]\n" +
"    out=[]\n" +
"    for _ in range(USES_N):\n" +
"        r=rng.randrange(total)\n" +
"        for i,c in enumerate(cum):\n" +
"            if r<c: out.append(NAMES[i]); break\n" +
"    return out\n" +
"\n" +
"def encode(names):\n" +
"    t0=time.perf_counter_ns()\n" +
"    distinct=sorted(set(names))\n" +
"    name_to_id={n:i for i,n in enumerate(distinct)}\n" +
"    n_tools=len(distinct); n_uses=len(names)\n" +
"    pool=bytearray()\n" +
"    name_offs=array.array('I',[0]*n_tools); name_lens=array.array('I',[0]*n_tools)\n" +
"    for i,n in enumerate(distinct):\n" +
"        nb=n.encode('utf-8','replace')\n" +
"        name_offs[i]=len(pool); name_lens[i]=len(nb); pool.extend(nb)\n" +
"    enum_col=bytes(name_to_id[n] for n in names)\n" +
"    header=struct.pack('<4sIIII',b'CTND',1,n_tools,n_uses,len(pool))\n" +
"    with open(BIN,'wb') as f:\n" +
"        f.write(header)\n" +
"        f.write(name_offs.tobytes()); f.write(name_lens.tobytes())\n" +
"        f.write(bytes(pool))\n" +
"        f.write(enum_col)\n" +
"    t1=time.perf_counter_ns()\n" +
"    return {'encode_ns':t1-t0,'n_tools':n_tools,'n_uses':n_uses,'distinct':distinct,\n" +
"            'enum_col':enum_col,'blob_size':os.path.getsize(BIN)}\n" +
"\n" +
"def old_count(names):\n" +
"    from collections import Counter\n" +
"    return dict(Counter(names))\n" +
"\n" +
"def new_count(enum_col,n_tools,distinct):\n" +
"    c=[0]*n_tools\n" +
"    for b in enum_col: c[b]+=1\n" +
"    return dict(zip(distinct,c))\n" +
"\n" +
"def bench():\n" +
"    print('airgenome bench/C9 — claude tool name dict column')\n" +
"    print(f'  USES_N={USES_N} NAMES={len(NAMES)}')\n" +
"    names=build()\n" +
"    info=encode(names)\n" +
"    raw_name_bytes=sum(len(n)+10 for n in names)\n" +
"    print(f'  encode: {info[\"encode_ns\"]/1e6:.1f}ms tools={info[\"n_tools\"]} uses={info[\"n_uses\"]}')\n" +
"    print(f'  raw name col bytes ≈ {fmt(raw_name_bytes)}  enum col bytes = {fmt(info[\"n_uses\"])}  blob={fmt(info[\"blob_size\"])}')\n" +
"    saved_pct=((raw_name_bytes-info['n_uses'])*100)//max(raw_name_bytes,1)\n" +
"    print(f'  size saved {saved_pct}%  ratio {info[\"n_uses\"]/max(raw_name_bytes,1)*100:.2f}%')\n" +
"    # diff test\n" +
"    a=old_count(names); b=new_count(info['enum_col'],info['n_tools'],info['distinct'])\n" +
"    mm=0\n" +
"    for k in set(list(a.keys())+list(b.keys())):\n" +
"        if a.get(k,0)!=b.get(k,0): mm+=1\n" +
"    print(f'  diff_test mismatches: {mm}')\n" +
"    if mm!=0: print('BENCH FAIL'); return\n" +
"    # OLD bench\n" +
"    REPS=20\n" +
"    t0=time.perf_counter_ns()\n" +
"    for _ in range(REPS): old_count(names)\n" +
"    t1=time.perf_counter_ns()\n" +
"    ns_old=(t1-t0)//REPS\n" +
"    # NEW bench\n" +
"    enum_col=info['enum_col']; n_tools=info['n_tools']; distinct=info['distinct']\n" +
"    t0=time.perf_counter_ns()\n" +
"    for _ in range(REPS): new_count(enum_col,n_tools,distinct)\n" +
"    t1=time.perf_counter_ns()\n" +
"    ns_new=(t1-t0)//REPS\n" +
"    print(f'  OLD count_by_name (Counter on str list)  : per_call_ns={ns_old}')\n" +
"    print(f'  NEW count_by_name (u8 enum tally)        : per_call_ns={ns_new}')\n" +
"    if ns_new>0:\n" +
"        ratio=ns_old/ns_new; saved=((ns_old-ns_new)*100)//max(ns_old,1)\n" +
"        print(f'  speedup={ratio:.1f}x saved={saved}%')\n" +
"    print(f'  5-tuple: site=C9 ROI#=9 baseline_ns={ns_old} post_ns={ns_new} diff_test=lossless')\n" +
"\n" +
"bench()\n"

fn run() {
    let tmp_py = "/tmp/bench_c9_tool_dict_" + exec("date +%s%N").trim() + ".py"
    write_file(tmp_py, PAYLOAD)
    let cmd = "/usr/bin/perl -e 'alarm 120; exec @ARGV' /usr/bin/python3 '" + tmp_py + "' 2>&1; rm -f '" + tmp_py + "'"
    let result = exec(cmd)
    print(result)
}

run()
