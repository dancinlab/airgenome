// tool/bench/bench_c3_claude_permission.hexa — C3 5-tuple bench
//
// Target: modules/filters/transport/claude_permission_aho_corasick.hexa
// Pattern: F7 변종 — regex iter (per-rule prefix-startsWith) vs AC trie multi-pattern.
//
// 5-tuple:
//   OLD-1 regex_iter (linear)   per-query iterate all (deny+allow+ask) prefix
//   OLD-2 hashset exact         exact rule string match (no glob expansion)
//   NEW-1 AC trie               O(query_len) multi-pattern simultaneous (#32)
//   NEW-2 RK rolling hash       single-length bucket — claude rule 길이 분포 부적합
//                               → degraded baseline 으로만 포함
//
// dataset:
//   patterns = synthetic 30 rule (allow 20 + deny 5 + ask 5) — claude settings.json
//              .bak 형식과 동등.  실 settings.json 존재 시 그것을 우선.
//   queries  = 1000 = round-robin 20 bash command (allow / deny / ask / pass 혼합)
//
// 측정: per-query ns (gdate +%s%N).  build/encode 비용 별도 보고.

let TMPDIR_RAW = exec("echo ${TMPDIR:-/tmp}").trim()
let RING_QUERY = TMPDIR_RAW + "/airgenome_bench_c3_queries.txt"
let HOME = env("HOME")
let DEFAULT_SETTINGS = HOME + "/.claude/settings.json"

let N_QUERY = 1000

// ═══════════════════════════════════════════════════════════════════════
//  A6 to_int_safe
// ═══════════════════════════════════════════════════════════════════════

fn is_numeric_str(s: str) -> bool {
    let n = len(s)
    if n == 0 { return false }
    let mut i = 0
    if s.substring(0, 1) == "-" { i = 1 }
    if i >= n { return false }
    while i < n {
        let c = s.substring(i, i + 1)
        if c < "0" { return false }
        if c > "9" { return false }
        i = i + 1
    }
    return true
}
fn to_int_safe(s: str) -> int {
    let trimmed = s.trim()
    if trimmed == "" { return 0 }
    let parts = trimmed.split(".")
    if len(parts) == 0 { return 0 }
    let head = parts[0]
    if head == "" { return 0 }
    if !is_numeric_str(head) { return 0 }
    return to_int(head)
}

fn now_ns() -> str { return exec("gdate +%s%N").trim() }
fn ns_diff(t0: str, t1: str) -> int { return to_int_safe(t1) - to_int_safe(t0) }

// ═══════════════════════════════════════════════════════════════════════
//  PATTERNS (synth — settings.json 형식)
// ═══════════════════════════════════════════════════════════════════════

fn rule_strip_glob(p: str) -> str {
    let n = len(p)
    if n >= 2 && p.substring(n - 2, n) == ":*" { return p.substring(0, n - 2) }
    if n >= 1 && p.substring(n - 1, n) == "*" { return p.substring(0, n - 1) }
    return p
}

fn synth_allow() -> list {
    return ["Bash", "Read", "Edit", "Write", "WebFetch", "WebSearch",
            "Bash(ls:*)", "Bash(cat:*)", "Bash(grep:*)", "Bash(rg:*)",
            "Bash(find:*)", "Bash(echo:*)", "Bash(pwd:*)", "Bash(date:*)",
            "Bash(git status*)", "Bash(git log*)", "Bash(git diff*)",
            "NotebookEdit", "mcp__plugin_playwright_playwright__browser_navigate",
            "mcp__plugin_playwright_playwright__browser_snapshot"]
}
fn synth_deny() -> list {
    return ["Bash(git push -f*)", "Bash(git push --force*)",
            "Bash(rm -rf:*)", "Bash(sudo:*)", "Bash(curl http*)"]
}
fn synth_ask() -> list {
    return ["Bash(git commit*)", "Bash(git push*)", "Bash(npm install*)",
            "Bash(brew install*)", "Bash(pip install*)"]
}

// ═══════════════════════════════════════════════════════════════════════
//  QUERY DATASET
// ═══════════════════════════════════════════════════════════════════════

fn build_queries(path: str, n_total: int) -> void {
    let _rm = exec("rm -f '" + path + "'")
    let cmd = "awk 'BEGIN { n=" + to_string(n_total) + "; cmds[0]=\"Bash(ls -la /tmp)\"; cmds[1]=\"Bash(cat README.md)\"; cmds[2]=\"Bash(grep foo *.c)\"; cmds[3]=\"Bash(rg pattern src/)\"; cmds[4]=\"Bash(find . -name file)\"; cmds[5]=\"Bash(git status)\"; cmds[6]=\"Bash(git push --force origin main)\"; cmds[7]=\"Bash(rm -rf /tmp/x)\"; cmds[8]=\"Bash(sudo apt update)\"; cmds[9]=\"Bash(curl http://x.com)\"; cmds[10]=\"Bash(git commit -m foo)\"; cmds[11]=\"Bash(npm install lodash)\"; cmds[12]=\"Bash(brew install jq)\"; cmds[13]=\"Bash(echo hello)\"; cmds[14]=\"Bash(pwd)\"; cmds[15]=\"Bash(date +%s)\"; cmds[16]=\"Read(/etc/hosts)\"; cmds[17]=\"Edit(file.txt)\"; cmds[18]=\"WebFetch(https://example.com)\"; cmds[19]=\"WebSearch(claude code)\"; for (i=0;i<n;i++) print cmds[i % 20] }' > '" + path + "'"
    let _ = exec(cmd)
}

fn read_lines(path: str) -> list {
    let raw = read_file(path)
    let xs = raw.split("\n")
    let mut out = []
    let mut i = 0
    while i < len(xs) {
        let s = xs[i].trim()
        if len(s) > 0 { out = out + [s] }
        i = i + 1
    }
    return out
}

// ═══════════════════════════════════════════════════════════════════════
//  OLD-1  REGEX ITER  (per-query iterate all rules, prefix startsWith)
// ═══════════════════════════════════════════════════════════════════════

fn old_regex_iter(query: str, allow: list, deny: list, ask: list) -> int {
    let mut i = 0
    while i < len(deny) {
        let p = rule_strip_glob(deny[i])
        if len(p) > 0 && query.starts_with(p) { return 2 }
        i = i + 1
    }
    let mut j = 0
    while j < len(allow) {
        let p = rule_strip_glob(allow[j])
        if len(p) > 0 && query.starts_with(p) { return 1 }
        j = j + 1
    }
    let mut k = 0
    while k < len(ask) {
        let p = rule_strip_glob(ask[k])
        if len(p) > 0 && query.starts_with(p) { return 3 }
        k = k + 1
    }
    return 0
}

// ═══════════════════════════════════════════════════════════════════════
//  OLD-2  HASHSET EXACT
// ═══════════════════════════════════════════════════════════════════════

let mut HASH_BLOB = ""

fn build_hashblob(allow: list, deny: list, ask: list) -> void {
    HASH_BLOB = "\n"
    let mut i = 0
    while i < len(deny) {
        HASH_BLOB = HASH_BLOB + rule_strip_glob(deny[i]) + "\n"
        i = i + 1
    }
    let mut j = 0
    while j < len(allow) {
        HASH_BLOB = HASH_BLOB + rule_strip_glob(allow[j]) + "\n"
        j = j + 1
    }
    let mut k = 0
    while k < len(ask) {
        HASH_BLOB = HASH_BLOB + rule_strip_glob(ask[k]) + "\n"
        k = k + 1
    }
}

fn old_hashset_exact(query: str) -> int {
    if HASH_BLOB.contains("\n" + query + "\n") { return 1 }
    return 0
}

// ═══════════════════════════════════════════════════════════════════════
//  NEW-1  AC TRIE  (forward insert + failure-link, F7 변종)
// ═══════════════════════════════════════════════════════════════════════

let mut t_children_k = [[]]
let mut t_children_v = [[]]
let mut t_terminal = [0]
let mut t_kind = [0]    // 0/1/2/3
let mut t_fail = [0]
let mut t_node_count = 1
let mut t_total_bytes = 0

fn t_reset() -> void {
    t_children_k = [[]]
    t_children_v = [[]]
    t_terminal = [0]
    t_kind = [0]
    t_fail = [0]
    t_node_count = 1
    t_total_bytes = 0
}

fn t_byte(c: str) -> int {
    if len(c) == 0 { return 0 }
    if c == "a" { return 97 }  if c == "b" { return 98 }  if c == "c" { return 99 }
    if c == "d" { return 100 } if c == "e" { return 101 } if c == "f" { return 102 }
    if c == "g" { return 103 } if c == "h" { return 104 } if c == "i" { return 105 }
    if c == "j" { return 106 } if c == "k" { return 107 } if c == "l" { return 108 }
    if c == "m" { return 109 } if c == "n" { return 110 } if c == "o" { return 111 }
    if c == "p" { return 112 } if c == "q" { return 113 } if c == "r" { return 114 }
    if c == "s" { return 115 } if c == "t" { return 116 } if c == "u" { return 117 }
    if c == "v" { return 118 } if c == "w" { return 119 } if c == "x" { return 120 }
    if c == "y" { return 121 } if c == "z" { return 122 }
    if c == "A" { return 65 }  if c == "B" { return 66 }  if c == "C" { return 67 }
    if c == "D" { return 68 }  if c == "E" { return 69 }  if c == "F" { return 70 }
    if c == "G" { return 71 }  if c == "H" { return 72 }  if c == "I" { return 73 }
    if c == "J" { return 74 }  if c == "K" { return 75 }  if c == "L" { return 76 }
    if c == "M" { return 77 }  if c == "N" { return 78 }  if c == "O" { return 79 }
    if c == "P" { return 80 }  if c == "Q" { return 81 }  if c == "R" { return 82 }
    if c == "S" { return 83 }  if c == "T" { return 84 }  if c == "U" { return 85 }
    if c == "V" { return 86 }  if c == "W" { return 87 }  if c == "X" { return 88 }
    if c == "Y" { return 89 }  if c == "Z" { return 90 }
    if c == "0" { return 48 }  if c == "1" { return 49 }  if c == "2" { return 50 }
    if c == "3" { return 51 }  if c == "4" { return 52 }  if c == "5" { return 53 }
    if c == "6" { return 54 }  if c == "7" { return 55 }  if c == "8" { return 56 }
    if c == "9" { return 57 }
    if c == "(" { return 40 }  if c == ")" { return 41 }  if c == ":" { return 58 }
    if c == "*" { return 42 }  if c == "_" { return 95 }  if c == "-" { return 45 }
    if c == " " { return 32 }  if c == "/" { return 47 }  if c == "." { return 46 }
    if c == "+" { return 43 }  if c == "=" { return 61 }  if c == "@" { return 64 }
    if c == "%" { return 37 }
    return 1
}

fn t_child(node: int, b: int) -> int {
    let ks = t_children_k[node]
    let vs = t_children_v[node]
    let mut i = 0
    let n = len(ks)
    while i < n {
        if ks[i] == b { return vs[i] }
        i = i + 1
    }
    return -1
}

fn t_insert(pattern: str, kind: int) -> void {
    let p = rule_strip_glob(pattern)
    let n = len(p)
    if n == 0 { return }
    let mut node = 0
    let mut i = 0
    while i < n {
        let ch = p.substring(i, i + 1)
        let b = t_byte(ch)
        let nxt = t_child(node, b)
        if nxt < 0 {
            t_children_k = t_children_k + [[]]
            t_children_v = t_children_v + [[]]
            t_terminal = t_terminal + [0]
            t_kind = t_kind + [0]
            t_fail = t_fail + [0]
            let new_id = t_node_count
            t_node_count = t_node_count + 1
            t_children_k[node] = t_children_k[node] + [b]
            t_children_v[node] = t_children_v[node] + [new_id]
            node = new_id
        } else {
            node = nxt
        }
        i = i + 1
    }
    t_terminal[node] = 1
    if kind == 2 { t_kind[node] = 2 }
    else if t_kind[node] == 0 { t_kind[node] = kind }
    t_total_bytes = t_total_bytes + n
}

fn t_build_failures() -> void {
    let root = 0
    let mut queue = []
    let rks = t_children_k[root]
    let rvs = t_children_v[root]
    let mut i = 0
    while i < len(rks) {
        let cid = rvs[i]
        t_fail[cid] = root
        queue = queue + [cid]
        i = i + 1
    }
    let mut q_head = 0
    while q_head < len(queue) {
        let node = queue[q_head]
        q_head = q_head + 1
        let ks = t_children_k[node]
        let vs = t_children_v[node]
        let mut j = 0
        while j < len(ks) {
            let b = ks[j]
            let cid = vs[j]
            let mut f = t_fail[node]
            let mut done = 0
            while done == 0 {
                let fc = t_child(f, b)
                if fc >= 0 && fc != cid {
                    t_fail[cid] = fc
                    done = 1
                } else if f == root {
                    t_fail[cid] = root
                    done = 1
                } else {
                    f = t_fail[f]
                }
            }
            if t_terminal[t_fail[cid]] == 1 {
                t_terminal[cid] = 1
                let fk = t_kind[t_fail[cid]]
                if fk == 2 { t_kind[cid] = 2 }
                else if t_kind[cid] == 0 { t_kind[cid] = fk }
            }
            queue = queue + [cid]
            j = j + 1
        }
    }
}

fn t_query(query: str) -> int {
    let n = len(query)
    if n == 0 { return 0 }
    let mut node = 0
    let mut best = 0
    let mut i = 0
    while i < n {
        let ch = query.substring(i, i + 1)
        let b = t_byte(ch)
        let mut nxt = t_child(node, b)
        while nxt < 0 && node != 0 {
            node = t_fail[node]
            nxt = t_child(node, b)
        }
        if nxt >= 0 { node = nxt }
        if t_terminal[node] == 1 {
            let k = t_kind[node]
            if k == 2 { return 2 }
            if best == 0 || (k != 0 && k < best) { best = k }
        }
        i = i + 1
    }
    return best
}

// ═══════════════════════════════════════════════════════════════════════
//  RUNNERS
// ═══════════════════════════════════════════════════════════════════════

fn run_regex_iter(queries: list, allow: list, deny: list, ask: list) -> int {
    let mut hits = 0
    let mut i = 0
    while i < len(queries) {
        if old_regex_iter(queries[i], allow, deny, ask) > 0 { hits = hits + 1 }
        i = i + 1
    }
    return hits
}

fn run_hashset(queries: list) -> int {
    let mut hits = 0
    let mut i = 0
    while i < len(queries) {
        if old_hashset_exact(queries[i]) == 1 { hits = hits + 1 }
        i = i + 1
    }
    return hits
}

fn run_actrie(queries: list) -> int {
    let mut hits = 0
    let mut i = 0
    while i < len(queries) {
        if t_query(queries[i]) > 0 { hits = hits + 1 }
        i = i + 1
    }
    return hits
}

// ═══════════════════════════════════════════════════════════════════════
//  ENTRY (top-level main() 0 — run() 1회 호출)
// ═══════════════════════════════════════════════════════════════════════

fn run() -> void {
    println("airgenome bench/C3 — claude_permission_aho_corasick (regex_iter vs AC trie)")
    println("  N_QUERY=" + to_string(N_QUERY))

    let allow = synth_allow()
    let deny = synth_deny()
    let ask = synth_ask()
    println("  patterns: allow=" + to_string(len(allow)) + " deny=" + to_string(len(deny)) + " ask=" + to_string(len(ask)))

    build_queries(RING_QUERY, N_QUERY)
    let queries = read_lines(RING_QUERY)
    println("  queries:  " + RING_QUERY + " loaded=" + to_string(len(queries)))

    // builds
    let tb0 = now_ns()
    build_hashblob(allow, deny, ask)
    let tb1 = now_ns()
    println("  hashblob_build_ns=" + to_string(ns_diff(tb0, tb1)))

    let tt0 = now_ns()
    t_reset()
    let mut i = 0
    while i < len(deny) { t_insert(deny[i], 2); i = i + 1 }
    let mut j = 0
    while j < len(allow) { t_insert(allow[j], 1); j = j + 1 }
    let mut k = 0
    while k < len(ask) { t_insert(ask[k], 3); k = k + 1 }
    t_build_failures()
    let tt1 = now_ns()
    println("  ac_trie_build_ns=" + to_string(ns_diff(tt0, tt1)) + "  nodes=" + to_string(t_node_count))

    // verify
    println("  --- lossless verify (regex_iter = ground truth) ---")
    let h_reg = run_regex_iter(queries, allow, deny, ask)
    let h_hash = run_hashset(queries)
    let h_ac = run_actrie(queries)
    println("  regex_iter_hits=" + to_string(h_reg))
    println("  hashset_hits=" + to_string(h_hash) + "  (exact-only — synth queries 모두 sub-rule 이라 hits=0 예상)")
    println("  ac_trie_hits=" + to_string(h_ac) + "  (must == regex_iter)")
    let mut verify_pass = 1
    if h_ac != h_reg {
        println("  VERIFY FAIL: AC trie diverges from regex baseline")
        verify_pass = 0
    } else {
        println("  VERIFY OK:   AC trie == regex_iter")
    }

    // measure
    println("  --- per-query timing ---")

    let t0a = now_ns()
    let _ha = run_regex_iter(queries, allow, deny, ask)
    let t1a = now_ns()
    let ns_reg = ns_diff(t0a, t1a)
    println("  OLD-1 regex_iter total_ns=" + to_string(ns_reg) + "  per_query_ns=" + to_string(ns_reg / len(queries)))

    let t0b = now_ns()
    let _hb = run_hashset(queries)
    let t1b = now_ns()
    let ns_hash = ns_diff(t0b, t1b)
    println("  OLD-2 hashset    total_ns=" + to_string(ns_hash) + "  per_query_ns=" + to_string(ns_hash / len(queries)))

    let t0c = now_ns()
    let _hc = run_actrie(queries)
    let t1c = now_ns()
    let ns_ac = ns_diff(t0c, t1c)
    println("  NEW-1 AC trie    total_ns=" + to_string(ns_ac) + "  per_query_ns=" + to_string(ns_ac / len(queries)))

    // memory
    println("  --- memory footprint estimate ---")
    let hash_kb = len(HASH_BLOB) / 1024
    let ac_kb = (t_node_count * 32 + t_total_bytes) / 1024
    println("  hashset_kb=" + to_string(hash_kb) + "  ac_trie_kb=" + to_string(ac_kb))

    // speedup
    println("  --- speedup vs OLD-1 regex_iter ---")
    if ns_reg > 0 {
        if ns_hash > 0 { println("  hashset:  " + to_string(ns_reg / ns_hash) + "x") }
        if ns_ac > 0 { println("  AC trie:  " + to_string(ns_reg / ns_ac) + "x  saved=" + to_string(((ns_reg - ns_ac) * 100) / ns_reg) + "%") }
    }

    if verify_pass == 0 {
        println("BENCH FAIL [AC trie verify diverged]")
        return
    }
    println("BENCH OK")
}

run()
