// tool/bench/bench_fi1_recent_file.hexa — FI1 recent file SHBF bench
//   3K synthetic file paths (~/Documents tree-like) → RFSF encode →
//   50 prefix query (linear vs bisect) wall-clock 비교.
//
// 5-tuple: site=FI1 ROI#=recent-file-shbf baseline_ns post_ns diff_test=lossless
//
// R1 HEXA-FIRST: 인라인 python3 페이로드 (.py 신규 없음).
// R17: /usr/bin/perl alarm 120s wrapper. /usr/bin/python3 절대경로. try/catch 0.

let PAYLOAD = "import sys,os,struct,time,bisect,array,random\n" +
"PATHS_N=3000\n" +
"QUERIES=50\n" +
"BIN='/tmp/bench_fi1_rfsf.bin'\n" +
"\n" +
"def fmt(b):\n" +
"    if b>1048576: return f'{b/1048576:.2f}MB'\n" +
"    if b>1024: return f'{b/1024:.1f}KB'\n" +
"    return f'{b}B'\n" +
"\n" +
"def build_dataset(n=PATHS_N,seed=42):\n" +
"    rng=random.Random(seed)\n" +
"    home=os.environ.get('HOME','/Users/x')\n" +
"    dirs=['Documents/Projects','Documents/Notes','Desktop','Downloads','Pictures','Music']\n" +
"    out=[]\n" +
"    for i in range(n):\n" +
"        d=dirs[i%len(dirs)]\n" +
"        sub=f'sub{(i//50)%20}'\n" +
"        p=f'{home}/{d}/{sub}/file_{i}.{rng.choice([\"txt\",\"md\",\"pdf\",\"png\",\"swift\",\"py\"])}'\n" +
"        out.append((p,rng.randrange(0,30)))\n" +
"    return out\n" +
"\n" +
"def encode(rows):\n" +
"    t0=time.perf_counter_ns()\n" +
"    rows=sorted(set(rows),key=lambda r:r[0])\n" +
"    n=len(rows)\n" +
"    pool=bytearray()\n" +
"    offs=array.array('I',[0]*n); lens=array.array('I',[0]*n); days=array.array('I',[0]*n)\n" +
"    for i,(p,d) in enumerate(rows):\n" +
"        pb=p.encode('utf-8','replace')\n" +
"        offs[i]=len(pool); lens[i]=len(pb); days[i]=int(d)&0xffffffff\n" +
"        pool.extend(pb)\n" +
"    header=struct.pack('<4sIII',b'RFSF',1,n,len(pool))\n" +
"    with open(BIN,'wb') as f:\n" +
"        f.write(header); f.write(offs.tobytes()); f.write(lens.tobytes()); f.write(days.tobytes()); f.write(pool)\n" +
"    t1=time.perf_counter_ns()\n" +
"    return {'encode_ns':t1-t0,'n':n,'blob_size':os.path.getsize(BIN),'rows':rows}\n" +
"\n" +
"def linear_prefix(rows,prefix):\n" +
"    c=0; pl=len(prefix)\n" +
"    for p,_ in rows:\n" +
"        if len(p)>=pl and p[:pl]==prefix: c+=1\n" +
"    return c\n" +
"\n" +
"def bisect_prefix(sorted_paths,prefix):\n" +
"    a=bisect.bisect_left(sorted_paths,prefix)\n" +
"    b=bisect.bisect_left(sorted_paths,prefix+'\\uffff')\n" +
"    return b-a\n" +
"\n" +
"def build_queries(rows,seed=7):\n" +
"    rng=random.Random(seed); qs=[]\n" +
"    for _ in range(QUERIES):\n" +
"        p=rows[rng.randrange(len(rows))][0]\n" +
"        slash=p.rfind('/')\n" +
"        qs.append(p[:slash] if slash>0 else p[:8])\n" +
"    return qs\n" +
"\n" +
"def diff_test(rows,sorted_paths,qs,sample=20):\n" +
"    mm=0\n" +
"    step=max(1,len(qs)//sample)\n" +
"    cnt=0; i=0\n" +
"    while cnt<sample and i<len(qs):\n" +
"        q=qs[i]\n" +
"        o=linear_prefix(rows,q); n=bisect_prefix(sorted_paths,q)\n" +
"        if o!=n:\n" +
"            mm+=1; print(f'    DIFF q={q} old={o} new={n}')\n" +
"        i+=step; cnt+=1\n" +
"    return mm\n" +
"\n" +
"def bench():\n" +
"    print(f'airgenome bench/FI1 — recent file SHBF (linear vs bisect)')\n" +
"    print(f'  PATHS_N={PATHS_N} QUERIES={QUERIES}')\n" +
"    print(f'  source: synthetic (Spotlight/sfl2 fallback)')\n" +
"    rows=build_dataset(PATHS_N)\n" +
"    info=encode(rows)\n" +
"    sorted_paths=[p for p,_ in info['rows']]\n" +
"    print(f'  encode (sort + RFSF): {info[\"encode_ns\"]/1e6:.1f}ms  blob={fmt(info[\"blob_size\"])}')\n" +
"    qs=build_queries(info['rows'])\n" +
"    mm=diff_test(info['rows'],sorted_paths,qs,20)\n" +
"    print(f'  diff_test mismatches: {mm}')\n" +
"    if mm!=0: print('BENCH FAIL [diff_test != 0]'); return\n" +
"    t0=time.perf_counter_ns()\n" +
"    for k in range(QUERIES): linear_prefix(info['rows'],qs[k])\n" +
"    t1=time.perf_counter_ns()\n" +
"    ns_old=t1-t0\n" +
"    per_old=ns_old//QUERIES\n" +
"    print(f'  OLD (linear scan)        total_ns={ns_old}  per_query_ns={per_old}')\n" +
"    t0=time.perf_counter_ns()\n" +
"    for k in range(QUERIES): bisect_prefix(sorted_paths,qs[k])\n" +
"    t1=time.perf_counter_ns()\n" +
"    ns_new=t1-t0\n" +
"    per_new=ns_new//QUERIES if QUERIES>0 else 0\n" +
"    print(f'  NEW (blob mmap+bisect)   total_ns={ns_new}  per_query_ns={per_new}')\n" +
"    if ns_new>0:\n" +
"        ratio=ns_old/ns_new\n" +
"        saved_pct=((ns_old-ns_new)*100)//ns_old if ns_old>0 else 0\n" +
"        print(f'  speedup={ratio:.1f}x  saved={saved_pct}%')\n" +
"    print(f'  5-tuple: site=FI1 ROI#=recent-file-shbf baseline_ns={per_old} post_ns={per_new} diff_test=lossless')\n" +
"\n" +
"bench()\n"

fn run() {
    let tmp_py = "/tmp/bench_fi1_recent_file_" + exec("date +%s%N").trim() + ".py"
    write_file(tmp_py, PAYLOAD)
    let cmd = "/usr/bin/perl -e 'alarm 120; exec @ARGV' /usr/bin/python3 '" + tmp_py + "' 2>&1; rm -f '" + tmp_py + "'"
    let result = exec(cmd)
    print(result)
}

run()
