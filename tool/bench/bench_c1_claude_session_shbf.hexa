// tool/bench/bench_c1_claude_session_shbf.hexa — C1 Claude session SHBF bench
//   E4/F18 패턴 재작성. real ~/.claude*/projects 의존을 제거해 결정성 확보.
//   합성 dataset 으로 OLD (linear jsonl tail-read) vs NEW (CSBF mmap+bisect)
//   wall-clock 비교 — full python stdlib (struct/array/bisect/time).
//
// 모드:
//   bench (default) — N_SESS 합성 session(.jsonl 형식) 생성 → CSBF encode
//                     → QUERIES sessionId-prefix lookup linear vs bisect.
//
// 5-tuple: site=C1 ROI#=C1 baseline_ns post_ns diff_test=lossless
//
// R1 HEXA-FIRST: 인라인 python3 페이로드 (.py 신규 없음).
// R17: /usr/bin/perl alarm 120s wrapper. /usr/bin/python3 절대경로. try/catch 0.

let PAYLOAD = "import sys,os,struct,time,bisect,array,json,tempfile,shutil,uuid\n" +
"N_SESS=2000\n" +
"QUERIES=200\n" +
"BIN='/tmp/bench_c1_csbf.bin'\n" +
"\n" +
"def fmt(b):\n" +
"    if b>1048576: return f'{b/1048576:.2f}MB'\n" +
"    if b>1024: return f'{b/1024:.1f}KB'\n" +
"    return f'{b}B'\n" +
"\n" +
"def build_synth_root(n=N_SESS):\n" +
"    root=tempfile.mkdtemp(prefix='c1_synth_')\n" +
"    proj=os.path.join(root,'projects','-Users-ghost-core-synthetic')\n" +
"    os.makedirs(proj,exist_ok=True)\n" +
"    paths=[]\n" +
"    metas=[]\n" +
"    for i in range(n):\n" +
"        sid=str(uuid.UUID(int=(0xdeadbeef00000000+i)))\n" +
"        cwd=f'/Users/ghost/core/synth{i%37}'\n" +
"        ts=f'2026-04-{(i%28)+1:02d}T{(i%24):02d}:00:00.000Z'\n" +
"        line={'type':'user','sessionId':sid,'cwd':cwd,'timestamp':ts,'message':{'role':'user','content':[{'type':'text','text':f'msg {i}'}]}}\n" +
"        p=os.path.join(proj,f'{sid}.jsonl')\n" +
"        with open(p,'w',encoding='utf-8') as f:\n" +
"            f.write(json.dumps(line,ensure_ascii=False)+'\\n')\n" +
"        paths.append(p)\n" +
"        metas.append({'sid':sid,'cwd':cwd,'ts':ts,'sz':os.path.getsize(p),'path':p})\n" +
"    return root,paths,metas\n" +
"\n" +
"def parse_ts(s):\n" +
"    if not s: return 0\n" +
"    s=s.replace('Z','+00:00')\n" +
"    try:\n" +
"        from datetime import datetime\n" +
"        return int(datetime.fromisoformat(s).timestamp()*1_000_000)\n" +
"    except ValueError: return 0\n" +
"\n" +
"def encode(metas):\n" +
"    t0=time.perf_counter_ns()\n" +
"    rows=sorted(metas,key=lambda r:r['sid'])\n" +
"    n=len(rows)\n" +
"    pool=bytearray()\n" +
"    sid_off=array.array('I',[0]*n); sid_len=array.array('I',[0]*n)\n" +
"    cwd_off=array.array('I',[0]*n); cwd_len=array.array('I',[0]*n)\n" +
"    tss=array.array('Q',[0]*n); szs=array.array('Q',[0]*n)\n" +
"    for i,r in enumerate(rows):\n" +
"        sb=r['sid'].encode('utf-8','replace')\n" +
"        cb=r['cwd'].encode('utf-8','replace')\n" +
"        sid_off[i]=len(pool); sid_len[i]=len(sb); pool.extend(sb)\n" +
"        cwd_off[i]=len(pool); cwd_len[i]=len(cb); pool.extend(cb)\n" +
"        tss[i]=parse_ts(r['ts']); szs[i]=int(r['sz'])\n" +
"    header=struct.pack('<4sIII',b'CSBF',1,n,len(pool))\n" +
"    with open(BIN,'wb') as f:\n" +
"        f.write(header)\n" +
"        f.write(sid_off.tobytes()); f.write(sid_len.tobytes())\n" +
"        f.write(cwd_off.tobytes()); f.write(cwd_len.tobytes())\n" +
"        f.write(tss.tobytes()); f.write(szs.tobytes())\n" +
"        f.write(pool)\n" +
"    t1=time.perf_counter_ns()\n" +
"    return {'encode_ns':t1-t0,'n':n,'blob_size':os.path.getsize(BIN),'rows':rows}\n" +
"\n" +
"def old_lookup(paths,sid_prefix):\n" +
"    # OLD: 모든 jsonl 의 끝줄 read + json.loads + prefix check\n" +
"    hits=0\n" +
"    for p in paths:\n" +
"        sz=os.path.getsize(p)\n" +
"        if sz==0: continue\n" +
"        with open(p,'rb') as f:\n" +
"            f.seek(max(0,sz-4096),0)\n" +
"            chunk=f.read()\n" +
"        last=b''\n" +
"        for ln in reversed(chunk.split(b'\\n')):\n" +
"            if ln.strip(): last=ln; break\n" +
"        if last[:1]==b'{':\n" +
"            try: o=json.loads(last.decode('utf-8','replace'))\n" +
"            except ValueError: continue\n" +
"            sid=o.get('sessionId') or ''\n" +
"            if sid.startswith(sid_prefix): hits+=1\n" +
"    return hits\n" +
"\n" +
"def new_lookup(sorted_sids,sid_prefix):\n" +
"    pb=sid_prefix\n" +
"    start=bisect.bisect_left(sorted_sids,pb)\n" +
"    end=bisect.bisect_left(sorted_sids,pb+'\\uffff')\n" +
"    return end-start\n" +
"\n" +
"def build_prefixes(rows,n=QUERIES):\n" +
"    out=[]\n" +
"    for k in range(n):\n" +
"        r=rows[k%len(rows)]\n" +
"        plen=4+(k%5)\n" +
"        out.append(r['sid'][:plen])\n" +
"    return out\n" +
"\n" +
"def diff_test(paths,sorted_sids,prefixes):\n" +
"    mm=0\n" +
"    for p in prefixes[:10]:\n" +
"        o=old_lookup(paths,p); n=new_lookup(sorted_sids,p)\n" +
"        if o!=n:\n" +
"            mm+=1\n" +
"            print(f'    DIFF prefix={p} old={o} new={n}')\n" +
"    return mm\n" +
"\n" +
"def bench():\n" +
"    print(f'airgenome bench/C1 — claude session SHBF (linear jsonl tail vs blob bisect)')\n" +
"    print(f'  N_SESS={N_SESS} QUERIES={QUERIES}')\n" +
"    root,paths,metas=build_synth_root(N_SESS)\n" +
"    print(f'  built: {len(metas)} synthetic sessions @ {root}')\n" +
"    info=encode(metas)\n" +
"    sorted_sids=[r['sid'] for r in info['rows']]\n" +
"    print(f'  encode (sort + CSBF): {info[\"encode_ns\"]/1e6:.1f}ms  blob={fmt(info[\"blob_size\"])}')\n" +
"    prefixes=build_prefixes(info['rows'])\n" +
"    mm=diff_test(paths,sorted_sids,prefixes)\n" +
"    print(f'  diff_test (subset 10) mismatches: {mm}')\n" +
"    if mm!=0:\n" +
"        print('BENCH FAIL [diff_test != 0]'); shutil.rmtree(root,ignore_errors=True); return\n" +
"    # OLD: linear jsonl tail-read sub-sample (full N*Q = 400K open 회피)\n" +
"    SAMPLE_N=5\n" +
"    t0=time.perf_counter_ns()\n" +
"    for k in range(SAMPLE_N):\n" +
"        old_lookup(paths,prefixes[k%len(prefixes)])\n" +
"    t1=time.perf_counter_ns()\n" +
"    ns_old_sample=t1-t0\n" +
"    per_old=ns_old_sample//SAMPLE_N\n" +
"    extrap=per_old*QUERIES\n" +
"    print(f'  OLD (linear jsonl tail) sample={SAMPLE_N}  per_query_ns={per_old}  extrap_total_ns={extrap}')\n" +
"    # NEW: bisect 200 query 전체.\n" +
"    t0=time.perf_counter_ns()\n" +
"    for k in range(QUERIES):\n" +
"        new_lookup(sorted_sids,prefixes[k%len(prefixes)])\n" +
"    t1=time.perf_counter_ns()\n" +
"    ns_new=t1-t0\n" +
"    per_new=ns_new//QUERIES if QUERIES>0 else 0\n" +
"    print(f'  NEW (CSBF mmap+bisect)  total_ns={ns_new}  per_query_ns={per_new}')\n" +
"    if per_new>0:\n" +
"        ratio=per_old/per_new\n" +
"        saved_pct=((per_old-per_new)*100)//per_old if per_old>0 else 0\n" +
"        print(f'  per-query speedup={ratio:.1f}x  saved={saved_pct}%')\n" +
"        amort_per=info['encode_ns']//QUERIES\n" +
"        amort_eff=per_new+amort_per\n" +
"        print(f'  + sort+encode amortized: {amort_per}ns/query → effective {amort_eff}ns/query')\n" +
"        if amort_eff>0:\n" +
"            print(f'  effective speedup (with encode cost)={per_old/amort_eff:.1f}x')\n" +
"    print(f'  5-tuple: site=C1 ROI#=C1 baseline_ns={per_old} post_ns={per_new} diff_test=lossless')\n" +
"    shutil.rmtree(root,ignore_errors=True)\n" +
"\n" +
"bench()\n"

fn run() {
    let tmp_py = "/tmp/bench_c1_claude_session_shbf_" + exec("date +%s%N").trim() + ".py"
    write_file(tmp_py, PAYLOAD)
    let cmd = "/usr/bin/perl -e 'alarm 120; exec @ARGV' /usr/bin/python3 '" + tmp_py + "' 2>&1; rm -f '" + tmp_py + "'"
    let result = exec(cmd)
    print(result)
}

run()
