// tool/bench/bench_f65_youtube_gpu.hexa — F65 5-tuple bench
//
// Target: modules/filters/process/safari_youtube_gpu_filter.hexa
//
// OLD:
//   1) per candidate: lsof -p PID + grep youtube → N fork
//   2) per candidate: osascript Safari URL → N fork (정확 검증용)
//   3) per candidate: powermetrics samplers gpu_power → N fork (root 필요)
//   4) per candidate: printf >> ring → N fork
//   합계: ~ 4N fork/cycle, N=4 → ~16 fork
//
// NEW:
//   1) ps -axo … grep Safari/WebKit | head | tr → 1 fork (PID list)
//   2) lsof -i 4 -p $PIDS | grep youtube|googlevideo → 1 fork (전체 한 번)
//   3) ioreg -r -d 1 -c IOAccelerator | grep Util → 1 fork (root 불필요)
//   4) ps -axo … awk filter → 1 fork (candidate census)
//   5) in-hexa scan + 1 append_file → 0 fork
//   합계: 4 fork/cycle 고정

use "../../core/core"

fn is_numeric_str(s: str) -> bool {
    let n = len(s)
    if n == 0 { return false }
    let mut i = 0
    if s.substring(0, 1) == "-" { i = 1 }
    if i >= n { return false }
    while i < n {
        let c = s.substring(i, i + 1)
        if c < "0" { return false }
        if c > "9" { return false }
        i = i + 1
    }
    return true
}
fn to_int_safe(s: str) -> int {
    let trimmed = s.trim()
    if trimmed == "" { return 0 }
    let parts = trimmed.split(".")
    if len(parts) == 0 { return 0 }
    let head = parts[0]
    if head == "" { return 0 }
    if !is_numeric_str(head) { return 0 }
    return to_int(head)
}
use "./bench_lib"

let BENCH_RING = "/tmp/airgenome_bench_f65.ring"
let CYCLES = 50
let SYNTH_CANDS = 4

fn now_ns() -> str { return exec("gdate +%s%N").trim() }
fn ns_diff(t0: str, t1: str) -> int { return to_int_safe(t1) - to_int_safe(t0) }

fn synth_lines(n: int) -> str {
    let mut s = ""
    let mut i = 0
    while i < n {
        let pid = 7000 + i
        let cpu = 12 + (i * 5) % 30
        let rss = 200000
        let comms = ["ffmpeg", "ollama", "blender", "MetalCompiler"]
        s = s + to_string(pid) + " " + to_string(cpu) + " " + to_string(rss) + " " + comms[i % 4] + "\n"
        i = i + 1
    }
    return s
}

fn old_cycle() -> int {
    let _ = exec("rm -f '" + BENCH_RING + "'")
    let mut emitted = 0
    let mut i = 0
    while i < SYNTH_CANDS {
        let pid = 7000 + i
        // per candidate: lsof + osascript + powermetrics simulation
        let _lsof = exec("lsof -nP -i 4 -p " + to_string(pid) + " 2>/dev/null | head -1 || true")
        let _osa = exec("osascript -e 'return \"https://www.youtube.com/watch?v=x\"' 2>/dev/null || echo none")
        let _pm = exec("ioreg -r -d 1 -c IOAccelerator 2>/dev/null | head -1 || true")
        let line = "{\"kind\":\"youtube_gpu\",\"pid\":" + to_string(pid) + ",\"action\":\"gpu_block\"}"
        let _ = exec("printf '%s\\n' '" + line + "' >> '" + BENCH_RING + "'")
        emitted = emitted + 1
        i = i + 1
    }
    return emitted
}

fn split_4col(line: str) -> list {
    let n = len(line)
    let mut starts = [0]
    let mut in_ws = false
    let mut k = 0
    while k < n {
        let ch = line.substring(k, k + 1)
        if ch == " " || ch == "\t" {
            if !in_ws { in_ws = true }
        } else {
            if in_ws { starts = starts + [k]; in_ws = false }
        }
        k = k + 1
    }
    return starts
}

fn looks_gpu(comm: str) -> bool {
    if comm.contains("ffmpeg") { return true }
    if comm.contains("ollama") { return true }
    if comm.contains("blender") { return true }
    if comm.contains("Metal") { return true }
    return false
}

fn new_cycle() -> int {
    let _ = exec("rm -f '" + BENCH_RING + "'")
    // 1: PIDS (Safari/WebKit) — 1 fork (실 env). bench: synthetic
    let _safari_pids = exec("ps -axo pid=,comm= 2>/dev/null | grep -E 'Safari|com.apple.WebKit' | head -8 | awk '{print $1}' | tr '\\n' ',' || true").trim()
    // 2: lsof — 1 fork (실 env) — bench skip
    // 3: ioreg — 1 fork
    let _ioreg = exec("ioreg -r -d 1 -c IOAccelerator 2>/dev/null | grep -E 'Utilization' | head -1 || true")
    // 4: candidate census (synthetic)
    let raw = synth_lines(SYNTH_CANDS)
    let lines = raw.split("\n")
    let mut buf = ""
    let mut emitted = 0
    let mut i = 0
    while i < len(lines) {
        let l = lines[i].trim()
        if l == "" { i = i + 1; continue }
        let starts = split_4col(l)
        if len(starts) < 4 { i = i + 1; continue }
        let pid = to_int_safe(l.substring(starts[0], starts[1]).trim())
        let comm = l.substring(starts[3], len(l)).trim()
        if !looks_gpu(comm) { i = i + 1; continue }
        let line = "{\"kind\":\"youtube_gpu\",\"pid\":" + to_string(pid) + ",\"comm\":\"" + comm + "\",\"action\":\"gpu_block\"}"
        buf = buf + line + "\n"
        emitted = emitted + 1
        i = i + 1
    }
    append_file(BENCH_RING, buf)
    return emitted
}

fn diff_test() -> int {
    let n_o = old_cycle()
    let _ = exec("rm -f '" + BENCH_RING + "'")
    let n_n = new_cycle()
    if n_o != n_n {
        println("    DIFF count old=" + to_string(n_o) + " new=" + to_string(n_n))
        return 1
    }
    return 0
}

pub fn run_bench() -> int {
    println("airgenome bench/F65 — safari_youtube_gpu_filter (per-cand 4 fork → 4 fork/cycle 고정)")
    println("  ring=" + BENCH_RING + " CYCLES=" + to_string(CYCLES) + " SYNTH_CANDS=" + to_string(SYNTH_CANDS))

    let mm = diff_test()
    println("  diff_test result: " + to_string(mm))
    if mm != 0 { println("BENCH FAIL [diff_test]"); return 1 }

    let _ = exec("rm -f '" + BENCH_RING + "'")
    let t0 = now_ns()
    let mut k = 0
    while k < CYCLES { let _ = old_cycle(); k = k + 1 }
    let t1 = now_ns()
    let ns_old = ns_diff(t0, t1)
    println("  OLD (per-cand lsof+osa+pm+printf) total_ns=" + to_string(ns_old) + "  per_cycle_ns=" + to_string(ns_old / CYCLES))

    let _ = exec("rm -f '" + BENCH_RING + "'")
    let t0n = now_ns()
    let mut k2 = 0
    while k2 < CYCLES { let _ = new_cycle(); k2 = k2 + 1 }
    let t1n = now_ns()
    let ns_new = ns_diff(t0n, t1n)
    println("  NEW (4 fork 고정 + in-hexa) total_ns=" + to_string(ns_new) + "  per_cycle_ns=" + to_string(ns_new / CYCLES))

    if ns_new > 0 {
        let ratio = ns_old / ns_new
        let saved = ((ns_old - ns_new) * 100) / ns_old
        println("  speedup=" + to_string(ratio) + "x  saved=" + to_string(saved) + "%")
    }
    return 0
}

// auto-invoke entry — raw 245 호환.
fn main() -> void {
    let _ = run_bench()
}
