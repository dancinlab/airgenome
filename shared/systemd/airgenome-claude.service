# airgenome-claude — 원격 호스트 (ubu/ubu2) systemd user service
# 설치: cp → ~/.config/systemd/user/, systemctl --user daemon-reload, systemctl --user enable --now airgenome-claude
# 업데이트: airgenome-pull.service 가 image digest 변경 감지 후 `systemctl --user try-restart airgenome-claude`
# 환경변수: /etc/airgenome/env 또는 ~/.config/airgenome/env 에서 로드 (AIRGENOME_TAG 로 이미지 고정 가능)
#
# P4: creds bind 하드코딩 제거. bin/airgenome-claude-run 이 accounts.json SSOT
# 를 읽어 동적으로 `-v ~/.claude-<name>:/root/.claude-<name>` 생성.

[Unit]
Description=airgenome claude CLI container (long-running, cold-start=0)
Documentation=https://github.com/need-singularity/airgenome/blob/main/docs/AG-Q14_docker_migration.md
# NOTE: user-mode systemd 에서는 `docker.service` 가 보이지 않아 Requires/After
# 에서 제거. 컨테이너가 docker daemon 을 못 만나면 Restart=always 가 재시도.
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
EnvironmentFile=-%h/.config/airgenome/env
Environment=AIRGENOME_TAG=dev
Environment=REGISTRY=ghcr.io/need-singularity/airgenome
Environment=MAC_HOME=%h/mac_home
# M11a docker tuning — 원격 호스트 폭주 보호 (입력렉 완화)
Environment=AIRGENOME_CPUSET=0,1
Environment=AIRGENOME_CPU_SHARES=4096

# slice 격리 + OOM killer 우선순위 하향
Slice=airgenome-claude.slice
OOMScoreAdjust=-500

# 메인: airgenome-claude-run 이 accounts SSOT 를 읽어 creds bind 를 동적 생성
# (stale 컨테이너 정리 + pull + exec docker run 까지 스크립트 내부에서 처리).
ExecStart=%h/Dev/airgenome/bin/airgenome-claude-run

# claude 는 `docker exec -it airgenome-claude claude` 로 호출 — cx 가 wrapping
# (run 스크립트 말미의 sleep infinity 가 컨테이너 상주 유지용)

ExecStop=/usr/bin/docker stop -t 30 airgenome-claude

Restart=always
RestartSec=10
# graceful stop 시간 충분히
TimeoutStopSec=60

# 로그는 journald
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=default.target
