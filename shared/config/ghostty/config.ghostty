shell-integration-features = no-title

bell-features = no-system,no-audio,attention,title,border

keybind = super+shift+r=reload_config

keybind = super+ctrl+digit_0=text:cd ~/Dev/hexa-os\n
keybind = super+ctrl+digit_1=text:cd ~/Dev/nexus\n
keybind = super+ctrl+digit_2=text:cd ~/Dev/anima\n
keybind = super+ctrl+digit_3=text:cd ~/Dev/n6-architecture\n
keybind = super+ctrl+digit_4=text:cd ~/Dev/hexa-lang\n
keybind = super+ctrl+digit_5=text:cd ~/mango/prism\n
keybind = super+ctrl+digit_6=text:cd ~/mango/prism-manager\n
keybind = super+ctrl+digit_8=text:cd ~/Dev/papers\n
keybind = super+ctrl+digit_9=text:cd ~/Dev/contact\n
