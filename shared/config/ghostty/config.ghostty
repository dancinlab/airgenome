shell-integration-features = no-title

bell-features = no-system,no-audio,attention,title,border

keybind = super+shift+r=reload_config

# cmd+ctrl+digit_N bindings moved to ~/.skhdrc (skhd OS-level daemon) — they now
# open a NEW Ghostty window with fixed title + cd + cl, instead of typing text
# into the current tab (which broke inside Claude Code CLI).
