#!/usr/bin/env bash
# shared/claudx/loadgate — system_load 체크 (M13d · v1 sampler EMA 간소화)
#
# claudx 진입부에서 `source .../loadgate` 또는 `$(.../loadgate)` 로 호출.
# 반환 코드 0 = ok, 1 = warn (진행 OK), 2 = danger (hold 권유), 3 = critical (abort).
# stdout 에 level 이름 출력.
#
# 환경:
#   CLAUDX_LOADGATE_OFF=1       → 체크 생략 (모든 것 ok)
#   CLAUDX_LOADGATE_NO_CLEAN=1  → Mac phantom cleanup 건너뜀 (diag 전용)
#   CLAUDX_LOAD_WARN            warn 배수 (default ncpu × 2)
#   CLAUDX_LOAD_DANGER          danger 배수 (default ncpu × 4)
#   CLAUDX_LOAD_CRITICAL        critical 배수 (default ncpu × 6)

set -u

if [ "${CLAUDX_LOADGATE_OFF:-0}" = "1" ]; then
    echo "ok"
    exit 0
fi

ncpu=$(nproc 2>/dev/null || sysctl -n hw.ncpu 2>/dev/null || echo 4)
warn="${CLAUDX_LOAD_WARN:-$((ncpu * 2))}"
danger="${CLAUDX_LOAD_DANGER:-$((ncpu * 4))}"
critical="${CLAUDX_LOAD_CRITICAL:-$((ncpu * 6))}"

# 1분 load avg (int×100)
_read_load_x100() {
    local l
    if [ -r /proc/loadavg ]; then
        l=$(awk '{print $1}' /proc/loadavg)
    else
        # macOS: sysctl vm.loadavg → { 1.23 4.56 7.89 }
        l=$(sysctl -n vm.loadavg 2>/dev/null | awk '{print $2}')
    fi
    l="${l:-0}"
    awk -v L="$l" 'BEGIN{printf "%d", L*100}'
}

# Mac phantom cleanup — stale hexa_stage0 wrapper/shim/binary (etime ≥5min)
# claude CLI (comm=claude) 절대 보호. HEXA_LOCAL=1 의도적 local 실행도 보호.
_mac_phantom_clean() {
    [ "$(uname -s)" = "Darwin" ] || return 0
    [ "${CLAUDX_LOADGATE_NO_CLEAN:-0}" = "1" ] && return 0
    [ "${HEXA_LOCAL:-0}" = "1" ] && return 0

    local pids
    pids=$(ps -Ao pid,etime,comm,command 2>/dev/null | awk '
        {
            pid=$1; e=$2; c=$3; sec=0;
            n=split(e, dp, "-");
            if (n==2) { days=dp[1]+0; e=dp[2] } else days=0;
            n=split(e, tp, ":");
            if (n==3)      sec = days*86400 + tp[1]*3600 + tp[2]*60 + tp[3];
            else if (n==2) sec = days*86400 + tp[1]*60 + tp[2];
            else           sec = tp[1]+0;
            if (c != "claude" && sec >= 300 && index($0, "hexa_stage0") > 0) print pid;
        }')
    for p in $pids; do kill -9 "$p" 2>/dev/null; done
}

li=$(_read_load_x100)
wi=$((warn * 100))
di=$((danger * 100))
ci=$((critical * 100))

# 부팅 transient grace: Mac/Linux 모두 부팅 직후 launchd/systemd 가
# 일제 spawn 하면 1분 loadavg 가 ncpu×6 이상 스파이크하는 게 정상.
# uptime < 240s 면 critical→danger 로 강등 (60s hold 만, abort 안 함).
_uptime_sec() {
    if [ -r /proc/uptime ]; then
        awk '{printf "%d", $1}' /proc/uptime
    else
        local boot now
        boot=$(sysctl -n kern.boottime 2>/dev/null | awk -F'[ ,]' '{print $4}')
        now=$(date +%s)
        [ -n "$boot" ] && echo $((now - boot)) || echo 99999
    fi
}

# critical 직전 재시도: Mac 에서는 phantom stage0 wrapper 누적이 원인일 때가 많다.
# 정리 후 2s 대기 후 재측정. 여전히 critical 이면 진짜 critical.
if [ "$li" -ge "$ci" ]; then
    _mac_phantom_clean
    sleep 2
    li=$(_read_load_x100)
fi

# 부팅 grace 적용 (재측정 후에도 critical 이면 강등)
if [ "$li" -ge "$ci" ] && [ "$(_uptime_sec)" -lt 240 ]; then
    echo "danger"; exit 2
fi

if [ "$li" -ge "$ci" ]; then echo "critical"; exit 3
elif [ "$li" -ge "$di" ]; then echo "danger"; exit 2
elif [ "$li" -ge "$wi" ]; then echo "warn"; exit 1
else echo "ok"; exit 0
fi
