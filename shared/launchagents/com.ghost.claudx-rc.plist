<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  com.ghost.claudx-rc — M13g iOS RC 배경 세션 (2026-04-19)

  install:
    cp shared/launchagents/com.ghost.claudx-rc.plist ~/Library/LaunchAgents/
    launchctl load ~/Library/LaunchAgents/com.ghost.claudx-rc.plist

  check:
    launchctl list | grep claudx-rc
    claudx-rc with the status flag

  unload:
    launchctl unload ~/Library/LaunchAgents/com.ghost.claudx-rc.plist
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.ghost.claudx-rc</string>

  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>-lc</string>
    <string>exec /Users/ghost/Dev/airgenome/bin/claudx-rc</string>
  </array>

  <key>EnvironmentVariables</key>
  <dict>
    <key>HOME</key><string>/Users/ghost</string>
    <key>PATH</key><string>/Users/ghost/Dev/airgenome/bin:/usr/local/bin:/usr/bin:/bin</string>
    <key>CLAUDX_RC_ACCT</key><string>claude1</string>
    <key>CLAUDX_RC_LOOP</key><string>1h /smash 돌파탐색 + /free 교대 — 현 컨텍스트 이어가며 atlas.n6 에 실험 기록</string>
    <key>CLAUDX_RC_PREFIX</key><string>mobile</string>
    <key>CLAUDX_NO_WATCH</key><string>1</string>
    <key>CLAUDX_MAX_ROT</key><string>0</string>
  </dict>

  <key>RunAtLoad</key>
  <true/>

  <key>KeepAlive</key>
  <dict>
    <key>SuccessfulExit</key><false/>
    <key>Crashed</key><true/>
  </dict>

  <key>ThrottleInterval</key>
  <integer>30</integer>

  <key>StandardOutPath</key>
  <string>/tmp/claudx-rc.out</string>

  <key>StandardErrorPath</key>
  <string>/tmp/claudx-rc.err</string>

  <key>WorkingDirectory</key>
  <string>/Users/ghost/Dev/airgenome</string>
</dict>
</plist>
