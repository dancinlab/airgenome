# Third DSL scanner — /tmp/hexa_* file count ceiling. Addresses the
# root cause surfaced by ag_hexa_cache_scan (1532 files found).

name=tmp_hexa_pressure
kind=threshold_abs
source=glob_count:/tmp/hexa_*
# Calibration 2026-04-23: bin/tmp-hexa-prune hourly LaunchAgent now keeps
# the directory bounded.  Real APFS-freeze risk begins around 8000+; set
# threshold above that with headroom.  Active AOT sessions legitimately
# spawn 2000-3000 transient files before the hourly prune.
baseline_bytes=8000
alarm_pct=0
severity=high
description=/tmp/hexa_* file count > 8000 (APFS B-tree degradation risk)
