#!/usr/bin/env bash
# airgenome/.claude/hooks/enforce_dist — PreToolUse distribution enforcer
#
# 목적: Mac 로컬 heavy compute 금지 (AG6/R-MAC-01) 를 코드 레벨로 강제.
# .session_defaults 의 프롬프트 규칙에 의존하지 않음 — 실제 Bash/Task 호출이
# Mac heavy 패턴일 때 PreToolUse hook 이 deny 로 차단.
#
# Matchers: Bash + Task
#
# Bash 차단:
#   - HEXA_LOCAL=1 hexa ... (Mac 로컬 hexa 강제)
#   - /hexa-lang/build/hexa_stage0 직접 경로 (RSS cap/lock 우회)
#   - claude -p 직접 호출 (cx/claudx 래핑 없음 — host routing 우회)
# Bash 통과 (allowlist):
#   - ssh <host> .../ cx .../ claudx .../ airgenome .../ nx ...
#   - HEXA_LOCAL=0 prefix / NO_HEXA_SHIM=1 prefix
#   - 기타 light ops (git/jq/grep/ls/cat/ps/awk 등)
#
# Task (subagent) 차단:
#   - prompt 에 heavy 지표 (hexa run|parse|self-test|compile|train 등) 있고
#     ssh/cx/airgenome agent-run 래핑 힌트 없음
#
# 입력: stdin JSON {"tool_name":..., "tool_input":{...}}
# 출력: deny 시 hookSpecificOutput JSON, 나머지 exit 0.

set -u

INPUT="$(cat)"
TOOL=$(printf '%s' "$INPUT" | jq -r '.tool_name // empty' 2>/dev/null)

decide_deny() {
    printf '{"hookSpecificOutput":{"hookEventName":"PreToolUse","permissionDecision":"deny","permissionDecisionReason":%s}}\n' \
        "$(printf '%s' "$1" | jq -Rs .)"
    exit 0
}

case "$TOOL" in
    Bash)
        CMD=$(printf '%s' "$INPUT" | jq -r '.tool_input.command // empty' 2>/dev/null)
        [ -z "$CMD" ] && exit 0

        # allowlist — ssh/cx/claudx/airgenome/nx 래핑 시작은 자동 승인
        if printf '%s' "$CMD" | head -c 400 | grep -qE '(^|[^[:alnum:]_])(ssh |cx |claudx |airgenome |nx |HEXA_LOCAL=0 |NO_HEXA_SHIM=1 )'; then
            exit 0
        fi

        # Mac 로컬 hexa 강제 — ssh 앞에 없으면 차단
        if printf '%s' "$CMD" | grep -qE 'HEXA_LOCAL=1[[:space:]]+hexa([[:space:]]|$)'; then
            decide_deny "Mac 로컬 hexa 실행 금지 (AG6/R-MAC-01). HEXA_LOCAL=1 제거하거나 'ssh <host> ...' 로 래핑. host 선택: dispatch_state.json .selection."
        fi
        # hexa_stage0 직접 경로 — shim/watchdog 우회
        if printf '%s' "$CMD" | grep -qE '/hexa-lang/build/hexa_stage0([[:space:]]|$)|/hexa-lang/build/hexa_stage0\.real'; then
            decide_deny "hexa_stage0 직접 경로 호출 금지 — RSS cap/lock 우회 (2026-04-18 Mac panic 재발 위험). hexa run ... 또는 ssh <host> hexa_stage0 사용."
        fi
        # claude -p 직접 호출 — cx/claudx 래핑 없음
        if printf '%s' "$CMD" | grep -qE '(^|[;&|[:space:]])claude[[:space:]]+-p([[:space:]]|$)'; then
            decide_deny "claude -p 직접 호출 금지 — host routing 우회. cx -p 또는 claudx -p 사용 (pool rotation + host pick)."
        fi

        exit 0
        ;;

    Task)
        PROMPT=$(printf '%s' "$INPUT" | jq -r '.tool_input.prompt // empty' 2>/dev/null)
        DESC=$(printf '%s' "$INPUT" | jq -r '.tool_input.description // empty' 2>/dev/null)
        [ -z "$PROMPT" ] && exit 0

        # remote hint 있으면 통과
        if printf '%s' "$PROMPT" | grep -qiE 'ssh[[:space:]]+(ubu[12]?|hetzner|htz)|cx[[:space:]]+-p|claudx[[:space:]]+-p|airgenome[[:space:]]+agent-run|\<ubu[12]\>|hetzner|\<htz\>'; then
            exit 0
        fi

        # heavy 지표 감지 — ssh/cx 래핑 없으면 차단
        if printf '%s' "$PROMPT" | grep -qiE 'hexa[[:space:]]+run|hexa[[:space:]]+parse|self[- ]test|npm[[:space:]]+(build|install|test)|cargo[[:space:]]+(build|test|run)|make[[:space:]]+-j|pytest|train\.hexa|compile|benchmark'; then
            decide_deny "Subagent heavy 작업 감지 — 프롬프트에 원격 host (ssh ubu2/hetzner 또는 cx -p / airgenome agent-run) 명시 필요. host 선택: dispatch_state.json .selection.{compute|heavy|gpu}."
        fi

        exit 0
        ;;

    *)
        exit 0
        ;;
esac
