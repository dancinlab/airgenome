# env vars for child=tg-bot (migrated from com.airgenome.tg-bot.plist)
export PATH="/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin:/Users/ghost/.hx/packages/airgenome/bin:/Users/ghost/core/nexus/shared/bin:/Users/ghost/.hx/bin"
export HOME="/Users/ghost"
export LANG="en_US.UTF-8"
export TG_TOKEN_FILE="/Users/ghost/etc/secret/tg_bot_token"
export TG_OFFSET_FILE="/Users/ghost/.airgenome/tg_core.offset"
export TG_DISPATCH="/Users/ghost/.hx/packages/airgenome/bin/tg_cx_md"
export TG_PARSE_MODE="Markdown"
