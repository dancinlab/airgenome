# env vars for child=tap (migrated from com.airgenome.tap.plist)
# raw 240 § B C4: in-process harvest/forecast/label dispatcher.
# AIRG_TAP_LOOP=1 (default 활성) → 60s/300s/3600s timer + posix_spawn 자식.
export AIRG_TAP_LOOP="1"
# Safari 통합 wave (F45/F64/F65/F66) — own 9 default ON.
export AIRG_TAP_LOOP_SAFARI="1"
# own 9 BENCHMARK-COMPLETE wave: blob refresh (E4 / F18 / PTBF).
export AIRG_TAP_LOOP_BLOBS="1"
# own 9 BENCHMARK-COMPLETE wave: process gate filters.
export AIRG_TAP_LOOP_PROCS="1"
# own 9 K-wave: macOS-level Type E data 재해석.
export AIRG_TAP_LOOP_DATAE="1"
