<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!--
        com.airgenome.supervisor
        ========================
        Single-process child supervisor (mini-launchd). Replaces 6 legacy
        LaunchAgents:
          com.airgenome                  → child label "run"            (keepalive)
          com.airgenome.hook-watch       → child label "hook-watch"     (interval:5)
          com.airgenome.settings-guard   → child label "settings-guard" (watchpaths)
          com.airgenome.tap              → child label "tap"            (keepalive-crashonly)
          com.airgenome.tg-bot           → child label "tg-bot"         (keepalive)
          com.airgenome.vacuum_watcher   → child label "vacuum-watcher" (interval:3600)

        Architecture: fork/exec, NOT threads. Each child runs as its own OS
        process supervised by a per-child wrapper subshell. A child crash does
        not affect siblings; the supervisor itself is supervised by launchd
        (KeepAlive=true here).

        Job table:  config/launchd/supervisor.jobs.tsv (TSV, '#' comments).
        Per-child env vars:  config/launchd/envs/<label>.env (shell-source).
        Reload table without restart:  airgenome-supervisor reload  (SIGHUP).
        Status dump (per-child):       airgenome-supervisor status  (SIGUSR1).

        Manual bootstrap (after running bin/airgenome-supervisor-migrate):
          launchctl bootstrap gui/$(id -u) \
            ~/Library/LaunchAgents/com.airgenome.supervisor.plist
          launchctl enable gui/$(id -u)/com.airgenome.supervisor
          launchctl kickstart -k gui/$(id -u)/com.airgenome.supervisor

        Unload:
          launchctl bootout gui/$(id -u)/com.airgenome.supervisor
    -->

    <key>Label</key>
    <string>com.airgenome.supervisor</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/Users/ghost/core/airgenome/bin/airgenome-supervisor</string>
        <string>run</string>
    </array>

    <key>RunAtLoad</key>
    <true/>

    <key>KeepAlive</key>
    <true/>

    <!-- Throttle 10s (same as the legacy com.airgenome plist). The supervisor
         itself is single-instance (PID file guard), so launchd respawning it
         too quickly is harmless but wasteful. -->
    <key>ThrottleInterval</key>
    <integer>10</integer>

    <key>StandardOutPath</key>
    <string>/Users/ghost/.airgenome/supervisor/supervisor.stdout.log</string>

    <key>StandardErrorPath</key>
    <string>/Users/ghost/.airgenome/supervisor/supervisor.stderr.log</string>

    <key>WorkingDirectory</key>
    <string>/Users/ghost/core/airgenome</string>

    <key>EnvironmentVariables</key>
    <dict>
        <!-- Path superset of all child env files so any tool referenced in
             jobs.tsv resolves. Per-child env files (config/launchd/envs/) are
             sourced inside each wrapper for full per-job env isolation. -->
        <key>PATH</key>
        <string>/opt/homebrew/bin:/opt/homebrew/sbin:/usr/local/bin:/usr/local/sbin:/usr/bin:/bin:/usr/sbin:/sbin:/Users/ghost/.hx/bin:/Users/ghost/.hx/shared/bin:/Users/ghost/.hx/packages/airgenome/bin:/Users/ghost/core/nexus/shared/bin:/Users/ghost/core/airgenome/bin:/Users/ghost/core/hexa-lang</string>
        <key>HOME</key>
        <string>/Users/ghost</string>
        <key>LANG</key>
        <string>en_US.UTF-8</string>
        <key>AIRGENOME_ROOT</key>
        <string>/Users/ghost/core/airgenome</string>
    </dict>

    <key>ProcessType</key>
    <string>Background</string>

    <!-- Bias slightly toward responsiveness so the supervisor's 1s polling
         tick + signal handling don't lag under load. -->
    <key>Nice</key>
    <integer>-5</integer>

    <key>LimitLoadToSessionType</key>
    <string>Aqua</string>
</dict>
</plist>
