// filters/module/process/safari_battery_freeze_filter.hexa
// F66 — battery < 20% AND Safari 활성 → bg tab 자동 freeze (Type A 게이트)
//
// 역할:
//   배터리 잔량이 임계 이하일 때 Safari background WebContent 들을 freeze 추천.
//   F45 게놈 (axes[4] = tab_active) 을 참조하여 active 가 아닌 탭만 후보.
//   본 모듈은 dry-run signal emit only — 실제 taskpolicy_bg 호출 0.
//
// 데이터 소스:
//   pmset -g batt        — 배터리 % + AC 연결 여부
//   forge/safari_tabs.ring — F45 가 채운 6축 게놈 ring (마지막 N 행)
//   lsappinfo            — Safari frontmost?
//
// 재해석:
//   battery<20 AND not on AC AND Safari frontmost
//     → "사용자가 Safari 보고 있음 + 배터리 위험"
//     → bg tab 들에 taskpolicy_bg + AX hide signal
//   battery<20 AND not on AC AND Safari NOT frontmost
//     → 더 공격적: 모든 WebContent 후보
//
// 출력 ring: forge/throttle_signals.ring (F64/F65 공유, kind="battery_freeze")
//   {"ts":"...","kind":"battery_freeze","pid":N,"comm":"WebContent","battery":NN,
//    "action":"taskpolicy_bg","ax_action":"hide","reason":"low_batt+bg_tab",
//    "confidence":"NN/100"}
//
// 제약:
//   - try/catch 0, top-level main() 0
//   - 실 taskpolicy_bg / AX hide 호출 0 (signal emit only)
//   - F45 ring 없으면 ps 직접 census fallback
//
// ROI 추정 (battery 보호):
//   M14 16" 평균 idle WebContent 1탭 ≈ 0.5W * 8탭 = 4W
//   bg taskpolicy 적용 시 대략 60% 감소 → ~2.4W 절감
//   → 100Wh 배터리에서 추가 ~24분 사용 가능 (battery<20% 약 20Wh 잔량 기준)
//   → 잔여 가용시간 약 +30% 연장 효과 추정
//
// 5-tuple bench: tool/bench/bench_f66_battery_freeze.hexa
//   OLD: per-cycle (pmset + osascript + ps + jq ring) = 4+ fork
//   NEW: pmset 1회 + read_file ring + in-hexa axes 파싱 + lsappinfo cache
//   기대: 120ms → 6ms (~20x, 95%↓), lossless candidate set

use "../../../airgenome/core/airgenome"

// A6 RFC interim — to_int_safe local helper (label.hexa pattern 직접 이식).
// `to_int("0.0")` panic 회피. A6 hexa-lang stdlib promote 후 제거 예정.
fn is_numeric_str(s: str) -> bool {
    let n = len(s)
    if n == 0 { return false }
    let mut i = 0
    if s.substring(0, 1) == "-" { i = 1 }
    if i >= n { return false }
    while i < n {
        let c = s.substring(i, i + 1)
        if c < "0" { return false }
        if c > "9" { return false }
        i = i + 1
    }
    return true
}
fn to_int_safe(s: str) -> int {
    let trimmed = s.trim()
    if trimmed == "" { return 0 }
    let parts = trimmed.split(".")
    if len(parts) == 0 { return 0 }
    let head = parts[0]
    if head == "" { return 0 }
    if !is_numeric_str(head) { return 0 }
    return to_int(head)
}

let RING_TABS = ring_path("safari_tabs.ring")
let RING_OUT = ring_path("throttle_signals.ring")
let BATT_TRIGGER = 20         // < 20% → 발동
let MAX_EMIT_PER_CYCLE = 16
let MAX_RING_OUT = 480

fn ts_iso() -> str {
    return exec("date -u +%Y-%m-%dT%H:%M:%SZ").trim()
}

fn frontmost_app() -> str {
    let cached = env("AG_COORD_FRONTMOST")
    if cached != "" { return cached }
    return exec("lsappinfo info -only name \"$(lsappinfo front)\" 2>/dev/null | awk -F'\"' 'NF>=4{print $4}'").trim()
}

// ── battery & AC ──────────────────────────────────────────────────────
struct BattState { pct: int, on_ac: bool, raw: str }

fn read_battery() -> BattState {
    let raw = exec("pmset -g batt 2>/dev/null").trim()
    // 형식 예: "Now drawing from 'Battery Power'\n -InternalBattery-0 (id=...)\t72%; discharging; ..."
    let mut pct = 100
    let mut on_ac = true
    if raw.contains("Battery Power") { on_ac = false }
    if raw.contains("AC Power") { on_ac = true }
    // % 추출 — 첫 % 직전 정수
    let parts = raw.split("%")
    if len(parts) >= 2 {
        let pre = parts[0]
        // 마지막 공백 이후 ~ 끝
        let n = len(pre)
        let mut i = n - 1
        let mut start = 0
        while i >= 0 {
            let ch = pre.substring(i, i + 1)
            if ch == " " || ch == "\t" || ch == "\n" { start = i + 1; i = -1 }
            else { i = i - 1 }
        }
        let num = pre.substring(start, n).trim()
        pct = to_int_safe(num)
    }
    return BattState { pct: pct, on_ac: on_ac, raw: raw }
}

// ── F45 ring 에서 마지막 cycle 의 axes 행 추출 ────────────────────────
// own 6 site-6 / own 7 site-9 / own 8 site-14 패턴.
fn jq_field_int(line: str, key: str) -> int {
    let anchor = "\"" + key + "\":"
    let parts = line.split(anchor)
    if len(parts) < 2 { return 0 }
    let after = parts[1]
    let n = len(after)
    let mut i = 0
    while i < n {
        let ch = after.substring(i, i + 1)
        if ch == "," { return to_int_safe(after.substring(0, i).trim()) }
        if ch == "}" { return to_int_safe(after.substring(0, i).trim()) }
        i = i + 1
    }
    return to_int_safe(after.trim())
}

// axes 추출: line 에 "\"axes\":[a,b,c,d,e,f]"
fn extract_axis(line: str, idx: int) -> int {
    let anchor = "\"axes\":["
    let parts = line.split(anchor)
    if len(parts) < 2 { return 0 }
    let after = parts[1]
    // ']' 이전까지가 axes
    let bp = after.split("]")
    if len(bp) < 1 { return 0 }
    let inside = bp[0]
    let nums = inside.split(",")
    if idx >= len(nums) { return 0 }
    return to_int_safe(nums[idx].trim())
}

struct TabCand {
    pid: int,
    comm: str,
    cpu: int,
    is_active: bool
}

fn comm_from_line(line: str) -> str {
    let anchor = "\"comm\":\""
    let parts = line.split(anchor)
    if len(parts) < 2 { return "" }
    let after = parts[1]
    let qp = after.split("\"")
    if len(qp) < 1 { return "" }
    return qp[0]
}

fn collect_from_ring() -> list {
    if !file_exists(RING_TABS) { return [] }
    let raw = read_file(RING_TABS)
    let lines = raw.split("\n")
    // 가장 최근 cycle 의 ts 만 필터 (마지막 ts).
    let mut last_ts = ""
    let mut i = len(lines) - 1
    while i >= 0 {
        let l = lines[i].trim()
        if l != "" {
            let anchor = "\"ts\":\""
            let parts = l.split(anchor)
            if len(parts) >= 2 {
                let qp = parts[1].split("\"")
                if len(qp) >= 1 { last_ts = qp[0]; i = -1 }
                else { i = i - 1 }
            } else { i = i - 1 }
        } else { i = i - 1 }
    }
    let mut out = []
    let mut j = 0
    while j < len(lines) {
        let l = lines[j].trim()
        if l == "" { j = j + 1; continue }
        if !l.contains("\"ts\":\"" + last_ts + "\"") { j = j + 1; continue }
        let pid = jq_field_int(l, "pid")
        let cpu = extract_axis(l, 0)
        let act = extract_axis(l, 4)
        let comm = comm_from_line(l)
        out = out + [TabCand { pid: pid, comm: comm, cpu: cpu, is_active: act == 1 }]
        j = j + 1
    }
    return out
}

// fallback census (F45 ring 비어있을 때)
fn collect_from_ps(is_safari_front: bool, max_active_pid: int) -> list {
    let raw = exec("ps -axo pid=,pcpu=,comm= 2>/dev/null | awk '$1+0>100' | grep -E 'WebContent' || true")
    let lines = raw.split("\n")
    let mut out = []
    let mut i = 0
    while i < len(lines) {
        let l = lines[i].trim()
        if l == "" { i = i + 1; continue }
        // pid pcpu comm
        let n = len(l)
        let mut starts = [0]
        let mut in_ws = false
        let mut k = 0
        while k < n {
            let ch = l.substring(k, k + 1)
            if ch == " " || ch == "\t" {
                if !in_ws { in_ws = true }
            } else {
                if in_ws { starts = starts + [k]; in_ws = false }
            }
            k = k + 1
        }
        if len(starts) < 3 { i = i + 1; continue }
        let pid = to_int_safe(l.substring(starts[0], starts[1]).trim())
        let cpu = to_int_safe(l.substring(starts[1], starts[2]).trim())
        let comm = l.substring(starts[2], n).trim()
        let active = is_safari_front && pid == max_active_pid
        out = out + [TabCand { pid: pid, comm: comm, cpu: cpu, is_active: active }]
        i = i + 1
    }
    return out
}

fn rotate_out() -> int {
    let raw = read_file(RING_OUT)
    let lines = raw.split("\n")
    let mut all = []
    let mut i = 0
    while i < len(lines) {
        if lines[i] != "" { all = all + [lines[i]] }
        i = i + 1
    }
    if len(all) <= MAX_RING_OUT { return len(all) }
    let start = len(all) - MAX_RING_OUT
    let mut out = ""
    let mut j = start
    while j < len(all) { out = out + all[j] + "\n"; j = j + 1 }
    write_file(RING_OUT, out)
    return MAX_RING_OUT
}

fn comm_escape(s: str) -> str {
    return s.replace("\\", "\\\\").replace("\"", "\\\"")
}

pub fn run_filter() -> int {
    let _ = exec("mkdir -p '" + forge_dir() + "'")
    let ts = ts_iso()
    let bs = read_battery()
    if bs.on_ac {
        println("safari_battery_freeze_filter: on AC — pass (batt=" + to_string(bs.pct) + "%)")
        return 0
    }
    if bs.pct >= BATT_TRIGGER {
        println("safari_battery_freeze_filter: batt=" + to_string(bs.pct) + "% >= " + to_string(BATT_TRIGGER) + " — pass")
        return 0
    }
    let front = frontmost_app()
    let safari_front = front == "Safari"

    let mut cands = collect_from_ring()
    if len(cands) == 0 {
        // fallback: ps 직접
        cands = collect_from_ps(safari_front, 0)
    }
    if len(cands) == 0 {
        println("safari_battery_freeze_filter: batt=" + to_string(bs.pct) + "% no WebContent")
        return 0
    }

    // 정책:
    //   safari_front=true  → is_active=false 만 emit (foreground 탭 보호)
    //   safari_front=false → 모두 emit (모든 탭 BG 가능)
    let mut buf = ""
    let mut emitted = 0
    let mut k = 0
    while k < len(cands) {
        if emitted >= MAX_EMIT_PER_CYCLE { k = len(cands) }
        else {
            let c = cands[k]
            let mut skip = false
            if safari_front && c.is_active { skip = true }
            if !skip {
                let conf = if bs.pct < 10 { "98/100" } else { "90/100" }
                let line = "{\"ts\":\"" + ts + "\""
                         + ",\"kind\":\"battery_freeze\""
                         + ",\"pid\":" + to_string(c.pid)
                         + ",\"comm\":\"" + comm_escape(c.comm) + "\""
                         + ",\"cpu\":" + to_string(c.cpu)
                         + ",\"battery\":" + to_string(bs.pct)
                         + ",\"on_ac\":false"
                         + ",\"action\":\"taskpolicy_bg\""
                         + ",\"ax_action\":\"hide\""
                         + ",\"confidence\":\"" + conf + "\""
                         + ",\"reason\":\"low_batt+bg_tab\"}"
                buf = buf + line + "\n"
                emitted = emitted + 1
            }
            k = k + 1
        }
    }
    append_file(RING_OUT, buf)
    let kept = rotate_out()
    println("safari_battery_freeze_filter: batt=" + to_string(bs.pct) + "% safari_front=" + (if safari_front { "true" } else { "false" }) + " emitted=" + to_string(emitted) + " ring_kept=" + to_string(kept))
    return emitted
}

pub fn self_test() -> void {
    // 1. axes 추출
    let line = "{\"ts\":\"2026-04-30T00:00:00Z\",\"pid\":1234,\"comm\":\"WebContent\",\"axes\":[42,50,0,10,1,30]}"
    if extract_axis(line, 0) != 42 { panic("F66 self_test [axis 0]") }
    if extract_axis(line, 4) != 1  { panic("F66 self_test [axis 4 active]") }
    if extract_axis(line, 5) != 30 { panic("F66 self_test [axis 5 gpu]") }
    if jq_field_int(line, "pid") != 1234 { panic("F66 self_test [jq pid]") }
    if comm_from_line(line) != "WebContent" { panic("F66 self_test [comm extract]") }
    // 2. battery parse — 합성 raw
    let raw_disch = " -InternalBattery-0 (id=12345)\t18%; discharging; 1:23 remaining present: true"
    let parts = raw_disch.split("%")
    if len(parts) < 2 { panic("F66 self_test [batt split]") }
    println("  ✅ F66 safari_battery_freeze_filter self_test PASS")
}

// auto-invoke entry — raw 245 호환 (top-level main() 호출 0, runtime auto-fires).
fn main() -> void {
    let a = args()
    if len(a) >= 3 && a[2] == "self-test" {
        self_test()
        return
    }
    let _ = run_filter()
}
