// filters/module/process/safari_active_throttle_signal.hexa
// F64 — Safari 활성 시 高-CPU 다른 process 에 taskpolicy_bg 시그널 emit (Type B)
//
// 역할:
//   Safari 가 frontmost 인 동안 사용자가 능동적으로 보고 있는 탭의 응답성을
//   보호하기 위해, 비-Safari high-CPU process 에 BG 정책을 추천 (집행은 별도).
//
// 데이터 소스:
//   lsappinfo / NSWorkspace (env AG_COORD_FRONTMOST 우선) → frontmost
//   ps -axo pid,pcpu,rss,comm — 단일 census (own 6 site-6 batch)
//
// 재해석:
//   Safari frontmost = "사용자 active context" → 다른 high-CPU 프로세스 = 방해 요소
//   단, HARD_NEVER 가드: WindowServer / launchd / loginwindow / kernel_task /
//   coreaudiod / hidd 등 시스템 본체는 절대 시그널 emit 금지.
//
// 출력 ring: forge/throttle_signals.ring (JSONL append-only, own 5 site-3 batch)
//   {"ts":"...","kind":"safari_active","pid":N,"comm":"...","cpu":..,"action":"taskpolicy_bg",
//    "confidence":"NN/100","reason":"..."}
//
// 제약:
//   - emit-only. 실제 taskpolicy_bg 호출 0.
//   - try/catch 0, top-level main() 0.
//
// 5-tuple bench: tool/bench/bench_f64_active_signal.hexa
//   OLD: 각 candidate PID 별 osascript + ps 추가 fork = N+2 fork
//   NEW: ps 1회 + in-hexa scan + 1회 append_file
//   기대: 80ms → 4ms (~20x, 95%↓), lossless signal set

use "../../../airgenome/core/airgenome"

// A6 RFC interim — to_int_safe local helper (label.hexa pattern 직접 이식).
// `to_int("0.0")` panic 회피. A6 hexa-lang stdlib promote 후 제거 예정.
fn is_numeric_str(s: str) -> bool {
    let n = len(s)
    if n == 0 { return false }
    let mut i = 0
    if s.substring(0, 1) == "-" { i = 1 }
    if i >= n { return false }
    while i < n {
        let c = s.substring(i, i + 1)
        if c < "0" { return false }
        if c > "9" { return false }
        i = i + 1
    }
    return true
}
fn to_int_safe(s: str) -> int {
    let trimmed = s.trim()
    if trimmed == "" { return 0 }
    let parts = trimmed.split(".")
    if len(parts) == 0 { return 0 }
    let head = parts[0]
    if head == "" { return 0 }
    if !is_numeric_str(head) { return 0 }
    return to_int(head)
}

let RING = ring_path("throttle_signals.ring")
let MAX_RING = 480
let CPU_TRIGGER = 25      // pcpu > 25 → 후보
let RSS_MB_FLOOR = 50     // 메모리 50MB 미만 = 무시 (놀이감 프로세스)
let MAX_EMIT_PER_CYCLE = 8

fn ts_iso() -> str {
    return exec("date -u +%Y-%m-%dT%H:%M:%SZ").trim()
}

fn frontmost_app() -> str {
    let cached = env("AG_COORD_FRONTMOST")
    if cached != "" { return cached }
    return exec("lsappinfo info -only name \"$(lsappinfo front)\" 2>/dev/null | awk -F'\"' 'NF>=4{print $4}'").trim()
}

// ── HARD_NEVER 가드 — 시스템 critical 프로세스 ─────────────────────────
fn is_hard_never(comm: str) -> bool {
    let blocklist = ["WindowServer", "launchd", "loginwindow", "kernel_task",
                     "coreaudiod", "hidd", "powerd", "configd", "mds",
                     "Dock", "Finder", "ControlCenter", "SystemUIServer",
                     "Safari", "WebContent", "com.apple.WebKit",
                     "airgenome", "hexa"]
    let mut i = 0
    while i < len(blocklist) {
        if comm.contains(blocklist[i]) { return true }
        i = i + 1
    }
    return false
}

// ── census ─────────────────────────────────────────────────────────────
struct ProcRow {
    pid: int,
    cpu: int,
    rss_kb: int,
    comm: str
}

fn split_4col(line: str) -> ProcRow {
    let n = len(line)
    let mut starts = [0]
    let mut in_ws = false
    let mut i = 0
    while i < n {
        let ch = line.substring(i, i + 1)
        if ch == " " || ch == "\t" {
            if !in_ws { in_ws = true }
        } else {
            if in_ws {
                starts = starts + [i]
                in_ws = false
            }
        }
        i = i + 1
    }
    if len(starts) < 4 {
        return ProcRow { pid: 0, cpu: 0, rss_kb: 0, comm: "" }
    }
    let pid = to_int_safe(line.substring(starts[0], starts[1]).trim())
    let cpu = to_int_safe(line.substring(starts[1], starts[2]).trim())
    let rss = to_int_safe(line.substring(starts[2], starts[3]).trim())
    let comm = line.substring(starts[3], n).trim()
    return ProcRow { pid: pid, cpu: cpu, rss_kb: rss, comm: comm }
}

fn collect_high_cpu() -> list {
    let raw = exec("ps -axo pid=,pcpu=,rss=,comm= 2>/dev/null | awk '$1+0>100 && $2+0>" + to_string(CPU_TRIGGER) + "'")
    let lines = raw.split("\n")
    let mut out = []
    let mut i = 0
    while i < len(lines) {
        let l = lines[i].trim()
        if l == "" { i = i + 1; continue }
        let r = split_4col(l)
        if r.pid == 0 { i = i + 1; continue }
        if r.rss_kb < RSS_MB_FLOOR * 1024 { i = i + 1; continue }
        if is_hard_never(r.comm) { i = i + 1; continue }
        out = out + [r]
        i = i + 1
    }
    return out
}

fn confidence_for(cpu: int) -> str {
    // cpu 25..50 = 70/100, 50..80 = 85/100, 80+ = 95/100
    if cpu >= 80 { return "95/100" }
    if cpu >= 50 { return "85/100" }
    return "70/100"
}

fn comm_escape(s: str) -> str {
    return s.replace("\\", "\\\\").replace("\"", "\\\"")
}

fn rotate_ring() -> int {
    let raw = read_file(RING)
    let lines = raw.split("\n")
    let mut all = []
    let mut i = 0
    while i < len(lines) {
        if lines[i] != "" { all = all + [lines[i]] }
        i = i + 1
    }
    if len(all) <= MAX_RING { return len(all) }
    let start = len(all) - MAX_RING
    let mut out = ""
    let mut j = start
    while j < len(all) {
        out = out + all[j] + "\n"
        j = j + 1
    }
    write_file(RING, out)
    return MAX_RING
}

pub fn run_filter() -> int {
    let _ = exec("mkdir -p '" + forge_dir() + "'")
    let ts = ts_iso()
    let front = frontmost_app()
    if front != "Safari" {
        println("safari_active_throttle_signal: front=" + front + " (not Safari) — pass")
        return 0
    }

    let cands = collect_high_cpu()
    if len(cands) == 0 {
        println("safari_active_throttle_signal: front=Safari, no high-CPU candidates")
        return 0
    }

    let mut buf = ""
    let mut emitted = 0
    let mut k = 0
    while k < len(cands) {
        if emitted >= MAX_EMIT_PER_CYCLE { k = len(cands) }
        else {
            let r = cands[k]
            let line = "{\"ts\":\"" + ts + "\""
                     + ",\"kind\":\"safari_active\""
                     + ",\"pid\":" + to_string(r.pid)
                     + ",\"comm\":\"" + comm_escape(r.comm) + "\""
                     + ",\"cpu\":" + to_string(r.cpu)
                     + ",\"rss_kb\":" + to_string(r.rss_kb)
                     + ",\"action\":\"taskpolicy_bg\""
                     + ",\"confidence\":\"" + confidence_for(r.cpu) + "\""
                     + ",\"reason\":\"safari_frontmost+high_cpu\"}"
            buf = buf + line + "\n"
            emitted = emitted + 1
            k = k + 1
        }
    }
    append_file(RING, buf)
    let kept = rotate_ring()
    println("safari_active_throttle_signal: front=Safari emitted=" + to_string(emitted)
          + " ring_kept=" + to_string(kept))
    return emitted
}

pub fn self_test() -> void {
    if !is_hard_never("WindowServer") { panic("F64 self_test [WindowServer guard]") }
    if !is_hard_never("/Applications/Safari.app/Contents/MacOS/Safari") { panic("F64 self_test [Safari guard]") }
    if is_hard_never("node") { panic("F64 self_test [node should not be guarded]") }
    if confidence_for(95) != "95/100" { panic("F64 self_test [conf 95]") }
    if confidence_for(60) != "85/100" { panic("F64 self_test [conf 60]") }
    if confidence_for(30) != "70/100" { panic("F64 self_test [conf 30]") }
    let r = split_4col("12345  42 102400  node")
    if r.pid != 12345 { panic("F64 self_test [split pid]") }
    if r.cpu != 42 { panic("F64 self_test [split cpu]") }
    if r.comm != "node" { panic("F64 self_test [split comm]") }
    println("  ✅ F64 safari_active_throttle_signal self_test PASS")
}

// auto-invoke entry — raw 245 호환 (top-level main() 호출 0, runtime auto-fires).
fn main() -> void {
    let a = args()
    if len(a) >= 3 && a[2] == "self-test" {
        self_test()
        return
    }
    let _ = run_filter()
}
