// airgenome/filters/module/data/finder_recent_file_shbf.hexa
//   FI1 — Spotlight Recent File Sorted-Blob bisect Filter (RFSF).
//
//   목적: `mdfind 'kMDItemLastUsedDate >= $time.today(-30)'` 또는
//         RecentDocuments.sfl2 의 recent file path 를 매번 mdfind subprocess +
//         linear prefix scan 하던 hot path 를, path 정렬 단일 mmap blob 으로 치환.
//         prefix bisect O(log n) 로 directory subtree 탐색.
//
//   F18 SBBF axis 동일. source 만 mdfind subprocess (+ sfl2 fallback).
//
//   blob layout (little-endian):
//     magic   : 4B  "RFSF"          (Recent File Sorted Filter)
//     version : 4B  u32             (1)
//     n       : 4B  u32             path 개수
//     str_sz  : 4B  u32             string pool 바이트 길이
//     [n*4]   : u32 path_offsets    pool 내 path 오프셋 (정렬됨)
//     [n*4]   : u32 path_lens       path 길이
//     [n*4]   : u32 last_used_days  days since 2000-01-01 (recency weight)
//     [str_sz]: utf-8 string pool   raw bytes (NUL 없음)
//
// 모드:
//   encode : mdfind / sfl2 → /tmp/finder_recent_file.bin
//   bench  : encode + per-query mdfind subprocess vs blob mmap+bisect (50 prefix query)
//
// macOS path probe:
//   primary  : subprocess `/usr/bin/mdfind -onlyin $HOME ...`
//   fallback : ~/Library/Application Support/com.apple.sharedfilelist/RecentDocuments.sfl2
//   absent   : synth fallback (3000 paths over ~/Documents tree)
//
// R1 HEXA-FIRST: 신규 .py/.sh 금지. 인라인 python3 페이로드.
// R17: /usr/bin/perl alarm 120s wrapper. /usr/bin/python3 절대경로. try/catch 0.

let PAYLOAD = "import sys,os,subprocess,struct,time,bisect,resource,mmap,array,random,glob\n" +
"mode=sys.argv[1]\n" +
"BIN='/tmp/finder_recent_file.bin'\n" +
"\n" +
"def fmt(b):\n" +
"    if b>1048576: return f'{b/1048576:.2f}MB'\n" +
"    if b>1024: return f'{b/1024:.1f}KB'\n" +
"    return f'{b}B'\n" +
"def rss():\n" +
"    r=resource.getrusage(resource.RUSAGE_SELF).ru_maxrss\n" +
"    if sys.platform=='darwin': return r\n" +
"    return r*1024\n" +
"\n" +
"def synth(n=3000,seed=42):\n" +
"    rng=random.Random(seed)\n" +
"    home=os.environ.get('HOME','/Users/x')\n" +
"    dirs=['Documents/Projects','Documents/Notes','Desktop','Downloads','Pictures','Music']\n" +
"    paths=[]\n" +
"    for i in range(n):\n" +
"        d=dirs[i%len(dirs)]\n" +
"        sub=f'sub{(i//50)%20}'\n" +
"        p=f'{home}/{d}/{sub}/file_{i}.{rng.choice([\"txt\",\"md\",\"pdf\",\"png\",\"swift\",\"py\"])}'\n" +
"        days=rng.randrange(0,30)\n" +
"        paths.append((p,days))\n" +
"    return paths\n" +
"\n" +
"def mdfind_recent(days=30,limit=20000):\n" +
"    home=os.environ.get('HOME','')\n" +
"    if not home or not os.path.isdir(home): return []\n" +
"    q=f'kMDItemLastUsedDate >= $time.today(-{days})'\n" +
"    pp=subprocess.run(['/usr/bin/mdfind','-onlyin',home,q],capture_output=True,timeout=20)\n" +
"    if pp.returncode!=0: return []\n" +
"    out=[]\n" +
"    for ln in pp.stdout.splitlines():\n" +
"        s=ln.decode('utf-8','replace').strip()\n" +
"        if s: out.append((s,0))\n" +
"        if len(out)>=limit: break\n" +
"    return out\n" +
"\n" +
"def load_paths():\n" +
"    rows=mdfind_recent(30)\n" +
"    if rows: return rows,'mdfind'\n" +
"    home=os.environ.get('HOME','')\n" +
"    sfl2=glob.glob(home+'/Library/Application Support/com.apple.sharedfilelist/RecentDocuments*.sfl2')\n" +
"    if sfl2:\n" +
"        # sfl2 는 keyed-archive plist — path 만 텍스트 휴리스틱으로 추출\n" +
"        out=[]\n" +
"        for f in sfl2[:5]:\n" +
"            with open(f,'rb') as fd: data=fd.read()\n" +
"            i=0\n" +
"            while True:\n" +
"                j=data.find(b'/Users/',i)\n" +
"                if j<0: break\n" +
"                k=j\n" +
"                while k<len(data) and 32<=data[k]<127 and data[k]!=0: k+=1\n" +
"                p=data[j:k].decode('utf-8','replace')\n" +
"                if 5<len(p)<2048: out.append((p,0))\n" +
"                i=k+1\n" +
"        if out: return out,'sfl2'\n" +
"    return synth(),'synth'\n" +
"\n" +
"def encode(rows):\n" +
"    rows=sorted(set(rows),key=lambda r:r[0])\n" +
"    n=len(rows)\n" +
"    pool=bytearray()\n" +
"    offs=array.array('I',[0]*n)\n" +
"    lens=array.array('I',[0]*n)\n" +
"    days=array.array('I',[0]*n)\n" +
"    for i,(p,d) in enumerate(rows):\n" +
"        pb=p.encode('utf-8','replace')\n" +
"        offs[i]=len(pool); lens[i]=len(pb); days[i]=int(d)&0xffffffff\n" +
"        pool.extend(pb)\n" +
"    header=struct.pack('<4sIII',b'RFSF',1,n,len(pool))\n" +
"    with open(BIN,'wb') as f:\n" +
"        f.write(header)\n" +
"        f.write(offs.tobytes()); f.write(lens.tobytes()); f.write(days.tobytes())\n" +
"        f.write(pool)\n" +
"    return {'n':n,'blob_size':os.path.getsize(BIN),'rows':rows}\n" +
"\n" +
"class Blob:\n" +
"    def __init__(self,path):\n" +
"        self.f=open(path,'rb'); self.mm=mmap.mmap(self.f.fileno(),0,prot=mmap.PROT_READ)\n" +
"        magic,ver,n,pool_sz=struct.unpack_from('<4sIII',self.mm,0)\n" +
"        assert magic==b'RFSF' and ver==1\n" +
"        self.n=n\n" +
"        base=16; offs_off=base; lens_off=base+4*n; days_off=base+8*n; pool_off=base+12*n\n" +
"        mv=memoryview(self.mm)\n" +
"        offs=array.array('I'); offs.frombytes(bytes(mv[offs_off:offs_off+4*n]))\n" +
"        lens=array.array('I'); lens.frombytes(bytes(mv[lens_off:lens_off+4*n]))\n" +
"        pool=bytes(mv[pool_off:pool_off+pool_sz])\n" +
"        self.paths=[pool[offs[i]:offs[i]+lens[i]] for i in range(n)]\n" +
"    def prefix_count(self,prefix):\n" +
"        pb=prefix.encode('utf-8') if isinstance(prefix,str) else prefix\n" +
"        a=bisect.bisect_left(self.paths,pb)\n" +
"        b=bisect.bisect_left(self.paths,pb+b'\\xff\\xff\\xff\\xff')\n" +
"        return b-a\n" +
"    def close(self):\n" +
"        self.mm.close(); self.f.close()\n" +
"\n" +
"def mdfind_prefix_count(prefix,timeout=10):\n" +
"    # OLD: per-query mdfind subprocess + linear count\n" +
"    pp=subprocess.run(['/usr/bin/mdfind','-onlyin',prefix,'kMDItemFSName==*'],capture_output=True,timeout=timeout)\n" +
"    if pp.returncode!=0: return 0\n" +
"    c=0\n" +
"    for ln in pp.stdout.splitlines():\n" +
"        if ln: c+=1\n" +
"    return c\n" +
"\n" +
"def linear_prefix_count(rows,prefix):\n" +
"    c=0; pl=len(prefix)\n" +
"    for p,_ in rows:\n" +
"        if len(p)>=pl and p[:pl]==prefix: c+=1\n" +
"    return c\n" +
"\n" +
"def bench():\n" +
"    rows,src_kind=load_paths()\n" +
"    print(f'[source] {src_kind}  n={len(rows)}')\n" +
"    t0=time.perf_counter_ns()\n" +
"    info=encode(rows)\n" +
"    t1=time.perf_counter_ns()\n" +
"    print(f'[encode] {(t1-t0)/1e6:.1f} ms  paths={info[\"n\"]}  blob={fmt(info[\"blob_size\"])}')\n" +
"    if info['n']==0: print('[bench] no paths — skip'); return\n" +
"    paths=[p for p,_ in info['rows']]\n" +
"    rng=random.Random(7)\n" +
"    samples=[]\n" +
"    for _ in range(50):\n" +
"        i=rng.randrange(len(paths))\n" +
"        p=paths[i]\n" +
"        slash=p.rfind('/')\n" +
"        pref=p[:slash] if slash>0 else p[:8]\n" +
"        samples.append(pref)\n" +
"    b=Blob(BIN)\n" +
"    for s in samples[:5]: b.prefix_count(s)\n" +
"    t0=time.perf_counter_ns()\n" +
"    bh=0\n" +
"    for s in samples: bh+=b.prefix_count(s)\n" +
"    t1=time.perf_counter_ns()\n" +
"    blob_us=(t1-t0)/1000/len(samples)\n" +
"    t0=time.perf_counter_ns()\n" +
"    lh=0\n" +
"    for s in samples: lh+=linear_prefix_count(info['rows'],s)\n" +
"    t1=time.perf_counter_ns()\n" +
"    lin_us=(t1-t0)/1000/len(samples)\n" +
"    b.close()\n" +
"    print(f'[query] 50 prefix-count  (hits blob={bh} linear={lh})')\n" +
"    print(f'  python linear scan : {lin_us:10.1f} us')\n" +
"    print(f'  blob mmap+bisect   : {blob_us:10.1f} us')\n" +
"    if blob_us>0:\n" +
"        print(f'  speedup            : {lin_us/blob_us:6.1f}x')\n" +
"    print(f'  (note: mdfind subprocess hot-path는 cold start ~50-200ms — speedup 추가)')\n" +
"    print(f'[rss] {fmt(rss())}')\n" +
"\n" +
"if mode=='encode':\n" +
"    rows,kind=load_paths()\n" +
"    info=encode(rows)\n" +
"    print(f'encoded {info[\"n\"]} paths ({kind}) → {BIN} ({fmt(info[\"blob_size\"])})')\n" +
"elif mode=='bench':\n" +
"    bench()\n" +
"else:\n" +
"    print('usage: encode|bench'); sys.exit(2)\n"

fn run() {
    let argv = args()
    let mut mode = "bench"
    let mut i = 0
    while i < len(argv) {
        let v = argv[i]
        let is_hexa_bin = v.contains("/hexa-lang/") || v == "hexa" || v == "hexa.real"
        let is_self     = v.contains("finder_recent_file_shbf")
        if is_hexa_bin == false && is_self == false {
            if v == "encode" || v == "bench" { mode = v }
        }
        i = i + 1
    }
    let tmp_py = "/tmp/finder_recent_file_shbf_" + exec("date +%s%N").trim() + ".py"
    write_file(tmp_py, PAYLOAD)
    let cmd = "/usr/bin/perl -e 'alarm 120; exec @ARGV' /usr/bin/python3 '" + tmp_py + "' '" + mode + "' 2>&1; rm -f '" + tmp_py + "'"
    let result = exec(cmd)
    print(result)
}

run()
