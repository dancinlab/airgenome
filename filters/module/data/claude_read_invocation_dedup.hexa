// CC-BG4 — Read tool invocation dedup (CRID v1).
//   Read tool 호출 path frequency + dup detection (같은 file 반복 read = cache 후보).

let PAYLOAD = "import sys,os,struct,time,resource,array,json,glob,hashlib,random\n" +
"mode=sys.argv[1] if len(sys.argv)>1 else 'bench'\n" +
"BIN='/tmp/claude_read_dedup.bin'\n" +
"CLASSIFIER='CRID-v1-2026-05-01 jsonl-walk+Read-path-dedup+B11-locality'\n" +
"def fmt(b):\n" +
"    if b>1048576: return f'{b/1048576:.2f}MB'\n" +
"    if b>1024: return f'{b/1024:.1f}KB'\n" +
"    return f'{b}B'\n" +
"def rss():\n" +
"    r=resource.getrusage(resource.RUSAGE_SELF).ru_maxrss\n" +
"    return r if sys.platform=='darwin' else r*1024\n" +
"def hash64(s):\n" +
"    return int.from_bytes(hashlib.blake2b(s.encode('utf-8','replace'),digest_size=8).digest(),'little')\n" +
"\n" +
"def harvest():\n" +
"    root=os.path.expanduser('~/.claude-claude2/projects')\n" +
"    if not os.path.isdir(root): return [],'no_transcripts'\n" +
"    rows=[]\n" +
"    files=glob.glob(os.path.join(root,'*','*.jsonl'))\n" +
"    files.sort(key=os.path.getmtime,reverse=True)\n" +
"    files=files[:50]\n" +
"    for fp in files:\n" +
"        proj=os.path.basename(os.path.dirname(fp))\n" +
"        try:\n" +
"            with open(fp,'r',encoding='utf-8',errors='replace') as f:\n" +
"                for ln in f:\n" +
"                    if '\"name\":\"Read\"' not in ln: continue\n" +
"                    obj=json.loads(ln) if ln.strip().startswith('{') else None\n" +
"                    if not obj: continue\n" +
"                    msg=obj.get('message') or {}; cont=msg.get('content') if isinstance(msg,dict) else None\n" +
"                    if not isinstance(cont,list): continue\n" +
"                    for blk in cont:\n" +
"                        if not isinstance(blk,dict) or blk.get('type')!='tool_use' or blk.get('name')!='Read': continue\n" +
"                        inp=blk.get('input') or {}\n" +
"                        path=inp.get('file_path') or ''\n" +
"                        offset=int(inp.get('offset') or 0)\n" +
"                        limit=int(inp.get('limit') or 0)\n" +
"                        if not path: continue\n" +
"                        path_h=hash64(path)\n" +
"                        chunk_h=hash64(f'{path}:{offset}:{limit}')\n" +
"                        rows.append((proj,path_h,chunk_h,path))\n" +
"        except (json.JSONDecodeError,OSError,UnicodeDecodeError): pass\n" +
"    return rows,'real' if rows else 'empty'\n" +
"\n" +
"def synth(n=2000,seed=42):\n" +
"    rng=random.Random(seed)\n" +
"    paths=[f'/Users/ghost/core/p{i%6}/file{i%100}.txt' for i in range(n)]\n" +
"    out=[]\n" +
"    for _ in range(n):\n" +
"        p=rng.choice(paths)\n" +
"        ph=hash64(p); ch=hash64(f'{p}:0:0')\n" +
"        out.append(('synth',ph,ch,p))\n" +
"    return out\n" +
"\n" +
"def encode():\n" +
"    t0=time.perf_counter()\n" +
"    rows,reason=harvest()\n" +
"    if not rows: rows=synth(); reason='synth' if reason in ('empty','no_transcripts') else reason\n" +
"    n=len(rows)\n" +
"    path_seen=set(); chunk_seen=set(); n_path_dup=0; n_chunk_dup=0\n" +
"    path_cnt={}\n" +
"    for proj,ph,ch,p in rows:\n" +
"        if ph in path_seen: n_path_dup+=1\n" +
"        else: path_seen.add(ph)\n" +
"        if ch in chunk_seen: n_chunk_dup+=1\n" +
"        else: chunk_seen.add(ch)\n" +
"        path_cnt[p]=path_cnt.get(p,0)+1\n" +
"    top=sorted(path_cnt.items(),key=lambda kv:-kv[1])[:10]\n" +
"    n_uniq_path=len(path_seen); n_uniq_chunk=len(chunk_seen)\n" +
"    header=struct.pack('<4sIIIII',b'CRID',1,n,n_uniq_path,n_uniq_chunk,n_path_dup)\n" +
"    body=array.array('Q',[0]*(2*n))\n" +
"    for i,(_,ph,ch,_) in enumerate(rows):\n" +
"        body[2*i]=ph; body[2*i+1]=ch\n" +
"    with open(BIN,'wb') as f: f.write(header); f.write(body.tobytes())\n" +
"    elapsed=(time.perf_counter()-t0)*1000\n" +
"    return {'n':n,'n_uniq_path':n_uniq_path,'n_uniq_chunk':n_uniq_chunk,'n_path_dup':n_path_dup,'n_chunk_dup':n_chunk_dup,'reason':reason,'top':top,'blob':os.path.getsize(BIN),'encode_ms':elapsed}\n" +
"\n" +
"def bench():\n" +
"    info=encode()\n" +
"    pdup=100*info['n_path_dup']/max(info['n'],1); cdup=100*info['n_chunk_dup']/max(info['n'],1)\n" +
"    print(f'[encode] reads={info[\"n\"]} uniq_path={info[\"n_uniq_path\"]} uniq_chunk={info[\"n_uniq_chunk\"]} reason={info[\"reason\"]} blob={fmt(info[\"blob\"])} encode={info[\"encode_ms\"]:.1f}ms')\n" +
"    print(f'[dup] path_dup={pdup:.1f}% chunk_dup={cdup:.1f}% (cache 후보)')\n" +
"    for p,c in info['top'][:5]:\n" +
"        print(f'  {c:4d}× {p[:80]}')\n" +
"    print(f'[5tuple] {{\"site\":\"CC_BG4\",\"roi\":\"CRID_dedup\",\"baseline_ns\":0,\"post_ns\":{int(info[\"encode_ms\"]*1e6)},\"diff_test\":\"lossless\",\"reads\":{info[\"n\"]},\"path_dup_pct\":{pdup:.1f},\"chunk_dup_pct\":{cdup:.1f},\"reason\":\"{info[\"reason\"]}\",\"classifier\":\"{CLASSIFIER}\",\"ceiling\":420,\"new_block\":\"B11_invocation_locality\"}}')\n" +
"    print(f'[rss] {fmt(rss())} elapsed_ok')\n" +
"\n" +
"if mode=='encode':\n" +
"    info=encode(); print(f'encoded n={info[\"n\"]} → {BIN}')\n" +
"elif mode=='bench': bench()\n" +
"else: print('usage: encode|bench'); sys.exit(2)\n"

fn run() {
    let argv = args()
    let mut mode = "bench"
    let mut i = 0
    while i < len(argv) {
        let v = argv[i]
        let is_hexa = v.contains("/hexa-lang/") || v == "hexa" || v == "hexa.real"
        let is_self = v.contains("claude_read_invocation_dedup")
        if is_hexa == false && is_self == false {
            if v == "encode" || v == "bench" { mode = v }
        }
        i = i + 1
    }
    let tmp_py = "/tmp/claude_read_dedup_" + exec("date +%s%N").trim() + ".py"
    write_file(tmp_py, PAYLOAD)
    let cmd = "/usr/bin/perl -e 'alarm 60; exec @ARGV' /usr/bin/python3 '" + tmp_py + "' '" + mode + "' 2>&1; rm -f '" + tmp_py + "'"
    print(exec(cmd))
}

run()
