// airgenome/filters/module/data/music_library_shbf.hexa
//   SY2 — Music.app library SHBF (MSBF — Music Sqlite Blob Filter).
//
//   목적: ~/Music/Music/Music Library.musiclibrary/Library.musicdb (proprietary
//         binary plist) 또는 사용자 export iTunes XML 의 (track_id, title, artist,
//         album) 을 단일 mmap blob 으로. title prefix bisect O(log n).
//
//   blob layout (little-endian):
//     magic   : 4B  "MSBF"          (Music Sqlite Blob Filter)
//     version : 4B  u32             (1)
//     n       : 4B  u32             track 개수
//     str_sz  : 4B  u32             string pool 바이트 길이
//     [n*4]   : u32 t_off           title pool 시작 (정렬된 title 순)
//     [n*4]   : u32 t_len           title 길이
//     [n*4]   : u32 a_off           artist pool 시작
//     [n*4]   : u32 a_len           artist 길이
//     [n*4]   : u32 al_off          album pool 시작
//     [n*4]   : u32 al_len          album 길이
//     [n*8]   : u64 track_id        track persistent ID
//     [str_sz]: utf-8 string pool   raw bytes (NUL 없음)
//
//   query: title prefix bisect_left → range → top-K (track_id 안정 정렬).
//
// 모드:
//   encode <iTunes_Music_Library.xml | Library.musicdb> : → /tmp/music_library_msbf.bin
//   bench  <...> : encode + plistlib XML parse + linear scan vs MSBF mmap+bisect
//
// E4/F18 와 다른 점:
//   - source = plistlib (XML 또는 binary) — Library.musicdb 는 비공개 schema 라
//     XML export 우선 시도 → 실패 시 synthetic fallback.
//   - 3-string pool (title/artist/album).
//
// R1 HEXA-FIRST: 인라인 python3 페이로드 (.py 신규 없음). raw 9 hexa-only.
// R17: /usr/bin/perl alarm 120s wrapper. try/catch 0.

let PAYLOAD = "import sys,os,plistlib,struct,time,bisect,heapq,resource,mmap,array,random,tempfile\n" +
"mode=sys.argv[1]; src=sys.argv[2]\n" +
"BIN='/tmp/music_library_msbf.bin'\n" +
"\n" +
"def fmt(b):\n" +
"    if b>1048576: return f'{b/1048576:.2f}MB'\n" +
"    if b>1024: return f'{b/1024:.1f}KB'\n" +
"    return f'{b}B'\n" +
"def rss():\n" +
"    r=resource.getrusage(resource.RUSAGE_SELF).ru_maxrss\n" +
"    if sys.platform=='darwin': return r\n" +
"    return r*1024\n" +
"def to_int_safe(v):\n" +
"    if v is None: return 0\n" +
"    if isinstance(v,int): return v\n" +
"    if isinstance(v,float): return int(v)\n" +
"    if isinstance(v,str) and v.isdigit(): return int(v)\n" +
"    return 0\n" +
"\n" +
"SYNTH_MARK='__SYNTH__'\n" +
"GENRES=['Aphex Twin','Boards of Canada','Burial','Daft Punk','Four Tet','Jon Hopkins','Kiasmos','Nils Frahm','Olafur Arnalds','Tycho']\n" +
"ALBUMS=['Selected Ambient Works','Music Has the Right','Untrue','Discovery','New Energy','Singularity','Kiasmos','All Melody','Re:member','Awake']\n" +
"def synth_rows(n=3000):\n" +
"    rng=random.Random(42)\n" +
"    out=[]\n" +
"    for i in range(n):\n" +
"        ar=GENRES[i%len(GENRES)]\n" +
"        al=ALBUMS[i%len(ALBUMS)]\n" +
"        ti=f'Track {i:04d} - {ar[:6]}'\n" +
"        out.append((i+1,ti,ar,al))\n" +
"    return out\n" +
"\n" +
"def load_xml(src):\n" +
"    with open(src,'rb') as f:\n" +
"        d=plistlib.load(f)\n" +
"    tracks=d.get('Tracks',{}) if isinstance(d,dict) else {}\n" +
"    out=[]\n" +
"    for tid,info in tracks.items():\n" +
"        ti=(info.get('Name') or '').strip()\n" +
"        ar=(info.get('Artist') or '').strip()\n" +
"        al=(info.get('Album') or '').strip()\n" +
"        if ti:\n" +
"            out.append((to_int_safe(tid),ti,ar,al))\n" +
"    return out\n" +
"\n" +
"def encode_rows(rows):\n" +
"    rows=sorted(rows,key=lambda r:r[1])\n" +
"    n=len(rows)\n" +
"    pool=bytearray()\n" +
"    t_off=array.array('I',[0]*n); t_len=array.array('I',[0]*n)\n" +
"    a_off=array.array('I',[0]*n); a_len=array.array('I',[0]*n)\n" +
"    al_off=array.array('I',[0]*n); al_len=array.array('I',[0]*n)\n" +
"    tid=array.array('Q',[0]*n)\n" +
"    for i,(pk,ti,ar,al) in enumerate(rows):\n" +
"        tb=ti.encode('utf-8','replace'); ab=ar.encode('utf-8','replace'); lb=al.encode('utf-8','replace')\n" +
"        t_off[i]=len(pool); t_len[i]=len(tb); pool.extend(tb)\n" +
"        a_off[i]=len(pool); a_len[i]=len(ab); pool.extend(ab)\n" +
"        al_off[i]=len(pool); al_len[i]=len(lb); pool.extend(lb)\n" +
"        tid[i]=int(pk)&0xffffffffffffffff\n" +
"    header=struct.pack('<4sIII',b'MSBF',1,n,len(pool))\n" +
"    with open(BIN,'wb') as f:\n" +
"        f.write(header)\n" +
"        f.write(t_off.tobytes()); f.write(t_len.tobytes())\n" +
"        f.write(a_off.tobytes()); f.write(a_len.tobytes())\n" +
"        f.write(al_off.tobytes()); f.write(al_len.tobytes())\n" +
"        f.write(tid.tobytes()); f.write(pool)\n" +
"    return n,os.path.getsize(BIN)\n" +
"\n" +
"def encode(src):\n" +
"    t0=time.perf_counter()\n" +
"    synth=True; rows=[]\n" +
"    if src!=SYNTH_MARK and os.path.exists(src) and src.endswith('.xml'):\n" +
"        rows=load_xml(src); synth=(len(rows)==0)\n" +
"    if synth:\n" +
"        rows=synth_rows(3000)\n" +
"    n,bsz=encode_rows(rows)\n" +
"    t1=time.perf_counter()\n" +
"    return {'encode_s':t1-t0,'n':n,'blob_size':bsz,'synth':synth,'rows':rows}\n" +
"\n" +
"class Blob:\n" +
"    def __init__(self,path):\n" +
"        self.f=open(path,'rb')\n" +
"        self.mm=mmap.mmap(self.f.fileno(),0,prot=mmap.PROT_READ)\n" +
"        magic,ver,n,pool_sz=struct.unpack_from('<4sIII',self.mm,0)\n" +
"        assert magic==b'MSBF' and ver==1\n" +
"        self.n=n; self.pool_sz=pool_sz\n" +
"        base=16\n" +
"        t_off_off =base\n" +
"        t_len_off =base+4*n\n" +
"        a_off_off =base+8*n\n" +
"        a_len_off =base+12*n\n" +
"        al_off_off=base+16*n\n" +
"        al_len_off=base+20*n\n" +
"        tid_off   =base+24*n\n" +
"        self.pool_off=base+24*n+8*n\n" +
"        self.mv=memoryview(self.mm)\n" +
"        def U(off): a=array.array('I'); a.frombytes(bytes(self.mv[off:off+4*n])); return a\n" +
"        def Q(off): a=array.array('Q'); a.frombytes(bytes(self.mv[off:off+8*n])); return a\n" +
"        t_off=U(t_off_off); t_len=U(t_len_off)\n" +
"        a_off=U(a_off_off); a_len=U(a_len_off)\n" +
"        al_off=U(al_off_off); al_len=U(al_len_off)\n" +
"        self.tid=Q(tid_off)\n" +
"        pool=bytes(self.mv[self.pool_off:self.pool_off+pool_sz])\n" +
"        self.titles=[pool[t_off[i]:t_off[i]+t_len[i]] for i in range(n)]\n" +
"        self.artists=[pool[a_off[i]:a_off[i]+a_len[i]] for i in range(n)]\n" +
"        self.albums=[pool[al_off[i]:al_off[i]+al_len[i]] for i in range(n)]\n" +
"    def prefix_topk(self,prefix,k=10):\n" +
"        pb=prefix.encode('utf-8') if isinstance(prefix,str) else prefix\n" +
"        s=bisect.bisect_left(self.titles,pb)\n" +
"        e=bisect.bisect_left(self.titles,pb+b'\\xff\\xff\\xff\\xff')\n" +
"        if e==s: return []\n" +
"        idxs=list(range(s,min(e,s+k)))\n" +
"        return [(self.titles[i].decode('utf-8','replace'),self.artists[i].decode('utf-8','replace'),int(self.tid[i])) for i in idxs]\n" +
"    def close(self):\n" +
"        self.mv.release(); self.mm.close(); self.f.close()\n" +
"\n" +
"def bench(src):\n" +
"    info=encode(src)\n" +
"    tag=' (synth fallback)' if info['synth'] else ''\n" +
"    print(f'[encode] {info[\"encode_s\"]*1000:.1f} ms  tracks={info[\"n\"]}  blob={fmt(info[\"blob_size\"])}{tag}')\n" +
"    if info['n']==0:\n" +
"        print('[bench] empty — skip'); return\n" +
"    rows=info['rows']\n" +
"    b=Blob(BIN)\n" +
"    rng=random.Random(42)\n" +
"    samples=[]\n" +
"    for _ in range(100):\n" +
"        i=rng.randrange(b.n)\n" +
"        u=b.titles[i].decode('utf-8','replace')\n" +
"        plen=rng.choice([3,4,5,6])\n" +
"        samples.append(u[:plen] if len(u)>=plen else u)\n" +
"    for p in samples[:5]: b.prefix_topk(p,10)\n" +
"    t0=time.perf_counter()\n" +
"    blob_hits=0\n" +
"    for p in samples:\n" +
"        blob_hits+=len(b.prefix_topk(p,10))\n" +
"    t1=time.perf_counter()\n" +
"    blob_us=(t1-t0)*1e6/len(samples)\n" +
"    rss_blob=rss()\n" +
"    b.close()\n" +
"    rows_sorted=sorted(rows,key=lambda r:r[1])\n" +
"    t0=time.perf_counter()\n" +
"    lin_hits=0\n" +
"    for p in samples:\n" +
"        for (pk,ti,ar,al) in rows_sorted:\n" +
"            if ti.startswith(p): lin_hits+=1\n" +
"    t1=time.perf_counter()\n" +
"    lin_us=(t1-t0)*1e6/len(samples)\n" +
"    print(f'[query] 100 title-prefix-topK-10  (blob={blob_hits} linear={lin_hits})')\n" +
"    print(f'  linear scan          : {lin_us:10.1f} us')\n" +
"    print(f'  blob mmap + bisect   : {blob_us:10.1f} us')\n" +
"    if blob_us>0: print(f'  speedup: {lin_us/blob_us:6.1f}x')\n" +
"    print(f'[rss] blob loaded: {fmt(rss_blob)}')\n" +
"\n" +
"if mode=='encode':\n" +
"    info=encode(src)\n" +
"    print(f'encoded {info[\"n\"]} tracks in {info[\"encode_s\"]*1000:.1f} ms → {BIN} ({fmt(info[\"blob_size\"])})' + (' synth' if info['synth'] else ''))\n" +
"elif mode=='bench':\n" +
"    bench(src)\n" +
"else:\n" +
"    print('usage: encode|bench <iTunes Music Library.xml>'); sys.exit(2)\n"

fn run() {
    let argv = args()
    let mut mode = "bench"
    let mut target = ""
    let mut i = 0
    while i < len(argv) {
        let v = argv[i]
        let is_hexa_bin = v.contains("/hexa-lang/") || v == "hexa" || v == "hexa.real"
        let is_self     = v.contains("music_library_shbf")
        if is_hexa_bin == false && is_self == false {
            if v == "encode" || v == "bench" { mode = v }
            else if v.contains(".xml") || v.contains(".musicdb") { target = v }
        }
        i = i + 1
    }
    if len(target) == 0 {
        target = env("HOME") + "/Music/iTunes/iTunes Music Library.xml"
        println("(default target: " + target + ")")
    }
    if file_exists(target) == false {
        println("(target not found / no XML export — using synthetic fallback)")
        target = "__SYNTH__"
    }
    let tmp_py = "/tmp/music_library_shbf_" + exec("date +%s%N").trim() + ".py"
    write_file(tmp_py, PAYLOAD)
    let cmd = "/usr/bin/perl -e 'alarm 120; exec @ARGV' /usr/bin/python3 '" + tmp_py + "' '" + mode + "' '" + target + "' 2>&1; rm -f '" + tmp_py + "'"
    let result = exec(cmd)
    print(result)
}

run()
