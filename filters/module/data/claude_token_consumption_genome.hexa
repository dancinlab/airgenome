// CC-BG5 — Token consumption genome (CTCG v1).
//   message.usage 의 input/output/cache_creation/cache_read tokens 시계열 + per-project + per-model genome.

let PAYLOAD = "import sys,os,struct,time,resource,array,json,glob,random\n" +
"mode=sys.argv[1] if len(sys.argv)>1 else 'bench'\n" +
"BIN='/tmp/claude_token_genome.bin'\n" +
"CLASSIFIER='CTCG-v1-2026-05-01 jsonl-walk+usage+per-project'\n" +
"def fmt(b):\n" +
"    if b>1048576: return f'{b/1048576:.2f}MB'\n" +
"    if b>1024: return f'{b/1024:.1f}KB'\n" +
"    return f'{b}B'\n" +
"def fmt_t(t):\n" +
"    if t>1e9: return f'{t/1e9:.2f}B'\n" +
"    if t>1e6: return f'{t/1e6:.1f}M'\n" +
"    if t>1e3: return f'{t/1e3:.1f}K'\n" +
"    return f'{t:.0f}'\n" +
"def rss():\n" +
"    r=resource.getrusage(resource.RUSAGE_SELF).ru_maxrss\n" +
"    return r if sys.platform=='darwin' else r*1024\n" +
"\n" +
"def harvest():\n" +
"    root=os.path.expanduser('~/.claude-claude2/projects')\n" +
"    if not os.path.isdir(root): return [],'no_transcripts'\n" +
"    rows=[]\n" +
"    files=glob.glob(os.path.join(root,'*','*.jsonl'))\n" +
"    files.sort(key=os.path.getmtime,reverse=True)\n" +
"    files=files[:50]\n" +
"    for fp in files:\n" +
"        proj=os.path.basename(os.path.dirname(fp))\n" +
"        try:\n" +
"            with open(fp,'r',encoding='utf-8',errors='replace') as f:\n" +
"                for ln in f:\n" +
"                    if '\"usage\"' not in ln: continue\n" +
"                    obj=json.loads(ln) if ln.strip().startswith('{') else None\n" +
"                    if not obj: continue\n" +
"                    msg=obj.get('message') or {}\n" +
"                    if not isinstance(msg,dict): continue\n" +
"                    u=msg.get('usage')\n" +
"                    if not isinstance(u,dict): continue\n" +
"                    model=msg.get('model') or 'unknown'\n" +
"                    rows.append((proj,model,\n" +
"                                 int(u.get('input_tokens') or 0),\n" +
"                                 int(u.get('output_tokens') or 0),\n" +
"                                 int(u.get('cache_creation_input_tokens') or 0),\n" +
"                                 int(u.get('cache_read_input_tokens') or 0)))\n" +
"        except (json.JSONDecodeError,OSError,UnicodeDecodeError): pass\n" +
"    return rows,'real' if rows else 'empty'\n" +
"\n" +
"def synth(n=1000,seed=42):\n" +
"    rng=random.Random(seed)\n" +
"    projs=['airgenome','hive','anima','nexus']; models=['claude-opus-4-7','claude-sonnet-4-6','claude-haiku-4-5']\n" +
"    return [(rng.choice(projs),rng.choice(models),rng.randrange(500,8000),rng.randrange(50,2000),rng.randrange(0,3000),rng.randrange(0,40000)) for _ in range(n)]\n" +
"\n" +
"def encode():\n" +
"    t0=time.perf_counter()\n" +
"    rows,reason=harvest()\n" +
"    if not rows: rows=synth(); reason='synth' if reason in ('empty','no_transcripts') else reason\n" +
"    n=len(rows)\n" +
"    proj_t={}; model_t={}\n" +
"    total_in=total_out=total_cc=total_cr=0\n" +
"    for p,m,ti,to,tc,tr in rows:\n" +
"        proj_t[p]=proj_t.get(p,(0,0,0,0))\n" +
"        a,b,c,d=proj_t[p]; proj_t[p]=(a+ti,b+to,c+tc,d+tr)\n" +
"        model_t[m]=model_t.get(m,0)+ti+to+tc+tr\n" +
"        total_in+=ti; total_out+=to; total_cc+=tc; total_cr+=tr\n" +
"    proj_top=sorted(proj_t.items(),key=lambda kv:-(kv[1][0]+kv[1][1]+kv[1][2]+kv[1][3]))[:10]\n" +
"    model_top=sorted(model_t.items(),key=lambda kv:-kv[1])[:10]\n" +
"    cache_hit_pct=100*total_cr/max(total_in+total_cr,1)\n" +
"    header=struct.pack('<4sIIQQQQ',b'CTCG',1,n,total_in,total_out,total_cc,total_cr)\n" +
"    body=array.array('Q',[0]*(4*n))\n" +
"    for i,(p,m,ti,to,tc,tr) in enumerate(rows):\n" +
"        body[4*i]=ti&0xffffffffffffffff; body[4*i+1]=to&0xffffffffffffffff\n" +
"        body[4*i+2]=tc&0xffffffffffffffff; body[4*i+3]=tr&0xffffffffffffffff\n" +
"    with open(BIN,'wb') as f: f.write(header); f.write(body.tobytes())\n" +
"    elapsed=(time.perf_counter()-t0)*1000\n" +
"    return {'n':n,'total_in':total_in,'total_out':total_out,'total_cc':total_cc,'total_cr':total_cr,'cache_hit_pct':cache_hit_pct,'proj_top':proj_top,'model_top':model_top,'reason':reason,'blob':os.path.getsize(BIN),'encode_ms':elapsed}\n" +
"\n" +
"def bench():\n" +
"    info=encode()\n" +
"    print(f'[encode] turns={info[\"n\"]} reason={info[\"reason\"]} blob={fmt(info[\"blob\"])} encode={info[\"encode_ms\"]:.1f}ms')\n" +
"    print(f'[total]  in={fmt_t(info[\"total_in\"])}  out={fmt_t(info[\"total_out\"])}  cache_create={fmt_t(info[\"total_cc\"])}  cache_read={fmt_t(info[\"total_cr\"])}')\n" +
"    print(f'[cache_hit] {info[\"cache_hit_pct\"]:.1f}%  (cache_read / (input+cache_read))')\n" +
"    print('[proj top] ' + ' / '.join(f'{p}={fmt_t(sum(t))}' for p,t in info['proj_top'][:5]))\n" +
"    print('[model top] ' + ' / '.join(f'{m}={fmt_t(t)}' for m,t in info['model_top'][:5]))\n" +
"    print(f'[5tuple] {{\"site\":\"CC_BG5\",\"roi\":\"CTCG_genome\",\"baseline_ns\":0,\"post_ns\":{int(info[\"encode_ms\"]*1e6)},\"diff_test\":\"lossless\",\"turns\":{info[\"n\"]},\"total_in\":{info[\"total_in\"]},\"total_out\":{info[\"total_out\"]},\"cache_hit_pct\":{info[\"cache_hit_pct\"]:.1f},\"reason\":\"{info[\"reason\"]}\",\"classifier\":\"{CLASSIFIER}\"}}')\n" +
"    print(f'[rss] {fmt(rss())} elapsed_ok')\n" +
"\n" +
"if mode=='encode':\n" +
"    info=encode(); print(f'encoded n={info[\"n\"]} total_in={info[\"total_in\"]} → {BIN}')\n" +
"elif mode=='bench': bench()\n" +
"else: print('usage: encode|bench'); sys.exit(2)\n"

fn run() {
    let argv = args()
    let mut mode = "bench"
    let mut i = 0
    while i < len(argv) {
        let v = argv[i]
        let is_hexa = v.contains("/hexa-lang/") || v == "hexa" || v == "hexa.real"
        let is_self = v.contains("claude_token_consumption_genome")
        if is_hexa == false && is_self == false {
            if v == "encode" || v == "bench" { mode = v }
        }
        i = i + 1
    }
    let tmp_py = "/tmp/claude_token_genome_" + exec("date +%s%N").trim() + ".py"
    write_file(tmp_py, PAYLOAD)
    let cmd = "/usr/bin/perl -e 'alarm 60; exec @ARGV' /usr/bin/python3 '" + tmp_py + "' '" + mode + "' 2>&1; rm -f '" + tmp_py + "'"
    print(exec(cmd))
}

run()
