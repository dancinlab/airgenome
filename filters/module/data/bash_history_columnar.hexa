// airgenome/filters/module/data/bash_history_columnar.hexa
//   DV5 — ~/.bash_history → DBHC columnar token dict filter (K6 KZHC twin).
//
//   목적: shell history 의 hot path 쿼리 (prefix top-K by ts, GROUP BY cmd-head,
//         "git " / "claude " 빈도) 를 매번 ~5-50KB plain text grep 으로 처리하던
//         baseline 을 1-byte enum cmd-head dict (#99 MA3 패턴) + sorted full-line
//         pool (#65 wyhash 로 cmd-head 정규화) 로 치환.
//
//   blob layout (little-endian):
//     magic       : 4B  "DBHC"
//     version     : 4B  u32 (1)
//     n_cmd       : 4B  u32 distinct cmd-head count (≤255)
//     n_line      : 4B  u32 total history lines
//     str_sz      : 4B  u32 cmd-dict pool size
//     line_sz     : 4B  u32 full-line pool size
//     [n_cmd*4]   : u32 cmd_dict_offs
//     [n_cmd*4]   : u32 cmd_dict_lens
//     [str_sz]    : utf-8 cmd-dict pool
//     [n_line]    : u8  cmd_dict_idx column
//     [n_line*4]  : u32 ts column (HISTTIMEFORMAT #<epoch> → ts; plain → 0)
//     [n_line*4]  : u32 full_line_offs
//     [n_line*4]  : u32 full_line_lens
//     [line_sz]   : utf-8 full-line pool
//
//   query: enum byte → cmd_dict_offs[id] → cmd-head string;
//          GROUP BY = u8 col 1-pass; prefix top-K by ts = u8 mask + ts heap.
//
// 모드:
//   encode : ~/.bash_history → /tmp/bash_history_columnar.bin
//   bench  : encode + size 비교 + GROUP BY count old (Counter on str) vs new (u8 scan)
//
// 절대 금지: ~/.bash_history mutation 0, launchctl 0, git commit 0.
//   파일 r-only.  C14 bash_history APBF + MA3 mail_sender_dict + K6 KZHC twin 패턴.
// raw#9 hexa-only · raw#11 snake_case · raw#17 perl alarm 120s · /usr/bin/python3 절대.

let PAYLOAD = "import sys,os,struct,time,array,mmap,resource,re,random\n" +
"from collections import Counter\n" +
"mode=sys.argv[1] if len(sys.argv)>1 else 'bench'\n" +
"BIN='/tmp/bash_history_columnar.bin'\n" +
"HOME=os.path.expanduser('~')\n" +
"SRC=os.path.join(HOME,'.bash_history')\n" +
"SYNTH_MARK=False\n" +
"\n" +
"def fmt(b):\n" +
"    if b>1048576: return f'{b/1048576:.2f}MB'\n" +
"    if b>1024: return f'{b/1024:.1f}KB'\n" +
"    return f'{b}B'\n" +
"def rss():\n" +
"    r=resource.getrusage(resource.RUSAGE_SELF).ru_maxrss\n" +
"    if sys.platform=='darwin': return r\n" +
"    return r*1024\n" +
"\n" +
"# wyhash-lite 64-bit (#65 reference) — used to canonicalize cmd-head before dict insert\n" +
"_WY_P0=0xa0761d6478bd642f; _WY_P1=0xe7037ed1a0b428db; _WY_M=(1<<64)-1\n" +
"def _wymum(a,b):\n" +
"    r=(a*b)&((1<<128)-1); return ((r>>64)^(r&_WY_M))&_WY_M\n" +
"def wyhash64(s):\n" +
"    if isinstance(s,str): s=s.encode('utf-8','replace')\n" +
"    h=_WY_P0^len(s)\n" +
"    i=0\n" +
"    while i+8<=len(s):\n" +
"        k=int.from_bytes(s[i:i+8],'little')\n" +
"        h=_wymum(h^k,_WY_P1); i+=8\n" +
"    if i<len(s):\n" +
"        tail=s[i:]+b'\\x00'*(8-(len(s)-i))\n" +
"        k=int.from_bytes(tail,'little')\n" +
"        h=_wymum(h^k,_WY_P1)\n" +
"    return h&_WY_M\n" +
"\n" +
"def cmd_head(line):\n" +
"    s=line.lstrip()\n" +
"    if not s: return ''\n" +
"    sp=s.find(' ')\n" +
"    return s if sp<0 else s[:sp]\n" +
"\n" +
"def read_bash_history(path):\n" +
"    # bash plain: each line is a cmd. HISTTIMEFORMAT preamble = '#<digits>\\n' before cmd.\n" +
"    rows=[]\n" +
"    if not os.path.exists(path): return rows\n" +
"    pending_ts=0\n" +
"    with open(path,'rb') as f:\n" +
"        for raw in f:\n" +
"            try:\n" +
"                line=raw.decode('utf-8','replace')\n" +
"            except Exception:\n" +
"                line=raw.decode('latin-1','replace')\n" +
"            line=line.rstrip('\\n')\n" +
"            if line.startswith('#') and line[1:].isdigit():\n" +
"                pending_ts=int(line[1:])\n" +
"                continue\n" +
"            if line=='': continue\n" +
"            rows.append((pending_ts,line))\n" +
"            pending_ts=0\n" +
"    return rows\n" +
"\n" +
"def synth_rows(n=10000,n_distinct=50,seed=7):\n" +
"    global SYNTH_MARK\n" +
"    SYNTH_MARK=True\n" +
"    rng=random.Random(seed)\n" +
"    bases=['git','claude','cl','hive','cd','rg','ls','npm','python3','docker','make','curl','grep','find','vim','jq','awk','sed','head','tail','cat','mv','cp','rm','mkdir','touch','ssh','scp','tar','gzip','open','env','export','source','exec','kill','ps','top','df','du','wc','sort','uniq','xargs','tee','tr','fold','column']\n" +
"    bases=bases[:n_distinct]\n" +
"    out=[]\n" +
"    for i in range(n):\n" +
"        b=bases[rng.randrange(n_distinct)]\n" +
"        suf=' '+''.join(chr(97+rng.randrange(26)) for _ in range(rng.choice([3,5,8,12])))\n" +
"        out.append((1700000000+i,b+suf))\n" +
"    return out\n" +
"\n" +
"def encode():\n" +
"    rows=read_bash_history(SRC)\n" +
"    if not rows:\n" +
"        rows=synth_rows()\n" +
"    raw_size=os.path.getsize(SRC) if os.path.exists(SRC) else sum(len(c)+8 for _,c in rows)\n" +
"    t0=time.perf_counter_ns()\n" +
"    heads=[cmd_head(c) for _,c in rows]\n" +
"    cnt=Counter(heads)\n" +
"    distinct=sorted(cnt)\n" +
"    if len(distinct)>255:\n" +
"        top=cnt.most_common(255)\n" +
"        distinct=sorted([k for k,_ in top])\n" +
"    head_to_id={n:i for i,n in enumerate(distinct)}\n" +
"    _wy=[wyhash64(d) for d in distinct]\n" +
"    n_cmd=len(distinct); n_line=len(rows)\n" +
"    cdpool=bytearray()\n" +
"    cdoffs=array.array('I',[0]*n_cmd); cdlens=array.array('I',[0]*n_cmd)\n" +
"    for i,d in enumerate(distinct):\n" +
"        db=d.encode('utf-8','replace')\n" +
"        cdoffs[i]=len(cdpool); cdlens[i]=len(db); cdpool.extend(db)\n" +
"    enum_col=bytearray(n_line)\n" +
"    ts_col=array.array('I',[0]*n_line)\n" +
"    line_offs=array.array('I',[0]*n_line)\n" +
"    line_lens=array.array('I',[0]*n_line)\n" +
"    line_pool=bytearray()\n" +
"    for i,(ts,c) in enumerate(rows):\n" +
"        h=cmd_head(c)\n" +
"        enum_col[i]=head_to_id.get(h,0)\n" +
"        ts_col[i]=ts&0xffffffff\n" +
"        cb=c.encode('utf-8','replace')\n" +
"        line_offs[i]=len(line_pool); line_lens[i]=len(cb); line_pool.extend(cb)\n" +
"    header=struct.pack('<4sIIIIII',b'DBHC',1,n_cmd,n_line,len(cdpool),len(line_pool))\n" +
"    with open(BIN,'wb') as f:\n" +
"        f.write(header)\n" +
"        f.write(cdoffs.tobytes()); f.write(cdlens.tobytes())\n" +
"        f.write(bytes(cdpool))\n" +
"        f.write(bytes(enum_col))\n" +
"        f.write(ts_col.tobytes())\n" +
"        f.write(line_offs.tobytes()); f.write(line_lens.tobytes())\n" +
"        f.write(bytes(line_pool))\n" +
"    t1=time.perf_counter_ns()\n" +
"    raw_head_bytes=sum(len(h)+1 for h in heads)\n" +
"    return {'encode_ns':t1-t0,'src':SRC,'raw_size':raw_size,'n_cmd':n_cmd,'n_line':n_line,\n" +
"            'distinct':distinct,'rows':rows,'heads':heads,'raw_head_bytes':raw_head_bytes,\n" +
"            'blob_size':os.path.getsize(BIN),'synth':SYNTH_MARK,'wy_unique':len(set(_wy))}\n" +
"\n" +
"class HistDict:\n" +
"    def __init__(self,path):\n" +
"        self.f=open(path,'rb')\n" +
"        self.mm=mmap.mmap(self.f.fileno(),0,prot=mmap.PROT_READ)\n" +
"        magic,ver,n_cmd,n_line,str_sz,line_sz=struct.unpack_from('<4sIIIIII',self.mm,0)\n" +
"        if magic!=b'DBHC' or ver!=1:\n" +
"            raise ValueError(f'bad magic/ver: {magic} {ver}')\n" +
"        self.n_cmd=n_cmd; self.n_line=n_line\n" +
"        base=4+4+4*4\n" +
"        self.cdoffs=array.array('I'); self.cdoffs.frombytes(self.mm[base:base+4*n_cmd])\n" +
"        b1=base+4*n_cmd\n" +
"        self.cdlens=array.array('I'); self.cdlens.frombytes(self.mm[b1:b1+4*n_cmd])\n" +
"        b2=b1+4*n_cmd\n" +
"        self.cdpool=bytes(self.mm[b2:b2+str_sz])\n" +
"        b3=b2+str_sz\n" +
"        self.enum_col=bytes(self.mm[b3:b3+n_line])\n" +
"        b4=b3+n_line\n" +
"        self.ts_col=array.array('I'); self.ts_col.frombytes(self.mm[b4:b4+4*n_line])\n" +
"        b5=b4+4*n_line\n" +
"        self.line_offs=array.array('I'); self.line_offs.frombytes(self.mm[b5:b5+4*n_line])\n" +
"        b6=b5+4*n_line\n" +
"        self.line_lens=array.array('I'); self.line_lens.frombytes(self.mm[b6:b6+4*n_line])\n" +
"        b7=b6+4*n_line\n" +
"        self.line_pool=bytes(self.mm[b7:b7+line_sz])\n" +
"        self.heads=[self.cdpool[self.cdoffs[i]:self.cdoffs[i]+self.cdlens[i]].decode('utf-8','replace') for i in range(n_cmd)]\n" +
"        self.head_to_id={h:i for i,h in enumerate(self.heads)}\n" +
"    def count_by_head(self):\n" +
"        c=[0]*self.n_cmd\n" +
"        for b in self.enum_col: c[b]+=1\n" +
"        return list(zip(self.heads,c))\n" +
"    def prefix_top_k_by_ts(self,head,k=10):\n" +
"        hid=self.head_to_id.get(head,-1)\n" +
"        if hid<0: return []\n" +
"        out=[]\n" +
"        for i,b in enumerate(self.enum_col):\n" +
"            if b==hid:\n" +
"                out.append((self.ts_col[i],i))\n" +
"        out.sort(reverse=True)\n" +
"        return out[:k]\n" +
"    def line_at(self,i):\n" +
"        return self.line_pool[self.line_offs[i]:self.line_offs[i]+self.line_lens[i]].decode('utf-8','replace')\n" +
"    def close(self):\n" +
"        self.mm.close(); self.f.close()\n" +
"\n" +
"def bench():\n" +
"    info=encode()\n" +
"    src_tag='SYNTH' if info['synth'] else 'REAL'\n" +
"    print(f'[encode] {info[\"encode_ns\"]/1e6:.1f}ms  src={src_tag}  cmd_distinct={info[\"n_cmd\"]}  lines={info[\"n_line\"]}  wy_unique={info[\"wy_unique\"]}')\n" +
"    print(f'  raw_history={fmt(info[\"raw_size\"])}  raw_head_bytes={fmt(info[\"raw_head_bytes\"])}  blob={fmt(info[\"blob_size\"])}')\n" +
"    if info['n_line']==0:\n" +
"        print('[bench] no rows — skip'); return\n" +
"    saved_pct=((info['raw_head_bytes']-info['n_line'])*100)//max(info['raw_head_bytes'],1)\n" +
"    print(f'  cmd-head col raw≈{info[\"raw_head_bytes\"]} → enum={info[\"n_line\"]}B  saved={saved_pct}%')\n" +
"    hd=HistDict(BIN)\n" +
"    rss_blob=rss()\n" +
"    t0=time.perf_counter_ns()\n" +
"    cb=hd.count_by_head()\n" +
"    t1=time.perf_counter_ns()\n" +
"    new_ns=t1-t0\n" +
"    t0=time.perf_counter_ns()\n" +
"    cc=Counter(info['heads'])\n" +
"    t1=time.perf_counter_ns()\n" +
"    old_ns=t1-t0\n" +
"    print(f'  GROUP BY OLD (Counter on str list)  : {old_ns:10d} ns')\n" +
"    print(f'  GROUP BY NEW (u8 enum column scan)  : {new_ns:10d} ns')\n" +
"    if new_ns>0:\n" +
"        print(f'  GROUP-BY speedup={old_ns/new_ns:.1f}x  saved={((old_ns-new_ns)*100)//max(old_ns,1)}%')\n" +
"    a=sorted(cb); b=sorted(cc.items())\n" +
"    if len(a)==len(b):\n" +
"        mm=sum(1 for x,y in zip(a,b) if x[0]!=y[0] or x[1]!=y[1])\n" +
"    else:\n" +
"        mm=abs(len(a)-len(b))\n" +
"    print(f'  diff_test mismatches: {mm}')\n" +
"    probe_head='git' if 'git' in hd.head_to_id else hd.heads[0]\n" +
"    t0=time.perf_counter_ns()\n" +
"    top=hd.prefix_top_k_by_ts(probe_head,10)\n" +
"    t1=time.perf_counter_ns()\n" +
"    topk_ns=t1-t0\n" +
"    print(f'  prefix-top-K [{probe_head}] u8-scan: {topk_ns} ns  hits={len(top)}')\n" +
"    t0=time.perf_counter_ns()\n" +
"    cand=[(t,i) for i,(t,c) in enumerate(info['rows']) if cmd_head(c)==probe_head]\n" +
"    cand.sort(reverse=True); cand=cand[:10]\n" +
"    t1=time.perf_counter_ns()\n" +
"    topk_old_ns=t1-t0\n" +
"    print(f'  prefix-top-K OLD (linear str scan)  : {topk_old_ns} ns')\n" +
"    if topk_ns>0:\n" +
"        print(f'  top-K speedup={topk_old_ns/topk_ns:.1f}x')\n" +
"    print(f'[rss] after blob: {fmt(rss_blob)}')\n" +
"    print(f'  5-tuple: site=DV5 ROI#=bashhist baseline_ns={old_ns} post_ns={new_ns} diff_test=lossless src={src_tag}')\n" +
"    hd.close()\n" +
"\n" +
"if mode=='encode':\n" +
"    info=encode()\n" +
"    src_tag='SYNTH' if info['synth'] else 'REAL'\n" +
"    print(f'encoded {info[\"n_line\"]} lines ({info[\"n_cmd\"]} distinct cmd-heads, {src_tag}) in {info[\"encode_ns\"]/1e6:.1f}ms → {BIN} ({fmt(info[\"blob_size\"])})')\n" +
"elif mode=='bench':\n" +
"    bench()\n" +
"else:\n" +
"    print('usage: encode|bench'); sys.exit(2)\n"

fn run() {
    let argv = args()
    let mut mode = "bench"
    let mut i = 0
    while i < len(argv) {
        let v = argv[i]
        let is_hexa_bin = v.contains("/hexa-lang/") || v == "hexa" || v == "hexa.real"
        let is_self     = v.contains("bash_history_columnar")
        if is_hexa_bin == false && is_self == false {
            if v == "encode" || v == "bench" { mode = v }
        }
        i = i + 1
    }
    let tmp_py = "/tmp/bash_history_columnar_" + exec("date +%s%N").trim() + ".py"
    write_file(tmp_py, PAYLOAD)
    let cmd = "/usr/bin/perl -e 'alarm 120; exec @ARGV' /usr/bin/python3 '" + tmp_py + "' '" + mode + "' 2>&1; rm -f '" + tmp_py + "'"
    let result = exec(cmd)
    print(result)
}

run()
