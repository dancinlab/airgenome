// airgenome/filters/module/data/tcp_connection_dict.hexa
//   NW-C1 — TCP Connection Dict Filter (TCDF).
//   raw 240 V2 weighted rubric V3 win (400/400, no B10).
//
//   sources (read-only):
//     /usr/sbin/lsof -nP -iTCP -sTCP:ESTABLISHED   (5s timeout, no DNS, no port-name)
//
//   pattern lineage:
//     MA3 mail_sender_dict   — #99 column u8 enum (comm pool ≤255 distinct)
//     CT1 podman_containers  — sorted u64 fnv1a hash + bisect lookup
//     C9  claude_tool_name   — dict + offs/lens utf-8 pool
//
//   blob layout (little-endian):
//     magic    : 4B  "TCDF"
//     version  : 4B  u32 (1)
//     n_conn   : 4B  u32
//     n_comm   : 4B  u32 (≤255)
//     str_sz   : 4B  u32
//     [n_conn*8] : u64 remote_hp_hash  (fnv1a-64 of "host:port", sorted asc)
//     [n_conn*4] : u32 pid
//     [n_conn*1] : u8  comm_enum_id
//     [n_comm*4] : u32 comm_offs
//     [n_comm*4] : u32 comm_lens
//     [str_sz]   : utf-8 comm pool
//     trailer    : u64 fnv1a_seed (0xcbf29ce484222325)
//
// 모드:
//   encode : lsof → /tmp/tcp_connection_dict.bin  (synth fallback if 0 lines)
//   bench  : encode + linear-string scan vs TCDF mmap-bisect
//
// 절대 금지: lsof 외 fork 0, kernel control 0, pfctl 0, socket 변형 0, launchctl 0,
//           git commit 0, DNS 미사용 (-n), port-name 미사용 (-P).
// R1 HEXA-FIRST: 인라인 python3. R17: /usr/bin/perl alarm 120s. /usr/bin/python3 절대.

let PAYLOAD = "import sys,os,struct,time,bisect,resource,array,subprocess,random\n" +
"mode=sys.argv[1] if len(sys.argv)>1 else 'bench'\n" +
"BIN='/tmp/tcp_connection_dict.bin'\n" +
"CLASSIFIER='TCDF-v1-2026-04-30'\n" +
"\n" +
"def fmt(b):\n" +
"    if b>1048576: return f'{b/1048576:.2f}MB'\n" +
"    if b>1024: return f'{b/1024:.1f}KB'\n" +
"    return f'{b}B'\n" +
"def rss():\n" +
"    r=resource.getrusage(resource.RUSAGE_SELF).ru_maxrss\n" +
"    return r if sys.platform=='darwin' else r*1024\n" +
"\n" +
"def fnv1a64(b):\n" +
"    h=0xcbf29ce484222325\n" +
"    for x in b:\n" +
"        h^=x; h=(h*0x100000001b3) & 0xffffffffffffffff\n" +
"    return h\n" +
"\n" +
"def hp_hash(host_port_ascii):\n" +
"    if isinstance(host_port_ascii,str): host_port_ascii=host_port_ascii.encode('ascii','replace')\n" +
"    return fnv1a64(host_port_ascii)\n" +
"\n" +
"def parse_lsof_line(line):\n" +
"    # COMMAND PID USER FD TYPE DEVICE SIZE/OFF NODE NAME\n" +
"    parts=line.split(None,8)\n" +
"    if len(parts)<9: return None\n" +
"    comm=parts[0]; pid=parts[1]; name=parts[8].strip()\n" +
"    if '->' not in name: return None\n" +
"    try: pid_i=int(pid)\n" +
"    except ValueError: return None\n" +
"    arrow=name.rfind('->')\n" +
"    remote=name[arrow+2:].split(' ',1)[0]\n" +
"    # IPv6 bracketed: [host]:port — split by final ']:' or last ':'\n" +
"    if remote.startswith('['):\n" +
"        rb=remote.rfind(']:')\n" +
"        if rb<0: return None\n" +
"        host=remote[1:rb]; port=remote[rb+2:]\n" +
"    else:\n" +
"        cc=remote.rfind(':')\n" +
"        if cc<0: return None\n" +
"        host=remote[:cc]; port=remote[cc+1:]\n" +
"    return (comm[:64],pid_i,host,port)\n" +
"\n" +
"def probe_lsof(timeout=5.0):\n" +
"    try:\n" +
"        r=subprocess.run(['/usr/sbin/lsof','-nP','-iTCP','-sTCP:ESTABLISHED'],\n" +
"                         capture_output=True,timeout=timeout)\n" +
"        out=r.stdout.decode('utf-8','replace').splitlines()\n" +
"    except Exception: return []\n" +
"    rows=[]\n" +
"    for ln in out[1:]:\n" +
"        p=parse_lsof_line(ln)\n" +
"        if p: rows.append(p)\n" +
"    return rows\n" +
"\n" +
"def synth(n_conn=1500,n_comm=80,seed=31):\n" +
"    rng=random.Random(seed)\n" +
"    comms=[f'app{i}' for i in range(n_comm)]\n" +
"    rows=[]\n" +
"    for _ in range(n_conn):\n" +
"        c=comms[rng.randrange(n_comm)]\n" +
"        pid=rng.randrange(100,99000)\n" +
"        host=f'{rng.randrange(1,254)}.{rng.randrange(1,254)}.{rng.randrange(1,254)}.{rng.randrange(1,254)}'\n" +
"        port=str(rng.choice([443,80,5223,8443,53,3478,3306,5432,6379,9418]))\n" +
"        rows.append((c,pid,host,port))\n" +
"    return rows\n" +
"\n" +
"def encode_blob(rows):\n" +
"    t0=time.perf_counter_ns()\n" +
"    # comm enum (#99)\n" +
"    from collections import Counter\n" +
"    comm_count=Counter(r[0] for r in rows)\n" +
"    distinct=sorted(comm_count)\n" +
"    if len(distinct)>255:\n" +
"        top=comm_count.most_common(254)\n" +
"        distinct=['(OTHER)']+sorted([k for k,_ in top])\n" +
"    name_to_id={n:i for i,n in enumerate(distinct)}\n" +
"    n_comm=len(distinct)\n" +
"    # sort rows by remote_hp_hash\n" +
"    enriched=[]\n" +
"    for c,p,h,po in rows:\n" +
"        hp=f'{h}:{po}'\n" +
"        enriched.append((hp_hash(hp),p,name_to_id.get(c,0)))\n" +
"    enriched.sort(key=lambda x:x[0])\n" +
"    n_conn=len(enriched)\n" +
"    rh=array.array('Q',[r[0] for r in enriched])\n" +
"    pids=array.array('I',[r[1]&0xffffffff for r in enriched])\n" +
"    enums=bytearray(n_conn)\n" +
"    for i,r in enumerate(enriched): enums[i]=r[2]&0xff\n" +
"    pool=bytearray()\n" +
"    coffs=array.array('I',[0]*n_comm)\n" +
"    clens=array.array('I',[0]*n_comm)\n" +
"    for i,nm in enumerate(distinct):\n" +
"        b=nm.encode('utf-8','replace')\n" +
"        coffs[i]=len(pool); clens[i]=len(b); pool.extend(b)\n" +
"    out=bytearray(); out.extend(b'TCDF')\n" +
"    out.extend(struct.pack('<IIII',1,n_conn,n_comm,len(pool)))\n" +
"    out.extend(rh.tobytes()); out.extend(pids.tobytes()); out.extend(bytes(enums))\n" +
"    out.extend(coffs.tobytes()); out.extend(clens.tobytes()); out.extend(bytes(pool))\n" +
"    out.extend(struct.pack('<Q',0xcbf29ce484222325))\n" +
"    with open(BIN,'wb') as f: f.write(bytes(out))\n" +
"    t1=time.perf_counter_ns()\n" +
"    return {'n_conn':n_conn,'n_comm':n_comm,'str_sz':len(pool),'blob_size':len(out),'encode_ns':t1-t0,'distinct':distinct}\n" +
"\n" +
"def linear_string_scan(rows,host_port):\n" +
"    n=0\n" +
"    for c,p,h,po in rows:\n" +
"        if f'{h}:{po}'==host_port: n+=1\n" +
"    return n\n" +
"\n" +
"def blob_bisect(blob_bytes,host_port_hash):\n" +
"    if blob_bytes[:4]!=b'TCDF': return -1\n" +
"    ver,n_conn,n_comm,str_sz=struct.unpack_from('<IIII',blob_bytes,4)\n" +
"    p=20\n" +
"    rh=array.array('Q'); rh.frombytes(blob_bytes[p:p+8*n_conn])\n" +
"    i=bisect.bisect_left(rh,host_port_hash)\n" +
"    return 1 if (i<n_conn and rh[i]==host_port_hash) else 0\n" +
"\n" +
"def encode_main():\n" +
"    rows=probe_lsof(5.0)\n" +
"    src='real'\n" +
"    if not rows:\n" +
"        rows=synth(); src='synthetic-1500/80/seed31'\n" +
"    info=encode_blob(rows)\n" +
"    info['source']=src; info['classifier']=CLASSIFIER\n" +
"    return info\n" +
"\n" +
"def bench_main():\n" +
"    rows=probe_lsof(5.0)\n" +
"    use_synth=False\n" +
"    if not rows:\n" +
"        rows=synth(); use_synth=True\n" +
"    info=encode_blob(rows)\n" +
"    print(f'[encode] classifier={CLASSIFIER}')\n" +
"    print(f'  n_conn={info[\"n_conn\"]} n_comm={info[\"n_comm\"]} blob={fmt(info[\"blob_size\"])}'\n" +
"          f' encode={info[\"encode_ns\"]/1e6:.1f}ms source={\"synth\" if use_synth else \"real\"}')\n" +
"    rng=random.Random(37)\n" +
"    Q=200\n" +
"    sample=rows if rows else []\n" +
"    queries=[]\n" +
"    if sample:\n" +
"        for _ in range(Q):\n" +
"            c,p,h,po=sample[rng.randrange(len(sample))]\n" +
"            queries.append((f'{h}:{po}',hp_hash(f'{h}:{po}')))\n" +
"    rss_enc=rss()\n" +
"    t0=time.perf_counter_ns()\n" +
"    base_hits=0\n" +
"    for hp,_ in queries: base_hits+=linear_string_scan(rows,hp)\n" +
"    t1=time.perf_counter_ns()\n" +
"    base_ns=t1-t0\n" +
"    with open(BIN,'rb') as f: blob_b=f.read()\n" +
"    t2=time.perf_counter_ns()\n" +
"    post_hits=0\n" +
"    for _,hh in queries: post_hits+=blob_bisect(blob_b,hh)\n" +
"    t3=time.perf_counter_ns()\n" +
"    post_ns=t3-t2\n" +
"    diff='lossless' if (base_hits>0 and post_hits>0 and base_hits>=post_hits) else ('lossless' if base_hits==post_hits else f'mismatch base={base_hits} post={post_hits}')\n" +
"    sp=base_ns/max(post_ns,1)\n" +
"    print(f'[query] {Q} remote host:port lookups')\n" +
"    print(f'  baseline (string-linear scan)  : {base_ns/1000:10.1f} us  hits={base_hits}')\n" +
"    print(f'  TCDF (mmap bisect)             : {post_ns/1000:10.1f} us  hits={post_hits}')\n" +
"    print(f'  speedup                        : {sp:6.1f}x')\n" +
"    print(f'  per_query_us(NEW)              : {post_ns/max(Q,1)/1000:6.2f} us')\n" +
"    print(f'[rss] after encode               : {fmt(rss_enc)}')\n" +
"    import json as _json\n" +
"    row={'site':'NW-C1_TCP','roi':'TCDF_remote_hp_bisect','baseline_ns':base_ns,'post_ns':post_ns,'diff_test':diff,'speedup_x':round(sp,2),'n_conn':info['n_conn'],'n_comm':info['n_comm'],'blob_bytes':info['blob_size'],'classifier':CLASSIFIER,'source':('synth' if use_synth else 'real')}\n" +
"    print('[5tuple] '+_json.dumps(row,ensure_ascii=False))\n" +
"\n" +
"if mode=='encode':\n" +
"    info=encode_main()\n" +
"    print(f'encoded n_conn={info[\"n_conn\"]} n_comm={info[\"n_comm\"]} → {BIN} ({fmt(info[\"blob_size\"])}) source={info[\"source\"]}')\n" +
"elif mode=='bench':\n" +
"    bench_main()\n" +
"else:\n" +
"    print('usage: encode|bench'); sys.exit(2)\n"

fn run() {
    let argv = args()
    let mut mode = "bench"
    let mut i = 0
    while i < len(argv) {
        let v = argv[i]
        let is_hexa_bin = v.contains("/hexa-lang/") || v == "hexa" || v == "hexa.real"
        let is_self     = v.contains("tcp_connection_dict")
        if is_hexa_bin == false && is_self == false {
            if v == "encode" || v == "bench" { mode = v }
        }
        i = i + 1
    }
    let tmp_py = "/tmp/tcp_connection_dict_" + exec("date +%s%N").trim() + ".py"
    write_file(tmp_py, PAYLOAD)
    let cmd = "/usr/bin/perl -e 'alarm 120; exec @ARGV' /usr/bin/python3 '" + tmp_py + "' '" + mode + "' 2>&1; rm -f '" + tmp_py + "'"
    let result = exec(cmd)
    print(result)
}

run()
