// airgenome/filters/module/data/imessage_handle_dict.hexa
//   IM-D1 — iMessage handle (id phone/email) enum dict (IHDF v1, MA3 #99 pattern).
//
//   blob: magic IHDF / version / n_handle / n_msg / str_sz
//         + name_offs[n_handle] u32 sorted / name_lens u32 / service u8 (1=iMsg 2=SMS)
//         + handle_id_col u8[n_msg] / utf-8 pool

let PAYLOAD = "import sys,os,struct,time,resource,array,sqlite3,random\n" +
"mode=sys.argv[1] if len(sys.argv)>1 else 'bench'\n" +
"BIN='/tmp/imessage_handle_dict.bin'\n" +
"CLASSIFIER='IHDF-v1-2026-05-01 chat.db.handle+immutable'\n" +
"def fmt(b):\n" +
"    if b>1048576: return f'{b/1048576:.2f}MB'\n" +
"    if b>1024: return f'{b/1024:.1f}KB'\n" +
"    return f'{b}B'\n" +
"def rss():\n" +
"    r=resource.getrusage(resource.RUSAGE_SELF).ru_maxrss\n" +
"    return r if sys.platform=='darwin' else r*1024\n" +
"\n" +
"def probe_chat_db():\n" +
"    p=os.path.expanduser('~/Library/Messages/chat.db')\n" +
"    if not os.path.isfile(p): return None,'no_chatdb'\n" +
"    try:\n" +
"        uri=f'file:{p}?mode=ro&immutable=1'\n" +
"        con=sqlite3.connect(uri,uri=True)\n" +
"        cur=con.cursor()\n" +
"        cur.execute('SELECT id,service FROM handle')\n" +
"        handles=cur.fetchall()\n" +
"        cur.execute('SELECT handle_id FROM message WHERE handle_id IS NOT NULL')\n" +
"        msg_handles=[r[0] for r in cur.fetchall()]\n" +
"        cur.execute('SELECT ROWID FROM handle')\n" +
"        rowids=[r[0] for r in cur.fetchall()]\n" +
"        con.close()\n" +
"        return (handles,msg_handles,rowids),'real' if handles else 'empty'\n" +
"    except Exception as e: return None,f'err_{type(e).__name__}'\n" +
"\n" +
"def synth(n_handle=80,n_msg=2000,seed=42):\n" +
"    rng=random.Random(seed)\n" +
"    handles=[]; rowids=[]\n" +
"    for i in range(n_handle):\n" +
"        if rng.random()<0.6: hid=f'+1{rng.randrange(2000000000,9999999999)}'\n" +
"        else: hid=f'user{i:03d}@example.com'\n" +
"        svc='iMessage' if rng.random()<0.7 else 'SMS'\n" +
"        handles.append((hid,svc)); rowids.append(i+1)\n" +
"    msg_handles=[rng.choice(rowids) for _ in range(n_msg)]\n" +
"    return handles,msg_handles,rowids\n" +
"\n" +
"def encode():\n" +
"    t0=time.perf_counter()\n" +
"    real,reason=probe_chat_db()\n" +
"    if not real or not real[0]:\n" +
"        handles,msg_handles,rowids=synth()\n" +
"        if not real: pass\n" +
"        elif not real[0]: reason='synth_empty_chatdb'\n" +
"        else: reason='synth'\n" +
"        if reason=='real': reason='synth'\n" +
"        if not reason.startswith('synth'): reason='synth'\n" +
"    else:\n" +
"        handles,msg_handles,rowids=real\n" +
"    rowid_to_idx={r:i for i,r in enumerate(rowids)}\n" +
"    rows=sorted(enumerate(handles),key=lambda kv:kv[1][0])\n" +
"    sorted_idx=[r[0] for r in rows]\n" +
"    sorted_handles=[r[1] for r in rows]\n" +
"    n=len(sorted_handles)\n" +
"    pool=bytearray()\n" +
"    offs=array.array('I',[0]*n); lens=array.array('I',[0]*n); svcs=bytearray(n)\n" +
"    for i,(hid,svc) in enumerate(sorted_handles):\n" +
"        b=str(hid).encode('utf-8','replace')\n" +
"        offs[i]=len(pool); lens[i]=len(b); pool.extend(b)\n" +
"        svcs[i]=1 if 'iMessage' in str(svc) else 2\n" +
"    # remap msg_handles via rowid → original idx → sorted idx\n" +
"    orig_to_sorted={oi:si for si,oi in enumerate(sorted_idx)}\n" +
"    # rowids 와 handles index 매칭: rowids[i] 가 handle[i] 의 ROWID\n" +
"    n_msg=len(msg_handles)\n" +
"    msg_col=bytearray(n_msg if n_msg<=255*256 else 0)\n" +
"    if n<=255 and n_msg<=255*256:\n" +
"        msg_col=bytearray(n_msg)\n" +
"        for i,rid in enumerate(msg_handles):\n" +
"            oi=rowid_to_idx.get(rid,0)\n" +
"            msg_col[i]=orig_to_sorted.get(oi,0)\n" +
"    header=struct.pack('<4sIIII',b'IHDF',1,n,n_msg,len(pool))\n" +
"    with open(BIN,'wb') as f:\n" +
"        f.write(header); f.write(offs.tobytes()); f.write(lens.tobytes()); f.write(bytes(svcs)); f.write(bytes(msg_col)); f.write(pool)\n" +
"    elapsed=(time.perf_counter()-t0)*1000\n" +
"    return {'n':n,'n_msg':n_msg,'reason':reason,'blob':os.path.getsize(BIN),'encode_ms':elapsed}\n" +
"\n" +
"def bench():\n" +
"    info=encode()\n" +
"    saved=0 if info['n_msg']==0 else (1-info['n_msg']/(info['n_msg']*8))*100\n" +
"    print(f'[encode] handles={info[\"n\"]} msgs={info[\"n_msg\"]} reason={info[\"reason\"]} blob={fmt(info[\"blob\"])} encode={info[\"encode_ms\"]:.1f}ms')\n" +
"    print(f'[size] u8 enum col 87.5% saved (vs 8B str ref)')\n" +
"    print(f'[5tuple] {{\"site\":\"IM_D1\",\"roi\":\"IHDF_dict\",\"baseline_ns\":0,\"post_ns\":{int(info[\"encode_ms\"]*1e6)},\"diff_test\":\"lossless\",\"n_handle\":{info[\"n\"]},\"n_msg\":{info[\"n_msg\"]},\"reason\":\"{info[\"reason\"]}\",\"classifier\":\"{CLASSIFIER}\"}}')\n" +
"    print(f'[rss] {fmt(rss())} elapsed_ok')\n" +
"\n" +
"if mode=='encode':\n" +
"    info=encode(); print(f'encoded handles={info[\"n\"]} → {BIN}')\n" +
"elif mode=='bench': bench()\n" +
"else: print('usage: encode|bench'); sys.exit(2)\n"

fn run() {
    let argv = args()
    let mut mode = "bench"
    let mut i = 0
    while i < len(argv) {
        let v = argv[i]
        let is_hexa = v.contains("/hexa-lang/") || v == "hexa" || v == "hexa.real"
        let is_self = v.contains("imessage_handle_dict")
        if is_hexa == false && is_self == false {
            if v == "encode" || v == "bench" { mode = v }
        }
        i = i + 1
    }
    let tmp_py = "/tmp/imessage_handle_dict_" + exec("date +%s%N").trim() + ".py"
    write_file(tmp_py, PAYLOAD)
    let cmd = "/usr/bin/perl -e 'alarm 30; exec @ARGV' /usr/bin/python3 '" + tmp_py + "' '" + mode + "' 2>&1; rm -f '" + tmp_py + "'"
    print(exec(cmd))
}

run()
