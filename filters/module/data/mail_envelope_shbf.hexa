// airgenome/filters/module/data/mail_envelope_shbf.hexa
//   MA1 — Mail.app Envelope Index byte-reinterpret SHBF.
//
//   목적: Mail.app 의 ~/Library/Mail/V<n>/MailData/Envelope Index sqlite 를
//         매번 sqlite3 attach + JOIN + ORDER BY 로 끌어오던 hot path
//         (Mail.app 내장 검색 / Smart Mailbox 평가 / Spotlight 보강) 를,
//         단일 mmap blob 으로 치환. subject 또는 from 정렬 + bisect O(log n).
//
//   blob layout (little-endian):
//     magic   : 4B  "MEBF"          (Mail Envelope Blob Filter)
//     version : 4B  u32             (1)
//     n       : 4B  u32             메시지 row 수
//     str_sz  : 4B  u32             string pool 바이트 길이
//     [n*8]   : u64 ts              date_received epoch ns (sort 보조 metadata)
//     [n*4]   : u32 subj_off        pool 내 subject 시작 오프셋 (sort key)
//     [n*4]   : u32 subj_len        subject 길이
//     [n*4]   : u32 from_off        sender(from) 오프셋
//     [n*4]   : u32 from_len        sender 길이
//     [n*4]   : u32 mid_off         message_id 오프셋 (lookup 보조)
//     [n*4]   : u32 mid_len         message_id 길이
//     [str_sz]: utf-8 string pool   subject ‖ from ‖ message_id (대소문자 normalize 된
//                                   subject 기준 정렬, 같은 row 의 from/mid 는 같은 i)
//
// 정렬: subject 의 lowercase utf-8 bytes 기준 ascending. prefix bisect 즉답.
//
// 모드:
//   encode : Envelope Index → /tmp/mail_envelope.bin
//   bench  : encode + sqlite ORDER BY scan vs blob mmap+bisect (100 query)
//
// E4 와 다른 점:
//   - source = Envelope Index (sqlite messages 테이블) — V8/V9/V10/V11 path probe
//   - sqlite 는 read-only URI (?immutable=1) 로 open — Envelope Index 쓰기 0
//   - subject normalize: "Re:"/"Fwd:" prefix strip + lowercase
//
// 절대 금지: Envelope Index mutation, emlx 변형, 외부 SMTP, launchctl, git commit.
// R1 HEXA-FIRST: 신규 .py/.sh 0. 인라인 python3 PAYLOAD.
// R17: /usr/bin/perl alarm 120s wrapper. /usr/bin/python3 절대경로. try/catch 0.

let PAYLOAD = "import sys,os,sqlite3,struct,time,bisect,resource,mmap,array,glob,re\n" +
"mode=sys.argv[1]\n" +
"BIN='/tmp/mail_envelope.bin'\n" +
"HOME=os.path.expanduser('~')\n" +
"\n" +
"def fmt(b):\n" +
"    if b>1048576: return f'{b/1048576:.2f}MB'\n" +
"    if b>1024: return f'{b/1024:.1f}KB'\n" +
"    return f'{b}B'\n" +
"def rss():\n" +
"    r=resource.getrusage(resource.RUSAGE_SELF).ru_maxrss\n" +
"    if sys.platform=='darwin': return r\n" +
"    return r*1024\n" +
"\n" +
"def probe_envelope():\n" +
"    # V8 → V9 → V10 → V11 순으로 시도. 각 V<n>/MailData/Envelope Index.\n" +
"    cands=[]\n" +
"    for v in (8,9,10,11,12):\n" +
"        p=f'{HOME}/Library/Mail/V{v}/MailData/Envelope Index'\n" +
"        if os.path.exists(p): cands.append((v,p))\n" +
"    return cands\n" +
"\n" +
"def open_ro(path):\n" +
"    # immutable=1 — sqlite 가 file 을 read-only 로 강제 + WAL 무시. Envelope Index 쓰기 0.\n" +
"    uri=f'file:{path}?immutable=1'\n" +
"    return sqlite3.connect(uri,uri=True,timeout=2.0)\n" +
"\n" +
"def list_message_columns(con):\n" +
"    cur=con.execute('PRAGMA table_info(messages)')\n" +
"    return [r[1] for r in cur.fetchall()]\n" +
"\n" +
"def detect_schema(con):\n" +
"    cols=set(list_message_columns(con))\n" +
"    # Mail.app schema variant: subject 는 'subjects' 테이블 join, sender 는 'addresses'.\n" +
"    has_subjects=False\n" +
"    has_addresses=False\n" +
"    cur=con.execute(\"SELECT name FROM sqlite_master WHERE type='table'\")\n" +
"    tables={r[0] for r in cur.fetchall()}\n" +
"    if 'subjects' in tables: has_subjects=True\n" +
"    if 'addresses' in tables: has_addresses=True\n" +
"    return cols,has_subjects,has_addresses\n" +
"\n" +
"def fetch_rows(con,limit=20000):\n" +
"    cols,has_subjects,has_addresses=detect_schema(con)\n" +
"    # Mail.app 일반 schema: messages(message_id, subject(subjects.ROWID), sender(addresses.ROWID), date_received)\n" +
"    sel_subj='m.subject'\n" +
"    join_subj=''\n" +
"    if has_subjects:\n" +
"        sel_subj='COALESCE(s.subject,\"\")'\n" +
"        join_subj='LEFT JOIN subjects s ON s.ROWID=m.subject'\n" +
"    sel_from='\"\"'\n" +
"    join_from=''\n" +
"    if has_addresses and 'sender' in cols:\n" +
"        sel_from='COALESCE(a.address,\"\")'\n" +
"        join_from='LEFT JOIN addresses a ON a.ROWID=m.sender'\n" +
"    elif 'sender' in cols:\n" +
"        sel_from='COALESCE(m.sender,\"\")'\n" +
"    mid='COALESCE(m.message_id,\"\")' if 'message_id' in cols else '\"\"'\n" +
"    ts='COALESCE(m.date_received,0)' if 'date_received' in cols else '0'\n" +
"    q=f'SELECT {mid},{sel_subj},{sel_from},{ts} FROM messages m {join_subj} {join_from} LIMIT {int(limit)}'\n" +
"    cur=con.execute(q)\n" +
"    out=[]\n" +
"    for mid_v,subj,frm,t in cur.fetchall():\n" +
"        # V10 schema: message_id/subject/sender 가 INTEGER ROWID 일 수 있음 → str() wrap\n" +
"        out.append((str(mid_v or '')[:512],str(subj or '')[:512],str(frm or '')[:256],int(t or 0)))\n" +
"    return out\n" +
"\n" +
"_RE_PREF=re.compile(r'^(?:re|fwd|fw|aw|sv)\\s*:\\s*',re.I)\n" +
"def norm_subj(s):\n" +
"    s=s.strip()\n" +
"    while True:\n" +
"        m=_RE_PREF.match(s)\n" +
"        if not m: break\n" +
"        s=s[m.end():]\n" +
"    return s.lower()\n" +
"\n" +
"def encode():\n" +
"    cands=probe_envelope()\n" +
"    if not cands:\n" +
"        print('ERROR: no Envelope Index found under ~/Library/Mail/V8..V11'); sys.exit(2)\n" +
"    v,path=cands[0]\n" +
"    raw_size=os.path.getsize(path)\n" +
"    t0=time.perf_counter()\n" +
"    con=open_ro(path)\n" +
"    rows=fetch_rows(con,20000)\n" +
"    con.close()\n" +
"    # sort by normalized subject\n" +
"    keyed=[(norm_subj(s),mid,s,frm,ts) for (mid,s,frm,ts) in rows]\n" +
"    keyed.sort(key=lambda r:r[0])\n" +
"    n=len(keyed)\n" +
"    pool=bytearray()\n" +
"    ts_arr=array.array('Q',[0]*n)\n" +
"    so=array.array('I',[0]*n); sl=array.array('I',[0]*n)\n" +
"    fo=array.array('I',[0]*n); fl=array.array('I',[0]*n)\n" +
"    mo=array.array('I',[0]*n); ml=array.array('I',[0]*n)\n" +
"    for i,(k,mid,s,frm,ts) in enumerate(keyed):\n" +
"        kb=k.encode('utf-8','replace')\n" +
"        so[i]=len(pool); sl[i]=len(kb); pool.extend(kb)\n" +
"        fb=frm.encode('utf-8','replace')\n" +
"        fo[i]=len(pool); fl[i]=len(fb); pool.extend(fb)\n" +
"        mb=mid.encode('utf-8','replace')\n" +
"        mo[i]=len(pool); ml[i]=len(mb); pool.extend(mb)\n" +
"        ts_arr[i]=int(ts)&0xffffffffffffffff\n" +
"    header=struct.pack('<4sIII',b'MEBF',1,n,len(pool))\n" +
"    with open(BIN,'wb') as f:\n" +
"        f.write(header)\n" +
"        f.write(ts_arr.tobytes())\n" +
"        f.write(so.tobytes()); f.write(sl.tobytes())\n" +
"        f.write(fo.tobytes()); f.write(fl.tobytes())\n" +
"        f.write(mo.tobytes()); f.write(ml.tobytes())\n" +
"        f.write(pool)\n" +
"    t1=time.perf_counter()\n" +
"    return {'encode_s':t1-t0,'n':n,'raw_size':raw_size,'blob_size':os.path.getsize(BIN),'src':path,'mail_v':v}\n" +
"\n" +
"class Blob:\n" +
"    def __init__(self,path):\n" +
"        self.f=open(path,'rb')\n" +
"        self.mm=mmap.mmap(self.f.fileno(),0,prot=mmap.PROT_READ)\n" +
"        magic,ver,n,pool_sz=struct.unpack_from('<4sIII',self.mm,0)\n" +
"        if magic!=b'MEBF' or ver!=1:\n" +
"            raise ValueError(f'bad magic/ver: {magic} {ver}')\n" +
"        self.n=n\n" +
"        base=16\n" +
"        ts_off=base; so_off=ts_off+8*n; sl_off=so_off+4*n\n" +
"        fo_off=sl_off+4*n; fl_off=fo_off+4*n\n" +
"        mo_off=fl_off+4*n; ml_off=mo_off+4*n\n" +
"        pool_off=ml_off+4*n\n" +
"        mv=memoryview(self.mm)\n" +
"        self.ts=array.array('Q'); self.ts.frombytes(bytes(mv[ts_off:ts_off+8*n]))\n" +
"        so=array.array('I'); so.frombytes(bytes(mv[so_off:so_off+4*n]))\n" +
"        sl=array.array('I'); sl.frombytes(bytes(mv[sl_off:sl_off+4*n]))\n" +
"        fo=array.array('I'); fo.frombytes(bytes(mv[fo_off:fo_off+4*n]))\n" +
"        fl=array.array('I'); fl.frombytes(bytes(mv[fl_off:fl_off+4*n]))\n" +
"        mo=array.array('I'); mo.frombytes(bytes(mv[mo_off:mo_off+4*n]))\n" +
"        ml=array.array('I'); ml.frombytes(bytes(mv[ml_off:ml_off+4*n]))\n" +
"        pool=bytes(mv[pool_off:pool_off+pool_sz])\n" +
"        self.subjects=[pool[so[i]:so[i]+sl[i]] for i in range(n)]\n" +
"        self.froms   =[pool[fo[i]:fo[i]+fl[i]] for i in range(n)]\n" +
"        self.mids    =[pool[mo[i]:mo[i]+ml[i]] for i in range(n)]\n" +
"    def prefix_subj(self,prefix):\n" +
"        pb=prefix.lower().encode('utf-8') if isinstance(prefix,str) else prefix\n" +
"        s=bisect.bisect_left(self.subjects,pb)\n" +
"        e=bisect.bisect_left(self.subjects,pb+b'\\xff\\xff\\xff\\xff')\n" +
"        return e-s\n" +
"    def close(self):\n" +
"        self.mm.close(); self.f.close()\n" +
"\n" +
"def bench():\n" +
"    info=encode()\n" +
"    print(f'[encode] {info[\"encode_s\"]*1000:.1f} ms  V{info[\"mail_v\"]}  msgs={info[\"n\"]}  blob={fmt(info[\"blob_size\"])} ({100*info[\"blob_size\"]/max(info[\"raw_size\"],1):.1f}% of {fmt(info[\"raw_size\"])})')\n" +
"    if info['n']==0:\n" +
"        print('[bench] no messages — skip query phase'); return\n" +
"    b=Blob(BIN)\n" +
"    import random\n" +
"    random.seed(42)\n" +
"    samples=[]\n" +
"    for _ in range(100):\n" +
"        i=random.randrange(b.n)\n" +
"        s=b.subjects[i].decode('utf-8','replace')\n" +
"        plen=min(len(s),random.choice([3,4,5,6]))\n" +
"        samples.append(s[:plen] if plen>0 else 'a')\n" +
"    rss_blob=rss()\n" +
"    for p in samples[:5]: b.prefix_subj(p)\n" +
"    t0=time.perf_counter()\n" +
"    total_hits=0\n" +
"    for p in samples: total_hits+=b.prefix_subj(p)\n" +
"    t1=time.perf_counter()\n" +
"    blob_us=(t1-t0)*1e6/len(samples)\n" +
"    b.close()\n" +
"    # OLD: 매 쿼리 sqlite ORDER BY+LIKE 재실행\n" +
"    con=open_ro(info['src'])\n" +
"    cols,has_subjects,_=detect_schema(con)\n" +
"    sub_expr=\"COALESCE(s.subject,'')\" if has_subjects else 'm.subject'\n" +
"    sub_join='LEFT JOIN subjects s ON s.ROWID=m.subject' if has_subjects else ''\n" +
"    t0=time.perf_counter()\n" +
"    sql_hits=0\n" +
"    for p in samples:\n" +
"        like=p.replace('%','').replace('_','')+'%'\n" +
"        cur=con.execute(f'SELECT COUNT(1) FROM messages m {sub_join} WHERE LOWER({sub_expr}) LIKE ?',(like.lower(),))\n" +
"        sql_hits+=int(cur.fetchone()[0] or 0)\n" +
"    t1=time.perf_counter()\n" +
"    sql_us=(t1-t0)*1e6/len(samples)\n" +
"    con.close()\n" +
"    print(f'[query] 100 prefix-subject  hits blob={total_hits} sqlite={sql_hits}')\n" +
"    print(f'  sqlite ORDER+LIKE          : {sql_us:10.1f} us')\n" +
"    print(f'  blob mmap + bisect         : {blob_us:10.1f} us')\n" +
"    if blob_us>0: print(f'  speedup                    : {sql_us/blob_us:6.1f}x')\n" +
"    print(f'[rss] after blob: {fmt(rss_blob)}')\n" +
"\n" +
"if mode=='encode':\n" +
"    info=encode()\n" +
"    print(f'encoded {info[\"n\"]} msgs (V{info[\"mail_v\"]}) in {info[\"encode_s\"]*1000:.1f} ms → {BIN} ({fmt(info[\"blob_size\"])})')\n" +
"elif mode=='bench':\n" +
"    bench()\n" +
"else:\n" +
"    print('usage: encode|bench'); sys.exit(2)\n"

fn run() {
    let argv = args()
    let mut mode = "bench"
    let mut i = 0
    while i < len(argv) {
        let v = argv[i]
        let is_hexa_bin = v.contains("/hexa-lang/") || v == "hexa" || v == "hexa.real"
        let is_self     = v.contains("mail_envelope_shbf")
        if is_hexa_bin == false && is_self == false {
            if v == "encode" || v == "bench" { mode = v }
        }
        i = i + 1
    }
    let tmp_py = "/tmp/mail_envelope_shbf_" + exec("date +%s%N").trim() + ".py"
    write_file(tmp_py, PAYLOAD)
    let cmd = "/usr/bin/perl -e 'alarm 120; exec @ARGV' /usr/bin/python3 '" + tmp_py + "' '" + mode + "' 2>&1; rm -f '" + tmp_py + "'"
    let result = exec(cmd)
    print(result)
}

run()
