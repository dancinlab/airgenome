// airgenome/filters/module/data/claude_tool_result_dedup.hexa
//   C2 — Claude tool_use_result content dedup filter (CTDD).
//
//   목적: jsonl 의 toolUseResult body (Bash 출력, Read 파일, Grep 결과 등)
//         가 반복 호출에서 자주 동일하다. content hash (xxh64-fallback)
//         로 dedup → 같은 hash 는 1회만 저장하고 reference 만 남긴다.
//         (#65 wyhash/xxh64 + #41 dedup cache + 카탈로그 R 멱등 게이트.)
//
//   blob layout (little-endian):
//     magic   : 4B  "CTDD"
//     version : 4B  u32             (1)
//     n_uniq  : 4B  u32             unique content 개수
//     pool_sz : 4B  u32             content pool 바이트
//     [n*8]   : u64 hashes          xxh64 (sorted asc, lookup bisect)
//     [n*4]   : u32 offs            pool 시작
//     [n*4]   : u32 lens            content 길이
//     [pool]  : utf-8 raw bytes
//
//   query: hash → bisect_left → content. token saving = sum(len * (refcount-1)).
//
// 모드:
//   encode <jsonl>     : jsonl → /tmp/claude_tool_result_ctdd.bin + stats
//   bench  <jsonl>     : encode + dedup ratio + token estimate
//                        (rough: 1 token ≈ 4 bytes for English text)
//
// 패턴: #65 (xxh64 — pure python fallback, sha256 대비 ~10× 빠름) + #41 dedup cache.
//
// R1 HEXA-FIRST: 인라인 python3 페이로드. raw 9 hexa-only.
// R17: /usr/bin/perl alarm 120s wrapper.

let PAYLOAD = "import sys,os,struct,time,bisect,resource,mmap,array,json,hashlib,glob\n" +
"mode=sys.argv[1]; src=sys.argv[2]\n" +
"BIN='/tmp/claude_tool_result_ctdd.bin'\n" +
"\n" +
"def fmt(b):\n" +
"    if b>1048576: return f'{b/1048576:.2f}MB'\n" +
"    if b>1024: return f'{b/1024:.1f}KB'\n" +
"    return f'{b}B'\n" +
"def rss():\n" +
"    r=resource.getrusage(resource.RUSAGE_SELF).ru_maxrss\n" +
"    if sys.platform=='darwin': return r\n" +
"    return r*1024\n" +
"\n" +
"# xxh64 stdlib-only fallback: blake2b 16-byte digest 의 first 8 bytes.\n" +
"# blake2b 는 sha256 대비 ~2-3× 빠르고, 8B 출력은 64-bit hash 로 충분.\n" +
"# 진짜 xxh64 가 깔리면 그걸 우선 쓰지만 stdlib 만 강제 — blake2b 로 일관성 유지.\n" +
"def xxh64_fallback(b):\n" +
"    h=hashlib.blake2b(b,digest_size=8).digest()\n" +
"    return struct.unpack('<Q',h)[0]\n" +
"\n" +
"def expand_input(src):\n" +
"    if os.path.isdir(src):\n" +
"        return [os.path.join(dp,f) for dp,_,fs in os.walk(src) for f in fs if f.endswith('.jsonl')]\n" +
"    if '*' in src:\n" +
"        return sorted(glob.glob(src))\n" +
"    if os.path.isfile(src): return [src]\n" +
"    return []\n" +
"\n" +
"def extract_tool_results(paths):\n" +
"    # Claude jsonl: type=='user' with 'toolUseResult', 또는\n" +
"    #              type=='assistant' message.content 의 tool_use_result body.\n" +
"    out=[]  # list[bytes]\n" +
"    raw_total=0\n" +
"    for p in paths:\n" +
"        try: f=open(p,'rb')\n" +
"        except OSError: continue\n" +
"        with f:\n" +
"            for ln in f:\n" +
"                ln=ln.strip()\n" +
"                if not ln or ln[:1]!=b'{': continue\n" +
"                raw_total+=len(ln)\n" +
"                try: o=json.loads(ln.decode('utf-8','replace'))\n" +
"                except ValueError: continue\n" +
"                # 1) top-level toolUseResult\n" +
"                tur=o.get('toolUseResult')\n" +
"                if isinstance(tur,(dict,list)):\n" +
"                    s=json.dumps(tur,ensure_ascii=False,sort_keys=True,separators=(',',':'))\n" +
"                    out.append(s.encode('utf-8','replace'))\n" +
"                elif isinstance(tur,str):\n" +
"                    out.append(tur.encode('utf-8','replace'))\n" +
"                # 2) message.content[].content (tool_result body)\n" +
"                msg=o.get('message')\n" +
"                if isinstance(msg,dict):\n" +
"                    c=msg.get('content')\n" +
"                    if isinstance(c,list):\n" +
"                        for blk in c:\n" +
"                            if isinstance(blk,dict) and blk.get('type')=='tool_result':\n" +
"                                body=blk.get('content')\n" +
"                                if isinstance(body,str):\n" +
"                                    out.append(body.encode('utf-8','replace'))\n" +
"                                elif isinstance(body,list):\n" +
"                                    s=json.dumps(body,ensure_ascii=False,sort_keys=True,separators=(',',':'))\n" +
"                                    out.append(s.encode('utf-8','replace'))\n" +
"    return out,raw_total\n" +
"\n" +
"def encode(src):\n" +
"    t0=time.perf_counter()\n" +
"    paths=expand_input(src)\n" +
"    if not paths:\n" +
"        print(f'ERROR: no jsonl: {src}'); sys.exit(1)\n" +
"    bodies,raw_total=extract_tool_results(paths)\n" +
"    if not bodies:\n" +
"        print('[encode] no tool_results extracted')\n" +
"        return {'encode_s':time.perf_counter()-t0,'n_total':0,'n_uniq':0,'raw_total':raw_total,'blob_size':0,'paths':len(paths),'dup_bytes':0}\n" +
"    # hash → first-seen-content map\n" +
"    seen={}\n" +
"    refs={}\n" +
"    total_bytes=0\n" +
"    for body in bodies:\n" +
"        h=xxh64_fallback(body)\n" +
"        total_bytes+=len(body)\n" +
"        if h in seen:\n" +
"            refs[h]=refs.get(h,1)+1\n" +
"        else:\n" +
"            seen[h]=body\n" +
"            refs[h]=1\n" +
"    # sorted by hash for bisect lookup\n" +
"    items=sorted(seen.items(), key=lambda kv:kv[0])\n" +
"    n=len(items)\n" +
"    pool=bytearray()\n" +
"    hashes=array.array('Q',[0]*n)\n" +
"    offs=array.array('I',[0]*n)\n" +
"    lens=array.array('I',[0]*n)\n" +
"    for i,(h,b) in enumerate(items):\n" +
"        hashes[i]=h\n" +
"        offs[i]=len(pool); lens[i]=len(b)\n" +
"        pool.extend(b)\n" +
"    header=struct.pack('<4sIII',b'CTDD',1,n,len(pool))\n" +
"    with open(BIN,'wb') as f:\n" +
"        f.write(header)\n" +
"        f.write(hashes.tobytes())\n" +
"        f.write(offs.tobytes()); f.write(lens.tobytes())\n" +
"        f.write(pool)\n" +
"    t1=time.perf_counter()\n" +
"    bsz=os.path.getsize(BIN)\n" +
"    dup_bytes=sum(len(seen[h])*(refs[h]-1) for h in seen)\n" +
"    return {'encode_s':t1-t0,'n_total':len(bodies),'n_uniq':n,'raw_total':raw_total,'total_bytes':total_bytes,'blob_size':bsz,'paths':len(paths),'dup_bytes':dup_bytes,'refs':refs}\n" +
"\n" +
"class Blob:\n" +
"    def __init__(self,path):\n" +
"        self.f=open(path,'rb')\n" +
"        self.mm=mmap.mmap(self.f.fileno(),0,prot=mmap.PROT_READ)\n" +
"        magic,ver,n,pool_sz=struct.unpack_from('<4sIII',self.mm,0)\n" +
"        if magic!=b'CTDD' or ver!=1:\n" +
"            raise ValueError(f'bad magic/ver: {magic} {ver}')\n" +
"        self.n=n; self.pool_sz=pool_sz\n" +
"        base=16\n" +
"        h_off=base; o_off=h_off+8*n; l_off=o_off+4*n; pool_off=l_off+4*n\n" +
"        self.mv=memoryview(self.mm)\n" +
"        hashes=array.array('Q'); hashes.frombytes(bytes(self.mv[h_off:h_off+8*n]))\n" +
"        offs=array.array('I'); offs.frombytes(bytes(self.mv[o_off:o_off+4*n]))\n" +
"        lens=array.array('I'); lens.frombytes(bytes(self.mv[l_off:l_off+4*n]))\n" +
"        pool=bytes(self.mv[pool_off:pool_off+pool_sz])\n" +
"        self.hashes=hashes\n" +
"        self.contents=[pool[offs[i]:offs[i]+lens[i]] for i in range(n)]\n" +
"    def lookup(self,h):\n" +
"        i=bisect.bisect_left(self.hashes,h)\n" +
"        if i<self.n and self.hashes[i]==h: return self.contents[i]\n" +
"        return None\n" +
"    def close(self):\n" +
"        self.mm.close(); self.f.close()\n" +
"\n" +
"def bench(src):\n" +
"    info=encode(src)\n" +
"    if info['n_total']==0:\n" +
"        print('[bench] no tool_results — skip'); return\n" +
"    n_total=info['n_total']; n_uniq=info['n_uniq']\n" +
"    total_bytes=info['total_bytes']; dup_bytes=info['dup_bytes']\n" +
"    dedup_ratio=(n_total-n_uniq)/n_total if n_total else 0\n" +
"    saved_pct=100*dup_bytes/total_bytes if total_bytes else 0\n" +
"    # 토큰 추정: 영어 텍스트 약 1 token ≈ 4 bytes (Claude tokenizer 근사)\n" +
"    tokens_dup_saved=dup_bytes//4\n" +
"    print(f'[encode] {info[\"encode_s\"]*1000:.1f} ms  paths={info[\"paths\"]}  tool_results={n_total}  unique={n_uniq}')\n" +
"    print(f'[size] raw_jsonl={fmt(info[\"raw_total\"])}  tool_result_bytes={fmt(total_bytes)}  blob={fmt(info[\"blob_size\"])}')\n" +
"    print(f'[dedup] dup_count={n_total-n_uniq}/{n_total} ({100*dedup_ratio:.1f}%)  dup_bytes={fmt(dup_bytes)} ({saved_pct:.1f}% of tool_result)')\n" +
"    print(f'[token] est_tokens_saved≈{tokens_dup_saved}  (assume 4B/tok)')\n" +
"    # bench: hash lookup throughput.\n" +
"    b=Blob(BIN)\n" +
"    rss_blob=rss()\n" +
"    sample=list(b.hashes)[:min(1000,b.n)]\n" +
"    t0=time.perf_counter()\n" +
"    hits=0\n" +
"    for h in sample:\n" +
"        if b.lookup(h) is not None: hits+=1\n" +
"    t1=time.perf_counter()\n" +
"    blob_us=(t1-t0)*1e6/max(1,len(sample))\n" +
"    print(f'[query] {len(sample)} hash lookups  hits={hits}  blob mmap+bisect: {blob_us:.2f} us/query')\n" +
"    # OLD: dedup cache 없을 때 — 매 호출 raw bytes 비교 (linear over n_uniq)\n" +
"    contents=b.contents\n" +
"    sample_bodies=contents[:min(100,len(contents))]\n" +
"    t0=time.perf_counter()\n" +
"    lin_hits=0\n" +
"    for body in sample_bodies:\n" +
"        for c in contents:\n" +
"            if c==body:\n" +
"                lin_hits+=1; break\n" +
"    t1=time.perf_counter()\n" +
"    lin_us=(t1-t0)*1e6/max(1,len(sample_bodies))\n" +
"    print(f'[query] {len(sample_bodies)} linear bytes-eq  hits={lin_hits}  : {lin_us:.2f} us/query')\n" +
"    if blob_us>0:\n" +
"        print(f'  speedup hash→bisect vs linear bytes-eq: {lin_us/blob_us:6.1f}x')\n" +
"    print(f'[rss] after blob: {fmt(rss_blob)}')\n" +
"    b.close()\n" +
"\n" +
"if mode=='encode':\n" +
"    info=encode(src)\n" +
"    print(f'encoded {info[\"n_uniq\"]}/{info[\"n_total\"]} unique tool_results in {info[\"encode_s\"]*1000:.1f} ms → {BIN} ({fmt(info[\"blob_size\"])})')\n" +
"elif mode=='bench':\n" +
"    bench(src)\n" +
"else:\n" +
"    print('usage: encode|bench <jsonl_or_dir>'); sys.exit(2)\n"

fn run() {
    let argv = args()
    let mut mode = "bench"
    let mut target = ""
    let mut i = 0
    while i < len(argv) {
        let v = argv[i]
        let is_hexa_bin = v.contains("/hexa-lang/") || v == "hexa" || v == "hexa.real"
        let is_self     = v.contains("claude_tool_result_dedup")
        if is_hexa_bin == false && is_self == false {
            if v == "encode" || v == "bench" { mode = v }
            else if v.contains(".jsonl") || v.contains("/projects") || v.contains("/.claude") { target = v }
        }
        i = i + 1
    }
    if len(target) == 0 {
        target = env("HOME") + "/.claude/projects"
        println("(default target: " + target + ")")
    }
    let tmp_py = "/tmp/claude_tool_result_dedup_" + exec("date +%s%N").trim() + ".py"
    write_file(tmp_py, PAYLOAD)
    let cmd = "/usr/bin/perl -e 'alarm 120; exec @ARGV' /usr/bin/python3 '" + tmp_py + "' '" + mode + "' '" + target + "' 2>&1; rm -f '" + tmp_py + "'"
    let result = exec(cmd)
    print(result)
}

run()
