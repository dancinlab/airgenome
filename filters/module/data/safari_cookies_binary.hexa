// airgenome/filters/module/data/safari_cookies_binary.hexa
//   SF3 — Safari Cookies.binarycookies parse + domain-sorted SHBF.
//
//   Apple custom binary plist format (reverse-engineered):
//     [outer header big-endian]
//       4B magic = "cook"
//       4B u32 = n_pages
//       n_pages * 4B u32 = page_sizes[]
//     [page #i — little-endian internal]
//       4B magic = 0x00000100
//       4B u32 = n_cookies
//       n_cookies * 4B u32 = cookie_offsets[] (relative to page start)
//       4B u32 footer = 0x00000000
//       [cookie record]
//         4B size, 4B unknown, 4B flags (1=secure, 4=httpOnly), 4B unknown,
//         4B url_off, 4B name_off, 4B path_off, 4B value_off,
//         8B end_marker = 0x00..00
//         8B double expiry  (Cocoa absolute time, +978307200 → unix)
//         8B double creation
//         [NUL-terminated url, name, path, value strings at offsets]
//     [outer footer big-endian]
//       8B = 0x071720050000004B
//
//   SF3 blob layout (little-endian, "SCBF" = Safari Cookies Binary Filter):
//     magic "SCBF" 4B + ver u32 (1) + n u32 + str_sz u32
//     [n*4] u32 host_offsets        (relative to host_pool)
//     [n*4] u32 host_lens
//     [n*4] u32 name_offsets        (relative to name_pool)
//     [n*4] u32 name_lens
//     [n*4] u32 expiry_ts           (unix seconds, u32 — 0 if missing)
//     [n*1] u8  flags               (bit0=secure, bit1=httpOnly)
//     [pad to 4B alignment for str pools — host pool then name pool]
//     [host_pool_size u32][host_pool bytes]
//     [name_pool_size u32][name_pool bytes]
//
//   Privacy: cookie VALUE is INTENTIONALLY EXCLUDED from blob.
//   Sort key: (host, name) ascending — bisect on host prefix.
//
// pgrep guard: read-only file, Safari running 안전 (Cookies.binarycookies 는 atomic-rename write 패턴, snapshot copy 사용).
// R1 HEXA-FIRST: 인라인 python3 페이로드.

let PAYLOAD = "import sys,os,struct,time,bisect,heapq,resource,mmap,array,tempfile,random\n" +
"mode=sys.argv[1]; src=sys.argv[2]\n" +
"BIN='/tmp/safari_cookies.bin'\n" +
"COCOA_OFFSET=978307200\n" +
"if not os.path.exists(src):\n" +
"    print('ERROR: not found: '+src); sys.exit(1)\n" +
"\n" +
"def fmt(b):\n" +
"    if b>1048576: return f'{b/1048576:.2f}MB'\n" +
"    if b>1024: return f'{b/1024:.1f}KB'\n" +
"    return f'{b}B'\n" +
"def rss():\n" +
"    r=resource.getrusage(resource.RUSAGE_SELF).ru_maxrss\n" +
"    if sys.platform=='darwin': return r\n" +
"    return r*1024\n" +
"\n" +
"def safe_copy(src):\n" +
"    tmp=tempfile.NamedTemporaryFile(suffix='.binarycookies',delete=False); tmp.close()\n" +
"    with open(src,'rb') as fr, open(tmp.name,'wb') as fw:\n" +
"        fw.write(fr.read())\n" +
"    return tmp.name\n" +
"\n" +
"def cstring(buf,off):\n" +
"    e=buf.find(b'\\x00',off)\n" +
"    if e<0: return buf[off:]\n" +
"    return buf[off:e]\n" +
"\n" +
"def parse_cookies(path):\n" +
"    with open(path,'rb') as f: data=f.read()\n" +
"    if len(data)<8 or data[:4]!=b'cook':\n" +
"        return [], 'cookies-bad-magic'\n" +
"    n_pages=struct.unpack_from('>I',data,4)[0]\n" +
"    if n_pages==0 or n_pages>1000000:\n" +
"        return [], 'cookies-bad-page-count'\n" +
"    if 8+4*n_pages > len(data):\n" +
"        return [], 'cookies-truncated-page-table'\n" +
"    page_sizes=struct.unpack_from('>'+ 'I'*n_pages, data, 8)\n" +
"    pages_offset=8+4*n_pages\n" +
"    rows=[]\n" +
"    cur=pages_offset\n" +
"    for pi,psz in enumerate(page_sizes):\n" +
"        if cur+psz > len(data):\n" +
"            return rows, 'cookies-page-overflow-truncated'\n" +
"        page=data[cur:cur+psz]\n" +
"        cur+=psz\n" +
"        if len(page)<8: continue\n" +
"        # page magic is BIG-ENDIAN 0x00000100 (verified against real Safari file)\n" +
"        if page[:4]!=b'\\x00\\x00\\x01\\x00':\n" +
"            continue  # tolerate per-page magic mismatch (best-effort skip)\n" +
"        n_cookies=struct.unpack_from('<I',page,4)[0]\n" +
"        if n_cookies==0 or 8+4*n_cookies+4 > len(page): continue\n" +
"        cookie_offs=struct.unpack_from('<'+'I'*n_cookies, page, 8)\n" +
"        for co in cookie_offs:\n" +
"            if co<0 or co+56 > len(page): continue\n" +
"            rec=page[co:]\n" +
"            try:\n" +
"                size=struct.unpack_from('<I',rec,0)[0]\n" +
"                if size<56 or co+size > len(page): continue\n" +
"                rec=rec[:size]\n" +
"                flags=struct.unpack_from('<I',rec,8)[0]\n" +
"                url_off=struct.unpack_from('<I',rec,16)[0]\n" +
"                name_off=struct.unpack_from('<I',rec,20)[0]\n" +
"                path_off=struct.unpack_from('<I',rec,24)[0]\n" +
"                val_off =struct.unpack_from('<I',rec,28)[0]\n" +
"                expiry  =struct.unpack_from('<d',rec,40)[0]\n" +
"                if not (0<=url_off<size and 0<=name_off<size): continue\n" +
"                url=cstring(rec,url_off).decode('utf-8','replace')\n" +
"                name=cstring(rec,name_off).decode('utf-8','replace')\n" +
"                # url 은 hostname (.example.com 형태 또는 full url)\n" +
"                host=url.lstrip('.')\n" +
"                ts=int(expiry+COCOA_OFFSET) if expiry>0 and expiry<2e9 else 0\n" +
"                f_secure=1 if (flags & 0x1) else 0\n" +
"                f_http  =1 if (flags & 0x4) else 0\n" +
"                fb=(f_secure<<0) | (f_http<<1)\n" +
"                rows.append((host,name,ts,fb))\n" +
"            except Exception:\n" +
"                continue\n" +
"    return rows, 'cookies-real'\n" +
"\n" +
"def synth_rows(n=1000):\n" +
"    domains=['example.com','sample.org','demo.net','test.io']\n" +
"    rng=random.Random(42)\n" +
"    base=int(time.time())\n" +
"    out=[]\n" +
"    for i in range(n):\n" +
"        d=domains[i%len(domains)]\n" +
"        out.append((f'sub{i:04d}.{d}',f'cookie_{i%50}',base+rng.randrange(0,86400*90),(i&3)))\n" +
"    return out\n" +
"\n" +
"def encode(src,allow_synth=True):\n" +
"    t0=time.perf_counter()\n" +
"    copy=safe_copy(src); raw_size=os.path.getsize(copy)\n" +
"    rows,reason=parse_cookies(copy)\n" +
"    os.unlink(copy)\n" +
"    if not rows and allow_synth:\n" +
"        rows=synth_rows(); reason=reason+'-synth-fallback' if reason!='cookies-real' else 'cookies-empty-synth'\n" +
"    rows.sort(key=lambda r:(r[0],r[1]))\n" +
"    n=len(rows)\n" +
"    host_pool=bytearray(); host_offs=array.array('I',[0]*n); host_lens=array.array('I',[0]*n)\n" +
"    name_pool=bytearray(); name_offs=array.array('I',[0]*n); name_lens=array.array('I',[0]*n)\n" +
"    tss=array.array('I',[0]*n); flags=bytearray(n)\n" +
"    for i,(h,nm,ts,fb) in enumerate(rows):\n" +
"        hb=h.encode('utf-8','replace'); nb=nm.encode('utf-8','replace')\n" +
"        host_offs[i]=len(host_pool); host_lens[i]=len(hb); host_pool.extend(hb)\n" +
"        name_offs[i]=len(name_pool); name_lens[i]=len(nb); name_pool.extend(nb)\n" +
"        tss[i]=int(ts) & 0xFFFFFFFF; flags[i]=fb & 0xFF\n" +
"    header=struct.pack('<4sIII',b'SCBF',1,n,len(host_pool)+len(name_pool))\n" +
"    with open(BIN,'wb') as f:\n" +
"        f.write(header)\n" +
"        f.write(host_offs.tobytes()); f.write(host_lens.tobytes())\n" +
"        f.write(name_offs.tobytes()); f.write(name_lens.tobytes())\n" +
"        f.write(tss.tobytes()); f.write(bytes(flags))\n" +
"        # alignment pad to 4B\n" +
"        pad=(4-(f.tell()%4))%4\n" +
"        if pad: f.write(b'\\x00'*pad)\n" +
"        f.write(struct.pack('<I',len(host_pool))); f.write(bytes(host_pool))\n" +
"        f.write(struct.pack('<I',len(name_pool))); f.write(bytes(name_pool))\n" +
"    t1=time.perf_counter()\n" +
"    return {'encode_s':t1-t0,'n':n,'raw_size':raw_size,'blob_size':os.path.getsize(BIN),'reason':reason}\n" +
"\n" +
"class Blob:\n" +
"    def __init__(self,path):\n" +
"        self.f=open(path,'rb'); data=self.f.read()\n" +
"        magic,ver,n,_=struct.unpack_from('<4sIII',data,0)\n" +
"        assert magic==b'SCBF' and ver==1\n" +
"        self.n=n; off=16\n" +
"        host_offs=array.array('I'); host_offs.frombytes(data[off:off+4*n]); off+=4*n\n" +
"        host_lens=array.array('I'); host_lens.frombytes(data[off:off+4*n]); off+=4*n\n" +
"        name_offs=array.array('I'); name_offs.frombytes(data[off:off+4*n]); off+=4*n\n" +
"        name_lens=array.array('I'); name_lens.frombytes(data[off:off+4*n]); off+=4*n\n" +
"        tss=array.array('I'); tss.frombytes(data[off:off+4*n]); off+=4*n\n" +
"        flags=data[off:off+n]; off+=n\n" +
"        pad=(4-(off%4))%4; off+=pad\n" +
"        host_pool_sz=struct.unpack_from('<I',data,off)[0]; off+=4\n" +
"        host_pool=data[off:off+host_pool_sz]; off+=host_pool_sz\n" +
"        name_pool_sz=struct.unpack_from('<I',data,off)[0]; off+=4\n" +
"        name_pool=data[off:off+name_pool_sz]; off+=name_pool_sz\n" +
"        self.hosts=[host_pool[host_offs[i]:host_offs[i]+host_lens[i]] for i in range(n)]\n" +
"        self.names=[name_pool[name_offs[i]:name_offs[i]+name_lens[i]] for i in range(n)]\n" +
"        self.tss=tss; self.flags=flags\n" +
"    def host_prefix_topk(self,prefix,k=10):\n" +
"        pb=prefix.encode('utf-8') if isinstance(prefix,str) else prefix\n" +
"        s=bisect.bisect_left(self.hosts,pb)\n" +
"        e=bisect.bisect_left(self.hosts,pb+b'\\xff\\xff\\xff\\xff')\n" +
"        if e==s: return []\n" +
"        if e-s<=k: idxs=list(range(s,e))\n" +
"        else: idxs=heapq.nlargest(k,range(s,e),key=lambda i:self.tss[i])\n" +
"        return [(self.hosts[i].decode('utf-8','replace'),self.names[i].decode('utf-8','replace'),int(self.tss[i]),int(self.flags[i])) for i in idxs]\n" +
"    def close(self): self.f.close()\n" +
"\n" +
"def linear_topk(rows,prefix,k=10):\n" +
"    pb=prefix\n" +
"    hits=[(h,nm,t,fb) for (h,nm,t,fb) in rows if h.startswith(pb)]\n" +
"    hits.sort(key=lambda r:-r[2])\n" +
"    return hits[:k]\n" +
"\n" +
"def bench(src):\n" +
"    info=encode(src,allow_synth=True)\n" +
"    print(f'[encode] {info[\"encode_s\"]*1000:.1f} ms n={info[\"n\"]} raw={fmt(info[\"raw_size\"])} blob={fmt(info[\"blob_size\"])} reason={info[\"reason\"]}')\n" +
"    if info['n']==0:\n" +
"        print('[bench] no cookies — skip query phase'); return\n" +
"    b=Blob(BIN)\n" +
"    rng=random.Random(42)\n" +
"    samples=[]\n" +
"    for _ in range(100):\n" +
"        i=rng.randrange(b.n)\n" +
"        h=b.hosts[i].decode('utf-8','replace')\n" +
"        plen=rng.choice([3,4,5,6])\n" +
"        samples.append(h[:plen] if len(h)>=plen else h)\n" +
"    rss_blob=rss()\n" +
"    for p in samples[:5]: b.host_prefix_topk(p,10)\n" +
"    t0=time.perf_counter()\n" +
"    blob_hits=0\n" +
"    for p in samples: blob_hits+=len(b.host_prefix_topk(p,10))\n" +
"    t1=time.perf_counter()\n" +
"    blob_us=(t1-t0)*1e6/len(samples)\n" +
"    rows_list=[(b.hosts[i].decode('utf-8','replace'),b.names[i].decode('utf-8','replace'),int(b.tss[i]),int(b.flags[i])) for i in range(b.n)]\n" +
"    b.close()\n" +
"    t0=time.perf_counter()\n" +
"    lin_hits=0\n" +
"    for p in samples: lin_hits+=len(linear_topk(rows_list,p,10))\n" +
"    t1=time.perf_counter()\n" +
"    lin_us=(t1-t0)*1e6/len(samples)\n" +
"    # cold-parse path: re-parse 매 query (Safari hot-path 모사 부분)\n" +
"    copy=safe_copy(src)\n" +
"    t0=time.perf_counter()\n" +
"    cold_hits=0\n" +
"    for p in samples[:10]:  # 10 query 만 (cold reparse 비싸므로)\n" +
"        rs,_=parse_cookies(copy)\n" +
"        cold_hits+=len(linear_topk([(h,nm,t,fb) for (h,nm,t,fb) in rs],p,10))\n" +
"    t1=time.perf_counter()\n" +
"    cold_us=(t1-t0)*1e6/10\n" +
"    os.unlink(copy)\n" +
"    print(f'[query] 100 host-prefix-topK-10 (blob_hits={blob_hits} linear_hits={lin_hits} cold_hits={cold_hits})')\n" +
"    print(f'  cold parse + linear (10q): {cold_us:10.1f} us')\n" +
"    print(f'  in-memory linear (100q)  : {lin_us:10.1f} us')\n" +
"    print(f'  blob mmap + bisect (100q): {blob_us:10.1f} us')\n" +
"    if blob_us>0:\n" +
"        print(f'  speedup vs cold-parse    : {cold_us/blob_us:6.1f}x')\n" +
"        print(f'  speedup vs in-mem linear : {lin_us/blob_us:6.1f}x')\n" +
"    print(f'[rss] {fmt(rss_blob)}')\n" +
"\n" +
"if mode=='encode':\n" +
"    info=encode(src,allow_synth=False)\n" +
"    print(f'encoded {info[\"n\"]} cookies in {info[\"encode_s\"]*1000:.1f} ms → {BIN} ({fmt(info[\"blob_size\"])}) reason={info[\"reason\"]}')\n" +
"elif mode=='bench':\n" +
"    bench(src)\n" +
"else:\n" +
"    print('usage: encode|bench <Cookies.binarycookies>'); sys.exit(2)\n"

fn run() {
    let argv = args()
    let mut mode = "bench"
    let mut target = ""
    let mut i = 0
    while i < len(argv) {
        let v = argv[i]
        let is_hexa_bin = v.contains("/hexa-lang/") || v == "hexa" || v == "hexa.real"
        let is_self     = v.contains("safari_cookies_binary")
        if is_hexa_bin == false && is_self == false {
            if v == "encode" || v == "bench" { mode = v }
            else if v.contains(".binarycookies") { target = v }
        }
        i = i + 1
    }
    if len(target) == 0 {
        target = env("HOME") + "/Library/Containers/com.apple.Safari/Data/Library/Cookies/Cookies.binarycookies"
        println("(default target: " + target + ")")
    }
    if file_exists(target) == false {
        println("ERROR: not found: " + target + " (TCC FDA may be required)")
        return
    }
    let safari_pids = exec("pgrep -x Safari 2>/dev/null | wc -l").trim()
    if safari_pids != "0" {
        println("(pgrep: Safari running, " + safari_pids + " pids — read-only safe_copy snapshot used; cookies file is non-mutated)")
    }
    let tmp_py = "/tmp/safari_cookies_binary_" + exec("date +%s%N").trim() + ".py"
    write_file(tmp_py, PAYLOAD)
    let cmd = "/usr/bin/perl -e 'alarm 120; exec @ARGV' /usr/bin/python3 '" + tmp_py + "' '" + mode + "' '" + target + "' 2>&1; rm -f '" + tmp_py + "'"
    let result = exec(cmd)
    print(result)
}

run()
