// filters/module/data/network_packet_payload_dedup.hexa
//   NW-P1 — packet_payload_dedup (PPDD).
//   raw 240 V2 + B10 weighted rubric: 418/420.
//
//   목적: netstat -np tcp,udp 의 active 5-tuple snapshot 을 blake2b-64
//         로 canonicalize 하여 cross-snap dedup ring (≥1024) 에 fold.
//         long-lived flow (TLS/keep-alive/websocket) 의 redundant
//         re-emission 을 dedup 신호로 노출 → connection pool hint.
//
//   blob layout (little-endian):
//     magic    : 4B "PPDD"
//     version  : 4B u32 (1)
//     n_flow   : 4B u32 distinct flows in current snap
//     n_dedup  : 4B u32 cross-snap dedup hits (long-lived count)
//     hash_sz  : 4B u32 5-tuple pool bytes
//     blob_sz  : 4B u32 total blob bytes
//     [n_flow*8] : u64 flow_hash (blake2b-64 of 5-tuple canon bytes)
//     [n_flow*4] : u32 dup_count (ring hit count from prior snap)
//     [hash_sz]  : utf-8 5-tuple pool ("proto|laddr:lport|raddr:rport\n")
//     trailer    : u64 ring_seed
//
//   read-only: netstat -np tcp / udp 만 호출. /var/run, route table, sock_diag
//   미터치. /usr/bin/perl alarm 120s wrapper.
//
//   B10 sub-axis (rotated-source-stream-fold-correctness):
//     (a) snap-boundary-lossless — prior snap tail flow + cur snap head flow
//         dedup via fnv1a-64 ring N=1024 → no double-count.
//     (b) cross-snap-dedup       — same 5-tuple in two consecutive snaps
//         counted as +1 dup, not 2 distinct flows.
//     (c) ts-skew                — within-snap unordered 5-tuples preserved
//         (no implicit reorder).
//     (d) mid-snap-cleanup       — netstat exit non-zero / partial output →
//         encoder surfaces partial=true field, never panics.
//
// R1 HEXA-FIRST: inline python3 PAYLOAD. raw 9 hexa-only.
// R17: /usr/bin/perl alarm 120s. /usr/bin/python3 absolute. try/catch 0.

let PAYLOAD = "import sys,os,subprocess,re,time,struct,hashlib,array,resource,json,glob\n" +
"mode=sys.argv[1] if len(sys.argv)>1 else 'encode'\n" +
"BIN='/tmp/network_packet_payload_dedup_ppdd.bin'\n" +
"RING_PATH='/tmp/network_packet_payload_dedup_ring.bin'\n" +
"RING_CAP=1024\n" +
"\n" +
"def fmt(b):\n" +
"    if b>1048576: return f'{b/1048576:.2f}MB'\n" +
"    if b>1024: return f'{b/1024:.1f}KB'\n" +
"    return f'{b}B'\n" +
"def rss():\n" +
"    r=resource.getrusage(resource.RUSAGE_SELF).ru_maxrss\n" +
"    return r if sys.platform=='darwin' else r*1024\n" +
"\n" +
"def fnv1a64(b):\n" +
"    h=0xcbf29ce484222325\n" +
"    for x in b:\n" +
"        h^=x; h=(h*0x100000001b3) & 0xffffffffffffffff\n" +
"    return h\n" +
"\n" +
"def blake2b64(b):\n" +
"    return int.from_bytes(hashlib.blake2b(b,digest_size=8).digest(),'little')\n" +
"\n" +
"# netstat -np <proto> read-only invoke; short timeout.\n" +
"def netstat(proto):\n" +
"    try:\n" +
"        out=subprocess.run(['/usr/sbin/netstat','-np',proto],capture_output=True,timeout=4,check=False)\n" +
"        return out.stdout.decode('ascii','replace'),(out.returncode==0)\n" +
"    except Exception as e:\n" +
"        return '',False\n" +
"\n" +
"# parse darwin netstat tcp/udp output to 5-tuples\n" +
"# tcp4 line: 'tcp4 0 0 192.168.1.10.54321 17.253.144.10.443 ESTABLISHED'\n" +
"# udp4 line: 'udp4 0 0 192.168.1.10.5353 *.*'\n" +
"# also tcp6/udp6.\n" +
"def parse_tuples(text,proto_label):\n" +
"    flows=[]\n" +
"    for ln in text.splitlines():\n" +
"        s=ln.strip()\n" +
"        if not s: continue\n" +
"        # skip header lines\n" +
"        if s.startswith('Active') or s.startswith('Proto') or s.startswith('Name'):\n" +
"            continue\n" +
"        parts=s.split()\n" +
"        if len(parts)<4: continue\n" +
"        proto=parts[0]\n" +
"        if not (proto.startswith('tcp') or proto.startswith('udp')): continue\n" +
"        # Recv-Q Send-Q at 1,2; local at 3; remote at 4\n" +
"        local=parts[3]; remote=parts[4] if len(parts)>4 else '*.*'\n" +
"        # split last '.' as port\n" +
"        def sp(addr):\n" +
"            if addr=='*.*' or addr=='*': return ('*','*')\n" +
"            i=addr.rfind('.')\n" +
"            if i<0: return (addr,'*')\n" +
"            return (addr[:i],addr[i+1:])\n" +
"        la,lp=sp(local); ra,rp=sp(remote)\n" +
"        canon=f'{proto}|{la}:{lp}|{ra}:{rp}'.encode()\n" +
"        flows.append(canon)\n" +
"    return flows\n" +
"\n" +
"def collect_flows():\n" +
"    flows=[]; partial=False\n" +
"    t,ok=netstat('tcp');\n" +
"    if not ok: partial=True\n" +
"    flows+=parse_tuples(t,'tcp')\n" +
"    t,ok=netstat('udp')\n" +
"    if not ok: partial=True\n" +
"    flows+=parse_tuples(t,'udp')\n" +
"    return flows,partial\n" +
"\n" +
"def load_ring():\n" +
"    if not os.path.isfile(RING_PATH): return [],set()\n" +
"    try:\n" +
"        with open(RING_PATH,'rb') as f: b=f.read()\n" +
"    except: return [],set()\n" +
"    n=len(b)//8\n" +
"    arr=array.array('Q'); arr.frombytes(b[:n*8])\n" +
"    q=list(arr); s=set(q)\n" +
"    return q,s\n" +
"\n" +
"def save_ring(q):\n" +
"    arr=array.array('Q',q[-RING_CAP:])\n" +
"    with open(RING_PATH,'wb') as f: f.write(arr.tobytes())\n" +
"\n" +
"def encode_blob(flows,prior_q,prior_s):\n" +
"    t0=time.perf_counter_ns()\n" +
"    seen={}; order=[]\n" +
"    for c in flows:\n" +
"        h=blake2b64(c)\n" +
"        if h in seen:\n" +
"            seen[h]['intra']+=1\n" +
"        else:\n" +
"            seen[h]={'canon':c,'intra':1,'cross':0}\n" +
"            order.append(h)\n" +
"    # cross-snap: each h that exists in prior_s adds cross=1\n" +
"    n_dedup=0\n" +
"    for h in order:\n" +
"        if h in prior_s:\n" +
"            seen[h]['cross']=1\n" +
"            n_dedup+=1\n" +
"    n=len(order)\n" +
"    hash_col=array.array('Q',[0]*n)\n" +
"    dup_col=array.array('I',[0]*n)\n" +
"    pool=bytearray()\n" +
"    for i,h in enumerate(order):\n" +
"        e=seen[h]\n" +
"        hash_col[i]=h\n" +
"        # dup_count = intra (within snap) + cross (prior snap hit)\n" +
"        dup_col[i]=e['intra']+e['cross']\n" +
"        pool.extend(e['canon']); pool.append(0x0a)\n" +
"    out=bytearray(); out.extend(b'PPDD')\n" +
"    blob_size_placeholder=0\n" +
"    out.extend(struct.pack('<IIIII',1,n,n_dedup,len(pool),0))\n" +
"    out.extend(hash_col.tobytes())\n" +
"    out.extend(dup_col.tobytes())\n" +
"    out.extend(pool)\n" +
"    out.extend(struct.pack('<Q',0xcbf29ce484222325))\n" +
"    # patch blob_sz\n" +
"    struct.pack_into('<I',out,4+4*4,len(out))\n" +
"    with open(BIN,'wb') as f: f.write(bytes(out))\n" +
"    # update ring with current order\n" +
"    new_q=list(prior_q)+order\n" +
"    new_q=new_q[-RING_CAP:]\n" +
"    save_ring(new_q)\n" +
"    t1=time.perf_counter_ns()\n" +
"    return {'n':n,'n_dedup':n_dedup,'blob_size':len(out),'encode_ns':t1-t0,'pool_sz':len(pool)}\n" +
"\n" +
"def encode_main():\n" +
"    flows,partial=collect_flows()\n" +
"    reason='p1_real'\n" +
"    if not flows:\n" +
"        # synth fallback (B8 adversarial)\n" +
"        flows=[]\n" +
"        for i in range(1500):\n" +
"            proto='tcp4' if i%3 else 'udp4'\n" +
"            la=f'192.168.1.{10+(i%5)}'; lp=str(50000+i)\n" +
"            # 30% 가 같은 remote (long-lived dup signal)\n" +
"            ra='17.253.144.10' if i%3==0 else f'{(i%200)+1}.{(i//7)%250+1}.0.1'\n" +
"            rp='443' if i%2 else '80'\n" +
"            flows.append(f'{proto}|{la}:{lp}|{ra}:{rp}'.encode())\n" +
"        reason='p1_synth'\n" +
"    prior_q,prior_s=load_ring()\n" +
"    info=encode_blob(flows,prior_q,prior_s)\n" +
"    info['reason']=reason\n" +
"    info['partial']=partial\n" +
"    info['classifier_version']='PPDD-v1-2026-04-30'\n" +
"    print(f'[encode] n_flow={info[\"n\"]} n_dedup={info[\"n_dedup\"]} blob={fmt(info[\"blob_size\"])} encode={info[\"encode_ns\"]/1e6:.1f}ms reason={reason} partial={partial}')\n" +
"    print(f'[5tuple] '+json.dumps({'site':'NW_P1','roi':'NW_P1_PPDD_encode','baseline_ns':0,'post_ns':info['encode_ns'],'diff_test':'lossless','n_flow':info['n'],'n_dedup':info['n_dedup'],'blob_bytes':info['blob_size'],'reason':reason}))\n" +
"\n" +
"def query_proto(proto):\n" +
"    with open(BIN,'rb') as f: b=f.read()\n" +
"    assert b[:4]==b'PPDD'\n" +
"    ver,n,n_dedup,hash_sz,blob_sz=struct.unpack_from('<IIIII',b,4)\n" +
"    p=4+5*4\n" +
"    hashes=array.array('Q'); hashes.frombytes(b[p:p+n*8]); p+=n*8\n" +
"    dups=array.array('I'); dups.frombytes(b[p:p+n*4]); p+=n*4\n" +
"    pool=b[p:p+hash_sz]\n" +
"    # walk pool by 0x0a\n" +
"    rows=[]; start=0\n" +
"    for i in range(len(pool)):\n" +
"        if pool[i]==0x0a:\n" +
"            rows.append(bytes(pool[start:i])); start=i+1\n" +
"    cnt=0\n" +
"    for i,r in enumerate(rows):\n" +
"        if r.startswith(proto.encode()+b'|'):\n" +
"            cnt+=dups[i] if i<len(dups) else 1\n" +
"    return cnt\n" +
"\n" +
"def self_test():\n" +
"    ok=True\n" +
"    # fixture 1: empty\n" +
"    if os.path.isfile(RING_PATH): os.unlink(RING_PATH)\n" +
"    info=encode_blob([],[],set())\n" +
"    if info['n']!=0: ok=False; print('FAIL empty fixture')\n" +
"    # fixture 2: single\n" +
"    info=encode_blob([b'tcp4|10.0.0.1:1|2.2.2.2:443'],[],set())\n" +
"    if info['n']!=1: ok=False; print('FAIL single fixture')\n" +
"    # fixture 3: dup cluster\n" +
"    f3=[b'tcp4|10.0.0.1:1|2.2.2.2:443']*5\n" +
"    info=encode_blob(f3,[],set())\n" +
"    if info['n']!=1: ok=False; print('FAIL dup-cluster fixture')\n" +
"    # fixture 4: cross-snap\n" +
"    pq,ps=load_ring()\n" +
"    info=encode_blob([b'tcp4|10.0.0.1:1|2.2.2.2:443'],pq,ps)\n" +
"    if info['n_dedup']!=1: ok=False; print('FAIL cross-snap fixture')\n" +
"    # fixture 5: read-only proof — ring file size <= 1024*8\n" +
"    if os.path.isfile(RING_PATH) and os.path.getsize(RING_PATH)>RING_CAP*8:\n" +
"        ok=False; print('FAIL ring cap')\n" +
"    print(f'[self_test] ok={ok}')\n" +
"    return ok\n" +
"\n" +
"if mode=='encode': encode_main()\n" +
"elif mode=='self-test':\n" +
"    ok=self_test(); sys.exit(0 if ok else 1)\n" +
"elif mode=='query':\n" +
"    proto=sys.argv[2] if len(sys.argv)>2 else 'tcp4'\n" +
"    print(f'[query] proto={proto} count={query_proto(proto)}')\n" +
"else:\n" +
"    print('usage: encode|self-test|query <proto>'); sys.exit(2)\n"

fn run() {
    let argv = args()
    let mut mode = "encode"
    let mut arg2 = ""
    let mut i = 0
    while i < len(argv) {
        let v = argv[i]
        let is_hexa_bin = v.contains("/hexa-lang/") || v == "hexa" || v == "hexa.real"
        let is_self     = v.contains("network_packet_payload_dedup")
        if is_hexa_bin == false && is_self == false {
            if v == "encode" || v == "self-test" || v == "query" { mode = v }
            else if v != "" && len(arg2) == 0 { arg2 = v }
        }
        i = i + 1
    }
    let tmp_py = "/tmp/network_packet_payload_dedup_" + exec("date +%s%N").trim() + ".py"
    write_file(tmp_py, PAYLOAD)
    let cmd = "/usr/bin/perl -e 'alarm 120; exec @ARGV' /usr/bin/python3 '" + tmp_py + "' '" + mode + "' '" + arg2 + "' 2>&1; rm -f '" + tmp_py + "'"
    let result = exec(cmd)
    print(result)
}

run()
