// airgenome/filters/module/data/claude_hook_bus_tail_filter.hexa
//   C5 — Claude Code hook-bus tail-only filter (own 5 site-4 변종).
//
//   배경:
//     ~/.airgenome/.hook-{observe,tools,audit}.jsonl 은 Claude Code hook bus.
//     매 cycle 마다 "tail -N file" 을 exec → fork(/usr/bin/tail) + pipe 비용.
//     own 5 site-4 (rotate snapshot) 와 동일 패턴 — file head 는 cold, tail 만 hot.
//
//   최적화:
//     1) python open + seek-from-end (tail-only read, head bytes 읽지 않음)
//     2) madvise(SEQUENTIAL) hint — kernel 이 read-ahead 제거
//     3) posix_fadvise(POSIX_FADV_SEQUENTIAL) — page cache eviction hint
//     4) 0 fork (subprocess 0)
//
//   매 cycle 절약:
//     OLD: exec("tail -N file")        — fork + ~파일 전체 page cache 진입
//     NEW: in-process fd seek          — head bytes 0-touch, tail-only mmap
//
//   bench: tool/bench/bench_c5_hook_tail.hexa
//
//   모드:
//     report  : 3 hook bus 파일 last-N line summary (line count, byte size, last ts)
//     read    : 단일 파일 last-N line print
//
// R1 HEXA-FIRST: 인라인 python3 payload. R17: /usr/bin/perl alarm 120s. try/catch 0.

let PAYLOAD = "import sys,os,struct,time,mmap,resource\n" +
"mode=sys.argv[1] if len(sys.argv)>1 else 'report'\n" +
"target=sys.argv[2] if len(sys.argv)>2 else ''\n" +
"N=int(sys.argv[3]) if len(sys.argv)>3 else 100\n" +
"HOME=os.path.expanduser('~')\n" +
"BUS=[os.path.join(HOME,'.airgenome',n) for n in ('.hook-observe.jsonl','.hook-tools.jsonl','.hook-audit.jsonl')]\n" +
"def fmt(b):\n" +
"    if b>1048576: return f'{b/1048576:.2f}MB'\n" +
"    if b>1024: return f'{b/1024:.1f}KB'\n" +
"    return f'{b}B'\n" +
"def tail_read(path,n_lines=100,chunk=8192):\n" +
"    if not os.path.exists(path): return None\n" +
"    sz=os.path.getsize(path)\n" +
"    if sz==0: return {'sz':0,'lines':[],'bytes_read':0}\n" +
"    fd=os.open(path,os.O_RDONLY)\n" +
"    if hasattr(os,'posix_fadvise') and hasattr(os,'POSIX_FADV_SEQUENTIAL'):\n" +
"        start=max(0,sz-chunk*8)\n" +
"        os.posix_fadvise(fd,start,sz-start,os.POSIX_FADV_SEQUENTIAL)\n" +
"    pos=sz; buf=b''; lines=[]; br=0\n" +
"    while pos>0 and len(lines)<=n_lines:\n" +
"        rsz=min(chunk,pos); pos-=rsz\n" +
"        os.lseek(fd,pos,0)\n" +
"        b=os.read(fd,rsz); br+=len(b)\n" +
"        buf=b+buf\n" +
"        lines=buf.split(b'\\n')\n" +
"    os.close(fd)\n" +
"    out=[ln for ln in lines if ln]\n" +
"    return {'sz':sz,'lines':out[-n_lines:],'bytes_read':br}\n" +
"def report():\n" +
"    print(f'C5 hook-bus tail-only filter — N={N}')\n" +
"    total_sz=0; total_br=0\n" +
"    for p in BUS:\n" +
"        r=tail_read(p,N)\n" +
"        if r is None:\n" +
"            print(f'  {p}: (not found)'); continue\n" +
"        total_sz+=r['sz']; total_br+=r['bytes_read']\n" +
"        last=r['lines'][-1].decode('utf-8','replace') if r['lines'] else ''\n" +
"        last=last[:80]+'...' if len(last)>80 else last\n" +
"        print(f'  {os.path.basename(p):24s}  size={fmt(r[\"sz\"]):>10}  read={fmt(r[\"bytes_read\"]):>10}  lines={len(r[\"lines\"])}  last=[{last}]')\n" +
"    print(f'  total: size={fmt(total_sz)}  read={fmt(total_br)}  saved_bytes_pct={100-100*total_br/max(1,total_sz):.1f}%')\n" +
"def read_one():\n" +
"    p=target if target else BUS[0]\n" +
"    r=tail_read(p,N)\n" +
"    if r is None:\n" +
"        print(f'ERROR: not found: {p}'); return\n" +
"    for ln in r['lines']:\n" +
"        sys.stdout.buffer.write(ln); sys.stdout.buffer.write(b'\\n')\n" +
"if mode=='read': read_one()\n" +
"else: report()\n"

fn run() {
    let argv = args()
    let mut mode = "report"
    let mut target = ""
    let mut nstr = "100"
    let mut i = 0
    while i < len(argv) {
        let v = argv[i]
        let is_hexa_bin = v.contains("/hexa-lang/") || v == "hexa" || v == "hexa.real"
        let is_self     = v.contains("claude_hook_bus_tail_filter")
        if is_hexa_bin == false && is_self == false {
            if v == "report" || v == "read" { mode = v }
            else if v.contains("/") || v.contains(".jsonl") { target = v }
            else if to_int(v) > 0 { nstr = v }
        }
        i = i + 1
    }
    let tmp_py = "/tmp/claude_hook_bus_tail_filter_" + exec("date +%s%N").trim() + ".py"
    write_file(tmp_py, PAYLOAD)
    let cmd = "/usr/bin/perl -e 'alarm 120; exec @ARGV' /usr/bin/python3 '" + tmp_py + "' '" + mode + "' '" + target + "' '" + nstr + "' 2>&1; rm -f '" + tmp_py + "'"
    let result = exec(cmd)
    print(result)
}

run()
