// filters/module/data/perf_lab.hexa — JSONL byte 재해석 5종 perf 실험.
//
// raw#9 hexa-only · raw#11 snake_case · py 0
//
// 측정 지표: 실시간(real ms), CPU(user+sys ms), 피크 RSS (KB).
// 모든 시간/메모리 캡처는 /usr/bin/time -l (macOS) 사용. 각 실험은
// 2-3개 방식을 비교하여 가속비를 산정.
//
// 6 실험:
//   P1  read-all vs stream-scan    — wc-l streaming vs awk vs cat|wc
//   P2  UUID linear vs binary      — grep N회 vs sorted+look N회
//   P3  full-scan vs columnar      — jq full vs 사전 추출 컬럼 grep
//   P4  random record N개 fetch    — sed -n linear vs 오프셋 인덱스 seek (shell)
//   P5  rescan vs cached extract   — jq 100회 vs 추출후 read 100회
//   P6  in-memory line array       — read_file + .split + arr[idx] 100회 — P4 의 hexa-builtin 버전
//
// 사용:
//   hexa filters/module/data/perf_lab.hexa <jsonl-path>

struct Perf {
    real_us: int
    cpu_us: int
    rss_kb: int
}

fn shq(s: str) -> str {
    return "'" + s.replace("'", "'\\''") + "'"
}

fn shell_int(cmd: str) -> int {
    let out = exec(cmd).trim()
    if out == "" { return 0 }
    return to_int(out)
}

fn fmt_ms(us: int) -> str {
    if us >= 1000000 { return to_string(us / 1000) + " ms" }
    if us >= 1000    { return to_string(us / 1000) + "." + to_string((us / 100) - (us / 1000) * 10) + " ms" }
    return to_string(us) + " us"
}

fn fmt_kb(kb: int) -> str {
    if kb >= 1024 { return to_string(kb / 1024) + " MB" }
    return to_string(kb) + " KB"
}

// 호출자가 cmd 내부에 stdout/stderr redirect 를 명시 (prep 의 `> col` 보존).
fn perf_run(cmd: str) -> Perf {
    let tmp = "/tmp/perf_lab_" + to_string(shell_int("date +%s%N")) + ".out"
    let _ = exec("(/usr/bin/time -l sh -c " + shq(cmd) + ") 2> " + tmp)
    let real_us = to_int(exec("awk '/real/ {print int($1*1000000)}' " + tmp).trim())
    let user_us = to_int(exec("awk '/real/ {print int($3*1000000)}' " + tmp).trim())
    let sys_us  = to_int(exec("awk '/real/ {print int($5*1000000)}' " + tmp).trim())
    let rss_b   = to_int(exec("awk '/maximum resident/ {print $1}' " + tmp).trim())
    let _ = exec("rm -f " + tmp)
    return Perf { real_us: real_us, cpu_us: user_us + sys_us, rss_kb: rss_b / 1024 }
}

fn ratio_x(slow: int, fast: int) -> str {
    if fast == 0 { return "  -  " }
    let r = slow / fast
    let r10 = (slow * 10) / fast
    return to_string(r) + "." + to_string(r10 - r * 10) + "x"
}

fn show(label: str, p: Perf) {
    println("  " + label + "  real=" + fmt_ms(p.real_us) + "  cpu=" + fmt_ms(p.cpu_us) + "  rss=" + fmt_kb(p.rss_kb))
}

fn compare(name_a: str, a: Perf, name_b: str, b: Perf) {
    println("  speedup " + name_a + "→" + name_b + ":  real=" + ratio_x(a.real_us, b.real_us) + "  cpu=" + ratio_x(a.cpu_us, b.cpu_us))
}

// ───────────────────────────────────────────────────────────────── P1 ──
fn p1_read_vs_stream(path: str) {
    println("P1 read-all vs stream-scan (line count)")
    let a = perf_run("wc -l < " + shq(path) + " > /dev/null")
    let b = perf_run("awk 'END{print NR}' " + shq(path) + " > /dev/null")
    let c = perf_run("cat " + shq(path) + " | wc -l > /dev/null")
    show("wc       ", a)
    show("awk END  ", b)
    show("cat | wc ", c)
    compare("cat|wc ", c, "wc     ", a)
}

// ───────────────────────────────────────────────────────────────── P2 ──
fn p2_uuid_lookup(path: str) {
    println("P2 UUID lookup — linear grep vs binary look")
    let uuids = "/tmp/perf_lab_uuids_" + to_string(shell_int("date +%s%N")) + ".txt"
    let lookups = "/tmp/perf_lab_lookups_" + to_string(shell_int("date +%s%N")) + ".txt"
    let sorted = "/tmp/perf_lab_sorted_" + to_string(shell_int("date +%s%N")) + ".txt"
    let _ = exec("jq -r '.uuid // empty' " + shq(path) + " 2>/dev/null > " + uuids)
    let n_uuid = shell_int("wc -l < " + uuids)
    if n_uuid == 0 {
        println("  skip — uuid 없음")
        let _ = exec("rm -f " + uuids)
        return
    }
    // 1000 개 (또는 가능한 만큼) 샘플
    let _ = exec("awk 'BEGIN{srand(42)} {print rand() \"\\t\" $0}' " + uuids + " | sort -k1,1 | head -1000 | cut -f2 > " + lookups)
    let _ = exec("sort -u " + uuids + " > " + sorted)
    println("  corpus: " + to_string(n_uuid) + " uuids,  lookups: " + to_string(shell_int("wc -l < " + lookups)))
    let a = perf_run("while read u; do grep -F \"$u\" " + shq(path) + " > /dev/null; done < " + lookups)
    let b = perf_run("while read u; do look \"$u\" " + sorted + " > /dev/null; done < " + lookups)
    show("grep linear ", a)
    show("look binary ", b)
    compare("grep   ", a, "look   ", b)
    let _ = exec("rm -f " + uuids + " " + lookups + " " + sorted)
}

// ───────────────────────────────────────────────────────────────── P3 ──
fn p3_columnar(path: str) {
    println("P3 full-scan vs columnar projection (parentUuid 카운트)")
    let col = "/tmp/perf_lab_col_" + to_string(shell_int("date +%s%N")) + ".txt"
    let prep_us = perf_run("jq -r '.parentUuid // empty' " + shq(path) + " > " + col).real_us
    let col_size = shell_int("wc -c < " + col)
    let raw_size = shell_int("wc -c < " + shq(path))
    println("  prep: " + fmt_ms(prep_us) + " (1회)  컬럼=" + to_string(col_size / 1024) + " KB / 원본=" + to_string(raw_size / 1024) + " KB")
    let a = perf_run("jq -c 'select(.parentUuid != null)' " + shq(path) + " | wc -l > /dev/null")
    let b = perf_run("grep -c . " + col + " > /dev/null")
    show("jq full      ", a)
    show("col grep     ", b)
    compare("jq     ", a, "col    ", b)
    let _ = exec("rm -f " + col)
}

// ───────────────────────────────────────────────────────────────── P4 ──
fn p4_random_record(path: str) {
    println("P4 random record N개 fetch — linear vs offset-seek")
    let n_lines = shell_int("wc -l < " + shq(path))
    if n_lines < 10 {
        println("  skip — 레코드 부족")
        return
    }
    let picks = "/tmp/perf_lab_picks_" + to_string(shell_int("date +%s%N")) + ".txt"
    let offsets = "/tmp/perf_lab_off_" + to_string(shell_int("date +%s%N")) + ".txt"
    let pairs = "/tmp/perf_lab_pairs_" + to_string(shell_int("date +%s%N")) + ".txt"
    // 100개 랜덤 라인 번호
    let _ = exec("awk -v n=" + to_string(n_lines) + " 'BEGIN{srand(7); for(i=0;i<100;i++) print 1+int(rand()*n)}' > " + picks)
    // 오프셋 인덱스 prep (라인별 시작 byte)
    let prep_us = perf_run("awk 'BEGIN{p=0}{print p\"\\t\"length($0); p+=length($0)+1}' " + shq(path) + " > " + offsets).real_us
    // picks 의 라인 번호에 해당하는 (offset, length) 만 추출 (process subst 회피)
    let _ = exec("awk 'NR==FNR{want[$0]=1; next} (FNR in want){print $1, $2}' " + picks + " " + offsets + " > " + pairs)
    println("  prep offsets: " + fmt_ms(prep_us) + " (1회)  pairs=" + to_string(shell_int("wc -l < " + pairs)))
    let a = perf_run("while read n; do sed -n \"${n}p\" " + shq(path) + " > /dev/null; done < " + picks)
    let b = perf_run("while read off len; do tail -c +$((off+1)) " + shq(path) + " | head -c $len > /dev/null; done < " + pairs)
    show("sed linear  ", a)
    show("offset seek ", b)
    compare("sed    ", a, "seek   ", b)
    let _ = exec("rm -f " + picks + " " + offsets + " " + pairs)
}

// ───────────────────────────────────────────────────────────────── P5 ──
fn p5_cache(path: str) {
    println("P5 rescan vs cached extract (tool_result 100회 쿼리)")
    let cache = "/tmp/perf_lab_cache_" + to_string(shell_int("date +%s%N")) + ".txt"
    let prep_us = perf_run("jq -rc '.message.content // [] | if type==\"array\" then map(select(.type==\"tool_result\") | (.content // \"\" | tostring)) | .[] else empty end' " + shq(path) + " > " + cache).real_us
    let cache_size = shell_int("wc -c < " + cache)
    println("  prep: " + fmt_ms(prep_us) + " (1회)  cache=" + to_string(cache_size / 1024) + " KB")
    let a = perf_run("for i in $(seq 1 100); do jq -rc '.message.content // [] | if type==\"array\" then map(select(.type==\"tool_result\")) | length else 0 end' " + shq(path) + " > /dev/null; done")
    let b = perf_run("for i in $(seq 1 100); do wc -l < " + cache + " > /dev/null; done")
    show("jq x100      ", a)
    show("cache x100   ", b)
    compare("jq     ", a, "cache  ", b)
    let _ = exec("rm -f " + cache)
}

// ───────────────────────────────────────────────────────────────── P6 ──
// hexa builtin (read_file + .split + array indexing) 으로 in-memory line array 만든 후
// P4 와 동일 패턴 (랜덤 100 라인 fetch). shell fork 비용 0 — 진짜 random access 이론치.
// 이 측정이 의미하는 바: hexa-lang upstream 에 io_seek/io_read_n native 추가 시
// shell-pipeline 으로는 도달 불가능한 영역의 속도가 가능. (현재는 builtin 으로 우회.)
fn p6_in_memory(path: str) {
    println("P6 in-memory line array (hexa builtin, shell fork 0)")
    let n_lines = shell_int("wc -l < " + shq(path))
    if n_lines < 10 {
        println("  skip — 레코드 부족")
        return
    }
    let picks = "/tmp/perf_lab_picks6_" + to_string(shell_int("date +%s%N")) + ".txt"
    let _ = exec("awk -v n=" + to_string(n_lines) + " 'BEGIN{srand(7); for(i=0;i<100;i++) print 1+int(rand()*n)}' > " + picks)
    // sed-linear baseline 재측정 (P4 와 같은 picks)
    let a = perf_run("while read n; do sed -n \"${n}p\" " + shq(path) + " > /dev/null; done < " + picks)
    show("sed linear     ", a)
    // hexa in-memory: 한 hexa 프로세스 내부에서 모두 처리. /usr/bin/time 으로 측정.
    let runner = "/tmp/perf_lab_p6run_" + to_string(shell_int("date +%s%N")) + ".hexa"
    let runner_src = "fn run() {\n    let argv = args()\n    let mut path = \"\"\n    let mut picks_path = \"\"\n    let mut i = 0\n    while i < len(argv) {\n        let v = argv[i]\n        i = i + 1\n        if v.ends_with(\".jsonl\") { path = v }\n        if v.contains(\"perf_lab_picks6\") { picks_path = v }\n    }\n    let content = read_file(path)\n    let lines = content.split(\"\\n\")\n    let picks_raw = read_file(picks_path)\n    let picks = picks_raw.split(\"\\n\")\n    let mut sum = 0\n    let mut j = 0\n    while j < picks.len() {\n        let p = picks[j].trim()\n        j = j + 1\n        if p == \"\" { continue }\n        let idx = to_int(p) - 1\n        if idx >= 0 { if idx < lines.len() { sum = sum + lines[idx].len() } }\n    }\n    println(to_string(sum))\n}\nrun()\n"
    write_file(runner, runner_src)
    let b = perf_run("HEXA_LOCAL=1 hexa run " + runner + " " + shq(path) + " " + picks + " > /dev/null")
    show("hexa in-mem    ", b)
    compare("sed    ", a, "in-mem ", b)
    let _ = exec("rm -f " + picks + " " + runner)
}

// ───────────────────────────────────────────────────────────────── main ──
fn run() {
    let argv = args()
    let mut path = ""
    let mut i = 0
    while i < len(argv) {
        let v = argv[i]
        i = i + 1
        if v == "" { continue }
        if v.contains(".hexa-cache") { continue }
        if v.ends_with(".hexa") { continue }
        if v.ends_with(".jsonl") { path = v }
    }
    if path == "" {
        println("usage: hexa filters/module/data/perf_lab.hexa <jsonl-path>")
        return
    }
    if file_exists(path) == false {
        println("ERROR: not found: " + path)
        return
    }
    let raw = shell_int("wc -c < " + shq(path))
    let lines = shell_int("wc -l < " + shq(path))
    println("== perf_lab: " + path + " ==")
    println("  size=" + fmt_kb(raw / 1024) + "  lines=" + to_string(lines))
    println("")
    p1_read_vs_stream(path)
    println("")
    p2_uuid_lookup(path)
    println("")
    p3_columnar(path)
    println("")
    p4_random_record(path)
    println("")
    p5_cache(path)
    println("")
    p6_in_memory(path)
}

run()
