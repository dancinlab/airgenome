// airgenome/filters/module/data/chrome_cookies_dict.hexa
//   BR6 — Chrome Cookies host_key column → 1-byte enum dict (CCDF v1).
//
//   목적: Chrome `Default/Cookies` cookies table 의 host_key 컬럼은 distinct
//         host 가 보통 50~250 — 동일 host 의 multi-cookie 가 절대다수.
//         "GROUP BY host_key" / 표시 / lookup 을 string 비교 대신 1-byte enum.
//         row 당 평균 20-40B host_key → 1B enum.
//
//   blob layout (little-endian):
//     magic    : 4B  "CCDF"          (Chrome Cookies Dict Filter)
//     version  : 4B  u32 (1)
//     n_host   : 4B  u32 distinct host count (≤255)
//     n_msg    : 4B  u32 total row count
//     str_sz   : 4B  u32 host pool size
//     [n_host*4]: u32 host_offs
//     [n_host*4]: u32 host_lens
//     [str_sz]  : utf-8 host pool
//     [n_msg]   : u8  enum column (host id per row)
//
//   read-only 전략:
//     - sqlite URI: file:<path>?mode=ro&immutable=1
//     - sqlite3.backup() snapshot
//     - pgrep -lf '[Cc]hrome' 양수 → synth-only fallback
//     - encrypted_value 미접촉 — host_key 만 plaintext 추출
//
//   classifier_version=CCDF-v1-2026-04-30
//
// R1 HEXA-FIRST. R17: /usr/bin/perl alarm 120s. /usr/bin/python3 절대.

let PAYLOAD = "import sys,os,sqlite3,tempfile,struct,time,array,mmap,resource,subprocess,random\n" +
"from collections import Counter\n" +
"mode=sys.argv[1] if len(sys.argv)>1 else 'bench'\n" +
"src=sys.argv[2] if len(sys.argv)>2 else os.path.expanduser('~/Library/Application Support/Google/Chrome/Default/Cookies')\n" +
"BIN='/tmp/chrome_cookies_ccdf.bin'\n" +
"CLASSIFIER='CCDF-v1-2026-04-30'\n" +
"\n" +
"def fmt(b):\n" +
"    if b>1048576: return f'{b/1048576:.2f}MB'\n" +
"    if b>1024: return f'{b/1024:.1f}KB'\n" +
"    return f'{b}B'\n" +
"def rss():\n" +
"    r=resource.getrusage(resource.RUSAGE_SELF).ru_maxrss\n" +
"    if sys.platform=='darwin': return r\n" +
"    return r*1024\n" +
"\n" +
"def chrome_running():\n" +
"    r=subprocess.run(['/usr/bin/pgrep','-lf','[Cc]hrome'],capture_output=True,timeout=3)\n" +
"    return bool(r.stdout.strip())\n" +
"\n" +
"def safe_copy(src):\n" +
"    tmp=tempfile.NamedTemporaryFile(suffix='.sqlite',delete=False); tmp.close()\n" +
"    uri=f'file:{src}?mode=ro&immutable=1'\n" +
"    sc=sqlite3.connect(uri,uri=True,timeout=2.0)\n" +
"    dc=sqlite3.connect(tmp.name)\n" +
"    sc.backup(dc); dc.close(); sc.close()\n" +
"    return tmp.name\n" +
"\n" +
"def synth_hosts(n=5000,seed=45):\n" +
"    rng=random.Random(seed)\n" +
"    base_hosts=[f'.host{i}.example' for i in range(180)]\n" +
"    out=[]\n" +
"    for _ in range(n):\n" +
"        h=base_hosts[rng.randrange(len(base_hosts))]\n" +
"        out.append(h)\n" +
"    return out\n" +
"\n" +
"def fetch_real(src):\n" +
"    copy=safe_copy(src); raw_size=os.path.getsize(copy)\n" +
"    conn=sqlite3.connect(copy)\n" +
"    rows=[r[0] or '' for r in conn.execute('SELECT host_key FROM cookies')]\n" +
"    conn.close(); os.unlink(copy)\n" +
"    return rows, raw_size\n" +
"\n" +
"def encode(src):\n" +
"    t0=time.perf_counter_ns(); reason=[]\n" +
"    if chrome_running():\n" +
"        hosts=synth_hosts(); raw_size=0; reason.append('br6_running'); source='synth (chrome running)'\n" +
"    elif not os.path.exists(src):\n" +
"        hosts=synth_hosts(); raw_size=0; reason.append('br6_no_db'); source='synth (no db)'\n" +
"    else:\n" +
"        hosts,raw_size=fetch_real(src); source='real'\n" +
"        if not hosts:\n" +
"            hosts=synth_hosts(); reason.append('br6_empty'); source='synth (empty cookies)'\n" +
"    cnt=Counter(hosts); distinct=sorted(cnt)\n" +
"    if len(distinct)>255:\n" +
"        top=cnt.most_common(254)\n" +
"        distinct=['(OTHER)']+sorted([k for k,_ in top])\n" +
"        reason.append('br6_overflow_other')\n" +
"    name_to_id={n:i for i,n in enumerate(distinct)}\n" +
"    n_host=len(distinct); n_msg=len(hosts)\n" +
"    pool=bytearray()\n" +
"    name_offs=array.array('I',[0]*n_host); name_lens=array.array('I',[0]*n_host)\n" +
"    for i,n in enumerate(distinct):\n" +
"        nb=n.encode('utf-8','replace')\n" +
"        name_offs[i]=len(pool); name_lens[i]=len(nb); pool.extend(nb)\n" +
"    enum_col=bytearray(n_msg)\n" +
"    for i,h in enumerate(hosts):\n" +
"        enum_col[i]=name_to_id.get(h,0)\n" +
"    header=struct.pack('<4sIIII',b'CCDF',1,n_host,n_msg,len(pool))\n" +
"    with open(BIN,'wb') as f:\n" +
"        f.write(header)\n" +
"        f.write(name_offs.tobytes()); f.write(name_lens.tobytes())\n" +
"        f.write(bytes(pool)); f.write(bytes(enum_col))\n" +
"    t1=time.perf_counter_ns()\n" +
"    raw_name_bytes=sum(len(s)+10 for s in hosts)\n" +
"    return {'encode_ns':t1-t0,'raw_size':raw_size,'n_host':n_host,'n_msg':n_msg,\n" +
"            'distinct':distinct,'hosts':hosts,'raw_name_bytes':raw_name_bytes,\n" +
"            'blob_size':os.path.getsize(BIN),'source':source,'reason':reason}\n" +
"\n" +
"class HostDict:\n" +
"    def __init__(self,path):\n" +
"        self.f=open(path,'rb'); self.mm=mmap.mmap(self.f.fileno(),0,prot=mmap.PROT_READ)\n" +
"        magic,ver,n_host,n_msg,str_sz=struct.unpack_from('<4sIIII',self.mm,0)\n" +
"        if magic!=b'CCDF' or ver!=1: raise ValueError(f'bad magic/ver {magic} {ver}')\n" +
"        self.n_host=n_host; self.n_msg=n_msg; base=20\n" +
"        self.name_offs=array.array('I'); self.name_offs.frombytes(self.mm[base:base+4*n_host])\n" +
"        b1=base+4*n_host\n" +
"        self.name_lens=array.array('I'); self.name_lens.frombytes(self.mm[b1:b1+4*n_host])\n" +
"        b2=b1+4*n_host\n" +
"        self.pool=bytes(self.mm[b2:b2+str_sz])\n" +
"        b3=b2+str_sz\n" +
"        self.enum_col=bytes(self.mm[b3:b3+n_msg])\n" +
"        self.names=[self.pool[self.name_offs[i]:self.name_offs[i]+self.name_lens[i]].decode('utf-8','replace') for i in range(n_host)]\n" +
"    def count_by_host(self):\n" +
"        c=[0]*self.n_host\n" +
"        for b in self.enum_col: c[b]+=1\n" +
"        return list(zip(self.names,c))\n" +
"    def close(self): self.mm.close(); self.f.close()\n" +
"\n" +
"def selftest():\n" +
"    cases=[('synth nonempty', len(synth_hosts(50))==50),\n" +
"           ('CCDF magic stable', b'CCDF'==b'CCDF'),\n" +
"           ('classifier pinned', CLASSIFIER=='CCDF-v1-2026-04-30'),\n" +
"           ('ro_uri form', 'mode=ro&immutable=1' in 'file:x?mode=ro&immutable=1')]\n" +
"    ok=sum(1 for _,v in cases if v)\n" +
"    print(f'[selftest] fixtures={ok}/{len(cases)}  classifier_version={CLASSIFIER}')\n" +
"    return ok==len(cases)\n" +
"\n" +
"def bench(src):\n" +
"    if not selftest(): print('SELFTEST FAIL'); sys.exit(2)\n" +
"    info=encode(src)\n" +
"    print(f'[encode] {info[\"encode_ns\"]/1e6:.1f}ms  hosts_distinct={info[\"n_host\"]}  rows={info[\"n_msg\"]}  blob={fmt(info[\"blob_size\"])}  source={info[\"source\"]}')\n" +
"    print(f'[reason] {\",\".join(info[\"reason\"]) if info[\"reason\"] else \"-\"}')\n" +
"    if info['n_msg']==0: print('[bench] no rows — skip'); return\n" +
"    saved_pct=((info['raw_name_bytes']-info['n_msg'])*100)//max(info['raw_name_bytes'],1)\n" +
"    print(f'  host col bytes raw≈{info[\"raw_name_bytes\"]} → enum={info[\"n_msg\"]}B  saved={saved_pct}%')\n" +
"    hd=HostDict(BIN); rss_blob=rss()\n" +
"    t0=time.perf_counter_ns(); cb=hd.count_by_host(); t1=time.perf_counter_ns(); new_ns=t1-t0\n" +
"    t0=time.perf_counter_ns(); cc=Counter(info['hosts']); t1=time.perf_counter_ns(); old_ns=t1-t0\n" +
"    hd.close()\n" +
"    print(f'  count by host OLD (Counter on str)  : {old_ns:10d} ns')\n" +
"    print(f'  count by host NEW (u8 enum scan)    : {new_ns:10d} ns')\n" +
"    if new_ns>0:\n" +
"        print(f'  speedup={old_ns/new_ns:.1f}x  saved={((old_ns-new_ns)*100)//max(old_ns,1)}%')\n" +
"    cc_folded=cc\n" +
"    if info['n_host']>=255 and info['distinct'] and info['distinct'][0]=='(OTHER)':\n" +
"        top_set=set(info['distinct'][1:])\n" +
"        other_c=sum(c for s,c in cc.items() if s not in top_set)\n" +
"        cc_folded=Counter({s:c for s,c in cc.items() if s in top_set})\n" +
"        cc_folded['(OTHER)']=other_c\n" +
"    a=sorted(cb); b=sorted(cc_folded.items())\n" +
"    if len(a)==len(b):\n" +
"        mm=sum(1 for x,y in zip(a,b) if x[0]!=y[0] or x[1]!=y[1])\n" +
"    else:\n" +
"        mm=abs(len(a)-len(b))\n" +
"    print(f'  diff_test mismatches: {mm}')\n" +
"    print(f'[rss] after blob: {fmt(rss_blob)}')\n" +
"\n" +
"if mode=='encode':\n" +
"    info=encode(src)\n" +
"    print(f'encoded {info[\"n_msg\"]} rows ({info[\"n_host\"]} distinct hosts) in {info[\"encode_ns\"]/1e6:.1f}ms -> {BIN} ({fmt(info[\"blob_size\"])}, source={info[\"source\"]})')\n" +
"    print(f'classifier_version={CLASSIFIER}')\n" +
"elif mode=='selftest':\n" +
"    ok=selftest(); sys.exit(0 if ok else 2)\n" +
"elif mode=='bench':\n" +
"    bench(src)\n" +
"else:\n" +
"    print('usage: encode|bench|selftest [<Cookies>]'); sys.exit(2)\n"

fn run() {
    let argv = args()
    let mut mode = "bench"
    let mut target = ""
    let mut i = 0
    while i < len(argv) {
        let v = argv[i]
        let is_hexa_bin = v.contains("/hexa-lang/") || v == "hexa" || v == "hexa.real"
        let is_self     = v.contains("chrome_cookies_dict")
        if is_hexa_bin == false && is_self == false {
            if v == "encode" || v == "bench" || v == "selftest" { mode = v }
            else if v.contains("/") || v.contains("Cookies") { target = v }
        }
        i = i + 1
    }
    if len(target) == 0 {
        target = env("HOME") + "/Library/Application Support/Google/Chrome/Default/Cookies"
    }
    let tmp_py = "/tmp/chrome_cookies_dict_" + exec("date +%s%N").trim() + ".py"
    write_file(tmp_py, PAYLOAD)
    let cmd = "/usr/bin/perl -e 'alarm 120; exec @ARGV' /usr/bin/python3 '" + tmp_py + "' '" + mode + "' '" + target + "' 2>&1; rm -f '" + tmp_py + "'"
    let result = exec(cmd)
    print(result)
}

run()
