// filters/module/data/claude_project_root_mmap.hexa
// C4 — Claude project root (cwd → git toplevel) mmap blob filter.
//
// 역할:
//   Claude CLI / statusline 매 cycle 마다 `git rev-parse --show-toplevel` 을
//   fork — repo 진입 + .git 탐색 비용. 평균 4-8ms/call (cold) / 1-3ms (warm).
//   세션이 동일 cwd 트리에 머무르는 시간이 길고 root 가 변하지 않는 점을
//   이용해, 알려진 cwd prefix → root 매핑을 prefix-trie blob 으로 mmap.
//
// 패턴 ref:
//   - catalog #12 trie / radix (autocomplete_trie_mmap, prefix_trie_mmap)
//   - bisect (sorted strings) + 대안: prefix-trie 누적 cp/suffix 복원
//
// blob layout (little-endian):
//   magic   : 4B  "CPRT"          (Claude Project Root Trie)
//   version : 4B  u32             (1)
//   n       : 4B  u32             cwd 개수
//   pool_sz : 4B  u32             string pool 바이트 길이
//   [n*4]   : u32 cwd_offsets     pool 내 cwd 오프셋 (sorted)
//   [n*4]   : u32 cwd_lens
//   [n*4]   : u32 root_offsets    pool 내 root 오프셋
//   [n*4]   : u32 root_lens
//   [pool_sz]: utf-8 string pool  cwd || root raw bytes
//
// 모드:
//   build   : seed cwds → /tmp/claude_project_root.bin
//   bench   : per-call exec("git rev-parse --show-toplevel") vs blob lookup (200 query)
//   query   : <cwd> → root (lookup demo)
//
// R1 HEXA-FIRST: 인라인 python3 PAYLOAD (.py 신규 0).
// R17: /usr/bin/perl alarm 120s wrapper.

let PAYLOAD = "import sys,os,struct,time,bisect,resource,mmap,array,subprocess,random,tempfile\n" +
"mode=sys.argv[1]; src=sys.argv[2] if len(sys.argv)>2 else 'synthetic'\n" +
"def fmt(b):\n" +
"    if b>1048576: return f'{b/1048576:.2f}MB'\n" +
"    if b>1024: return f'{b/1024:.1f}KB'\n" +
"    return f'{b}B'\n" +
"def rss():\n" +
"    r=resource.getrusage(resource.RUSAGE_SELF).ru_maxrss\n" +
"    if sys.platform=='darwin': return r\n" +
"    return r*1024\n" +
"\n" +
"BIN='/tmp/claude_project_root.bin'\n" +
"\n" +
"def discover_cwds():\n" +
"    # Claude project session 은 ~/.claude*/projects/<encoded-cwd>/*.jsonl 형태.\n" +
"    # encoded-cwd: '/' → '-'. 디렉토리명에서 cwd 복원 + git rev-parse 1회 실행 → seed.\n" +
"    bases=[]\n" +
"    home=os.path.expanduser('~')\n" +
"    for d in sorted(os.listdir(home)):\n" +
"        if d.startswith('.claude'):\n" +
"            p=os.path.join(home,d,'projects')\n" +
"            if os.path.isdir(p): bases.append(p)\n" +
"    rows=[]\n" +
"    seen=set()\n" +
"    for base in bases:\n" +
"        for nm in os.listdir(base):\n" +
"            if not nm.startswith('-'): continue\n" +
"            cwd='/'+nm[1:].replace('-','/')\n" +
"            if cwd in seen: continue\n" +
"            seen.add(cwd)\n" +
"            if not os.path.isdir(cwd): continue\n" +
"            try:\n" +
"                r=subprocess.run(['git','-C',cwd,'rev-parse','--show-toplevel'],capture_output=True,timeout=3)\n" +
"                if r.returncode!=0: continue\n" +
"                root=r.stdout.decode().strip()\n" +
"                if root: rows.append((cwd,root))\n" +
"            except Exception: pass\n" +
"    return rows\n" +
"\n" +
"def synth(n=64,seed=11):\n" +
"    rng=random.Random(seed)\n" +
"    out=[]\n" +
"    roots=['/Users/ghost/core/airgenome','/Users/ghost/core/hexa-lang','/Users/ghost/core/hive','/Users/ghost/core/airgenome/state','/Users/ghost/Dev/sample','/private/tmp']\n" +
"    for i in range(n):\n" +
"        rt=roots[i%len(roots)]\n" +
"        depth=rng.choice([0,1,1,2,3])\n" +
"        if depth==0: cwd=rt\n" +
"        else:\n" +
"            seg='/'.join(['s'+str(rng.randrange(20)) for _ in range(depth)])\n" +
"            cwd=rt+'/'+seg\n" +
"        out.append((cwd,rt))\n" +
"    return out\n" +
"\n" +
"def encode(rows):\n" +
"    rows=sorted(set(rows),key=lambda r:r[0])\n" +
"    n=len(rows)\n" +
"    pool=bytearray()\n" +
"    cwd_off=array.array('I',[0]*n); cwd_len=array.array('I',[0]*n)\n" +
"    rt_off =array.array('I',[0]*n); rt_len =array.array('I',[0]*n)\n" +
"    for i,(c,r) in enumerate(rows):\n" +
"        cb=c.encode('utf-8','replace'); rb=r.encode('utf-8','replace')\n" +
"        cwd_off[i]=len(pool); cwd_len[i]=len(cb); pool.extend(cb)\n" +
"        rt_off[i] =len(pool); rt_len[i] =len(rb); pool.extend(rb)\n" +
"    header=struct.pack('<4sIII',b'CPRT',1,n,len(pool))\n" +
"    with open(BIN,'wb') as f:\n" +
"        f.write(header)\n" +
"        f.write(cwd_off.tobytes()); f.write(cwd_len.tobytes())\n" +
"        f.write(rt_off.tobytes());  f.write(rt_len.tobytes())\n" +
"        f.write(pool)\n" +
"    return BIN,len(pool),n\n" +
"\n" +
"class Blob:\n" +
"    def __init__(self,path):\n" +
"        self.f=open(path,'rb')\n" +
"        self.mm=mmap.mmap(self.f.fileno(),0,prot=mmap.PROT_READ)\n" +
"        magic,ver,n,pool_sz=struct.unpack_from('<4sIII',self.mm,0)\n" +
"        if magic!=b'CPRT' or ver!=1: raise ValueError('bad magic/ver')\n" +
"        self.n=n; self.pool_sz=pool_sz\n" +
"        base=16\n" +
"        co=base; cl=base+4*n; ro=base+8*n; rl=base+12*n; po=base+16*n\n" +
"        mv=memoryview(self.mm)\n" +
"        cwd_off=array.array('I'); cwd_off.frombytes(bytes(mv[co:co+4*n]))\n" +
"        cwd_len=array.array('I'); cwd_len.frombytes(bytes(mv[cl:cl+4*n]))\n" +
"        rt_off =array.array('I'); rt_off.frombytes(bytes(mv[ro:ro+4*n]))\n" +
"        rt_len =array.array('I'); rt_len.frombytes(bytes(mv[rl:rl+4*n]))\n" +
"        pool=bytes(mv[po:po+pool_sz])\n" +
"        self.cwds =[pool[cwd_off[i]:cwd_off[i]+cwd_len[i]] for i in range(n)]\n" +
"        self.roots=[pool[rt_off[i]:rt_off[i]+rt_len[i]] for i in range(n)]\n" +
"        self.mv=mv\n" +
"    def lookup(self,cwd):\n" +
"        # prefix match: largest cwd entry that is a prefix of <cwd>.\n" +
"        # bisect_right(cwds,cwd_bytes) → 후보 idx-1; backtrack to find longest prefix.\n" +
"        cb=cwd.encode('utf-8','replace') if isinstance(cwd,str) else cwd\n" +
"        i=bisect.bisect_right(self.cwds,cb)-1\n" +
"        # walk back while not prefix\n" +
"        while i>=0:\n" +
"            c=self.cwds[i]\n" +
"            if cb.startswith(c) and (len(cb)==len(c) or cb[len(c):len(c)+1]==b'/'):\n" +
"                return self.roots[i].decode('utf-8','replace')\n" +
"            i-=1\n" +
"        return None\n" +
"    def close(self):\n" +
"        try: self.mv.release()\n" +
"        except Exception: pass\n" +
"        self.mm.close(); self.f.close()\n" +
"\n" +
"def make_queries(rows,n=200,seed=3):\n" +
"    rng=random.Random(seed); out=[]\n" +
"    if not rows: return out\n" +
"    for _ in range(n):\n" +
"        cwd,root=rows[rng.randrange(len(rows))]\n" +
"        # 50% root 그대로, 50% 임의 sub-path 추가\n" +
"        if rng.random()<0.5:\n" +
"            out.append(cwd)\n" +
"        else:\n" +
"            sub='/'.join(['s'+str(rng.randrange(50)) for _ in range(rng.randrange(1,4))])\n" +
"            out.append(cwd.rstrip('/')+'/'+sub)\n" +
"    return out\n" +
"\n" +
"def bench(src):\n" +
"    if src=='synthetic':\n" +
"        rows=synth(64)\n" +
"    else:\n" +
"        rows=discover_cwds()\n" +
"        if len(rows)<4:\n" +
"            print(f'discovered {len(rows)} real cwds — adding synthetic seeds')\n" +
"            rows=rows+synth(32)\n" +
"    if not rows:\n" +
"        print('ERROR: 0 rows'); sys.exit(1)\n" +
"    bin_path,pool_sz,n=encode(rows)\n" +
"    print(f'[encode] n={n}  pool={fmt(pool_sz)}  blob={fmt(os.path.getsize(bin_path))}')\n" +
"    b=Blob(bin_path)\n" +
"    qs=make_queries(rows,200)\n" +
"    rss_loaded=rss()\n" +
"    # warmup\n" +
"    for q in qs[:5]: b.lookup(q)\n" +
"    # 1) per-call git rev-parse fork — 가장 비싼 baseline.\n" +
"    # 진짜 git fork 200 회는 너무 비쌈 — 50 회만 실측, per-query 환산.\n" +
"    GIT_N=min(50,len(qs))\n" +
"    t0=time.perf_counter(); h_g=0; mismatches=0\n" +
"    for q in qs[:GIT_N]:\n" +
"        # 실제 디렉토리만 git fork; 합성 cwd 는 dirname 추적해서 존재하는 부모로\n" +
"        cwd=q\n" +
"        while cwd and not os.path.isdir(cwd) and len(cwd)>1:\n" +
"            cwd=os.path.dirname(cwd)\n" +
"        try:\n" +
"            r=subprocess.run(['git','-C',cwd,'rev-parse','--show-toplevel'],capture_output=True,timeout=2)\n" +
"            root=r.stdout.decode().strip() if r.returncode==0 else None\n" +
"        except Exception: root=None\n" +
"        if root: h_g+=1\n" +
"    t1=time.perf_counter(); git_us=(t1-t0)*1e6/max(GIT_N,1)\n" +
"    # 2) blob lookup\n" +
"    t2=time.perf_counter(); h_b=0\n" +
"    for q in qs:\n" +
"        r=b.lookup(q)\n" +
"        if r: h_b+=1\n" +
"    t3=time.perf_counter(); blob_us=(t3-t2)*1e6/len(qs)\n" +
"    b.close()\n" +
"    print(f'[query] git_n={GIT_N} blob_n={len(qs)}  hits git={h_g} blob={h_b}')\n" +
"    print(f'  git rev-parse fork : {git_us :12.1f} us/query')\n" +
"    print(f'  blob bisect lookup : {blob_us:12.1f} us/query')\n" +
"    if blob_us>0: print(f'  speedup git→blob   : {git_us/blob_us:8.1f}x')\n" +
"    if git_us>0:  print(f'  saved %            : {(git_us-blob_us)*100/git_us:8.1f}%')\n" +
"    print(f'[rss] after blob loaded: {fmt(rss_loaded)}')\n" +
"\n" +
"def query_one(cwd):\n" +
"    if not os.path.exists(BIN):\n" +
"        rows=discover_cwds() or synth(64)\n" +
"        encode(rows)\n" +
"    b=Blob(BIN); r=b.lookup(cwd); b.close()\n" +
"    print(f'cwd={cwd}\\nroot={r}')\n" +
"\n" +
"def build():\n" +
"    rows=discover_cwds()\n" +
"    if not rows:\n" +
"        print('no cwds discovered — using synthetic seeds')\n" +
"        rows=synth(64)\n" +
"    bin_path,pool_sz,n=encode(rows)\n" +
"    print(f'built {bin_path}  n={n}  pool={fmt(pool_sz)}  blob={fmt(os.path.getsize(bin_path))}')\n" +
"\n" +
"if mode=='build':\n" +
"    build()\n" +
"elif mode=='bench':\n" +
"    bench(src)\n" +
"elif mode=='query':\n" +
"    query_one(src)\n" +
"else:\n" +
"    print('usage: build|bench|query <cwd|synthetic|->'); sys.exit(2)\n"

fn run() {
    let argv = args()
    let mut mode = "bench"
    let mut target = "synthetic"
    let mut i = 0
    while i < len(argv) {
        let v = argv[i]
        let is_hexa_bin = v.contains("/hexa-lang/") || v == "hexa" || v == "hexa.real"
        let is_self     = v.contains("claude_project_root_mmap")
        if is_hexa_bin == false && is_self == false {
            if v == "build" || v == "bench" || v == "query" { mode = v }
            else if v == "-" || v == "synthetic" { target = v }
            else if v.contains("/") { target = v }
        }
        i = i + 1
    }
    let tmp_py = "/tmp/claude_project_root_mmap_" + exec("date +%s%N").trim() + ".py"
    write_file(tmp_py, PAYLOAD)
    let cmd = "/usr/bin/perl -e 'alarm 120; exec @ARGV' /usr/bin/python3 '" + tmp_py + "' '" + mode + "' '" + target + "' 2>&1; rm -f '" + tmp_py + "'"
    let result = exec(cmd)
    print(result)
}

run()
