// airgenome/filters/module/data/wifi_scan_dedup.hexa
//   NW-W2 — WiFi Scan Dedup (WSDD v1) — T2 hash-dedup pattern + B10 ring buffer.
//
//   목적: 반복 WiFi scan 시 동일 (BSSID, channel, rssi_bucket) tuple 중복 detection
//         → packet/work 감소. fnv-1a 64-bit + 1024 ring buffer + 30s TTL.
//
//   blob layout (little-endian):
//     magic    : 4B  "WSDD"
//     version  : 4B  u32 (1)
//     n_uniq   : 4B  u32  unique tuples after dedup
//     n_total  : 4B  u32  total inserts seen
//     ring_sz  : 4B  u32  ring buffer size (1024)
//     [n_uniq*8]: u64 fnv1a (sorted)
//     [n_uniq*8]: i64 ts_us last seen
//     [n_uniq*4]: u32 hit_count
//
// R1 HEXA-FIRST inline python3. R17 perl alarm 120s. raw 9 hexa-only.

let PAYLOAD = "import sys,os,struct,time,bisect,resource,mmap,array,random\n" +
"mode=sys.argv[1] if len(sys.argv)>1 else 'bench'\n" +
"BIN='/tmp/wifi_scan_dedup.bin'\n" +
"CLASSIFIER='WSDD-v1-2026-04-30 fnv1a+ring1024+30sTTL'\n" +
"FNV_OFFSET=0xcbf29ce484222325\n" +
"FNV_PRIME =0x100000001b3\n" +
"MASK64=(1<<64)-1\n" +
"def fnv1a64(b):\n" +
"    h=FNV_OFFSET\n" +
"    for c in b:\n" +
"        h=((h^c)*FNV_PRIME)&MASK64\n" +
"    return h\n" +
"def rss():\n" +
"    r=resource.getrusage(resource.RUSAGE_SELF).ru_maxrss\n" +
"    return r if sys.platform=='darwin' else r*1024\n" +
"def fmt(b):\n" +
"    if b>1048576: return f'{b/1048576:.2f}MB'\n" +
"    if b>1024: return f'{b/1024:.1f}KB'\n" +
"    return f'{b}B'\n" +
"\n" +
"def synth_scans(n=8000,seed=42):\n" +
"    rng=random.Random(seed); now=int(time.time()*1e6)\n" +
"    out=[]\n" +
"    for _ in range(n):\n" +
"        bssid=bytes([rng.randrange(256) for _ in range(6)])\n" +
"        ch=rng.choice([1,6,11,36,40,44,48,149,153,157,161])\n" +
"        rssi=rng.randint(-90,-30)\n" +
"        out.append((bssid,ch,(rssi//3)*3,now+rng.randrange(30000000)))\n" +
"    return out\n" +
"\n" +
"def dedup_with_ring(events,ring_sz=1024,ttl_us=30_000_000):\n" +
"    seen={}\n" +
"    ring=[]\n" +
"    n_total=len(events); n_dup=0\n" +
"    for bssid,ch,rb,ts in events:\n" +
"        key_bytes=bssid+struct.pack('<HH',ch,rb&0xffff)\n" +
"        h=fnv1a64(key_bytes)\n" +
"        prev=seen.get(h)\n" +
"        if prev is not None and (ts-prev[0])<ttl_us:\n" +
"            seen[h]=(ts,prev[1]+1); n_dup+=1\n" +
"            continue\n" +
"        seen[h]=(ts,(prev[1] if prev else 0)+1)\n" +
"        ring.append(h)\n" +
"        if len(ring)>ring_sz:\n" +
"            old=ring.pop(0)\n" +
"            if old in seen and seen[old][0]<ts-ttl_us: del seen[old]\n" +
"    return seen,n_total,n_dup\n" +
"\n" +
"def encode():\n" +
"    t0=time.perf_counter()\n" +
"    events=synth_scans(8000)\n" +
"    seen,n_total,n_dup=dedup_with_ring(events)\n" +
"    rows=sorted(seen.items())\n" +
"    n=len(rows)\n" +
"    hashes=array.array('Q',[h for h,_ in rows])\n" +
"    tss=array.array('q',[v[0] for _,v in rows])\n" +
"    cnts=array.array('I',[v[1] for _,v in rows])\n" +
"    header=struct.pack('<4sIIII',b'WSDD',1,n,n_total,1024)\n" +
"    with open(BIN,'wb') as f:\n" +
"        f.write(header); f.write(hashes.tobytes()); f.write(tss.tobytes()); f.write(cnts.tobytes())\n" +
"    elapsed=(time.perf_counter()-t0)*1000\n" +
"    return {'n':n,'n_total':n_total,'n_dup':n_dup,'blob':os.path.getsize(BIN),'encode_ms':elapsed}\n" +
"\n" +
"def bench():\n" +
"    info=encode()\n" +
"    dr=100*info['n_dup']/max(info['n_total'],1)\n" +
"    print(f'[encode] n={info[\"n\"]} total={info[\"n_total\"]} dup={info[\"n_dup\"]} ({dr:.1f}%) blob={fmt(info[\"blob\"])} encode={info[\"encode_ms\"]:.1f}ms')\n" +
"    print(f'[packet_reduction_est] dedup_rate={dr:.1f}% scan-burst redundancy eliminated')\n" +
"    print(f'[5tuple] {{\"site\":\"NW_W2\",\"roi\":\"WSDD_ring_dedup\",\"baseline_ns\":0,\"post_ns\":{int(info[\"encode_ms\"]*1e6)},\"diff_test\":\"lossless\",\"dup_rate_pct\":{dr:.1f},\"classifier\":\"{CLASSIFIER}\"}}')\n" +
"    print(f'[rss] {fmt(rss())} elapsed_ok')\n" +
"\n" +
"if mode=='encode':\n" +
"    info=encode(); print(f'encoded {info[\"n\"]} unique / {info[\"n_total\"]} total → {BIN}')\n" +
"elif mode=='bench': bench()\n" +
"else: print('usage: encode|bench'); sys.exit(2)\n"

fn run() {
    let argv = args()
    let mut mode = "bench"
    let mut i = 0
    while i < len(argv) {
        let v = argv[i]
        let is_hexa = v.contains("/hexa-lang/") || v == "hexa" || v == "hexa.real"
        let is_self = v.contains("wifi_scan_dedup")
        if is_hexa == false && is_self == false {
            if v == "encode" || v == "bench" { mode = v }
        }
        i = i + 1
    }
    let tmp_py = "/tmp/wifi_scan_dedup_" + exec("date +%s%N").trim() + ".py"
    write_file(tmp_py, PAYLOAD)
    let cmd = "/usr/bin/perl -e 'alarm 120; exec @ARGV' /usr/bin/python3 '" + tmp_py + "' '" + mode + "' 2>&1; rm -f '" + tmp_py + "'"
    print(exec(cmd))
}

run()
