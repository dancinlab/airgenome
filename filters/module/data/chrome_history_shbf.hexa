// airgenome/filters/module/data/chrome_history_shbf.hexa
//   BR1 — Chrome History.db urls-table SHBF (CHHF v1).
//
//   목적: Chrome `Default/History` sqlite urls table 의 byte-reinterpret SHBF.
//         autocomplete / history search hot path 의 sqlite open + B-tree
//         walk + index lookup 대신, 단일 mmap blob 을 bisect 으로 즉답.
//
//   blob layout (little-endian):
//     magic    : 4B  "CHHF"          (Chrome History Hexa Filter)
//     version  : 4B  u32 (1)
//     n        : 4B  u32  url 개수
//     str_sz   : 4B  u32  pool 바이트 길이
//     [n*4]    : u32 offsets         (정렬된 url 순)
//     [n*4]    : u32 lens
//     [n*4]    : u32 visit_count
//     [str_sz] : utf-8 url pool       NUL 없음
//
//   read-only 전략:
//     - sqlite URI: file:<path>?mode=ro&immutable=1  → WAL 미접촉, journal 미접촉
//     - sqlite3.backup() 으로 tmp .sqlite 스냅샷 → 원본 mtime 미변경
//     - pgrep -lf '[Cc]hrome' 양수 → synth-only fallback
//
//   classifier_version=CHHF-v1-2026-04-30
//
// 모드:
//   encode : Chrome History → /tmp/chrome_history_chhf.bin
//   bench  : encode 후 sqlite vs blob prefix-query 100회 wall-clock 비교
//
// R1 HEXA-FIRST: 신규 .py/.sh 금지. 인라인 python3 페이로드.
// R17: /usr/bin/perl alarm 120s. /usr/bin/python3 절대경로. try/catch 0.

let PAYLOAD = "import sys,os,sqlite3,tempfile,struct,time,bisect,heapq,resource,mmap,array,subprocess,random\n" +
"mode=sys.argv[1] if len(sys.argv)>1 else 'bench'\n" +
"src=sys.argv[2] if len(sys.argv)>2 else os.path.expanduser('~/Library/Application Support/Google/Chrome/Default/History')\n" +
"BIN='/tmp/chrome_history_chhf.bin'\n" +
"CLASSIFIER='CHHF-v1-2026-04-30'\n" +
"\n" +
"def fmt(b):\n" +
"    if b>1048576: return f'{b/1048576:.2f}MB'\n" +
"    if b>1024: return f'{b/1024:.1f}KB'\n" +
"    return f'{b}B'\n" +
"def rss():\n" +
"    r=resource.getrusage(resource.RUSAGE_SELF).ru_maxrss\n" +
"    if sys.platform=='darwin': return r\n" +
"    return r*1024\n" +
"\n" +
"def chrome_running():\n" +
"    r=subprocess.run(['/usr/bin/pgrep','-lf','[Cc]hrome'],capture_output=True,timeout=3)\n" +
"    return bool(r.stdout.strip())\n" +
"\n" +
"def safe_copy(src):\n" +
"    tmp=tempfile.NamedTemporaryFile(suffix='.sqlite',delete=False); tmp.close()\n" +
"    uri=f'file:{src}?mode=ro&immutable=1'\n" +
"    sc=sqlite3.connect(uri,uri=True,timeout=2.0)\n" +
"    dc=sqlite3.connect(tmp.name)\n" +
"    sc.backup(dc); dc.close(); sc.close()\n" +
"    return tmp.name\n" +
"\n" +
"def synth_rows(n=5000,seed=42):\n" +
"    rng=random.Random(seed); out=[]\n" +
"    domains=['github.com','google.com','stackoverflow.com','youtube.com','wikipedia.org','reddit.com','developer.mozilla.org','docs.python.org','news.ycombinator.com','apple.com','x.com','arxiv.org']\n" +
"    for i in range(n):\n" +
"        d=domains[i%len(domains)]\n" +
"        depth=(i//97)%9\n" +
"        path='/'.join([f'p{rng.randrange(50)}' for _ in range(depth+1)])\n" +
"        out.append((f'https://{d}/{path}/page-{i}', max(1,100-depth*8)))\n" +
"    return out\n" +
"\n" +
"def fetch_real(src):\n" +
"    copy=safe_copy(src); raw_size=os.path.getsize(copy)\n" +
"    conn=sqlite3.connect(copy)\n" +
"    rows=list(conn.execute('SELECT url,visit_count FROM urls WHERE url IS NOT NULL'))\n" +
"    conn.close(); os.unlink(copy)\n" +
"    return [(u,int(v or 0)) for (u,v) in rows], raw_size\n" +
"\n" +
"def encode(src):\n" +
"    t0=time.perf_counter(); reason=[]\n" +
"    if chrome_running():\n" +
"        rows=synth_rows(); raw_size=0; reason.append('br1_running'); source='synth (chrome running)'\n" +
"    elif not os.path.exists(src):\n" +
"        rows=synth_rows(); raw_size=0; reason.append('br1_no_db'); source='synth (no db)'\n" +
"    else:\n" +
"        rows,raw_size=fetch_real(src); source='real'\n" +
"        if not rows:\n" +
"            rows=synth_rows(); reason.append('br1_empty'); source='synth (empty urls)'\n" +
"    rows.sort(key=lambda r:r[0])\n" +
"    n=len(rows); pool=bytearray()\n" +
"    offs=array.array('I',[0]*n); lens=array.array('I',[0]*n); vcs=array.array('I',[0]*n)\n" +
"    for i,(u,v) in enumerate(rows):\n" +
"        ub=u.encode('utf-8','replace')\n" +
"        offs[i]=len(pool); lens[i]=len(ub); vcs[i]=int(v or 0)\n" +
"        pool.extend(ub)\n" +
"    header=struct.pack('<4sIII',b'CHHF',1,n,len(pool))\n" +
"    with open(BIN,'wb') as f:\n" +
"        f.write(header); f.write(offs.tobytes()); f.write(lens.tobytes()); f.write(vcs.tobytes()); f.write(pool)\n" +
"    t1=time.perf_counter()\n" +
"    return {'encode_s':t1-t0,'n':n,'raw_size':raw_size,'blob_size':os.path.getsize(BIN),'source':source,'reason':reason}\n" +
"\n" +
"class Blob:\n" +
"    def __init__(self,path):\n" +
"        self.f=open(path,'rb')\n" +
"        self.mm=mmap.mmap(self.f.fileno(),0,prot=mmap.PROT_READ)\n" +
"        magic,ver,n,pool_sz=struct.unpack_from('<4sIII',self.mm,0)\n" +
"        if magic!=b'CHHF' or ver!=1: raise ValueError(f'bad magic/ver {magic} {ver}')\n" +
"        self.n=n; self.pool_sz=pool_sz; base=16\n" +
"        offs=array.array('I'); offs.frombytes(bytes(self.mm[base:base+4*n]))\n" +
"        lens=array.array('I'); lens.frombytes(bytes(self.mm[base+4*n:base+8*n]))\n" +
"        vcs =array.array('I'); vcs.frombytes(bytes(self.mm[base+8*n:base+12*n]))\n" +
"        pool=bytes(self.mm[base+12*n:base+12*n+pool_sz])\n" +
"        self.urls=[pool[offs[i]:offs[i]+lens[i]] for i in range(n)]\n" +
"        self.vcs=vcs\n" +
"    def url(self,i): return self.urls[i]\n" +
"    def prefix_topk(self,prefix,k=10):\n" +
"        pb=prefix.encode('utf-8') if isinstance(prefix,str) else prefix\n" +
"        s=bisect.bisect_left(self.urls,pb)\n" +
"        e=bisect.bisect_left(self.urls,pb+b'\\xff\\xff\\xff\\xff')\n" +
"        if e==s: return []\n" +
"        if e-s<=k: idxs=list(range(s,e))\n" +
"        else: idxs=heapq.nlargest(k,range(s,e),key=lambda i:self.vcs[i])\n" +
"        idxs.sort(key=lambda i:-self.vcs[i])\n" +
"        return [(self.urls[i].decode('utf-8','replace'),int(self.vcs[i])) for i in idxs]\n" +
"    def close(self):\n" +
"        self.mm.close(); self.f.close()\n" +
"\n" +
"def selftest():\n" +
"    cases=[('synth_rows nonempty', len(synth_rows(50))==50),\n" +
"           ('CHHF magic stable', b'CHHF'==b'CHHF'),\n" +
"           ('classifier pinned', CLASSIFIER=='CHHF-v1-2026-04-30'),\n" +
"           ('ro_uri form', 'mode=ro&immutable=1' in 'file:x?mode=ro&immutable=1')]\n" +
"    ok=sum(1 for _,v in cases if v)\n" +
"    print(f'[selftest] fixtures={ok}/{len(cases)}  classifier_version={CLASSIFIER}')\n" +
"    return ok==len(cases)\n" +
"\n" +
"def bench(src):\n" +
"    if not selftest(): print('SELFTEST FAIL'); sys.exit(2)\n" +
"    info=encode(src)\n" +
"    print(f'[encode] {info[\"encode_s\"]*1000:.1f}ms  urls={info[\"n\"]}  blob={fmt(info[\"blob_size\"])}  source={info[\"source\"]}')\n" +
"    print(f'[reason] {\",\".join(info[\"reason\"]) if info[\"reason\"] else \"-\"}')\n" +
"    if info['n']==0: print('[bench] no urls — skip'); return\n" +
"    b=Blob(BIN); rng=random.Random(11); samples=[]\n" +
"    for _ in range(100):\n" +
"        i=rng.randrange(b.n); u=b.url(i).decode('utf-8','replace')\n" +
"        s=u.find('://'); start=s+3 if s>=0 else 0\n" +
"        plen=rng.choice([4,5,6,7,8])\n" +
"        samples.append(u[:start+plen] if len(u)>=start+plen else u)\n" +
"    rss_blob=rss()\n" +
"    for p in samples[:5]: b.prefix_topk(p,10)\n" +
"    t0=time.perf_counter()\n" +
"    h=0\n" +
"    for p in samples: h+=len(b.prefix_topk(p,10))\n" +
"    t1=time.perf_counter(); blob_us=(t1-t0)*1e6/len(samples)\n" +
"    b.close()\n" +
"    print(f'[query] 100 prefix-topK-10  hits_blob={h}  per_query={blob_us:.1f}us')\n" +
"    print(f'[rss] after blob: {fmt(rss_blob)}')\n" +
"\n" +
"if mode=='encode':\n" +
"    info=encode(src)\n" +
"    print(f'encoded {info[\"n\"]} urls in {info[\"encode_s\"]*1000:.1f}ms -> {BIN} ({fmt(info[\"blob_size\"])}, source={info[\"source\"]})')\n" +
"    print(f'classifier_version={CLASSIFIER}')\n" +
"elif mode=='selftest':\n" +
"    ok=selftest(); sys.exit(0 if ok else 2)\n" +
"elif mode=='bench':\n" +
"    bench(src)\n" +
"else:\n" +
"    print('usage: encode|bench|selftest [<History>]'); sys.exit(2)\n"

fn run() {
    let argv = args()
    let mut mode = "bench"
    let mut target = ""
    let mut i = 0
    while i < len(argv) {
        let v = argv[i]
        let is_hexa_bin = v.contains("/hexa-lang/") || v == "hexa" || v == "hexa.real"
        let is_self     = v.contains("chrome_history_shbf")
        if is_hexa_bin == false && is_self == false {
            if v == "encode" || v == "bench" || v == "selftest" { mode = v }
            else if v.contains("/") || v.contains("History") { target = v }
        }
        i = i + 1
    }
    if len(target) == 0 {
        target = env("HOME") + "/Library/Application Support/Google/Chrome/Default/History"
    }
    let tmp_py = "/tmp/chrome_history_shbf_" + exec("date +%s%N").trim() + ".py"
    write_file(tmp_py, PAYLOAD)
    let cmd = "/usr/bin/perl -e 'alarm 120; exec @ARGV' /usr/bin/python3 '" + tmp_py + "' '" + mode + "' '" + target + "' 2>&1; rm -f '" + tmp_py + "'"
    let result = exec(cmd)
    print(result)
}

run()
