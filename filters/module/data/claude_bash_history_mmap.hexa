// airgenome/filters/module/data/claude_bash_history_mmap.hexa
//   C14 — Claude Code Bash command history mmap blob (Type E, F58 APBF 변종).
//
//   배경:
//     ~/.claude/projects/**/*.jsonl 안 tool_use=Bash command + cwd 추출 → recent N
//     command 정렬 mmap blob. 후속 prompt 의 prefix lookup ("git " / "ls " / "cd ")
//     이 매번 grep -h '"name":"Bash"' jsonl 전체 스캔 → APBF blob bisect lookup 으로
//     교체.
//
//   blob layout (CBHF — Claude Bash History Filter):
//     magic   : 4B  "CBHF"
//     version : 4B  u32  (1)
//     n       : 4B  u32  command 개수
//     pool_sz : 4B  u32  string pool 바이트
//     [n*4]   : u32 cmd_off  (sorted)
//     [n*4]   : u32 cmd_len
//     [n*4]   : u32 cwd_off
//     [n*4]   : u32 cwd_len
//     [n*4]   : u32 ts_unix  (정렬 키 부)
//     [pool]  : utf-8 string pool
//
//   query: bisect_left(cmd, prefix) 두 번 → range. range 내 ts 기준 top-K.
//
//   모드:
//     encode <out.bin>     : ~/.claude/projects/**/*.jsonl 스캔 → Bash command 추출 → blob
//     bench  <prefix>      : 동일 jsonl set 으로 OLD grep-jq vs NEW APBF bisect 비교
//     query  <blob> <pfx>  : 단일 blob lookup
//
// R1 HEXA-FIRST: 인라인 python3 payload. R17: /usr/bin/perl alarm 120s. try/catch 0.

let PAYLOAD = "import sys,os,struct,time,bisect,glob,json,array,mmap\n" +
"mode=sys.argv[1] if len(sys.argv)>1 else 'encode'\n" +
"arg2=sys.argv[2] if len(sys.argv)>2 else ''\n" +
"arg3=sys.argv[3] if len(sys.argv)>3 else ''\n" +
"HOME=os.path.expanduser('~')\n" +
"PROJ=os.path.join(HOME,'.claude','projects')\n" +
"DEFAULT_BLOB='/tmp/claude_bash_history_cbhf.bin'\n" +
"def fmt(b):\n" +
"    if b>1048576: return f'{b/1048576:.2f}MB'\n" +
"    if b>1024: return f'{b/1024:.1f}KB'\n" +
"    return f'{b}B'\n" +
"def find_jsonl(maxn=200):\n" +
"    if not os.path.isdir(PROJ): return []\n" +
"    paths=glob.glob(os.path.join(PROJ,'**','*.jsonl'),recursive=True)\n" +
"    paths.sort(key=lambda p:os.path.getmtime(p),reverse=True)\n" +
"    return paths[:maxn]\n" +
"def extract_bash(paths,maxrec=20000):\n" +
"    out=[]\n" +
"    for p in paths:\n" +
"        if len(out)>=maxrec: break\n" +
"        f=open(p,'rb')\n" +
"        for ln in f:\n" +
"            if b'\"Bash\"' not in ln: continue\n" +
"            o=None\n" +
"            try: o=json.loads(ln)\n" +
"            except Exception: continue\n" +
"            cwd=o.get('cwd','') or ''\n" +
"            ts=o.get('timestamp') or ''\n" +
"            ts_unix=0\n" +
"            if ts:\n" +
"                try:\n" +
"                    import datetime\n" +
"                    ts_unix=int(datetime.datetime.fromisoformat(ts.replace('Z','+00:00')).timestamp())\n" +
"                except Exception: ts_unix=0\n" +
"            msg=o.get('message') or {}\n" +
"            content=msg.get('content') if isinstance(msg,dict) else None\n" +
"            if not isinstance(content,list): \n" +
"                f.close() if False else None\n" +
"                continue\n" +
"            for c in content:\n" +
"                if isinstance(c,dict) and c.get('type')=='tool_use' and c.get('name')=='Bash':\n" +
"                    inp=c.get('input') or {}\n" +
"                    cmd=inp.get('command','') if isinstance(inp,dict) else ''\n" +
"                    if cmd:\n" +
"                        out.append((cmd,cwd,ts_unix))\n" +
"                        if len(out)>=maxrec: break\n" +
"        f.close()\n" +
"    return out\n" +
"def encode_blob(rows,out_path):\n" +
"    rows=sorted(rows,key=lambda r:r[0])\n" +
"    n=len(rows)\n" +
"    pool=bytearray()\n" +
"    cmd_off=array.array('I',[0]*n)\n" +
"    cmd_len=array.array('I',[0]*n)\n" +
"    cwd_off=array.array('I',[0]*n)\n" +
"    cwd_len=array.array('I',[0]*n)\n" +
"    ts_arr =array.array('I',[0]*n)\n" +
"    for i,(cmd,cwd,ts) in enumerate(rows):\n" +
"        cb=cmd.encode('utf-8','replace'); wb=cwd.encode('utf-8','replace')\n" +
"        cmd_off[i]=len(pool); cmd_len[i]=len(cb); pool.extend(cb)\n" +
"        cwd_off[i]=len(pool); cwd_len[i]=len(wb); pool.extend(wb)\n" +
"        ts_arr[i]=ts&0xffffffff\n" +
"    header=struct.pack('<4sIII',b'CBHF',1,n,len(pool))\n" +
"    with open(out_path,'wb') as f:\n" +
"        f.write(header)\n" +
"        f.write(cmd_off.tobytes()); f.write(cmd_len.tobytes())\n" +
"        f.write(cwd_off.tobytes()); f.write(cwd_len.tobytes())\n" +
"        f.write(ts_arr.tobytes())\n" +
"        f.write(pool)\n" +
"    return os.path.getsize(out_path)\n" +
"class Blob:\n" +
"    def __init__(self,path):\n" +
"        self.f=open(path,'rb')\n" +
"        self.mm=mmap.mmap(self.f.fileno(),0,prot=mmap.PROT_READ)\n" +
"        magic,ver,n,pool_sz=struct.unpack_from('<4sIII',self.mm,0)\n" +
"        if magic!=b'CBHF' or ver!=1: raise ValueError(f'bad: {magic} {ver}')\n" +
"        self.n=n; self.pool_sz=pool_sz\n" +
"        base=16\n" +
"        ax=lambda off,size: array.array('I')\n" +
"        def rd(off,count):\n" +
"            a=array.array('I'); a.frombytes(bytes(memoryview(self.mm)[off:off+4*count])); return a\n" +
"        self.cmd_off=rd(base+0*4*n,n)\n" +
"        self.cmd_len=rd(base+1*4*n,n)\n" +
"        self.cwd_off=rd(base+2*4*n,n)\n" +
"        self.cwd_len=rd(base+3*4*n,n)\n" +
"        self.ts    =rd(base+4*4*n,n)\n" +
"        self.pool_off=base+5*4*n\n" +
"        self.cmds=[bytes(memoryview(self.mm)[self.pool_off+self.cmd_off[i]:self.pool_off+self.cmd_off[i]+self.cmd_len[i]]) for i in range(n)]\n" +
"    def query(self,prefix,k=10):\n" +
"        pb=prefix.encode('utf-8') if isinstance(prefix,str) else prefix\n" +
"        cmds=self.cmds\n" +
"        lo=bisect.bisect_left(cmds,pb)\n" +
"        hi=bisect.bisect_left(cmds,pb+b'\\xff\\xff\\xff\\xff')\n" +
"        if hi==lo: return []\n" +
"        rng=list(range(lo,hi))\n" +
"        rng.sort(key=lambda i:-int(self.ts[i]))\n" +
"        return [(self.cmds[i].decode('utf-8','replace'),int(self.ts[i])) for i in rng[:k]]\n" +
"    def close(self):\n" +
"        self.mm.close(); self.f.close()\n" +
"if mode=='encode':\n" +
"    out=arg2 if arg2 else DEFAULT_BLOB\n" +
"    paths=find_jsonl(200)\n" +
"    print(f'C14 encode — scanning {len(paths)} jsonl from {PROJ}')\n" +
"    if not paths:\n" +
"        # synthetic fallback\n" +
"        rows=[(f'git status -sb {i}',f'/tmp/proj{i%5}',1700000000+i) for i in range(2000)]\n" +
"        rows+= [(f'ls -la dir{i}',f'/tmp/proj{i%5}',1700000000+i) for i in range(500)]\n" +
"        print(f'  no .claude/projects jsonl — using synthetic 2500 rows')\n" +
"    else:\n" +
"        rows=extract_bash(paths)\n" +
"        if not rows:\n" +
"            rows=[(f'echo synth_{i}',f'/tmp/proj{i%5}',1700000000+i) for i in range(2000)]\n" +
"            print(f'  no Bash tool_use found — using synthetic 2000 rows')\n" +
"    sz=encode_blob(rows,out)\n" +
"    print(f'  encoded {len(rows)} commands → {out}  blob={fmt(sz)}')\n" +
"elif mode=='query':\n" +
"    blob=arg2 if arg2 else DEFAULT_BLOB\n" +
"    pfx=arg3 if arg3 else 'git '\n" +
"    if not os.path.exists(blob):\n" +
"        print(f'ERROR: blob not found: {blob} — run encode first'); sys.exit(1)\n" +
"    b=Blob(blob)\n" +
"    res=b.query(pfx,k=10)\n" +
"    print(f'C14 query — blob={blob}  prefix=[{pfx}]  hits={len(res)}')\n" +
"    for cmd,ts in res:\n" +
"        s=cmd[:120]+'...' if len(cmd)>120 else cmd\n" +
"        print(f'  ts={ts}  {s}')\n" +
"    b.close()\n" +
"elif mode=='report':\n" +
"    paths=find_jsonl(200)\n" +
"    rows=extract_bash(paths) if paths else []\n" +
"    print(f'C14 report — {len(paths)} jsonl  {len(rows)} Bash commands extracted')\n" +
"else:\n" +
"    print('usage: encode|query|report [out|blob] [prefix]'); sys.exit(2)\n"

fn run() {
    let argv = args()
    let mut mode = "encode"
    let mut arg2 = ""
    let mut arg3 = ""
    let mut seen = 0
    let mut i = 0
    while i < len(argv) {
        let v = argv[i]
        let is_hexa_bin = v.contains("/hexa-lang/") || v == "hexa" || v == "hexa.real"
        let is_self     = v.contains("claude_bash_history_mmap")
        if is_hexa_bin == false && is_self == false {
            if v == "encode" || v == "query" || v == "report" { mode = v }
            else {
                if seen == 0 { arg2 = v; seen = 1 }
                else if seen == 1 { arg3 = v; seen = 2 }
            }
        }
        i = i + 1
    }
    let tmp_py = "/tmp/claude_bash_history_mmap_" + exec("date +%s%N").trim() + ".py"
    write_file(tmp_py, PAYLOAD)
    let cmd = "/usr/bin/perl -e 'alarm 120; exec @ARGV' /usr/bin/python3 '" + tmp_py + "' '" + mode + "' '" + arg2 + "' '" + arg3 + "' 2>&1; rm -f '" + tmp_py + "'"
    let result = exec(cmd)
    print(result)
}

run()
