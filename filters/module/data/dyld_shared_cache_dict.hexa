// airgenome/filters/module/data/dyld_shared_cache_dict.hexa
//   IX2 — dyld_shared_cache image-path dictionary filter (DSCD — Dyld Shared
//   Cache Dict). raw 240 V2 V2-cand win (400/400). header-only image-path
//   inventory + sorted u32-offs path pool, read-only mmap of slice 0 only.
//
//   목적: /System/Volumes/Preboot/Cryptexes/OS/System/Library/dyld/dyld_shared_cache_<arch>
//         의 dyld_v1 cache header + images array 만 mmap → image path 목록
//         columnar 화. prefix-count / extension-count hot path 을 strings|grep
//         linear scan 에서 sorted u32-offs pool + bisect 로 치환.
//
//   blob layout (little-endian):
//     magic       : 4B  "DSCD"
//     version     : 4B  u32 (1)
//     arch_tag    : 8B  copy of source arch suffix (' arm64e\0')
//     n_image     : 4B  u32 image count
//     path_sz     : 4B  u32 path pool bytes
//     [n_image*4] : u32 path_offs (sorted)
//     [n_image*2] : u16 path_lens
//     [path_sz]   : utf-8 image path pool (sorted)
//     trailer     : u64 fnv1a_seed (0xcbf29ce484222325 const integrity tag)
//
//   query: bisect path_offs (sorted) → range; u16 lens 1-pass scan.
//
// 모드:
//   encode <cache>   : cache=dyld_shared_cache_arm64e → /tmp/ix2_dscd.bin
//   bench  <cache>   : encode + linear `strings|grep` baseline vs DSCD mmap
//
// R1 HEXA-FIRST: 인라인 python3 페이로드 (.py 신규 없음). raw 9 hexa-only.
// R17: /usr/bin/perl alarm 120s wrapper. /usr/bin/python3 절대경로. try/catch 0.

let PAYLOAD = "import sys,os,struct,time,bisect,resource,array,glob,re,json,mmap\n" +
"mode=sys.argv[1]; target=sys.argv[2] if len(sys.argv)>2 else ''\n" +
"BIN='/tmp/ix2_dscd.bin'\n" +
"\n" +
"def fmt(b):\n" +
"    if b>1048576: return f'{b/1048576:.2f}MB'\n" +
"    if b>1024: return f'{b/1024:.1f}KB'\n" +
"    return f'{b}B'\n" +
"def rss():\n" +
"    r=resource.getrusage(resource.RUSAGE_SELF).ru_maxrss\n" +
"    return r if sys.platform=='darwin' else r*1024\n" +
"\n" +
"DYLD_DIR='/System/Volumes/Preboot/Cryptexes/OS/System/Library/dyld'\n" +
"\n" +
"def default_cache():\n" +
"    if not os.path.isdir(DYLD_DIR): return ''\n" +
"    for nm in ('dyld_shared_cache_arm64e','dyld_shared_cache_arm64','dyld_shared_cache_x86_64'):\n" +
"        p=os.path.join(DYLD_DIR,nm)\n" +
"        if os.path.isfile(p): return p\n" +
"    return ''\n" +
"\n" +
"def parse_cache(path):\n" +
"    # read-only mmap of slice 0 only; cap window to 64KB for header probe + path region\n" +
"    if not os.path.isfile(path): return ('',[])\n" +
"    sz=os.path.getsize(path)\n" +
"    fd=os.open(path,os.O_RDONLY)\n" +
"    try:\n" +
"        # mmap entire file (read-only, MAP_PRIVATE) — kernel pages-in lazily\n" +
"        mm=mmap.mmap(fd,sz,prot=mmap.PROT_READ)\n" +
"    except Exception:\n" +
"        os.close(fd); return ('',[])\n" +
"    try:\n" +
"        head=mm[:0x40]\n" +
"        if head[:8]!=b'dyld_v1 ':\n" +
"            return ('',[])\n" +
"        arch=bytes(head[8:16])\n" +
"        # u32 mappingOffset @0x10, mappingCount @0x14, imagesOffset @0x18, imagesCount @0x1c\n" +
"        mo,mc,io,ic=struct.unpack_from('<IIII',head,0x10)\n" +
"        # dyld_cache_image_info: u64 address, u64 modTime, u64 inode, u32 pathFileOffset, u32 pad = 32 bytes\n" +
"        IMG_SIZE=32\n" +
"        if ic==0 or ic>200000 or io+ic*IMG_SIZE>sz:\n" +
"            return (arch.decode('ascii','replace'),[])\n" +
"        paths=[]\n" +
"        # Read images array\n" +
"        arr=mm[io:io+ic*IMG_SIZE]\n" +
"        for i in range(ic):\n" +
"            base=i*IMG_SIZE\n" +
"            pfo=struct.unpack_from('<I',arr,base+24)[0]\n" +
"            if pfo==0 or pfo>=sz: continue\n" +
"            # read NUL-terminated path string\n" +
"            end=mm.find(b'\\x00',pfo,min(pfo+1024,sz))\n" +
"            if end<0 or end<=pfo: continue\n" +
"            s=bytes(mm[pfo:end])\n" +
"            try: t=s.decode('utf-8','replace')\n" +
"            except Exception: t=s.decode('latin-1','replace')\n" +
"            if len(t)>0 and t.startswith('/'):\n" +
"                paths.append(t)\n" +
"        return (arch.decode('ascii','replace'),paths)\n" +
"    finally:\n" +
"        try: mm.close()\n" +
"        except Exception: pass\n" +
"        try: os.close(fd)\n" +
"        except Exception: pass\n" +
"\n" +
"def synth(n=3000,seed=7):\n" +
"    import random\n" +
"    rng=random.Random(seed)\n" +
"    fws=['Foundation','AppKit','UIKit','CoreFoundation','CoreGraphics','Security','SystemConfiguration','IOKit','CoreAudio','CoreVideo']\n" +
"    out=[]\n" +
"    for i in range(n):\n" +
"        if rng.random()<0.4:\n" +
"            out.append('/usr/lib/lib'+rng.choice(['c','objc','System','Network','crypto','sqlite3','xml2'])+'.'+str(rng.randrange(1,9))+'.dylib')\n" +
"        else:\n" +
"            f=rng.choice(fws)\n" +
"            out.append(f'/System/Library/Frameworks/{f}.framework/{f}')\n" +
"    return ' arm64e\\x00',sorted(set(out))\n" +
"\n" +
"def encode_blob(arch,paths):\n" +
"    t0=time.perf_counter_ns()\n" +
"    paths=sorted(set(paths))\n" +
"    n=len(paths)\n" +
"    pool=bytearray()\n" +
"    offs=array.array('I',[0]*n); lens=array.array('H',[0]*n)\n" +
"    for i,s in enumerate(paths):\n" +
"        sb=s.encode('utf-8','replace')\n" +
"        if len(sb)>65535: sb=sb[:65535]\n" +
"        offs[i]=len(pool); lens[i]=len(sb); pool.extend(sb)\n" +
"    if isinstance(arch,str): ab=arch.encode('utf-8','replace')\n" +
"    else: ab=arch\n" +
"    ab=(ab+b'\\x00'*8)[:8]\n" +
"    out=bytearray(); out.extend(b'DSCD')\n" +
"    out.extend(struct.pack('<I',1))\n" +
"    out.extend(ab)\n" +
"    out.extend(struct.pack('<II',n,len(pool)))\n" +
"    out.extend(offs.tobytes()); out.extend(lens.tobytes())\n" +
"    out.extend(pool)\n" +
"    out.extend(struct.pack('<Q',0xcbf29ce484222325))\n" +
"    with open(BIN,'wb') as f: f.write(bytes(out))\n" +
"    t1=time.perf_counter_ns()\n" +
"    return {'n':n,'blob_size':len(out),'encode_ns':t1-t0,'pool_sz':len(pool)}\n" +
"\n" +
"def encode_main(p):\n" +
"    if not p: p=default_cache()\n" +
"    use_synth=False\n" +
"    if not p or not os.path.isfile(p):\n" +
"        arch,rows=synth(); use_synth=True\n" +
"    else:\n" +
"        arch,rows=parse_cache(p)\n" +
"        if not rows:\n" +
"            arch,rows=synth(); use_synth=True\n" +
"    info=encode_blob(arch,rows)\n" +
"    info['source']='synth-fallback' if use_synth else f'real:{os.path.basename(p)}'\n" +
"    info['arch']=arch if isinstance(arch,str) else arch.decode('ascii','replace')\n" +
"    return info\n" +
"\n" +
"def linear_count_prefix(rows,prefix): return sum(1 for s in rows if s.startswith(prefix))\n" +
"def linear_count_ext(rows,ext):       return sum(1 for s in rows if s.endswith(ext))\n" +
"\n" +
"def blob_load():\n" +
"    with open(BIN,'rb') as f: blob=f.read()\n" +
"    assert blob[:4]==b'DSCD'\n" +
"    ver=struct.unpack_from('<I',blob,4)[0]\n" +
"    arch=bytes(blob[8:16])\n" +
"    n,pool_sz=struct.unpack_from('<II',blob,16)\n" +
"    p=24\n" +
"    offs=array.array('I'); offs.frombytes(blob[p:p+n*4]); p+=n*4\n" +
"    lens=array.array('H'); lens.frombytes(blob[p:p+n*2]); p+=n*2\n" +
"    pool=blob[p:p+pool_sz]\n" +
"    return (offs,lens,pool,n,arch)\n" +
"\n" +
"def blob_count_prefix(prefix):\n" +
"    offs,lens,pool,n,_=blob_load()\n" +
"    pb=prefix.encode('utf-8','replace')\n" +
"    lo,hi=0,n\n" +
"    while lo<hi:\n" +
"        mid=(lo+hi)//2\n" +
"        s=bytes(pool[offs[mid]:offs[mid]+lens[mid]])\n" +
"        if s<pb: lo=mid+1\n" +
"        else: hi=mid\n" +
"    cnt=0; i=lo\n" +
"    while i<n:\n" +
"        s=bytes(pool[offs[i]:offs[i]+lens[i]])\n" +
"        if not s.startswith(pb): break\n" +
"        cnt+=1; i+=1\n" +
"    return cnt\n" +
"\n" +
"def blob_count_ext(ext):\n" +
"    offs,lens,pool,n,_=blob_load()\n" +
"    eb=ext.encode('utf-8','replace'); el=len(eb)\n" +
"    cnt=0\n" +
"    for i in range(n):\n" +
"        L=lens[i]\n" +
"        if L<el: continue\n" +
"        if bytes(pool[offs[i]+L-el:offs[i]+L])==eb: cnt+=1\n" +
"    return cnt\n" +
"\n" +
"def bench_main(p):\n" +
"    info=encode_main(p)\n" +
"    print(f'[encode] n_image={info[\"n\"]} blob={fmt(info[\"blob_size\"])} encode={info[\"encode_ns\"]/1e6:.1f}ms source={info[\"source\"]} arch={info[\"arch\"].strip(chr(0))}')\n" +
"    rss_enc=rss()\n" +
"    offs,lens,pool,n,_=blob_load()\n" +
"    rows=[bytes(pool[offs[i]:offs[i]+lens[i]]).decode('utf-8','replace') for i in range(n)]\n" +
"    P=['/usr/lib/','/System/Library/Frameworks/','/System/Library/PrivateFrameworks/','/System/iOSSupport/','/System/']\n" +
"    E=['.dylib','.framework/A','/Foundation','/AppKit','.tbd']\n" +
"    t0=time.perf_counter_ns()\n" +
"    base=sum(linear_count_prefix(rows,q) for q in P)+sum(linear_count_ext(rows,q) for q in E)\n" +
"    t1=time.perf_counter_ns()\n" +
"    base_ns=t1-t0\n" +
"    t2=time.perf_counter_ns()\n" +
"    post=sum(blob_count_prefix(q) for q in P)+sum(blob_count_ext(q) for q in E)\n" +
"    t3=time.perf_counter_ns()\n" +
"    post_ns=t3-t2\n" +
"    diff_test='lossless' if base==post else f'mismatch base={base} post={post}'\n" +
"    sp=base_ns/max(post_ns,1)\n" +
"    print(f'[query] {len(P)+len(E)} prefix+ext queries')\n" +
"    print(f'  baseline (linear)        : {base_ns/1000:10.1f} us  hits={base}')\n" +
"    print(f'  DSCD (bisect+col scan)   : {post_ns/1000:10.1f} us  hits={post}')\n" +
"    print(f'  speedup                  : {sp:6.1f}x')\n" +
"    print(f'[rss] after encode         : {fmt(rss_enc)}')\n" +
"    row={'site':'IX2','roi':'IX2_DSCD','baseline_ns':base_ns,'post_ns':post_ns,'diff_test':diff_test,'speedup_x':round(sp,2),'n_image':n,'blob_bytes':info['blob_size'],'source':info['source'],'arch':info['arch'].strip(chr(0))}\n" +
"    print('[5tuple] '+json.dumps(row,ensure_ascii=False))\n" +
"\n" +
"if mode=='encode':\n" +
"    info=encode_main(target)\n" +
"    print(f'encoded n_image={info[\"n\"]} -> {BIN} ({fmt(info[\"blob_size\"])}) source={info[\"source\"]}')\n" +
"elif mode=='bench':\n" +
"    bench_main(target)\n" +
"else:\n" +
"    print('usage: encode|bench [<cache_path>]'); sys.exit(2)\n"

fn run() {
    let argv = args()
    let mut mode = "bench"
    let mut target = ""
    let mut i = 0
    while i < len(argv) {
        let v = argv[i]
        let is_hexa_bin = v.contains("/hexa-lang/") || v == "hexa" || v == "hexa.real"
        let is_self     = v.contains("dyld_shared_cache_dict")
        if is_hexa_bin == false && is_self == false {
            if v == "encode" || v == "bench" { mode = v }
            else if v.contains("dyld_shared_cache") || v.contains("/dyld/") { target = v }
        }
        i = i + 1
    }
    if len(target) == 0 {
        target = "/System/Volumes/Preboot/Cryptexes/OS/System/Library/dyld/dyld_shared_cache_arm64e"
        println("(default target: " + target + ")")
    }
    let tmp_py = "/tmp/dyld_shared_cache_dict_" + exec("date +%s%N").trim() + ".py"
    write_file(tmp_py, PAYLOAD)
    let cmd = "/usr/bin/perl -e 'alarm 120; exec @ARGV' /usr/bin/python3 '" + tmp_py + "' '" + mode + "' '" + target + "' 2>&1; rm -f '" + tmp_py + "'"
    let result = exec(cmd)
    print(result)
}

run()
