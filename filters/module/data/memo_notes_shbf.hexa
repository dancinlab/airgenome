// airgenome/filters/module/data/memo_notes_shbf.hexa
//   M1 — Apple Notes (memo) NoteStore.sqlite 의 byte-reinterpret SHBF.
//
//   목적: 노트 검색/list autocomplete 가 매번 ZICCLOUDSYNCINGOBJECT 전체를
//         B-tree walk + ZTITLE2 LIKE 'prefix%' 로 훑던 hot path 를, 단일 mmap
//         blob 으로 치환. title 정렬 blob + bisect prefix search.
//
//   blob layout (little-endian):
//     magic    : 4B  "MNBF"          (Memo Notes Blob Filter)
//     version  : 4B  u32             (1)
//     n        : 4B  u32             note 개수
//     str_sz   : 4B  u32             title pool 바이트 길이
//     [n*4]    : u32 offsets         pool 내 title 시작 (정렬된 title 순)
//     [n*4]    : u32 lens            각 title 길이
//     [n*4]    : u32 zpk             ZICCLOUDSYNCINGOBJECT.Z_PK (note id)
//     [n*4]    : u32 mts             modified ts (Mac absolute, u32 캐스팅)
//     [str_sz] : utf-8 string pool   정렬된 title raw bytes (NUL 없음)
//
//   query: bisect_left(titles, prefix) ~ bisect_left(titles, prefix+ff*4) → range,
//          range 안에서 mts(modified) DESC top-K heap.
//
// E4/F18 reference:
//   - F18 SBBF (safari_bookmarks_shbf.hexa) 직접 이식: source 만 sqlite3 read-only
//     URI + ZICCLOUDSYNCINGOBJECT 로 변경. layout magic = "MNBF".
//   - top-K key 는 visit_count 대신 modified ts (최근 수정 우선).
//
// macOS 버전별 path probe:
//   1) ~/Library/Group Containers/group.com.apple.notes/NoteStore.sqlite        (macOS 10.13+)
//   2) ~/Library/Containers/com.apple.Notes/Data/Library/Notes/NoteStore.sqlite (구 path)
//
// TCC: Files & Folders > "Apple Notes" 또는 FDA 미부여 시 file_exists false → graceful skip.
//
// R1 HEXA-FIRST: 인라인 python3 페이로드 (.py 신규 없음).
// R17: /usr/bin/perl alarm 120s wrapper.

let PAYLOAD = "import sys,os,sqlite3,tempfile,struct,time,bisect,heapq,resource,mmap,array\n" +
"mode=sys.argv[1]; src=sys.argv[2]\n" +
"BIN='/tmp/memo_notes_shbf.bin'\n" +
"if not os.path.exists(src):\n" +
"    print('ERROR: not found: '+src); sys.exit(1)\n" +
"\n" +
"def to_int_safe(x):\n" +
"    if x is None: return 0\n" +
"    if isinstance(x,(int,float)): return int(x)&0xffffffff\n" +
"    s=str(x)\n" +
"    if not s: return 0\n" +
"    try: return int(float(s))&0xffffffff\n" +
"    except: return 0\n" +
"\n" +
"def fmt(b):\n" +
"    if b>1048576: return f'{b/1048576:.2f}MB'\n" +
"    if b>1024: return f'{b/1024:.1f}KB'\n" +
"    return f'{b}B'\n" +
"def rss():\n" +
"    r=resource.getrusage(resource.RUSAGE_SELF).ru_maxrss\n" +
"    if sys.platform=='darwin': return r\n" +
"    return r*1024\n" +
"\n" +
"def safe_copy(src):\n" +
"    # NoteStore.sqlite 은 WAL — read-only URI + sqlite backup() 으로 snapshot.\n" +
"    tmp=tempfile.NamedTemporaryFile(suffix='.sqlite',delete=False); tmp.close()\n" +
"    sc=sqlite3.connect(f'file:{src}?mode=ro&immutable=1',uri=True)\n" +
"    dc=sqlite3.connect(tmp.name)\n" +
"    sc.backup(dc); dc.close(); sc.close()\n" +
"    return tmp.name\n" +
"\n" +
"NOTE_QUERY=('SELECT Z_PK, ZTITLE1, ZCREATIONDATE1, ZMODIFICATIONDATE1 '\n" +
"            'FROM ZICCLOUDSYNCINGOBJECT '\n" +
"            'WHERE ZTITLE1 IS NOT NULL AND ZTITLE1 != \"\" '\n" +
"            'AND ZNOTE IS NOT NULL')\n" +
"# fallback for older schemas\n" +
"NOTE_QUERY_FB=('SELECT Z_PK, ZTITLE2, ZCREATIONDATE, ZMODIFICATIONDATE1 '\n" +
"               'FROM ZICCLOUDSYNCINGOBJECT '\n" +
"               'WHERE ZTITLE2 IS NOT NULL AND ZTITLE2 != \"\"')\n" +
"\n" +
"def fetch_rows(conn):\n" +
"    cur=conn.cursor()\n" +
"    rows=[]\n" +
"    for q in (NOTE_QUERY,NOTE_QUERY_FB):\n" +
"        ok=True\n" +
"        try:\n" +
"            cur.execute(q)\n" +
"            for pk,title,cts,mts in cur.fetchall():\n" +
"                if not title: continue\n" +
"                rows.append((str(title),to_int_safe(pk),to_int_safe(cts),to_int_safe(mts)))\n" +
"        except Exception:\n" +
"            ok=False\n" +
"        if ok and rows: break\n" +
"    return rows\n" +
"\n" +
"def encode(src):\n" +
"    t0=time.perf_counter()\n" +
"    copy=safe_copy(src)\n" +
"    raw_size=os.path.getsize(copy)\n" +
"    conn=sqlite3.connect(copy)\n" +
"    rows=fetch_rows(conn)\n" +
"    conn.close(); os.unlink(copy)\n" +
"    rows.sort(key=lambda r:r[0])\n" +
"    n=len(rows)\n" +
"    pool=bytearray()\n" +
"    offs=array.array('I',[0]*n)\n" +
"    lens=array.array('I',[0]*n)\n" +
"    zpks=array.array('I',[0]*n)\n" +
"    mtss=array.array('I',[0]*n)\n" +
"    for i,(t,pk,cts,mts) in enumerate(rows):\n" +
"        tb=t.encode('utf-8','replace')\n" +
"        offs[i]=len(pool); lens[i]=len(tb); zpks[i]=pk; mtss[i]=mts\n" +
"        pool.extend(tb)\n" +
"    header=struct.pack('<4sIII',b'MNBF',1,n,len(pool))\n" +
"    with open(BIN,'wb') as f:\n" +
"        f.write(header)\n" +
"        f.write(offs.tobytes()); f.write(lens.tobytes())\n" +
"        f.write(zpks.tobytes()); f.write(mtss.tobytes())\n" +
"        f.write(pool)\n" +
"    t1=time.perf_counter()\n" +
"    blob_size=os.path.getsize(BIN)\n" +
"    return {'encode_s':t1-t0,'n':n,'raw_size':raw_size,'blob_size':blob_size}\n" +
"\n" +
"class Blob:\n" +
"    def __init__(self,path):\n" +
"        self.f=open(path,'rb')\n" +
"        self.mm=mmap.mmap(self.f.fileno(),0,prot=mmap.PROT_READ)\n" +
"        magic,ver,n,pool_sz=struct.unpack_from('<4sIII',self.mm,0)\n" +
"        assert magic==b'MNBF' and ver==1\n" +
"        self.n=n; self.pool_sz=pool_sz\n" +
"        base=16\n" +
"        self.offs_off=base\n" +
"        self.lens_off=base+4*n\n" +
"        self.zpks_off=base+8*n\n" +
"        self.mtss_off=base+12*n\n" +
"        self.pool_off=base+16*n\n" +
"        self.mv=memoryview(self.mm)\n" +
"        offs=array.array('I'); offs.frombytes(bytes(self.mv[self.offs_off:self.offs_off+4*n]))\n" +
"        lens=array.array('I'); lens.frombytes(bytes(self.mv[self.lens_off:self.lens_off+4*n]))\n" +
"        zpks=array.array('I'); zpks.frombytes(bytes(self.mv[self.zpks_off:self.zpks_off+4*n]))\n" +
"        mtss=array.array('I'); mtss.frombytes(bytes(self.mv[self.mtss_off:self.mtss_off+4*n]))\n" +
"        pool=bytes(self.mv[self.pool_off:self.pool_off+pool_sz])\n" +
"        self.titles=[pool[offs[i]:offs[i]+lens[i]] for i in range(n)]\n" +
"        self.zpks=zpks; self.mtss=mtss\n" +
"    def title(self,i): return self.titles[i]\n" +
"    def prefix_topk(self,prefix,k=10):\n" +
"        pb=prefix.encode('utf-8') if isinstance(prefix,str) else prefix\n" +
"        ts=self.titles\n" +
"        start=bisect.bisect_left(ts,pb)\n" +
"        end=bisect.bisect_left(ts,pb+b'\\xff\\xff\\xff\\xff')\n" +
"        if end==start: return []\n" +
"        if end-start<=k: idxs=list(range(start,end))\n" +
"        else: idxs=heapq.nlargest(k,range(start,end),key=lambda i:self.mtss[i])\n" +
"        idxs.sort(key=lambda i:-self.mtss[i])\n" +
"        return [(self.titles[i].decode('utf-8','replace'),int(self.zpks[i]),int(self.mtss[i])) for i in idxs]\n" +
"    def close(self):\n" +
"        try: self.mv.release()\n" +
"        except Exception: pass\n" +
"        self.mm.close(); self.f.close()\n" +
"\n" +
"def sqlite_topk(conn,prefix,k=10):\n" +
"    cur=conn.execute('SELECT Z_PK,ZTITLE1,ZMODIFICATIONDATE1 FROM ZICCLOUDSYNCINGOBJECT WHERE ZTITLE1 LIKE ? ORDER BY ZMODIFICATIONDATE1 DESC LIMIT ?',(prefix+'%',k))\n" +
"    return cur.fetchall()\n" +
"\n" +
"def bench(src):\n" +
"    info=encode(src)\n" +
"    print(f'[encode] {info[\"encode_s\"]*1000:.1f} ms  notes={info[\"n\"]}  blob={fmt(info[\"blob_size\"])} ({100*info[\"blob_size\"]/max(info[\"raw_size\"],1):.1f}% of {fmt(info[\"raw_size\"])})')\n" +
"    if info['n']==0:\n" +
"        print('[bench] no notes — skip query phase'); return\n" +
"    b=Blob(BIN)\n" +
"    import random\n" +
"    random.seed(42)\n" +
"    samples=[]\n" +
"    for _ in range(100):\n" +
"        i=random.randrange(b.n)\n" +
"        t=b.title(i).decode('utf-8','replace')\n" +
"        plen=random.choice([1,2,3,4,5])\n" +
"        samples.append(t[:plen] if len(t)>=plen else t)\n" +
"    rss_blob=rss()\n" +
"    for p in samples[:5]: b.prefix_topk(p,10)\n" +
"    t0=time.perf_counter(); total_hits=0\n" +
"    for p in samples:\n" +
"        r=b.prefix_topk(p,10); total_hits+=len(r)\n" +
"    t1=time.perf_counter()\n" +
"    blob_us=(t1-t0)*1e6/len(samples)\n" +
"    b.close()\n" +
"    copy=safe_copy(src)\n" +
"    conn=sqlite3.connect(copy)\n" +
"    for p in samples[:5]: sqlite_topk(conn,p,10)\n" +
"    t0=time.perf_counter(); sq_hits=0\n" +
"    for p in samples:\n" +
"        r=sqlite_topk(conn,p,10); sq_hits+=len(r)\n" +
"    t1=time.perf_counter()\n" +
"    sqlite_persistent_us=(t1-t0)*1e6/len(samples)\n" +
"    conn.close()\n" +
"    rss_sqlite=rss()\n" +
"    t0=time.perf_counter()\n" +
"    for p in samples:\n" +
"        c=sqlite3.connect(copy); sqlite_topk(c,p,10); c.close()\n" +
"    t1=time.perf_counter()\n" +
"    sqlite_cold_us=(t1-t0)*1e6/len(samples)\n" +
"    os.unlink(copy)\n" +
"    print(f'[query] 100 prefix-topK-10  (hits blob={total_hits}, sqlite={sq_hits})')\n" +
"    print(f'  sqlite cold (per-query open/close): {sqlite_cold_us:10.1f} us')\n" +
"    print(f'  sqlite persistent connection      : {sqlite_persistent_us:10.1f} us')\n" +
"    print(f'  blob mmap + bisect                : {blob_us:10.1f} us')\n" +
"    if blob_us>0:\n" +
"        print(f'  speedup vs cold      : {sqlite_cold_us/blob_us:6.1f}x')\n" +
"        print(f'  speedup vs persistent: {sqlite_persistent_us/blob_us:6.1f}x')\n" +
"    print(f'[rss] after blob only      : {fmt(rss_blob)}')\n" +
"    print(f'[rss] after sqlite as well : {fmt(rss_sqlite)}')\n" +
"\n" +
"if mode=='encode':\n" +
"    info=encode(src)\n" +
"    print(f'encoded {info[\"n\"]} notes in {info[\"encode_s\"]*1000:.1f} ms → {BIN} ({fmt(info[\"blob_size\"])}, {100*info[\"blob_size\"]/max(info[\"raw_size\"],1):.1f}% of raw {fmt(info[\"raw_size\"])})')\n" +
"elif mode=='bench':\n" +
"    bench(src)\n" +
"else:\n" +
"    print('usage: encode|bench <NoteStore.sqlite>'); sys.exit(2)\n"

fn run() {
    let argv = args()
    let mut mode = "bench"
    let mut target = ""
    let mut i = 0
    while i < len(argv) {
        let v = argv[i]
        let is_hexa_bin = v.contains("/hexa-lang/") || v == "hexa" || v == "hexa.real"
        let is_self     = v.contains("memo_notes_shbf")
        if is_hexa_bin == false && is_self == false {
            if v == "encode" || v == "bench" { mode = v }
            else if v.contains(".sqlite") || v.contains(".db") { target = v }
        }
        i = i + 1
    }
    // macOS 버전별 path probe
    if len(target) == 0 {
        let p1 = env("HOME") + "/Library/Group Containers/group.com.apple.notes/NoteStore.sqlite"
        let p2 = env("HOME") + "/Library/Containers/com.apple.Notes/Data/Library/Notes/NoteStore.sqlite"
        if file_exists(p1) {
            target = p1
        } else if file_exists(p2) {
            target = p2
        } else {
            target = p1
        }
        println("(default target: " + target + ")")
    }
    if file_exists(target) == false {
        println("ERROR: not found: " + target)
        println("hint: TCC > Files & Folders > 'Apple Notes' 또는 Full Disk Access 부여 필요")
        return
    }
    let tmp_py = "/tmp/memo_notes_shbf_" + exec("date +%s%N").trim() + ".py"
    write_file(tmp_py, PAYLOAD)
    let cmd = "/usr/bin/perl -e 'alarm 120; exec @ARGV' /usr/bin/python3 '" + tmp_py + "' '" + mode + "' '" + target + "' 2>&1; rm -f '" + tmp_py + "'"
    let result = exec(cmd)
    print(result)
}

run()
