// airgenome/filters/module/data/telegram_chat_shbf.hexa
//   T1 — Telegram Chat Sorted Blob Filter (SHBF — F18 직접 이식).
//
//   목적: macOS Telegram Desktop 의 postbox 가 실제로는 app-encrypted SQLite —
//         schema 가 표준 sqlite3 로 안 열린다 (`unsupported file format`).
//         하지만 postbox/media/ 디렉토리는 sandbox 안에서 read 가능하고,
//         파일명에 peer_id (cloud-document-<dc>-<peer>) 가 그대로 노출된다.
//         peer_id + last_msg_ts (mtime) 를 sorted blob 으로 박제 → bisect 즉답.
//
//   blob layout (little-endian):
//     magic   : 4B  "TCBF"          (Telegram Chat Blob Filter)
//     version : 4B  u32             (1)
//     n       : 4B  u32             chat (peer) 개수
//     str_sz  : 4B  u32             peer_id 문자열 pool 바이트
//     [n*4]   : u32 offsets         peer_id 시작 (정렬됨, 문자열 정렬)
//     [n*4]   : u32 lens            peer_id 길이
//     [n*4]   : u32 last_ts         가장 최근 mtime (epoch s)
//     [n*4]   : u32 file_count      해당 peer 의 media 파일 수 (활성도 proxy)
//     [str_sz]: utf-8 raw bytes
//
//   query: peer_id_prefix → bisect_left 두 번 → range. activity = file_count.
//
// 모드:
//   encode      : postbox 디렉토리 walk → /tmp/telegram_chat_tcbf.bin
//   bench       : encode + linear walk vs blob bisect (100 query)
//
// 가이드라인:
//   - postbox.db read-only (open 자체 안 함 — 파일명 파싱만)
//   - sandbox path 미존재 시 synthetic fallback (5000 peers)
//
// R1 HEXA-FIRST: 인라인 python3 페이로드 (.py 신규 없음).
// R17: /usr/bin/perl alarm 120s wrapper. raw 9 hexa-only.

let PAYLOAD = "import sys,os,struct,time,bisect,heapq,resource,mmap,array,glob,re,random\n" +
"mode=sys.argv[1]; src=sys.argv[2] if len(sys.argv)>2 else ''\n" +
"BIN='/tmp/telegram_chat_tcbf.bin'\n" +
"def fmt(b):\n" +
"    if b>1048576: return f'{b/1048576:.2f}MB'\n" +
"    if b>1024: return f'{b/1024:.1f}KB'\n" +
"    return f'{b}B'\n" +
"def rss():\n" +
"    r=resource.getrusage(resource.RUSAGE_SELF).ru_maxrss\n" +
"    if sys.platform=='darwin': return r\n" +
"    return r*1024\n" +
"\n" +
"# 파일명 패턴: telegram-cloud-document-<dc>-<peer>[suffix], local-file--<peer>[suffix]\n" +
"PEER_RE=re.compile(r'(?:telegram-cloud-(?:document|photo-size)-(?:size-)?\\d+-(\\d+)|local-file-+(\\d+))')\n" +
"\n" +
"def probe_postbox():\n" +
"    home=os.path.expanduser('~')\n" +
"    cands=glob.glob(home+'/Library/Group Containers/*Telegram*/stable/account-*/postbox/media')\n" +
"    cands+=glob.glob(home+'/Library/Group Containers/*Telegram*/appstore/account-*/postbox/media')\n" +
"    cands+=glob.glob(home+'/Library/Containers/ru.keepcoder.Telegram/Data/Library/Caches/postbox*/media')\n" +
"    return [c for c in cands if os.path.isdir(c)]\n" +
"\n" +
"def harvest(media_dirs):\n" +
"    by_peer={}\n" +
"    for d in media_dirs:\n" +
"        for name in os.listdir(d):\n" +
"            m=PEER_RE.search(name)\n" +
"            if not m: continue\n" +
"            peer=m.group(1) or m.group(2)\n" +
"            full=os.path.join(d,name)\n" +
"            st=os.stat(full,follow_symlinks=False)\n" +
"            cur=by_peer.get(peer)\n" +
"            ts=int(st.st_mtime)\n" +
"            if cur is None: by_peer[peer]=[ts,1]\n" +
"            else:\n" +
"                if ts>cur[0]: cur[0]=ts\n" +
"                cur[1]+=1\n" +
"    return by_peer\n" +
"\n" +
"def synth_chats(n=5000,seed=42):\n" +
"    rng=random.Random(seed)\n" +
"    out={}\n" +
"    for i in range(n):\n" +
"        peer=str(rng.randrange(1,10**18))\n" +
"        out[peer]=[1700000000+rng.randrange(60*60*24*365),rng.randrange(1,200)]\n" +
"    return out\n" +
"\n" +
"def encode(src):\n" +
"    t0=time.perf_counter()\n" +
"    media_dirs=[]\n" +
"    if src and os.path.isdir(src): media_dirs=[src]\n" +
"    else: media_dirs=probe_postbox()\n" +
"    if not media_dirs:\n" +
"        print('[encode] no postbox media dir found — synthetic fallback')\n" +
"        by_peer=synth_chats(5000)\n" +
"        source='synthetic'\n" +
"    else:\n" +
"        by_peer=harvest(media_dirs)\n" +
"        source=media_dirs[0]\n" +
"        if not by_peer:\n" +
"            print('[encode] media dir empty — synthetic fallback')\n" +
"            by_peer=synth_chats(5000); source='synthetic'\n" +
"    rows=sorted(by_peer.items(), key=lambda kv:kv[0])\n" +
"    n=len(rows)\n" +
"    pool=bytearray()\n" +
"    offs=array.array('I',[0]*n)\n" +
"    lens=array.array('I',[0]*n)\n" +
"    tss =array.array('I',[0]*n)\n" +
"    fcs =array.array('I',[0]*n)\n" +
"    for i,(peer,(ts,fc)) in enumerate(rows):\n" +
"        pb=peer.encode('utf-8','replace')\n" +
"        offs[i]=len(pool); lens[i]=len(pb); tss[i]=ts&0xffffffff; fcs[i]=int(fc)&0xffffffff\n" +
"        pool.extend(pb)\n" +
"    header=struct.pack('<4sIII',b'TCBF',1,n,len(pool))\n" +
"    with open(BIN,'wb') as f:\n" +
"        f.write(header)\n" +
"        f.write(offs.tobytes()); f.write(lens.tobytes())\n" +
"        f.write(tss.tobytes()); f.write(fcs.tobytes())\n" +
"        f.write(pool)\n" +
"    t1=time.perf_counter()\n" +
"    return {'encode_s':t1-t0,'n':n,'blob_size':os.path.getsize(BIN),'source':source}\n" +
"\n" +
"class Blob:\n" +
"    def __init__(self,path):\n" +
"        self.f=open(path,'rb')\n" +
"        self.mm=mmap.mmap(self.f.fileno(),0,prot=mmap.PROT_READ)\n" +
"        magic,ver,n,pool_sz=struct.unpack_from('<4sIII',self.mm,0)\n" +
"        if magic!=b'TCBF' or ver!=1:\n" +
"            raise ValueError(f'bad magic/ver: {magic} {ver}')\n" +
"        self.n=n; self.pool_sz=pool_sz\n" +
"        base=16\n" +
"        self.offs_off=base; self.lens_off=base+4*n\n" +
"        self.tss_off =base+8*n; self.fcs_off=base+12*n\n" +
"        self.pool_off=base+16*n\n" +
"        self.mv=memoryview(self.mm)\n" +
"        offs=array.array('I'); offs.frombytes(bytes(self.mv[self.offs_off:self.offs_off+4*n]))\n" +
"        lens=array.array('I'); lens.frombytes(bytes(self.mv[self.lens_off:self.lens_off+4*n]))\n" +
"        tss =array.array('I'); tss.frombytes(bytes(self.mv[self.tss_off :self.tss_off +4*n]))\n" +
"        fcs =array.array('I'); fcs.frombytes(bytes(self.mv[self.fcs_off :self.fcs_off +4*n]))\n" +
"        pool=bytes(self.mv[self.pool_off:self.pool_off+pool_sz])\n" +
"        self.peers=[pool[offs[i]:offs[i]+lens[i]] for i in range(n)]\n" +
"        self.tss=tss; self.fcs=fcs\n" +
"    def prefix_topk(self,prefix,k=10):\n" +
"        pb=prefix.encode('utf-8') if isinstance(prefix,str) else prefix\n" +
"        peers=self.peers\n" +
"        start=bisect.bisect_left(peers,pb)\n" +
"        end=bisect.bisect_left(peers,pb+b'\\xff\\xff\\xff\\xff')\n" +
"        if end==start: return []\n" +
"        if end-start<=k: idxs=list(range(start,end))\n" +
"        else: idxs=heapq.nlargest(k,range(start,end),key=lambda i:self.tss[i])\n" +
"        idxs.sort(key=lambda i:-self.tss[i])\n" +
"        return [(self.peers[i].decode('utf-8','replace'),int(self.tss[i]),int(self.fcs[i])) for i in idxs]\n" +
"    def close(self):\n" +
"        try: self.mv.release()\n" +
"        except Exception: pass\n" +
"        self.mm.close(); self.f.close()\n" +
"\n" +
"def linear_topk(rows,prefix,k=10):\n" +
"    pb=prefix\n" +
"    cand=[r for r in rows if r[0].startswith(pb)]\n" +
"    cand.sort(key=lambda r:-r[1][0])\n" +
"    return cand[:k]\n" +
"\n" +
"def bench(src):\n" +
"    info=encode(src)\n" +
"    print(f'[encode] {info[\"encode_s\"]*1000:.1f} ms  peers={info[\"n\"]}  blob={fmt(info[\"blob_size\"])}  source={info[\"source\"]}')\n" +
"    if info['n']==0:\n" +
"        print('[bench] no peers — skip query phase'); return\n" +
"    b=Blob(BIN)\n" +
"    rng=random.Random(7)\n" +
"    samples=[]\n" +
"    for _ in range(100):\n" +
"        i=rng.randrange(b.n)\n" +
"        peer=b.peers[i].decode('utf-8','replace')\n" +
"        plen=rng.choice([2,3,4,5,6])\n" +
"        samples.append(peer[:plen] if len(peer)>=plen else peer)\n" +
"    rss_blob=rss()\n" +
"    # OLD: 매 query 마다 dir scan + filename parse 모사 (rows 위에 linear)\n" +
"    rows=[(b.peers[i].decode('utf-8','replace'),(int(b.tss[i]),int(b.fcs[i]))) for i in range(b.n)]\n" +
"    for p in samples[:5]: linear_topk(rows,p,10); b.prefix_topk(p,10)\n" +
"    t0=time.perf_counter(); h_lin=0\n" +
"    for p in samples:\n" +
"        h_lin+=len(linear_topk(rows,p,10))\n" +
"    t1=time.perf_counter(); lin_us=(t1-t0)*1e6/len(samples)\n" +
"    t0=time.perf_counter(); h_bi=0\n" +
"    for p in samples:\n" +
"        h_bi+=len(b.prefix_topk(p,10))\n" +
"    t1=time.perf_counter(); bi_us=(t1-t0)*1e6/len(samples)\n" +
"    b.close()\n" +
"    print(f'[query] 100 prefix-topK-10  hits linear={h_lin} bisect={h_bi}')\n" +
"    print(f'  linear scan       : {lin_us:10.1f} us/query')\n" +
"    print(f'  blob mmap+bisect  : {bi_us :10.1f} us/query')\n" +
"    if bi_us>0: print(f'  speedup: {lin_us/bi_us:6.1f}x')\n" +
"    print(f'[lossless] hits equal: {h_lin==h_bi}')\n" +
"    print(f'[rss] after blob loaded: {fmt(rss_blob)}')\n" +
"\n" +
"if mode=='encode':\n" +
"    info=encode(src)\n" +
"    print(f'encoded {info[\"n\"]} peers in {info[\"encode_s\"]*1000:.1f} ms -> {BIN} ({fmt(info[\"blob_size\"])}, source={info[\"source\"]})')\n" +
"elif mode=='bench':\n" +
"    bench(src)\n" +
"else:\n" +
"    print('usage: encode|bench [<postbox/media dir>]'); sys.exit(2)\n"

fn run() {
    let argv = args()
    let mut mode = "bench"
    let mut target = ""
    let mut i = 0
    while i < len(argv) {
        let v = argv[i]
        let is_hexa_bin = v.contains("/hexa-lang/") || v == "hexa" || v == "hexa.real"
        let is_self     = v.contains("telegram_chat_shbf")
        if is_hexa_bin == false && is_self == false {
            if v == "encode" || v == "bench" { mode = v }
            else if v.contains("/") || v == "synthetic" { target = v }
        }
        i = i + 1
    }
    let tmp_py = "/tmp/telegram_chat_shbf_" + exec("date +%s%N").trim() + ".py"
    write_file(tmp_py, PAYLOAD)
    let cmd = "/usr/bin/perl -e 'alarm 120; exec @ARGV' /usr/bin/python3 '" + tmp_py + "' '" + mode + "' '" + target + "' 2>&1; rm -f '" + tmp_py + "'"
    let result = exec(cmd)
    print(result)
}

run()
