// airgenome/filters/module/data/photos_faces_dict.hexa
//   MD1 — Photos.app person/face name → 1-byte enum dict (MFDC, MA3 #99 pattern).
//
//   목적: Photos Library/database/Photos.sqlite 의 ZPERSON (named face cluster)
//         + ZDETECTEDFACE (per-asset face occurrence) hot path 를 1-byte enum
//         column 으로 치환. ZFACECOUNT u32 sidecar 로 top-K-by-faces 즉시.
//
//   blob layout (little-endian):
//     magic        : 4B  "MFDC"
//     version      : 4B  u32 (1)
//     n_person     : 4B  u32 distinct person count (≤ 255)
//     n_face       : 4B  u32 total face occurrences (clustered only)
//     str_sz       : 4B  u32 name pool 바이트 길이
//     [n_person*4] : u32 name_offs
//     [n_person*4] : u32 name_lens
//     [n_person*4] : u32 face_count   ZPERSON.ZFACECOUNT (sidecar, top-K)
//     [str_sz]     : utf-8 name pool  (NUL 없음)
//     [n_face]     : u8  enum_col     per-face person id
//
//   query:
//     enum byte → name_offs[id] → string 즉시.
//     top-K-by-faces = face_count argpartition. 1-pass.
//     GROUP BY count = enum_col 1-pass histogram.
//
// TCC carve:
//   - file_exists(target)==False → synth-only + reason_code=md1_tcc_deny
//   - file_exists==True ∧ ZPERSON COUNT=0 → synth + reason_code=md1_zero_persons
//   - sqlite open URI 'file:...?mode=ro&immutable=1' 강제 (NO mutation)
//
// 절대 금지: Photos.sqlite 쓰기 0, launchctl 0, git commit 0, network 0.
// R1 HEXA-FIRST: 인라인 python3. R17: /usr/bin/perl alarm 120s. /usr/bin/python3 절대.

let PAYLOAD = "import sys,os,sqlite3,struct,time,array,mmap,resource,random,tempfile\n" +
"from collections import Counter\n" +
"mode=sys.argv[1] if len(sys.argv)>1 else 'bench'\n" +
"src=sys.argv[2] if len(sys.argv)>2 else '__SYNTH__'\n" +
"BIN='/tmp/photos_faces_dict.bin'\n" +
"CLASSIFIER='MFDC-v1-2026-04-30'\n" +
"SYNTH_MARK='__SYNTH__'\n" +
"\n" +
"def fmt(b):\n" +
"    if b>1048576: return f'{b/1048576:.2f}MB'\n" +
"    if b>1024: return f'{b/1024:.1f}KB'\n" +
"    return f'{b}B'\n" +
"def rss():\n" +
"    r=resource.getrusage(resource.RUSAGE_SELF).ru_maxrss\n" +
"    if sys.platform=='darwin': return r\n" +
"    return r*1024\n" +
"def to_int_safe(v):\n" +
"    if v is None: return 0\n" +
"    if isinstance(v,int): return v\n" +
"    if isinstance(v,float): return int(v)\n" +
"    if isinstance(v,str) and v.isdigit(): return int(v)\n" +
"    return 0\n" +
"\n" +
"def synth_persons(n_person=200,n_face=5000):\n" +
"    rng=random.Random(42)\n" +
"    names=[f'Person {i:04d}' for i in range(n_person)]\n" +
"    weights=[]\n" +
"    for i in range(n_person):\n" +
"        if i<5: w=400-i*50\n" +
"        elif i<30: w=40\n" +
"        else: w=3\n" +
"        weights.append(w)\n" +
"    # face stream uses pk values directly (pk = i+1) so ZDETECTEDFACE→ZPERSONFORFACE join semantics match real path\n" +
"    pks=[i+1 for i in range(n_person)]\n" +
"    faces=rng.choices(pks,weights=weights,k=n_face)\n" +
"    fc=[0]*n_person\n" +
"    for pk in faces: fc[pk-1]+=1\n" +
"    persons=[(i+1,fc[i],names[i]) for i in range(n_person)]\n" +
"    return persons,faces\n" +
"\n" +
"def open_ro(path):\n" +
"    uri=f'file:{path}?mode=ro&immutable=1'\n" +
"    return sqlite3.connect(uri,uri=True,timeout=2.0)\n" +
"\n" +
"def safe_copy(src):\n" +
"    tmp=tempfile.NamedTemporaryFile(suffix='.sqlite',delete=False); tmp.close()\n" +
"    sc=open_ro(src)\n" +
"    dc=sqlite3.connect(tmp.name)\n" +
"    sc.backup(dc); dc.close(); sc.close()\n" +
"    return tmp.name\n" +
"\n" +
"def list_tables(con):\n" +
"    cur=con.execute(\"SELECT name FROM sqlite_master WHERE type='table'\")\n" +
"    return {r[0] for r in cur.fetchall()}\n" +
"def list_cols(con,tab):\n" +
"    cur=con.execute(f'PRAGMA table_info({tab})')\n" +
"    return [r[1] for r in cur.fetchall()]\n" +
"\n" +
"def fetch_real(con):\n" +
"    tabs=list_tables(con)\n" +
"    if 'ZPERSON' not in tabs: return None,None,'md1_schema_skew'\n" +
"    pcols=set(list_cols(con,'ZPERSON'))\n" +
"    name_expr=\"COALESCE(NULLIF(TRIM(ZFULLNAME),''), NULLIF(TRIM(ZDISPLAYNAME),''), '(unnamed)')\"\n" +
"    if 'ZFULLNAME' not in pcols and 'ZDISPLAYNAME' not in pcols:\n" +
"        return None,None,'md1_schema_skew'\n" +
"    fc_col='ZFACECOUNT' if 'ZFACECOUNT' in pcols else None\n" +
"    if fc_col:\n" +
"        q=f'SELECT Z_PK,{fc_col},{name_expr} FROM ZPERSON'\n" +
"    else:\n" +
"        q=f'SELECT Z_PK,0 AS fc,{name_expr} FROM ZPERSON'\n" +
"    persons=[]\n" +
"    for r in con.execute(q):\n" +
"        persons.append((to_int_safe(r[0]),to_int_safe(r[1]),(r[2] or '(unnamed)').strip()[:200]))\n" +
"    if len(persons)==0: return None,None,'md1_zero_persons'\n" +
"    faces=[]\n" +
"    if 'ZDETECTEDFACE' in tabs:\n" +
"        fcols=set(list_cols(con,'ZDETECTEDFACE'))\n" +
"        if 'ZPERSONFORFACE' in fcols:\n" +
"            for (pk,) in con.execute('SELECT ZPERSONFORFACE FROM ZDETECTEDFACE WHERE ZPERSONFORFACE IS NOT NULL'):\n" +
"                faces.append(to_int_safe(pk))\n" +
"    return persons,faces,'md1_real'\n" +
"\n" +
"def encode_blob(persons,faces,reason):\n" +
"    pk_to_name={pk:n for (pk,fc,n) in persons}\n" +
"    pk_to_fc  ={pk:fc for (pk,fc,n) in persons}\n" +
"    distinct_pks=sorted(set(pk_to_name.keys()))\n" +
"    overflow=len(distinct_pks)>255\n" +
"    if overflow:\n" +
"        face_cnt=Counter(faces)\n" +
"        for pk in distinct_pks:\n" +
"            face_cnt[pk]=face_cnt.get(pk,0)+pk_to_fc.get(pk,0)\n" +
"        top=[pk for pk,_ in face_cnt.most_common(254)]\n" +
"        kept=set(top)\n" +
"        names=['(OTHER)']+[pk_to_name[pk] for pk in top]\n" +
"        fcs  =[sum(pk_to_fc.get(p,0) for p in distinct_pks if p not in kept)]\n" +
"        fcs += [pk_to_fc.get(pk,0) for pk in top]\n" +
"        pk_to_id={pk:(i+1) for i,pk in enumerate(top)}\n" +
"    else:\n" +
"        names=[pk_to_name[pk] for pk in distinct_pks]\n" +
"        fcs  =[pk_to_fc.get(pk,0) for pk in distinct_pks]\n" +
"        pk_to_id={pk:i for i,pk in enumerate(distinct_pks)}\n" +
"    n_person=len(names)\n" +
"    enum_col=bytearray(len(faces))\n" +
"    for i,pk in enumerate(faces):\n" +
"        enum_col[i]=pk_to_id.get(pk,0)\n" +
"    pool=bytearray()\n" +
"    name_offs=array.array('I',[0]*n_person)\n" +
"    name_lens=array.array('I',[0]*n_person)\n" +
"    fc_arr   =array.array('I',[0]*n_person)\n" +
"    for i,n in enumerate(names):\n" +
"        nb=n.encode('utf-8','replace')\n" +
"        name_offs[i]=len(pool); name_lens[i]=len(nb); pool.extend(nb)\n" +
"        fc_arr[i]=int(fcs[i])&0xffffffff\n" +
"    header=struct.pack('<4sIIII',b'MFDC',1,n_person,len(faces),len(pool))\n" +
"    with open(BIN,'wb') as f:\n" +
"        f.write(header)\n" +
"        f.write(name_offs.tobytes())\n" +
"        f.write(name_lens.tobytes())\n" +
"        f.write(fc_arr.tobytes())\n" +
"        f.write(bytes(pool))\n" +
"        f.write(bytes(enum_col))\n" +
"    raw_name_bytes=sum(len(pk_to_name.get(pk,'').encode('utf-8','replace')) for pk in faces)\n" +
"    return {'n_person':n_person,'n_face':len(faces),'blob_size':os.path.getsize(BIN),\n" +
"            'names':names,'fcs':fcs,'enum_col':bytes(enum_col),'overflow':overflow,\n" +
"            'reason':reason if not overflow else 'md1_overflow_255','raw_name_bytes':raw_name_bytes}\n" +
"\n" +
"def encode():\n" +
"    t0=time.perf_counter_ns()\n" +
"    use_synth=False; reason='md1_real'\n" +
"    if src==SYNTH_MARK or not os.path.exists(src):\n" +
"        persons,faces=synth_persons()\n" +
"        use_synth=True; reason='md1_tcc_deny' if src!=SYNTH_MARK else 'md1_synth_explicit'\n" +
"    else:\n" +
"        try:\n" +
"            copy=safe_copy(src); con=sqlite3.connect(copy)\n" +
"            persons,faces,reason=fetch_real(con)\n" +
"            con.close(); os.unlink(copy)\n" +
"            if persons is None:\n" +
"                persons,faces=synth_persons(); use_synth=True\n" +
"        except Exception as e:\n" +
"            persons,faces=synth_persons(); use_synth=True; reason='md1_open_fail'\n" +
"    info=encode_blob(persons,faces,reason)\n" +
"    t1=time.perf_counter_ns()\n" +
"    info['encode_ns']=t1-t0; info['synth']=use_synth\n" +
"    info['classifier']=CLASSIFIER\n" +
"    return info\n" +
"\n" +
"class FacesDict:\n" +
"    def __init__(self,path):\n" +
"        self.f=open(path,'rb')\n" +
"        self.mm=mmap.mmap(self.f.fileno(),0,prot=mmap.PROT_READ)\n" +
"        magic,ver,n_person,n_face,str_sz=struct.unpack_from('<4sIIII',self.mm,0)\n" +
"        if magic!=b'MFDC' or ver!=1:\n" +
"            raise ValueError(f'bad magic/ver: {magic} {ver}')\n" +
"        self.n_person=n_person; self.n_face=n_face\n" +
"        base=20\n" +
"        self.name_offs=array.array('I'); self.name_offs.frombytes(self.mm[base:base+4*n_person])\n" +
"        b1=base+4*n_person\n" +
"        self.name_lens=array.array('I'); self.name_lens.frombytes(self.mm[b1:b1+4*n_person])\n" +
"        b2=b1+4*n_person\n" +
"        self.face_cnt=array.array('I'); self.face_cnt.frombytes(self.mm[b2:b2+4*n_person])\n" +
"        b3=b2+4*n_person\n" +
"        self.pool=bytes(self.mm[b3:b3+str_sz])\n" +
"        b4=b3+str_sz\n" +
"        self.enum_col=bytes(self.mm[b4:b4+n_face])\n" +
"        self.names=[self.pool[self.name_offs[i]:self.name_offs[i]+self.name_lens[i]].decode('utf-8','replace') for i in range(n_person)]\n" +
"    def topk_by_face_count(self,k=10):\n" +
"        idx=sorted(range(self.n_person),key=lambda i:-self.face_cnt[i])[:k]\n" +
"        return [(self.names[i],int(self.face_cnt[i])) for i in idx]\n" +
"    def histogram(self):\n" +
"        c=[0]*self.n_person\n" +
"        for b in self.enum_col: c[b]+=1\n" +
"        return list(zip(self.names,c))\n" +
"    def close(self):\n" +
"        self.mm.close(); self.f.close()\n" +
"\n" +
"def bench():\n" +
"    info=encode()\n" +
"    tag=' [synth]' if info['synth'] else ''\n" +
"    print(f'[encode]{tag} {info[\"encode_ns\"]/1e6:.1f}ms  persons={info[\"n_person\"]}  faces={info[\"n_face\"]}  blob={fmt(info[\"blob_size\"])}  reason={info[\"reason\"]}  classifier={info[\"classifier\"]}')\n" +
"    if info['n_face']==0:\n" +
"        print('[bench] no faces — skip query phase'); return\n" +
"    saved_pct=((info['raw_name_bytes']-info['n_face'])*100)//max(info['raw_name_bytes'],1) if info['raw_name_bytes']>0 else 0\n" +
"    print(f'  raw_name_bytes={fmt(info[\"raw_name_bytes\"])} → enum={fmt(info[\"n_face\"])}  saved={saved_pct}%')\n" +
"    fd=FacesDict(BIN)\n" +
"    rss_blob=rss()\n" +
"    t0=time.perf_counter_ns()\n" +
"    cb=fd.histogram()\n" +
"    t1=time.perf_counter_ns(); ns_new=t1-t0\n" +
"    t0=time.perf_counter_ns()\n" +
"    enum_col=info['enum_col']; names=info['names']\n" +
"    cc=Counter()\n" +
"    for i,bb in enumerate(enum_col): cc[names[bb]]+=1\n" +
"    t1=time.perf_counter_ns(); ns_old=t1-t0\n" +
"    print(f'  GROUP BY person OLD (Counter on str)  : {ns_old:10d} ns')\n" +
"    print(f'  GROUP BY person NEW (u8 enum scan)    : {ns_new:10d} ns')\n" +
"    if ns_new>0: print(f'  speedup={ns_old/ns_new:.2f}x')\n" +
"    # filter zero-face persons from NEW histogram for fair compare with OLD Counter (which never emits zero)\n" +
"    a=sorted([(n,c) for (n,c) in cb if c>0]); b=sorted(cc.items())\n" +
"    if len(a)==len(b):\n" +
"        mm_=sum(1 for x,y in zip(a,b) if x[0]!=y[0] or x[1]!=y[1])\n" +
"    else:\n" +
"        mm_=abs(len(a)-len(b))\n" +
"    print(f'  diff_test mismatches: {mm_}')\n" +
"    top=fd.topk_by_face_count(5)\n" +
"    print(f'  top-5 by face_count: {top}')\n" +
"    fd.close()\n" +
"    print(f'[rss] after blob loaded: {fmt(rss_blob)}')\n" +
"\n" +
"if mode=='encode':\n" +
"    info=encode()\n" +
"    tag=' [synth]' if info['synth'] else ''\n" +
"    print(f'encoded {info[\"n_face\"]} faces ({info[\"n_person\"]} persons) in {info[\"encode_ns\"]/1e6:.1f}ms → {BIN} ({fmt(info[\"blob_size\"])}) reason={info[\"reason\"]}{tag}')\n" +
"elif mode=='bench':\n" +
"    bench()\n" +
"else:\n" +
"    print('usage: encode|bench [Photos.sqlite]'); sys.exit(2)\n"

fn run() {
    let argv = args()
    let mut mode = "bench"
    let mut target = ""
    let mut i = 0
    while i < len(argv) {
        let v = argv[i]
        let is_hexa_bin = v.contains("/hexa-lang/") || v == "hexa" || v == "hexa.real"
        let is_self     = v.contains("photos_faces_dict")
        if is_hexa_bin == false && is_self == false {
            if v == "encode" || v == "bench" { mode = v }
            else if v.contains(".sqlite") || v.contains(".db") { target = v }
        }
        i = i + 1
    }
    if len(target) == 0 {
        target = env("HOME") + "/Pictures/Photos Library.photoslibrary/database/Photos.sqlite"
        println("(default target: " + target + ")")
    }
    if file_exists(target) == false {
        println("(target not found / TCC denied — using synthetic fallback)")
        target = "__SYNTH__"
    }
    let tmp_py = "/tmp/photos_faces_dict_" + exec("date +%s%N").trim() + ".py"
    write_file(tmp_py, PAYLOAD)
    let cmd = "/usr/bin/perl -e 'alarm 120; exec @ARGV' /usr/bin/python3 '" + tmp_py + "' '" + mode + "' '" + target + "' 2>&1; rm -f '" + tmp_py + "'"
    let result = exec(cmd)
    print(result)
}

run()
