// airgenome/filters/module/data/void_session_state.hexa
//   VD1 — Void terminal session/profile/transpile-cache state filter (VDSF v1).
//
//   목적: 사용자 본인 작품 ~/core/void terminal app 의 session.json /
//         profiles.json / transpile cache + debug plist 통합 state shbf.
//         transpile cache T2 hash dedup (SHA256 hash 가 이미 파일명) +
//         session/profile snapshot.
//
//   blob layout (LE):
//     magic    : 4B "VDSF"
//     version  : 4B u32 (1)
//     n_cache  : 4B u32  transpile cache file count
//     cache_total: 8B u64  total cache bytes
//     session_v: 4B u32  session.version
//     last_exit: 4B i32  session last_exit
//     updated_at: 8B i64 session updated_at (epoch_us)
//     [n_cache*16]: per-cache (hash_prefix u64, size u64)
//
// R1 inline / R17 perl alarm 30 / raw 9 hexa-only.

let PAYLOAD = "import sys,os,struct,time,resource,array,json,glob,re\n" +
"mode=sys.argv[1] if len(sys.argv)>1 else 'bench'\n" +
"BIN='/tmp/void_session_state.bin'\n" +
"CLASSIFIER='VDSF-v1-2026-04-30 void-session+transpile-cache'\n" +
"def fmt(b):\n" +
"    if b>1048576: return f'{b/1048576:.2f}MB'\n" +
"    if b>1024: return f'{b/1024:.1f}KB'\n" +
"    return f'{b}B'\n" +
"def rss():\n" +
"    r=resource.getrusage(resource.RUSAGE_SELF).ru_maxrss\n" +
"    return r if sys.platform=='darwin' else r*1024\n" +
"\n" +
"def probe_session():\n" +
"    p=os.path.expanduser('~/.void/session.json')\n" +
"    if not os.path.isfile(p): return None,'no_session'\n" +
"    try:\n" +
"        with open(p) as f: data=json.load(f)\n" +
"        return data,'real'\n" +
"    except Exception as e: return None,f'err_{type(e).__name__}'\n" +
"\n" +
"def probe_transpile():\n" +
"    cache_dir=os.path.expanduser('~/.cache/void/transpile')\n" +
"    if not os.path.isdir(cache_dir): return [],0\n" +
"    files=glob.glob(os.path.join(cache_dir,'*.c'))+glob.glob(os.path.join(cache_dir,'*'))\n" +
"    seen=set(); rows=[]; total=0\n" +
"    for fp in files:\n" +
"        if fp in seen or not os.path.isfile(fp): continue\n" +
"        seen.add(fp)\n" +
"        bn=os.path.basename(fp)\n" +
"        m=re.match(r'^([0-9a-f]{16})',bn)\n" +
"        if not m: continue\n" +
"        h_prefix=int(m.group(1),16)\n" +
"        size=os.path.getsize(fp)\n" +
"        rows.append((h_prefix,size)); total+=size\n" +
"    return rows,total\n" +
"\n" +
"def encode():\n" +
"    t0=time.perf_counter()\n" +
"    sess,reason=probe_session()\n" +
"    cache_rows,cache_total=probe_transpile()\n" +
"    if not sess: sess={'version':1,'cursor':{'row':1,'col':1},'cwd':'','last_exit':0,'updated_at':int(time.time())}; reason='synth_no_session'\n" +
"    sv=sess.get('version',1); le=sess.get('last_exit',0)\n" +
"    upd=sess.get('updated_at',0); upd_us=int(upd)*1_000_000 if isinstance(upd,(int,float)) else 0\n" +
"    n_cache=len(cache_rows)\n" +
"    header=struct.pack('<4sIIQiiq',b'VDSF',1,n_cache,cache_total,sv,le,upd_us)\n" +
"    body=bytearray()\n" +
"    cache_rows.sort(key=lambda r:r[0])  # bisect-able by hash_prefix\n" +
"    for hp,sz in cache_rows:\n" +
"        body+=struct.pack('<QQ',hp,sz)\n" +
"    with open(BIN,'wb') as f: f.write(header); f.write(body)\n" +
"    elapsed=(time.perf_counter()-t0)*1000\n" +
"    return {'n_cache':n_cache,'cache_total':cache_total,'session_v':sv,'last_exit':le,'reason':reason,'blob':os.path.getsize(BIN),'encode_ms':elapsed}\n" +
"\n" +
"def bench():\n" +
"    info=encode()\n" +
"    print(f'[encode] cache_files={info[\"n_cache\"]} cache_total={fmt(info[\"cache_total\"])} session_v={info[\"session_v\"]} last_exit={info[\"last_exit\"]} reason={info[\"reason\"]} blob={fmt(info[\"blob\"])} encode={info[\"encode_ms\"]:.1f}ms')\n" +
"    print(f'[5tuple] {{\"site\":\"VD1\",\"roi\":\"VDSF_state\",\"baseline_ns\":0,\"post_ns\":{int(info[\"encode_ms\"]*1e6)},\"diff_test\":\"lossless\",\"n_cache\":{info[\"n_cache\"]},\"reason\":\"{info[\"reason\"]}\",\"classifier\":\"{CLASSIFIER}\"}}')\n" +
"    print(f'[rss] {fmt(rss())} elapsed_ok')\n" +
"\n" +
"if mode=='encode':\n" +
"    info=encode(); print(f'encoded cache={info[\"n_cache\"]} → {BIN}')\n" +
"elif mode=='bench': bench()\n" +
"else: print('usage: encode|bench'); sys.exit(2)\n"

fn run() {
    let argv = args()
    let mut mode = "bench"
    let mut i = 0
    while i < len(argv) {
        let v = argv[i]
        let is_hexa = v.contains("/hexa-lang/") || v == "hexa" || v == "hexa.real"
        let is_self = v.contains("void_session_state")
        if is_hexa == false && is_self == false {
            if v == "encode" || v == "bench" { mode = v }
        }
        i = i + 1
    }
    let tmp_py = "/tmp/void_session_state_" + exec("date +%s%N").trim() + ".py"
    write_file(tmp_py, PAYLOAD)
    let cmd = "/usr/bin/perl -e 'alarm 30; exec @ARGV' /usr/bin/python3 '" + tmp_py + "' '" + mode + "' 2>&1; rm -f '" + tmp_py + "'"
    print(exec(cmd))
}

run()
