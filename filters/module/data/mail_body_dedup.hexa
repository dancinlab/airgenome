// airgenome/filters/module/data/mail_body_dedup.hexa
//   MA2 — Mail.app emlx 본문 thread/quote dedup (MBDD).
//
//   목적: 메일 thread 는 reply chain 마다 quoted body 가 중복 (">" prefix
//         또는 "On <date>, <sender> wrote:" 블록). 매번 thread render
//         (Mail.app 검색/Smart Mailbox snippet 추출/Spotlight indexing) 가
//         같은 quoted block 을 반복 hash/scan 한다. line-level wyhash 로
//         block-set 등록 후 동일 hash 만나면 skip — token saving 직선적.
//
//   blob layout (little-endian):
//     magic   : 4B  "MBDD"
//     version : 4B  u32             (1)
//     n_uniq  : 4B  u32             unique block 수
//     pool_sz : 4B  u32             content pool 바이트
//     [n*8]   : u64 hashes          blake2b-8B (sorted asc)
//     [n*4]   : u32 offs            pool 시작
//     [n*4]   : u32 lens            block 길이
//     [pool]  : utf-8 raw bytes     첫 등장 block 만 보관
//
//   block 정의: 본문에서 ">"-prefix line + "On ... wrote:" header 한 묶음을
//                ${quote_block} 으로 split. 각 quote block 단위로 hash.
//                non-quote 신규 텍스트는 dedup 대상 아님.
//
//   패턴: #65 wyhash-fallback (blake2b-8B) + #41 dedup cache.
//
// 모드:
//   encode : ~/Library/Mail/V<n> emlx 스캔 → /tmp/mail_body_dedup.bin
//   bench  : encode + dedup ratio (quote 중복 비율) + token 추정 (4B/tok)
//
// 절대 금지: emlx mutation, Envelope Index 쓰기, SMTP, launchctl, git commit.
// emlx open mode 는 'rb' read-only 강제.
// R1 HEXA-FIRST: 인라인 python3. R17: perl alarm 120s.

let PAYLOAD = "import sys,os,struct,time,bisect,resource,mmap,array,glob,hashlib,re\n" +
"from email.parser import BytesParser\n" +
"from email.policy import default as email_default_policy\n" +
"mode=sys.argv[1]\n" +
"BIN='/tmp/mail_body_dedup.bin'\n" +
"HOME=os.path.expanduser('~')\n" +
"MAX_FILES=2000\n" +
"\n" +
"def fmt(b):\n" +
"    if b>1048576: return f'{b/1048576:.2f}MB'\n" +
"    if b>1024: return f'{b/1024:.1f}KB'\n" +
"    return f'{b}B'\n" +
"def rss():\n" +
"    r=resource.getrusage(resource.RUSAGE_SELF).ru_maxrss\n" +
"    if sys.platform=='darwin': return r\n" +
"    return r*1024\n" +
"\n" +
"def wyhash_fb(b):\n" +
"    # blake2b 8B fallback. wyhash 가 없으면 동일 일관성.\n" +
"    h=hashlib.blake2b(b,digest_size=8).digest()\n" +
"    return struct.unpack('<Q',h)[0]\n" +
"\n" +
"def probe_mail():\n" +
"    out=[]\n" +
"    for v in (8,9,10,11,12):\n" +
"        d=f'{HOME}/Library/Mail/V{v}'\n" +
"        if os.path.isdir(d): out.append((v,d))\n" +
"    return out\n" +
"\n" +
"def find_emlx(root,limit=MAX_FILES):\n" +
"    out=[]\n" +
"    # mbox/Data/<n>/<n>/Messages/<msgid>.emlx 패턴\n" +
"    for dp,_,fs in os.walk(root):\n" +
"        if '/Messages' not in dp: continue\n" +
"        for fn in fs:\n" +
"            if fn.endswith('.emlx'):\n" +
"                out.append(os.path.join(dp,fn))\n" +
"                if len(out)>=limit: return out\n" +
"    return out\n" +
"\n" +
"# emlx layout: <ascii_len_int>\\n<rfc822 message>\\n<plist trailer>\n" +
"def read_emlx(path):\n" +
"    with open(path,'rb') as f:\n" +
"        first=f.readline().strip()\n" +
"        if not first.isdigit():\n" +
"            f.seek(0); return f.read()\n" +
"        n=int(first)\n" +
"        return f.read(n)\n" +
"\n" +
"def extract_text(body_bytes):\n" +
"    msg=BytesParser(policy=email_default_policy).parsebytes(body_bytes)\n" +
"    parts=[]\n" +
"    if msg.is_multipart():\n" +
"        for p in msg.walk():\n" +
"            ct=(p.get_content_type() or '').lower()\n" +
"            if ct=='text/plain':\n" +
"                payload=p.get_content() if hasattr(p,'get_content') else None\n" +
"                if isinstance(payload,str): parts.append(payload)\n" +
"    else:\n" +
"        ct=(msg.get_content_type() or '').lower()\n" +
"        if ct.startswith('text/'):\n" +
"            payload=msg.get_content() if hasattr(msg,'get_content') else None\n" +
"            if isinstance(payload,str): parts.append(payload)\n" +
"    return '\\n'.join(parts)\n" +
"\n" +
"_RE_ON_WROTE=re.compile(r'^On\\s.{1,200}\\s+wrote:\\s*$',re.M)\n" +
"def split_quote_blocks(text):\n" +
"    # quote block 정의:\n" +
"    #   1) consecutive '>'-prefix lines 묶음 (variable per-reply 인 header 와\n" +
"    #      독립적으로 관리되어야 root quote 가 reply 간 동일 hash).\n" +
"    #   2) 'On ... wrote:' header 자체는 single-line block (timestamp/sender 가\n" +
"    #      매번 달라 dedup 대상에서 자연 제외 — 보존만).\n" +
"    blocks=[]\n" +
"    lines=text.splitlines()\n" +
"    i=0; n=len(lines)\n" +
"    while i<n:\n" +
"        ln=lines[i]\n" +
"        if ln.startswith('>'):\n" +
"            j=i\n" +
"            while j<n and lines[j].startswith('>'):\n" +
"                j+=1\n" +
"            blk='\\n'.join(lines[i:j]).strip()\n" +
"            if blk: blocks.append(blk)\n" +
"            i=j; continue\n" +
"        if _RE_ON_WROTE.match(ln):\n" +
"            blocks.append(ln.strip())\n" +
"            i+=1; continue\n" +
"        i+=1\n" +
"    return blocks\n" +
"\n" +
"def encode():\n" +
"    cands=probe_mail()\n" +
"    if not cands:\n" +
"        print('ERROR: no Mail V<n> dir found'); sys.exit(2)\n" +
"    v,root=cands[0]\n" +
"    t0=time.perf_counter()\n" +
"    files=find_emlx(root,MAX_FILES)\n" +
"    raw_total=0; total_blocks=0; total_block_bytes=0\n" +
"    seen={}; refs={}\n" +
"    for fp in files:\n" +
"        try: raw_total+=os.path.getsize(fp)\n" +
"        except OSError: continue\n" +
"        body=read_emlx(fp)\n" +
"        text=extract_text(body)\n" +
"        if not text: continue\n" +
"        for blk in split_quote_blocks(text):\n" +
"            bb=blk.encode('utf-8','replace')\n" +
"            total_blocks+=1; total_block_bytes+=len(bb)\n" +
"            h=wyhash_fb(bb)\n" +
"            if h in seen:\n" +
"                refs[h]=refs.get(h,1)+1\n" +
"            else:\n" +
"                seen[h]=bb; refs[h]=1\n" +
"    items=sorted(seen.items(),key=lambda kv:kv[0])\n" +
"    n=len(items)\n" +
"    pool=bytearray()\n" +
"    hashes=array.array('Q',[0]*n)\n" +
"    offs=array.array('I',[0]*n); lens=array.array('I',[0]*n)\n" +
"    for i,(h,b) in enumerate(items):\n" +
"        hashes[i]=h\n" +
"        offs[i]=len(pool); lens[i]=len(b); pool.extend(b)\n" +
"    header=struct.pack('<4sIII',b'MBDD',1,n,len(pool))\n" +
"    with open(BIN,'wb') as f:\n" +
"        f.write(header)\n" +
"        f.write(hashes.tobytes())\n" +
"        f.write(offs.tobytes()); f.write(lens.tobytes())\n" +
"        f.write(pool)\n" +
"    t1=time.perf_counter()\n" +
"    dup_bytes=sum(len(seen[h])*(refs[h]-1) for h in seen)\n" +
"    return {'encode_s':t1-t0,'mail_v':v,'files':len(files),\n" +
"            'raw_total':raw_total,'n_total':total_blocks,'n_uniq':n,\n" +
"            'total_block_bytes':total_block_bytes,'dup_bytes':dup_bytes,\n" +
"            'blob_size':os.path.getsize(BIN)}\n" +
"\n" +
"class Blob:\n" +
"    def __init__(self,path):\n" +
"        self.f=open(path,'rb')\n" +
"        self.mm=mmap.mmap(self.f.fileno(),0,prot=mmap.PROT_READ)\n" +
"        magic,ver,n,pool_sz=struct.unpack_from('<4sIII',self.mm,0)\n" +
"        if magic!=b'MBDD' or ver!=1:\n" +
"            raise ValueError(f'bad magic/ver: {magic} {ver}')\n" +
"        self.n=n\n" +
"        base=16\n" +
"        h_off=base; o_off=h_off+8*n; l_off=o_off+4*n; pool_off=l_off+4*n\n" +
"        mv=memoryview(self.mm)\n" +
"        self.hashes=array.array('Q'); self.hashes.frombytes(bytes(mv[h_off:h_off+8*n]))\n" +
"        offs=array.array('I'); offs.frombytes(bytes(mv[o_off:o_off+4*n]))\n" +
"        lens=array.array('I'); lens.frombytes(bytes(mv[l_off:l_off+4*n]))\n" +
"        pool=bytes(mv[pool_off:pool_off+pool_sz])\n" +
"        self.blocks=[pool[offs[i]:offs[i]+lens[i]] for i in range(n)]\n" +
"    def lookup(self,h):\n" +
"        i=bisect.bisect_left(self.hashes,h)\n" +
"        if i<self.n and self.hashes[i]==h: return self.blocks[i]\n" +
"        return None\n" +
"    def close(self):\n" +
"        self.mm.close(); self.f.close()\n" +
"\n" +
"def bench():\n" +
"    info=encode()\n" +
"    print(f'[encode] {info[\"encode_s\"]*1000:.1f} ms  V{info[\"mail_v\"]}  files={info[\"files\"]}  blocks={info[\"n_total\"]}  unique={info[\"n_uniq\"]}')\n" +
"    print(f'[size] raw_emlx={fmt(info[\"raw_total\"])}  block_bytes={fmt(info[\"total_block_bytes\"])}  blob={fmt(info[\"blob_size\"])}')\n" +
"    if info['n_total']==0:\n" +
"        print('[bench] no quote blocks — skip'); return\n" +
"    dr=(info['n_total']-info['n_uniq'])/info['n_total']\n" +
"    sp=100*info['dup_bytes']/info['total_block_bytes'] if info['total_block_bytes'] else 0\n" +
"    print(f'[dedup] dup={info[\"n_total\"]-info[\"n_uniq\"]}/{info[\"n_total\"]} ({100*dr:.1f}%)  dup_bytes={fmt(info[\"dup_bytes\"])} ({sp:.1f}% of block bytes)')\n" +
"    print(f'[token] est_tokens_saved≈{info[\"dup_bytes\"]//4}  (assume 4B/tok)')\n" +
"    b=Blob(BIN)\n" +
"    rss_blob=rss()\n" +
"    sample=list(b.hashes)[:min(1000,b.n)]\n" +
"    t0=time.perf_counter()\n" +
"    hits=0\n" +
"    for h in sample:\n" +
"        if b.lookup(h) is not None: hits+=1\n" +
"    t1=time.perf_counter()\n" +
"    blob_us=(t1-t0)*1e6/max(1,len(sample))\n" +
"    print(f'[query] {len(sample)} hash lookups hits={hits}  blob mmap+bisect: {blob_us:.2f} us/query')\n" +
"    contents=b.blocks\n" +
"    sample_bodies=contents[:min(100,len(contents))]\n" +
"    t0=time.perf_counter()\n" +
"    lin_hits=0\n" +
"    for body in sample_bodies:\n" +
"        for c in contents:\n" +
"            if c==body: lin_hits+=1; break\n" +
"    t1=time.perf_counter()\n" +
"    lin_us=(t1-t0)*1e6/max(1,len(sample_bodies))\n" +
"    print(f'[query] {len(sample_bodies)} linear bytes-eq hits={lin_hits}  : {lin_us:.2f} us/query')\n" +
"    if blob_us>0: print(f'  speedup: {lin_us/blob_us:6.1f}x')\n" +
"    print(f'[rss] after blob: {fmt(rss_blob)}')\n" +
"    b.close()\n" +
"\n" +
"if mode=='encode':\n" +
"    info=encode()\n" +
"    print(f'encoded {info[\"n_uniq\"]}/{info[\"n_total\"]} unique blocks (V{info[\"mail_v\"]}) in {info[\"encode_s\"]*1000:.1f} ms → {BIN} ({fmt(info[\"blob_size\"])})')\n" +
"elif mode=='bench':\n" +
"    bench()\n" +
"else:\n" +
"    print('usage: encode|bench'); sys.exit(2)\n"

fn run() {
    let argv = args()
    let mut mode = "bench"
    let mut i = 0
    while i < len(argv) {
        let v = argv[i]
        let is_hexa_bin = v.contains("/hexa-lang/") || v == "hexa" || v == "hexa.real"
        let is_self     = v.contains("mail_body_dedup")
        if is_hexa_bin == false && is_self == false {
            if v == "encode" || v == "bench" { mode = v }
        }
        i = i + 1
    }
    let tmp_py = "/tmp/mail_body_dedup_" + exec("date +%s%N").trim() + ".py"
    write_file(tmp_py, PAYLOAD)
    let cmd = "/usr/bin/perl -e 'alarm 120; exec @ARGV' /usr/bin/python3 '" + tmp_py + "' '" + mode + "' 2>&1; rm -f '" + tmp_py + "'"
    let result = exec(cmd)
    print(result)
}

run()
