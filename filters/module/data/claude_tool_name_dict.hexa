// filters/module/data/claude_tool_name_dict.hexa
//   C9 — Claude JSONL tool_use name → 1-byte enum dict column (#99).
//
//   목적: tool_use.name 은 8~15 distinct values 만 등장 (Read/Edit/Write/Bash/
//         Grep/Glob/Task/WebFetch/...). 매번 string 비교/join 하던 hot path 를
//         1-byte enum 컬럼으로 치환. jsonl line 당 ~3-7B → 1B.
//
//   blob layout (little-endian):
//     magic   : 4B  "CTND"
//     version : 4B  u32 (1)
//     n_tools : 4B  u32 distinct tool name count (≤255)
//     n_uses  : 4B  u32 total tool_use occurrences
//     str_sz  : 4B  u32 tool name string pool size
//     [n_tools*4]: u32 name_offs
//     [n_tools*4]: u32 name_lens
//     [str_sz]   : utf-8 name pool
//     [n_uses]   : u8  enum column (sequential as encountered)
//
//   query: enum 한 byte → name_offs[id] 로 즉시 string 복원.
//
// 모드:
//   encode : ~/.claude/projects 전체 jsonl → /tmp/claude_tool_dict.bin
//   bench  : encode size 비교 + scan (count by name) old vs new
//
// R1 HEXA-FIRST: 인라인 python3.

let PAYLOAD = "import sys,os,glob,json,struct,time,array,mmap,resource\n" +
"mode=sys.argv[1] if len(sys.argv)>1 else 'bench'\n" +
"BIN='/tmp/claude_tool_dict.bin'\n" +
"HOME=os.path.expanduser('~')\n" +
"MAX_FILES=400\n" +
"\n" +
"def fmt(b):\n" +
"    if b>1048576: return f'{b/1048576:.2f}MB'\n" +
"    if b>1024: return f'{b/1024:.1f}KB'\n" +
"    return f'{b}B'\n" +
"def rss():\n" +
"    return resource.getrusage(resource.RUSAGE_SELF).ru_maxrss\n" +
"\n" +
"def find_files():\n" +
"    out=[]\n" +
"    for root in glob.glob(HOME+'/.claude/projects'):\n" +
"        for proj in os.listdir(root):\n" +
"            pdir=os.path.join(root,proj)\n" +
"            if not os.path.isdir(pdir): continue\n" +
"            for fn in os.listdir(pdir):\n" +
"                if fn.endswith('.jsonl'):\n" +
"                    out.append(os.path.join(pdir,fn))\n" +
"                    if len(out)>=MAX_FILES: return out\n" +
"    return out\n" +
"\n" +
"def collect_tool_names(files):\n" +
"    names=[]\n" +
"    raw_bytes=0\n" +
"    for fp in files:\n" +
"        try: raw_bytes+=os.path.getsize(fp)\n" +
"        except OSError: continue\n" +
"        try:\n" +
"            f=open(fp,'rb')\n" +
"        except OSError:\n" +
"            continue\n" +
"        for ln in f:\n" +
"            # quick reject\n" +
"            if b'tool_use' not in ln: continue\n" +
"            try: d=json.loads(ln)\n" +
"            except Exception: continue\n" +
"            m=d.get('message')\n" +
"            if not isinstance(m,dict): continue\n" +
"            c=m.get('content')\n" +
"            if not isinstance(c,list): continue\n" +
"            for it in c:\n" +
"                if isinstance(it,dict) and it.get('type')=='tool_use':\n" +
"                    nm=it.get('name')\n" +
"                    if isinstance(nm,str): names.append(nm)\n" +
"        f.close()\n" +
"    return names,raw_bytes\n" +
"\n" +
"def encode():\n" +
"    files=find_files()\n" +
"    t0=time.perf_counter_ns()\n" +
"    names,raw_bytes=collect_tool_names(files)\n" +
"    distinct=sorted(set(names))\n" +
"    if len(distinct)>255:\n" +
"        # fallback: top 255\n" +
"        from collections import Counter\n" +
"        cc=Counter(names).most_common(255)\n" +
"        distinct=sorted([k for k,_ in cc])\n" +
"    name_to_id={n:i for i,n in enumerate(distinct)}\n" +
"    n_tools=len(distinct); n_uses=len(names)\n" +
"    pool=bytearray()\n" +
"    name_offs=array.array('I',[0]*n_tools)\n" +
"    name_lens=array.array('I',[0]*n_tools)\n" +
"    for i,n in enumerate(distinct):\n" +
"        nb=n.encode('utf-8','replace')\n" +
"        name_offs[i]=len(pool); name_lens[i]=len(nb)\n" +
"        pool.extend(nb)\n" +
"    enum_col=bytearray(n_uses)\n" +
"    for i,n in enumerate(names):\n" +
"        enum_col[i]=name_to_id.get(n,0)\n" +
"    header=struct.pack('<4sIIII',b'CTND',1,n_tools,n_uses,len(pool))\n" +
"    with open(BIN,'wb') as f:\n" +
"        f.write(header)\n" +
"        f.write(name_offs.tobytes()); f.write(name_lens.tobytes())\n" +
"        f.write(bytes(pool))\n" +
"        f.write(bytes(enum_col))\n" +
"    t1=time.perf_counter_ns()\n" +
"    # baseline byte cost: sum(len(name)+8 quotes/key) per use ≈ name+10\n" +
"    raw_name_bytes=sum(len(n)+10 for n in names)\n" +
"    return {'encode_ns':t1-t0,'n_tools':n_tools,'n_uses':n_uses,'distinct':distinct,'names':names,\n" +
"            'raw_bytes':raw_bytes,'raw_name_bytes':raw_name_bytes,'blob_size':os.path.getsize(BIN),\n" +
"            'files':len(files)}\n" +
"\n" +
"class ToolDict:\n" +
"    def __init__(self,path):\n" +
"        self.f=open(path,'rb')\n" +
"        self.mm=mmap.mmap(self.f.fileno(),0,prot=mmap.PROT_READ)\n" +
"        magic,ver,n_tools,n_uses,str_sz=struct.unpack_from('<4sIIII',self.mm,0)\n" +
"        assert magic==b'CTND' and ver==1\n" +
"        self.n_tools=n_tools; self.n_uses=n_uses\n" +
"        base=20\n" +
"        self.name_offs=array.array('I'); self.name_offs.frombytes(self.mm[base:base+4*n_tools])\n" +
"        b1=base+4*n_tools\n" +
"        self.name_lens=array.array('I'); self.name_lens.frombytes(self.mm[b1:b1+4*n_tools])\n" +
"        b2=b1+4*n_tools\n" +
"        self.pool=bytes(self.mm[b2:b2+str_sz])\n" +
"        b3=b2+str_sz\n" +
"        self.enum_col=bytes(self.mm[b3:b3+n_uses])\n" +
"        self.names=[self.pool[self.name_offs[i]:self.name_offs[i]+self.name_lens[i]].decode('utf-8','replace') for i in range(n_tools)]\n" +
"    def count_by_name(self):\n" +
"        c=[0]*self.n_tools\n" +
"        for b in self.enum_col:\n" +
"            c[b]+=1\n" +
"        return list(zip(self.names,c))\n" +
"    def close(self):\n" +
"        self.mm.close(); self.f.close()\n" +
"\n" +
"def old_count(names):\n" +
"    from collections import Counter\n" +
"    return Counter(names)\n" +
"\n" +
"def bench():\n" +
"    info=encode()\n" +
"    print(f'[encode] {info[\"encode_ns\"]/1e6:.1f}ms files={info[\"files\"]} tools={info[\"n_tools\"]} uses={info[\"n_uses\"]}')\n" +
"    print(f'  raw_jsonl_size={fmt(info[\"raw_bytes\"])} raw_name_bytes={fmt(info[\"raw_name_bytes\"])} blob={fmt(info[\"blob_size\"])}')\n" +
"    if info['n_uses']==0:\n" +
"        print('[bench] no tool_use — skip'); return\n" +
"    print(f'  distinct names: {info[\"distinct\"]}')\n" +
"    saved_pct=((info['raw_name_bytes']-info['n_uses'])*100)//max(info['raw_name_bytes'],1)\n" +
"    print(f'  name col bytes raw≈{info[\"raw_name_bytes\"]} → enum={info[\"n_uses\"]}B  saved={saved_pct}%')\n" +
"    td=ToolDict(BIN)\n" +
"    # NEW count by enum column\n" +
"    t0=time.perf_counter_ns()\n" +
"    cb=td.count_by_name()\n" +
"    t1=time.perf_counter_ns()\n" +
"    new_ns=t1-t0\n" +
"    # OLD count by Counter on string list\n" +
"    t0=time.perf_counter_ns()\n" +
"    cc=old_count(info['names'])\n" +
"    t1=time.perf_counter_ns()\n" +
"    old_ns=t1-t0\n" +
"    td.close()\n" +
"    print(f'  count by name OLD (Counter on str list)  : {old_ns:10d} ns')\n" +
"    print(f'  count by name NEW (u8 enum column scan)  : {new_ns:10d} ns')\n" +
"    if new_ns>0:\n" +
"        print(f'  speedup={old_ns/new_ns:.1f}x  saved={((old_ns-new_ns)*100)//max(old_ns,1)}%')\n" +
"    # diff_test\n" +
"    a=sorted(cb); b=sorted(cc.items())\n" +
"    mm=0\n" +
"    for x,y in zip(a,b):\n" +
"        if x[0]!=y[0] or x[1]!=y[1]: mm+=1\n" +
"    print(f'  diff_test mismatches: {mm}')\n" +
"    print(f'[rss] {fmt(rss())}')\n" +
"\n" +
"if mode=='encode':\n" +
"    info=encode()\n" +
"    print(f'encoded {info[\"n_uses\"]} uses ({info[\"n_tools\"]} distinct) in {info[\"encode_ns\"]/1e6:.1f}ms → {BIN} ({fmt(info[\"blob_size\"])})')\n" +
"elif mode=='bench':\n" +
"    bench()\n" +
"else:\n" +
"    print('usage: encode|bench'); sys.exit(2)\n"

fn run() {
    let argv = args()
    let mut mode = "bench"
    let mut i = 0
    while i < len(argv) {
        let v = argv[i]
        let is_hexa_bin = v.contains("/hexa-lang/") || v == "hexa" || v == "hexa.real"
        let is_self     = v.contains("claude_tool_name_dict")
        if is_hexa_bin == false && is_self == false {
            if v == "encode" || v == "bench" { mode = v }
        }
        i = i + 1
    }
    let tmp_py = "/tmp/claude_tool_dict_" + exec("date +%s%N").trim() + ".py"
    write_file(tmp_py, PAYLOAD)
    let cmd = "/usr/bin/perl -e 'alarm 120; exec @ARGV' /usr/bin/python3 '" + tmp_py + "' '" + mode + "' 2>&1; rm -f '" + tmp_py + "'"
    let result = exec(cmd)
    print(result)
}

run()
