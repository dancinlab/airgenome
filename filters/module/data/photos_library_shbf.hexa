// airgenome/filters/module/data/photos_library_shbf.hexa
//   SY1 — Photos.app library SHBF (PSBF — Photos Sqlite Blob Filter).
//
//   목적: Photos Library.photoslibrary/database/Photos.sqlite 의
//         (asset_id, creation_date, filename) 를 매번 sqlite open + B-tree walk
//         하던 hot path 를 단일 mmap blob 으로 치환. filename prefix bisect O(log n).
//
//   blob layout (little-endian):
//     magic   : 4B  "PSBF"          (Photos Sqlite Blob Filter)
//     version : 4B  u32             (1)
//     n       : 4B  u32             asset 개수
//     str_sz  : 4B  u32             string pool 바이트 길이 (filename pool)
//     [n*4]   : u32 fn_off          정렬된 filename 의 pool 시작
//     [n*4]   : u32 fn_len          filename 길이
//     [n*8]   : u64 asset_id        sqlite ZASSET.Z_PK
//     [n*8]   : u64 creation_date   Cocoa epoch (2001-01-01) seconds * 1e6 (us)
//     [str_sz]: utf-8 string pool   filename raw bytes (NUL 없음)
//
//   query: filename prefix bisect_left 두 번 → range. range 안에서 ts 내림차순 top-K.
//
// 모드:
//   encode <Photos.sqlite> : → /tmp/photos_library_psbf.bin
//   bench  <Photos.sqlite> : encode + sqlite per-query open vs PSBF mmap+bisect
//
// E4/F18 와 다른 점:
//   - source = Cocoa-epoch timestamp (sqlite NSDate float). second*1e6 정수 변환.
//   - filename 은 ZADDITIONALASSETATTRIBUTES.ZORIGINALFILENAME (없으면 ZFILENAME fallback).
//   - TCC Photos 권한 필요 — 미부여 시 synthetic fallback (run() 측 file_exists 분기).
//
// R1 HEXA-FIRST: 인라인 python3 페이로드 (.py 신규 없음). raw 9 hexa-only.
// R17: /usr/bin/perl alarm 120s wrapper. /usr/bin/python3 절대경로. try/catch 0.

let PAYLOAD = "import sys,os,sqlite3,struct,time,bisect,heapq,resource,mmap,array,tempfile,random\n" +
"mode=sys.argv[1]; src=sys.argv[2]\n" +
"BIN='/tmp/photos_library_psbf.bin'\n" +
"\n" +
"def fmt(b):\n" +
"    if b>1048576: return f'{b/1048576:.2f}MB'\n" +
"    if b>1024: return f'{b/1024:.1f}KB'\n" +
"    return f'{b}B'\n" +
"def rss():\n" +
"    r=resource.getrusage(resource.RUSAGE_SELF).ru_maxrss\n" +
"    if sys.platform=='darwin': return r\n" +
"    return r*1024\n" +
"def to_int_safe(v):\n" +
"    if v is None: return 0\n" +
"    if isinstance(v,int): return v\n" +
"    if isinstance(v,float): return int(v)\n" +
"    if isinstance(v,str) and v.isdigit(): return int(v)\n" +
"    return 0\n" +
"\n" +
"SYNTH_MARK='__SYNTH__'\n" +
"def synth_rows(n=2000):\n" +
"    rng=random.Random(42)\n" +
"    out=[]\n" +
"    for i in range(n):\n" +
"        fn=f'IMG_{i:05d}.HEIC'\n" +
"        cd=int(time.time()*1e6)-i*86400000\n" +
"        out.append((i+1,cd,fn))\n" +
"    return out\n" +
"\n" +
"def safe_copy_sqlite(src):\n" +
"    tmp=tempfile.NamedTemporaryFile(suffix='.sqlite',delete=False); tmp.close()\n" +
"    sc=sqlite3.connect(f'file:{src}?mode=ro',uri=True)\n" +
"    dc=sqlite3.connect(tmp.name)\n" +
"    sc.backup(dc); dc.close(); sc.close()\n" +
"    return tmp.name\n" +
"\n" +
"def load_real(src):\n" +
"    copy=safe_copy_sqlite(src)\n" +
"    conn=sqlite3.connect(copy)\n" +
"    conn.row_factory=None\n" +
"    rows=[]\n" +
"    cur=conn.cursor()\n" +
"    candidate_sqls=[\n" +
"      'SELECT a.Z_PK, a.ZDATECREATED, COALESCE(att.ZORIGINALFILENAME, a.ZFILENAME) FROM ZASSET a LEFT JOIN ZADDITIONALASSETATTRIBUTES att ON att.ZASSET=a.Z_PK',\n" +
"      'SELECT Z_PK, ZDATECREATED, ZFILENAME FROM ZASSET',\n" +
"      'SELECT Z_PK, ZADDEDDATE, ZFILENAME FROM ZGENERICASSET',\n" +
"    ]\n" +
"    chosen=None\n" +
"    for q in candidate_sqls:\n" +
"        ok=True\n" +
"        for r in cur.execute(q+' LIMIT 1'):\n" +
"            ok=True; break\n" +
"        if cur.description is not None:\n" +
"            chosen=q; break\n" +
"    if chosen is None:\n" +
"        conn.close(); os.unlink(copy)\n" +
"        return synth_rows(2000),True\n" +
"    for r in conn.execute(chosen):\n" +
"        pk=to_int_safe(r[0])\n" +
"        cd_raw=r[1]\n" +
"        cd=int((float(cd_raw) if cd_raw is not None else 0)*1e6)\n" +
"        fn=(r[2] or '').strip()\n" +
"        if not fn: continue\n" +
"        rows.append((pk,cd,fn))\n" +
"    conn.close(); os.unlink(copy)\n" +
"    if not rows: return synth_rows(2000),True\n" +
"    return rows,False\n" +
"\n" +
"def encode_rows(rows):\n" +
"    rows=sorted(rows,key=lambda r:r[2])\n" +
"    n=len(rows)\n" +
"    pool=bytearray()\n" +
"    fn_off=array.array('I',[0]*n); fn_len=array.array('I',[0]*n)\n" +
"    aid=array.array('Q',[0]*n); cdate=array.array('Q',[0]*n)\n" +
"    for i,(pk,cd,fn) in enumerate(rows):\n" +
"        fb=fn.encode('utf-8','replace')\n" +
"        fn_off[i]=len(pool); fn_len[i]=len(fb); pool.extend(fb)\n" +
"        aid[i]=int(pk)&0xffffffffffffffff\n" +
"        cdate[i]=int(cd)&0xffffffffffffffff\n" +
"    header=struct.pack('<4sIII',b'PSBF',1,n,len(pool))\n" +
"    with open(BIN,'wb') as f:\n" +
"        f.write(header)\n" +
"        f.write(fn_off.tobytes()); f.write(fn_len.tobytes())\n" +
"        f.write(aid.tobytes()); f.write(cdate.tobytes())\n" +
"        f.write(pool)\n" +
"    return n,os.path.getsize(BIN)\n" +
"\n" +
"def encode(src):\n" +
"    t0=time.perf_counter()\n" +
"    if src==SYNTH_MARK or not os.path.exists(src):\n" +
"        rows=synth_rows(2000); synth=True\n" +
"    else:\n" +
"        rows,synth=load_real(src)\n" +
"    n,bsz=encode_rows(rows)\n" +
"    t1=time.perf_counter()\n" +
"    return {'encode_s':t1-t0,'n':n,'blob_size':bsz,'synth':synth,'rows':rows}\n" +
"\n" +
"class Blob:\n" +
"    def __init__(self,path):\n" +
"        self.f=open(path,'rb')\n" +
"        self.mm=mmap.mmap(self.f.fileno(),0,prot=mmap.PROT_READ)\n" +
"        magic,ver,n,pool_sz=struct.unpack_from('<4sIII',self.mm,0)\n" +
"        assert magic==b'PSBF' and ver==1\n" +
"        self.n=n; self.pool_sz=pool_sz\n" +
"        base=16\n" +
"        self.fn_off_off=base\n" +
"        self.fn_len_off=base+4*n\n" +
"        self.aid_off  =base+8*n\n" +
"        self.cd_off   =base+8*n+8*n\n" +
"        self.pool_off =base+8*n+16*n\n" +
"        self.mv=memoryview(self.mm)\n" +
"        fn_off=array.array('I'); fn_off.frombytes(bytes(self.mv[self.fn_off_off:self.fn_off_off+4*n]))\n" +
"        fn_len=array.array('I'); fn_len.frombytes(bytes(self.mv[self.fn_len_off:self.fn_len_off+4*n]))\n" +
"        aid   =array.array('Q'); aid.frombytes(bytes(self.mv[self.aid_off:self.aid_off+8*n]))\n" +
"        cd    =array.array('Q'); cd.frombytes(bytes(self.mv[self.cd_off:self.cd_off+8*n]))\n" +
"        pool=bytes(self.mv[self.pool_off:self.pool_off+pool_sz])\n" +
"        self.fns=[pool[fn_off[i]:fn_off[i]+fn_len[i]] for i in range(n)]\n" +
"        self.aid=aid; self.cd=cd\n" +
"    def prefix_topk(self,prefix,k=10):\n" +
"        pb=prefix.encode('utf-8') if isinstance(prefix,str) else prefix\n" +
"        s=bisect.bisect_left(self.fns,pb)\n" +
"        e=bisect.bisect_left(self.fns,pb+b'\\xff\\xff\\xff\\xff')\n" +
"        if e==s: return []\n" +
"        if e-s<=k: idxs=list(range(s,e))\n" +
"        else: idxs=heapq.nlargest(k,range(s,e),key=lambda i:self.cd[i])\n" +
"        idxs.sort(key=lambda i:-self.cd[i])\n" +
"        return [(self.fns[i].decode('utf-8','replace'),int(self.aid[i]),int(self.cd[i])) for i in idxs]\n" +
"    def close(self):\n" +
"        self.mv.release(); self.mm.close(); self.f.close()\n" +
"\n" +
"def bench(src):\n" +
"    info=encode(src)\n" +
"    tag=' (synth fallback)' if info['synth'] else ''\n" +
"    print(f'[encode] {info[\"encode_s\"]*1000:.1f} ms  assets={info[\"n\"]}  blob={fmt(info[\"blob_size\"])}{tag}')\n" +
"    if info['n']==0:\n" +
"        print('[bench] empty — skip'); return\n" +
"    rows=info['rows']\n" +
"    b=Blob(BIN)\n" +
"    rng=random.Random(42)\n" +
"    samples=[]\n" +
"    for _ in range(100):\n" +
"        i=rng.randrange(b.n)\n" +
"        u=b.fns[i].decode('utf-8','replace')\n" +
"        plen=rng.choice([3,4,5])\n" +
"        samples.append(u[:plen] if len(u)>=plen else u)\n" +
"    for p in samples[:5]: b.prefix_topk(p,10)\n" +
"    t0=time.perf_counter()\n" +
"    blob_hits=0\n" +
"    for p in samples:\n" +
"        blob_hits+=len(b.prefix_topk(p,10))\n" +
"    t1=time.perf_counter()\n" +
"    blob_us=(t1-t0)*1e6/len(samples)\n" +
"    rss_blob=rss()\n" +
"    b.close()\n" +
"    sql_hits=0\n" +
"    if not info['synth']:\n" +
"        copy=safe_copy_sqlite(src)\n" +
"        t0=time.perf_counter()\n" +
"        for p in samples[:25]:\n" +
"            c=sqlite3.connect(copy)\n" +
"            cur=c.execute('SELECT Z_PK,ZDATECREATED,ZFILENAME FROM ZASSET WHERE ZFILENAME>=? AND ZFILENAME<? LIMIT 10',(p,p+'\\uffff'))\n" +
"            sql_hits+=len(cur.fetchall())\n" +
"            c.close()\n" +
"        t1=time.perf_counter()\n" +
"        sql_us=(t1-t0)*1e6/25\n" +
"        os.unlink(copy)\n" +
"    else:\n" +
"        rows_sorted=sorted(rows,key=lambda r:r[2])\n" +
"        t0=time.perf_counter()\n" +
"        for p in samples:\n" +
"            for (pk,cd,fn) in rows_sorted:\n" +
"                if fn.startswith(p): pass\n" +
"        t1=time.perf_counter()\n" +
"        sql_us=(t1-t0)*1e6/len(samples)\n" +
"    print(f'[query] 100 prefix-topK-10 (blob hits={blob_hits} sql/linear hits={sql_hits})')\n" +
"    print(f'  baseline (sqlite cold or linear): {sql_us:10.1f} us')\n" +
"    print(f'  blob mmap + bisect             : {blob_us:10.1f} us')\n" +
"    if blob_us>0:\n" +
"        print(f'  speedup: {sql_us/blob_us:6.1f}x')\n" +
"    print(f'[rss] blob loaded: {fmt(rss_blob)}')\n" +
"\n" +
"if mode=='encode':\n" +
"    info=encode(src)\n" +
"    print(f'encoded {info[\"n\"]} assets in {info[\"encode_s\"]*1000:.1f} ms → {BIN} ({fmt(info[\"blob_size\"])})' + (' synth' if info['synth'] else ''))\n" +
"elif mode=='bench':\n" +
"    bench(src)\n" +
"else:\n" +
"    print('usage: encode|bench <Photos.sqlite>'); sys.exit(2)\n"

fn run() {
    let argv = args()
    let mut mode = "bench"
    let mut target = ""
    let mut i = 0
    while i < len(argv) {
        let v = argv[i]
        let is_hexa_bin = v.contains("/hexa-lang/") || v == "hexa" || v == "hexa.real"
        let is_self     = v.contains("photos_library_shbf")
        if is_hexa_bin == false && is_self == false {
            if v == "encode" || v == "bench" { mode = v }
            else if v.contains(".sqlite") || v.contains(".db") { target = v }
        }
        i = i + 1
    }
    if len(target) == 0 {
        target = env("HOME") + "/Pictures/Photos Library.photoslibrary/database/Photos.sqlite"
        println("(default target: " + target + ")")
    }
    if file_exists(target) == false {
        println("(target not found / TCC denied — using synthetic fallback)")
        target = "__SYNTH__"
    }
    let tmp_py = "/tmp/photos_library_shbf_" + exec("date +%s%N").trim() + ".py"
    write_file(tmp_py, PAYLOAD)
    let cmd = "/usr/bin/perl -e 'alarm 120; exec @ARGV' /usr/bin/python3 '" + tmp_py + "' '" + mode + "' '" + target + "' 2>&1; rm -f '" + tmp_py + "'"
    let result = exec(cmd)
    print(result)
}

run()
