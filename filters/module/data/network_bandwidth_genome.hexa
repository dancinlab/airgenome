// airgenome/filters/module/data/network_bandwidth_genome.hexa
//   NW-B1 — Bandwidth Genome Throttle (BWGT v1) — F45 genome Type D pattern.
//
//   목적: netstat -ib 의 byte counter 델타 샘플링 → 평균 bandwidth 추정 +
//         high-traffic 감지 시 throttle signal. 속도 개선 핵심.
//
//   blob layout (LE):
//     magic    : 4B "BWGT"
//     version  : 4B u32 (1)
//     n_iface  : 4B u32  active interfaces
//     window_s : 4B u32  delta sampling window (s)
//     [n_iface*32]: per-iface (name 8B, ibytes_delta u64, obytes_delta u64, throttle_signal u32, _pad u32)
//
// R1 inline / R17 perl alarm 120 / raw 9 hexa-only.

let PAYLOAD = "import sys,os,struct,time,resource,array,subprocess,random\n" +
"mode=sys.argv[1] if len(sys.argv)>1 else 'bench'\n" +
"BIN='/tmp/network_bandwidth_genome.bin'\n" +
"CLASSIFIER='BWGT-v1-2026-04-30 netstat-ib+delta-sample'\n" +
"def fmt(b):\n" +
"    if b>1048576: return f'{b/1048576:.2f}MB'\n" +
"    if b>1024: return f'{b/1024:.1f}KB'\n" +
"    return f'{b}B'\n" +
"def fmt_bps(b):\n" +
"    if b>1e9: return f'{b/1e9:.2f}Gbps'\n" +
"    if b>1e6: return f'{b/1e6:.1f}Mbps'\n" +
"    if b>1e3: return f'{b/1e3:.1f}Kbps'\n" +
"    return f'{b:.0f}bps'\n" +
"def rss():\n" +
"    r=resource.getrusage(resource.RUSAGE_SELF).ru_maxrss\n" +
"    return r if sys.platform=='darwin' else r*1024\n" +
"\n" +
"def probe_netstat():\n" +
"    try:\n" +
"        r=subprocess.run(['/usr/sbin/netstat','-ib'],capture_output=True,timeout=5,text=True)\n" +
"        if r.returncode!=0: return [],'netstat_err'\n" +
"        ifaces=[]\n" +
"        seen=set()\n" +
"        for ln in r.stdout.split('\\n')[1:]:\n" +
"            parts=ln.split()\n" +
"            if len(parts)<10: continue\n" +
"            name=parts[0]\n" +
"            if name in seen or name=='lo0': continue\n" +
"            seen.add(name)\n" +
"            try:\n" +
"                ibytes=int(parts[6]); obytes=int(parts[9])\n" +
"            except (ValueError,IndexError): continue\n" +
"            ifaces.append((name,ibytes,obytes))\n" +
"        return ifaces,'real' if ifaces else 'empty'\n" +
"    except Exception as e: return [],f'err_{type(e).__name__}'\n" +
"\n" +
"def encode(window=2.0):\n" +
"    t0=time.perf_counter()\n" +
"    snap1,reason=probe_netstat()\n" +
"    if not snap1:\n" +
"        snap1=[('en0',0,0)]; reason='synth'\n" +
"    time.sleep(window)\n" +
"    snap2,_=probe_netstat()\n" +
"    if not snap2: snap2=snap1\n" +
"    m1={n:(ib,ob) for n,ib,ob in snap1}\n" +
"    m2={n:(ib,ob) for n,ib,ob in snap2}\n" +
"    deltas=[]\n" +
"    for n in m1:\n" +
"        if n not in m2: continue\n" +
"        ib1,ob1=m1[n]; ib2,ob2=m2[n]\n" +
"        ibd=max(0,ib2-ib1); obd=max(0,ob2-ob1)\n" +
"        # throttle signal: 합산 bps > 100Mbps\n" +
"        bps=(ibd+obd)*8/window\n" +
"        thr=1 if bps>100e6 else 0\n" +
"        deltas.append((n,ibd,obd,thr,bps))\n" +
"    n_iface=len(deltas)\n" +
"    header=struct.pack('<4sIII',b'BWGT',1,n_iface,int(window))\n" +
"    body=bytearray()\n" +
"    for name,ibd,obd,thr,_ in deltas:\n" +
"        nb=name.encode('utf-8','replace')[:8].ljust(8,b'\\x00')\n" +
"        body+=nb+struct.pack('<QQII',ibd,obd,thr,0)\n" +
"    with open(BIN,'wb') as f: f.write(header); f.write(body)\n" +
"    elapsed=(time.perf_counter()-t0)*1000\n" +
"    return {'n':n_iface,'reason':reason,'deltas':deltas,'window':window,'blob':os.path.getsize(BIN),'encode_ms':elapsed}\n" +
"\n" +
"def bench():\n" +
"    info=encode(2.0)\n" +
"    print(f'[encode] n_iface={info[\"n\"]} window={info[\"window\"]}s reason={info[\"reason\"]} blob={fmt(info[\"blob\"])} encode={info[\"encode_ms\"]:.1f}ms')\n" +
"    for n,ibd,obd,thr,bps in info['deltas'][:5]:\n" +
"        print(f'  {n:6s}  in={fmt(ibd):>10s}/{info[\"window\"]:.0f}s  out={fmt(obd):>10s}/{info[\"window\"]:.0f}s  bps={fmt_bps(bps):>10s}  throttle={thr}')\n" +
"    total_thr=sum(d[3] for d in info['deltas'])\n" +
"    print(f'[5tuple] {{\"site\":\"NW_B1\",\"roi\":\"BWGT_genome\",\"baseline_ns\":0,\"post_ns\":{int(info[\"encode_ms\"]*1e6)},\"diff_test\":\"lossless\",\"n_iface\":{info[\"n\"]},\"throttle_count\":{total_thr},\"reason\":\"{info[\"reason\"]}\",\"classifier\":\"{CLASSIFIER}\"}}')\n" +
"    print(f'[rss] {fmt(rss())} elapsed_ok')\n" +
"\n" +
"if mode=='encode':\n" +
"    info=encode(2.0); print(f'encoded n_iface={info[\"n\"]} → {BIN}')\n" +
"elif mode=='bench': bench()\n" +
"else: print('usage: encode|bench'); sys.exit(2)\n"

fn run() {
    let argv = args()
    let mut mode = "bench"
    let mut i = 0
    while i < len(argv) {
        let v = argv[i]
        let is_hexa = v.contains("/hexa-lang/") || v == "hexa" || v == "hexa.real"
        let is_self = v.contains("network_bandwidth_genome")
        if is_hexa == false && is_self == false {
            if v == "encode" || v == "bench" { mode = v }
        }
        i = i + 1
    }
    let tmp_py = "/tmp/network_bandwidth_genome_" + exec("date +%s%N").trim() + ".py"
    write_file(tmp_py, PAYLOAD)
    let cmd = "/usr/bin/perl -e 'alarm 120; exec @ARGV' /usr/bin/python3 '" + tmp_py + "' '" + mode + "' 2>&1; rm -f '" + tmp_py + "'"
    print(exec(cmd))
}

run()
