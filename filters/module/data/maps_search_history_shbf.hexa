// airgenome/filters/module/data/maps_search_history_shbf.hexa
//   SY3 — Maps.app search history SHBF (MapsBF — Maps Search Blob Filter).
//
//   목적: Maps 의 검색 history (~/Library/Containers/com.apple.Maps/Data/Library/
//         Maps/MapsSync_*.db 또는 plist) 의 (query, ts) 튜플을 단일 mmap blob
//         으로. query prefix bisect O(log n) — autocomplete hot path.
//
//   blob layout (little-endian):
//     magic   : 4B  "MapsBF"[6]→4B  "MPBF" (Maps Blob Filter)
//     version : 4B  u32             (1)
//     n       : 4B  u32             query 개수
//     str_sz  : 4B  u32             string pool 바이트 길이
//     [n*4]   : u32 q_off           query pool 시작 (정렬된 query 순)
//     [n*4]   : u32 q_len           query 길이
//     [n*8]   : u64 ts_us           unix epoch us
//     [str_sz]: utf-8 string pool   raw bytes (NUL 없음)
//
//   query: query prefix bisect_left 두 번 → range → ts 내림차순 top-K.
//
// 모드:
//   encode <MapsSync.db | __SYNTH__> : → /tmp/maps_search_msbf.bin
//   bench  <...> : encode + sqlite per-query open vs MPBF mmap+bisect
//
// E4/F18 와 다른 점:
//   - source = MapsSync_*.db (sqlite, schema 비공개) — table 이름 best-effort
//     (ZHGSEARCHHISTORY 등) probe → 실패 시 synthetic fallback.
//   - TCC Maps 권한 / sandbox container 접근 한정.
//
// R1 HEXA-FIRST: 인라인 python3 페이로드 (.py 신규 없음). raw 9 hexa-only.
// R17: /usr/bin/perl alarm 120s wrapper. try/catch 0.

let PAYLOAD = "import sys,os,sqlite3,struct,time,bisect,heapq,resource,mmap,array,random,tempfile\n" +
"mode=sys.argv[1]; src=sys.argv[2]\n" +
"BIN='/tmp/maps_search_mpbf.bin'\n" +
"\n" +
"def fmt(b):\n" +
"    if b>1048576: return f'{b/1048576:.2f}MB'\n" +
"    if b>1024: return f'{b/1024:.1f}KB'\n" +
"    return f'{b}B'\n" +
"def rss():\n" +
"    r=resource.getrusage(resource.RUSAGE_SELF).ru_maxrss\n" +
"    if sys.platform=='darwin': return r\n" +
"    return r*1024\n" +
"def to_int_safe(v):\n" +
"    if v is None: return 0\n" +
"    if isinstance(v,int): return v\n" +
"    if isinstance(v,float): return int(v)\n" +
"    if isinstance(v,str) and v.isdigit(): return int(v)\n" +
"    return 0\n" +
"\n" +
"SYNTH_MARK='__SYNTH__'\n" +
"PLACES=['Starbucks','Apple Park','Yosemite','SFO','LAX','JFK','Times Square','Eiffel Tower','Tokyo Station','Seoul','Busan','Jeju','Gangnam','Hongdae','Itaewon','New York','Boston','Seattle','Austin','Denver']\n" +
"def synth_rows(n=1500):\n" +
"    rng=random.Random(42)\n" +
"    now=int(time.time()*1e6)\n" +
"    out=[]\n" +
"    for i in range(n):\n" +
"        p=PLACES[i%len(PLACES)]\n" +
"        q=f'{p} {i%50}'\n" +
"        ts=now-i*60_000_000\n" +
"        out.append((q,ts))\n" +
"    return out\n" +
"\n" +
"def safe_copy_sqlite(src):\n" +
"    tmp=tempfile.NamedTemporaryFile(suffix='.sqlite',delete=False); tmp.close()\n" +
"    sc=sqlite3.connect(f'file:{src}?mode=ro',uri=True)\n" +
"    dc=sqlite3.connect(tmp.name)\n" +
"    sc.backup(dc); dc.close(); sc.close()\n" +
"    return tmp.name\n" +
"\n" +
"def list_tables(conn):\n" +
"    out=[]\n" +
"    for r in conn.execute(\"SELECT name FROM sqlite_master WHERE type='table'\"):\n" +
"        out.append(r[0])\n" +
"    return out\n" +
"\n" +
"def list_cols(conn,t):\n" +
"    out=[]\n" +
"    for r in conn.execute(f'PRAGMA table_info(\"{t}\")'):\n" +
"        out.append(r[1])\n" +
"    return out\n" +
"\n" +
"def load_real(src):\n" +
"    copy=safe_copy_sqlite(src)\n" +
"    conn=sqlite3.connect(copy)\n" +
"    rows=[]\n" +
"    tables=list_tables(conn)\n" +
"    for t in tables:\n" +
"        cols=list_cols(conn,t)\n" +
"        cols_lower=[c.lower() for c in cols]\n" +
"        q_col=None; ts_col=None\n" +
"        for c in cols:\n" +
"            cl=c.lower()\n" +
"            if q_col is None and ('query' in cl or 'searchstring' in cl or 'displayquery' in cl or 'name' in cl):\n" +
"                q_col=c\n" +
"            if ts_col is None and ('timestamp' in cl or 'date' in cl or 'created' in cl):\n" +
"                ts_col=c\n" +
"        if q_col is None: continue\n" +
"        sel=f'SELECT \"{q_col}\"' + (f',\"{ts_col}\"' if ts_col else ',NULL') + f' FROM \"{t}\"'\n" +
"        for r in conn.execute(sel):\n" +
"            qv=r[0]; tv=r[1]\n" +
"            if not isinstance(qv,str) or not qv.strip(): continue\n" +
"            ts=int(float(tv)*1e6) if isinstance(tv,(int,float)) else 0\n" +
"            rows.append((qv.strip(),ts))\n" +
"        if rows: break\n" +
"    conn.close(); os.unlink(copy)\n" +
"    if not rows: return synth_rows(1500),True\n" +
"    return rows,False\n" +
"\n" +
"def encode_rows(rows):\n" +
"    rows=sorted(rows,key=lambda r:r[0])\n" +
"    n=len(rows)\n" +
"    pool=bytearray()\n" +
"    q_off=array.array('I',[0]*n); q_len=array.array('I',[0]*n)\n" +
"    ts=array.array('Q',[0]*n)\n" +
"    for i,(q,t) in enumerate(rows):\n" +
"        qb=q.encode('utf-8','replace')\n" +
"        q_off[i]=len(pool); q_len[i]=len(qb); pool.extend(qb)\n" +
"        ts[i]=int(t)&0xffffffffffffffff\n" +
"    header=struct.pack('<4sIII',b'MPBF',1,n,len(pool))\n" +
"    with open(BIN,'wb') as f:\n" +
"        f.write(header)\n" +
"        f.write(q_off.tobytes()); f.write(q_len.tobytes())\n" +
"        f.write(ts.tobytes()); f.write(pool)\n" +
"    return n,os.path.getsize(BIN)\n" +
"\n" +
"def encode(src):\n" +
"    t0=time.perf_counter()\n" +
"    if src==SYNTH_MARK or not os.path.exists(src):\n" +
"        rows=synth_rows(1500); synth=True\n" +
"    else:\n" +
"        rows,synth=load_real(src)\n" +
"    n,bsz=encode_rows(rows)\n" +
"    t1=time.perf_counter()\n" +
"    return {'encode_s':t1-t0,'n':n,'blob_size':bsz,'synth':synth,'rows':rows}\n" +
"\n" +
"class Blob:\n" +
"    def __init__(self,path):\n" +
"        self.f=open(path,'rb')\n" +
"        self.mm=mmap.mmap(self.f.fileno(),0,prot=mmap.PROT_READ)\n" +
"        magic,ver,n,pool_sz=struct.unpack_from('<4sIII',self.mm,0)\n" +
"        assert magic==b'MPBF' and ver==1\n" +
"        self.n=n; self.pool_sz=pool_sz\n" +
"        base=16\n" +
"        q_off_off=base\n" +
"        q_len_off=base+4*n\n" +
"        ts_off  =base+8*n\n" +
"        self.pool_off=base+8*n+8*n\n" +
"        self.mv=memoryview(self.mm)\n" +
"        q_off=array.array('I'); q_off.frombytes(bytes(self.mv[q_off_off:q_off_off+4*n]))\n" +
"        q_len=array.array('I'); q_len.frombytes(bytes(self.mv[q_len_off:q_len_off+4*n]))\n" +
"        ts=array.array('Q'); ts.frombytes(bytes(self.mv[ts_off:ts_off+8*n]))\n" +
"        pool=bytes(self.mv[self.pool_off:self.pool_off+pool_sz])\n" +
"        self.qs=[pool[q_off[i]:q_off[i]+q_len[i]] for i in range(n)]\n" +
"        self.ts=ts\n" +
"    def prefix_topk(self,prefix,k=10):\n" +
"        pb=prefix.encode('utf-8') if isinstance(prefix,str) else prefix\n" +
"        s=bisect.bisect_left(self.qs,pb)\n" +
"        e=bisect.bisect_left(self.qs,pb+b'\\xff\\xff\\xff\\xff')\n" +
"        if e==s: return []\n" +
"        if e-s<=k: idxs=list(range(s,e))\n" +
"        else: idxs=heapq.nlargest(k,range(s,e),key=lambda i:self.ts[i])\n" +
"        idxs.sort(key=lambda i:-self.ts[i])\n" +
"        return [(self.qs[i].decode('utf-8','replace'),int(self.ts[i])) for i in idxs]\n" +
"    def close(self):\n" +
"        self.mv.release(); self.mm.close(); self.f.close()\n" +
"\n" +
"def bench(src):\n" +
"    info=encode(src)\n" +
"    tag=' (synth fallback)' if info['synth'] else ''\n" +
"    print(f'[encode] {info[\"encode_s\"]*1000:.1f} ms  queries={info[\"n\"]}  blob={fmt(info[\"blob_size\"])}{tag}')\n" +
"    if info['n']==0:\n" +
"        print('[bench] empty — skip'); return\n" +
"    rows=info['rows']\n" +
"    b=Blob(BIN)\n" +
"    rng=random.Random(42)\n" +
"    samples=[]\n" +
"    for _ in range(100):\n" +
"        i=rng.randrange(b.n)\n" +
"        u=b.qs[i].decode('utf-8','replace')\n" +
"        plen=rng.choice([2,3,4,5])\n" +
"        samples.append(u[:plen] if len(u)>=plen else u)\n" +
"    for p in samples[:5]: b.prefix_topk(p,10)\n" +
"    t0=time.perf_counter()\n" +
"    blob_hits=0\n" +
"    for p in samples:\n" +
"        blob_hits+=len(b.prefix_topk(p,10))\n" +
"    t1=time.perf_counter()\n" +
"    blob_us=(t1-t0)*1e6/len(samples)\n" +
"    rss_blob=rss()\n" +
"    b.close()\n" +
"    rows_sorted=sorted(rows,key=lambda r:r[0])\n" +
"    t0=time.perf_counter()\n" +
"    lin_hits=0\n" +
"    for p in samples:\n" +
"        for (q,t) in rows_sorted:\n" +
"            if q.startswith(p): lin_hits+=1\n" +
"    t1=time.perf_counter()\n" +
"    lin_us=(t1-t0)*1e6/len(samples)\n" +
"    print(f'[query] 100 prefix-topK-10 (blob={blob_hits} linear={lin_hits})')\n" +
"    print(f'  linear scan          : {lin_us:10.1f} us')\n" +
"    print(f'  blob mmap + bisect   : {blob_us:10.1f} us')\n" +
"    if blob_us>0: print(f'  speedup: {lin_us/blob_us:6.1f}x')\n" +
"    print(f'[rss] blob loaded: {fmt(rss_blob)}')\n" +
"\n" +
"if mode=='encode':\n" +
"    info=encode(src)\n" +
"    print(f'encoded {info[\"n\"]} queries in {info[\"encode_s\"]*1000:.1f} ms → {BIN} ({fmt(info[\"blob_size\"])})' + (' synth' if info['synth'] else ''))\n" +
"elif mode=='bench':\n" +
"    bench(src)\n" +
"else:\n" +
"    print('usage: encode|bench <MapsSync.db>'); sys.exit(2)\n"

fn run() {
    let argv = args()
    let mut mode = "bench"
    let mut target = ""
    let mut i = 0
    while i < len(argv) {
        let v = argv[i]
        let is_hexa_bin = v.contains("/hexa-lang/") || v == "hexa" || v == "hexa.real"
        let is_self     = v.contains("maps_search_history_shbf")
        if is_hexa_bin == false && is_self == false {
            if v == "encode" || v == "bench" { mode = v }
            else if v.contains(".db") || v.contains(".sqlite") { target = v }
        }
        i = i + 1
    }
    if len(target) == 0 {
        target = env("HOME") + "/Library/Containers/com.apple.Maps/Data/Maps/MapsSync_0.0.1_deviceLocalCache.db"
        println("(default target: " + target + ")")
    }
    if file_exists(target) == false {
        println("(target not found / TCC denied — using synthetic fallback)")
        target = "__SYNTH__"
    }
    let tmp_py = "/tmp/maps_search_history_shbf_" + exec("date +%s%N").trim() + ".py"
    write_file(tmp_py, PAYLOAD)
    let cmd = "/usr/bin/perl -e 'alarm 120; exec @ARGV' /usr/bin/python3 '" + tmp_py + "' '" + mode + "' '" + target + "' 2>&1; rm -f '" + tmp_py + "'"
    let result = exec(cmd)
    print(result)
}

run()
