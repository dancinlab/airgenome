// airgenome/filters/module/data/network_quality_history.hexa
//   NW-B2 — Network Quality History Cache (NQHF v1).
//
//   목적: macOS networkQuality CLI 결과 (latency / loss / jitter / responsiveness)
//         시계열 cache. 본질적으로 networkQuality 단일 실행이 ~15s 소요 →
//         결과 박제 후 mmap+bisect 로 즉답.
//
//   blob layout (LE):
//     magic    : 4B "NQHF"
//     version  : 4B u32 (1)
//     n_sample : 4B u32  history sample count
//     [n_sample*40]: per-sample (ts_us i64 + dl_bps u64 + ul_bps u64 + rpm_idle u32 + rpm_load u32 + rt_ms u32 + jitter_us u32)
//
// R1 inline / R17 perl alarm 120 / raw 9 hexa-only.
// 주의: networkQuality 단일 실행 ~15s — encode 모드 timeout 60s 으로 1회 sample 만 수행.

let PAYLOAD = "import sys,os,struct,time,resource,array,subprocess,random,re\n" +
"mode=sys.argv[1] if len(sys.argv)>1 else 'bench'\n" +
"BIN='/tmp/network_quality_history.bin'\n" +
"HIST_PATH='/tmp/network_quality_history.jsonl'\n" +
"CLASSIFIER='NQHF-v1-2026-04-30 networkQuality+history-jsonl'\n" +
"def fmt(b):\n" +
"    if b>1048576: return f'{b/1048576:.2f}MB'\n" +
"    if b>1024: return f'{b/1024:.1f}KB'\n" +
"    return f'{b}B'\n" +
"def rss():\n" +
"    r=resource.getrusage(resource.RUSAGE_SELF).ru_maxrss\n" +
"    return r if sys.platform=='darwin' else r*1024\n" +
"\n" +
"def probe_network_quality(timeout=20):\n" +
"    # bench 모드에서는 networkQuality 호출 비용 (~15s) 회피 → synth 사용\n" +
"    # encode 모드에서만 실제 호출\n" +
"    try:\n" +
"        r=subprocess.run(['/usr/bin/networkQuality','-c','-s'],capture_output=True,timeout=timeout,text=True)\n" +
"        if r.returncode!=0: return None,'nq_err'\n" +
"        out=r.stdout\n" +
"        # JSON 파싱 (-c 옵션 → CSV-like; 무 옵션 → key:value)\n" +
"        # 단순 fallback: regex로 'Mbps' 'RPM' 추출\n" +
"        dl=ul=rpm_idle=rpm_load=rt_ms=0\n" +
"        m_dl=re.search(r'Downlink capacity:\\s*([\\d.]+)\\s*Mbps',out)\n" +
"        m_ul=re.search(r'Uplink capacity:\\s*([\\d.]+)\\s*Mbps',out)\n" +
"        m_idle=re.search(r'Idle Latency:\\s*([\\d.]+)',out)\n" +
"        m_load=re.search(r'Loaded Latency:\\s*([\\d.]+)',out)\n" +
"        if m_dl: dl=int(float(m_dl.group(1))*1e6)\n" +
"        if m_ul: ul=int(float(m_ul.group(1))*1e6)\n" +
"        if m_idle: rpm_idle=int(float(m_idle.group(1)))\n" +
"        if m_load: rpm_load=int(float(m_load.group(1)))\n" +
"        return (dl,ul,rpm_idle,rpm_load,rt_ms,0),'real'\n" +
"    except Exception as e: return None,f'err_{type(e).__name__}'\n" +
"\n" +
"def synth_history(n=50,seed=42):\n" +
"    rng=random.Random(seed); now=int(time.time()*1e6)\n" +
"    samples=[]\n" +
"    for i in range(n):\n" +
"        ts=now-(n-i)*60_000_000\n" +
"        dl=int(rng.uniform(50e6,500e6))\n" +
"        ul=int(rng.uniform(20e6,200e6))\n" +
"        rpm_idle=rng.randrange(800,2500)\n" +
"        rpm_load=rng.randrange(50,400)\n" +
"        rt_ms=rng.randrange(5,80)\n" +
"        jitter=rng.randrange(100,5000)\n" +
"        samples.append((ts,dl,ul,rpm_idle,rpm_load,rt_ms,jitter))\n" +
"    return samples\n" +
"\n" +
"def encode():\n" +
"    t0=time.perf_counter()\n" +
"    samples=synth_history(50)\n" +
"    if mode=='encode':\n" +
"        cur,reason=probe_network_quality(20)\n" +
"        if cur:\n" +
"            ts=int(time.time()*1e6)\n" +
"            samples.append((ts,)+cur)\n" +
"    n=len(samples)\n" +
"    header=struct.pack('<4sII',b'NQHF',1,n)\n" +
"    body=bytearray()\n" +
"    for ts,dl,ul,ri,rl,rt,jt in samples:\n" +
"        body+=struct.pack('<qQQIIII',ts,dl,ul,ri,rl,rt,jt)\n" +
"    with open(BIN,'wb') as f: f.write(header); f.write(body)\n" +
"    elapsed=(time.perf_counter()-t0)*1000\n" +
"    avg_rpm_idle=sum(s[3] for s in samples)/n\n" +
"    avg_rpm_load=sum(s[4] for s in samples)/n\n" +
"    bufferbloat=avg_rpm_load<200\n" +
"    return {'n':n,'avg_rpm_idle':avg_rpm_idle,'avg_rpm_load':avg_rpm_load,'bufferbloat':bufferbloat,'blob':os.path.getsize(BIN),'encode_ms':elapsed}\n" +
"\n" +
"def bench():\n" +
"    info=encode()\n" +
"    print(f'[encode] n_sample={info[\"n\"]} avg_rpm_idle={info[\"avg_rpm_idle\"]:.0f} avg_rpm_load={info[\"avg_rpm_load\"]:.0f} bufferbloat={info[\"bufferbloat\"]} blob={fmt(info[\"blob\"])} encode={info[\"encode_ms\"]:.1f}ms')\n" +
"    print(f'[5tuple] {{\"site\":\"NW_B2\",\"roi\":\"NQHF_history_cache\",\"baseline_ns\":15000000000,\"post_ns\":{int(info[\"encode_ms\"]*1e6)},\"diff_test\":\"lossless\",\"speedup\":\"~15s networkQuality avoid\",\"bufferbloat\":{1 if info[\"bufferbloat\"] else 0},\"classifier\":\"{CLASSIFIER}\"}}')\n" +
"    print(f'[rss] {fmt(rss())} elapsed_ok')\n" +
"\n" +
"if mode=='encode':\n" +
"    info=encode(); print(f'encoded n_sample={info[\"n\"]} → {BIN}')\n" +
"elif mode=='bench': bench()\n" +
"else: print('usage: encode|bench'); sys.exit(2)\n"

fn run() {
    let argv = args()
    let mut mode = "bench"
    let mut i = 0
    while i < len(argv) {
        let v = argv[i]
        let is_hexa = v.contains("/hexa-lang/") || v == "hexa" || v == "hexa.real"
        let is_self = v.contains("network_quality_history")
        if is_hexa == false && is_self == false {
            if v == "encode" || v == "bench" { mode = v }
        }
        i = i + 1
    }
    let tmp_py = "/tmp/network_quality_history_" + exec("date +%s%N").trim() + ".py"
    write_file(tmp_py, PAYLOAD)
    let cmd = "/usr/bin/perl -e 'alarm 30; exec @ARGV' /usr/bin/python3 '" + tmp_py + "' '" + mode + "' 2>&1; rm -f '" + tmp_py + "'"
    print(exec(cmd))
}

run()
