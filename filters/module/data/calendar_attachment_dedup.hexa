// airgenome/filters/module/data/calendar_attachment_dedup.hexa
//   MX3 — Calendar Event Attachment Content Dedup (CADD).
//
//   목적: Calendar.app 이벤트 첨부 (.ics/Attachments/, ZATTACHMENT.ZFILEURL) 는
//         같은 회의 PDF / image 가 반복-초대 사이클로 중복 저장된다. content
//         hash (blake2b 8B) 로 collapse → 디스크 절감 quantification.
//
//   blob layout (little-endian):
//     magic   : 4B  "CADD"
//     version : 4B  u32 (1)
//     n_uniq  : 4B  u32 unique content count
//     reserved: 4B  u32 (0)
//     [n*8]   : u64 hashes        blake2b first-8B (sorted asc)
//     [n*4]   : u32 sizes         content size
//     [n*4]   : u32 dup_count     dup occurrence
//
//   query: hash → bisect_left → meta. saving = sum(size * (dup_count-1)).
//
// 모드:
//   encode : Calendar attachments → /tmp/calendar_attachment_cadd.bin
//   bench  : encode + 디스크 절감 + 1000 hash lookup (linear vs bisect)
//
// 절대 금지: Calendar.sqlitedb 쓰기 0, ics 변형 0, EventKit private API 0,
//   launchctl 0, git commit 0. sqlite open 은 immutable=1 read-only.
// R1 HEXA-FIRST: 인라인 python3. R17: perl alarm 120s.

let PAYLOAD = "import sys,os,sqlite3,tempfile,struct,time,bisect,resource,mmap,array,glob,hashlib,random,urllib.parse\n" +
"mode=sys.argv[1] if len(sys.argv)>1 else 'bench'\n" +
"src=sys.argv[2] if len(sys.argv)>2 else ''\n" +
"BIN='/tmp/calendar_attachment_cadd.bin'\n" +
"HEAD_BYTES=65536\n" +
"MAX_FILES=4000\n" +
"HOME=os.path.expanduser('~')\n" +
"\n" +
"def fmt(b):\n" +
"    if b>1073741824: return f'{b/1073741824:.2f}GB'\n" +
"    if b>1048576: return f'{b/1048576:.2f}MB'\n" +
"    if b>1024: return f'{b/1024:.1f}KB'\n" +
"    return f'{b}B'\n" +
"def rss():\n" +
"    r=resource.getrusage(resource.RUSAGE_SELF).ru_maxrss\n" +
"    if sys.platform=='darwin': return r\n" +
"    return r*1024\n" +
"\n" +
"def wyh64(b,sz):\n" +
"    h=hashlib.blake2b(b,digest_size=8,key=struct.pack('<Q',sz&0xffffffffffffffff)).digest()\n" +
"    return struct.unpack('<Q',h)[0]\n" +
"\n" +
"def safe_copy(src):\n" +
"    tmp=tempfile.NamedTemporaryFile(suffix='.sqlite',delete=False); tmp.close()\n" +
"    with open(src,'rb') as fr, open(tmp.name,'wb') as fw:\n" +
"        fw.write(fr.read())\n" +
"    return tmp.name\n" +
"\n" +
"def open_ro(path):\n" +
"    uri=f'file:{path}?immutable=1'\n" +
"    return sqlite3.connect(uri,uri=True,timeout=2.0)\n" +
"\n" +
"def probe_cal_db():\n" +
"    p=f'{HOME}/Library/Calendars/Calendar.sqlitedb'\n" +
"    return p if os.path.isfile(p) else ''\n" +
"\n" +
"def probe_cal_dirs():\n" +
"    cands=glob.glob(f'{HOME}/Library/Calendars/*.calendar/Events/*/Attachments')\n" +
"    cands+=glob.glob(f'{HOME}/Library/Calendars/*.calendar/Events/*/Attachments/*')\n" +
"    return [c for c in cands if os.path.isdir(c)]\n" +
"\n" +
"def harvest_db(db_path):\n" +
"    files=[]\n" +
"    if not db_path: return files\n" +
"    try:\n" +
"        copy=safe_copy(db_path)\n" +
"        con=sqlite3.connect(copy); cur=con.cursor()\n" +
"        cur.execute(\"SELECT name FROM sqlite_master WHERE type='table'\")\n" +
"        tabs={r[0] for r in cur.fetchall()}\n" +
"        if 'ZATTACHMENT' in tabs:\n" +
"            cur.execute('PRAGMA table_info(ZATTACHMENT)')\n" +
"            cols={c[1] for c in cur.fetchall()}\n" +
"            url_col='ZFILEURL' if 'ZFILEURL' in cols else 'ZURL' if 'ZURL' in cols else None\n" +
"            if url_col:\n" +
"                cur.execute(f'SELECT {url_col} FROM ZATTACHMENT WHERE {url_col} IS NOT NULL LIMIT {MAX_FILES}')\n" +
"                for (u,) in cur.fetchall():\n" +
"                    if not u: continue\n" +
"                    p=urllib.parse.unquote(str(u))\n" +
"                    if p.startswith('file://'): p=p[7:]\n" +
"                    if not os.path.isfile(p): continue\n" +
"                    if os.path.islink(p): continue\n" +
"                    try: st=os.lstat(p)\n" +
"                    except OSError: continue\n" +
"                    if st.st_size<=0: continue\n" +
"                    files.append((p,st.st_size))\n" +
"        con.close(); os.unlink(copy)\n" +
"    except Exception as e:\n" +
"        print(f'[encode] db harvest fail: {e!r}')\n" +
"    return files\n" +
"\n" +
"def harvest_dirs(dirs):\n" +
"    files=[]\n" +
"    for d in dirs:\n" +
"        try: names=os.listdir(d)\n" +
"        except OSError: continue\n" +
"        for nm in names:\n" +
"            full=os.path.join(d,nm)\n" +
"            if os.path.islink(full): continue\n" +
"            try: st=os.lstat(full)\n" +
"            except OSError: continue\n" +
"            if not (st.st_mode & 0o170000)==0o100000: continue\n" +
"            if st.st_size<=0: continue\n" +
"            files.append((full,st.st_size))\n" +
"            if len(files)>=MAX_FILES: return files\n" +
"    return files\n" +
"\n" +
"def synth_files(n=1500,seed=13):\n" +
"    rng=random.Random(seed)\n" +
"    out=[]\n" +
"    for i in range(n):\n" +
"        if i>0 and rng.random()<0.30:\n" +
"            j=rng.randrange(i); out.append(out[j])\n" +
"        else:\n" +
"            sz=rng.choice([1024,4096,16384,65536,262144,1048576])\n" +
"            payload=bytes(rng.randrange(256) for _ in range(min(sz,256)))\n" +
"            out.append(('synth-'+str(i),sz,payload))\n" +
"    return out\n" +
"\n" +
"def hash_files(files):\n" +
"    seen={}\n" +
"    total_bytes=0\n" +
"    is_synth=files and isinstance(files[0],tuple) and len(files[0])==3\n" +
"    for item in files:\n" +
"        if is_synth:\n" +
"            name,sz,payload=item; head=payload[:HEAD_BYTES]\n" +
"        else:\n" +
"            full,sz=item\n" +
"            try:\n" +
"                f=open(full,'rb'); head=f.read(HEAD_BYTES); f.close()\n" +
"            except OSError: continue\n" +
"        h=wyh64(head,sz); total_bytes+=sz\n" +
"        cur=seen.get(h)\n" +
"        if cur is None: seen[h]=[sz,1]\n" +
"        else: cur[1]+=1\n" +
"    return seen,total_bytes,len(files)\n" +
"\n" +
"def encode(src):\n" +
"    t0=time.perf_counter()\n" +
"    files=[]; source='real'\n" +
"    db=src if (src and os.path.isfile(src) and src.endswith('.sqlitedb')) else probe_cal_db()\n" +
"    if db: files=harvest_db(db)\n" +
"    if not files: files=harvest_dirs(probe_cal_dirs())\n" +
"    if not files:\n" +
"        print('[encode] no calendar attachments → synthetic'); files=synth_files(1500); source='synthetic'\n" +
"    seen,total_bytes,total_n=hash_files(files)\n" +
"    items=sorted(seen.items(), key=lambda kv:kv[0])\n" +
"    n=len(items)\n" +
"    hashes=array.array('Q',[h for h,_ in items])\n" +
"    sizes =array.array('I',[m[0]&0xffffffff for _,m in items])\n" +
"    dups  =array.array('I',[m[1]&0xffffffff for _,m in items])\n" +
"    header=struct.pack('<4sIII',b'CADD',1,n,0)\n" +
"    with open(BIN,'wb') as f:\n" +
"        f.write(header)\n" +
"        f.write(hashes.tobytes()); f.write(sizes.tobytes()); f.write(dups.tobytes())\n" +
"    t1=time.perf_counter()\n" +
"    saving=sum(sizes[i]*(dups[i]-1) for i in range(n))\n" +
"    return {'encode_s':t1-t0,'n_total':total_n,'n_uniq':n,'total_bytes':total_bytes,'saving':saving,'blob_size':os.path.getsize(BIN),'source':source}\n" +
"\n" +
"class Blob:\n" +
"    def __init__(self,path):\n" +
"        self.f=open(path,'rb')\n" +
"        self.mm=mmap.mmap(self.f.fileno(),0,prot=mmap.PROT_READ)\n" +
"        magic,ver,n,_=struct.unpack_from('<4sIII',self.mm,0)\n" +
"        if magic!=b'CADD' or ver!=1:\n" +
"            raise ValueError(f'bad magic/ver: {magic} {ver}')\n" +
"        self.n=n; base=16\n" +
"        mv=memoryview(self.mm)\n" +
"        self.hashes=array.array('Q'); self.hashes.frombytes(bytes(mv[base:base+8*n]))\n" +
"        self.sizes =array.array('I'); self.sizes.frombytes(bytes(mv[base+8*n:base+12*n]))\n" +
"        self.dups  =array.array('I'); self.dups.frombytes(bytes(mv[base+12*n:base+16*n]))\n" +
"        mv.release()\n" +
"    def lookup_bisect(self,h):\n" +
"        i=bisect.bisect_left(self.hashes,h)\n" +
"        if i<self.n and self.hashes[i]==h: return (int(self.sizes[i]),int(self.dups[i]))\n" +
"        return None\n" +
"    def lookup_linear(self,h):\n" +
"        for i in range(self.n):\n" +
"            if self.hashes[i]==h: return (int(self.sizes[i]),int(self.dups[i]))\n" +
"        return None\n" +
"    def close(self):\n" +
"        self.mm.close(); self.f.close()\n" +
"\n" +
"def bench(src):\n" +
"    info=encode(src)\n" +
"    print(f'[encode] {info[\"encode_s\"]*1000:.1f}ms  total={info[\"n_total\"]}  uniq={info[\"n_uniq\"]}  blob={fmt(info[\"blob_size\"])}  source={info[\"source\"]}')\n" +
"    if info['n_total']>0:\n" +
"        dup_pct=100*(info['n_total']-info['n_uniq'])/info['n_total']\n" +
"        sav_pct=100*info['saving']/max(info['total_bytes'],1)\n" +
"        print(f'[dedup] dup_count={info[\"n_total\"]-info[\"n_uniq\"]} ({dup_pct:.1f}%)  total={fmt(info[\"total_bytes\"])}  saving={fmt(info[\"saving\"])} ({sav_pct:.1f}%)')\n" +
"    if info['n_uniq']==0:\n" +
"        print('[bench] no uniq — skip'); return\n" +
"    b=Blob(BIN)\n" +
"    rng=random.Random(13)\n" +
"    queries=[int(b.hashes[rng.randrange(b.n)]) for _ in range(1000)]\n" +
"    rss_blob=rss()\n" +
"    for q in queries[:5]: b.lookup_bisect(q); b.lookup_linear(q)\n" +
"    t0=time.perf_counter_ns(); h_lin=0\n" +
"    for q in queries:\n" +
"        if b.lookup_linear(q) is not None: h_lin+=1\n" +
"    t1=time.perf_counter_ns(); ns_lin=t1-t0; per_lin=ns_lin//len(queries)\n" +
"    t0=time.perf_counter_ns(); h_bi=0\n" +
"    for q in queries:\n" +
"        if b.lookup_bisect(q) is not None: h_bi+=1\n" +
"    t1=time.perf_counter_ns(); ns_bi=t1-t0; per_bi=ns_bi//len(queries)\n" +
"    b.close()\n" +
"    print(f'[query] 1000 hash-lookup  hits linear={h_lin} bisect={h_bi}')\n" +
"    print(f'  OLD (linear scan)        per_query_ns={per_lin}')\n" +
"    print(f'  NEW (u64 bisect blob)    per_query_ns={per_bi}')\n" +
"    if per_bi>0: print(f'  speedup={per_lin/per_bi:.1f}x')\n" +
"    diff_test='lossless' if h_lin==h_bi else f'mismatch:lin={h_lin}_bi={h_bi}'\n" +
"    print(f'  5-tuple: site=MX3 ROI#=calendar-attachment-dedup baseline_ns={per_lin} post_ns={per_bi} diff_test={diff_test}')\n" +
"    print(f'[rss] after blob: {fmt(rss_blob)}')\n" +
"\n" +
"if mode=='encode':\n" +
"    info=encode(src)\n" +
"    print(f'encoded {info[\"n_uniq\"]}/{info[\"n_total\"]} uniq → {BIN} ({fmt(info[\"blob_size\"])}, saving={fmt(info[\"saving\"])}, source={info[\"source\"]})')\n" +
"elif mode=='bench':\n" +
"    bench(src)\n" +
"else:\n" +
"    print('usage: encode|bench [<Calendar.sqlitedb>]'); sys.exit(2)\n"

fn run() {
    let argv = args()
    let mut mode = "bench"
    let mut target = ""
    let mut i = 0
    while i < len(argv) {
        let v = argv[i]
        let is_hexa_bin = v.contains("/hexa-lang/") || v == "hexa" || v == "hexa.real"
        let is_self     = v.contains("calendar_attachment_dedup")
        if is_hexa_bin == false && is_self == false {
            if v == "encode" || v == "bench" { mode = v }
            else if v.contains(".sqlitedb") || v.contains("/Calendars") { target = v }
        }
        i = i + 1
    }
    let tmp_py = "/tmp/calendar_attachment_dedup_" + exec("date +%s%N").trim() + ".py"
    write_file(tmp_py, PAYLOAD)
    let cmd = "/usr/bin/perl -e 'alarm 120; exec @ARGV' /usr/bin/python3 '" + tmp_py + "' '" + mode + "' '" + target + "' 2>&1; rm -f '" + tmp_py + "'"
    let result = exec(cmd)
    print(result)
}

run()
