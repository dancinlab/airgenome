// airgenome/modules/filters/data/telegram_contact_apbf.hexa
//   T3 — Telegram Contact Autocomplete Prefix Blob Filter (APBF — F58 직접 이식).
//
//   목적: Telegram 의 contact / chat peer 검색 (autocomplete) hot path 를 sorted
//         peer-name blob + bisect 로 치환. F58 과 동일 layout — schema-free.
//
//   blob layout (little-endian):
//     magic   : 4B  "APBF"
//     version : 4B  u32             (1)
//     n       : 4B  u32             contact 개수
//     str_sz  : 4B  u32             pool size
//     [n*4]   : u32 offsets         pool 시작 (정렬됨)
//     [n*4]   : u32 lens            length
//     [n*4]   : u32 score           recency / activity score (file_count proxy)
//     [str_sz]: utf-8 raw bytes
//
//   query: prefix → bisect_left 두 번 → range → top-K by score.
//
//   source 옵션:
//     1) postbox media 의 peer_id 만 추출 — 안전 (read-only)
//     2) Address Book / TelegramSearch / 명시 입력 파일
//     3) 미존재 시 synthetic 8000 contact (로마자 first-name 이니셜 분포)
//
// R1 HEXA-FIRST: 인라인 python3. R17: alarm 120s.

let PAYLOAD = "import sys,os,struct,time,bisect,heapq,resource,mmap,array,glob,re,random,json\n" +
"mode=sys.argv[1]; src=sys.argv[2] if len(sys.argv)>2 else ''\n" +
"BIN='/tmp/telegram_contact_apbf.bin'\n" +
"def fmt(b):\n" +
"    if b>1048576: return f'{b/1048576:.2f}MB'\n" +
"    if b>1024: return f'{b/1024:.1f}KB'\n" +
"    return f'{b}B'\n" +
"def rss():\n" +
"    r=resource.getrusage(resource.RUSAGE_SELF).ru_maxrss\n" +
"    if sys.platform=='darwin': return r\n" +
"    return r*1024\n" +
"\n" +
"PEER_RE=re.compile(r'(?:telegram-cloud-(?:document|photo-size)-(?:size-)?\\d+-(\\d+)|local-file-+(\\d+))')\n" +
"FIRST=['alex','ben','chris','dan','emma','frank','grace','helen','ivan','julia','kim','liam','mia','noah','olivia','peter','quinn','ryan','sam','tina','uma','victor','wendy','xena','yuri','zoe','aaron','beth','carl','diana','ethan','fiona','gabe','hugo','iris','jake','kate','leo','maya','nick','owen','piper','quincy','ruth','seth','troy','umar','vera','will','xavier','yuna']\n" +
"LAST=['kim','lee','park','choi','jung','han','seo','yoon','lim','jang','smith','jones','brown','davis','miller','wilson','moore','taylor','anderson','thomas','jackson','white','harris','martin','thompson','garcia','martinez','robinson','clark','rodriguez','lewis','walker','hall','allen','young','hernandez','king','wright','lopez','hill','scott','green','adams','baker']\n" +
"\n" +
"def probe_postbox():\n" +
"    home=os.path.expanduser('~')\n" +
"    cands=glob.glob(home+'/Library/Group Containers/*Telegram*/stable/account-*/postbox/media')\n" +
"    cands+=glob.glob(home+'/Library/Group Containers/*Telegram*/appstore/account-*/postbox/media')\n" +
"    cands+=glob.glob(home+'/Library/Containers/ru.keepcoder.Telegram/Data/Library/Caches/postbox*/media')\n" +
"    return [c for c in cands if os.path.isdir(c)]\n" +
"\n" +
"def harvest_peers(media_dirs):\n" +
"    peers={}\n" +
"    for d in media_dirs:\n" +
"        for name in os.listdir(d):\n" +
"            m=PEER_RE.search(name)\n" +
"            if not m: continue\n" +
"            peer=m.group(1) or m.group(2)\n" +
"            peers[peer]=peers.get(peer,0)+1\n" +
"    return peers\n" +
"\n" +
"def synth_contacts(n=8000,seed=23):\n" +
"    rng=random.Random(seed)\n" +
"    out={}\n" +
"    for i in range(n):\n" +
"        f=FIRST[rng.randrange(len(FIRST))]\n" +
"        l=LAST[rng.randrange(len(LAST))]\n" +
"        sfx=str(rng.randrange(99)) if rng.random()<0.3 else ''\n" +
"        name=f+' '+l+sfx\n" +
"        out[name]=out.get(name,0)+rng.randrange(1,50)\n" +
"    return out\n" +
"\n" +
"def load_input(src):\n" +
"    if not src: return None\n" +
"    if not os.path.exists(src): return None\n" +
"    rows={}\n" +
"    with open(src,'rb') as f:\n" +
"        head=f.read(2); f.seek(0)\n" +
"        is_json=head.startswith(b'{')\n" +
"        for ln in f:\n" +
"            ln=ln.rstrip(b'\\r\\n')\n" +
"            if not ln: continue\n" +
"            if is_json:\n" +
"                try:\n" +
"                    o=json.loads(ln)\n" +
"                    nm=o.get('name') or o.get('first_name') or ''\n" +
"                    sc=int(o.get('score') or o.get('count') or 0)\n" +
"                except Exception: continue\n" +
"            else:\n" +
"                parts=ln.decode('utf-8','replace').split('\\t')\n" +
"                nm=parts[0]\n" +
"                try: sc=int(parts[1]) if len(parts)>1 else 0\n" +
"                except: sc=0\n" +
"            if nm: rows[nm]=rows.get(nm,0)+max(sc,1)\n" +
"    return rows\n" +
"\n" +
"def encode(src):\n" +
"    t0=time.perf_counter()\n" +
"    rows=None; source='unknown'\n" +
"    if src and os.path.isdir(src):\n" +
"        rows=harvest_peers([src]); source='postbox-id:'+src\n" +
"    elif src and os.path.isfile(src):\n" +
"        rows=load_input(src); source='file:'+src\n" +
"    else:\n" +
"        dirs=probe_postbox()\n" +
"        if dirs:\n" +
"            rows=harvest_peers(dirs); source='postbox-id:'+dirs[0]\n" +
"    if not rows:\n" +
"        print('[encode] no source — synthetic fallback')\n" +
"        rows=synth_contacts(8000); source='synthetic'\n" +
"    items=sorted(rows.items(), key=lambda kv:kv[0])\n" +
"    n=len(items)\n" +
"    pool=bytearray()\n" +
"    offs=array.array('I',[0]*n)\n" +
"    lens=array.array('I',[0]*n)\n" +
"    scs =array.array('I',[0]*n)\n" +
"    for i,(nm,sc) in enumerate(items):\n" +
"        nb=nm.encode('utf-8','replace')\n" +
"        offs[i]=len(pool); lens[i]=len(nb); scs[i]=int(sc)&0xffffffff\n" +
"        pool.extend(nb)\n" +
"    header=struct.pack('<4sIII',b'APBF',1,n,len(pool))\n" +
"    with open(BIN,'wb') as f:\n" +
"        f.write(header)\n" +
"        f.write(offs.tobytes()); f.write(lens.tobytes()); f.write(scs.tobytes())\n" +
"        f.write(pool)\n" +
"    t1=time.perf_counter()\n" +
"    return {'encode_s':t1-t0,'n':n,'blob_size':os.path.getsize(BIN),'source':source}\n" +
"\n" +
"class Blob:\n" +
"    def __init__(self,path):\n" +
"        self.f=open(path,'rb')\n" +
"        self.mm=mmap.mmap(self.f.fileno(),0,prot=mmap.PROT_READ)\n" +
"        magic,ver,n,pool_sz=struct.unpack_from('<4sIII',self.mm,0)\n" +
"        if magic!=b'APBF' or ver!=1:\n" +
"            raise ValueError(f'bad magic/ver: {magic} {ver}')\n" +
"        self.n=n; self.pool_sz=pool_sz\n" +
"        base=16\n" +
"        self.offs_off=base; self.lens_off=base+4*n\n" +
"        self.scs_off =base+8*n; self.pool_off=base+12*n\n" +
"        mv=memoryview(self.mm)\n" +
"        offs=array.array('I'); offs.frombytes(bytes(mv[self.offs_off:self.offs_off+4*n]))\n" +
"        lens=array.array('I'); lens.frombytes(bytes(mv[self.lens_off:self.lens_off+4*n]))\n" +
"        scs =array.array('I'); scs.frombytes(bytes(mv[self.scs_off :self.scs_off +4*n]))\n" +
"        pool=bytes(mv[self.pool_off:self.pool_off+pool_sz])\n" +
"        self.names=[pool[offs[i]:offs[i]+lens[i]] for i in range(n)]\n" +
"        self.scs=scs; self.mv=mv\n" +
"    def linear_topk(self,prefix,k=10):\n" +
"        pb=prefix.encode('utf-8') if isinstance(prefix,str) else prefix\n" +
"        cand=[i for i,u in enumerate(self.names) if u.startswith(pb)]\n" +
"        if len(cand)<=k: idxs=cand\n" +
"        else: idxs=heapq.nlargest(k,cand,key=lambda i:self.scs[i])\n" +
"        idxs.sort(key=lambda i:-self.scs[i])\n" +
"        return [(self.names[i].decode('utf-8','replace'),int(self.scs[i])) for i in idxs]\n" +
"    def bisect_topk(self,prefix,k=10):\n" +
"        pb=prefix.encode('utf-8') if isinstance(prefix,str) else prefix\n" +
"        names=self.names\n" +
"        start=bisect.bisect_left(names,pb)\n" +
"        end=bisect.bisect_left(names,pb+b'\\xff\\xff\\xff\\xff')\n" +
"        if end==start: return []\n" +
"        if end-start<=k: idxs=list(range(start,end))\n" +
"        else: idxs=heapq.nlargest(k,range(start,end),key=lambda i:self.scs[i])\n" +
"        idxs.sort(key=lambda i:-self.scs[i])\n" +
"        return [(self.names[i].decode('utf-8','replace'),int(self.scs[i])) for i in idxs]\n" +
"    def close(self):\n" +
"        try: self.mv.release()\n" +
"        except Exception: pass\n" +
"        self.mm.close(); self.f.close()\n" +
"\n" +
"def bench(src):\n" +
"    info=encode(src)\n" +
"    print(f'[encode] {info[\"encode_s\"]*1000:.1f} ms  contacts={info[\"n\"]}  blob={fmt(info[\"blob_size\"])}  source={info[\"source\"]}')\n" +
"    if info['n']==0:\n" +
"        print('[bench] no contacts — skip'); return\n" +
"    b=Blob(BIN)\n" +
"    rng=random.Random(31)\n" +
"    samples=[]\n" +
"    for _ in range(200):\n" +
"        i=rng.randrange(b.n)\n" +
"        nm=b.names[i].decode('utf-8','replace')\n" +
"        plen=rng.choice([1,2,3,4,5])\n" +
"        samples.append(nm[:plen] if len(nm)>=plen else nm)\n" +
"    rss_blob=rss()\n" +
"    for p in samples[:5]: b.linear_topk(p,10); b.bisect_topk(p,10)\n" +
"    t0=time.perf_counter(); h_lin=0\n" +
"    for p in samples: h_lin+=len(b.linear_topk(p,10))\n" +
"    t1=time.perf_counter(); lin_us=(t1-t0)*1e6/len(samples)\n" +
"    t0=time.perf_counter(); h_bi=0\n" +
"    for p in samples: h_bi+=len(b.bisect_topk(p,10))\n" +
"    t1=time.perf_counter(); bi_us=(t1-t0)*1e6/len(samples)\n" +
"    b.close()\n" +
"    print(f'[query] 200 prefix-topK-10  hits linear={h_lin} bisect={h_bi}')\n" +
"    print(f'  linear scan       : {lin_us:10.1f} us/query')\n" +
"    print(f'  bisect on blob    : {bi_us :10.1f} us/query')\n" +
"    if bi_us>0: print(f'  speedup: {lin_us/bi_us:6.1f}x')\n" +
"    print(f'[lossless] hits equal: {h_lin==h_bi}')\n" +
"    print(f'[rss] after blob loaded: {fmt(rss_blob)}')\n" +
"\n" +
"if mode=='encode':\n" +
"    info=encode(src)\n" +
"    print(f'encoded {info[\"n\"]} contacts in {info[\"encode_s\"]*1000:.1f} ms -> {BIN} ({fmt(info[\"blob_size\"])}, source={info[\"source\"]})')\n" +
"elif mode=='bench':\n" +
"    bench(src)\n" +
"else:\n" +
"    print('usage: encode|bench [<dir|file|synthetic>]'); sys.exit(2)\n"

fn run() {
    let argv = args()
    let mut mode = "bench"
    let mut target = ""
    let mut i = 0
    while i < len(argv) {
        let v = argv[i]
        let is_hexa_bin = v.contains("/hexa-lang/") || v == "hexa" || v == "hexa.real"
        let is_self     = v.contains("telegram_contact_apbf")
        if is_hexa_bin == false && is_self == false {
            if v == "encode" || v == "bench" { mode = v }
            else if v.contains("/") || v == "synthetic" || v.contains(".tsv") || v.contains(".jsonl") { target = v }
        }
        i = i + 1
    }
    let tmp_py = "/tmp/telegram_contact_apbf_" + exec("date +%s%N").trim() + ".py"
    write_file(tmp_py, PAYLOAD)
    let cmd = "/usr/bin/perl -e 'alarm 120; exec @ARGV' /usr/bin/python3 '" + tmp_py + "' '" + mode + "' '" + target + "' 2>&1; rm -f '" + tmp_py + "'"
    let result = exec(cmd)
    print(result)
}

run()
