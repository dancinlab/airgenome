// airgenome/modules/filters/data/memo_attachment_dedup.hexa
//   M2 — Apple Notes Media/Attachments dedup cache (wyhash content hash).
//
//   목적: Notes 앱이 첨부 추가 시 매번 새 UUID 디렉터리에 복사 — 동일 image/pdf
//         가 N번 복사되면 디스크 N배. 이 hot path 를 byte-reinterpret:
//           - sqlite3 ZATTACHMENT row → file path 합성
//           - 파일 content hash (wyhash → hashlib blake2b 64bit fallback)
//           - hash → [path,...] 역색인 (cache: #65 + #41 패턴, 정렬 + bisect)
//
//   blob layout (little-endian):
//     magic    : 4B  "MADC"          (Memo Attachment Dedup Cache)
//     version  : 4B  u32             (1)
//     n        : 4B  u32             unique attachment 개수
//     str_sz   : 4B  u32             path pool 바이트 길이
//     [n*8]    : u64 hash            content hash (정렬키, 동일 hash → cluster)
//     [n*4]    : u32 path_off        pool 내 path 시작
//     [n*4]    : u32 path_len        path 길이
//     [n*4]    : u32 size            file size (bytes)
//     [str_sz] : utf-8 string pool   path raw bytes
//
//   query: bisect_left(hashes, h) → cluster start; cluster 안 path 들이 dedup 후보.
//          dup_count >= 2 인 cluster 의 (size * (count-1)) 합계 = 절감 추정.
//
// catalog #65/#41 reference:
//   - #65: content-hash dedup cache (entry 마다 hash key + payload pointer)
//   - #41: mmap-able sorted blob (random-access via offset table)
//   조합: hash 정렬 → bisect 로 cluster lookup O(log n).
//
// macOS path probe:
//   1) ~/Library/Group Containers/group.com.apple.notes/NoteStore.sqlite + Accounts/<UUID>/Media
//   2) ~/Library/Containers/com.apple.Notes/Data/Library/Notes/...
//
// TCC: file_exists 검사로 graceful skip.
//
// R1 HEXA-FIRST: 인라인 python3 페이로드. R17: alarm 120s.

let PAYLOAD = "import sys,os,sqlite3,tempfile,struct,time,bisect,hashlib,resource,mmap,array,glob\n" +
"mode=sys.argv[1]; src=sys.argv[2]; media_root=sys.argv[3] if len(sys.argv)>3 else ''\n" +
"BIN='/tmp/memo_attachment_dedup.bin'\n" +
"if not os.path.exists(src):\n" +
"    print('ERROR: not found: '+src); sys.exit(1)\n" +
"\n" +
"def to_int_safe(x):\n" +
"    if x is None: return 0\n" +
"    if isinstance(x,(int,float)): return int(x)&0xffffffff\n" +
"    s=str(x)\n" +
"    if not s: return 0\n" +
"    try: return int(float(s))&0xffffffff\n" +
"    except: return 0\n" +
"\n" +
"def fmt(b):\n" +
"    if b>1073741824: return f'{b/1073741824:.2f}GB'\n" +
"    if b>1048576: return f'{b/1048576:.2f}MB'\n" +
"    if b>1024: return f'{b/1024:.1f}KB'\n" +
"    return f'{b}B'\n" +
"def rss():\n" +
"    r=resource.getrusage(resource.RUSAGE_SELF).ru_maxrss\n" +
"    if sys.platform=='darwin': return r\n" +
"    return r*1024\n" +
"\n" +
"def safe_copy(src):\n" +
"    tmp=tempfile.NamedTemporaryFile(suffix='.sqlite',delete=False); tmp.close()\n" +
"    sc=sqlite3.connect(f'file:{src}?mode=ro&immutable=1',uri=True)\n" +
"    dc=sqlite3.connect(tmp.name)\n" +
"    sc.backup(dc); dc.close(); sc.close()\n" +
"    return tmp.name\n" +
"\n" +
"# wyhash 가 stdlib 에 없음 — blake2b 64bit (digest_size=8) 로 surrogate (xxh64 fallback)\n" +
"def hash_file(path):\n" +
"    h=hashlib.blake2b(digest_size=8)\n" +
"    f=open(path,'rb')\n" +
"    while True:\n" +
"        c=f.read(65536)\n" +
"        if not c: break\n" +
"        h.update(c)\n" +
"    f.close()\n" +
"    return int.from_bytes(h.digest(),'little')\n" +
"\n" +
"def discover_paths(conn,media_root):\n" +
"    # ZATTACHMENT (varies by macOS) — fallback: glob media_root.\n" +
"    paths=[]\n" +
"    cur=conn.cursor()\n" +
"    queries=[\n" +
"        ('SELECT ZIDENTIFIER, ZFILENAME FROM ZICCLOUDSYNCINGOBJECT '\n" +
"         'WHERE ZFILENAME IS NOT NULL'),\n" +
"        ('SELECT ZIDENTIFIER, ZFILENAME FROM ZATTACHMENT'),\n" +
"    ]\n" +
"    rows_sql=[]\n" +
"    for q in queries:\n" +
"        try:\n" +
"            cur.execute(q); rows_sql.extend(cur.fetchall()); break\n" +
"        except Exception: pass\n" +
"    # build paths from sql + glob fallback\n" +
"    if media_root and os.path.isdir(media_root):\n" +
"        for ident,fname in rows_sql:\n" +
"            if not fname: continue\n" +
"            cand=os.path.join(media_root,str(ident or ''),str(fname))\n" +
"            if os.path.isfile(cand): paths.append(cand)\n" +
"        # glob 모든 file (매칭 못 한 경우 포함)\n" +
"        for p in glob.glob(os.path.join(media_root,'**','*'),recursive=True):\n" +
"            if os.path.isfile(p) and p not in paths:\n" +
"                paths.append(p)\n" +
"    return paths\n" +
"\n" +
"def encode(src,media_root):\n" +
"    t0=time.perf_counter()\n" +
"    copy=safe_copy(src)\n" +
"    conn=sqlite3.connect(copy)\n" +
"    paths=discover_paths(conn,media_root)\n" +
"    conn.close(); os.unlink(copy)\n" +
"    # hash + size 로 entry 생성. (hash, path) 튜플 정렬.\n" +
"    entries=[]\n" +
"    for p in paths:\n" +
"        if not os.path.isfile(p): continue\n" +
"        st=os.stat(p)\n" +
"        sz=st.st_size\n" +
"        if sz==0: continue\n" +
"        h=hash_file(p)\n" +
"        entries.append((h,p,sz))\n" +
"    entries.sort(key=lambda e:e[0])\n" +
"    n=len(entries)\n" +
"    pool=bytearray()\n" +
"    hashes=array.array('Q',[0]*n)\n" +
"    poffs=array.array('I',[0]*n)\n" +
"    plens=array.array('I',[0]*n)\n" +
"    sizes=array.array('I',[0]*n)\n" +
"    for i,(h,p,sz) in enumerate(entries):\n" +
"        pb=p.encode('utf-8','replace')\n" +
"        hashes[i]=h&0xffffffffffffffff\n" +
"        poffs[i]=len(pool); plens[i]=len(pb); sizes[i]=to_int_safe(sz)\n" +
"        pool.extend(pb)\n" +
"    header=struct.pack('<4sIII',b'MADC',1,n,len(pool))\n" +
"    with open(BIN,'wb') as f:\n" +
"        f.write(header)\n" +
"        f.write(hashes.tobytes())\n" +
"        f.write(poffs.tobytes()); f.write(plens.tobytes()); f.write(sizes.tobytes())\n" +
"        f.write(pool)\n" +
"    t1=time.perf_counter()\n" +
"    blob_size=os.path.getsize(BIN)\n" +
"    return {'encode_s':t1-t0,'n':n,'entries':entries,'blob_size':blob_size}\n" +
"\n" +
"class Blob:\n" +
"    def __init__(self,path):\n" +
"        self.f=open(path,'rb')\n" +
"        self.mm=mmap.mmap(self.f.fileno(),0,prot=mmap.PROT_READ)\n" +
"        magic,ver,n,pool_sz=struct.unpack_from('<4sIII',self.mm,0)\n" +
"        assert magic==b'MADC' and ver==1\n" +
"        self.n=n; self.pool_sz=pool_sz\n" +
"        base=16\n" +
"        self.hashes_off=base\n" +
"        self.poffs_off =base+8*n\n" +
"        self.plens_off =base+12*n\n" +
"        self.sizes_off =base+16*n\n" +
"        self.pool_off  =base+20*n\n" +
"        self.mv=memoryview(self.mm)\n" +
"        hs=array.array('Q'); hs.frombytes(bytes(self.mv[self.hashes_off:self.hashes_off+8*n]))\n" +
"        po=array.array('I'); po.frombytes(bytes(self.mv[self.poffs_off:self.poffs_off+4*n]))\n" +
"        pl=array.array('I'); pl.frombytes(bytes(self.mv[self.plens_off:self.plens_off+4*n]))\n" +
"        sz=array.array('I'); sz.frombytes(bytes(self.mv[self.sizes_off:self.sizes_off+4*n]))\n" +
"        pool=bytes(self.mv[self.pool_off:self.pool_off+pool_sz])\n" +
"        self.hashes=hs\n" +
"        self.paths=[pool[po[i]:po[i]+pl[i]].decode('utf-8','replace') for i in range(n)]\n" +
"        self.sizes=sz\n" +
"    def find_dups(self,h):\n" +
"        # 정렬된 hashes 에서 동일 hash cluster 찾기.\n" +
"        lo=bisect.bisect_left(self.hashes,h)\n" +
"        hi=bisect.bisect_right(self.hashes,h)\n" +
"        return list(range(lo,hi))\n" +
"    def close(self):\n" +
"        try: self.mv.release()\n" +
"        except Exception: pass\n" +
"        self.mm.close(); self.f.close()\n" +
"\n" +
"def bench(src,media_root):\n" +
"    info=encode(src,media_root)\n" +
"    print(f'[encode] {info[\"encode_s\"]*1000:.1f} ms  attachments={info[\"n\"]}  blob={fmt(info[\"blob_size\"])}')\n" +
"    if info['n']==0:\n" +
"        print('[bench] no attachments — skip dup phase'); return\n" +
"    b=Blob(BIN)\n" +
"    # cluster scan: 동일 hash 가 2개 이상이면 dup.\n" +
"    clusters={}\n" +
"    for i in range(b.n):\n" +
"        h=int(b.hashes[i])\n" +
"        clusters.setdefault(h,[]).append(i)\n" +
"    dup_clusters=[(h,ix) for h,ix in clusters.items() if len(ix)>=2]\n" +
"    dup_files=sum(len(ix) for _,ix in dup_clusters)\n" +
"    saved=0\n" +
"    for _,ix in dup_clusters:\n" +
"        sz=int(b.sizes[ix[0]])\n" +
"        saved+=sz*(len(ix)-1)\n" +
"    total_size=sum(int(b.sizes[i]) for i in range(b.n))\n" +
"    print(f'[dedup] dup clusters={len(dup_clusters)}  dup files={dup_files}  unique={b.n-dup_files+len(dup_clusters)}')\n" +
"    print(f'[disk]  total={fmt(total_size)}  recoverable={fmt(saved)} ({100*saved/max(total_size,1):.1f}%)')\n" +
"    # bisect lookup vs linear scan 비교\n" +
"    import random\n" +
"    rng=random.Random(42)\n" +
"    sample_h=[int(b.hashes[rng.randrange(b.n)]) for _ in range(min(100,b.n))]\n" +
"    rss_blob=rss()\n" +
"    for h in sample_h[:5]: b.find_dups(h)\n" +
"    t0=time.perf_counter()\n" +
"    for h in sample_h: b.find_dups(h)\n" +
"    t1=time.perf_counter()\n" +
"    bi_us=(t1-t0)*1e6/len(sample_h)\n" +
"    # linear baseline\n" +
"    hs_list=list(b.hashes)\n" +
"    t0=time.perf_counter()\n" +
"    for h in sample_h:\n" +
"        _=[i for i,hh in enumerate(hs_list) if hh==h]\n" +
"    t1=time.perf_counter()\n" +
"    lin_us=(t1-t0)*1e6/len(sample_h)\n" +
"    b.close()\n" +
"    print(f'[query] {len(sample_h)} hash-lookup')\n" +
"    print(f'  linear scan       : {lin_us:10.1f} us')\n" +
"    print(f'  blob mmap + bisect: {bi_us:10.1f} us')\n" +
"    if bi_us>0: print(f'  speedup: {lin_us/bi_us:6.1f}x')\n" +
"    print(f'[rss] after blob loaded: {fmt(rss_blob)}')\n" +
"\n" +
"if mode=='encode':\n" +
"    info=encode(src,media_root)\n" +
"    print(f'encoded {info[\"n\"]} attachments in {info[\"encode_s\"]*1000:.1f} ms → {BIN} ({fmt(info[\"blob_size\"])})')\n" +
"elif mode=='bench':\n" +
"    bench(src,media_root)\n" +
"else:\n" +
"    print('usage: encode|bench <NoteStore.sqlite> [media_root]'); sys.exit(2)\n"

fn run() {
    let argv = args()
    let mut mode = "bench"
    let mut target = ""
    let mut media_root = ""
    let mut i = 0
    while i < len(argv) {
        let v = argv[i]
        let is_hexa_bin = v.contains("/hexa-lang/") || v == "hexa" || v == "hexa.real"
        let is_self     = v.contains("memo_attachment_dedup")
        if is_hexa_bin == false && is_self == false {
            if v == "encode" || v == "bench" { mode = v }
            else if v.contains(".sqlite") || v.contains(".db") { target = v }
            else if v.contains("/Media") || v.contains("/Attachments") { media_root = v }
        }
        i = i + 1
    }
    if len(target) == 0 {
        let p1 = env("HOME") + "/Library/Group Containers/group.com.apple.notes/NoteStore.sqlite"
        let p2 = env("HOME") + "/Library/Containers/com.apple.Notes/Data/Library/Notes/NoteStore.sqlite"
        if file_exists(p1) {
            target = p1
        } else if file_exists(p2) {
            target = p2
        } else {
            target = p1
        }
        println("(default target: " + target + ")")
    }
    if file_exists(target) == false {
        println("ERROR: not found: " + target)
        println("hint: TCC > Files & Folders > 'Apple Notes' 또는 FDA 부여 필요")
        return
    }
    // media_root probe — Accounts/<UUID>/Media (UUID 가변)
    if len(media_root) == 0 {
        let group_root = env("HOME") + "/Library/Group Containers/group.com.apple.notes/Accounts"
        if file_exists(group_root) {
            // glob: Accounts/<UUID>/Media — python payload 가 glob fallback 처리.
            media_root = group_root
        }
    }
    let tmp_py = "/tmp/memo_attachment_dedup_" + exec("date +%s%N").trim() + ".py"
    write_file(tmp_py, PAYLOAD)
    let cmd = "/usr/bin/perl -e 'alarm 120; exec @ARGV' /usr/bin/python3 '" + tmp_py + "' '" + mode + "' '" + target + "' '" + media_root + "' 2>&1; rm -f '" + tmp_py + "'"
    let result = exec(cmd)
    print(result)
}

run()
