// airgenome/modules/filters/data/claude_read_content_cache.hexa
//   C15 — Claude Read tool content cache (CRCC).
//
//   목적: tool_use=Read 가 같은 파일을 여러 번 읽는 경우, sqlite/jsonl 을
//         매번 cold scan 하지 않고 mmap blob + xxh64 key 로 즉답.
//         hot file 은 LRU 로 유지 — capacity 초과 시 LRU evict.
//
//   blob layout (little-endian):
//     magic   : 4B  "CRCC"
//     version : 4B  u32             (1)
//     n       : 4B  u32             entry 개수
//     pool_sz : 4B  u32             pool 바이트 (path|content 합쳐 저장)
//     [n*8]   : u64 path_xxh64      path xxh64 (sorted asc, bisect)
//     [n*4]   : u32 path_off        pool 내 path 시작
//     [n*4]   : u32 path_len        path 길이
//     [n*4]   : u32 cont_off        pool 내 content 시작
//     [n*4]   : u32 cont_len        content 길이
//     [n*8]   : u64 last_used_us    LRU eviction key
//     [pool]  : utf-8 raw bytes (path + content concat)
//
//   query: path_xxh64 → bisect_left → entry. content slice 즉답.
//          캐시 미스 시 디스크 read + 새 entry 추가 (in-memory side; blob immutable).
//
// 모드:
//   encode <jsonl_or_dir>     : jsonl 의 Read tool_use → /tmp/claude_read_crcc.bin
//   bench  <jsonl_or_dir>     : encode + cold (jsonl scan) vs blob hit + LRU bench
//
// 패턴: #4 LRU + #41 dedup cache + #65 xxh64 (blake2b 8B fallback).
//
// R1 HEXA-FIRST: 인라인 python3 페이로드. raw 9 hexa-only.
// R17: /usr/bin/perl alarm 120s wrapper.

let PAYLOAD = "import sys,os,struct,time,bisect,resource,mmap,array,json,hashlib,glob\n" +
"from collections import OrderedDict\n" +
"mode=sys.argv[1]; src=sys.argv[2]\n" +
"BIN='/tmp/claude_read_crcc.bin'\n" +
"LRU_CAP=128\n" +
"\n" +
"def fmt(b):\n" +
"    if b>1048576: return f'{b/1048576:.2f}MB'\n" +
"    if b>1024: return f'{b/1024:.1f}KB'\n" +
"    return f'{b}B'\n" +
"def rss():\n" +
"    r=resource.getrusage(resource.RUSAGE_SELF).ru_maxrss\n" +
"    if sys.platform=='darwin': return r\n" +
"    return r*1024\n" +
"\n" +
"def xxh64_fallback(b):\n" +
"    h=hashlib.blake2b(b if isinstance(b,(bytes,bytearray)) else b.encode('utf-8','replace'),digest_size=8).digest()\n" +
"    return struct.unpack('<Q',h)[0]\n" +
"\n" +
"def expand_input(src):\n" +
"    if os.path.isdir(src):\n" +
"        return [os.path.join(dp,f) for dp,_,fs in os.walk(src) for f in fs if f.endswith('.jsonl')]\n" +
"    if '*' in src:\n" +
"        return sorted(glob.glob(src))\n" +
"    if os.path.isfile(src): return [src]\n" +
"    return []\n" +
"\n" +
"def extract_reads(paths):\n" +
"    # Read tool_use → (file_path, content) — content 는 같은 jsonl 의 후속\n" +
"    # tool_use_result body 에서 회수. Claude jsonl 형식:\n" +
"    #   message.content[].type=='tool_use' name=='Read' input.file_path=...\n" +
"    #   다음 줄 message.content[].type=='tool_result' tool_use_id=... content=...\n" +
"    out=[]  # list[(path,bytes)]\n" +
"    raw_total=0\n" +
"    for p in paths:\n" +
"        try: f=open(p,'rb')\n" +
"        except OSError: continue\n" +
"        pending={}  # tool_use_id -> file_path\n" +
"        with f:\n" +
"            for ln in f:\n" +
"                ln=ln.strip()\n" +
"                if not ln or ln[:1]!=b'{': continue\n" +
"                raw_total+=len(ln)\n" +
"                try: o=json.loads(ln.decode('utf-8','replace'))\n" +
"                except ValueError: continue\n" +
"                msg=o.get('message')\n" +
"                if not isinstance(msg,dict): continue\n" +
"                c=msg.get('content')\n" +
"                if not isinstance(c,list): continue\n" +
"                for blk in c:\n" +
"                    if not isinstance(blk,dict): continue\n" +
"                    bt=blk.get('type')\n" +
"                    if bt=='tool_use' and blk.get('name')=='Read':\n" +
"                        inp=blk.get('input') or {}\n" +
"                        fp=inp.get('file_path') or ''\n" +
"                        tid=blk.get('id') or ''\n" +
"                        if fp and tid: pending[tid]=fp\n" +
"                    elif bt=='tool_result':\n" +
"                        tid=blk.get('tool_use_id') or ''\n" +
"                        if tid in pending:\n" +
"                            body=blk.get('content')\n" +
"                            if isinstance(body,str):\n" +
"                                out.append((pending[tid],body.encode('utf-8','replace')))\n" +
"                            elif isinstance(body,list):\n" +
"                                # gather text blocks only\n" +
"                                buf=[]\n" +
"                                for tb in body:\n" +
"                                    if isinstance(tb,dict) and tb.get('type')=='text':\n" +
"                                        buf.append(tb.get('text','') or '')\n" +
"                                if buf:\n" +
"                                    out.append((pending[tid],('\\n'.join(buf)).encode('utf-8','replace')))\n" +
"                            del pending[tid]\n" +
"    return out,raw_total\n" +
"\n" +
"def encode(src):\n" +
"    t0=time.perf_counter()\n" +
"    paths=expand_input(src)\n" +
"    if not paths:\n" +
"        print(f'ERROR: no jsonl: {src}'); sys.exit(1)\n" +
"    reads,raw_total=extract_reads(paths)\n" +
"    if not reads:\n" +
"        print('[encode] no Read tool_uses extracted')\n" +
"        return {'encode_s':time.perf_counter()-t0,'n_total':0,'n_uniq':0,'raw_total':raw_total,'blob_size':0,'paths':len(paths),'reads_total':0}\n" +
"    # path 별 latest content 만 채택 (#41 dedup — 동일 path 재read 는 last-write-wins)\n" +
"    by_path={}\n" +
"    for p,c in reads: by_path[p]=c\n" +
"    items=sorted(by_path.items(), key=lambda kv:xxh64_fallback(kv[0]))\n" +
"    n=len(items)\n" +
"    pool=bytearray()\n" +
"    hashes=array.array('Q',[0]*n)\n" +
"    p_off=array.array('I',[0]*n); p_len=array.array('I',[0]*n)\n" +
"    c_off=array.array('I',[0]*n); c_len=array.array('I',[0]*n)\n" +
"    lru =array.array('Q',[0]*n)\n" +
"    now_us=int(time.time()*1_000_000)\n" +
"    for i,(p,c) in enumerate(items):\n" +
"        pb=p.encode('utf-8','replace')\n" +
"        hashes[i]=xxh64_fallback(pb)\n" +
"        p_off[i]=len(pool); p_len[i]=len(pb); pool.extend(pb)\n" +
"        c_off[i]=len(pool); c_len[i]=len(c); pool.extend(c)\n" +
"        lru[i]=now_us-i  # 초기엔 latest first 가 큰 값\n" +
"    header=struct.pack('<4sIII',b'CRCC',1,n,len(pool))\n" +
"    with open(BIN,'wb') as f:\n" +
"        f.write(header)\n" +
"        f.write(hashes.tobytes())\n" +
"        f.write(p_off.tobytes()); f.write(p_len.tobytes())\n" +
"        f.write(c_off.tobytes()); f.write(c_len.tobytes())\n" +
"        f.write(lru.tobytes())\n" +
"        f.write(pool)\n" +
"    t1=time.perf_counter()\n" +
"    bsz=os.path.getsize(BIN)\n" +
"    return {'encode_s':t1-t0,'n_total':len(reads),'n_uniq':n,'raw_total':raw_total,'blob_size':bsz,'paths':len(paths),'reads_total':len(reads),'pool_sz':len(pool)}\n" +
"\n" +
"class Blob:\n" +
"    def __init__(self,path):\n" +
"        self.f=open(path,'rb')\n" +
"        self.mm=mmap.mmap(self.f.fileno(),0,prot=mmap.PROT_READ)\n" +
"        magic,ver,n,pool_sz=struct.unpack_from('<4sIII',self.mm,0)\n" +
"        if magic!=b'CRCC' or ver!=1:\n" +
"            raise ValueError(f'bad magic/ver: {magic} {ver}')\n" +
"        self.n=n; self.pool_sz=pool_sz\n" +
"        base=16\n" +
"        h_off=base; po_off=h_off+8*n; pl_off=po_off+4*n\n" +
"        co_off=pl_off+4*n; cl_off=co_off+4*n; lru_off=cl_off+4*n\n" +
"        pool_off=lru_off+8*n\n" +
"        self.mv=memoryview(self.mm)\n" +
"        hashes=array.array('Q'); hashes.frombytes(bytes(self.mv[h_off:h_off+8*n]))\n" +
"        p_off=array.array('I'); p_off.frombytes(bytes(self.mv[po_off:po_off+4*n]))\n" +
"        p_len=array.array('I'); p_len.frombytes(bytes(self.mv[pl_off:pl_off+4*n]))\n" +
"        c_off=array.array('I'); c_off.frombytes(bytes(self.mv[co_off:co_off+4*n]))\n" +
"        c_len=array.array('I'); c_len.frombytes(bytes(self.mv[cl_off:cl_off+4*n]))\n" +
"        pool=bytes(self.mv[pool_off:pool_off+pool_sz])\n" +
"        self.hashes=hashes\n" +
"        self.paths=[pool[p_off[i]:p_off[i]+p_len[i]] for i in range(n)]\n" +
"        self.contents=[pool[c_off[i]:c_off[i]+c_len[i]] for i in range(n)]\n" +
"    def get(self,path):\n" +
"        h=xxh64_fallback(path if isinstance(path,(bytes,bytearray)) else path.encode('utf-8','replace'))\n" +
"        i=bisect.bisect_left(self.hashes,h)\n" +
"        if i<self.n and self.hashes[i]==h: return self.contents[i]\n" +
"        return None\n" +
"    def close(self):\n" +
"        self.mm.close(); self.f.close()\n" +
"\n" +
"class LRU:\n" +
"    def __init__(self,cap=LRU_CAP):\n" +
"        self.cap=cap; self.d=OrderedDict()\n" +
"    def get(self,k):\n" +
"        if k in self.d:\n" +
"            self.d.move_to_end(k); return self.d[k]\n" +
"        return None\n" +
"    def put(self,k,v):\n" +
"        if k in self.d: self.d.move_to_end(k)\n" +
"        else:\n" +
"            if len(self.d)>=self.cap: self.d.popitem(last=False)\n" +
"        self.d[k]=v\n" +
"\n" +
"def cold_jsonl_scan(paths,target_path):\n" +
"    # OLD: 매 lookup 마다 모든 jsonl 의 Read tool_use 를 다시 훑는다.\n" +
"    last=None\n" +
"    for p in paths:\n" +
"        try: f=open(p,'rb')\n" +
"        except OSError: continue\n" +
"        pending={}\n" +
"        with f:\n" +
"            for ln in f:\n" +
"                ln=ln.strip()\n" +
"                if not ln or ln[:1]!=b'{': continue\n" +
"                try: o=json.loads(ln.decode('utf-8','replace'))\n" +
"                except ValueError: continue\n" +
"                msg=o.get('message')\n" +
"                if not isinstance(msg,dict): continue\n" +
"                c=msg.get('content')\n" +
"                if not isinstance(c,list): continue\n" +
"                for blk in c:\n" +
"                    if not isinstance(blk,dict): continue\n" +
"                    bt=blk.get('type')\n" +
"                    if bt=='tool_use' and blk.get('name')=='Read':\n" +
"                        inp=blk.get('input') or {}\n" +
"                        fp=inp.get('file_path') or ''\n" +
"                        tid=blk.get('id') or ''\n" +
"                        if fp==target_path and tid: pending[tid]=fp\n" +
"                    elif bt=='tool_result':\n" +
"                        tid=blk.get('tool_use_id') or ''\n" +
"                        if tid in pending:\n" +
"                            body=blk.get('content')\n" +
"                            if isinstance(body,str): last=body.encode('utf-8','replace')\n" +
"                            elif isinstance(body,list):\n" +
"                                buf=[]\n" +
"                                for tb in body:\n" +
"                                    if isinstance(tb,dict) and tb.get('type')=='text':\n" +
"                                        buf.append(tb.get('text','') or '')\n" +
"                                if buf: last=('\\n'.join(buf)).encode('utf-8','replace')\n" +
"                            del pending[tid]\n" +
"    return last\n" +
"\n" +
"def bench(src):\n" +
"    info=encode(src)\n" +
"    if info['n_total']==0:\n" +
"        print('[bench] no Read tool_uses — skip'); return\n" +
"    print(f'[encode] {info[\"encode_s\"]*1000:.1f} ms  paths={info[\"paths\"]}  reads={info[\"n_total\"]}  unique_files={info[\"n_uniq\"]}')\n" +
"    print(f'[size] raw_jsonl={fmt(info[\"raw_total\"])}  blob={fmt(info[\"blob_size\"])}  pool={fmt(info[\"pool_sz\"])}')\n" +
"    b=Blob(BIN)\n" +
"    rss_blob=rss()\n" +
"    sample_paths=[bp.decode('utf-8','replace') for bp in b.paths[:min(50,b.n)]]\n" +
"    if not sample_paths:\n" +
"        print('[bench] no sample paths'); b.close(); return\n" +
"    # warmup\n" +
"    for sp in sample_paths[:3]: b.get(sp)\n" +
"    # NEW: blob hit\n" +
"    t0=time.perf_counter()\n" +
"    hits=0\n" +
"    for sp in sample_paths:\n" +
"        if b.get(sp) is not None: hits+=1\n" +
"    t1=time.perf_counter()\n" +
"    blob_us=(t1-t0)*1e6/len(sample_paths)\n" +
"    # NEW: LRU layer (warm)\n" +
"    lru=LRU(LRU_CAP)\n" +
"    for sp in sample_paths: lru.put(sp,b.get(sp))\n" +
"    t0=time.perf_counter()\n" +
"    lru_hits=0\n" +
"    for sp in sample_paths*3:  # 3-pass for hit ratio\n" +
"        if lru.get(sp) is not None: lru_hits+=1\n" +
"    t1=time.perf_counter()\n" +
"    lru_us=(t1-t0)*1e6/(len(sample_paths)*3)\n" +
"    # OLD: cold jsonl scan (sub-sample — 비싸)\n" +
"    paths=expand_input(src)\n" +
"    cold_n=min(3,len(sample_paths))\n" +
"    t0=time.perf_counter()\n" +
"    cold_hits=0\n" +
"    for sp in sample_paths[:cold_n]:\n" +
"        if cold_jsonl_scan(paths,sp) is not None: cold_hits+=1\n" +
"    t1=time.perf_counter()\n" +
"    cold_us=(t1-t0)*1e6/max(1,cold_n)\n" +
"    rss_cold=rss()\n" +
"    print(f'[query] {len(sample_paths)} Read-cache lookups  blob_hits={hits} lru_hits={lru_hits}/{len(sample_paths)*3} cold_hits={cold_hits}/{cold_n}')\n" +
"    print(f'  cold jsonl scan (per-query)        : {cold_us:12.1f} us')\n" +
"    print(f'  blob mmap + xxh64 + bisect          : {blob_us:12.2f} us')\n" +
"    print(f'  LRU OrderedDict (capacity {LRU_CAP})    : {lru_us:12.2f} us')\n" +
"    if blob_us>0:\n" +
"        print(f'  speedup blob vs cold : {cold_us/blob_us:8.1f}x')\n" +
"    if lru_us>0:\n" +
"        print(f'  speedup LRU  vs cold : {cold_us/lru_us:8.1f}x')\n" +
"    print(f'[rss] after blob   : {fmt(rss_blob)}')\n" +
"    print(f'[rss] after cold   : {fmt(rss_cold)}')\n" +
"    b.close()\n" +
"\n" +
"if mode=='encode':\n" +
"    info=encode(src)\n" +
"    print(f'encoded {info[\"n_uniq\"]} unique files / {info[\"reads_total\"]} reads in {info[\"encode_s\"]*1000:.1f} ms → {BIN} ({fmt(info[\"blob_size\"])})')\n" +
"elif mode=='bench':\n" +
"    bench(src)\n" +
"else:\n" +
"    print('usage: encode|bench <jsonl_or_dir>'); sys.exit(2)\n"

fn run() {
    let argv = args()
    let mut mode = "bench"
    let mut target = ""
    let mut i = 0
    while i < len(argv) {
        let v = argv[i]
        let is_hexa_bin = v.contains("/hexa-lang/") || v == "hexa" || v == "hexa.real"
        let is_self     = v.contains("claude_read_content_cache")
        if is_hexa_bin == false && is_self == false {
            if v == "encode" || v == "bench" { mode = v }
            else if v.contains(".jsonl") || v.contains("/projects") || v.contains("/.claude") { target = v }
        }
        i = i + 1
    }
    if len(target) == 0 {
        target = env("HOME") + "/.claude/projects"
        println("(default target: " + target + ")")
    }
    let tmp_py = "/tmp/claude_read_content_cache_" + exec("date +%s%N").trim() + ".py"
    write_file(tmp_py, PAYLOAD)
    let cmd = "/usr/bin/perl -e 'alarm 120; exec @ARGV' /usr/bin/python3 '" + tmp_py + "' '" + mode + "' '" + target + "' 2>&1; rm -f '" + tmp_py + "'"
    let result = exec(cmd)
    print(result)
}

run()
