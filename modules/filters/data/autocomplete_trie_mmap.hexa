// airgenome/modules/filters/data/autocomplete_trie_mmap.hexa
//   F58 — Autocomplete Prefix Blob Filter (APBF) — E4 (SHBF) 의 일반화.
//
//   Axis 차이:
//     E4/SHBF: Safari History.db (sqlite schema-coupled) → blob.
//     F58/APBF: schema-free (string, score) sequence → blob. URL/문장/임의 토큰
//               어느 sorted 데이터셋에도 적용 가능. Safari 데이터도 입력 가능.
//
//   blob layout (little-endian):
//     magic   : 4B  "APBF"          (Autocomplete Prefix Blob Filter)
//     version : 4B  u32             (1)
//     n       : 4B  u32             string 개수
//     str_sz  : 4B  u32             string pool 바이트 길이
//     [n*4]   : u32 offsets         pool 내 시작 (정렬된 순)
//     [n*4]   : u32 lens            각 길이
//     [n*4]   : u32 score           score / visit_count / weight (top-K 키)
//     [str_sz]: utf-8 string pool   raw bytes (NUL 없음)
//
//   query: 정렬된 string + bisect_left 두 번 → range. range 안에서 score 로 top-K heap.
//
// 모드:
//   encode <input>     : line-tsv (`<str>\t<score>`) 또는 jsonl (`{"url":...,"score":...}`)
//                        → /tmp/<basename>_apbf.bin. input="-" or "synthetic" → 10K synthetic.
//   bench  <input>     : encode 후 linear scan vs sorted bisect vs trie traversal 3-way.
//
// R1 HEXA-FIRST: 인라인 python3 페이로드 (.py 신규 없음).
// R17: /usr/bin/perl alarm 120s wrapper.

let PAYLOAD = "import sys,os,struct,time,bisect,heapq,resource,mmap,array,json,random,tempfile\n" +
"mode=sys.argv[1]; src=sys.argv[2]\n" +
"def fmt(b):\n" +
"    if b>1048576: return f'{b/1048576:.2f}MB'\n" +
"    if b>1024: return f'{b/1024:.1f}KB'\n" +
"    return f'{b}B'\n" +
"def rss():\n" +
"    r=resource.getrusage(resource.RUSAGE_SELF).ru_maxrss\n" +
"    if sys.platform=='darwin': return r\n" +
"    return r*1024\n" +
"\n" +
"DOMAINS=['github.com','google.com','stackoverflow.com','youtube.com','wikipedia.org','reddit.com','developer.mozilla.org','docs.python.org','news.ycombinator.com','twitter.com','apple.com','anthropic.com','openai.com','arxiv.org','medium.com','linkedin.com','amazon.com','netflix.com','spotify.com','dropbox.com']\n" +
"\n" +
"def synth(n=10000,seed=42):\n" +
"    rng=random.Random(seed)\n" +
"    out=[]\n" +
"    for i in range(n):\n" +
"        d=DOMAINS[i%len(DOMAINS)]\n" +
"        u=f'https://{d}/path{i}/page{i%137}/sub{rng.randrange(99)}'\n" +
"        out.append((u,(i*7)%1000))\n" +
"    return out\n" +
"\n" +
"def load_input(path):\n" +
"    if path in ('-','synthetic',''):\n" +
"        return synth(10000)\n" +
"    if not os.path.exists(path):\n" +
"        print(f'ERROR: not found: {path}'); sys.exit(1)\n" +
"    rows=[]\n" +
"    with open(path,'rb') as f:\n" +
"        head=f.read(2); f.seek(0)\n" +
"        is_json=head.startswith(b'{')\n" +
"        for ln in f:\n" +
"            ln=ln.rstrip(b'\\r\\n')\n" +
"            if not ln: continue\n" +
"            if is_json:\n" +
"                try:\n" +
"                    o=json.loads(ln)\n" +
"                    u=o.get('url') or o.get('str') or o.get('s') or ''\n" +
"                    s=int(o.get('score') or o.get('visit_count') or o.get('weight') or 0)\n" +
"                except Exception: continue\n" +
"            else:\n" +
"                parts=ln.decode('utf-8','replace').split('\\t')\n" +
"                u=parts[0]\n" +
"                try: s=int(parts[1]) if len(parts)>1 else 0\n" +
"                except: s=0\n" +
"            if u: rows.append((u,s))\n" +
"    return rows\n" +
"\n" +
"def out_path(src):\n" +
"    if src in ('-','synthetic',''): base='synthetic'\n" +
"    else: base=os.path.splitext(os.path.basename(src))[0]\n" +
"    return f'/tmp/{base}_apbf.bin'\n" +
"\n" +
"def encode(src):\n" +
"    t0=time.perf_counter()\n" +
"    rows=load_input(src)\n" +
"    if not rows:\n" +
"        print('ERROR: no rows'); sys.exit(1)\n" +
"    rows.sort(key=lambda r:r[0])\n" +
"    n=len(rows)\n" +
"    pool=bytearray()\n" +
"    offs=array.array('I',[0]*n)\n" +
"    lens=array.array('I',[0]*n)\n" +
"    scs =array.array('I',[0]*n)\n" +
"    for i,(s,sc) in enumerate(rows):\n" +
"        sb=s.encode('utf-8','replace')\n" +
"        offs[i]=len(pool); lens[i]=len(sb); scs[i]=int(sc)&0xffffffff\n" +
"        pool.extend(sb)\n" +
"    header=struct.pack('<4sIII',b'APBF',1,n,len(pool))\n" +
"    bin_path=out_path(src)\n" +
"    with open(bin_path,'wb') as f:\n" +
"        f.write(header)\n" +
"        f.write(offs.tobytes()); f.write(lens.tobytes()); f.write(scs.tobytes())\n" +
"        f.write(pool)\n" +
"    t1=time.perf_counter()\n" +
"    bsz=os.path.getsize(bin_path)\n" +
"    raw_est=sum(len(s.encode('utf-8','replace'))+1 for s,_ in rows)+8*n\n" +
"    return {'encode_s':t1-t0,'n':n,'bin':bin_path,'blob_size':bsz,'raw_est':raw_est}\n" +
"\n" +
"class Blob:\n" +
"    def __init__(self,path):\n" +
"        self.f=open(path,'rb')\n" +
"        self.mm=mmap.mmap(self.f.fileno(),0,prot=mmap.PROT_READ)\n" +
"        magic,ver,n,pool_sz=struct.unpack_from('<4sIII',self.mm,0)\n" +
"        if magic!=b'APBF' or ver!=1:\n" +
"            raise ValueError(f'bad magic/ver: {magic} {ver}')\n" +
"        self.n=n; self.pool_sz=pool_sz\n" +
"        base=16\n" +
"        self.offs_off=base; self.lens_off=base+4*n\n" +
"        self.scs_off =base+8*n; self.pool_off=base+12*n\n" +
"        self.mv=memoryview(self.mm)\n" +
"        offs=array.array('I'); offs.frombytes(bytes(self.mv[self.offs_off:self.offs_off+4*n]))\n" +
"        lens=array.array('I'); lens.frombytes(bytes(self.mv[self.lens_off:self.lens_off+4*n]))\n" +
"        scs =array.array('I'); scs.frombytes(bytes(self.mv[self.scs_off :self.scs_off +4*n]))\n" +
"        pool=bytes(self.mv[self.pool_off:self.pool_off+pool_sz])\n" +
"        self.urls=[pool[offs[i]:offs[i]+lens[i]] for i in range(n)]\n" +
"        self.scs=scs\n" +
"    def url(self,i): return self.urls[i]\n" +
"    def linear_topk(self,prefix,k=10):\n" +
"        pb=prefix.encode('utf-8') if isinstance(prefix,str) else prefix\n" +
"        cand=[]\n" +
"        for i,u in enumerate(self.urls):\n" +
"            if u.startswith(pb): cand.append(i)\n" +
"        if len(cand)<=k: idxs=cand\n" +
"        else: idxs=heapq.nlargest(k,cand,key=lambda i:self.scs[i])\n" +
"        idxs.sort(key=lambda i:-self.scs[i])\n" +
"        return [(self.urls[i].decode('utf-8','replace'),int(self.scs[i])) for i in idxs]\n" +
"    def bisect_topk(self,prefix,k=10):\n" +
"        pb=prefix.encode('utf-8') if isinstance(prefix,str) else prefix\n" +
"        urls=self.urls\n" +
"        start=bisect.bisect_left(urls,pb)\n" +
"        end=bisect.bisect_left(urls,pb+b'\\xff\\xff\\xff\\xff')\n" +
"        if end==start: return []\n" +
"        if end-start<=k: idxs=list(range(start,end))\n" +
"        else: idxs=heapq.nlargest(k,range(start,end),key=lambda i:self.scs[i])\n" +
"        idxs.sort(key=lambda i:-self.scs[i])\n" +
"        return [(self.urls[i].decode('utf-8','replace'),int(self.scs[i])) for i in idxs]\n" +
"    def trie_topk(self,prefix,k=10):\n" +
"        # simulated trie traversal — descend char-by-char via bisect_left repeatedly.\n" +
"        # 효과: 동일 결과지만 상수 inflate (3-way 비교용 honest baseline).\n" +
"        pb=prefix.encode('utf-8') if isinstance(prefix,str) else prefix\n" +
"        urls=self.urls\n" +
"        lo=0; hi=len(urls)\n" +
"        for ci in range(len(pb)):\n" +
"            seg=pb[:ci+1]\n" +
"            lo=bisect.bisect_left(urls,seg,lo,hi)\n" +
"            hi=bisect.bisect_left(urls,seg+b'\\xff\\xff\\xff\\xff',lo,hi)\n" +
"            if lo>=hi: return []\n" +
"        if hi-lo<=k: idxs=list(range(lo,hi))\n" +
"        else: idxs=heapq.nlargest(k,range(lo,hi),key=lambda i:self.scs[i])\n" +
"        idxs.sort(key=lambda i:-self.scs[i])\n" +
"        return [(self.urls[i].decode('utf-8','replace'),int(self.scs[i])) for i in idxs]\n" +
"    def close(self):\n" +
"        try: self.mv.release()\n" +
"        except Exception: pass\n" +
"        self.mm.close(); self.f.close()\n" +
"\n" +
"def make_prefixes(b,n=200,seed=7):\n" +
"    rng=random.Random(seed)\n" +
"    out=[]\n" +
"    for _ in range(n):\n" +
"        i=rng.randrange(b.n)\n" +
"        u=b.url(i).decode('utf-8','replace')\n" +
"        s=u.find('://'); start=s+3 if s>=0 else 0\n" +
"        plen=rng.choice([4,5,6,7,8,10,12])\n" +
"        out.append(u[:start+plen] if len(u)>=start+plen else u)\n" +
"    return out\n" +
"\n" +
"def bench(src):\n" +
"    info=encode(src)\n" +
"    print(f'[encode] {info[\"encode_s\"]*1000:.1f} ms  n={info[\"n\"]}  blob={fmt(info[\"blob_size\"])} (raw_est {fmt(info[\"raw_est\"])}, {100*info[\"blob_size\"]/info[\"raw_est\"]:.1f}%)')\n" +
"    b=Blob(info['bin'])\n" +
"    samples=make_prefixes(b,200)\n" +
"    rss_loaded=rss()\n" +
"    # warmup\n" +
"    for p in samples[:5]:\n" +
"        b.linear_topk(p,10); b.bisect_topk(p,10); b.trie_topk(p,10)\n" +
"    # 1) linear scan\n" +
"    t0=time.perf_counter(); h_lin=0\n" +
"    for p in samples:\n" +
"        r=b.linear_topk(p,10); h_lin+=len(r)\n" +
"    t1=time.perf_counter(); lin_us=(t1-t0)*1e6/len(samples)\n" +
"    # 2) bisect on sorted blob\n" +
"    t0=time.perf_counter(); h_bi=0\n" +
"    for p in samples:\n" +
"        r=b.bisect_topk(p,10); h_bi+=len(r)\n" +
"    t1=time.perf_counter(); bi_us=(t1-t0)*1e6/len(samples)\n" +
"    # 3) trie-traversal\n" +
"    t0=time.perf_counter(); h_tr=0\n" +
"    for p in samples:\n" +
"        r=b.trie_topk(p,10); h_tr+=len(r)\n" +
"    t1=time.perf_counter(); tr_us=(t1-t0)*1e6/len(samples)\n" +
"    b.close()\n" +
"    print(f'[query] {len(samples)} prefix-topK-10  hits linear={h_lin} bisect={h_bi} trie={h_tr}')\n" +
"    print(f'  linear scan       : {lin_us:10.1f} us/query')\n" +
"    print(f'  bisect on blob    : {bi_us :10.1f} us/query')\n" +
"    print(f'  trie traversal    : {tr_us :10.1f} us/query')\n" +
"    if bi_us>0: print(f'  speedup linear→bisect: {lin_us/bi_us:6.1f}x')\n" +
"    if tr_us>0: print(f'  speedup linear→trie  : {lin_us/tr_us:6.1f}x')\n" +
"    if bi_us>0 and tr_us>0: print(f'  bisect vs trie ratio : {tr_us/bi_us:6.2f}x (>1 = bisect faster)')\n" +
"    print(f'[lossless] hits all equal: {h_lin==h_bi==h_tr}')\n" +
"    print(f'[rss] after blob loaded: {fmt(rss_loaded)}')\n" +
"\n" +
"if mode=='encode':\n" +
"    info=encode(src)\n" +
"    print(f'encoded {info[\"n\"]} strings in {info[\"encode_s\"]*1000:.1f} ms → {info[\"bin\"]} ({fmt(info[\"blob_size\"])}, raw_est {fmt(info[\"raw_est\"])}, {100*info[\"blob_size\"]/info[\"raw_est\"]:.1f}%)')\n" +
"elif mode=='bench':\n" +
"    bench(src)\n" +
"else:\n" +
"    print('usage: encode|bench <input|synthetic|->'); sys.exit(2)\n"

fn run() {
    let argv = args()
    let mut mode = "bench"
    let mut target = "synthetic"
    let mut i = 0
    while i < len(argv) {
        let v = argv[i]
        let is_hexa_bin = v.contains("/hexa-lang/") || v == "hexa" || v == "hexa.real"
        let is_self     = v.contains("autocomplete_trie_mmap")
        if is_hexa_bin == false && is_self == false {
            if v == "encode" || v == "bench" { mode = v }
            else if v == "-" || v == "synthetic" { target = v }
            else if v.contains(".tsv") || v.contains(".jsonl") || v.contains(".txt") || v.contains("/") { target = v }
        }
        i = i + 1
    }
    let tmp_py = "/tmp/autocomplete_trie_mmap_" + exec("date +%s%N").trim() + ".py"
    write_file(tmp_py, PAYLOAD)
    let cmd = "/usr/bin/perl -e 'alarm 120; exec @ARGV' /usr/bin/python3 '" + tmp_py + "' '" + mode + "' '" + target + "' 2>&1; rm -f '" + tmp_py + "'"
    let result = exec(cmd)
    print(result)
}

run()
