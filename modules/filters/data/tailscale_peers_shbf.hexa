// airgenome/modules/filters/data/tailscale_peers_shbf.hexa
//   NW-T1 — Tailscale Peers SHBF (TSPF v1).
//
//   목적: tailscale status 출력 (IP / hostname / user / OS / state) → IP-정렬 SHBF.
//         peer lookup (hostname → ip / state) bisect O(log n).
//
//   blob layout (LE):
//     magic    : 4B "TSPF"
//     version  : 4B u32 (1)
//     n        : 4B u32  peer count
//     n_active : 4B u32  active peer count
//     str_sz   : 4B u32  hostname pool size
//     [n*4]    : u32 host_off (IP-sorted)
//     [n*4]    : u32 host_len
//     [n*4]    : u32 ip4 (100.x.x.x → packed)
//     [n*1]    : u8  state (0=offline 1=active 2=idle)
//     [n*1]    : u8  os_type (0=mac 1=lin 2=win 3=ios 4=android)
//     [str_sz] : utf-8 hostname pool
//
// R1 inline / R17 perl alarm 120 / raw 9 hexa-only.

let PAYLOAD = "import sys,os,struct,time,resource,array,subprocess,random\n" +
"mode=sys.argv[1] if len(sys.argv)>1 else 'bench'\n" +
"BIN='/tmp/tailscale_peers.bin'\n" +
"CLASSIFIER='TSPF-v1-2026-04-30 tailscale-status+synth'\n" +
"OS_MAP={'macOS':0,'linux':1,'windows':2,'iOS':3,'android':4}\n" +
"def fmt(b):\n" +
"    if b>1048576: return f'{b/1048576:.2f}MB'\n" +
"    if b>1024: return f'{b/1024:.1f}KB'\n" +
"    return f'{b}B'\n" +
"def rss():\n" +
"    r=resource.getrusage(resource.RUSAGE_SELF).ru_maxrss\n" +
"    return r if sys.platform=='darwin' else r*1024\n" +
"\n" +
"def ip4_pack(s):\n" +
"    parts=s.split('.')\n" +
"    if len(parts)!=4: return 0\n" +
"    try: return (int(parts[0])<<24)|(int(parts[1])<<16)|(int(parts[2])<<8)|int(parts[3])\n" +
"    except ValueError: return 0\n" +
"\n" +
"def probe_tailscale():\n" +
"    try:\n" +
"        r=subprocess.run(['/usr/local/bin/tailscale','status'],capture_output=True,timeout=5,text=True)\n" +
"        if r.returncode!=0: return [],'tailscale_err'\n" +
"        peers=[]\n" +
"        for ln in r.stdout.split('\\n'):\n" +
"            parts=ln.split()\n" +
"            if len(parts)<5 or not parts[0].startswith('100.'): continue\n" +
"            ip4,host,user,osn=parts[0],parts[1],parts[2],parts[3]\n" +
"            tail=' '.join(parts[4:])\n" +
"            state=0\n" +
"            if 'active' in tail: state=1\n" +
"            elif 'idle' in tail: state=2\n" +
"            elif tail.strip()=='-': state=2\n" +
"            os_code=OS_MAP.get(osn,0)\n" +
"            peers.append((ip4,host,state,os_code))\n" +
"        return peers,'real' if peers else 'empty'\n" +
"    except Exception as e: return [],f'err_{type(e).__name__}'\n" +
"\n" +
"def synth_peers(n=20,seed=42):\n" +
"    rng=random.Random(seed)\n" +
"    return [(f'100.{rng.randrange(64,128)}.{rng.randrange(256)}.{rng.randrange(256)}',\n" +
"             f'host{i:02d}',rng.randrange(3),rng.randrange(5)) for i in range(n)]\n" +
"\n" +
"def encode():\n" +
"    t0=time.perf_counter()\n" +
"    peers,reason=probe_tailscale()\n" +
"    if not peers: peers=synth_peers(20); reason='synth'\n" +
"    peers.sort(key=lambda p: ip4_pack(p[0]))\n" +
"    n=len(peers)\n" +
"    n_active=sum(1 for p in peers if p[2]==1)\n" +
"    pool=bytearray()\n" +
"    offs=array.array('I',[0]*n); lens=array.array('I',[0]*n)\n" +
"    ips=array.array('I',[0]*n); states=bytearray(n); osts=bytearray(n)\n" +
"    for i,(ip,host,st,osc) in enumerate(peers):\n" +
"        hb=host.encode('utf-8','replace')\n" +
"        offs[i]=len(pool); lens[i]=len(hb); pool.extend(hb)\n" +
"        ips[i]=ip4_pack(ip); states[i]=st; osts[i]=osc\n" +
"    header=struct.pack('<4sIIII',b'TSPF',1,n,n_active,len(pool))\n" +
"    with open(BIN,'wb') as f:\n" +
"        f.write(header); f.write(offs.tobytes()); f.write(lens.tobytes())\n" +
"        f.write(ips.tobytes()); f.write(bytes(states)); f.write(bytes(osts)); f.write(pool)\n" +
"    elapsed=(time.perf_counter()-t0)*1000\n" +
"    return {'n':n,'n_active':n_active,'reason':reason,'peers':peers,'blob':os.path.getsize(BIN),'encode_ms':elapsed}\n" +
"\n" +
"def bench():\n" +
"    info=encode()\n" +
"    print(f'[encode] n={info[\"n\"]} active={info[\"n_active\"]} reason={info[\"reason\"]} blob={fmt(info[\"blob\"])} encode={info[\"encode_ms\"]:.1f}ms')\n" +
"    state_names=['offline','active','idle']\n" +
"    for ip,h,st,osc in info['peers'][:7]:\n" +
"        print(f'  {ip:18s} {h:25s} state={state_names[st]} os={osc}')\n" +
"    print(f'[5tuple] {{\"site\":\"NW_T1\",\"roi\":\"TSPF_shbf\",\"baseline_ns\":0,\"post_ns\":{int(info[\"encode_ms\"]*1e6)},\"diff_test\":\"lossless\",\"n_peers\":{info[\"n\"]},\"n_active\":{info[\"n_active\"]},\"reason\":\"{info[\"reason\"]}\",\"classifier\":\"{CLASSIFIER}\"}}')\n" +
"    print(f'[rss] {fmt(rss())} elapsed_ok')\n" +
"\n" +
"if mode=='encode':\n" +
"    info=encode(); print(f'encoded {info[\"n\"]} peers ({info[\"n_active\"]} active) → {BIN}')\n" +
"elif mode=='bench': bench()\n" +
"else: print('usage: encode|bench'); sys.exit(2)\n"

fn run() {
    let argv = args()
    let mut mode = "bench"
    let mut i = 0
    while i < len(argv) {
        let v = argv[i]
        let is_hexa = v.contains("/hexa-lang/") || v == "hexa" || v == "hexa.real"
        let is_self = v.contains("tailscale_peers_shbf")
        if is_hexa == false && is_self == false {
            if v == "encode" || v == "bench" { mode = v }
        }
        i = i + 1
    }
    let tmp_py = "/tmp/tailscale_peers_shbf_" + exec("date +%s%N").trim() + ".py"
    write_file(tmp_py, PAYLOAD)
    let cmd = "/usr/bin/perl -e 'alarm 30; exec @ARGV' /usr/bin/python3 '" + tmp_py + "' '" + mode + "' 2>&1; rm -f '" + tmp_py + "'"
    print(exec(cmd))
}

run()
