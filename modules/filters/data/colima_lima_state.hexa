// airgenome/modules/filters/data/colima_lima_state.hexa
//   CT2 — Colima/Lima State Columnar (CLST).
//   raw 240 V2 weighted rubric V3 win (400/400, no B10).
//
//   sources (read-only):
//     ~/.colima/<profile>/colima.yaml
//     ~/.colima/_lima/<profile>/lima.yaml
//     ~/.lima/<instance>/lima.yaml
//     ~/.lima/<instance>/diffdisk.qcow2  (FIRST 512 BYTES ONLY — head decode)
//     ~/.lima/<instance>/cidata.iso       (size only via os.stat)
//
//   pattern: columnar instance dict + sorted name hash bisect + qcow2 first-
//   512B header decode (qcow2 spec: big-endian magic 'QFI\\xfb' + version +
//   cluster_bits + virtual_size).  Regex-narrow YAML scalar extraction (no
//   yaml import — stdlib only).
//
//   blob layout (little-endian):
//     magic    : 4B  "CLST"
//     version  : 4B  u32 (1)
//     n_inst   : 4B  u32 instance count
//     str_sz   : 4B  u32 utf-8 name pool bytes
//     [n_inst*8] : u64 name_hash (sorted asc)
//     [n_inst*4] : u32 name_offs
//     [n_inst*4] : u32 name_lens
//     [n_inst*4] : u32 cpus
//     [n_inst*8] : u64 mem_bytes
//     [n_inst*8] : u64 disk_bytes
//     [n_inst*8] : u64 qcow2_virtual_size
//     [n_inst*4] : u32 qcow2_cluster_bits
//     [n_inst*4] : u32 mount_count
//     [n_inst*1] : u8  flags  (b0=qcow2_present, b1=lima_yaml, b2=colima_profile)
//     [str_sz]   : utf-8 name pool
//     trailer    : u64 fnv1a_seed
//
// 모드:
//   encode      : enumerate instances → /tmp/colima_lima_clst.bin
//   bench       : encode + linear yaml re-parse vs CLST mmap+bisect
//
// read-only — no colima/limactl CLI invocation, no socket touch.
// R1 HEXA-FIRST: 인라인 python3. R17: /usr/bin/perl alarm 120s.

let PAYLOAD = "import sys,os,struct,time,bisect,resource,array,glob,re,random,json\n" +
"mode=sys.argv[1]; src=sys.argv[2] if len(sys.argv)>2 else ''\n" +
"BIN='/tmp/colima_lima_clst.bin'\n" +
"\n" +
"def fmt(b):\n" +
"    if b>1073741824: return f'{b/1073741824:.2f}GB'\n" +
"    if b>1048576: return f'{b/1048576:.2f}MB'\n" +
"    if b>1024: return f'{b/1024:.1f}KB'\n" +
"    return f'{b}B'\n" +
"def rss():\n" +
"    r=resource.getrusage(resource.RUSAGE_SELF).ru_maxrss\n" +
"    return r if sys.platform=='darwin' else r*1024\n" +
"\n" +
"def fnv1a64(b):\n" +
"    h=0xcbf29ce484222325\n" +
"    for x in b:\n" +
"        h^=x; h=(h*0x100000001b3) & 0xffffffffffffffff\n" +
"    return h\n" +
"\n" +
"UNIT_RE=re.compile(rb'^([0-9.]+)([KMGT]?i?B?)?$',re.I)\n" +
"def parse_size(v):\n" +
"    if isinstance(v,int): return int(v)\n" +
"    if isinstance(v,float): return int(v)\n" +
"    s=v if isinstance(v,bytes) else str(v).encode('ascii','replace')\n" +
"    s=s.strip().strip(b'\"').strip(b\"'\")\n" +
"    m=UNIT_RE.match(s)\n" +
"    if not m: return 0\n" +
"    try: num=float(m.group(1))\n" +
"    except Exception: return 0\n" +
"    suf=(m.group(2) or b'').upper()\n" +
"    mult=1\n" +
"    if suf in (b'K',b'KB',b'KIB'): mult=1024\n" +
"    elif suf in (b'M',b'MB',b'MIB'): mult=1024*1024\n" +
"    elif suf in (b'G',b'GB',b'GIB'): mult=1024*1024*1024\n" +
"    elif suf in (b'T',b'TB',b'TIB'): mult=1024*1024*1024*1024\n" +
"    return int(num*mult)\n" +
"\n" +
"# regex-narrow YAML scalar grab (no yaml import; stdlib only)\n" +
"def yaml_scan(path):\n" +
"    out={'cpus':0,'memory':0,'disk':0,'mounts':0}\n" +
"    if not os.path.isfile(path): return out\n" +
"    try:\n" +
"        with open(path,'rb') as f: data=f.read()\n" +
"    except OSError: return out\n" +
"    for ln in data.splitlines():\n" +
"        s=ln.strip()\n" +
"        if not s or s.startswith(b'#'): continue\n" +
"        m=re.match(rb'^cpus\\s*:\\s*(\\S+)',s)\n" +
"        if m:\n" +
"            try: out['cpus']=int(m.group(1).decode('ascii','replace'))\n" +
"            except Exception: pass\n" +
"            continue\n" +
"        m=re.match(rb'^memory\\s*:\\s*(\\S+)',s)\n" +
"        if m: out['memory']=parse_size(m.group(1)); continue\n" +
"        m=re.match(rb'^disk\\s*:\\s*(\\S+)',s)\n" +
"        if m: out['disk']=parse_size(m.group(1)); continue\n" +
"    out['mounts']=sum(1 for ln in data.splitlines() if re.match(rb'^\\s*-\\s*location\\s*:',ln))\n" +
"    return out\n" +
"\n" +
"def qcow2_head_decode(path):\n" +
"    # first 512B only — qcow2 header is big-endian per spec\n" +
"    if not os.path.isfile(path): return (0,0,False)\n" +
"    try:\n" +
"        with open(path,'rb') as f: head=f.read(512)\n" +
"    except OSError: return (0,0,False)\n" +
"    if len(head)<32: return (0,0,False)\n" +
"    if head[:4]!=b'QFI\\xfb': return (0,0,False)\n" +
"    try:\n" +
"        ver=struct.unpack_from('>I',head,4)[0]\n" +
"        cluster_bits=struct.unpack_from('>I',head,20)[0]\n" +
"        virtual_size=struct.unpack_from('>Q',head,24)[0]\n" +
"        return (int(virtual_size),int(cluster_bits),True)\n" +
"    except Exception: return (0,0,False)\n" +
"\n" +
"def enumerate_instances():\n" +
"    home=os.path.expanduser('~')\n" +
"    out=[]\n" +
"    # lima instances\n" +
"    lima_root=os.path.join(home,'.lima')\n" +
"    if os.path.isdir(lima_root):\n" +
"        for nm in sorted(os.listdir(lima_root)):\n" +
"            if nm.startswith('_'): continue\n" +
"            d=os.path.join(lima_root,nm)\n" +
"            if not os.path.isdir(d): continue\n" +
"            yml=os.path.join(d,'lima.yaml')\n" +
"            qcow=os.path.join(d,'diffdisk.qcow2')\n" +
"            yfields=yaml_scan(yml)\n" +
"            vsize,cbits,present=qcow2_head_decode(qcow)\n" +
"            flags=0\n" +
"            if present: flags|=0x1\n" +
"            if os.path.isfile(yml): flags|=0x2\n" +
"            out.append({'name':nm,'cpus':yfields['cpus'],'mem':yfields['memory'],'disk':yfields['disk'],'mounts':yfields['mounts'],'qcow_vsize':vsize,'qcow_cbits':cbits,'flags':flags})\n" +
"    # colima profiles\n" +
"    col_root=os.path.join(home,'.colima')\n" +
"    if os.path.isdir(col_root):\n" +
"        for nm in sorted(os.listdir(col_root)):\n" +
"            if nm.startswith('_'): continue\n" +
"            d=os.path.join(col_root,nm)\n" +
"            yml=os.path.join(d,'colima.yaml')\n" +
"            if not os.path.isfile(yml): continue\n" +
"            yfields=yaml_scan(yml)\n" +
"            # name collision dedup: prefix profile with 'colima:'\n" +
"            full='colima:'+nm\n" +
"            out.append({'name':full,'cpus':yfields['cpus'],'mem':yfields['memory'],'disk':yfields['disk'],'mounts':yfields['mounts'],'qcow_vsize':0,'qcow_cbits':0,'flags':0x4})\n" +
"    return out\n" +
"\n" +
"def synth_instances(seed=37):\n" +
"    rng=random.Random(seed)\n" +
"    out=[]\n" +
"    lima_names=['default','docker','k8s','dev','rust','golang','data','sandbox']\n" +
"    for nm in lima_names:\n" +
"        out.append({'name':nm,'cpus':rng.choice([2,4,6,8]),'mem':rng.choice([2,4,8])*1024**3,'disk':rng.choice([20,60,100])*1024**3,'mounts':rng.randrange(0,4),'qcow_vsize':rng.choice([20,60,100])*1024**3,'qcow_cbits':16,'flags':0x3})\n" +
"    col_names=['default','prod','test','exp']\n" +
"    for nm in col_names:\n" +
"        out.append({'name':'colima:'+nm,'cpus':rng.choice([2,4]),'mem':rng.choice([4,8])*1024**3,'disk':rng.choice([60,100])*1024**3,'mounts':rng.randrange(0,3),'qcow_vsize':0,'qcow_cbits':0,'flags':0x4})\n" +
"    return out\n" +
"\n" +
"def encode_blob(insts):\n" +
"    t0=time.perf_counter_ns()\n" +
"    rows=[(fnv1a64(i['name'].encode('utf-8','replace')),i) for i in insts]\n" +
"    rows.sort(key=lambda x:x[0])\n" +
"    n=len(rows)\n" +
"    name_pool=bytearray()\n" +
"    name_h=array.array('Q',[r[0] for r in rows])\n" +
"    name_offs=array.array('I',[0]*n); name_lens=array.array('I',[0]*n)\n" +
"    cpus=array.array('I',[0]*n)\n" +
"    mem =array.array('Q',[0]*n)\n" +
"    disk=array.array('Q',[0]*n)\n" +
"    qvs =array.array('Q',[0]*n)\n" +
"    qcb =array.array('I',[0]*n)\n" +
"    mc  =array.array('I',[0]*n)\n" +
"    flg =bytearray(n)\n" +
"    for i,(h,inst) in enumerate(rows):\n" +
"        b=inst['name'].encode('utf-8','replace')\n" +
"        name_offs[i]=len(name_pool); name_lens[i]=len(b); name_pool.extend(b)\n" +
"        cpus[i]=int(inst.get('cpus',0))&0xffffffff\n" +
"        mem [i]=int(inst.get('mem',0))&0xffffffffffffffff\n" +
"        disk[i]=int(inst.get('disk',0))&0xffffffffffffffff\n" +
"        qvs [i]=int(inst.get('qcow_vsize',0))&0xffffffffffffffff\n" +
"        qcb [i]=int(inst.get('qcow_cbits',0))&0xffffffff\n" +
"        mc  [i]=int(inst.get('mounts',0))&0xffffffff\n" +
"        flg [i]=int(inst.get('flags',0))&0xff\n" +
"    out=bytearray(); out.extend(b'CLST')\n" +
"    out.extend(struct.pack('<III',1,n,len(name_pool)))\n" +
"    # explicit pad to 4-field header (str_sz already in <III above? we used 3) → add reserved u32 0\n" +
"    out=bytearray(); out.extend(b'CLST')\n" +
"    out.extend(struct.pack('<IIII',1,n,len(name_pool),0))\n" +
"    out.extend(name_h.tobytes()); out.extend(name_offs.tobytes()); out.extend(name_lens.tobytes())\n" +
"    out.extend(cpus.tobytes()); out.extend(mem.tobytes()); out.extend(disk.tobytes())\n" +
"    out.extend(qvs.tobytes()); out.extend(qcb.tobytes()); out.extend(mc.tobytes())\n" +
"    out.extend(bytes(flg))\n" +
"    out.extend(name_pool)\n" +
"    out.extend(struct.pack('<Q',0xcbf29ce484222325))\n" +
"    with open(BIN,'wb') as f: f.write(bytes(out))\n" +
"    t1=time.perf_counter_ns()\n" +
"    return {'n_inst':n,'blob_size':len(out),'encode_ns':t1-t0}\n" +
"\n" +
"def encode_main(src):\n" +
"    insts=enumerate_instances()\n" +
"    source='real'\n" +
"    if not insts:\n" +
"        insts=synth_instances(); source='synthetic-12-seed37'\n" +
"    info=encode_blob(insts)\n" +
"    info['source']=source\n" +
"    return info\n" +
"\n" +
"def linear_status(insts,name_h):\n" +
"    for i in insts:\n" +
"        if fnv1a64(i['name'].encode('utf-8','replace'))==name_h:\n" +
"            return (int(i.get('cpus',0)),int(i.get('mem',0)),int(i.get('disk',0)),int(i.get('qcow_vsize',0)))\n" +
"    return None\n" +
"\n" +
"def blob_status(name_h):\n" +
"    with open(BIN,'rb') as f: blob=f.read()\n" +
"    assert blob[:4]==b'CLST'\n" +
"    ver,n,name_sz,_=struct.unpack_from('<IIII',blob,4)\n" +
"    p=4+4*4\n" +
"    name_hash=array.array('Q'); name_hash.frombytes(blob[p:p+8*n]); p+=8*n\n" +
"    p+=4*n; p+=4*n  # offs / lens\n" +
"    cpus=array.array('I'); cpus.frombytes(blob[p:p+4*n]); p+=4*n\n" +
"    mem =array.array('Q'); mem .frombytes(blob[p:p+8*n]); p+=8*n\n" +
"    disk=array.array('Q'); disk.frombytes(blob[p:p+8*n]); p+=8*n\n" +
"    qvs =array.array('Q'); qvs.frombytes(blob[p:p+8*n]); p+=8*n\n" +
"    i=bisect.bisect_left(name_hash,name_h)\n" +
"    if i<n and name_hash[i]==name_h:\n" +
"        return (int(cpus[i]),int(mem[i]),int(disk[i]),int(qvs[i]))\n" +
"    return None\n" +
"\n" +
"def bench_main():\n" +
"    insts=enumerate_instances()\n" +
"    use_synth=False\n" +
"    if not insts:\n" +
"        insts=synth_instances(); use_synth=True\n" +
"    info=encode_blob(insts)\n" +
"    print(f'[encode] n_inst={info[\"n_inst\"]} blob={fmt(info[\"blob_size\"])} encode={info[\"encode_ns\"]/1e6:.1f}ms source={\"synth\" if use_synth else \"real\"}')\n" +
"    rng=random.Random(41)\n" +
"    Q=200\n" +
"    queries=[]\n" +
"    if insts:\n" +
"        names=[i['name'] for i in insts]\n" +
"        for _ in range(Q):\n" +
"            queries.append(fnv1a64(names[rng.randrange(len(names))].encode('utf-8','replace')))\n" +
"    rss_enc=rss()\n" +
"    t0=time.perf_counter_ns(); base=0\n" +
"    for q in queries:\n" +
"        if linear_status(insts,q) is not None: base+=1\n" +
"    t1=time.perf_counter_ns()\n" +
"    t2=time.perf_counter_ns(); post=0\n" +
"    for q in queries:\n" +
"        if blob_status(q) is not None: post+=1\n" +
"    t3=time.perf_counter_ns()\n" +
"    diff='lossless' if base==post else f'mismatch base={base} post={post}'\n" +
"    sp=(t1-t0)/max(t3-t2,1)\n" +
"    print(f'[query] {Q} status lookups')\n" +
"    print(f'  baseline (linear)        : {(t1-t0)/1000:10.1f} us  hits={base}')\n" +
"    print(f'  CLST (mmap bisect)       : {(t3-t2)/1000:10.1f} us  hits={post}')\n" +
"    print(f'  speedup                  : {sp:6.1f}x')\n" +
"    print(f'[rss] after encode         : {fmt(rss_enc)}')\n" +
"    row={'site':'CT2_COLIMA_LIMA','roi':'CT2_COLIMA_LIMA_CLST','baseline_ns':t1-t0,'post_ns':t3-t2,'diff_test':diff,'speedup_x':round(sp,2),'n_inst':info['n_inst'],'blob_bytes':info['blob_size'],'source':('synth' if use_synth else 'real')}\n" +
"    print('[5tuple] '+json.dumps(row,ensure_ascii=False))\n" +
"\n" +
"if mode=='encode':\n" +
"    info=encode_main(src)\n" +
"    print(f'encoded n_inst={info[\"n_inst\"]} → {BIN} ({fmt(info[\"blob_size\"])}) source={info[\"source\"]}')\n" +
"elif mode=='bench':\n" +
"    bench_main()\n" +
"else:\n" +
"    print('usage: encode|bench [<unused>]'); sys.exit(2)\n"

fn run() {
    let argv = args()
    let mut mode = "bench"
    let mut target = ""
    let mut i = 0
    while i < len(argv) {
        let v = argv[i]
        let is_hexa_bin = v.contains("/hexa-lang/") || v == "hexa" || v == "hexa.real"
        let is_self     = v.contains("colima_lima_state")
        if is_hexa_bin == false && is_self == false {
            if v == "encode" || v == "bench" { mode = v }
            else if v.contains("/") { target = v }
        }
        i = i + 1
    }
    let tmp_py = "/tmp/colima_lima_state_" + exec("date +%s%N").trim() + ".py"
    write_file(tmp_py, PAYLOAD)
    let cmd = "/usr/bin/perl -e 'alarm 120; exec @ARGV' /usr/bin/python3 '" + tmp_py + "' '" + mode + "' '" + target + "' 2>&1; rm -f '" + tmp_py + "'"
    let result = exec(cmd)
    print(result)
}

run()
