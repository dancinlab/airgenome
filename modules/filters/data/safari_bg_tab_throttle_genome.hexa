// modules/filters/data/safari_bg_tab_throttle_genome.hexa
// F45 — Safari background tab 6축 게놈 투영 (Type D, Forge ring)
//
// 역할:
//   own 8 (predictive_throttle stage) 의 후속 — 시스템 전역 cpu/ram 시계열을
//   넘어, Safari WebContent 단위로 자원을 6축 게놈에 투영해 per-tab 예측 가능.
//
// 6축 매핑 (60-byte 게놈 — own 5 ring 패턴 동일):
//   axis 0 = cpu_pct        (ps pcpu, 0..100)
//   axis 1 = ram_mb         (ps rss / 1024, clip 0..255)
//   axis 2 = network_kbps   (nettop --proc 옵션 — 비용 큼 → optional skip)
//   axis 3 = idle_sec       (ps etime - 마지막 cpu activity 차)
//   axis 4 = tab_active     (frontmost Safari + 최대 cpu PID = 1, else 0)
//   axis 5 = gpu_share      (powermetrics samplers gpu_power 의 process share — 추정)
//
// 출력 ring: forge/safari_tabs.ring (JSONL append-only, own 5 site-3 batch pattern)
//   {"ts":"...","pid":N,"comm":"WebContent","rss_kb":..,"axes":[c,r,n,i,a,g]}
//
// 제약:
//   - own 8 site-13 패턴: append_file builtin, 0 fork rotate
//   - own 6 site-6 / own 7 site-9 패턴: read_file + in-hexa anchor extract
//   - try/catch 0, top-level main() 0
//   - 측정-only: 본 모듈은 ps + 옵션 powermetrics 만 호출, taskpolicy/kill 0
//
// 5-tuple bench: tool/bench/bench_f45_safari_genome.hexa
//   OLD: per-cycle (pgrep + ps + jq) full-scan + 매 PID 별 fork
//   NEW: ps 1회 batch + in-hexa parse + append_file
//   기대: 200ms/cycle → ~5ms/cycle (~40x, 95%↓), lossless

use "../../../core/core"

let RING = ring_path("safari_tabs.ring")
let MAX_RING = 240          // ~ 4시간 if 60s 주기
let GPU_SAMPLE_MS = 0       // 0 = 비활성 (powermetrics root 필요). >0 → -i ms
let CPU_AXIS_CLIP = 100
let RAM_AXIS_CLIP = 255
let NET_AXIS_CLIP = 255

fn ts_iso() -> str {
    return exec("date -u +%Y-%m-%dT%H:%M:%SZ").trim()
}

fn ts_epoch() -> int {
    return to_int(exec("date +%s").trim())
}

// ── frontmost (env shortcut, fallback lsappinfo) ──────────────────────
fn frontmost_app() -> str {
    let cached = env("AG_COORD_FRONTMOST")
    if cached != "" { return cached }
    return exec("lsappinfo info -only name \"$(lsappinfo front)\" 2>/dev/null | awk -F'\"' 'NF>=4{print $4}'").trim()
}

// ── ps 단일 호출로 모든 Safari WebContent census 추출 ─────────────────
// 1 fork: ps + grep — own 6 site-6 batch pattern.
struct TabRow {
    pid: int,
    cpu: int,        // pcpu *  (소수 절단)
    rss_kb: int,
    etime_sec: int,
    comm: str
}

fn parse_etime(et: str) -> int {
    // ps etime 형식: [[dd-]hh:]mm:ss → 초로 환산
    let mut s = et
    let mut days = 0
    if s.contains("-") {
        let dp = s.split("-")
        if len(dp) == 2 { days = to_int(dp[0].trim()); s = dp[1] }
    }
    let parts = s.split(":")
    let n = len(parts)
    if n == 3 {
        let h = to_int(parts[0].trim())
        let m = to_int(parts[1].trim())
        let sec = to_int(parts[2].trim())
        return days * 86400 + h * 3600 + m * 60 + sec
    }
    if n == 2 {
        let m = to_int(parts[0].trim())
        let sec = to_int(parts[1].trim())
        return m * 60 + sec
    }
    return to_int(s.trim())
}

fn collect_tabs() -> list {
    // pgrep -fn WebContent 보다 ps 1회가 저렴. comm 에 "WebContent" 포함만 필터.
    let raw = exec("ps -axo pid=,pcpu=,rss=,etime=,comm= 2>/dev/null | awk '$1+0>100' | grep -E 'WebContent' || true")
    let lines = raw.split("\n")
    let mut out = []
    let mut i = 0
    while i < len(lines) {
        let line = lines[i].trim()
        if line == "" { i = i + 1; continue }
        // ps 출력은 컬럼 가변 공백 — awk style split.
        let cmd_split = "echo " + "'" + line.replace("'", "'\\''") + "'" + " | awk '{pid=$1; cpu=$2; rss=$3; et=$4; $1=$2=$3=$4=\"\"; sub(/^  */,\"\"); printf \"%d|%d|%d|%s|%s\", pid, int(cpu), rss, et, $0}'"
        // exec fork 회피 위해 in-hexa 분할.
        let n = len(line)
        let mut field_starts = [0]
        let mut k = 0
        let mut in_ws = false
        while k < n {
            let ch = line.substring(k, k + 1)
            if ch == " " || ch == "\t" {
                if !in_ws { in_ws = true }
            } else {
                if in_ws {
                    field_starts = field_starts + [k]
                    in_ws = false
                }
            }
            k = k + 1
        }
        if len(field_starts) < 5 { i = i + 1; continue }
        let pid_s = line.substring(field_starts[0], field_starts[1]).trim()
        let cpu_s = line.substring(field_starts[1], field_starts[2]).trim()
        let rss_s = line.substring(field_starts[2], field_starts[3]).trim()
        let et_s  = line.substring(field_starts[3], field_starts[4]).trim()
        let comm  = line.substring(field_starts[4], n).trim()
        let mut row = TabRow {
            pid: to_int(pid_s),
            cpu: to_int(cpu_s),
            rss_kb: to_int(rss_s),
            etime_sec: parse_etime(et_s),
            comm: comm
        }
        out = out + [row]
        i = i + 1
    }
    return out
}

fn clip(v: int, hi: int) -> int {
    if v < 0 { return 0 }
    if v > hi { return hi }
    return v
}

// 6축 인코딩 — int list (0..255 예상, axis 5 만 0..100)
fn project_axes(row: TabRow, is_active: bool, gpu_share: int, net_kbps: int) -> list {
    let cpu_a = clip(row.cpu, CPU_AXIS_CLIP)
    let ram_a = clip(row.rss_kb / 1024, RAM_AXIS_CLIP)
    let net_a = clip(net_kbps, NET_AXIS_CLIP)
    // idle_sec: etime - cpu seconds 가 정확하나 cpu time 추출 비싸 — etime 자체로 surrogate
    let idle_a = clip(row.etime_sec / 60, 255)
    let act_a  = if is_active { 1 } else { 0 }
    let gpu_a  = clip(gpu_share, 100)
    return [cpu_a, ram_a, net_a, idle_a, act_a, gpu_a]
}

// ── ring rotate (own 8 site-13 패턴) ───────────────────────────────────
fn rotate_ring() -> int {
    let raw = read_file(RING)
    let lines = raw.split("\n")
    let mut all = []
    let mut i = 0
    while i < len(lines) {
        if lines[i] != "" { all = all + [lines[i]] }
        i = i + 1
    }
    if len(all) <= MAX_RING { return len(all) }
    let start = len(all) - MAX_RING
    let mut out = ""
    let mut j = start
    while j < len(all) {
        out = out + all[j] + "\n"
        j = j + 1
    }
    write_file(RING, out)
    return MAX_RING
}

fn axes_json(axes: list) -> str {
    let mut s = "["
    let mut i = 0
    while i < len(axes) {
        if i > 0 { s = s + "," }
        s = s + to_string(axes[i])
        i = i + 1
    }
    return s + "]"
}

fn comm_escape(s: str) -> str {
    return s.replace("\\", "\\\\").replace("\"", "\\\"")
}

// ── 메인 진입 (top-level main() 0 — caller 가 직접 호출) ───────────────
pub fn run_filter() -> int {
    let _ = exec("mkdir -p '" + forge_dir() + "'")
    let ts = ts_iso()
    let front = frontmost_app()
    let is_safari_front = front == "Safari"

    let tabs = collect_tabs()
    if len(tabs) == 0 {
        println("safari_bg_tab_throttle_genome: 0 WebContent tabs (ts=" + ts + ")")
        return 0
    }

    // active 탭 식별 — Safari frontmost + 최대 cpu PID 가 active 후보
    let mut max_cpu = -1
    let mut active_pid = 0
    let mut k = 0
    while k < len(tabs) {
        let r = tabs[k]
        if r.cpu > max_cpu { max_cpu = r.cpu; active_pid = r.pid }
        k = k + 1
    }

    // gpu / net 축은 비용 큼 — 기본 0. GPU_SAMPLE_MS > 0 일 때만 측정.
    let gpu_share_global = 0   // powermetrics dry — design only
    let net_kbps_default = 0

    let mut written = 0
    let mut buf = ""
    let mut j = 0
    while j < len(tabs) {
        let r = tabs[j]
        let is_active = is_safari_front && r.pid == active_pid
        let axes = project_axes(r, is_active, gpu_share_global, net_kbps_default)
        let line = "{\"ts\":\"" + ts + "\""
                 + ",\"pid\":" + to_string(r.pid)
                 + ",\"comm\":\"" + comm_escape(r.comm) + "\""
                 + ",\"rss_kb\":" + to_string(r.rss_kb)
                 + ",\"front\":\"" + comm_escape(front) + "\""
                 + ",\"axes\":" + axes_json(axes) + "}"
        buf = buf + line + "\n"
        written = written + 1
        j = j + 1
    }
    // 1회 append (own 5 site-3 batch pattern)
    append_file(RING, buf)
    let kept = rotate_ring()
    println("safari_bg_tab_throttle_genome: tabs=" + to_string(len(tabs))
          + " active_pid=" + to_string(active_pid)
          + " max_cpu=" + to_string(max_cpu)
          + " safari_front=" + (if is_safari_front { "true" } else { "false" })
          + " ring_kept=" + to_string(kept))
    return written
}

pub fn self_test() -> void {
    // 1. parse_etime 케이스
    if parse_etime("12:34") != 12 * 60 + 34 { panic("F45 self_test [etime mm:ss]") }
    if parse_etime("01:02:03") != 3723 { panic("F45 self_test [etime hh:mm:ss]") }
    if parse_etime("2-03:04:05") != 2 * 86400 + 3 * 3600 + 4 * 60 + 5 { panic("F45 self_test [etime dd-hh:mm:ss]") }
    // 2. clip
    if clip(150, 100) != 100 { panic("F45 self_test [clip hi]") }
    if clip(-3, 255) != 0 { panic("F45 self_test [clip lo]") }
    // 3. project_axes 형태 — 6원소
    let row = TabRow { pid: 1234, cpu: 42, rss_kb: 1024 * 50, etime_sec: 600, comm: "WebContent" }
    let axes = project_axes(row, true, 30, 100)
    if len(axes) != 6 { panic("F45 self_test [axes len]") }
    if axes[0] != 42 { panic("F45 self_test [axis 0 cpu]") }
    if axes[1] != 50 { panic("F45 self_test [axis 1 ram]") }
    if axes[4] != 1  { panic("F45 self_test [axis 4 active]") }
    println("  ✅ F45 safari_bg_tab_throttle_genome self_test PASS")
}

// auto-invoke entry — raw 245 호환 (top-level main() 호출 0, runtime auto-fires).
fn main() -> void {
    let a = args()
    if len(a) >= 3 && a[2] == "self-test" {
        self_test()
        return
    }
    let _ = run_filter()
}
