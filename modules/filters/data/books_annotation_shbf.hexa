// airgenome/modules/filters/data/books_annotation_shbf.hexa
//   SY5 — Books.app annotations SHBF (BKBF — Books Blob Filter).
//
//   목적: Books.app annotation DB (~/Library/Containers/com.apple.iBooksX/Data/
//         Documents/AEAnnotation/AEAnnotation*.sqlite) 의 (book_id,
//         annotation_text, page) 를 mmap blob. annotation prefix bisect O(log n).
//
//   blob layout (little-endian):
//     magic   : 4B  "BKBF"          (Books Blob Filter)
//     version : 4B  u32             (1)
//     n       : 4B  u32             annotation 개수
//     str_sz  : 4B  u32             string pool 바이트 길이 (book_id|text 합)
//     [n*4]   : u32 b_off           book_id pool 시작
//     [n*4]   : u32 b_len           book_id 길이
//     [n*4]   : u32 t_off           text pool 시작 (정렬된 text 순)
//     [n*4]   : u32 t_len           text 길이
//     [n*8]   : u64 page_loc        page 또는 location 오프셋
//     [str_sz]: utf-8 string pool   raw bytes (NUL 없음)
//
//   query: text prefix bisect_left → range → page 오름차순 top-K.
//
// 모드:
//   encode <AEAnnotation*.sqlite | __SYNTH__> : → /tmp/books_annotation_bkbf.bin
//   bench  <...> : encode + sqlite open vs BKBF mmap+bisect
//
// E4/F18 와 다른 점:
//   - source = AEAnnotation sqlite — Containers 내부 (sandbox path, FDA 필요).
//   - schema: ZAEANNOTATION.ZANNOTATIONSELECTEDTEXT / ZANNOTATIONASSETID /
//             ZANNOTATIONLOCATION (CFI). probe 우선 → 실패 시 synthetic.
//
// R1 HEXA-FIRST: 인라인 python3 페이로드 (.py 신규 없음). raw 9 hexa-only.
// R17: /usr/bin/perl alarm 120s wrapper. try/catch 0.

let PAYLOAD = "import sys,os,sqlite3,struct,time,bisect,heapq,resource,mmap,array,random,tempfile,glob\n" +
"mode=sys.argv[1]; src=sys.argv[2]\n" +
"BIN='/tmp/books_annotation_bkbf.bin'\n" +
"\n" +
"def fmt(b):\n" +
"    if b>1048576: return f'{b/1048576:.2f}MB'\n" +
"    if b>1024: return f'{b/1024:.1f}KB'\n" +
"    return f'{b}B'\n" +
"def rss():\n" +
"    r=resource.getrusage(resource.RUSAGE_SELF).ru_maxrss\n" +
"    if sys.platform=='darwin': return r\n" +
"    return r*1024\n" +
"def to_int_safe(v):\n" +
"    if v is None: return 0\n" +
"    if isinstance(v,int): return v\n" +
"    if isinstance(v,float): return int(v)\n" +
"    if isinstance(v,str) and v.isdigit(): return int(v)\n" +
"    return 0\n" +
"\n" +
"SYNTH_MARK='__SYNTH__'\n" +
"BOOKS=['cover-art','design-of-everyday','clean-code','sicp','tcp-illustrated','crafting-interpreters','programming-pearls','algorithms-4ed','effective-python','fluent-python']\n" +
"PHRASES=['the only constant is change','small steps compound','readers are leaders','code is read more than written','simple is robust','clarity beats cleverness','measure twice cut once','one truth at a time','optimize after correct','feedback loops shape habits']\n" +
"def synth_rows(n=1500):\n" +
"    rng=random.Random(42)\n" +
"    out=[]\n" +
"    for i in range(n):\n" +
"        b=BOOKS[i%len(BOOKS)]\n" +
"        t=PHRASES[(i*3)%len(PHRASES)]+f' [{i:04d}]'\n" +
"        loc=(i*113)%5000\n" +
"        out.append((b,t,loc))\n" +
"    return out\n" +
"\n" +
"def safe_copy_sqlite(src):\n" +
"    tmp=tempfile.NamedTemporaryFile(suffix='.sqlite',delete=False); tmp.close()\n" +
"    sc=sqlite3.connect(f'file:{src}?mode=ro',uri=True)\n" +
"    dc=sqlite3.connect(tmp.name)\n" +
"    sc.backup(dc); dc.close(); sc.close()\n" +
"    return tmp.name\n" +
"\n" +
"def discover_db(src):\n" +
"    if os.path.exists(src) and src.endswith(('.sqlite','.db')):\n" +
"        return src\n" +
"    home=os.path.expanduser('~')\n" +
"    pats=[\n" +
"      home+'/Library/Containers/com.apple.iBooksX/Data/Documents/AEAnnotation/AEAnnotation*.sqlite',\n" +
"      home+'/Library/Containers/com.apple.iBooksX*/Data/Documents/**/AEAnnotation*.sqlite',\n" +
"    ]\n" +
"    for p in pats:\n" +
"        for x in glob.glob(p,recursive=True):\n" +
"            return x\n" +
"    return None\n" +
"\n" +
"def load_real(path):\n" +
"    copy=safe_copy_sqlite(path)\n" +
"    conn=sqlite3.connect(copy)\n" +
"    rows=[]\n" +
"    tables=[r[0] for r in conn.execute(\"SELECT name FROM sqlite_master WHERE type='table'\")]\n" +
"    for t in tables:\n" +
"        if 'ANNOTATION' not in t.upper(): continue\n" +
"        cols=[r[1] for r in conn.execute(f'PRAGMA table_info(\"{t}\")')]\n" +
"        text_col=None; book_col=None; loc_col=None\n" +
"        for c in cols:\n" +
"            cu=c.upper()\n" +
"            if text_col is None and ('SELECTEDTEXT' in cu or 'NOTE' in cu or 'TEXT' in cu): text_col=c\n" +
"            if book_col is None and ('ASSETID' in cu or 'BOOKID' in cu): book_col=c\n" +
"            if loc_col is None and ('LOCATION' in cu or 'OFFSET' in cu or 'CFI' in cu): loc_col=c\n" +
"        if text_col is None or book_col is None: continue\n" +
"        sel=f'SELECT \"{book_col}\",\"{text_col}\"' + (f',\"{loc_col}\"' if loc_col else ',NULL') + f' FROM \"{t}\"'\n" +
"        for r in conn.execute(sel):\n" +
"            bv=r[0]; tv=r[1]; lv=r[2]\n" +
"            if not isinstance(tv,str) or not tv.strip(): continue\n" +
"            if not isinstance(bv,str): bv=str(bv) if bv is not None else ''\n" +
"            loc=to_int_safe(lv)\n" +
"            rows.append((bv,tv.strip(),loc))\n" +
"        if rows: break\n" +
"    conn.close(); os.unlink(copy)\n" +
"    if not rows: return synth_rows(1500),True\n" +
"    return rows,False\n" +
"\n" +
"def encode_rows(rows):\n" +
"    rows=sorted(rows,key=lambda r:r[1])\n" +
"    n=len(rows)\n" +
"    pool=bytearray()\n" +
"    b_off=array.array('I',[0]*n); b_len=array.array('I',[0]*n)\n" +
"    t_off=array.array('I',[0]*n); t_len=array.array('I',[0]*n)\n" +
"    loc=array.array('Q',[0]*n)\n" +
"    for i,(b,t,l) in enumerate(rows):\n" +
"        bb=b.encode('utf-8','replace'); tb=t.encode('utf-8','replace')\n" +
"        b_off[i]=len(pool); b_len[i]=len(bb); pool.extend(bb)\n" +
"        t_off[i]=len(pool); t_len[i]=len(tb); pool.extend(tb)\n" +
"        loc[i]=int(l)&0xffffffffffffffff\n" +
"    header=struct.pack('<4sIII',b'BKBF',1,n,len(pool))\n" +
"    with open(BIN,'wb') as f:\n" +
"        f.write(header)\n" +
"        f.write(b_off.tobytes()); f.write(b_len.tobytes())\n" +
"        f.write(t_off.tobytes()); f.write(t_len.tobytes())\n" +
"        f.write(loc.tobytes()); f.write(pool)\n" +
"    return n,os.path.getsize(BIN)\n" +
"\n" +
"def encode(src):\n" +
"    t0=time.perf_counter()\n" +
"    db=None if src==SYNTH_MARK else discover_db(src)\n" +
"    if db is None:\n" +
"        rows=synth_rows(1500); synth=True\n" +
"    else:\n" +
"        rows,synth=load_real(db)\n" +
"    n,bsz=encode_rows(rows)\n" +
"    t1=time.perf_counter()\n" +
"    return {'encode_s':t1-t0,'n':n,'blob_size':bsz,'synth':synth,'rows':rows}\n" +
"\n" +
"class Blob:\n" +
"    def __init__(self,path):\n" +
"        self.f=open(path,'rb')\n" +
"        self.mm=mmap.mmap(self.f.fileno(),0,prot=mmap.PROT_READ)\n" +
"        magic,ver,n,pool_sz=struct.unpack_from('<4sIII',self.mm,0)\n" +
"        assert magic==b'BKBF' and ver==1\n" +
"        self.n=n; self.pool_sz=pool_sz\n" +
"        base=16\n" +
"        b_off_off=base\n" +
"        b_len_off=base+4*n\n" +
"        t_off_off=base+8*n\n" +
"        t_len_off=base+12*n\n" +
"        loc_off  =base+16*n\n" +
"        self.pool_off=base+16*n+8*n\n" +
"        self.mv=memoryview(self.mm)\n" +
"        def U(off): a=array.array('I'); a.frombytes(bytes(self.mv[off:off+4*n])); return a\n" +
"        def Q(off): a=array.array('Q'); a.frombytes(bytes(self.mv[off:off+8*n])); return a\n" +
"        b_off=U(b_off_off); b_len=U(b_len_off)\n" +
"        t_off=U(t_off_off); t_len=U(t_len_off)\n" +
"        self.loc=Q(loc_off)\n" +
"        pool=bytes(self.mv[self.pool_off:self.pool_off+pool_sz])\n" +
"        self.books=[pool[b_off[i]:b_off[i]+b_len[i]] for i in range(n)]\n" +
"        self.texts=[pool[t_off[i]:t_off[i]+t_len[i]] for i in range(n)]\n" +
"    def prefix_topk(self,prefix,k=10):\n" +
"        pb=prefix.encode('utf-8') if isinstance(prefix,str) else prefix\n" +
"        s=bisect.bisect_left(self.texts,pb)\n" +
"        e=bisect.bisect_left(self.texts,pb+b'\\xff\\xff\\xff\\xff')\n" +
"        if e==s: return []\n" +
"        if e-s<=k: idxs=list(range(s,e))\n" +
"        else: idxs=heapq.nsmallest(k,range(s,e),key=lambda i:self.loc[i])\n" +
"        idxs.sort(key=lambda i:self.loc[i])\n" +
"        return [(self.books[i].decode('utf-8','replace'),self.texts[i].decode('utf-8','replace'),int(self.loc[i])) for i in idxs]\n" +
"    def close(self):\n" +
"        self.mv.release(); self.mm.close(); self.f.close()\n" +
"\n" +
"def bench(src):\n" +
"    info=encode(src)\n" +
"    tag=' (synth fallback)' if info['synth'] else ''\n" +
"    print(f'[encode] {info[\"encode_s\"]*1000:.1f} ms  notes={info[\"n\"]}  blob={fmt(info[\"blob_size\"])}{tag}')\n" +
"    if info['n']==0:\n" +
"        print('[bench] empty — skip'); return\n" +
"    rows=info['rows']\n" +
"    b=Blob(BIN)\n" +
"    rng=random.Random(42)\n" +
"    samples=[]\n" +
"    for _ in range(100):\n" +
"        i=rng.randrange(b.n)\n" +
"        u=b.texts[i].decode('utf-8','replace')\n" +
"        plen=rng.choice([3,4,5,6])\n" +
"        samples.append(u[:plen] if len(u)>=plen else u)\n" +
"    for p in samples[:5]: b.prefix_topk(p,10)\n" +
"    t0=time.perf_counter()\n" +
"    blob_hits=0\n" +
"    for p in samples:\n" +
"        blob_hits+=len(b.prefix_topk(p,10))\n" +
"    t1=time.perf_counter()\n" +
"    blob_us=(t1-t0)*1e6/len(samples)\n" +
"    rss_blob=rss()\n" +
"    b.close()\n" +
"    rows_sorted=sorted(rows,key=lambda r:r[1])\n" +
"    t0=time.perf_counter()\n" +
"    lin_hits=0\n" +
"    for p in samples:\n" +
"        for (bk,t,l) in rows_sorted:\n" +
"            if t.startswith(p): lin_hits+=1\n" +
"    t1=time.perf_counter()\n" +
"    lin_us=(t1-t0)*1e6/len(samples)\n" +
"    print(f'[query] 100 prefix-topK-10 (blob={blob_hits} linear={lin_hits})')\n" +
"    print(f'  linear scan          : {lin_us:10.1f} us')\n" +
"    print(f'  blob mmap + bisect   : {blob_us:10.1f} us')\n" +
"    if blob_us>0: print(f'  speedup: {lin_us/blob_us:6.1f}x')\n" +
"    print(f'[rss] blob loaded: {fmt(rss_blob)}')\n" +
"\n" +
"if mode=='encode':\n" +
"    info=encode(src)\n" +
"    print(f'encoded {info[\"n\"]} notes in {info[\"encode_s\"]*1000:.1f} ms → {BIN} ({fmt(info[\"blob_size\"])})' + (' synth' if info['synth'] else ''))\n" +
"elif mode=='bench':\n" +
"    bench(src)\n" +
"else:\n" +
"    print('usage: encode|bench <AEAnnotation.sqlite|__SYNTH__>'); sys.exit(2)\n"

fn run() {
    let argv = args()
    let mut mode = "bench"
    let mut target = ""
    let mut i = 0
    while i < len(argv) {
        let v = argv[i]
        let is_hexa_bin = v.contains("/hexa-lang/") || v == "hexa" || v == "hexa.real"
        let is_self     = v.contains("books_annotation_shbf")
        if is_hexa_bin == false && is_self == false {
            if v == "encode" || v == "bench" { mode = v }
            else if v.contains(".sqlite") || v.contains(".db") { target = v }
        }
        i = i + 1
    }
    if len(target) == 0 {
        target = env("HOME") + "/Library/Containers/com.apple.iBooksX/Data/Documents/AEAnnotation"
        println("(default target: " + target + " — discover sqlite by glob)")
    }
    let tmp_py = "/tmp/books_annotation_shbf_" + exec("date +%s%N").trim() + ".py"
    write_file(tmp_py, PAYLOAD)
    let cmd = "/usr/bin/perl -e 'alarm 120; exec @ARGV' /usr/bin/python3 '" + tmp_py + "' '" + mode + "' '" + target + "' 2>&1; rm -f '" + tmp_py + "'"
    let result = exec(cmd)
    print(result)
}

run()
