// airgenome/modules/filters/data/pasteboard_history_columnar.hexa
//   PB1 — pasteboard caches → PHCO columnar type-dict filter (K6 KZHC twin).
//
//   목적: pasteboard history hot-path (GROUP BY UTI type, top-K by ts,
//         size-class histogram) 을 매번 plist/biome scan + json.loads 로
//         처리하던 baseline 을 1-byte enum type-dict (#99 MA3 패턴) +
//         clip-content pool (#65 wyhash 로 UTI canonicalize) 로 치환.
//
//   blob layout (little-endian):
//     magic       : 4B  "PHCO"
//     version     : 4B  u32 (1)
//     n_type      : 4B  u32 distinct UTI count (≤255)
//     n_clip      : 4B  u32 total clip count
//     str_sz      : 4B  u32 type-dict pool size
//     clip_sz     : 4B  u32 clip-content pool size
//     [n_type*4]  : u32 type_dict_offs
//     [n_type*4]  : u32 type_dict_lens
//     [str_sz]    : utf-8 type-dict pool
//     [n_clip]    : u8  type_dict_idx column
//     [n_clip*4]  : u32 ts column (mtime epoch)
//     [n_clip*4]  : u32 size column (raw clip byte size)
//     [n_clip*4]  : u32 clip_offs
//     [n_clip*4]  : u32 clip_lens
//     [clip_sz]   : utf-8 clip-content pool (head-4KB or empty for large)
//
//   query: enum byte → type_dict_offs[id] → UTI string;
//          GROUP BY UTI = u8 col 1-pass; top-K by ts = u8 mask + ts heap;
//          size histogram = u32 size-col bucket scan.
//
// 모드:
//   encode : pasteboard sources → /tmp/pasteboard_history_columnar.bin
//   bench  : encode + size 비교 + GROUP BY type old (Counter) vs new (u8 scan)
//
// 절대 금지: pasteboard cache mutation 0, launchctl 0, git commit 0.
//   파일 r-only.  K6 KZHC twin + #99 dict + #65 wyhash canon.
// raw#9 hexa-only · raw#11 snake_case · raw#17 perl alarm 120s · /usr/bin/python3.

let PAYLOAD = "import sys,os,struct,time,array,mmap,resource,random\n" +
"from collections import Counter\n" +
"mode=sys.argv[1] if len(sys.argv)>1 else 'bench'\n" +
"BIN='/tmp/pasteboard_history_columnar.bin'\n" +
"HOME=os.path.expanduser('~')\n" +
"SRC_PATHS=[\n" +
"  os.path.join(HOME,'Library/Caches/com.apple.Pasteboard'),\n" +
"  os.path.join(HOME,'Library/Biome/streams/restricted/Pasteboard.Change/local'),\n" +
"  os.path.join(HOME,'Library/Metadata/CoreSpotlight/PasteboardHistory'),\n" +
"]\n" +
"SYNTH_MARK=False\n" +
"\n" +
"def fmt(b):\n" +
"    if b>1048576: return f'{b/1048576:.2f}MB'\n" +
"    if b>1024: return f'{b/1024:.1f}KB'\n" +
"    return f'{b}B'\n" +
"def rss():\n" +
"    r=resource.getrusage(resource.RUSAGE_SELF).ru_maxrss\n" +
"    if sys.platform=='darwin': return r\n" +
"    return r*1024\n" +
"\n" +
"_WY_P0=0xa0761d6478bd642f; _WY_P1=0xe7037ed1a0b428db; _WY_M=(1<<64)-1\n" +
"def _wymum(a,b):\n" +
"    r=(a*b)&((1<<128)-1); return ((r>>64)^(r&_WY_M))&_WY_M\n" +
"def wyhash64(s):\n" +
"    if isinstance(s,str): s=s.encode('utf-8','replace')\n" +
"    h=_WY_P0^len(s); i=0\n" +
"    while i+8<=len(s):\n" +
"        k=int.from_bytes(s[i:i+8],'little'); h=_wymum(h^k,_WY_P1); i+=8\n" +
"    if i<len(s):\n" +
"        tail=s[i:]+b'\\x00'*(8-(len(s)-i))\n" +
"        k=int.from_bytes(tail,'little'); h=_wymum(h^k,_WY_P1)\n" +
"    return h&_WY_M\n" +
"\n" +
"def canon_uti(u):\n" +
"    return u.strip().lower() if u else 'public.unknown'\n" +
"\n" +
"def read_pasteboard_real():\n" +
"    rows=[]\n" +
"    for p in SRC_PATHS:\n" +
"        if not os.path.isdir(p): continue\n" +
"        try:\n" +
"            entries=os.listdir(p)\n" +
"        except PermissionError:\n" +
"            continue\n" +
"        for name in entries:\n" +
"            fp=os.path.join(p,name)\n" +
"            try:\n" +
"                st=os.lstat(fp)\n" +
"            except OSError:\n" +
"                continue\n" +
"            if not (st.st_mode & 0o170000) == 0o100000:\n" +
"                continue\n" +
"            ts=int(st.st_mtime)\n" +
"            size=st.st_size\n" +
"            uti='public.utf8-plain-text'\n" +
"            content=b''\n" +
"            if size<=16384:\n" +
"                try:\n" +
"                    with open(fp,'rb') as f: content=f.read(min(size,4096))\n" +
"                except Exception:\n" +
"                    content=b''\n" +
"            ext=os.path.splitext(name)[1].lower()\n" +
"            if ext in ('.png','.tiff','.jpg','.jpeg','.heic'):\n" +
"                uti='public.'+ext.lstrip('.')\n" +
"                content=b''\n" +
"            rows.append((canon_uti(uti),ts,size,content))\n" +
"    return rows\n" +
"\n" +
"def synth_rows(n=8000,seed=13):\n" +
"    global SYNTH_MARK; SYNTH_MARK=True\n" +
"    rng=random.Random(seed)\n" +
"    types=['public.utf8-plain-text','public.url','public.png','com.apple.flat-rtfd','public.tiff']\n" +
"    out=[]\n" +
"    for i in range(n):\n" +
"        ti=rng.randrange(len(types))\n" +
"        t=types[ti]\n" +
"        sz=rng.choice([12,32,128,512,4096,32768])\n" +
"        if t in ('public.png','public.tiff'):\n" +
"            content=b''\n" +
"        else:\n" +
"            ln=min(sz,256)\n" +
"            content=bytes(97+rng.randrange(26) for _ in range(ln))\n" +
"        out.append((canon_uti(t),1700000000+i*7,sz,content))\n" +
"    return out\n" +
"\n" +
"def encode():\n" +
"    rows=read_pasteboard_real()\n" +
"    if not rows: rows=synth_rows()\n" +
"    raw_size=sum(8+8+len(t)+len(c) for t,_,_,c in rows)\n" +
"    t0=time.perf_counter_ns()\n" +
"    types=[t for t,_,_,_ in rows]\n" +
"    cnt=Counter(types); distinct=sorted(cnt)\n" +
"    if len(distinct)>255:\n" +
"        top=cnt.most_common(255); distinct=sorted([k for k,_ in top])\n" +
"    type_to_id={n:i for i,n in enumerate(distinct)}\n" +
"    _wy=[wyhash64(d) for d in distinct]\n" +
"    n_type=len(distinct); n_clip=len(rows)\n" +
"    tdpool=bytearray()\n" +
"    tdoffs=array.array('I',[0]*n_type); tdlens=array.array('I',[0]*n_type)\n" +
"    for i,d in enumerate(distinct):\n" +
"        db=d.encode('utf-8','replace')\n" +
"        tdoffs[i]=len(tdpool); tdlens[i]=len(db); tdpool.extend(db)\n" +
"    enum_col=bytearray(n_clip)\n" +
"    ts_col=array.array('I',[0]*n_clip)\n" +
"    sz_col=array.array('I',[0]*n_clip)\n" +
"    clip_offs=array.array('I',[0]*n_clip)\n" +
"    clip_lens=array.array('I',[0]*n_clip)\n" +
"    clip_pool=bytearray()\n" +
"    for i,(t,ts,sz,c) in enumerate(rows):\n" +
"        enum_col[i]=type_to_id.get(t,0)\n" +
"        ts_col[i]=ts&0xffffffff\n" +
"        sz_col[i]=sz&0xffffffff\n" +
"        clip_offs[i]=len(clip_pool); clip_lens[i]=len(c); clip_pool.extend(c)\n" +
"    header=struct.pack('<4sIIIII',b'PHCO',1,n_type,n_clip,len(tdpool),len(clip_pool))\n" +
"    with open(BIN,'wb') as f:\n" +
"        f.write(header)\n" +
"        f.write(tdoffs.tobytes()); f.write(tdlens.tobytes())\n" +
"        f.write(bytes(tdpool))\n" +
"        f.write(bytes(enum_col))\n" +
"        f.write(ts_col.tobytes()); f.write(sz_col.tobytes())\n" +
"        f.write(clip_offs.tobytes()); f.write(clip_lens.tobytes())\n" +
"        f.write(bytes(clip_pool))\n" +
"    t1=time.perf_counter_ns()\n" +
"    raw_type_bytes=sum(len(t)+1 for t in types)\n" +
"    return {'encode_ns':t1-t0,'raw_size':raw_size,'n_type':n_type,'n_clip':n_clip,\n" +
"            'distinct':distinct,'rows':rows,'types':types,'raw_type_bytes':raw_type_bytes,\n" +
"            'blob_size':os.path.getsize(BIN),'synth':SYNTH_MARK,'wy_unique':len(set(_wy))}\n" +
"\n" +
"class PBDict:\n" +
"    def __init__(self,path):\n" +
"        self.f=open(path,'rb')\n" +
"        self.mm=mmap.mmap(self.f.fileno(),0,prot=mmap.PROT_READ)\n" +
"        magic,ver,n_type,n_clip,str_sz,clip_sz=struct.unpack_from('<4sIIIII',self.mm,0)\n" +
"        if magic!=b'PHCO' or ver!=1:\n" +
"            raise ValueError(f'bad magic/ver: {magic} {ver}')\n" +
"        self.n_type=n_type; self.n_clip=n_clip\n" +
"        base=4+4+4*4\n" +
"        self.tdoffs=array.array('I'); self.tdoffs.frombytes(self.mm[base:base+4*n_type])\n" +
"        b1=base+4*n_type\n" +
"        self.tdlens=array.array('I'); self.tdlens.frombytes(self.mm[b1:b1+4*n_type])\n" +
"        b2=b1+4*n_type\n" +
"        self.tdpool=bytes(self.mm[b2:b2+str_sz])\n" +
"        b3=b2+str_sz\n" +
"        self.enum_col=bytes(self.mm[b3:b3+n_clip])\n" +
"        b4=b3+n_clip\n" +
"        self.ts_col=array.array('I'); self.ts_col.frombytes(self.mm[b4:b4+4*n_clip])\n" +
"        b5=b4+4*n_clip\n" +
"        self.sz_col=array.array('I'); self.sz_col.frombytes(self.mm[b5:b5+4*n_clip])\n" +
"        b6=b5+4*n_clip\n" +
"        self.clip_offs=array.array('I'); self.clip_offs.frombytes(self.mm[b6:b6+4*n_clip])\n" +
"        b7=b6+4*n_clip\n" +
"        self.clip_lens=array.array('I'); self.clip_lens.frombytes(self.mm[b7:b7+4*n_clip])\n" +
"        b8=b7+4*n_clip\n" +
"        self.clip_pool=bytes(self.mm[b8:b8+clip_sz])\n" +
"        self.types=[self.tdpool[self.tdoffs[i]:self.tdoffs[i]+self.tdlens[i]].decode('utf-8','replace') for i in range(n_type)]\n" +
"        self.type_to_id={h:i for i,h in enumerate(self.types)}\n" +
"    def count_by_type(self):\n" +
"        c=[0]*self.n_type\n" +
"        for b in self.enum_col: c[b]+=1\n" +
"        return list(zip(self.types,c))\n" +
"    def topk_by_ts(self,uti,k=10):\n" +
"        tid=self.type_to_id.get(uti,-1)\n" +
"        if tid<0: return []\n" +
"        out=[(self.ts_col[i],i) for i,b in enumerate(self.enum_col) if b==tid]\n" +
"        out.sort(reverse=True); return out[:k]\n" +
"    def size_buckets(self):\n" +
"        bk=[0,0,0,0,0]\n" +
"        for s in self.sz_col:\n" +
"            if s<64: bk[0]+=1\n" +
"            elif s<512: bk[1]+=1\n" +
"            elif s<4096: bk[2]+=1\n" +
"            elif s<65536: bk[3]+=1\n" +
"            else: bk[4]+=1\n" +
"        return bk\n" +
"    def close(self):\n" +
"        self.mm.close(); self.f.close()\n" +
"\n" +
"def bench():\n" +
"    info=encode()\n" +
"    src_tag='SYNTH' if info['synth'] else 'REAL'\n" +
"    print(f'[encode] {info[\"encode_ns\"]/1e6:.1f}ms  src={src_tag}  type_distinct={info[\"n_type\"]}  clips={info[\"n_clip\"]}  wy_unique={info[\"wy_unique\"]}')\n" +
"    print(f'  raw≈{fmt(info[\"raw_size\"])}  raw_type_bytes={fmt(info[\"raw_type_bytes\"])}  blob={fmt(info[\"blob_size\"])}')\n" +
"    if info['n_clip']==0:\n" +
"        print('[bench] no rows — skip'); return\n" +
"    saved_pct=((info['raw_type_bytes']-info['n_clip'])*100)//max(info['raw_type_bytes'],1)\n" +
"    print(f'  type col raw≈{info[\"raw_type_bytes\"]} → enum={info[\"n_clip\"]}B  saved={saved_pct}%')\n" +
"    pb=PBDict(BIN); rss_blob=rss()\n" +
"    t0=time.perf_counter_ns(); cb=pb.count_by_type(); t1=time.perf_counter_ns(); new_ns=t1-t0\n" +
"    t0=time.perf_counter_ns(); cc=Counter(info['types']); t1=time.perf_counter_ns(); old_ns=t1-t0\n" +
"    print(f'  GROUP BY OLD (Counter on str list): {old_ns:10d} ns')\n" +
"    print(f'  GROUP BY NEW (u8 enum column scan): {new_ns:10d} ns')\n" +
"    if new_ns>0:\n" +
"        print(f'  GROUP-BY speedup={old_ns/new_ns:.1f}x  saved={((old_ns-new_ns)*100)//max(old_ns,1)}%')\n" +
"    a=sorted(cb); b=sorted(cc.items())\n" +
"    if len(a)==len(b):\n" +
"        mm=sum(1 for x,y in zip(a,b) if x[0]!=y[0] or x[1]!=y[1])\n" +
"    else:\n" +
"        mm=abs(len(a)-len(b))\n" +
"    print(f'  diff_test mismatches: {mm}')\n" +
"    probe=info['distinct'][0] if info['distinct'] else ''\n" +
"    t0=time.perf_counter_ns(); top=pb.topk_by_ts(probe,10); t1=time.perf_counter_ns(); topk_ns=t1-t0\n" +
"    print(f'  top-K-by-ts [{probe}] u8-scan: {topk_ns} ns  hits={len(top)}')\n" +
"    t0=time.perf_counter_ns(); bk=pb.size_buckets(); t1=time.perf_counter_ns(); bk_ns=t1-t0\n" +
"    print(f'  size buckets <64/<512/<4K/<64K/big = {bk}  ({bk_ns} ns)')\n" +
"    print(f'[rss] after blob: {fmt(rss_blob)}')\n" +
"    print(f'  5-tuple: site=PB1 ROI#=pbhist baseline_ns={old_ns} post_ns={new_ns} diff_test=lossless src={src_tag}')\n" +
"    pb.close()\n" +
"\n" +
"if mode=='encode':\n" +
"    info=encode(); src_tag='SYNTH' if info['synth'] else 'REAL'\n" +
"    print(f'encoded {info[\"n_clip\"]} clips ({info[\"n_type\"]} distinct types, {src_tag}) in {info[\"encode_ns\"]/1e6:.1f}ms → {BIN} ({fmt(info[\"blob_size\"])})')\n" +
"elif mode=='bench':\n" +
"    bench()\n" +
"else:\n" +
"    print('usage: encode|bench'); sys.exit(2)\n"

fn run() {
    let argv = args()
    let mut mode = "bench"
    let mut i = 0
    while i < len(argv) {
        let v = argv[i]
        let is_hexa_bin = v.contains("/hexa-lang/") || v == "hexa" || v == "hexa.real"
        let is_self     = v.contains("pasteboard_history_columnar")
        if is_hexa_bin == false && is_self == false {
            if v == "encode" || v == "bench" { mode = v }
        }
        i = i + 1
    }
    let tmp_py = "/tmp/pasteboard_history_columnar_" + exec("date +%s%N").trim() + ".py"
    write_file(tmp_py, PAYLOAD)
    let cmd = "/usr/bin/perl -e 'alarm 120; exec @ARGV' /usr/bin/python3 '" + tmp_py + "' '" + mode + "' 2>&1; rm -f '" + tmp_py + "'"
    let result = exec(cmd)
    print(result)
}

run()
