// modules/filters/data/claude_session_statusline_metric.hexa
// C12 — Claude session 6축 게놈 (statusline metric).
//
// 역할:
//   F45 (Safari WebContent 6축 ring) 패턴을 Claude session 으로 이식.
//   현재 cwd 별 Claude session 의 활동 시계열을 6축으로 투영해
//   per-session statusline (ms_count / tool / token / file / err / wall) 표시.
//
// 6축 매핑 (60-byte 게놈 — own 5 ring 패턴 동일):
//   axis 0 = msg_count       (jsonl 줄 수, clip 0..255)
//   axis 1 = tool_count      (.message.content[].type=="tool_use" 합)
//   axis 2 = token_kused     (input+cache_creation+output, /1000 clip 0..255)
//   axis 3 = file_touched    (Edit/Write/Read 호출 unique file count, clip)
//   axis 4 = error_count     (.toolUseResult.is_error true 또는 stderr 패턴)
//   axis 5 = wall_min        (last_ts - first_ts, /60 clip 0..255)
//
// 출력 ring: forge/claude_sessions.ring (JSONL append-only)
//   {"ts":"...","sess":"<uuid>","cwd":"...","axes":[m,t,k,f,e,w]}
//
// 제약:
//   - own 5 site-3 batch pattern (single append_file)
//   - own 6 site-6 / own 7 site-9: jq fork 회피 (인덱싱 jsonl 1패스 awk)
//   - try/catch 0, top-level main() 0 (caller dispatch)
//   - 측정-only: ps/pkill 호출 0
//
// 5-tuple bench: tool/bench/bench_c12_session_metric.hexa

use "../../../core/core"

// A6 RFC interim — to_int_safe local helper
fn is_numeric_str(s: str) -> bool {
    let n = len(s)
    if n == 0 { return false }
    let mut i = 0
    if s.substring(0, 1) == "-" { i = 1 }
    if i >= n { return false }
    while i < n {
        let c = s.substring(i, i + 1)
        if c < "0" { return false }
        if c > "9" { return false }
        i = i + 1
    }
    return true
}
fn to_int_safe(s: str) -> int {
    let trimmed = s.trim()
    if trimmed == "" { return 0 }
    let parts = trimmed.split(".")
    if len(parts) == 0 { return 0 }
    let head = parts[0]
    if head == "" { return 0 }
    if !is_numeric_str(head) { return 0 }
    return to_int(head)
}

let RING = ring_path("claude_sessions.ring")
let MAX_RING = 240
let CLIP_255 = 255

fn ts_iso() -> str {
    return exec("date -u +%Y-%m-%dT%H:%M:%SZ").trim()
}

fn clip(v: int, hi: int) -> int {
    if v < 0 { return 0 }
    if v > hi { return hi }
    return v
}

// ── ~/.claude*/projects/<dir>/*.jsonl 발견 ─────────────────────────────
fn discover_session_files() -> list {
    // 1 fork: bash glob enum + last-modified 정렬 (newest first).
    // 합성 fallback 은 caller 의 책임 (없으면 빈 list).
    let cmd = "ls -1t ~/.claude*/projects/*/*.jsonl 2>/dev/null | head -64"
    let raw = exec(cmd)
    let lines = raw.split("\n")
    let mut out = []
    let mut i = 0
    while i < len(lines) {
        let p = lines[i].trim()
        if p != "" { out = out + [p] }
        i = i + 1
    }
    return out
}

// 한 jsonl 파일을 1 fork (awk) 로 6축 axes 추출.
// awk 는 jq 보다 5x 빠르고 fork 1회로 모든 metric 산정 가능.
struct SessAxes {
    msg_count: int,
    tool_count: int,
    token_kused: int,
    file_touched: int,
    error_count: int,
    wall_min: int,
    cwd: str,
    sess: str
}

fn parse_session_file(path: str) -> SessAxes {
    // awk 1 fork: count msg + tool_use + tokens + Edit/Read/Write target file + error + ts range.
    // sess uuid: filename stem; cwd 는 첫 줄 .cwd 추출 (jq 1 fork — drop 가능 시 awk 로 단순 grep).
    let stem_cmd = "basename '" + path + "' .jsonl"
    let sess = exec(stem_cmd).trim()
    // cwd 첫 줄 기준 — awk 안에서 합쳐 1 fork 로 처리.
    let awk_prog = "BEGIN{ msg=0; tools=0; tok=0; err=0; min_ts=\"\"; max_ts=\"\"; cwd=\"\" } " +
        "{ msg++; " +
        "  n=split($0,_,\"\\\"type\\\":\\\"tool_use\\\"\"); if (n>1) tools+=(n-1); " +
        "  n=split($0,_,\"\\\"input_tokens\\\":\"); if (n>1) { for(k=2;k<=n;k++){ s=_[k]; m=0; v=0; while(m<length(s)){ ch=substr(s,m+1,1); if (ch>=\"0\" && ch<=\"9\") { v=v*10+(ch+0); m++ } else break } tok+=v } } " +
        "  n=split($0,_,\"\\\"output_tokens\\\":\"); if (n>1) { for(k=2;k<=n;k++){ s=_[k]; m=0; v=0; while(m<length(s)){ ch=substr(s,m+1,1); if (ch>=\"0\" && ch<=\"9\") { v=v*10+(ch+0); m++ } else break } tok+=v } } " +
        "  n=split($0,_,\"\\\"cache_creation_input_tokens\\\":\"); if (n>1) { for(k=2;k<=n;k++){ s=_[k]; m=0; v=0; while(m<length(s)){ ch=substr(s,m+1,1); if (ch>=\"0\" && ch<=\"9\") { v=v*10+(ch+0); m++ } else break } tok+=v } } " +
        "  if (index($0,\"\\\"is_error\\\":true\")) err++; " +
        "  if (cwd==\"\") { p=index($0,\"\\\"cwd\\\":\\\"\"); if (p>0) { rest=substr($0,p+8); q=index(rest,\"\\\"\"); if (q>0) cwd=substr(rest,1,q-1) } } " +
        "  p=index($0,\"\\\"timestamp\\\":\\\"\"); if (p>0) { rest=substr($0,p+14); q=index(rest,\"\\\"\"); if (q>0) { t=substr(rest,1,q-1); if (min_ts==\"\" || t<min_ts) min_ts=t; if (t>max_ts) max_ts=t } } " +
        "} " +
        "END{ printf \"%d|%d|%d|%d|%s|%s|%s\", msg, tools, tok, err, min_ts, max_ts, cwd }"
    // single-quote escape for awk prog.
    let cmd = "awk '" + awk_prog.replace("'", "'\\''") + "' '" + path + "' 2>/dev/null"
    let raw = exec(cmd).trim()
    let parts = raw.split("|")
    let mut msg = 0
    let mut tools = 0
    let mut tok = 0
    let mut err = 0
    let mut min_ts = ""
    let mut max_ts = ""
    let mut cwd = ""
    if len(parts) >= 1 { msg = to_int_safe(parts[0]) }
    if len(parts) >= 2 { tools = to_int_safe(parts[1]) }
    if len(parts) >= 3 { tok = to_int_safe(parts[2]) }
    if len(parts) >= 4 { err = to_int_safe(parts[3]) }
    if len(parts) >= 5 { min_ts = parts[4] }
    if len(parts) >= 6 { max_ts = parts[5] }
    if len(parts) >= 7 { cwd = parts[6] }

    // wall_min: epoch diff (gdate). min_ts/max_ts ISO-8601.
    let mut wall = 0
    if min_ts != "" && max_ts != "" && min_ts != max_ts {
        let cmd2 = "echo $(( $(gdate -u -d '" + max_ts + "' +%s 2>/dev/null) - $(gdate -u -d '" + min_ts + "' +%s 2>/dev/null) ))"
        let dsec = to_int_safe(exec(cmd2).trim())
        wall = dsec / 60
    }

    // file_touched: Edit/Write/Read 의 file_path argument 의 unique count.
    // 별도 awk 1 fork (sort -u | wc -l) — jq 회피.
    let cmd3 = "awk '/\"name\":\"(Edit|Write|Read)\"/{ p=index($0,\"\\\"file_path\\\":\\\"\"); if (p>0) { rest=substr($0,p+14); q=index(rest,\"\\\"\"); if (q>0) print substr(rest,1,q-1) } }' '" + path + "' 2>/dev/null | sort -u | wc -l"
    let f_touched = to_int_safe(exec(cmd3).trim())

    return SessAxes {
        msg_count: msg,
        tool_count: tools,
        token_kused: tok / 1000,
        file_touched: f_touched,
        error_count: err,
        wall_min: wall,
        cwd: cwd,
        sess: sess
    }
}

fn project_axes(s: SessAxes) -> list {
    return [
        clip(s.msg_count, CLIP_255),
        clip(s.tool_count, CLIP_255),
        clip(s.token_kused, CLIP_255),
        clip(s.file_touched, CLIP_255),
        clip(s.error_count, CLIP_255),
        clip(s.wall_min, CLIP_255)
    ]
}

fn axes_json(axes: list) -> str {
    let mut s = "["
    let mut i = 0
    while i < len(axes) {
        if i > 0 { s = s + "," }
        s = s + to_string(axes[i])
        i = i + 1
    }
    return s + "]"
}

fn esc_str(s: str) -> str {
    return s.replace("\\", "\\\\").replace("\"", "\\\"")
}

// ring rotate (own 8 site-13 패턴)
fn rotate_ring() -> int {
    let raw = read_file(RING)
    let lines = raw.split("\n")
    let mut all = []
    let mut i = 0
    while i < len(lines) {
        if lines[i] != "" { all = all + [lines[i]] }
        i = i + 1
    }
    if len(all) <= MAX_RING { return len(all) }
    let start = len(all) - MAX_RING
    let mut out = ""
    let mut j = start
    while j < len(all) {
        out = out + all[j] + "\n"
        j = j + 1
    }
    write_file(RING, out)
    return MAX_RING
}

pub fn run_filter() -> int {
    let _ = exec("mkdir -p '" + forge_dir() + "'")
    let ts = ts_iso()
    let files = discover_session_files()
    if len(files) == 0 {
        println("claude_session_statusline_metric: 0 session jsonl found (ts=" + ts + ")")
        return 0
    }
    let mut buf = ""
    let mut written = 0
    let mut total_msg = 0
    let mut total_tool = 0
    let mut total_tok_k = 0
    let mut i = 0
    while i < len(files) {
        let p = files[i]
        let s = parse_session_file(p)
        if s.msg_count == 0 { i = i + 1; continue }
        let axes = project_axes(s)
        let line = "{\"ts\":\"" + ts + "\""
                 + ",\"sess\":\"" + esc_str(s.sess) + "\""
                 + ",\"cwd\":\"" + esc_str(s.cwd) + "\""
                 + ",\"axes\":" + axes_json(axes) + "}"
        buf = buf + line + "\n"
        total_msg = total_msg + s.msg_count
        total_tool = total_tool + s.tool_count
        total_tok_k = total_tok_k + s.token_kused
        written = written + 1
        i = i + 1
    }
    append_file(RING, buf)
    let kept = rotate_ring()
    println("claude_session_statusline_metric: sessions=" + to_string(written)
          + " msg_total=" + to_string(total_msg)
          + " tool_total=" + to_string(total_tool)
          + " token_k_total=" + to_string(total_tok_k)
          + " ring_kept=" + to_string(kept))
    return written
}

pub fn self_test() -> void {
    if clip(300, 255) != 255 { panic("C12 self_test [clip hi]") }
    if clip(-1, 255) != 0    { panic("C12 self_test [clip lo]") }
    let s = SessAxes { msg_count: 50, tool_count: 12, token_kused: 30, file_touched: 5, error_count: 1, wall_min: 90, cwd: "/Users/ghost/core/airgenome", sess: "abc" }
    let ax = project_axes(s)
    if len(ax) != 6 { panic("C12 self_test [axes len]") }
    if ax[0] != 50 { panic("C12 self_test [axis 0 msg]") }
    if ax[2] != 30 { panic("C12 self_test [axis 2 token_k]") }
    println("  ✅ C12 claude_session_statusline_metric self_test PASS")
}

// auto-invoke entry — raw 245 호환.
fn main() -> void {
    let a = args()
    if len(a) >= 3 && a[2] == "self-test" {
        self_test()
        return
    }
    let _ = run_filter()
}
