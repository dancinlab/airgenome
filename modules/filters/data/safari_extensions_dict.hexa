// airgenome/modules/filters/data/safari_extensions_dict.hexa
//   SF4 — Safari Extensions dict (AppExtensions + WebExtensions Extensions.plist) → SHBF.
//
//   blob layout (little-endian, "SXBF" = Safari eXtensions Blob Filter):
//     magic "SXBF" 4B + ver u32 (1) + n u32 + str_sz u32
//     [n*4] u32 bid_offsets        (bundle id, sorted ascending)
//     [n*4] u32 bid_lens
//     [n*4] u32 name_offsets       (display name = bundle id alias for now)
//     [n*4] u32 name_lens
//     [n*4] u32 added_ts           (unix seconds, AddedDate)
//     [n*1] u8  flags              (bit0=app-kind, bit1=web-kind, bit2=enabled, bit3=user-gesture)
//     pad to 4B
//     [bid_pool_size u32][bid_pool bytes]
//     [name_pool_size u32][name_pool bytes]
//
// pgrep guard: read-only plistlib, Safari running 안전.
// R1 HEXA-FIRST: 인라인 python3 페이로드.

let PAYLOAD = "import sys,os,plistlib,struct,time,bisect,heapq,resource,mmap,array,tempfile,random\n" +
"mode=sys.argv[1]; ignored=sys.argv[2]\n" +
"BIN='/tmp/safari_extensions.bin'\n" +
"COCOA_OFFSET=978307200\n" +
"home=os.environ.get('HOME','/Users/_')\n" +
"S1=home+'/Library/Containers/com.apple.Safari/Data/Library/Safari/AppExtensions/Extensions.plist'\n" +
"S2=home+'/Library/Containers/com.apple.Safari/Data/Library/Safari/WebExtensions/Extensions.plist'\n" +
"\n" +
"def fmt(b):\n" +
"    if b>1048576: return f'{b/1048576:.2f}MB'\n" +
"    if b>1024: return f'{b/1024:.1f}KB'\n" +
"    return f'{b}B'\n" +
"def rss():\n" +
"    r=resource.getrusage(resource.RUSAGE_SELF).ru_maxrss\n" +
"    if sys.platform=='darwin': return r\n" +
"    return r*1024\n" +
"\n" +
"def safe_copy(src):\n" +
"    tmp=tempfile.NamedTemporaryFile(suffix='.plist',delete=False); tmp.close()\n" +
"    with open(src,'rb') as fr, open(tmp.name,'wb') as fw: fw.write(fr.read())\n" +
"    return tmp.name\n" +
"\n" +
"def ts_of(v):\n" +
"    try:\n" +
"        if hasattr(v,'timestamp'): return int(v.timestamp())\n" +
"        if isinstance(v,(int,float)):\n" +
"            return int(v)+COCOA_OFFSET if v<2e9 else int(v)\n" +
"    except Exception: pass\n" +
"    return 0\n" +
"\n" +
"def parse_source(path,kind_bit):\n" +
"    if not os.path.exists(path): return [], 'ext-source-missing'\n" +
"    try:\n" +
"        copy=safe_copy(path)\n" +
"        with open(copy,'rb') as f: d=plistlib.load(f)\n" +
"        os.unlink(copy)\n" +
"    except Exception:\n" +
"        return [], 'ext-corrupt-skip'\n" +
"    if not isinstance(d,dict): return [], 'ext-non-dict-root'\n" +
"    out=[]\n" +
"    for bid,meta in d.items():\n" +
"        if not isinstance(bid,str): continue\n" +
"        added=0; enabled=0; gesture=0\n" +
"        if isinstance(meta,dict):\n" +
"            added=ts_of(meta.get('AddedDate'))\n" +
"            if meta.get('Enabled'): enabled=1\n" +
"            if meta.get('EnabledByUserGesture'): gesture=1\n" +
"        # strip team-id suffix '(XXXXXXXXXX)' for sort key but preserve full name\n" +
"        sort_key=bid.split(' (')[0]\n" +
"        flags=(1<<kind_bit) | (enabled<<2) | (gesture<<3)\n" +
"        out.append((sort_key,bid,added,flags))\n" +
"    return out, 'ext-real'\n" +
"\n" +
"def synth_rows(n=50):\n" +
"    rng=random.Random(42); base=int(time.time())\n" +
"    out=[]\n" +
"    for i in range(n):\n" +
"        bid=f'com.synth.ext{i:03d}'\n" +
"        out.append((bid,bid+' (SYNTH00000)',base-rng.randrange(0,86400*30),(1 if i%2==0 else 2)|((i%3==0)<<2)))\n" +
"    return out\n" +
"\n" +
"def encode(allow_synth=True):\n" +
"    t0=time.perf_counter()\n" +
"    raw_size=0\n" +
"    for p in (S1,S2):\n" +
"        try: raw_size+=os.path.getsize(p)\n" +
"        except Exception: pass\n" +
"    rows=[]; reasons=[]\n" +
"    a,r1=parse_source(S1,0); rows.extend(a); reasons.append('app:'+r1)\n" +
"    w,r2=parse_source(S2,1); rows.extend(w); reasons.append('web:'+r2)\n" +
"    n_app=sum(1 for x in rows if x[3]&1); n_web=sum(1 for x in rows if x[3]&2)\n" +
"    if not rows and allow_synth:\n" +
"        rows=synth_rows(); reasons.append('synth-fallback')\n" +
"    rows.sort(key=lambda r:(r[0],r[1]))\n" +
"    n=len(rows)\n" +
"    bid_pool=bytearray(); bid_offs=array.array('I',[0]*n); bid_lens=array.array('I',[0]*n)\n" +
"    name_pool=bytearray(); name_offs=array.array('I',[0]*n); name_lens=array.array('I',[0]*n)\n" +
"    tss=array.array('I',[0]*n); flags=bytearray(n)\n" +
"    for i,(sk,bid,ts,fb) in enumerate(rows):\n" +
"        bb=sk.encode('utf-8','replace'); nb=bid.encode('utf-8','replace')\n" +
"        bid_offs[i]=len(bid_pool); bid_lens[i]=len(bb); bid_pool.extend(bb)\n" +
"        name_offs[i]=len(name_pool); name_lens[i]=len(nb); name_pool.extend(nb)\n" +
"        tss[i]=int(ts) & 0xFFFFFFFF; flags[i]=fb & 0xFF\n" +
"    header=struct.pack('<4sIII',b'SXBF',1,n,len(bid_pool)+len(name_pool))\n" +
"    with open(BIN,'wb') as f:\n" +
"        f.write(header)\n" +
"        f.write(bid_offs.tobytes()); f.write(bid_lens.tobytes())\n" +
"        f.write(name_offs.tobytes()); f.write(name_lens.tobytes())\n" +
"        f.write(tss.tobytes()); f.write(bytes(flags))\n" +
"        pad=(4-(f.tell()%4))%4\n" +
"        if pad: f.write(b'\\x00'*pad)\n" +
"        f.write(struct.pack('<I',len(bid_pool))); f.write(bytes(bid_pool))\n" +
"        f.write(struct.pack('<I',len(name_pool))); f.write(bytes(name_pool))\n" +
"    t1=time.perf_counter()\n" +
"    return {'encode_s':t1-t0,'n':n,'n_app':n_app,'n_web':n_web,'raw_size':raw_size,'blob_size':os.path.getsize(BIN),'reason':';'.join(reasons)}\n" +
"\n" +
"class Blob:\n" +
"    def __init__(self,path):\n" +
"        self.f=open(path,'rb'); data=self.f.read()\n" +
"        magic,ver,n,_=struct.unpack_from('<4sIII',data,0)\n" +
"        assert magic==b'SXBF' and ver==1\n" +
"        self.n=n; off=16\n" +
"        bid_offs=array.array('I'); bid_offs.frombytes(data[off:off+4*n]); off+=4*n\n" +
"        bid_lens=array.array('I'); bid_lens.frombytes(data[off:off+4*n]); off+=4*n\n" +
"        name_offs=array.array('I'); name_offs.frombytes(data[off:off+4*n]); off+=4*n\n" +
"        name_lens=array.array('I'); name_lens.frombytes(data[off:off+4*n]); off+=4*n\n" +
"        tss=array.array('I'); tss.frombytes(data[off:off+4*n]); off+=4*n\n" +
"        flags=data[off:off+n]; off+=n\n" +
"        pad=(4-(off%4))%4; off+=pad\n" +
"        bp_sz=struct.unpack_from('<I',data,off)[0]; off+=4\n" +
"        bp=data[off:off+bp_sz]; off+=bp_sz\n" +
"        np_sz=struct.unpack_from('<I',data,off)[0]; off+=4\n" +
"        np=data[off:off+np_sz]; off+=np_sz\n" +
"        self.bids=[bp[bid_offs[i]:bid_offs[i]+bid_lens[i]] for i in range(n)]\n" +
"        self.names=[np[name_offs[i]:name_offs[i]+name_lens[i]] for i in range(n)]\n" +
"        self.tss=tss; self.flags=flags\n" +
"    def bid_prefix_topk(self,prefix,k=10):\n" +
"        pb=prefix.encode('utf-8') if isinstance(prefix,str) else prefix\n" +
"        s=bisect.bisect_left(self.bids,pb)\n" +
"        e=bisect.bisect_left(self.bids,pb+b'\\xff\\xff\\xff\\xff')\n" +
"        if e==s: return []\n" +
"        if e-s<=k: idxs=list(range(s,e))\n" +
"        else: idxs=heapq.nlargest(k,range(s,e),key=lambda i:self.tss[i])\n" +
"        return [(self.bids[i].decode('utf-8','replace'),self.names[i].decode('utf-8','replace'),int(self.tss[i]),int(self.flags[i])) for i in idxs]\n" +
"    def close(self): self.f.close()\n" +
"\n" +
"def linear_topk(rows,prefix,k=10):\n" +
"    pb=prefix\n" +
"    hits=[(b,nm,t,fb) for (b,nm,t,fb) in rows if b.startswith(pb)]\n" +
"    hits.sort(key=lambda r:-r[2])\n" +
"    return hits[:k]\n" +
"\n" +
"def bench():\n" +
"    info=encode(allow_synth=True)\n" +
"    print(f'[encode] {info[\"encode_s\"]*1000:.2f} ms n={info[\"n\"]} (app={info[\"n_app\"]} web={info[\"n_web\"]}) blob={fmt(info[\"blob_size\"])} reason={info[\"reason\"]}')\n" +
"    if info['n']==0: print('[bench] no extensions — skip query phase'); return\n" +
"    b=Blob(BIN)\n" +
"    rng=random.Random(42)\n" +
"    samples=[]\n" +
"    for _ in range(50):\n" +
"        i=rng.randrange(b.n)\n" +
"        bid=b.bids[i].decode('utf-8','replace')\n" +
"        plen=rng.choice([3,4,5,6,7])\n" +
"        samples.append(bid[:plen] if len(bid)>=plen else bid)\n" +
"    rss_blob=rss()\n" +
"    for p in samples[:5]: b.bid_prefix_topk(p,10)\n" +
"    t0=time.perf_counter()\n" +
"    blob_hits=0\n" +
"    for p in samples: blob_hits+=len(b.bid_prefix_topk(p,10))\n" +
"    t1=time.perf_counter()\n" +
"    blob_us=(t1-t0)*1e6/len(samples)\n" +
"    rows_list=[(b.bids[i].decode('utf-8','replace'),b.names[i].decode('utf-8','replace'),int(b.tss[i]),int(b.flags[i])) for i in range(b.n)]\n" +
"    b.close()\n" +
"    t0=time.perf_counter()\n" +
"    lin_hits=0\n" +
"    for p in samples: lin_hits+=len(linear_topk(rows_list,p,10))\n" +
"    t1=time.perf_counter()\n" +
"    lin_us=(t1-t0)*1e6/len(samples)\n" +
"    print(f'[query] 50 bid-prefix-topK-10 (blob={blob_hits} linear={lin_hits})')\n" +
"    print(f'  in-memory linear     : {lin_us:10.1f} us')\n" +
"    print(f'  blob mmap + bisect   : {blob_us:10.1f} us')\n" +
"    if blob_us>0: print(f'  speedup              : {lin_us/blob_us:6.1f}x')\n" +
"    print(f'[rss] {fmt(rss_blob)}')\n" +
"\n" +
"if mode=='encode':\n" +
"    info=encode(allow_synth=False)\n" +
"    print(f'encoded {info[\"n\"]} extensions in {info[\"encode_s\"]*1000:.2f} ms → {BIN} ({fmt(info[\"blob_size\"])}) reason={info[\"reason\"]}')\n" +
"elif mode=='bench':\n" +
"    bench()\n" +
"else:\n" +
"    print('usage: encode|bench [unused-arg]'); sys.exit(2)\n"

fn run() {
    let argv = args()
    let mut mode = "bench"
    let mut i = 0
    while i < len(argv) {
        let v = argv[i]
        let is_hexa_bin = v.contains("/hexa-lang/") || v == "hexa" || v == "hexa.real"
        let is_self     = v.contains("safari_extensions_dict")
        if is_hexa_bin == false && is_self == false {
            if v == "encode" || v == "bench" { mode = v }
        }
        i = i + 1
    }
    let safari_pids = exec("pgrep -x Safari 2>/dev/null | wc -l").trim()
    if safari_pids != "0" {
        println("(pgrep: Safari running, " + safari_pids + " pids — read-only safe_copy snapshot used)")
    }
    let tmp_py = "/tmp/safari_extensions_dict_" + exec("date +%s%N").trim() + ".py"
    write_file(tmp_py, PAYLOAD)
    let cmd = "/usr/bin/perl -e 'alarm 120; exec @ARGV' /usr/bin/python3 '" + tmp_py + "' '" + mode + "' '_unused_' 2>&1; rm -f '" + tmp_py + "'"
    let result = exec(cmd)
    print(result)
}

run()
