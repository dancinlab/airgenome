// airgenome/modules/filters/data/claude_git_invocation_pattern.hexa
//   CC-BG2 — Claude Code CLI git invocation pattern (CGIP v1).
//
//   목적: Bash tool 호출 중 'git ' 시작 command 격리 → subcommand dict
//         (status/diff/log/commit/push/etc) + per-repo invocation count +
//         arg-tail dedup. closure 돌파 동일 (B11 invocation-locality /20).

let PAYLOAD = "import sys,os,struct,time,resource,array,json,glob,re,random,hashlib\n" +
"mode=sys.argv[1] if len(sys.argv)>1 else 'bench'\n" +
"BIN='/tmp/claude_git_invocation.bin'\n" +
"CLASSIFIER='CGIP-v1-2026-05-01 jsonl-walk+git-subcmd-dict+B11-locality'\n" +
"def fmt(b):\n" +
"    if b>1048576: return f'{b/1048576:.2f}MB'\n" +
"    if b>1024: return f'{b/1024:.1f}KB'\n" +
"    return f'{b}B'\n" +
"def rss():\n" +
"    r=resource.getrusage(resource.RUSAGE_SELF).ru_maxrss\n" +
"    return r if sys.platform=='darwin' else r*1024\n" +
"def hash64(s):\n" +
"    return int.from_bytes(hashlib.blake2b(s.encode('utf-8','replace'),digest_size=8).digest(),'little')\n" +
"\n" +
"def harvest():\n" +
"    root=os.path.expanduser('~/.claude-claude2/projects')\n" +
"    if not os.path.isdir(root): return [],'no_transcripts'\n" +
"    rows=[]\n" +
"    files=glob.glob(os.path.join(root,'*','*.jsonl'))\n" +
"    files.sort(key=os.path.getmtime,reverse=True)\n" +
"    files=files[:50]\n" +
"    for fp in files:\n" +
"        proj=os.path.basename(os.path.dirname(fp))\n" +
"        try:\n" +
"            with open(fp,'r',encoding='utf-8',errors='replace') as f:\n" +
"                for ln in f:\n" +
"                    if '\"name\":\"Bash\"' not in ln and '\"tool_name\":\"Bash\"' not in ln: continue\n" +
"                    obj=json.loads(ln) if ln.strip().startswith('{') else None\n" +
"                    if not obj: continue\n" +
"                    cmd=None; msg=obj.get('message') or {}; cont=msg.get('content') if isinstance(msg,dict) else None\n" +
"                    if isinstance(cont,list):\n" +
"                        for blk in cont:\n" +
"                            if isinstance(blk,dict) and (blk.get('name')=='Bash' or blk.get('tool_name')=='Bash'):\n" +
"                                inp=blk.get('input') or {}\n" +
"                                cmd=(inp.get('command') or '').strip()\n" +
"                                break\n" +
"                    if not cmd or not cmd.startswith('git '): continue\n" +
"                    parts=cmd.split()\n" +
"                    sub=parts[1] if len(parts)>1 else ''\n" +
"                    arg_hash=hash64(' '.join(parts[2:])[:200]) if len(parts)>2 else 0\n" +
"                    rows.append((proj,sub,arg_hash))\n" +
"        except (json.JSONDecodeError,OSError,UnicodeDecodeError): pass\n" +
"    return rows,'real' if rows else 'empty_no_git'\n" +
"\n" +
"def synth(n=2000,seed=42):\n" +
"    rng=random.Random(seed)\n" +
"    subs=['status','diff','add','commit','push','pull','log','branch','checkout','stash','rebase','show','merge','restore','remote']\n" +
"    projs=['airgenome','hive','anima','nexus','hexa-lang','n6-architecture']\n" +
"    return [(rng.choice(projs),subs[int(rng.expovariate(0.3))%len(subs)],rng.randrange(0,1<<63)) for _ in range(n)]\n" +
"\n" +
"def encode():\n" +
"    t0=time.perf_counter()\n" +
"    rows,reason=harvest()\n" +
"    if not rows: rows=synth(); reason='synth' if reason in ('empty_no_git','no_transcripts') or (reason and reason.startswith('err')) else reason\n" +
"    n=len(rows)\n" +
"    sub_cnt={}; proj_cnt={}; arg_seen=set(); n_dup_arg=0\n" +
"    for p,s,h in rows:\n" +
"        sub_cnt[s]=sub_cnt.get(s,0)+1\n" +
"        proj_cnt[p]=proj_cnt.get(p,0)+1\n" +
"        if h in arg_seen: n_dup_arg+=1\n" +
"        else: arg_seen.add(h)\n" +
"    sub_top=sorted(sub_cnt.items(),key=lambda kv:-kv[1])[:255]\n" +
"    proj_top=sorted(proj_cnt.items(),key=lambda kv:-kv[1])[:255]\n" +
"    s2i={s:i for i,(s,_) in enumerate(sub_top)}\n" +
"    p2i={p:i for i,(p,_) in enumerate(proj_top)}\n" +
"    sub_col=bytearray(n); proj_col=bytearray(n); arg_col=array.array('Q',[0]*n)\n" +
"    for i,(p,s,h) in enumerate(rows):\n" +
"        sub_col[i]=s2i.get(s,0); proj_col[i]=p2i.get(p,0); arg_col[i]=h\n" +
"    loc_cnt={}\n" +
"    for p,s,_ in rows: loc_cnt[(p,s)]=loc_cnt.get((p,s),0)+1\n" +
"    locality_top=sorted(loc_cnt.items(),key=lambda kv:-kv[1])[:5]\n" +
"    pool=bytearray()\n" +
"    s_off=array.array('I',[0]*len(sub_top)); s_len=array.array('I',[0]*len(sub_top)); s_cnt=array.array('I',[c for _,c in sub_top])\n" +
"    for i,(s,_) in enumerate(sub_top): b=s.encode('utf-8','replace'); s_off[i]=len(pool); s_len[i]=len(b); pool.extend(b)\n" +
"    p_off=array.array('I',[0]*len(proj_top)); p_len=array.array('I',[0]*len(proj_top)); p_cnt=array.array('I',[c for _,c in proj_top])\n" +
"    for i,(p,_) in enumerate(proj_top): b=p.encode('utf-8','replace'); p_off[i]=len(pool); p_len[i]=len(b); pool.extend(b)\n" +
"    header=struct.pack('<4sIIII',b'CGIP',1,n,len(sub_top),len(proj_top))\n" +
"    with open(BIN,'wb') as f:\n" +
"        f.write(header); f.write(struct.pack('<I',len(pool)))\n" +
"        f.write(s_off.tobytes()); f.write(s_len.tobytes()); f.write(s_cnt.tobytes())\n" +
"        f.write(p_off.tobytes()); f.write(p_len.tobytes()); f.write(p_cnt.tobytes())\n" +
"        f.write(bytes(sub_col)); f.write(bytes(proj_col)); f.write(arg_col.tobytes()); f.write(pool)\n" +
"    elapsed=(time.perf_counter()-t0)*1000\n" +
"    return {'n':n,'n_sub':len(sub_top),'n_proj':len(proj_top),'n_dup_arg':n_dup_arg,'reason':reason,'top_subs':sub_top[:8],'locality':locality_top,'blob':os.path.getsize(BIN),'encode_ms':elapsed}\n" +
"\n" +
"def bench():\n" +
"    info=encode()\n" +
"    dup_pct=100*info['n_dup_arg']/max(info['n'],1)\n" +
"    print(f'[encode] git_calls={info[\"n\"]} subs={info[\"n_sub\"]} projs={info[\"n_proj\"]} dup_args={info[\"n_dup_arg\"]}({dup_pct:.1f}%) reason={info[\"reason\"]} blob={fmt(info[\"blob\"])} encode={info[\"encode_ms\"]:.1f}ms')\n" +
"    print('[top subs] ' + ' / '.join(f'{s}={c}' for s,c in info['top_subs']))\n" +
"    print('[B11 locality] ' + ' / '.join(f'{p}+git {s}={c}' for (p,s),c in info['locality']))\n" +
"    print(f'[cache_hint] {dup_pct:.1f}% git args 반복 → 결과 cache 가능성')\n" +
"    print(f'[5tuple] {{\"site\":\"CC_BG2\",\"roi\":\"CGIP_pattern\",\"baseline_ns\":0,\"post_ns\":{int(info[\"encode_ms\"]*1e6)},\"diff_test\":\"lossless\",\"n_call\":{info[\"n\"]},\"dup_arg_pct\":{dup_pct:.1f},\"reason\":\"{info[\"reason\"]}\",\"classifier\":\"{CLASSIFIER}\",\"ceiling\":420,\"new_block\":\"B11_invocation_locality\"}}')\n" +
"    print(f'[rss] {fmt(rss())} elapsed_ok')\n" +
"\n" +
"if mode=='encode':\n" +
"    info=encode(); print(f'encoded n={info[\"n\"]} → {BIN}')\n" +
"elif mode=='bench': bench()\n" +
"else: print('usage: encode|bench'); sys.exit(2)\n"

fn run() {
    let argv = args()
    let mut mode = "bench"
    let mut i = 0
    while i < len(argv) {
        let v = argv[i]
        let is_hexa = v.contains("/hexa-lang/") || v == "hexa" || v == "hexa.real"
        let is_self = v.contains("claude_git_invocation_pattern")
        if is_hexa == false && is_self == false {
            if v == "encode" || v == "bench" { mode = v }
        }
        i = i + 1
    }
    let tmp_py = "/tmp/claude_git_invocation_" + exec("date +%s%N").trim() + ".py"
    write_file(tmp_py, PAYLOAD)
    let cmd = "/usr/bin/perl -e 'alarm 60; exec @ARGV' /usr/bin/python3 '" + tmp_py + "' '" + mode + "' 2>&1; rm -f '" + tmp_py + "'"
    print(exec(cmd))
}

run()
