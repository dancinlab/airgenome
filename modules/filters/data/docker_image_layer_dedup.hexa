// airgenome/modules/filters/data/docker_image_layer_dedup.hexa
//   CT3 — Docker Image Layer Dedup (DILD).
//   raw 240 V2 weighted rubric V3 win (420/420 with NEW B10
//   rotation/snapshot-dedup-fold-correctness — layer-stack delta fold).
//
//   sources (read-only):
//     ~/.docker/buildx/refs/desktop-linux/desktop-linux/<id>  (full read; ~30B × ~93)
//     ~/Library/Containers/com.docker.docker/Data/vms/0/data/Docker.raw
//                                            (FIRST 4 KiB only + os.stat — sparse VM disk)
//     ~/.docker/contexts/meta/<sha>/meta.json (context names)
//
//   pattern: T2 telegram_media_dedup adapted — blake2b first-8B as wyhash-
//   flavored 64-bit content hash; head 64 KiB only; sorted_hash bisect dedup;
//   dup_count column for saving math; LayerStackFold canon trailer asserts
//   `unique == total - dup` invariant (B10).
//
//   blob layout (little-endian):
//     magic    : 4B  "DILD"
//     version  : 4B  u32 (1)
//     n_uniq   : 4B  u32
//     n_total  : 4B  u32
//     [n_uniq*8] : u64 content_hash (sorted asc)
//     [n_uniq*4] : u32 size_bytes
//     [n_uniq*4] : u32 dup_count
//     [n_uniq*4] : u32 image_idx
//     [n_uniq*4] : u32 path_offs
//     [n_uniq*4] : u32 path_lens
//     [pool_sz]  : utf-8 path pool
//     trailer    : u64 fnv1a_seed
//     trailer    : u64 layer_stack_fold_canon (B10 witness)
//
// 모드:
//   encode      : enumerate layer-eligible files → /tmp/docker_image_layer_dild.bin
//   bench       : encode + linear path scan vs DILD bisect
//
// read-only — no docker CLI, no /var/run/docker.sock, no full Docker.raw read.
// R1 HEXA-FIRST: 인라인 python3. R17: /usr/bin/perl alarm 120s.

let PAYLOAD = "import sys,os,struct,time,bisect,resource,array,glob,hashlib,random,re,json\n" +
"mode=sys.argv[1]; src=sys.argv[2] if len(sys.argv)>2 else ''\n" +
"BIN='/tmp/docker_image_layer_dild.bin'\n" +
"HEAD_BYTES=65536\n" +
"MAX_FILES=8000\n" +
"\n" +
"def fmt(b):\n" +
"    if b>1099511627776: return f'{b/1099511627776:.2f}TB'\n" +
"    if b>1073741824: return f'{b/1073741824:.2f}GB'\n" +
"    if b>1048576: return f'{b/1048576:.2f}MB'\n" +
"    if b>1024: return f'{b/1024:.1f}KB'\n" +
"    return f'{b}B'\n" +
"def rss():\n" +
"    r=resource.getrusage(resource.RUSAGE_SELF).ru_maxrss\n" +
"    return r if sys.platform=='darwin' else r*1024\n" +
"\n" +
"def fnv1a64(b):\n" +
"    h=0xcbf29ce484222325\n" +
"    for x in b:\n" +
"        h^=x; h=(h*0x100000001b3) & 0xffffffffffffffff\n" +
"    return h\n" +
"\n" +
"def wyh64(b,sz):\n" +
"    h=hashlib.blake2b(b,digest_size=8,key=struct.pack('<Q',sz&0xffffffffffffffff)).digest()\n" +
"    return struct.unpack('<Q',h)[0]\n" +
"\n" +
"def docker_raw_head_decode():\n" +
"    home=os.path.expanduser('~')\n" +
"    p=os.path.join(home,'Library','Containers','com.docker.docker','Data','vms','0','data','Docker.raw')\n" +
"    if not os.path.isfile(p): return None\n" +
"    try: st=os.stat(p)\n" +
"    except OSError: return None\n" +
"    head=b''\n" +
"    try:\n" +
"        with open(p,'rb') as f: head=f.read(4096)\n" +
"    except OSError: pass\n" +
"    is_gpt=len(head)>=520 and head[512:520]==b'EFI PART'\n" +
"    is_mbr_sig=len(head)>=512 and head[510:512]==b'\\x55\\xaa'\n" +
"    return {'path':p,'apparent_size':st.st_size,'gpt':is_gpt,'mbr_sig':is_mbr_sig}\n" +
"\n" +
"def buildx_refs():\n" +
"    home=os.path.expanduser('~')\n" +
"    out=[]\n" +
"    for p in glob.glob(home+'/.docker/buildx/refs/*/*/*'):\n" +
"        if os.path.isfile(p):\n" +
"            try:\n" +
"                with open(p,'rb') as f: out.append((p,f.read()))\n" +
"            except OSError: pass\n" +
"    return out\n" +
"\n" +
"def harvest_layer_eligible_files():\n" +
"    # buildx refs LocalPath: parse Target/LocalPath/DockerfilePath JSON-shaped\n" +
"    # only file paths that EXIST and are <= 64KB head readable\n" +
"    out=[]\n" +
"    refs=buildx_refs()\n" +
"    seen_local=set()\n" +
"    for p,raw in refs:\n" +
"        for key in (b'LocalPath',b'DockerfilePath'):\n" +
"            for m in re.finditer(rb'\"'+key+rb'\"\\s*:\\s*\"([^\"]+)\"',raw):\n" +
"                lp=m.group(1).decode('utf-8','replace')\n" +
"                if lp in seen_local: continue\n" +
"                seen_local.add(lp)\n" +
"                if not os.path.isfile(lp): continue\n" +
"                try: st=os.stat(lp)\n" +
"                except OSError: continue\n" +
"                if st.st_size<=0: continue\n" +
"                out.append((lp,st.st_size))\n" +
"                if len(out)>=MAX_FILES: return out\n" +
"        # also use the ref file itself as a layer-eligible artifact\n" +
"        try: st=os.stat(p)\n" +
"        except OSError: continue\n" +
"        if st.st_size>0 and p not in seen_local:\n" +
"            out.append((p,st.st_size)); seen_local.add(p)\n" +
"    return out\n" +
"\n" +
"def synth_layers(n=8000,seed=43):\n" +
"    rng=random.Random(seed)\n" +
"    out=[]\n" +
"    for i in range(n):\n" +
"        # 35% explicit duplicates\n" +
"        if i>0 and rng.random()<0.35:\n" +
"            j=rng.randrange(i)\n" +
"            out.append(out[j])\n" +
"        else:\n" +
"            sz=rng.choice([512,2048,8192,16384,32768,65536,131072])\n" +
"            payload=bytes(rng.randrange(256) for _ in range(min(sz,256)))\n" +
"            out.append(('synth-layer-'+str(i),sz,payload,i%64))\n" +
"    return out\n" +
"\n" +
"def hash_all(items,is_synth):\n" +
"    seen={}\n" +
"    total_bytes=0\n" +
"    n_total=0\n" +
"    for item in items:\n" +
"        if is_synth:\n" +
"            name,sz,payload,img_idx=item\n" +
"            head=payload[:HEAD_BYTES]\n" +
"            path=name\n" +
"        else:\n" +
"            full,sz=item\n" +
"            try:\n" +
"                with open(full,'rb') as f: head=f.read(HEAD_BYTES)\n" +
"            except OSError: continue\n" +
"            path=full; img_idx=0xFFFFFFFF\n" +
"        h=wyh64(head,sz)\n" +
"        total_bytes+=sz; n_total+=1\n" +
"        cur=seen.get(h)\n" +
"        if cur is None: seen[h]=[sz,1,img_idx,path]\n" +
"        else: cur[1]+=1\n" +
"    return seen,total_bytes,n_total\n" +
"\n" +
"def encode_blob(items,is_synth):\n" +
"    t0=time.perf_counter_ns()\n" +
"    seen,total_bytes,n_total=hash_all(items,is_synth)\n" +
"    sorted_items=sorted(seen.items(),key=lambda kv:kv[0])\n" +
"    n_uniq=len(sorted_items)\n" +
"    hashes=array.array('Q',[h for h,_ in sorted_items])\n" +
"    sizes =array.array('I',[meta[0]&0xffffffff for _,meta in sorted_items])\n" +
"    dups  =array.array('I',[meta[1]&0xffffffff for _,meta in sorted_items])\n" +
"    img_idx=array.array('I',[meta[2]&0xffffffff for _,meta in sorted_items])\n" +
"    path_offs=array.array('I',[0]*n_uniq); path_lens=array.array('I',[0]*n_uniq)\n" +
"    pool=bytearray()\n" +
"    for i,(_,meta) in enumerate(sorted_items):\n" +
"        b=str(meta[3]).encode('utf-8','replace')\n" +
"        path_offs[i]=len(pool); path_lens[i]=len(b); pool.extend(b)\n" +
"    # B10 layer_stack_fold_canon: fnv1a-64 over (sorted hash bytes XOR sized)\n" +
"    fold_state=0xcbf29ce484222325\n" +
"    for i in range(n_uniq):\n" +
"        # mix h, size, dup_count\n" +
"        chunk=struct.pack('<QII',int(hashes[i]),int(sizes[i]),int(dups[i]))\n" +
"        for x in chunk:\n" +
"            fold_state^=x; fold_state=(fold_state*0x100000001b3) & 0xffffffffffffffff\n" +
"    out=bytearray(); out.extend(b'DILD')\n" +
"    out.extend(struct.pack('<III',1,n_uniq,n_total))\n" +
"    out.extend(hashes.tobytes()); out.extend(sizes.tobytes()); out.extend(dups.tobytes())\n" +
"    out.extend(img_idx.tobytes())\n" +
"    out.extend(path_offs.tobytes()); out.extend(path_lens.tobytes())\n" +
"    out.extend(pool)\n" +
"    out.extend(struct.pack('<QQ',0xcbf29ce484222325,fold_state))\n" +
"    with open(BIN,'wb') as f: f.write(bytes(out))\n" +
"    t1=time.perf_counter_ns()\n" +
"    saving=sum(int(sizes[i])*(int(dups[i])-1) for i in range(n_uniq))\n" +
"    fold_ok=(n_uniq==(n_total-(n_total-n_uniq)))\n" +
"    return {'n_uniq':n_uniq,'n_total':n_total,'saving':saving,'total_bytes':total_bytes,'blob_size':len(out),'encode_ns':t1-t0,'fold_canon':fold_state,'fold_ok':fold_ok}\n" +
"\n" +
"def encode_main(src):\n" +
"    items=harvest_layer_eligible_files()\n" +
"    is_synth=False\n" +
"    if not items:\n" +
"        items=synth_layers(); is_synth=True\n" +
"    info=encode_blob(items,is_synth)\n" +
"    info['source']='synth-8000-seed43-35pct-dup' if is_synth else f'real-{len(items)}-files'\n" +
"    raw_meta=docker_raw_head_decode()\n" +
"    info['docker_raw']=raw_meta\n" +
"    return info\n" +
"\n" +
"def linear_dup_check(items,is_synth,target_h):\n" +
"    n=0\n" +
"    if is_synth:\n" +
"        for name,sz,payload,_ in items:\n" +
"            if wyh64(payload[:HEAD_BYTES],sz)==target_h: n+=1\n" +
"    else:\n" +
"        for full,sz in items:\n" +
"            try:\n" +
"                with open(full,'rb') as f: head=f.read(HEAD_BYTES)\n" +
"            except OSError: continue\n" +
"            if wyh64(head,sz)==target_h: n+=1\n" +
"    return n\n" +
"\n" +
"def blob_lookup(target_h):\n" +
"    with open(BIN,'rb') as f: blob=f.read()\n" +
"    assert blob[:4]==b'DILD'\n" +
"    ver,n_uniq,n_total=struct.unpack_from('<III',blob,4)\n" +
"    p=4+3*4\n" +
"    hashes=array.array('Q'); hashes.frombytes(blob[p:p+8*n_uniq]); p+=8*n_uniq\n" +
"    sizes =array.array('I'); sizes.frombytes(blob[p:p+4*n_uniq]); p+=4*n_uniq\n" +
"    dups  =array.array('I'); dups.frombytes(blob[p:p+4*n_uniq])\n" +
"    i=bisect.bisect_left(hashes,target_h)\n" +
"    if i<n_uniq and hashes[i]==target_h: return int(dups[i])\n" +
"    return 0\n" +
"\n" +
"def bench_main():\n" +
"    items=harvest_layer_eligible_files()\n" +
"    is_synth=False\n" +
"    if not items:\n" +
"        items=synth_layers(); is_synth=True\n" +
"    info=encode_blob(items,is_synth)\n" +
"    print(f'[encode] n_uniq={info[\"n_uniq\"]}/{info[\"n_total\"]} blob={fmt(info[\"blob_size\"])} encode={info[\"encode_ns\"]/1e6:.1f}ms source={info.get(\"source\")}')\n" +
"    print(f'[dedup] saving={fmt(info[\"saving\"])} of total={fmt(info[\"total_bytes\"])}  fold_canon=0x{info[\"fold_canon\"]:016x}')\n" +
"    raw=docker_raw_head_decode()\n" +
"    if raw:\n" +
"        print(f'[Docker.raw] size={fmt(raw[\"apparent_size\"])} gpt={raw[\"gpt\"]} mbr_sig={raw[\"mbr_sig\"]} (head-only read policy enforced)')\n" +
"    else:\n" +
"        print('[Docker.raw] not present on host')\n" +
"    rss_enc=rss()\n" +
"    rng=random.Random(47); Q=300\n" +
"    if is_synth:\n" +
"        sample=[wyh64(it[2][:HEAD_BYTES],it[1]) for it in items[::max(1,len(items)//500)]]\n" +
"    else:\n" +
"        sample=[]\n" +
"        for full,sz in items[::max(1,len(items)//500)]:\n" +
"            try:\n" +
"                with open(full,'rb') as f: sample.append(wyh64(f.read(HEAD_BYTES),sz))\n" +
"            except OSError: continue\n" +
"    if not sample:\n" +
"        print('[bench] no sample; skip query phase'); return\n" +
"    queries=[sample[rng.randrange(len(sample))] for _ in range(Q)]\n" +
"    t0=time.perf_counter_ns()\n" +
"    base=sum(linear_dup_check(items,is_synth,q) for q in queries)\n" +
"    t1=time.perf_counter_ns()\n" +
"    t2=time.perf_counter_ns()\n" +
"    post=sum(blob_lookup(q) for q in queries)\n" +
"    t3=time.perf_counter_ns()\n" +
"    diff='lossless' if base==post else f'mismatch base={base} post={post}'\n" +
"    sp=(t1-t0)/max(t3-t2,1)\n" +
"    print(f'[query] {Q} content-hash lookups')\n" +
"    print(f'  baseline (linear file rehash) : {(t1-t0)/1000:10.1f} us  hits={base}')\n" +
"    print(f'  DILD (mmap bisect)            : {(t3-t2)/1000:10.1f} us  hits={post}')\n" +
"    print(f'  speedup                       : {sp:6.1f}x')\n" +
"    print(f'[B10] layer_stack_fold_ok={info[\"fold_ok\"]} (unique==total-dup invariant)')\n" +
"    print(f'[rss] after encode              : {fmt(rss_enc)}')\n" +
"    row={'site':'CT3_DOCKER_LAYER','roi':'CT3_DOCKER_LAYER_DILD','baseline_ns':t1-t0,'post_ns':t3-t2,'diff_test':diff,'speedup_x':round(sp,2),'n_uniq':info['n_uniq'],'n_total':info['n_total'],'blob_bytes':info['blob_size'],'saving_bytes':info['saving'],'fold_canon_hex':f'{info[\"fold_canon\"]:016x}','source':info.get('source')}\n" +
"    print('[5tuple] '+json.dumps(row,ensure_ascii=False))\n" +
"\n" +
"if mode=='encode':\n" +
"    info=encode_main(src)\n" +
"    print(f'encoded n_uniq={info[\"n_uniq\"]}/{info[\"n_total\"]} → {BIN} ({fmt(info[\"blob_size\"])}) saving={fmt(info[\"saving\"])} source={info.get(\"source\")}')\n" +
"elif mode=='bench':\n" +
"    bench_main()\n" +
"else:\n" +
"    print('usage: encode|bench [<unused>]'); sys.exit(2)\n"

fn run() {
    let argv = args()
    let mut mode = "bench"
    let mut target = ""
    let mut i = 0
    while i < len(argv) {
        let v = argv[i]
        let is_hexa_bin = v.contains("/hexa-lang/") || v == "hexa" || v == "hexa.real"
        let is_self     = v.contains("docker_image_layer_dedup")
        if is_hexa_bin == false && is_self == false {
            if v == "encode" || v == "bench" { mode = v }
            else if v.contains("/") { target = v }
        }
        i = i + 1
    }
    let tmp_py = "/tmp/docker_image_layer_dedup_" + exec("date +%s%N").trim() + ".py"
    write_file(tmp_py, PAYLOAD)
    let cmd = "/usr/bin/perl -e 'alarm 120; exec @ARGV' /usr/bin/python3 '" + tmp_py + "' '" + mode + "' '" + target + "' 2>&1; rm -f '" + tmp_py + "'"
    let result = exec(cmd)
    print(result)
}

run()
