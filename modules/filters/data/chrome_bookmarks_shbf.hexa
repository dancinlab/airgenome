// airgenome/modules/filters/data/chrome_bookmarks_shbf.hexa
//   BR2 — Chrome Bookmarks JSON-tree → SHBF (CBBF v1).
//
//   목적: Chrome `Default/Bookmarks` JSON 트리를 매번 json.load + 재귀 walk +
//         linear prefix scan 하던 hot path 를 단일 mmap blob 으로 치환.
//
//   blob layout (little-endian):
//     magic    : 4B  "CBBF"          (Chrome Bookmarks Blob Filter)
//     version  : 4B  u32 (1)
//     n        : 4B  u32  url 개수
//     str_sz   : 4B  u32  pool size
//     [n*4]    : u32 offsets         (정렬된 url 순)
//     [n*4]    : u32 lens
//     [n*4]    : u32 weight          (depth 기반)
//     [str_sz] : utf-8 url pool      NUL 없음
//
//   read-only 전략:
//     - open('rb') only — Bookmarks / Bookmarks.bak 미수정
//     - pgrep -lf '[Cc]hrome' 양수 → synth fallback (encode-safe window)
//
//   classifier_version=CBBF-v1-2026-04-30
//
// R1 HEXA-FIRST: 인라인 python3 페이로드. R17: /usr/bin/perl alarm 120s.

let PAYLOAD = "import sys,os,json,tempfile,struct,time,bisect,heapq,resource,mmap,array,subprocess,random\n" +
"mode=sys.argv[1] if len(sys.argv)>1 else 'bench'\n" +
"src=sys.argv[2] if len(sys.argv)>2 else os.path.expanduser('~/Library/Application Support/Google/Chrome/Default/Bookmarks')\n" +
"BIN='/tmp/chrome_bookmarks_cbbf.bin'\n" +
"CLASSIFIER='CBBF-v1-2026-04-30'\n" +
"\n" +
"def fmt(b):\n" +
"    if b>1048576: return f'{b/1048576:.2f}MB'\n" +
"    if b>1024: return f'{b/1024:.1f}KB'\n" +
"    return f'{b}B'\n" +
"def rss():\n" +
"    r=resource.getrusage(resource.RUSAGE_SELF).ru_maxrss\n" +
"    if sys.platform=='darwin': return r\n" +
"    return r*1024\n" +
"\n" +
"def chrome_running():\n" +
"    r=subprocess.run(['/usr/bin/pgrep','-lf','[Cc]hrome'],capture_output=True,timeout=3)\n" +
"    return bool(r.stdout.strip())\n" +
"\n" +
"def safe_copy(src):\n" +
"    tmp=tempfile.NamedTemporaryFile(suffix='.json',delete=False); tmp.close()\n" +
"    with open(src,'rb') as fr, open(tmp.name,'wb') as fw:\n" +
"        fw.write(fr.read())\n" +
"    return tmp.name\n" +
"\n" +
"def walk_node(node, depth, out):\n" +
"    # Chrome bookmark node: {'type':'folder'|'url','url':..,'name':..,'children':[..]}\n" +
"    if isinstance(node, dict):\n" +
"        t=node.get('type')\n" +
"        u=node.get('url')\n" +
"        if t=='url' and isinstance(u,str) and u:\n" +
"            w=max(1, 100-depth*10)\n" +
"            out.append((u,w))\n" +
"        ch=node.get('children')\n" +
"        if isinstance(ch,list):\n" +
"            for c in ch:\n" +
"                walk_node(c, depth+1, out)\n" +
"    elif isinstance(node, list):\n" +
"        for c in node:\n" +
"            walk_node(c, depth+1, out)\n" +
"\n" +
"def parse_bookmarks(path):\n" +
"    with open(path,'rb') as f:\n" +
"        return json.loads(f.read().decode('utf-8','replace'))\n" +
"\n" +
"def synth_rows(n=5000,seed=43):\n" +
"    rng=random.Random(seed); out=[]\n" +
"    domains=['github.com','google.com','stackoverflow.com','youtube.com','wikipedia.org','reddit.com','developer.mozilla.org','docs.python.org','news.ycombinator.com','apple.com','arxiv.org','x.com']\n" +
"    for i in range(n):\n" +
"        d=domains[i%len(domains)]\n" +
"        depth=(i//100)%9\n" +
"        path='/'.join([f'f{rng.randrange(50)}' for _ in range(depth+1)])\n" +
"        out.append((f'https://{d}/{path}/bm-{i}', max(1,100-depth*10)))\n" +
"    return out\n" +
"\n" +
"def harvest_real(src):\n" +
"    copy=safe_copy(src); raw_size=os.path.getsize(copy)\n" +
"    root=parse_bookmarks(copy); os.unlink(copy)\n" +
"    rows=[]\n" +
"    walk_node(root.get('roots',{}),0,rows)\n" +
"    return rows, raw_size\n" +
"\n" +
"def encode(src):\n" +
"    t0=time.perf_counter(); reason=[]\n" +
"    if chrome_running():\n" +
"        rows=synth_rows(); raw_size=0; reason.append('br2_running'); source='synth (chrome running)'\n" +
"    elif not os.path.exists(src):\n" +
"        rows=synth_rows(); raw_size=0; reason.append('br2_no_file'); source='synth (no file)'\n" +
"    else:\n" +
"        rows,raw_size=harvest_real(src); source='real'\n" +
"        if not rows:\n" +
"            rows=synth_rows(); reason.append('br2_empty'); source='synth (empty tree)'\n" +
"    seen={}\n" +
"    for u,w in rows:\n" +
"        if u not in seen or seen[u]<w: seen[u]=w\n" +
"    rows=sorted(seen.items(), key=lambda r:r[0])\n" +
"    n=len(rows); pool=bytearray()\n" +
"    offs=array.array('I',[0]*n); lens=array.array('I',[0]*n); vcs=array.array('I',[0]*n)\n" +
"    for i,(u,w) in enumerate(rows):\n" +
"        ub=u.encode('utf-8','replace')\n" +
"        offs[i]=len(pool); lens[i]=len(ub); vcs[i]=int(w); pool.extend(ub)\n" +
"    header=struct.pack('<4sIII',b'CBBF',1,n,len(pool))\n" +
"    with open(BIN,'wb') as f:\n" +
"        f.write(header); f.write(offs.tobytes()); f.write(lens.tobytes()); f.write(vcs.tobytes()); f.write(pool)\n" +
"    t1=time.perf_counter()\n" +
"    return {'encode_s':t1-t0,'n':n,'raw_size':raw_size,'blob_size':os.path.getsize(BIN),'source':source,'reason':reason}\n" +
"\n" +
"class Blob:\n" +
"    def __init__(self,path):\n" +
"        self.f=open(path,'rb')\n" +
"        self.mm=mmap.mmap(self.f.fileno(),0,prot=mmap.PROT_READ)\n" +
"        magic,ver,n,pool_sz=struct.unpack_from('<4sIII',self.mm,0)\n" +
"        if magic!=b'CBBF' or ver!=1: raise ValueError(f'bad magic/ver {magic} {ver}')\n" +
"        self.n=n; self.pool_sz=pool_sz; base=16\n" +
"        offs=array.array('I'); offs.frombytes(bytes(self.mm[base:base+4*n]))\n" +
"        lens=array.array('I'); lens.frombytes(bytes(self.mm[base+4*n:base+8*n]))\n" +
"        vcs =array.array('I'); vcs.frombytes(bytes(self.mm[base+8*n:base+12*n]))\n" +
"        pool=bytes(self.mm[base+12*n:base+12*n+pool_sz])\n" +
"        self.urls=[pool[offs[i]:offs[i]+lens[i]] for i in range(n)]\n" +
"        self.vcs=vcs\n" +
"    def url(self,i): return self.urls[i]\n" +
"    def prefix_topk(self,prefix,k=10):\n" +
"        pb=prefix.encode('utf-8') if isinstance(prefix,str) else prefix\n" +
"        s=bisect.bisect_left(self.urls,pb)\n" +
"        e=bisect.bisect_left(self.urls,pb+b'\\xff\\xff\\xff\\xff')\n" +
"        if e==s: return []\n" +
"        if e-s<=k: idxs=list(range(s,e))\n" +
"        else: idxs=heapq.nlargest(k,range(s,e),key=lambda i:self.vcs[i])\n" +
"        idxs.sort(key=lambda i:-self.vcs[i])\n" +
"        return [(self.urls[i].decode('utf-8','replace'),int(self.vcs[i])) for i in idxs]\n" +
"    def close(self):\n" +
"        self.mm.close(); self.f.close()\n" +
"\n" +
"def selftest():\n" +
"    cases=[('synth nonempty', len(synth_rows(50))==50),\n" +
"           ('CBBF magic stable', b'CBBF'==b'CBBF'),\n" +
"           ('classifier pinned', CLASSIFIER=='CBBF-v1-2026-04-30'),\n" +
"           ('depth weight', max(1,100-9*10)==10)]\n" +
"    ok=sum(1 for _,v in cases if v)\n" +
"    print(f'[selftest] fixtures={ok}/{len(cases)}  classifier_version={CLASSIFIER}')\n" +
"    return ok==len(cases)\n" +
"\n" +
"def bench(src):\n" +
"    if not selftest(): print('SELFTEST FAIL'); sys.exit(2)\n" +
"    info=encode(src)\n" +
"    print(f'[encode] {info[\"encode_s\"]*1000:.1f}ms  urls={info[\"n\"]}  blob={fmt(info[\"blob_size\"])}  source={info[\"source\"]}')\n" +
"    print(f'[reason] {\",\".join(info[\"reason\"]) if info[\"reason\"] else \"-\"}')\n" +
"    if info['n']==0: print('[bench] no urls — skip'); return\n" +
"    b=Blob(BIN); rng=random.Random(11); samples=[]\n" +
"    for _ in range(100):\n" +
"        i=rng.randrange(b.n); u=b.url(i).decode('utf-8','replace')\n" +
"        s=u.find('://'); start=s+3 if s>=0 else 0\n" +
"        plen=rng.choice([4,5,6,7,8])\n" +
"        samples.append(u[:start+plen] if len(u)>=start+plen else u)\n" +
"    rss_blob=rss()\n" +
"    for p in samples[:5]: b.prefix_topk(p,10)\n" +
"    t0=time.perf_counter(); h=0\n" +
"    for p in samples: h+=len(b.prefix_topk(p,10))\n" +
"    t1=time.perf_counter(); blob_us=(t1-t0)*1e6/len(samples)\n" +
"    b.close()\n" +
"    print(f'[query] 100 prefix-topK-10  hits_blob={h}  per_query={blob_us:.1f}us')\n" +
"    print(f'[rss] after blob: {fmt(rss_blob)}')\n" +
"\n" +
"if mode=='encode':\n" +
"    info=encode(src)\n" +
"    print(f'encoded {info[\"n\"]} urls in {info[\"encode_s\"]*1000:.1f}ms -> {BIN} ({fmt(info[\"blob_size\"])}, source={info[\"source\"]})')\n" +
"    print(f'classifier_version={CLASSIFIER}')\n" +
"elif mode=='selftest':\n" +
"    ok=selftest(); sys.exit(0 if ok else 2)\n" +
"elif mode=='bench':\n" +
"    bench(src)\n" +
"else:\n" +
"    print('usage: encode|bench|selftest [<Bookmarks>]'); sys.exit(2)\n"

fn run() {
    let argv = args()
    let mut mode = "bench"
    let mut target = ""
    let mut i = 0
    while i < len(argv) {
        let v = argv[i]
        let is_hexa_bin = v.contains("/hexa-lang/") || v == "hexa" || v == "hexa.real"
        let is_self     = v.contains("chrome_bookmarks_shbf")
        if is_hexa_bin == false && is_self == false {
            if v == "encode" || v == "bench" || v == "selftest" { mode = v }
            else if v.contains("/") || v.contains("Bookmarks") { target = v }
        }
        i = i + 1
    }
    if len(target) == 0 {
        target = env("HOME") + "/Library/Application Support/Google/Chrome/Default/Bookmarks"
    }
    let tmp_py = "/tmp/chrome_bookmarks_shbf_" + exec("date +%s%N").trim() + ".py"
    write_file(tmp_py, PAYLOAD)
    let cmd = "/usr/bin/perl -e 'alarm 120; exec @ARGV' /usr/bin/python3 '" + tmp_py + "' '" + mode + "' '" + target + "' 2>&1; rm -f '" + tmp_py + "'"
    let result = exec(cmd)
    print(result)
}

run()
