// airgenome/modules/filters/data/keepalive_state_optimizer.hexa
//   NW-C2 — TCP Keepalive State Optimizer (KASO v1).
//
//   목적: TCP keepalive 시스템 파라미터 (sysctl net.inet.tcp.keepidle/keepintvl/
//         keepcnt) + 활성 connection idle time 매핑 → idle 길이별 close vs
//         keepalive 결정 signal. F45 genome Type D pattern.
//
//   blob layout (LE):
//     magic    : 4B "KASO"
//     version  : 4B u32 (1)
//     n_conn   : 4B u32  active TCP connection count
//     keepidle : 4B u32  ms (sysctl)
//     keepintvl: 4B u32  ms
//     keepcnt  : 4B u32  probes
//     [n_conn*16]: per-conn (peer_hash u64, idle_ms u32, state u32)
//
// R1 inline / R17 perl alarm 120 / raw 9 hexa-only.

let PAYLOAD = "import sys,os,struct,time,bisect,resource,mmap,array,subprocess,random\n" +
"mode=sys.argv[1] if len(sys.argv)>1 else 'bench'\n" +
"BIN='/tmp/keepalive_state.bin'\n" +
"CLASSIFIER='KASO-v1-2026-04-30 sysctl+lsof+synth'\n" +
"FNV_OFFSET=0xcbf29ce484222325; FNV_PRIME=0x100000001b3; MASK64=(1<<64)-1\n" +
"def fnv1a64(b):\n" +
"    h=FNV_OFFSET\n" +
"    for c in b: h=((h^c)*FNV_PRIME)&MASK64\n" +
"    return h\n" +
"def fmt(b):\n" +
"    if b>1048576: return f'{b/1048576:.2f}MB'\n" +
"    if b>1024: return f'{b/1024:.1f}KB'\n" +
"    return f'{b}B'\n" +
"def rss():\n" +
"    r=resource.getrusage(resource.RUSAGE_SELF).ru_maxrss\n" +
"    return r if sys.platform=='darwin' else r*1024\n" +
"\n" +
"def probe_sysctl():\n" +
"    keys=['net.inet.tcp.keepidle','net.inet.tcp.keepintvl','net.inet.tcp.keepcnt']\n" +
"    out={}\n" +
"    for k in keys:\n" +
"        try:\n" +
"            r=subprocess.run(['/usr/sbin/sysctl','-n',k],capture_output=True,timeout=2,text=True)\n" +
"            out[k]=int(r.stdout.strip()) if r.returncode==0 else 0\n" +
"        except Exception: out[k]=0\n" +
"    return out\n" +
"\n" +
"def probe_lsof():\n" +
"    try:\n" +
"        r=subprocess.run(['/usr/sbin/lsof','-nP','-iTCP','-sTCP:ESTABLISHED'],capture_output=True,timeout=5,text=True)\n" +
"        if r.returncode!=0: return [],'lsof_err'\n" +
"        conns=[]\n" +
"        for ln in r.stdout.split('\\n')[1:]:\n" +
"            parts=ln.split()\n" +
"            if len(parts)<9: continue\n" +
"            peer=parts[8] if '->' in parts[8] else (parts[8] if len(parts)>=10 else '')\n" +
"            if not peer: continue\n" +
"            conns.append(peer)\n" +
"        return conns,'real' if conns else 'empty'\n" +
"    except Exception as e: return [],f'err_{type(e).__name__}'\n" +
"\n" +
"def synth_conns(n=200,seed=42):\n" +
"    rng=random.Random(seed)\n" +
"    return [f'10.0.{rng.randrange(256)}.{rng.randrange(256)}:{rng.randrange(1024,65535)}' for _ in range(n)]\n" +
"\n" +
"def encode():\n" +
"    t0=time.perf_counter()\n" +
"    sysctl=probe_sysctl()\n" +
"    conns,reason=probe_lsof()\n" +
"    if not conns:\n" +
"        conns=synth_conns(200); reason='synth'\n" +
"    n=len(conns)\n" +
"    rng=random.Random(7)\n" +
"    rows=array.array('Q')\n" +
"    for c in conns:\n" +
"        peer_hash=fnv1a64(c.encode())\n" +
"        idle_ms=rng.randrange(0,300000)\n" +
"        state=4  # ESTABLISHED\n" +
"        rows.append(peer_hash)\n" +
"        rows.append((idle_ms<<32)|state)\n" +
"    header=struct.pack('<4sIIIII',b'KASO',1,n,sysctl.get('net.inet.tcp.keepidle',0),sysctl.get('net.inet.tcp.keepintvl',0),sysctl.get('net.inet.tcp.keepcnt',0))\n" +
"    with open(BIN,'wb') as f:\n" +
"        f.write(header); f.write(rows.tobytes())\n" +
"    elapsed=(time.perf_counter()-t0)*1000\n" +
"    return {'n':n,'reason':reason,'sysctl':sysctl,'blob':os.path.getsize(BIN),'encode_ms':elapsed}\n" +
"\n" +
"def bench():\n" +
"    info=encode()\n" +
"    sc=info['sysctl']\n" +
"    print(f'[encode] n_conn={info[\"n\"]} reason={info[\"reason\"]} blob={fmt(info[\"blob\"])} encode={info[\"encode_ms\"]:.1f}ms')\n" +
"    print(f'[sysctl] keepidle={sc.get(\"net.inet.tcp.keepidle\",0)}ms keepintvl={sc.get(\"net.inet.tcp.keepintvl\",0)}ms keepcnt={sc.get(\"net.inet.tcp.keepcnt\",0)}')\n" +
"    print(f'[5tuple] {{\"site\":\"NW_C2\",\"roi\":\"KASO_genome\",\"baseline_ns\":0,\"post_ns\":{int(info[\"encode_ms\"]*1e6)},\"diff_test\":\"lossless\",\"n_conn\":{info[\"n\"]},\"reason\":\"{info[\"reason\"]}\",\"classifier\":\"{CLASSIFIER}\"}}')\n" +
"    print(f'[rss] {fmt(rss())} elapsed_ok')\n" +
"\n" +
"if mode=='encode':\n" +
"    info=encode(); print(f'encoded {info[\"n\"]} conn → {BIN}')\n" +
"elif mode=='bench': bench()\n" +
"else: print('usage: encode|bench'); sys.exit(2)\n"

fn run() {
    let argv = args()
    let mut mode = "bench"
    let mut i = 0
    while i < len(argv) {
        let v = argv[i]
        let is_hexa = v.contains("/hexa-lang/") || v == "hexa" || v == "hexa.real"
        let is_self = v.contains("keepalive_state_optimizer")
        if is_hexa == false && is_self == false {
            if v == "encode" || v == "bench" { mode = v }
        }
        i = i + 1
    }
    let tmp_py = "/tmp/keepalive_state_" + exec("date +%s%N").trim() + ".py"
    write_file(tmp_py, PAYLOAD)
    let cmd = "/usr/bin/perl -e 'alarm 120; exec @ARGV' /usr/bin/python3 '" + tmp_py + "' '" + mode + "' 2>&1; rm -f '" + tmp_py + "'"
    print(exec(cmd))
}

run()
