// airgenome/modules/filters/data/calendar_event_shbf.hexa
//   CA1 — Calendar Event Sorted-Blob Bisect Filter (CESF).
//
//   목적: ~/Library/Calendars/Calendar.sqlitedb 의 CalendarItem (event row) 를
//         매번 sqlite3 query + linear time-range scan 하던 hot path 를,
//         start_ts 정렬 단일 mmap blob 으로 치환. 시간 범위 query O(log n) 로 즉답.
//
//   E4/F18 reference 와 차이:
//     - axis = time-range bisect (URL prefix bisect 가 아닌 numeric 범위)
//     - sort key = start_ts (i64 epoch seconds)
//     - secondary = title pool (offset+len, 정렬 X — start_ts row 와 1:1)
//     - bisect_left(start_ts, lo) ~ bisect_right(start_ts, hi) → range
//
//   blob layout (little-endian):
//     magic   : 4B  "CESF"          (Calendar Event Sorted Filter)
//     version : 4B  u32             (1)
//     n       : 4B  u32             event 개수
//     str_sz  : 4B  u32             title pool 바이트 길이
//     [n*4]   : u32 ROWID           Calendar row id (debug / RRule join key)
//     [n*8]   : i64 start_ts        epoch seconds (정렬됨 ↑)
//     [n*8]   : i64 end_ts          epoch seconds
//     [n*4]   : u32 title_offsets   pool 내 title 오프셋
//     [n*4]   : u32 title_lens      title 길이
//     [str_sz]: utf-8 string pool   raw bytes (NUL 없음)
//
// 모드:
//   encode : Calendar.sqlitedb → /tmp/calendar_event.bin
//   bench  : encode + sqlite3 query + linear scan vs blob mmap + bisect (100 range query)
//
// macOS path probe (Calendar):
//   primary  : ~/Library/Calendars/Calendar.sqlitedb
//   fallback : ~/Library/Application Support/CalendarServer/  (dir, hostbased)
//   absent   : synth fallback (5000 events / 365 day window)
//
// R1 HEXA-FIRST: 신규 .py/.sh 금지. 인라인 python3 페이로드.
// R17: /usr/bin/perl alarm 120s wrapper. /usr/bin/python3 절대경로. try/catch 0.

let PAYLOAD = "import sys,os,sqlite3,tempfile,struct,time,bisect,resource,mmap,array,random\n" +
"mode=sys.argv[1]; src=sys.argv[2]\n" +
"BIN='/tmp/calendar_event.bin'\n" +
"\n" +
"def fmt(b):\n" +
"    if b>1048576: return f'{b/1048576:.2f}MB'\n" +
"    if b>1024: return f'{b/1024:.1f}KB'\n" +
"    return f'{b}B'\n" +
"def rss():\n" +
"    r=resource.getrusage(resource.RUSAGE_SELF).ru_maxrss\n" +
"    if sys.platform=='darwin': return r\n" +
"    return r*1024\n" +
"\n" +
"def safe_copy(src):\n" +
"    tmp=tempfile.NamedTemporaryFile(suffix='.sqlite',delete=False); tmp.close()\n" +
"    with open(src,'rb') as fr, open(tmp.name,'wb') as fw:\n" +
"        fw.write(fr.read())\n" +
"    return tmp.name\n" +
"\n" +
"def synth(n=5000,seed=42):\n" +
"    rng=random.Random(seed)\n" +
"    base=int(time.time())-86400*180\n" +
"    rows=[]\n" +
"    for i in range(n):\n" +
"        s=base+rng.randrange(86400*365)\n" +
"        e=s+rng.choice([900,1800,3600,5400])\n" +
"        rows.append((i+1,s,e,f'event-{i}-{rng.randrange(9999)}'))\n" +
"    return rows\n" +
"\n" +
"def load_events(src):\n" +
"    if not os.path.exists(src): return synth()\n" +
"    if os.path.isdir(src): return synth()\n" +
"    copy=safe_copy(src)\n" +
"    rows=[]\n" +
"    con=sqlite3.connect(copy); cur=con.cursor()\n" +
"    cur.execute(\"SELECT name FROM sqlite_master WHERE type='table'\")\n" +
"    tables=set(r[0] for r in cur.fetchall())\n" +
"    if 'CalendarItem' in tables:\n" +
"        # CalendarItem schema (macOS 14+): ROWID, summary, start_date, end_date (CFAbsoluteTime)\n" +
"        cur.execute('PRAGMA table_info(CalendarItem)')\n" +
"        cols=set(c[1] for c in cur.fetchall())\n" +
"        sc='start_date' if 'start_date' in cols else 'startDate' if 'startDate' in cols else None\n" +
"        ec='end_date' if 'end_date' in cols else 'endDate' if 'endDate' in cols else None\n" +
"        tc='summary' if 'summary' in cols else 'title' if 'title' in cols else None\n" +
"        if sc and ec and tc:\n" +
"            cfb=978307200  # CFAbsoluteTime epoch (2001-01-01) → unix epoch\n" +
"            cur.execute(f'SELECT ROWID,{sc},{ec},{tc} FROM CalendarItem WHERE {sc} IS NOT NULL')\n" +
"            for rid,s,e,t in cur.fetchall():\n" +
"                if s is None or e is None: continue\n" +
"                # CFAbsoluteTime float → unix int\n" +
"                ss=int(float(s)+cfb); ee=int(float(e)+cfb)\n" +
"                if ee<ss: ee=ss\n" +
"                rows.append((int(rid),ss,ee,(t or '')[:128]))\n" +
"    con.close(); os.unlink(copy)\n" +
"    if not rows: return synth()\n" +
"    return rows\n" +
"\n" +
"def encode(rows):\n" +
"    rows=sorted(rows,key=lambda r:r[1])\n" +
"    n=len(rows)\n" +
"    pool=bytearray()\n" +
"    rids=array.array('I',[0]*n)\n" +
"    starts=array.array('q',[0]*n)\n" +
"    ends  =array.array('q',[0]*n)\n" +
"    toffs =array.array('I',[0]*n)\n" +
"    tlens =array.array('I',[0]*n)\n" +
"    for i,(rid,s,e,t) in enumerate(rows):\n" +
"        tb=t.encode('utf-8','replace')\n" +
"        rids[i]=int(rid)&0xffffffff\n" +
"        starts[i]=int(s); ends[i]=int(e)\n" +
"        toffs[i]=len(pool); tlens[i]=len(tb)\n" +
"        pool.extend(tb)\n" +
"    header=struct.pack('<4sIII',b'CESF',1,n,len(pool))\n" +
"    with open(BIN,'wb') as f:\n" +
"        f.write(header)\n" +
"        f.write(rids.tobytes())\n" +
"        f.write(starts.tobytes()); f.write(ends.tobytes())\n" +
"        f.write(toffs.tobytes()); f.write(tlens.tobytes())\n" +
"        f.write(pool)\n" +
"    return {'n':n,'blob_size':os.path.getsize(BIN),'rows':rows,'starts':starts}\n" +
"\n" +
"class Blob:\n" +
"    def __init__(self,path):\n" +
"        self.f=open(path,'rb')\n" +
"        self.mm=mmap.mmap(self.f.fileno(),0,prot=mmap.PROT_READ)\n" +
"        magic,ver,n,pool_sz=struct.unpack_from('<4sIII',self.mm,0)\n" +
"        assert magic==b'CESF' and ver==1\n" +
"        self.n=n\n" +
"        base=16\n" +
"        rids_off=base\n" +
"        starts_off=rids_off+4*n\n" +
"        ends_off=starts_off+8*n\n" +
"        toffs_off=ends_off+8*n\n" +
"        tlens_off=toffs_off+4*n\n" +
"        pool_off=tlens_off+4*n\n" +
"        mv=memoryview(self.mm)\n" +
"        self.starts=array.array('q'); self.starts.frombytes(bytes(mv[starts_off:starts_off+8*n]))\n" +
"        self.ends=array.array('q'); self.ends.frombytes(bytes(mv[ends_off:ends_off+8*n]))\n" +
"        self.toffs=array.array('I'); self.toffs.frombytes(bytes(mv[toffs_off:toffs_off+4*n]))\n" +
"        self.tlens=array.array('I'); self.tlens.frombytes(bytes(mv[tlens_off:tlens_off+4*n]))\n" +
"        self.pool=bytes(mv[pool_off:pool_off+pool_sz])\n" +
"        self.mv=mv\n" +
"    def range_count(self,lo,hi):\n" +
"        a=bisect.bisect_left(self.starts,lo)\n" +
"        b=bisect.bisect_right(self.starts,hi)\n" +
"        return b-a\n" +
"    def close(self):\n" +
"        self.mm.close(); self.f.close()\n" +
"\n" +
"def linear_range(rows,lo,hi):\n" +
"    c=0\n" +
"    for _,s,_,_ in rows:\n" +
"        if lo<=s<=hi: c+=1\n" +
"    return c\n" +
"\n" +
"def bench(src):\n" +
"    rows=load_events(src)\n" +
"    t0=time.perf_counter_ns()\n" +
"    info=encode(rows)\n" +
"    t1=time.perf_counter_ns()\n" +
"    print(f'[encode] {(t1-t0)/1e6:.1f} ms  events={info[\"n\"]}  blob={fmt(info[\"blob_size\"])}')\n" +
"    if info['n']==0:\n" +
"        print('[bench] no events — skip'); return\n" +
"    b=Blob(BIN)\n" +
"    rng=random.Random(7)\n" +
"    starts=info['starts']\n" +
"    lo0=int(starts[0]); hi0=int(starts[-1])\n" +
"    samples=[]\n" +
"    for _ in range(100):\n" +
"        a=rng.randrange(lo0,hi0); w=rng.choice([3600,86400,86400*7,86400*30])\n" +
"        samples.append((a,a+w))\n" +
"    rss_blob=rss()\n" +
"    for lo,hi in samples[:5]: b.range_count(lo,hi)\n" +
"    t0=time.perf_counter_ns()\n" +
"    bh=0\n" +
"    for lo,hi in samples: bh+=b.range_count(lo,hi)\n" +
"    t1=time.perf_counter_ns()\n" +
"    blob_us=(t1-t0)/1000/len(samples)\n" +
"    t0=time.perf_counter_ns()\n" +
"    lh=0\n" +
"    for lo,hi in samples: lh+=linear_range(rows,lo,hi)\n" +
"    t1=time.perf_counter_ns()\n" +
"    lin_us=(t1-t0)/1000/len(samples)\n" +
"    b.close()\n" +
"    print(f'[query] 100 time-range count  (hits blob={bh} linear={lh})')\n" +
"    print(f'  linear scan       : {lin_us:10.1f} us')\n" +
"    print(f'  blob mmap+bisect  : {blob_us:10.1f} us')\n" +
"    if blob_us>0:\n" +
"        print(f'  speedup           : {lin_us/blob_us:6.1f}x')\n" +
"    print(f'[rss] {fmt(rss_blob)}')\n" +
"\n" +
"if mode=='encode':\n" +
"    rows=load_events(src)\n" +
"    info=encode(rows)\n" +
"    print(f'encoded {info[\"n\"]} events → {BIN} ({fmt(info[\"blob_size\"])})')\n" +
"elif mode=='bench':\n" +
"    bench(src)\n" +
"else:\n" +
"    print('usage: encode|bench <Calendar.sqlitedb>'); sys.exit(2)\n"

fn run() {
    let argv = args()
    let mut mode = "bench"
    let mut target = ""
    let mut i = 0
    while i < len(argv) {
        let v = argv[i]
        let is_hexa_bin = v.contains("/hexa-lang/") || v == "hexa" || v == "hexa.real"
        let is_self     = v.contains("calendar_event_shbf")
        if is_hexa_bin == false && is_self == false {
            if v == "encode" || v == "bench" { mode = v }
            else if v.contains(".sqlitedb") || v.contains("Calendar") { target = v }
        }
        i = i + 1
    }
    if len(target) == 0 {
        target = env("HOME") + "/Library/Calendars/Calendar.sqlitedb"
        println("(default target: " + target + ")")
    }
    let tmp_py = "/tmp/calendar_event_shbf_" + exec("date +%s%N").trim() + ".py"
    write_file(tmp_py, PAYLOAD)
    let cmd = "/usr/bin/perl -e 'alarm 120; exec @ARGV' /usr/bin/python3 '" + tmp_py + "' '" + mode + "' '" + target + "' 2>&1; rm -f '" + tmp_py + "'"
    let result = exec(cmd)
    print(result)
}

run()
