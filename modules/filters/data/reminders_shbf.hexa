// airgenome/modules/filters/data/reminders_shbf.hexa
//   SY4 — Reminders.app SHBF (RMBF — Reminders Blob Filter).
//
//   목적: Reminders.app 데이터 (Group Container — group.com.apple.reminders 의
//         Container/RemindersData) 의 (reminder_title, due_ts) 를 mmap blob.
//         title prefix + due_ts 정렬 즉답.
//
//   blob layout (little-endian):
//     magic   : 4B  "RMBF"          (Reminders Blob Filter)
//     version : 4B  u32             (1)
//     n       : 4B  u32             reminder 개수
//     str_sz  : 4B  u32             string pool 바이트 길이
//     [n*4]   : u32 t_off           title pool 시작 (정렬된 title 순)
//     [n*4]   : u32 t_len           title 길이
//     [n*8]   : u64 due_ts_us       Cocoa→unix us
//     [str_sz]: utf-8 string pool   raw bytes (NUL 없음)
//
//   query: title prefix bisect_left → range → due_ts 오름차순 top-K.
//
// 모드:
//   encode <reminders.sqlite | __SYNTH__> : → /tmp/reminders_rmbf.bin
//   bench  <...> : encode + linear scan vs RMBF mmap+bisect
//
// E4/F18 와 다른 점:
//   - source = group.com.apple.reminders Group Container 내 sqlite (RemindersData
//     CoreData store) — schema 비공개. probe 후 실패 시 synthetic fallback.
//   - TCC Reminders 권한 필요 (Tahoe-26 부터 별도 prompt).
//
// R1 HEXA-FIRST: 인라인 python3 페이로드 (.py 신규 없음). raw 9 hexa-only.
// R17: /usr/bin/perl alarm 120s wrapper. try/catch 0.

let PAYLOAD = "import sys,os,sqlite3,struct,time,bisect,heapq,resource,mmap,array,random,tempfile,glob\n" +
"mode=sys.argv[1]; src=sys.argv[2]\n" +
"BIN='/tmp/reminders_rmbf.bin'\n" +
"\n" +
"def fmt(b):\n" +
"    if b>1048576: return f'{b/1048576:.2f}MB'\n" +
"    if b>1024: return f'{b/1024:.1f}KB'\n" +
"    return f'{b}B'\n" +
"def rss():\n" +
"    r=resource.getrusage(resource.RUSAGE_SELF).ru_maxrss\n" +
"    if sys.platform=='darwin': return r\n" +
"    return r*1024\n" +
"def to_int_safe(v):\n" +
"    if v is None: return 0\n" +
"    if isinstance(v,int): return v\n" +
"    if isinstance(v,float): return int(v)\n" +
"    if isinstance(v,str) and v.isdigit(): return int(v)\n" +
"    return 0\n" +
"\n" +
"SYNTH_MARK='__SYNTH__'\n" +
"VERBS=['Buy','Call','Email','Read','Write','Review','Submit','Schedule','Pick up','Renew']\n" +
"NOUNS=['groceries','dentist','manager','book','draft','PR','expense','flight','laundry','license']\n" +
"def synth_rows(n=1200):\n" +
"    rng=random.Random(42)\n" +
"    now=int(time.time()*1e6)\n" +
"    out=[]\n" +
"    for i in range(n):\n" +
"        v=VERBS[i%len(VERBS)]\n" +
"        nn=NOUNS[(i//7)%len(NOUNS)]\n" +
"        t=f'{v} {nn} #{i:04d}'\n" +
"        due=now+(i-300)*3600_000_000\n" +
"        out.append((t,due))\n" +
"    return out\n" +
"\n" +
"def safe_copy_sqlite(src):\n" +
"    tmp=tempfile.NamedTemporaryFile(suffix='.sqlite',delete=False); tmp.close()\n" +
"    sc=sqlite3.connect(f'file:{src}?mode=ro',uri=True)\n" +
"    dc=sqlite3.connect(tmp.name)\n" +
"    sc.backup(dc); dc.close(); sc.close()\n" +
"    return tmp.name\n" +
"\n" +
"def discover_db(src):\n" +
"    if os.path.exists(src) and src.endswith(('.sqlite','.db')):\n" +
"        return src\n" +
"    home=os.path.expanduser('~')\n" +
"    pats=[\n" +
"      home+'/Library/Group Containers/group.com.apple.reminders/Container_v?/Stores/*.sqlite',\n" +
"      home+'/Library/Group Containers/group.com.apple.reminders/**/*.sqlite',\n" +
"    ]\n" +
"    for p in pats:\n" +
"        for x in glob.glob(p,recursive=True):\n" +
"            return x\n" +
"    return None\n" +
"\n" +
"def load_real(path):\n" +
"    copy=safe_copy_sqlite(path)\n" +
"    conn=sqlite3.connect(copy)\n" +
"    rows=[]\n" +
"    tables=[r[0] for r in conn.execute(\"SELECT name FROM sqlite_master WHERE type='table'\")]\n" +
"    for t in tables:\n" +
"        cols=[r[1] for r in conn.execute(f'PRAGMA table_info(\"{t}\")')]\n" +
"        title_col=None; due_col=None\n" +
"        for c in cols:\n" +
"            cl=c.lower()\n" +
"            if title_col is None and ('title' in cl or 'name' in cl or 'summary' in cl): title_col=c\n" +
"            if due_col is None and ('due' in cl or 'date' in cl): due_col=c\n" +
"        if title_col is None: continue\n" +
"        sel=f'SELECT \"{title_col}\"' + (f',\"{due_col}\"' if due_col else ',NULL') + f' FROM \"{t}\"'\n" +
"        for r in conn.execute(sel):\n" +
"            tv=r[0]; dv=r[1]\n" +
"            if not isinstance(tv,str) or not tv.strip(): continue\n" +
"            due=int(float(dv)*1e6) if isinstance(dv,(int,float)) else 0\n" +
"            rows.append((tv.strip(),due))\n" +
"        if rows: break\n" +
"    conn.close(); os.unlink(copy)\n" +
"    if not rows: return synth_rows(1200),True\n" +
"    return rows,False\n" +
"\n" +
"def encode_rows(rows):\n" +
"    rows=sorted(rows,key=lambda r:r[0])\n" +
"    n=len(rows)\n" +
"    pool=bytearray()\n" +
"    t_off=array.array('I',[0]*n); t_len=array.array('I',[0]*n)\n" +
"    due=array.array('Q',[0]*n)\n" +
"    for i,(t,d) in enumerate(rows):\n" +
"        tb=t.encode('utf-8','replace')\n" +
"        t_off[i]=len(pool); t_len[i]=len(tb); pool.extend(tb)\n" +
"        due[i]=int(d)&0xffffffffffffffff\n" +
"    header=struct.pack('<4sIII',b'RMBF',1,n,len(pool))\n" +
"    with open(BIN,'wb') as f:\n" +
"        f.write(header)\n" +
"        f.write(t_off.tobytes()); f.write(t_len.tobytes())\n" +
"        f.write(due.tobytes()); f.write(pool)\n" +
"    return n,os.path.getsize(BIN)\n" +
"\n" +
"def encode(src):\n" +
"    t0=time.perf_counter()\n" +
"    db=None if src==SYNTH_MARK else discover_db(src)\n" +
"    if db is None:\n" +
"        rows=synth_rows(1200); synth=True\n" +
"    else:\n" +
"        rows,synth=load_real(db)\n" +
"    n,bsz=encode_rows(rows)\n" +
"    t1=time.perf_counter()\n" +
"    return {'encode_s':t1-t0,'n':n,'blob_size':bsz,'synth':synth,'rows':rows}\n" +
"\n" +
"class Blob:\n" +
"    def __init__(self,path):\n" +
"        self.f=open(path,'rb')\n" +
"        self.mm=mmap.mmap(self.f.fileno(),0,prot=mmap.PROT_READ)\n" +
"        magic,ver,n,pool_sz=struct.unpack_from('<4sIII',self.mm,0)\n" +
"        assert magic==b'RMBF' and ver==1\n" +
"        self.n=n; self.pool_sz=pool_sz\n" +
"        base=16\n" +
"        t_off_off=base\n" +
"        t_len_off=base+4*n\n" +
"        due_off  =base+8*n\n" +
"        self.pool_off=base+8*n+8*n\n" +
"        self.mv=memoryview(self.mm)\n" +
"        t_off=array.array('I'); t_off.frombytes(bytes(self.mv[t_off_off:t_off_off+4*n]))\n" +
"        t_len=array.array('I'); t_len.frombytes(bytes(self.mv[t_len_off:t_len_off+4*n]))\n" +
"        due=array.array('Q'); due.frombytes(bytes(self.mv[due_off:due_off+8*n]))\n" +
"        pool=bytes(self.mv[self.pool_off:self.pool_off+pool_sz])\n" +
"        self.titles=[pool[t_off[i]:t_off[i]+t_len[i]] for i in range(n)]\n" +
"        self.due=due\n" +
"    def prefix_topk(self,prefix,k=10):\n" +
"        pb=prefix.encode('utf-8') if isinstance(prefix,str) else prefix\n" +
"        s=bisect.bisect_left(self.titles,pb)\n" +
"        e=bisect.bisect_left(self.titles,pb+b'\\xff\\xff\\xff\\xff')\n" +
"        if e==s: return []\n" +
"        if e-s<=k: idxs=list(range(s,e))\n" +
"        else: idxs=heapq.nsmallest(k,range(s,e),key=lambda i:self.due[i])\n" +
"        idxs.sort(key=lambda i:self.due[i])\n" +
"        return [(self.titles[i].decode('utf-8','replace'),int(self.due[i])) for i in idxs]\n" +
"    def close(self):\n" +
"        self.mv.release(); self.mm.close(); self.f.close()\n" +
"\n" +
"def bench(src):\n" +
"    info=encode(src)\n" +
"    tag=' (synth fallback)' if info['synth'] else ''\n" +
"    print(f'[encode] {info[\"encode_s\"]*1000:.1f} ms  reminders={info[\"n\"]}  blob={fmt(info[\"blob_size\"])}{tag}')\n" +
"    if info['n']==0:\n" +
"        print('[bench] empty — skip'); return\n" +
"    rows=info['rows']\n" +
"    b=Blob(BIN)\n" +
"    rng=random.Random(42)\n" +
"    samples=[]\n" +
"    for _ in range(100):\n" +
"        i=rng.randrange(b.n)\n" +
"        u=b.titles[i].decode('utf-8','replace')\n" +
"        plen=rng.choice([2,3,4])\n" +
"        samples.append(u[:plen] if len(u)>=plen else u)\n" +
"    for p in samples[:5]: b.prefix_topk(p,10)\n" +
"    t0=time.perf_counter()\n" +
"    blob_hits=0\n" +
"    for p in samples:\n" +
"        blob_hits+=len(b.prefix_topk(p,10))\n" +
"    t1=time.perf_counter()\n" +
"    blob_us=(t1-t0)*1e6/len(samples)\n" +
"    rss_blob=rss()\n" +
"    b.close()\n" +
"    rows_sorted=sorted(rows,key=lambda r:r[0])\n" +
"    t0=time.perf_counter()\n" +
"    lin_hits=0\n" +
"    for p in samples:\n" +
"        for (t,d) in rows_sorted:\n" +
"            if t.startswith(p): lin_hits+=1\n" +
"    t1=time.perf_counter()\n" +
"    lin_us=(t1-t0)*1e6/len(samples)\n" +
"    print(f'[query] 100 prefix-topK-10 (blob={blob_hits} linear={lin_hits})')\n" +
"    print(f'  linear scan          : {lin_us:10.1f} us')\n" +
"    print(f'  blob mmap + bisect   : {blob_us:10.1f} us')\n" +
"    if blob_us>0: print(f'  speedup: {lin_us/blob_us:6.1f}x')\n" +
"    print(f'[rss] blob loaded: {fmt(rss_blob)}')\n" +
"\n" +
"if mode=='encode':\n" +
"    info=encode(src)\n" +
"    print(f'encoded {info[\"n\"]} reminders in {info[\"encode_s\"]*1000:.1f} ms → {BIN} ({fmt(info[\"blob_size\"])})' + (' synth' if info['synth'] else ''))\n" +
"elif mode=='bench':\n" +
"    bench(src)\n" +
"else:\n" +
"    print('usage: encode|bench <reminders.sqlite|__SYNTH__>'); sys.exit(2)\n"

fn run() {
    let argv = args()
    let mut mode = "bench"
    let mut target = ""
    let mut i = 0
    while i < len(argv) {
        let v = argv[i]
        let is_hexa_bin = v.contains("/hexa-lang/") || v == "hexa" || v == "hexa.real"
        let is_self     = v.contains("reminders_shbf")
        if is_hexa_bin == false && is_self == false {
            if v == "encode" || v == "bench" { mode = v }
            else if v.contains(".sqlite") || v.contains(".db") { target = v }
        }
        i = i + 1
    }
    if len(target) == 0 {
        target = env("HOME") + "/Library/Group Containers/group.com.apple.reminders"
        println("(default target: " + target + " — discover sqlite by glob)")
    }
    let tmp_py = "/tmp/reminders_shbf_" + exec("date +%s%N").trim() + ".py"
    write_file(tmp_py, PAYLOAD)
    let cmd = "/usr/bin/perl -e 'alarm 120; exec @ARGV' /usr/bin/python3 '" + tmp_py + "' '" + mode + "' '" + target + "' 2>&1; rm -f '" + tmp_py + "'"
    let result = exec(cmd)
    print(result)
}

run()
