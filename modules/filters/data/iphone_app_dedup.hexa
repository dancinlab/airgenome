// airgenome/modules/filters/data/iphone_app_dedup.hexa
//   IB2 — iOS Backup blob content-hash dedup filter (J. wave, 2/2).
//
//   목적: ~/Library/Application Support/MobileSync/Backup/<UDID>/<2-hex>/<sha1>
//         blob 들 head-64KB content-hash (blake2b digest_size=8, key=size_u64) →
//         u64 sorted blob (IBDD magic) → 동일 content 의 dup_count + 절감 byte
//         quantification. T2 telegram_media_dedup pattern (TMDD) 직접 transpose.
//
//   blob layout (little-endian):
//     magic     : 4B  "IBDD"
//     version   : 4B  u32 (1)
//     n_uniq    : 4B  u32 unique content hash count
//     reserved  : 4B  u32 (0)
//     [n*8]     : u64 hashes      blake2b-64 head-64KB (sorted asc)
//     [n*4]     : u32 sizes       per-content size (u32 sat 0xffffffff)
//     [n*4]     : u32 dup_count   total occurrences (1=uniq)
//
// 모드:
//   encode : Backup blob → /tmp/iphone_app_dedup.bin
//   bench  : encode + 디스크 절감 추정 + 1000 hash lookup (linear vs bisect)
//
// 절대 금지: Backup blob mutation 0 (os.lstat + read-only open),
//   launchctl 0, git commit 0, hard-link 0 (operator-side, out of scope).
//   backup absent → 5000 row synth fallback (seed=29, 30% planted dup).
// raw#9 hexa-only · raw#11 snake_case · raw#17 perl alarm 120s · /usr/bin/python3.

let PAYLOAD = "import sys,os,struct,time,bisect,array,hashlib,glob,resource,mmap,random\n" +
"mode=sys.argv[1] if len(sys.argv)>1 else 'bench'\n" +
"BIN='/tmp/iphone_app_dedup.bin'\n" +
"HOME=os.path.expanduser('~')\n" +
"BACKUP_ROOT=os.path.join(HOME,'Library','Application Support','MobileSync','Backup')\n" +
"HEAD_BYTES=65536\n" +
"MAX_FILES=20000\n" +
"SYNTH_N=5000\n" +
"SYNTH_SEED=29\n" +
"DUP_RATE=0.30\n" +
"\n" +
"def fmt(b):\n" +
"    if b>1073741824: return f'{b/1073741824:.2f}GB'\n" +
"    if b>1048576: return f'{b/1048576:.2f}MB'\n" +
"    if b>1024: return f'{b/1024:.1f}KB'\n" +
"    return f'{b}B'\n" +
"def rss():\n" +
"    r=resource.getrusage(resource.RUSAGE_SELF).ru_maxrss\n" +
"    if sys.platform=='darwin': return r\n" +
"    return r*1024\n" +
"\n" +
"def wyh64(b,sz):\n" +
"    h=hashlib.blake2b(b,digest_size=8,key=struct.pack('<Q',sz&0xffffffffffffffff)).digest()\n" +
"    return struct.unpack('<Q',h)[0]\n" +
"\n" +
"def find_backup_udid_dirs():\n" +
"    if not os.path.isdir(BACKUP_ROOT): return []\n" +
"    out=[]\n" +
"    for name in os.listdir(BACKUP_ROOT):\n" +
"        full=os.path.join(BACKUP_ROOT,name)\n" +
"        if not os.path.isdir(full): continue\n" +
"        if name.startswith('.'): continue\n" +
"        # iOS UDID dirs contain 2-hex prefix subdirs like 00/, 01/, ..., ff/\n" +
"        try: subs=os.listdir(full)\n" +
"        except OSError: continue\n" +
"        hexdirs=[s for s in subs if len(s)==2 and all(c in '0123456789abcdef' for c in s)]\n" +
"        if hexdirs: out.append(full)\n" +
"    return out\n" +
"\n" +
"def harvest_blobs(udid_dir):\n" +
"    files=[]\n" +
"    for prefix in os.listdir(udid_dir):\n" +
"        if len(prefix)!=2: continue\n" +
"        sub=os.path.join(udid_dir,prefix)\n" +
"        if not os.path.isdir(sub): continue\n" +
"        for name in os.listdir(sub):\n" +
"            full=os.path.join(sub,name)\n" +
"            try: st=os.lstat(full)\n" +
"            except OSError: continue\n" +
"            if not (st.st_mode & 0o170000)==0o100000: continue  # regular files only\n" +
"            if st.st_size<=0: continue\n" +
"            files.append((full,st.st_size))\n" +
"            if len(files)>=MAX_FILES: return files\n" +
"    return files\n" +
"\n" +
"def synth_files(n=SYNTH_N,seed=SYNTH_SEED):\n" +
"    rng=random.Random(seed)\n" +
"    out=[]\n" +
"    for i in range(n):\n" +
"        if i>0 and rng.random()<DUP_RATE:\n" +
"            j=rng.randrange(i); out.append(out[j])\n" +
"        else:\n" +
"            sz=rng.choice([512,2048,8192,16384,32768,65536,131072])\n" +
"            payload=bytes(rng.randrange(256) for _ in range(min(sz,256)))\n" +
"            out.append(('synth-'+str(i),sz,payload))\n" +
"    return out\n" +
"\n" +
"def hash_files(files):\n" +
"    seen={}\n" +
"    total_bytes=0\n" +
"    is_synth=files and isinstance(files[0],tuple) and len(files[0])==3\n" +
"    for item in files:\n" +
"        if is_synth:\n" +
"            name,sz,payload=item\n" +
"            head=payload[:HEAD_BYTES]\n" +
"        else:\n" +
"            full,sz=item\n" +
"            try:\n" +
"                f=open(full,'rb')\n" +
"                head=f.read(HEAD_BYTES); f.close()\n" +
"            except OSError: continue\n" +
"        h=wyh64(head,sz)\n" +
"        total_bytes+=sz\n" +
"        cur=seen.get(h)\n" +
"        if cur is None: seen[h]=[sz,1]\n" +
"        else: cur[1]+=1\n" +
"    return seen,total_bytes,len(files)\n" +
"\n" +
"def encode():\n" +
"    udid_dirs=find_backup_udid_dirs()\n" +
"    source='real'\n" +
"    files=[]\n" +
"    if udid_dirs:\n" +
"        files=harvest_blobs(udid_dirs[0])\n" +
"        source=udid_dirs[0]\n" +
"    if not files:\n" +
"        files=synth_files()\n" +
"        source='synthetic'\n" +
"    t0=time.perf_counter_ns()\n" +
"    seen,total_bytes,total_n=hash_files(files)\n" +
"    items=sorted(seen.items(),key=lambda kv:kv[0])\n" +
"    n=len(items)\n" +
"    hashes=array.array('Q',[h for h,_ in items])\n" +
"    sizes =array.array('I',[min(meta[0],0xffffffff) for _,meta in items])\n" +
"    dups  =array.array('I',[meta[1]&0xffffffff for _,meta in items])\n" +
"    header=struct.pack('<4sIII',b'IBDD',1,n,0)\n" +
"    with open(BIN,'wb') as f:\n" +
"        f.write(header)\n" +
"        f.write(hashes.tobytes()); f.write(sizes.tobytes()); f.write(dups.tobytes())\n" +
"    t1=time.perf_counter_ns()\n" +
"    saving=sum(int(sizes[i])*(int(dups[i])-1) for i in range(n))\n" +
"    return {'encode_ns':t1-t0,'n_total':total_n,'n_uniq':n,'total_bytes':total_bytes,'saving':saving,'blob_size':os.path.getsize(BIN),'source':source,'hashes':hashes,'sizes':sizes,'dups':dups}\n" +
"\n" +
"class DedupBlob:\n" +
"    def __init__(self,path):\n" +
"        self.f=open(path,'rb')\n" +
"        self.mm=mmap.mmap(self.f.fileno(),0,prot=mmap.PROT_READ)\n" +
"        magic,ver,n,_=struct.unpack_from('<4sIII',self.mm,0)\n" +
"        if magic!=b'IBDD' or ver!=1:\n" +
"            raise ValueError(f'bad magic/ver: {magic} {ver}')\n" +
"        self.n=n\n" +
"        base=16\n" +
"        mv=memoryview(self.mm)\n" +
"        self.hashes=array.array('Q'); self.hashes.frombytes(bytes(mv[base:base+8*n]))\n" +
"        self.sizes =array.array('I'); self.sizes.frombytes(bytes(mv[base+8*n:base+12*n]))\n" +
"        self.dups  =array.array('I'); self.dups.frombytes(bytes(mv[base+12*n:base+16*n]))\n" +
"        self.mv=mv\n" +
"    def lookup_bisect(self,h):\n" +
"        i=bisect.bisect_left(self.hashes,h)\n" +
"        if i<self.n and self.hashes[i]==h: return (int(self.sizes[i]),int(self.dups[i]))\n" +
"        return None\n" +
"    def lookup_linear(self,h):\n" +
"        for i in range(self.n):\n" +
"            if self.hashes[i]==h: return (int(self.sizes[i]),int(self.dups[i]))\n" +
"        return None\n" +
"    def close(self):\n" +
"        try: self.mv.release()\n" +
"        except Exception: pass\n" +
"        self.mm.close(); self.f.close()\n" +
"\n" +
"def bench():\n" +
"    info=encode()\n" +
"    src_tag='SYNTH' if info['source']=='synthetic' else 'REAL'\n" +
"    print(f'[encode] {info[\"encode_ns\"]/1e6:.1f}ms  total={info[\"n_total\"]}  uniq={info[\"n_uniq\"]}  blob={fmt(info[\"blob_size\"])}  source={info[\"source\"]}')\n" +
"    if info['n_total']>0:\n" +
"        dup_pct=100*(info['n_total']-info['n_uniq'])/info['n_total']\n" +
"        sav_pct=100*info['saving']/max(info['total_bytes'],1)\n" +
"        print(f'[dedup] dup_count={info[\"n_total\"]-info[\"n_uniq\"]} ({dup_pct:.1f}%)  total={fmt(info[\"total_bytes\"])}  saving={fmt(info[\"saving\"])} ({sav_pct:.1f}%)')\n" +
"    if info['n_uniq']==0:\n" +
"        print('[bench] no uniq — skip query phase'); return\n" +
"    b=DedupBlob(BIN)\n" +
"    rng=random.Random(13)\n" +
"    Q=1000\n" +
"    queries=[int(b.hashes[rng.randrange(b.n)]) for _ in range(Q)]\n" +
"    rss_blob=rss()\n" +
"    for q in queries[:5]: b.lookup_bisect(q); b.lookup_linear(q)  # warm\n" +
"    t0=time.perf_counter_ns(); h_lin=0\n" +
"    for q in queries:\n" +
"        if b.lookup_linear(q) is not None: h_lin+=1\n" +
"    t1=time.perf_counter_ns(); lin_ns=t1-t0; per_lin=lin_ns//Q\n" +
"    t0=time.perf_counter_ns(); h_bi=0\n" +
"    for q in queries:\n" +
"        if b.lookup_bisect(q) is not None: h_bi+=1\n" +
"    t1=time.perf_counter_ns(); bi_ns=t1-t0; per_bi=bi_ns//Q\n" +
"    print(f'  hash lookup OLD (linear scan)       : {per_lin:10d} ns/query  hits={h_lin}')\n" +
"    print(f'  hash lookup NEW (blob mmap+bisect)  : {per_bi:10d} ns/query  hits={h_bi}')\n" +
"    if per_bi>0: print(f'  lookup speedup={per_lin/per_bi:.1f}x  saved={((per_lin-per_bi)*100)//max(per_lin,1)}%')\n" +
"    print(f'[lossless] hits equal: {h_lin==h_bi}')\n" +
"    print(f'[rss] after blob: {fmt(rss_blob)}')\n" +
"    print(f'  5-tuple: site=IB2 ROI#=ibdd baseline_ns={per_lin} post_ns={per_bi} diff_test=lossless src={src_tag}')\n" +
"    b.close()\n" +
"\n" +
"if mode=='encode':\n" +
"    info=encode()\n" +
"    print(f'encoded {info[\"n_uniq\"]}/{info[\"n_total\"]} uniq blobs in {info[\"encode_ns\"]/1e6:.1f}ms → {BIN} ({fmt(info[\"blob_size\"])}, saving={fmt(info[\"saving\"])}, source={info[\"source\"]})')\n" +
"elif mode=='bench':\n" +
"    bench()\n" +
"else:\n" +
"    print('usage: encode|bench'); sys.exit(2)\n"

fn run() {
    let argv = args()
    let mut mode = "bench"
    let mut i = 0
    while i < len(argv) {
        let v = argv[i]
        let is_hexa_bin = v.contains("/hexa-lang/") || v == "hexa" || v == "hexa.real"
        let is_self     = v.contains("iphone_app_dedup")
        if is_hexa_bin == false && is_self == false {
            if v == "encode" || v == "bench" { mode = v }
        }
        i = i + 1
    }
    let tmp_py = "/tmp/iphone_app_dedup_" + exec("date +%s%N").trim() + ".py"
    write_file(tmp_py, PAYLOAD)
    let cmd = "/usr/bin/perl -e 'alarm 120; exec @ARGV' /usr/bin/python3 '" + tmp_py + "' '" + mode + "' 2>&1; rm -f '" + tmp_py + "'"
    let result = exec(cmd)
    print(result)
}

run()
