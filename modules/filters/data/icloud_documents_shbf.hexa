// airgenome/modules/filters/data/icloud_documents_shbf.hexa
//   CL3 — iCloud Documents Sorted-Blob bisect Filter (ICDF).
//
//   목적: ~/Library/Mobile Documents/ (iCloud Drive local cache) 의
//         locally-cached file path 를 매번 os.walk + lstat traversal
//         하던 hot-path 를 path 정렬 단일 mmap blob 으로 치환.
//         per-app dict header 로 "list local Pages files" 같은
//         app-prefix 쿼리도 O(log n_apps + log n_paths).
//
//   F18 SBBF axis. FI1 finder_recent_file_shbf (RFSF) +
//   K2 sharedfilelist_recent_shbf (KSFL) 패턴 transfer.
//
//   blob layout (little-endian):
//     magic     : 4B  "ICDF"          (iCloud Documents Filter)
//     version   : 4B  u32             (1)
//     n         : 4B  u32             path count
//     str_sz    : 4B  u32             path string pool bytes
//     n_apps    : 4B  u32             app count
//     app_sz    : 4B  u32             app-name pool bytes
//     [n*4]     : u32 path_offsets    (path-sorted)
//     [n*4]     : u32 path_lens
//     [n*4]     : u32 mtime_days      (u32 epoch-2000 days; lstat st_mtime)
//     [n_apps*4]: u32 app_offsets     (app-name sorted)
//     [n_apps*4]: u32 app_lens
//     [n_apps*4]: u32 app_path_start  (first path index for this app)
//     [n_apps*4]: u32 app_path_count  (number of paths for this app)
//     [str_sz]  : utf-8 path pool     (no NUL)
//     [app_sz]  : utf-8 app pool      (no NUL)
//
// 모드:
//   encode : os.walk + lstat → /tmp/icloud_documents.bin
//   bench  : encode + 50 prefix-count queries (linear vs blob bisect) + per-app subset query
//
// macOS path probe (read-only, $HOME no TCC):
//   primary  : ~/Library/Mobile Documents/<app_container>/.../*
//              .icloud placeholder skip ('.<basename>.<ext>.icloud' basename heuristic)
//              os.lstat ONLY (no open() — would trigger fdownload on placeholder)
//   absent   : synth fallback (2000 paths over Documents/Pages + Notes + Sketch + Workflow + Preview + iBooks)
//
// R1 HEXA-FIRST: 신규 .py/.sh 금지. 인라인 python3 페이로드.
// R17: /usr/bin/perl alarm 120s wrapper. /usr/bin/python3 절대경로. try/catch 0.

let PAYLOAD = "import sys,os,struct,time,bisect,resource,mmap,array,random\n" +
"mode=sys.argv[1]\n" +
"BIN='/tmp/icloud_documents.bin'\n" +
"CLASSIFIER_VERSION='CL3.ICDF.v1.2026-04-30'\n" +
"\n" +
"def fmt(b):\n" +
"    if b>1048576: return f'{b/1048576:.2f}MB'\n" +
"    if b>1024: return f'{b/1024:.1f}KB'\n" +
"    return f'{b}B'\n" +
"def rss():\n" +
"    r=resource.getrusage(resource.RUSAGE_SELF).ru_maxrss\n" +
"    if sys.platform=='darwin': return r\n" +
"    return r*1024\n" +
"\n" +
"EPOCH_2000=946684800\n" +
"def days_since_2000(ts):\n" +
"    d=int((ts-EPOCH_2000)//86400)\n" +
"    if d<0: return 0\n" +
"    if d>0xffffffff: return 0xffffffff\n" +
"    return d\n" +
"\n" +
"def is_icloud_placeholder(name):\n" +
"    return name.startswith('.') and name.endswith('.icloud')\n" +
"\n" +
"def synth(n=2000,seed=42):\n" +
"    rng=random.Random(seed)\n" +
"    home=os.environ.get('HOME','/Users/x')\n" +
"    base=home+'/Library/Mobile Documents'\n" +
"    apps=['com~apple~Pages/Documents','com~apple~TextEdit/Documents','com~apple~Preview/Documents','iCloud~is~workflow~my~workflows/Documents','iCloud~com~apple~iBooks/Documents','WUGMZZ5K46~com~bohemiancoding~sketch/Documents','com~apple~Automator/Documents','com~apple~ScriptEditor2/Documents']\n" +
"    exts=['pages','txt','md','pdf','rtf','sketch','epub','workflow','scpt']\n" +
"    now_days=days_since_2000(time.time())\n" +
"    rows=[]\n" +
"    for i in range(n):\n" +
"        a=apps[i%len(apps)]\n" +
"        sub='Folder'+str((i//50)%10)\n" +
"        e=rng.choice(exts)\n" +
"        p=f'{base}/{a}/{sub}/file_{i}.{e}'\n" +
"        d=now_days-rng.randrange(0,180)\n" +
"        rows.append((p,d))\n" +
"    return rows\n" +
"\n" +
"def real_walk():\n" +
"    home=os.environ.get('HOME','')\n" +
"    if not home: return [],'no-home'\n" +
"    root=home+'/Library/Mobile Documents'\n" +
"    if not os.path.isdir(root): return [],'absent'\n" +
"    rows=[]\n" +
"    skipped=0\n" +
"    for dirpath,dirnames,filenames in os.walk(root,followlinks=False,onerror=lambda e:None):\n" +
"        for fn in filenames:\n" +
"            if is_icloud_placeholder(fn):\n" +
"                skipped+=1\n" +
"                continue\n" +
"            full=os.path.join(dirpath,fn)\n" +
"            st=os.lstat(full) if os.path.lexists(full) else None\n" +
"            if st is None: continue\n" +
"            if not (st.st_mode & 0o170000)==0o100000: continue\n" +
"            d=days_since_2000(int(st.st_mtime))\n" +
"            rows.append((full,d))\n" +
"    return rows,f'real(skipped_placeholders={skipped})'\n" +
"\n" +
"def app_of(path,root):\n" +
"    if not path.startswith(root+'/'): return ''\n" +
"    rest=path[len(root)+1:]\n" +
"    sep=rest.find('/')\n" +
"    if sep<0: return rest\n" +
"    return rest[:sep]\n" +
"\n" +
"def load_paths():\n" +
"    rows,kind=real_walk()\n" +
"    if len(rows)>=10: return rows,kind\n" +
"    s=synth()\n" +
"    return s,f'synth(real_kind={kind},real_n={len(rows)})'\n" +
"\n" +
"def encode(rows):\n" +
"    home=os.environ.get('HOME','/Users/x')\n" +
"    root=home+'/Library/Mobile Documents'\n" +
"    rows=sorted(set(rows),key=lambda r:r[0])\n" +
"    n=len(rows)\n" +
"    pool=bytearray()\n" +
"    offs=array.array('I',[0]*n)\n" +
"    lens=array.array('I',[0]*n)\n" +
"    mts =array.array('I',[0]*n)\n" +
"    app_groups={}\n" +
"    for i,(p,d) in enumerate(rows):\n" +
"        pb=p.encode('utf-8','replace')\n" +
"        offs[i]=len(pool); lens[i]=len(pb); mts[i]=int(d)&0xffffffff\n" +
"        pool.extend(pb)\n" +
"        a=app_of(p,root)\n" +
"        if a:\n" +
"            if a not in app_groups: app_groups[a]=[i,1]\n" +
"            else: app_groups[a][1]+=1\n" +
"    apps_sorted=sorted(app_groups.items(),key=lambda kv:kv[0])\n" +
"    n_apps=len(apps_sorted)\n" +
"    apool=bytearray()\n" +
"    aoffs=array.array('I',[0]*n_apps)\n" +
"    alens=array.array('I',[0]*n_apps)\n" +
"    astart=array.array('I',[0]*n_apps)\n" +
"    acount=array.array('I',[0]*n_apps)\n" +
"    for j,(a,(start,cnt)) in enumerate(apps_sorted):\n" +
"        ab=a.encode('utf-8','replace')\n" +
"        aoffs[j]=len(apool); alens[j]=len(ab)\n" +
"        astart[j]=start; acount[j]=cnt\n" +
"        apool.extend(ab)\n" +
"    header=struct.pack('<4sIIIII',b'ICDF',1,n,len(pool),n_apps,len(apool))\n" +
"    with open(BIN,'wb') as f:\n" +
"        f.write(header)\n" +
"        f.write(offs.tobytes()); f.write(lens.tobytes()); f.write(mts.tobytes())\n" +
"        f.write(aoffs.tobytes()); f.write(alens.tobytes()); f.write(astart.tobytes()); f.write(acount.tobytes())\n" +
"        f.write(pool); f.write(apool)\n" +
"    return {'n':n,'n_apps':n_apps,'blob_size':os.path.getsize(BIN),'rows':rows,'apps':apps_sorted}\n" +
"\n" +
"class Blob:\n" +
"    def __init__(self,path):\n" +
"        self.f=open(path,'rb'); self.mm=mmap.mmap(self.f.fileno(),0,prot=mmap.PROT_READ)\n" +
"        magic,ver,n,pool_sz,n_apps,app_sz=struct.unpack_from('<4sIIIII',self.mm,0)\n" +
"        assert magic==b'ICDF' and ver==1\n" +
"        self.n=n; self.n_apps=n_apps\n" +
"        base=24\n" +
"        offs_off=base; lens_off=base+4*n; mts_off=base+8*n\n" +
"        aoffs_off=base+12*n; alens_off=aoffs_off+4*n_apps\n" +
"        astart_off=alens_off+4*n_apps; acount_off=astart_off+4*n_apps\n" +
"        pool_off=acount_off+4*n_apps; apool_off=pool_off+pool_sz\n" +
"        mv=memoryview(self.mm)\n" +
"        offs=array.array('I'); offs.frombytes(bytes(mv[offs_off:offs_off+4*n]))\n" +
"        lens=array.array('I'); lens.frombytes(bytes(mv[lens_off:lens_off+4*n]))\n" +
"        pool=bytes(mv[pool_off:pool_off+pool_sz])\n" +
"        self.paths=[pool[offs[i]:offs[i]+lens[i]] for i in range(n)]\n" +
"        aoffs=array.array('I'); aoffs.frombytes(bytes(mv[aoffs_off:aoffs_off+4*n_apps]))\n" +
"        alens=array.array('I'); alens.frombytes(bytes(mv[alens_off:alens_off+4*n_apps]))\n" +
"        astart=array.array('I'); astart.frombytes(bytes(mv[astart_off:astart_off+4*n_apps]))\n" +
"        acount=array.array('I'); acount.frombytes(bytes(mv[acount_off:acount_off+4*n_apps]))\n" +
"        apool=bytes(mv[apool_off:apool_off+app_sz])\n" +
"        self.apps=[apool[aoffs[j]:aoffs[j]+alens[j]] for j in range(n_apps)]\n" +
"        self.app_start=list(astart); self.app_count=list(acount)\n" +
"    def prefix_count(self,prefix):\n" +
"        pb=prefix.encode('utf-8') if isinstance(prefix,str) else prefix\n" +
"        a=bisect.bisect_left(self.paths,pb)\n" +
"        b=bisect.bisect_left(self.paths,pb+b'\\xff\\xff\\xff\\xff')\n" +
"        return b-a\n" +
"    def app_count_lookup(self,app_name):\n" +
"        ab=app_name.encode('utf-8') if isinstance(app_name,str) else app_name\n" +
"        j=bisect.bisect_left(self.apps,ab)\n" +
"        if j<self.n_apps and self.apps[j]==ab: return self.app_count[j]\n" +
"        return 0\n" +
"    def close(self):\n" +
"        self.mm.close(); self.f.close()\n" +
"\n" +
"def linear_prefix_count(rows,prefix):\n" +
"    c=0; pl=len(prefix)\n" +
"    for p,_ in rows:\n" +
"        if len(p)>=pl and p[:pl]==prefix: c+=1\n" +
"    return c\n" +
"\n" +
"def bench():\n" +
"    print(f'airgenome filter/CL3 — iCloud Documents SHBF (ICDF)')\n" +
"    print(f'  classifier_version={CLASSIFIER_VERSION}')\n" +
"    rows,src_kind=load_paths()\n" +
"    print(f'[source] {src_kind}  n={len(rows)}')\n" +
"    t0=time.perf_counter_ns()\n" +
"    info=encode(rows)\n" +
"    t1=time.perf_counter_ns()\n" +
"    print(f'[encode] {(t1-t0)/1e6:.1f} ms  paths={info[\"n\"]}  apps={info[\"n_apps\"]}  blob={fmt(info[\"blob_size\"])}')\n" +
"    if info['n']==0: print('[bench] no paths — skip'); return\n" +
"    if info['apps']:\n" +
"        top=sorted(info['apps'],key=lambda kv:-kv[1][1])[:5]\n" +
"        for a,(_,c) in top: print(f'  app {a:50s} {c:6d}')\n" +
"    paths=[p for p,_ in info['rows']]\n" +
"    rng=random.Random(7)\n" +
"    samples=[]\n" +
"    for _ in range(50):\n" +
"        i=rng.randrange(len(paths))\n" +
"        p=paths[i]\n" +
"        slash=p.rfind('/')\n" +
"        pref=p[:slash] if slash>0 else p[:8]\n" +
"        samples.append(pref)\n" +
"    b=Blob(BIN)\n" +
"    for s in samples[:5]: b.prefix_count(s)\n" +
"    t0=time.perf_counter_ns()\n" +
"    bh=0\n" +
"    for s in samples: bh+=b.prefix_count(s)\n" +
"    t1=time.perf_counter_ns()\n" +
"    blob_us=(t1-t0)/1000/len(samples)\n" +
"    t0=time.perf_counter_ns()\n" +
"    lh=0\n" +
"    for s in samples: lh+=linear_prefix_count(info['rows'],s)\n" +
"    t1=time.perf_counter_ns()\n" +
"    lin_us=(t1-t0)/1000/len(samples)\n" +
"    if info['apps']:\n" +
"        sample_app=info['apps'][0][0]\n" +
"        t0=time.perf_counter_ns()\n" +
"        for _ in range(50): b.app_count_lookup(sample_app)\n" +
"        t1=time.perf_counter_ns()\n" +
"        app_us=(t1-t0)/1000/50\n" +
"    else:\n" +
"        app_us=0.0\n" +
"    b.close()\n" +
"    print(f'[query] 50 prefix-count  (hits blob={bh} linear={lh})')\n" +
"    print(f'  python linear scan : {lin_us:10.1f} us')\n" +
"    print(f'  blob mmap+bisect   : {blob_us:10.1f} us')\n" +
"    if blob_us>0:\n" +
"        print(f'  speedup            : {lin_us/blob_us:6.1f}x')\n" +
"    print(f'  app dict lookup    : {app_us:10.1f} us  (per query)')\n" +
"    print(f'  (note: os.walk + lstat cold ~80-250ms on dense iCloud account — speedup 추가)')\n" +
"    print(f'[rss] {fmt(rss())}')\n" +
"\n" +
"if mode=='encode':\n" +
"    rows,kind=load_paths()\n" +
"    info=encode(rows)\n" +
"    print(f'encoded {info[\"n\"]} paths / {info[\"n_apps\"]} apps ({kind}) -> {BIN} ({fmt(info[\"blob_size\"])})')\n" +
"elif mode=='bench':\n" +
"    bench()\n" +
"else:\n" +
"    print('usage: encode|bench'); sys.exit(2)\n"

fn run() {
    let argv = args()
    let mut mode = "bench"
    let mut i = 0
    while i < len(argv) {
        let v = argv[i]
        let is_hexa_bin = v.contains("/hexa-lang/") || v == "hexa" || v == "hexa.real"
        let is_self     = v.contains("icloud_documents_shbf")
        if is_hexa_bin == false && is_self == false {
            if v == "encode" || v == "bench" { mode = v }
        }
        i = i + 1
    }
    let tmp_py = "/tmp/icloud_documents_shbf_" + exec("date +%s%N").trim() + ".py"
    write_file(tmp_py, PAYLOAD)
    let cmd = "/usr/bin/perl -e 'alarm 120; exec @ARGV' /usr/bin/python3 '" + tmp_py + "' '" + mode + "' 2>&1; rm -f '" + tmp_py + "'"
    let result = exec(cmd)
    print(result)
}

run()
