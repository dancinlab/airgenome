// modules/filters/process/safari_youtube_gpu_filter.hexa
// F65 — Safari YouTube 활성 + GPU 부하 → 다른 GPU 작업 차단 시그널 (Type A + B 결합)
//
// 역할:
//   Safari 에서 YouTube 가 활성 (탭 URL 또는 Safari frontmost + youtube.com 공개 connection)
//   + GPU > 70% → 다른 GPU 프로세스 (모델 추론, video encode 등) 에 차단 시그널.
//
// 데이터 소스:
//   1. YouTube 활성 detection
//      a) lsof -i 4 -P -p $SAFARI_PID | grep youtube  (가벼움, 1 fork)
//      b) osascript Safari URL  (정확하지만 자동화 거부 가능)
//      → 본 모듈: lsof 우선, osascript fallback (env 토글)
//   2. GPU 사용률
//      powermetrics --samplers gpu_power -i 200 -n 1
//      ※ 본 모듈은 design 단계 — root 필요 cmd 는 dry-run.
//      대안: ioreg -l | grep "PerformanceStatistics" (root 불필요, GPU busy %)
//
// 재해석:
//   YouTube + GPU>=70% = "사용자가 영상 보는 중, GPU contention 발생"
//   → 비디오 끊김 가능성 → 다른 GPU 프로세스 차단 후보
//
// 출력 ring: forge/throttle_signals.ring (F64 와 공유, kind="youtube_gpu")
//   {"ts":"...","kind":"youtube_gpu","pid":N,"comm":"...","gpu_busy":NN,
//    "action":"gpu_block","reason":"yt_active+gpu_high","confidence":"NN/100"}
//
// 제약:
//   - try/catch 0, top-level main() 0
//   - powermetrics 실호출 0 (design dry mode). ioreg 만 사용.
//
// 5-tuple bench: tool/bench/bench_f65_youtube_gpu.hexa
//   OLD: per-candidate (lsof + osascript + powermetrics) ≥ 3 fork/candidate
//   NEW: lsof 1회 + ioreg 1회 + ps 1회 = 3 fork/cycle 고정
//   기대: 250ms → 12ms (~20x, 95%↓), signal 결정 동치

use "../../../core/core"

// A6 RFC interim — to_int_safe local helper (label.hexa pattern 직접 이식).
// `to_int("0.0")` panic 회피. A6 hexa-lang stdlib promote 후 제거 예정.
fn is_numeric_str(s: str) -> bool {
    let n = len(s)
    if n == 0 { return false }
    let mut i = 0
    if s.substring(0, 1) == "-" { i = 1 }
    if i >= n { return false }
    while i < n {
        let c = s.substring(i, i + 1)
        if c < "0" { return false }
        if c > "9" { return false }
        i = i + 1
    }
    return true
}
fn to_int_safe(s: str) -> int {
    let trimmed = s.trim()
    if trimmed == "" { return 0 }
    let parts = trimmed.split(".")
    if len(parts) == 0 { return 0 }
    let head = parts[0]
    if head == "" { return 0 }
    if !is_numeric_str(head) { return 0 }
    return to_int(head)
}

let RING = ring_path("throttle_signals.ring")
let GPU_TRIGGER = 70                  // ioreg PerformanceStatistics busy %
let MAX_EMIT_PER_CYCLE = 4
let YT_HOST_ANCHOR = "youtube.com"
let YT_HOST_ANCHOR_2 = "googlevideo.com"  // YT CDN

fn ts_iso() -> str {
    return exec("date -u +%Y-%m-%dT%H:%M:%SZ").trim()
}

fn frontmost_app() -> str {
    let cached = env("AG_COORD_FRONTMOST")
    if cached != "" { return cached }
    return exec("lsappinfo info -only name \"$(lsappinfo front)\" 2>/dev/null | awk -F'\"' 'NF>=4{print $4}'").trim()
}

// ── YouTube detection ─────────────────────────────────────────────────
// Safari WebContent / Networking PID 들의 lsof 4 -P 결과에서 youtube/googlevideo
// 호스트로 active connection 이 있는지 확인.
fn youtube_active() -> bool {
    // ps 로 Safari + WebContent + Networking PID 수집
    let pids_raw = exec("ps -axo pid=,comm= 2>/dev/null | awk '$1+0>100' | grep -E 'Safari|com.apple.WebKit' | awk '{print $1}' | head -32 | tr '\\n' ',' | sed 's/,$//'")
    let pids = pids_raw.trim()
    if pids == "" { return false }
    let lsof_cmd = "lsof -nP -i 4 -p '" + pids + "' 2>/dev/null | grep -E '" + YT_HOST_ANCHOR + "|" + YT_HOST_ANCHOR_2 + "' | head -1 || true"
    let hit = exec(lsof_cmd).trim()
    return hit != ""
}

// ── GPU busy via ioreg (root 불필요) ──────────────────────────────────
// "Device Utilization %" 또는 "GPU Core Utilization" 검색.
fn gpu_busy_pct() -> int {
    let raw = exec("ioreg -r -d 1 -w 0 -c IOAccelerator 2>/dev/null | grep -E '\"Device Utilization %\"|\"GPU Core Utilization\"' | head -1 || true")
    let line = raw.trim()
    if line == "" { return 0 }
    // 형식: "Device Utilization %" = 47
    let parts = line.split("=")
    if len(parts) < 2 { return 0 }
    return to_int_safe(parts[1].trim())
}

// ── GPU 사용 의심 프로세스 census ─────────────────────────────────────
// 기준: ps 의 컴맨드명에서 video/encode/render/ML 추정 키워드 + Safari/YT 자체 제외.
struct GpuCand {
    pid: int,
    cpu: int,
    rss_kb: int,
    comm: str
}

fn looks_gpu_workload(comm: str) -> bool {
    let kw = ["ffmpeg", "VideoToolbox", "MetalCompiler", "ollama", "llama",
              "blender", "Blender", "DaVinci", "Final Cut", "ScreenRecorder",
              "obs", "OBS", "AVConference", "compressor"]
    let mut i = 0
    while i < len(kw) {
        if comm.contains(kw[i]) { return true }
        i = i + 1
    }
    return false
}

fn is_hard_never(comm: str) -> bool {
    if comm.contains("Safari") { return true }
    if comm.contains("WebContent") { return true }
    if comm.contains("WindowServer") { return true }
    if comm.contains("kernel_task") { return true }
    if comm.contains("airgenome") { return true }
    if comm.contains("hexa") { return true }
    return false
}

fn split_4col(line: str) -> GpuCand {
    let n = len(line)
    let mut starts = [0]
    let mut in_ws = false
    let mut i = 0
    while i < n {
        let ch = line.substring(i, i + 1)
        if ch == " " || ch == "\t" {
            if !in_ws { in_ws = true }
        } else {
            if in_ws { starts = starts + [i]; in_ws = false }
        }
        i = i + 1
    }
    if len(starts) < 4 {
        return GpuCand { pid: 0, cpu: 0, rss_kb: 0, comm: "" }
    }
    return GpuCand {
        pid: to_int_safe(line.substring(starts[0], starts[1]).trim()),
        cpu: to_int_safe(line.substring(starts[1], starts[2]).trim()),
        rss_kb: to_int_safe(line.substring(starts[2], starts[3]).trim()),
        comm: line.substring(starts[3], n).trim()
    }
}

fn collect_gpu_workloads() -> list {
    let raw = exec("ps -axo pid=,pcpu=,rss=,comm= 2>/dev/null | awk '$1+0>100 && $2+0>5'")
    let lines = raw.split("\n")
    let mut out = []
    let mut i = 0
    while i < len(lines) {
        let l = lines[i].trim()
        if l == "" { i = i + 1; continue }
        let c = split_4col(l)
        if c.pid == 0 { i = i + 1; continue }
        if is_hard_never(c.comm) { i = i + 1; continue }
        if !looks_gpu_workload(c.comm) { i = i + 1; continue }
        out = out + [c]
        i = i + 1
    }
    return out
}

fn rotate_ring() -> int {
    let raw = read_file(RING)
    let lines = raw.split("\n")
    let mut all = []
    let mut i = 0
    while i < len(lines) {
        if lines[i] != "" { all = all + [lines[i]] }
        i = i + 1
    }
    let max_r = 480
    if len(all) <= max_r { return len(all) }
    let start = len(all) - max_r
    let mut out = ""
    let mut j = start
    while j < len(all) { out = out + all[j] + "\n"; j = j + 1 }
    write_file(RING, out)
    return max_r
}

fn comm_escape(s: str) -> str {
    return s.replace("\\", "\\\\").replace("\"", "\\\"")
}

pub fn run_filter() -> int {
    let _ = exec("mkdir -p '" + forge_dir() + "'")
    let ts = ts_iso()
    let front = frontmost_app()
    let yt = youtube_active()
    let gpu = gpu_busy_pct()
    if !yt {
        println("safari_youtube_gpu_filter: yt_active=false front=" + front + " gpu=" + to_string(gpu) + " — pass")
        return 0
    }
    if gpu < GPU_TRIGGER {
        println("safari_youtube_gpu_filter: yt_active=true gpu=" + to_string(gpu) + " < " + to_string(GPU_TRIGGER) + " — pass")
        return 0
    }
    let cands = collect_gpu_workloads()
    if len(cands) == 0 {
        println("safari_youtube_gpu_filter: yt+gpu_high but no GPU workload candidates")
        return 0
    }

    let mut buf = ""
    let mut emitted = 0
    let mut k = 0
    while k < len(cands) {
        if emitted >= MAX_EMIT_PER_CYCLE { k = len(cands) }
        else {
            let c = cands[k]
            let conf = if gpu >= 90 { "95/100" } else { "80/100" }
            let line = "{\"ts\":\"" + ts + "\""
                     + ",\"kind\":\"youtube_gpu\""
                     + ",\"pid\":" + to_string(c.pid)
                     + ",\"comm\":\"" + comm_escape(c.comm) + "\""
                     + ",\"cpu\":" + to_string(c.cpu)
                     + ",\"gpu_busy\":" + to_string(gpu)
                     + ",\"action\":\"gpu_block\""
                     + ",\"confidence\":\"" + conf + "\""
                     + ",\"reason\":\"yt_active+gpu_high\"}"
            buf = buf + line + "\n"
            emitted = emitted + 1
            k = k + 1
        }
    }
    append_file(RING, buf)
    let kept = rotate_ring()
    println("safari_youtube_gpu_filter: yt=true gpu=" + to_string(gpu) + " emitted=" + to_string(emitted) + " ring_kept=" + to_string(kept))
    return emitted
}

pub fn self_test() -> void {
    if !looks_gpu_workload("ffmpeg") { panic("F65 self_test [ffmpeg]") }
    if !looks_gpu_workload("ollama") { panic("F65 self_test [ollama]") }
    if looks_gpu_workload("node") { panic("F65 self_test [node]") }
    if !is_hard_never("Safari") { panic("F65 self_test [Safari guard]") }
    if !is_hard_never("WebContent") { panic("F65 self_test [WebContent guard]") }
    if is_hard_never("ffmpeg") { panic("F65 self_test [ffmpeg should not be guarded]") }
    let c = split_4col("999 12 50000 ffmpeg")
    if c.pid != 999 || c.comm != "ffmpeg" { panic("F65 self_test [split]") }
    println("  ✅ F65 safari_youtube_gpu_filter self_test PASS")
}

// auto-invoke entry — raw 245 호환 (top-level main() 호출 0, runtime auto-fires).
fn main() -> void {
    let a = args()
    if len(a) >= 3 && a[2] == "self-test" {
        self_test()
        return
    }
    let _ = run_filter()
}
