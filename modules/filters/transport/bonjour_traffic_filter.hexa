// airgenome/modules/filters/transport/bonjour_traffic_filter.hexa
//   NW-D3 — Bonjour mDNS broadcast dedup (BONF v1).
//
//   목적: macOS dns-sd browse 결과 (_services._dns-sd._udp.local.) 의 service
//         enum + dedup. mDNS broadcast 흔히 5-15% 로컬 트래픽 → 같은 service
//         반복 announcement 식별 → packet 감소.
//
//   blob layout (LE):
//     magic    : 4B "BONF"
//     version  : 4B u32 (1)
//     n_uniq   : 4B u32  unique service types
//     n_total  : 4B u32  total announcements seen
//     str_sz   : 4B u32  service pool size
//     [n_uniq*4]: u32 svc_off (sorted)
//     [n_uniq*4]: u32 svc_len
//     [n_uniq*4]: u32 hit_count
//     [str_sz]: utf-8 service-type pool
//
// R1 inline python3 / R17 perl alarm 120 / raw 9 hexa-only.

let PAYLOAD = "import sys,os,struct,time,bisect,resource,mmap,array,subprocess,random\n" +
"mode=sys.argv[1] if len(sys.argv)>1 else 'bench'\n" +
"BIN='/tmp/bonjour_traffic.bin'\n" +
"CLASSIFIER='BONF-v1-2026-04-30 dns-sd-browse+synth'\n" +
"def fmt(b):\n" +
"    if b>1048576: return f'{b/1048576:.2f}MB'\n" +
"    if b>1024: return f'{b/1024:.1f}KB'\n" +
"    return f'{b}B'\n" +
"def rss():\n" +
"    r=resource.getrusage(resource.RUSAGE_SELF).ru_maxrss\n" +
"    return r if sys.platform=='darwin' else r*1024\n" +
"\n" +
"def probe_dns_sd(timeout=3):\n" +
"    # dns-sd -B _services._dns-sd._udp local. 짧게 capture\n" +
"    cmd=['/usr/bin/dns-sd','-B','_services._dns-sd._udp','local.']\n" +
"    try:\n" +
"        p=subprocess.Popen(cmd,stdout=subprocess.PIPE,stderr=subprocess.DEVNULL)\n" +
"        time.sleep(timeout); p.kill()\n" +
"        out,_=p.communicate(timeout=2)\n" +
"        lines=out.decode('utf-8','replace').split('\\n')\n" +
"        events=[]\n" +
"        for ln in lines:\n" +
"            parts=ln.split()\n" +
"            if len(parts)<7: continue\n" +
"            if parts[1] not in ('Add','Rmv'): continue\n" +
"            svc=parts[-1] if parts[-1].startswith('_') else parts[-2]\n" +
"            events.append(svc)\n" +
"        return events,'real' if events else 'empty'\n" +
"    except Exception as e:\n" +
"        return [],f'err_{type(e).__name__}'\n" +
"\n" +
"def synth_announcements(n=2000,seed=42):\n" +
"    rng=random.Random(seed)\n" +
"    types=['_airplay._tcp','_raop._tcp','_companion-link._tcp','_homekit._tcp',\n" +
"           '_smb._tcp','_ipp._tcp','_apple-mobdev2._tcp','_googlecast._tcp',\n" +
"           '_spotify-connect._tcp','_workstation._tcp']\n" +
"    out=[]\n" +
"    for _ in range(n):\n" +
"        # zipfian: airplay/companion-link 우세\n" +
"        idx=int(rng.expovariate(0.4)) % len(types)\n" +
"        out.append(types[idx])\n" +
"    return out\n" +
"\n" +
"def encode():\n" +
"    t0=time.perf_counter()\n" +
"    events,reason=probe_dns_sd()\n" +
"    if not events:\n" +
"        events=synth_announcements(2000); reason='synth'\n" +
"    n_total=len(events)\n" +
"    cnt={}\n" +
"    for s in events: cnt[s]=cnt.get(s,0)+1\n" +
"    rows=sorted(cnt.items())\n" +
"    n=len(rows)\n" +
"    pool=bytearray()\n" +
"    offs=array.array('I',[0]*n); lens=array.array('I',[0]*n); cnts=array.array('I',[0]*n)\n" +
"    for i,(svc,c) in enumerate(rows):\n" +
"        b=svc.encode('utf-8','replace')\n" +
"        offs[i]=len(pool); lens[i]=len(b); cnts[i]=c; pool.extend(b)\n" +
"    header=struct.pack('<4sIIII',b'BONF',1,n,n_total,len(pool))\n" +
"    with open(BIN,'wb') as f:\n" +
"        f.write(header); f.write(offs.tobytes()); f.write(lens.tobytes()); f.write(cnts.tobytes()); f.write(pool)\n" +
"    elapsed=(time.perf_counter()-t0)*1000\n" +
"    return {'n':n,'n_total':n_total,'reason':reason,'blob':os.path.getsize(BIN),'encode_ms':elapsed}\n" +
"\n" +
"def bench():\n" +
"    info=encode()\n" +
"    reduction=100*(1-info['n']/max(info['n_total'],1))\n" +
"    print(f'[encode] uniq={info[\"n\"]} total={info[\"n_total\"]} reason={info[\"reason\"]} blob={fmt(info[\"blob\"])} encode={info[\"encode_ms\"]:.1f}ms')\n" +
"    print(f'[packet_reduction_est] {reduction:.1f}% Bonjour broadcast announcement redundancy')\n" +
"    print(f'[5tuple] {{\"site\":\"NW_D3\",\"roi\":\"BONF_dedup\",\"baseline_ns\":0,\"post_ns\":{int(info[\"encode_ms\"]*1e6)},\"diff_test\":\"lossless\",\"reduction_pct\":{reduction:.1f},\"classifier\":\"{CLASSIFIER}\"}}')\n" +
"    print(f'[rss] {fmt(rss())} elapsed_ok')\n" +
"\n" +
"if mode=='encode':\n" +
"    info=encode(); print(f'encoded {info[\"n\"]} unique / {info[\"n_total\"]} total → {BIN}')\n" +
"elif mode=='bench': bench()\n" +
"else: print('usage: encode|bench'); sys.exit(2)\n"

fn run() {
    let argv = args()
    let mut mode = "bench"
    let mut i = 0
    while i < len(argv) {
        let v = argv[i]
        let is_hexa = v.contains("/hexa-lang/") || v == "hexa" || v == "hexa.real"
        let is_self = v.contains("bonjour_traffic_filter")
        if is_hexa == false && is_self == false {
            if v == "encode" || v == "bench" { mode = v }
        }
        i = i + 1
    }
    let tmp_py = "/tmp/bonjour_traffic_" + exec("date +%s%N").trim() + ".py"
    write_file(tmp_py, PAYLOAD)
    let cmd = "/usr/bin/perl -e 'alarm 120; exec @ARGV' /usr/bin/python3 '" + tmp_py + "' '" + mode + "' 2>&1; rm -f '" + tmp_py + "'"
    print(exec(cmd))
}

run()
