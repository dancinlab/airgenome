// gate_client.hexa — AG3 게이트 unix-socket 클라이언트 (gate_client.py 대체)
// L0 | HEXA-FIRST | AG3 Ubuntu-side 비-PyTorch 워커
//
// 역할: stdin 바이너리 payload → unix socket(gate.sock) → stdout
// 설정: gate_config.jsonl 의 ubu_gate_sock 키 (값은 gate_config.jsonl 참조)
// 구현: nc -U 쉘 우회 (hexa raw socket API 부재). ncat 미설치 → nc 사용.
//
// 사용 (ubu):
//   cat payload.bin | ~/Dev/hexa-lang/target/release/hexa modules/gate_client.hexa
//
// 주의: nc -U 는 stdin EOF 후 종료. 영구 스트리밍 필요 시 nc -q 0 옵션 사용.

fn load_sock() -> str {
    // gate_config.jsonl 에서 ubu_gate_sock 로드 (하드코딩 금지 R2)
    // A10 interim: try/catch 제거 (PANIC parse blocker) — env()/exec() 에러는 stderr 로 emit
    let home = env("HOME")
    let cfg_path = home + "/Dev/airgenome/nexus/shared/gate_config.jsonl"
    if file_exists(cfg_path) {
        let line = exec("/usr/bin/grep -m1 ubu_gate_sock '" + cfg_path + "' 2>/dev/null || true").trim()
        if len(line) > 0 {
            let parts = line.split("\"")
            // 마지막 문자열 값 추정
            let n = parts.len()
            if n >= 4 { return parts[n - 2] }
        }
    }
    // fallback: gate_config.jsonl 에 ubu_gate_sock 없을 때 환경변수
    let fb = env("AG3_GATE_SOCK")
    if len(fb) > 0 { return fb }
    // gate_config.jsonl 에 ubu_gate_sock 이 반드시 있어야 함 (R2 하드코딩 금지)
    return ""
}

fn main() {
    let sock = load_sock()
    if len(sock) == 0 {
        println("[warn] gate_client: ubu_gate_sock unresolved (gate_config.jsonl + AG3_GATE_SOCK both empty)")
        return
    }
    // nc -U <sock>: stdin → socket, socket → stdout.
    // A10 interim: macOS BSD nc 는 -q 미지원 (invalid option) — Linux GNU nc 만 지원.
    //   macOS bench/dry-run 에서는 -N (close on EOF) 으로 대체. Linux gate worker 는 -q 0 사용.
    //   런타임 분기: uname=Darwin → -N, else → -q 0
    // A10 interim: try/catch 제거 — exec failure 는 stdout/stderr 로 emit
    let kernel = exec("/usr/bin/uname -s").trim()
    let nc_flag = if kernel == "Darwin" { "-N" } else { "-q 0" }
    let cmd = "exec /usr/bin/nc " + nc_flag + " -U " + sock
    exec(cmd)
}
