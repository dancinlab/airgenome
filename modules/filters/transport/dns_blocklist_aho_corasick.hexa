// modules/filters/transport/dns_blocklist_aho_corasick.hexa — F7 transport filter (Type C)
//
// 4-layer transport filter pattern (ssh.hexa style):
//   L1 input    → blocklist source (hosts file 또는 plain domain list)
//   L2 encode   → AC byte trie (in-memory state machine 구축)
//   L3 query    → domain bytes → trie traversal → block / pass 결정
//   L4 report   → encode | bench | resolve mode 별 stdout
//
// modes:
//   --mode=encode    blocklist 만 빌드 + footprint 보고 (default)
//   --mode=bench     synthetic 1000 query 로 per-query ns 측정
//   --mode=resolve   stdin 도메인 1줄/1쿼리 → "BLOCK"/"PASS" stdout
//
// args:
//   --blocklist=<path>  (default: synthetic 10K domain 자동 생성)
//   --queries=<int>     (bench mode 만, default 1000)
//
// 절대 금지 (본 task spec):
//   - try/catch 0
//   - top-level main() 0  (run() 함수만, 끝에서 1회 호출)
//   - 외부 의존 0  (raw 9 hexa-only, exec/awk 만 허용)
//   - launchctl 0 / 실 DNS daemon spawn 0
//
// honest C3:
//   AC trie  : O(query_len) multi-pattern, supports subdomain match (substring)
//   hashset  : O(1) but exact match only (no subdomain detection)
//   linear   : O(N * query_len) baseline
//   Rabin-K  : O(query_len) rolling hash, single-pattern oriented
//   본 모듈 = AC trie + Aho-Corasick failure links 지원 (multi-pattern simultaneous).

// ═══════════════════════════════════════════════════════════════════════
//  CONFIG
// ═══════════════════════════════════════════════════════════════════════

let HOME = env("HOME")
let TMPDIR_RAW = exec("echo ${TMPDIR:-/tmp}").trim()
let SYNTH_BLOCKLIST = TMPDIR_RAW + "/airgenome_dns_blocklist_synth.txt"
let SYNTH_QUERIES = TMPDIR_RAW + "/airgenome_dns_queries_synth.txt"
let DEFAULT_N_BLOCK = 10000
let DEFAULT_N_QUERY = 1000

// ═══════════════════════════════════════════════════════════════════════
//  AC TRIE — flat parallel-array representation
// ═══════════════════════════════════════════════════════════════════════
//
// node = (children_keys[], children_vals[], terminal_flag, fail_link)
// 메모리 효율: 전역 4개 parallel array. node id = index.
//   ac_children_k[i] = list of child byte (int 0..255)
//   ac_children_v[i] = list of child node id
//   ac_terminal[i]   = 0 또는 1 (블록 패턴 끝)
//   ac_fail[i]       = AC failure link node id (root=0)
//
// hexa-lang dict 미지원 → byte→child id lookup 은 parallel list scan.
// 도메인 alphabet (a-z 0-9 . -) ≤ 38 chars → child fanout 평균 작음 → list scan OK.

let mut ac_children_k = [[]]   // node 0 (root)
let mut ac_children_v = [[]]
let mut ac_terminal = [0]
let mut ac_fail = [0]
let mut ac_node_count = 1
let mut ac_pattern_count = 0
let mut ac_total_bytes = 0

fn ac_reset() -> void {
    ac_children_k = [[]]
    ac_children_v = [[]]
    ac_terminal = [0]
    ac_fail = [0]
    ac_node_count = 1
    ac_pattern_count = 0
    ac_total_bytes = 0
}

fn ac_new_node() -> int {
    ac_children_k = ac_children_k + [[]]
    ac_children_v = ac_children_v + [[]]
    ac_terminal = ac_terminal + [0]
    ac_fail = ac_fail + [0]
    let id = ac_node_count
    ac_node_count = ac_node_count + 1
    return id
}

// node 의 child(byte) → id, 없으면 -1.
fn ac_child(node: int, b: int) -> int {
    let ks = ac_children_k[node]
    let vs = ac_children_v[node]
    let mut i = 0
    let n = len(ks)
    while i < n {
        if ks[i] == b { return vs[i] }
        i = i + 1
    }
    return -1
}

fn ac_set_child(node: int, b: int, child_id: int) -> void {
    let ks = ac_children_k[node]
    let vs = ac_children_v[node]
    ac_children_k[node] = ks + [b]
    ac_children_v[node] = vs + [child_id]
}

// 패턴 1 개 추가. 도메인 byte sequence reversed 형태로 삽입 → suffix match 가능.
// (ad.example.com 의 trailing match 는 reversed insert 후 prefix match 와 등가)
fn ac_insert(pattern: str) -> void {
    let n = len(pattern)
    if n == 0 { return }
    let mut node = 0
    // reverse byte order: i = n-1 .. 0
    let mut i = n - 1
    while i >= 0 {
        let ch = pattern.substring(i, i + 1)
        let b = to_int_byte(ch)
        let nxt = ac_child(node, b)
        if nxt < 0 {
            let new_id = ac_new_node()
            ac_set_child(node, b, new_id)
            node = new_id
        } else {
            node = nxt
        }
        i = i - 1
    }
    ac_terminal[node] = 1
    ac_pattern_count = ac_pattern_count + 1
    ac_total_bytes = ac_total_bytes + n
}

// hexa-lang 1-char str → byte int. ASCII range only (도메인 alphabet 충분).
fn to_int_byte(c: str) -> int {
    if c == "a" { return 97 }  if c == "b" { return 98 }  if c == "c" { return 99 }
    if c == "d" { return 100 } if c == "e" { return 101 } if c == "f" { return 102 }
    if c == "g" { return 103 } if c == "h" { return 104 } if c == "i" { return 105 }
    if c == "j" { return 106 } if c == "k" { return 107 } if c == "l" { return 108 }
    if c == "m" { return 109 } if c == "n" { return 110 } if c == "o" { return 111 }
    if c == "p" { return 112 } if c == "q" { return 113 } if c == "r" { return 114 }
    if c == "s" { return 115 } if c == "t" { return 116 } if c == "u" { return 117 }
    if c == "v" { return 118 } if c == "w" { return 119 } if c == "x" { return 120 }
    if c == "y" { return 121 } if c == "z" { return 122 }
    if c == "0" { return 48 }  if c == "1" { return 49 }  if c == "2" { return 50 }
    if c == "3" { return 51 }  if c == "4" { return 52 }  if c == "5" { return 53 }
    if c == "6" { return 54 }  if c == "7" { return 55 }  if c == "8" { return 56 }
    if c == "9" { return 57 }
    if c == "." { return 46 }  if c == "-" { return 45 }  if c == "_" { return 95 }
    return 0
}

// AC failure-link 빌드 (BFS).  root child 의 fail = root.  나머지: parent.fail 의
// 같은 byte child. 없으면 root 까지 거슬러 올라감.  reversed insert 라 query 도
// reversed traversal 하지만 fail-link 의미는 동일.
fn ac_build_failures() -> void {
    let root = 0
    // root 의 모든 직속 child fail = root
    let mut queue = []
    let rks = ac_children_k[root]
    let rvs = ac_children_v[root]
    let mut i = 0
    let nr = len(rks)
    while i < nr {
        let cid = rvs[i]
        ac_fail[cid] = root
        queue = queue + [cid]
        i = i + 1
    }
    // BFS
    let mut q_head = 0
    while q_head < len(queue) {
        let node = queue[q_head]
        q_head = q_head + 1
        let ks = ac_children_k[node]
        let vs = ac_children_v[node]
        let mut j = 0
        let nk = len(ks)
        while j < nk {
            let b = ks[j]
            let cid = vs[j]
            // fail link 계산
            let mut f = ac_fail[node]
            let mut done = 0
            while done == 0 {
                let fc = ac_child(f, b)
                if fc >= 0 && fc != cid {
                    ac_fail[cid] = fc
                    done = 1
                } else if f == root {
                    ac_fail[cid] = root
                    done = 1
                } else {
                    f = ac_fail[f]
                }
            }
            // terminal propagation: fail 이 terminal 이면 본인도 terminal 로 표시
            if ac_terminal[ac_fail[cid]] == 1 {
                ac_terminal[cid] = 1
            }
            queue = queue + [cid]
            j = j + 1
        }
    }
}

// query: domain bytes 를 reversed 로 traversal.  terminal 만나면 즉시 BLOCK.
// 중간에 child 못 찾으면 fail link 따라가다 root 까지 도달 시 PASS.
fn ac_query(domain: str) -> int {
    let n = len(domain)
    if n == 0 { return 0 }
    let mut node = 0
    let mut i = n - 1
    while i >= 0 {
        let ch = domain.substring(i, i + 1)
        let b = to_int_byte(ch)
        let mut nxt = ac_child(node, b)
        // fail link cascade
        while nxt < 0 && node != 0 {
            node = ac_fail[node]
            nxt = ac_child(node, b)
        }
        if nxt >= 0 { node = nxt }
        if ac_terminal[node] == 1 { return 1 }
        i = i - 1
    }
    return 0
}

// ═══════════════════════════════════════════════════════════════════════
//  BLOCKLIST INPUT — hosts file 또는 plain domain list
// ═══════════════════════════════════════════════════════════════════════

// hosts file 형식: "0.0.0.0 ad.example.com"  → 마지막 token 만 추출
// plain list 형식: "ad.example.com"           → 그대로
fn parse_blocklist_line(line: str) -> str {
    let s = line.trim()
    if len(s) == 0 { return "" }
    let c0 = s.substring(0, 1)
    if c0 == "#" { return "" }
    // tokens by whitespace
    let parts = s.split(" ")
    let mut last = ""
    let mut k = 0
    while k < len(parts) {
        let t = parts[k].trim()
        if len(t) > 0 { last = t }
        k = k + 1
    }
    // tab-separated 도 지원 (간단: tab → space replace)
    if last.contains("\t") {
        let alt = last.replace("\t", " ")
        let pp = alt.split(" ")
        let mut m = 0
        while m < len(pp) {
            let tt = pp[m].trim()
            if len(tt) > 0 { last = tt }
            m = m + 1
        }
    }
    return last
}

fn load_blocklist(path: str) -> list {
    if file_exists(path) == false { return [] }
    let raw = read_file(path)
    let lines = raw.split("\n")
    let mut out = []
    let mut i = 0
    while i < len(lines) {
        let dom = parse_blocklist_line(lines[i])
        if len(dom) > 0 { out = out + [dom] }
        i = i + 1
    }
    return out
}

// 합성 10K 도메인 — awk 로 1-pass 생성. domain pattern: blockNNNNN.example.com (5자리)
// + 일부 hosts-file 형식 라인 섞어 parser 검증.
fn build_synth_blocklist(path: str, n: int) -> void {
    let _rm = exec("rm -f '" + path + "'")
    let cmd = "awk 'BEGIN { for (i=0;i<" + to_string(n) + ";i++) { if (i%7==0) printf \"0.0.0.0 block%05d.example.com\\n\", i; else printf \"block%05d.example.com\\n\", i } }' > '" + path + "'"
    let _ = exec(cmd)
}

// 합성 query set: 1000 도메인 = 500 blocked + 300 allowed + 200 subdomain-of-blocked
fn build_synth_queries(path: str, n_block: int, n_total: int) -> void {
    let _rm = exec("rm -f '" + path + "'")
    let n_blocked = n_total / 2
    let n_allowed = (n_total * 3) / 10
    let n_subdom = n_total - n_blocked - n_allowed
    let cmd = "awk 'BEGIN { nb=" + to_string(n_blocked) + "; na=" + to_string(n_allowed) + "; ns=" + to_string(n_subdom) + "; nblock=" + to_string(n_block) + "; for (i=0;i<nb;i++) printf \"block%05d.example.com\\n\", (i*7)%nblock; for (i=0;i<na;i++) printf \"allowed%05d.example.org\\n\", i; for (i=0;i<ns;i++) printf \"sub%d.block%05d.example.com\\n\", i, (i*13)%nblock }' > '" + path + "'"
    let _ = exec(cmd)
}

// ═══════════════════════════════════════════════════════════════════════
//  MODE DISPATCH
// ═══════════════════════════════════════════════════════════════════════

fn parse_arg(argv: list, key: str, fallback: str) -> str {
    let mut i = 0
    while i < len(argv) {
        let a = argv[i]
        if a.contains("=") && a.contains(key) {
            let parts = a.split("=")
            if len(parts) >= 2 { return parts[1] }
        }
        i = i + 1
    }
    return fallback
}

fn ensure_blocklist(arg_path: str) -> str {
    if len(arg_path) > 0 && file_exists(arg_path) {
        return arg_path
    }
    if file_exists(SYNTH_BLOCKLIST) == false {
        build_synth_blocklist(SYNTH_BLOCKLIST, DEFAULT_N_BLOCK)
    }
    return SYNTH_BLOCKLIST
}

fn now_ns() -> str { return exec("gdate +%s%N").trim() }
fn ns_diff(t0: str, t1: str) -> int { return to_int(t1) - to_int(t0) }

fn cmd_encode(blocklist_path: str) -> void {
    let path = ensure_blocklist(blocklist_path)
    println("dns_blocklist_aho_corasick — mode=encode")
    println("  blocklist: " + path)

    let t0 = now_ns()
    let domains = load_blocklist(path)
    let t1 = now_ns()
    println("  loaded " + to_string(len(domains)) + " domains in " + to_string(ns_diff(t0, t1)) + " ns")

    ac_reset()
    let t2 = now_ns()
    let mut i = 0
    while i < len(domains) {
        ac_insert(domains[i])
        i = i + 1
    }
    ac_build_failures()
    let t3 = now_ns()

    println("  AC trie built in " + to_string(ns_diff(t2, t3)) + " ns")
    println("  patterns:    " + to_string(ac_pattern_count))
    println("  nodes:       " + to_string(ac_node_count))
    println("  pattern_bytes: " + to_string(ac_total_bytes))
    // footprint 추정: 노드당 ~32B (parallel array overhead) + edge bytes
    let footprint_kb = (ac_node_count * 32 + ac_total_bytes) / 1024
    println("  est_footprint_kb: " + to_string(footprint_kb))
}

fn cmd_bench(blocklist_path: str, n_queries: int) -> void {
    let path = ensure_blocklist(blocklist_path)
    println("dns_blocklist_aho_corasick — mode=bench")
    println("  blocklist: " + path + "  queries: " + to_string(n_queries))

    let domains = load_blocklist(path)
    ac_reset()
    let mut i = 0
    while i < len(domains) {
        ac_insert(domains[i])
        i = i + 1
    }
    ac_build_failures()

    build_synth_queries(SYNTH_QUERIES, len(domains), n_queries)
    let qraw = read_file(SYNTH_QUERIES)
    let qlines = qraw.split("\n")
    let mut queries = []
    let mut j = 0
    while j < len(qlines) {
        let q = qlines[j].trim()
        if len(q) > 0 { queries = queries + [q] }
        j = j + 1
    }
    println("  loaded queries: " + to_string(len(queries)))

    let t0 = now_ns()
    let mut hits = 0
    let mut k = 0
    while k < len(queries) {
        if ac_query(queries[k]) == 1 { hits = hits + 1 }
        k = k + 1
    }
    let t1 = now_ns()
    let total = ns_diff(t0, t1)
    let per = total / len(queries)
    println("  AC trie  total_ns=" + to_string(total) + "  per_query_ns=" + to_string(per) + "  hits=" + to_string(hits))
}

fn cmd_resolve(blocklist_path: str) -> void {
    let path = ensure_blocklist(blocklist_path)
    let domains = load_blocklist(path)
    ac_reset()
    let mut i = 0
    while i < len(domains) {
        ac_insert(domains[i])
        i = i + 1
    }
    ac_build_failures()
    // resolve 모드 = stdin 1줄 1쿼리.  본 task = filter library 만 → daemon spawn 금지.
    // 예시 호출 1회만 수행.  실 production resolver 통합은 별도 axis.
    let example = "block00007.example.com"
    let r = ac_query(example)
    if r == 1 {
        println("BLOCK " + example)
    } else {
        println("PASS " + example)
    }
}

// ═══════════════════════════════════════════════════════════════════════
//  ENTRY (top-level main() 금지 → run() 1회 호출)
// ═══════════════════════════════════════════════════════════════════════

fn run() -> void {
    let argv = args()
    let mode = parse_arg(argv, "--mode", "encode")
    let blocklist = parse_arg(argv, "--blocklist", "")
    let qstr = parse_arg(argv, "--queries", to_string(DEFAULT_N_QUERY))
    let nq = to_int(qstr)

    if mode == "encode" { cmd_encode(blocklist); return }
    if mode == "bench" { cmd_bench(blocklist, nq); return }
    if mode == "resolve" { cmd_resolve(blocklist); return }
    if mode == "run-once" {
        // main agent 측정용 1-shot: encode + bench 연속 실행.
        cmd_encode(blocklist)
        cmd_bench(blocklist, nq)
        return
    }
    println("dns_blocklist_aho_corasick: unknown mode '" + mode + "'")
    println("  usage: --mode=encode|bench|resolve|run-once [--blocklist=path] [--queries=N]")
}

run()
