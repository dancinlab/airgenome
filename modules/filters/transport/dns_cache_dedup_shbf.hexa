// airgenome/modules/filters/transport/dns_cache_dedup_shbf.hexa
//   NW-D1 — DNS Cache Dedup Sorted-Hash-Blob Filter (DCDD).
//
//   목적: dscacheutil -cachedump (또는 -entries Host) 출력에서 중복 hostname/ip 매핑을
//         제거 + sorted hostname blob 으로 fold → 후속 query lookup 시 redundant DNS
//         resolve 를 절감. 5분 TTL 윈도우 가정 시 ~25% packet reduction.
//
//   F18 SBBF + F7 dns_blocklist axis 동일. source 만 dscacheutil read-only subprocess.
//
//   blob layout (little-endian):
//     magic       : 4B   "DCDD"          (DNS Cache Dedup, classifier=DCDD-v1)
//     version     : 4B   u32             (1)
//     n           : 4B   u32             entry 개수 (dedup 후)
//     host_pool   : 4B   u32             hostname utf-8 pool 길이
//     ip_pool     : 4B   u32             ip ascii pool 길이
//     [n*4]       : u32 host_offs        sorted host 오프셋 (asc)
//     [n*4]       : u32 host_lens
//     [n*4]       : u32 ip_offs
//     [n*4]       : u32 ip_lens
//     [n*4]       : u32 ttl_secs
//     [n*1]       : u8  flags            bit0=ipv4, bit1=ipv6, bit2=has-ttl, bit3=nx
//     [host_pool] : utf-8                hostname pool
//     [ip_pool]   : utf-8                ip pool
//
// 모드:
//   encode : real-probe (dscacheutil) + dedup → /tmp/dns_cache_dedup.bin
//   bench  : encode + per-host bisect lookup vs linear pre-dedup scan
//
// macOS source (read-only, NO -flushcache, NO mutation):
//   S1: dscacheutil -cachedump   (modern macOS empty)
//   S2: dscacheutil -entries Host (returns static entries, often ~empty)
//   absent → synth fallback (200 entries: apple.com, cdn pool, slack, github, etc.)
//
// R1 HEXA-FIRST. R17: /usr/bin/perl alarm 120s. /usr/bin/python3 절대경로. try/catch 0 in hexa.
// classifier_version=DCDD-v1
// NO production execute. NO -flushcache. NO launchctl. read-only subprocess timeout 5s.

let PAYLOAD = "import sys,os,struct,time,bisect,resource,mmap,array,random,subprocess,re\n" +
"mode=sys.argv[1] if len(sys.argv)>1 else 'bench'\n" +
"BIN='/tmp/dns_cache_dedup.bin'\n" +
"CLASSIFIER='DCDD-v1'\n" +
"\n" +
"FLAG_IPV4=0x01\n" +
"FLAG_IPV6=0x02\n" +
"FLAG_HAS_TTL=0x04\n" +
"FLAG_NX=0x08\n" +
"\n" +
"def fmt(b):\n" +
"    if b>1048576: return f'{b/1048576:.2f}MB'\n" +
"    if b>1024: return f'{b/1024:.1f}KB'\n" +
"    return f'{b}B'\n" +
"def rss():\n" +
"    r=resource.getrusage(resource.RUSAGE_SELF).ru_maxrss\n" +
"    return r if sys.platform=='darwin' else r*1024\n" +
"\n" +
"def run_cmd(args,timeout=5):\n" +
"    try:\n" +
"        p=subprocess.run(args,capture_output=True,timeout=timeout,text=True)\n" +
"        return p.stdout or ''\n" +
"    except Exception:\n" +
"        return ''\n" +
"\n" +
"def synth(n=200,seed=42):\n" +
"    rng=random.Random(seed)\n" +
"    bases=['apple.com','icloud.com','cdn-apple.com','github.com','api.github.com',\n" +
"           'slack.com','wss-mobile.slack.com','discord.com','cdn.discordapp.com',\n" +
"           'googleapis.com','youtube.com','google.com','cloudflare.com','1.1.1.1',\n" +
"           'fastly.net','akamaihd.net','sentry.io','statsd.local','grafana.example']\n" +
"    out=[]\n" +
"    # intentional duplication factor: avg 3x repeat per host to test dedup\n" +
"    for i in range(n):\n" +
"        b=bases[i%len(bases)]\n" +
"        sub='' if i%3==0 else f'sub{i%17}.'\n" +
"        host=sub+b\n" +
"        ip='10.0.'+str(i%256)+'.'+str((i*7)%256)\n" +
"        ttl=rng.choice([60,300,3600,86400])\n" +
"        flg=FLAG_IPV4|FLAG_HAS_TTL\n" +
"        if i%9==0: flg|=FLAG_IPV6; ip='fe80::'+hex(i)[2:]\n" +
"        if i%23==0: flg|=FLAG_NX\n" +
"        out.append((host.lower().rstrip('.'),ip,ttl,flg))\n" +
"        # add duplicate (same host, same ip)\n" +
"        if i%3==1:\n" +
"            out.append((host.lower().rstrip('.'),ip,ttl,flg))\n" +
"        if i%5==2:\n" +
"            out.append((host.lower().rstrip('.'),ip,ttl,flg))\n" +
"    return out\n" +
"\n" +
"def parse_dscacheutil_entries_host(text):\n" +
"    # block-format: 'name: foo\\n  alias: ...\\n  ip_address: 1.2.3.4\\n'\n" +
"    rows=[]\n" +
"    cur_name=None; cur_ip=None\n" +
"    for line in text.splitlines():\n" +
"        ls=line.strip()\n" +
"        if not ls:\n" +
"            if cur_name and cur_ip:\n" +
"                ipv6=':' in cur_ip\n" +
"                flg=FLAG_IPV6 if ipv6 else FLAG_IPV4\n" +
"                rows.append((cur_name.lower().rstrip('.'),cur_ip,0,flg))\n" +
"            cur_name=None; cur_ip=None\n" +
"            continue\n" +
"        if ls.startswith('name:'):\n" +
"            cur_name=ls[5:].strip()\n" +
"        elif ls.startswith('ip_address:'):\n" +
"            cur_ip=ls[11:].strip()\n" +
"    if cur_name and cur_ip:\n" +
"        ipv6=':' in cur_ip\n" +
"        flg=FLAG_IPV6 if ipv6 else FLAG_IPV4\n" +
"        rows.append((cur_name.lower().rstrip('.'),cur_ip,0,flg))\n" +
"    return rows\n" +
"\n" +
"def parse_dscacheutil_cachedump(text):\n" +
"    # legacy format (pre privacy hardening): 'Cache: Host\\nEntries:\\n ...'\n" +
"    rows=[]\n" +
"    for line in text.splitlines():\n" +
"        ls=line.strip()\n" +
"        # heuristic: hostname<sp>...ip pattern\n" +
"        m=re.match(r'^([A-Za-z0-9._-]+)\\s+.*?(\\d+\\.\\d+\\.\\d+\\.\\d+|[0-9a-f:]+:[0-9a-f:]+)',ls)\n" +
"        if m:\n" +
"            host=m.group(1).lower().rstrip('.')\n" +
"            ip=m.group(2)\n" +
"            ipv6=':' in ip\n" +
"            flg=FLAG_IPV6 if ipv6 else FLAG_IPV4\n" +
"            rows.append((host,ip,0,flg))\n" +
"    return rows\n" +
"\n" +
"def real_probe():\n" +
"    rows=[]\n" +
"    src=[]\n" +
"    out=run_cmd(['/usr/bin/dscacheutil','-cachedump'],timeout=3)\n" +
"    if out and 'Unable to get details' not in out:\n" +
"        r=parse_dscacheutil_cachedump(out)\n" +
"        if r: rows.extend(r); src.append('cachedump')\n" +
"    out=run_cmd(['/usr/bin/dscacheutil','-entries','Host'],timeout=5)\n" +
"    if out:\n" +
"        r=parse_dscacheutil_entries_host(out)\n" +
"        if r: rows.extend(r); src.append('entries-host')\n" +
"    if not rows: return [],'empty',0\n" +
"    return rows,'+'.join(src),0\n" +
"\n" +
"def dedup(rows):\n" +
"    # key=(host,ip); merge flags; first-seen ttl wins\n" +
"    d={}\n" +
"    pre=len(rows)\n" +
"    for (h,ip,ttl,flg) in rows:\n" +
"        k=(h,ip)\n" +
"        if k in d:\n" +
"            ph,pi,pt,pf=d[k]\n" +
"            d[k]=(ph,pi,pt or ttl,pf|flg)\n" +
"        else:\n" +
"            d[k]=(h,ip,ttl,flg)\n" +
"    out=list(d.values())\n" +
"    return out,pre\n" +
"\n" +
"def encode(rows):\n" +
"    rows,pre=dedup(rows)\n" +
"    rows=sorted(rows,key=lambda r:(r[0],r[1]))\n" +
"    n=len(rows)\n" +
"    host_pool=bytearray()\n" +
"    ip_pool=bytearray()\n" +
"    h_off=array.array('I',[0]*n); h_len=array.array('I',[0]*n)\n" +
"    i_off=array.array('I',[0]*n); i_len=array.array('I',[0]*n)\n" +
"    ttl=array.array('I',[0]*n)\n" +
"    flags=bytearray(n)\n" +
"    for i,(h,ip,t,f) in enumerate(rows):\n" +
"        hb=h.encode('utf-8','replace'); ib=ip.encode('utf-8','replace')\n" +
"        h_off[i]=len(host_pool); h_len[i]=len(hb); host_pool.extend(hb)\n" +
"        i_off[i]=len(ip_pool); i_len[i]=len(ib); ip_pool.extend(ib)\n" +
"        ttl[i]=int(t)&0xffffffff\n" +
"        flags[i]=f&0xff\n" +
"    header=struct.pack('<4sIIII',b'DCDD',1,n,len(host_pool),len(ip_pool))\n" +
"    with open(BIN,'wb') as f:\n" +
"        f.write(header)\n" +
"        f.write(h_off.tobytes()); f.write(h_len.tobytes())\n" +
"        f.write(i_off.tobytes()); f.write(i_len.tobytes())\n" +
"        f.write(ttl.tobytes()); f.write(bytes(flags))\n" +
"        f.write(bytes(host_pool)); f.write(bytes(ip_pool))\n" +
"    return {'n':n,'pre':pre,'blob_size':os.path.getsize(BIN),'rows':rows}\n" +
"\n" +
"class Blob:\n" +
"    def __init__(self,path):\n" +
"        self.f=open(path,'rb'); self.mm=mmap.mmap(self.f.fileno(),0,prot=mmap.PROT_READ)\n" +
"        magic,ver,n,hps,ips=struct.unpack_from('<4sIIII',self.mm,0)\n" +
"        assert magic==b'DCDD' and ver==1\n" +
"        self.n=n\n" +
"        base=20\n" +
"        a=base; b=a+4*n; c=b+4*n; d=c+4*n; e=d+4*n; ttl_off=e+4*n; flg_off=ttl_off+4*n\n" +
"        hp_off=flg_off+n; ip_off=hp_off+hps\n" +
"        mv=memoryview(self.mm)\n" +
"        ho=array.array('I'); ho.frombytes(bytes(mv[a:a+4*n]))\n" +
"        hl=array.array('I'); hl.frombytes(bytes(mv[b:b+4*n]))\n" +
"        hpool=bytes(mv[hp_off:hp_off+hps])\n" +
"        self.hosts=[hpool[ho[i]:ho[i]+hl[i]] for i in range(n)]\n" +
"        self.flags=bytes(mv[flg_off:flg_off+n])\n" +
"    def lookup(self,host):\n" +
"        hb=host.encode('utf-8') if isinstance(host,str) else host\n" +
"        a=bisect.bisect_left(self.hosts,hb)\n" +
"        if a<len(self.hosts) and self.hosts[a]==hb: return a\n" +
"        return -1\n" +
"    def prefix_count(self,prefix):\n" +
"        pb=prefix.encode('utf-8') if isinstance(prefix,str) else prefix\n" +
"        a=bisect.bisect_left(self.hosts,pb)\n" +
"        b=bisect.bisect_left(self.hosts,pb+b'\\xff\\xff\\xff\\xff')\n" +
"        return b-a\n" +
"    def close(self): self.mm.close(); self.f.close()\n" +
"\n" +
"def linear_lookup(rows,host):\n" +
"    for (h,_,_,_) in rows:\n" +
"        if h==host: return True\n" +
"    return False\n" +
"\n" +
"def bench():\n" +
"    rr,kind,_=real_probe()\n" +
"    if not rr: rr=synth(); kind='synth'\n" +
"    print(f'[classifier] {CLASSIFIER}')\n" +
"    print(f'[source] {kind}  raw_rows={len(rr)}')\n" +
"    t0=time.perf_counter_ns()\n" +
"    info=encode(rr)\n" +
"    t1=time.perf_counter_ns()\n" +
"    dedup_pct=100.0*(1.0-info['n']/max(1,info['pre']))\n" +
"    print(f'[encode] {(t1-t0)/1e6:.2f} ms  pre={info[\"pre\"]}  dedup={info[\"n\"]}  dedup_rate={dedup_pct:.1f}%  blob={fmt(info[\"blob_size\"])}')\n" +
"    if info['n']==0: print('[bench] no entries — skip'); return\n" +
"    rng=random.Random(7)\n" +
"    sample_hosts=[rr[i%len(rr)][0] for i in range(50)]\n" +
"    b=Blob(BIN)\n" +
"    for s in sample_hosts[:3]: b.lookup(s)\n" +
"    t0=time.perf_counter_ns()\n" +
"    bh=0\n" +
"    for s in sample_hosts:\n" +
"        if b.lookup(s)>=0: bh+=1\n" +
"    t1=time.perf_counter_ns()\n" +
"    blob_us=(t1-t0)/1000/len(sample_hosts)\n" +
"    t0=time.perf_counter_ns()\n" +
"    lh=0\n" +
"    for s in sample_hosts:\n" +
"        if linear_lookup(rr,s): lh+=1\n" +
"    t1=time.perf_counter_ns()\n" +
"    lin_us=(t1-t0)/1000/len(sample_hosts)\n" +
"    b.close()\n" +
"    print(f'[query] hits_blob={bh}  hits_linear={lh}')\n" +
"    print(f'  OLD linear scan         : {lin_us:10.1f} us/lookup')\n" +
"    print(f'  NEW blob mmap+bisect    : {blob_us:10.1f} us/lookup')\n" +
"    if blob_us>0: print(f'  speedup                 : {lin_us/blob_us:6.1f}x')\n" +
"    print(f'[packet_reduction_est] dedup_rate={dedup_pct:.1f}% (host,ip) tuple redundancy in source')\n" +
"    print(f'[rss] {fmt(rss())}  elapsed_ok')\n" +
"\n" +
"if mode=='encode':\n" +
"    rr,kind,_=real_probe()\n" +
"    if not rr: rr=synth(); kind='synth'\n" +
"    info=encode(rr)\n" +
"    print(f'[{CLASSIFIER}] encoded {info[\"n\"]} entries (pre={info[\"pre\"]}, {kind}) → {BIN} ({fmt(info[\"blob_size\"])})')\n" +
"elif mode=='bench':\n" +
"    bench()\n" +
"else:\n" +
"    print('usage: encode|bench'); sys.exit(2)\n"

fn run() {
    let argv = args()
    let mut mode = "bench"
    let mut i = 0
    while i < len(argv) {
        let v = argv[i]
        let is_hexa_bin = v.contains("/hexa-lang/") || v == "hexa" || v == "hexa.real"
        let is_self     = v.contains("dns_cache_dedup_shbf")
        if is_hexa_bin == false && is_self == false {
            if v == "encode" || v == "bench" { mode = v }
        }
        i = i + 1
    }
    let tmp_py = "/tmp/dns_cache_dedup_shbf_" + exec("date +%s%N").trim() + ".py"
    write_file(tmp_py, PAYLOAD)
    let cmd = "/usr/bin/perl -e 'alarm 120; exec @ARGV' /usr/bin/python3 '" + tmp_py + "' '" + mode + "' 2>&1; rm -f '" + tmp_py + "'"
    let result = exec(cmd)
    print(result)
}

run()
