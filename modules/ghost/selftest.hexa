// modules/ghost/selftest.hexa — leak pre-flight + fingerprint check (cond.8)
//
// 책임:
//   1. DNS leak — 시스템 첫 nameserver 가 공개 DNS (8.8.8.8 / 1.1.1.1 / KR ISP
//      168.126.x.x / 210.220.x.x 등) 인지 확인. Mullvad up 상태에서 공개 DNS
//      가 첫 resolver 면 leak. mk1 은 Mullvad pushed DNS (10.64.0.x)
//      또는 link-local 만 통과해야 PASS.
//   2. IPv6 leak — IPv6 default route 가 물리 인터페이스 (en*) 로 나가면 FAIL.
//      tunnel 인터페이스 (utun* / wg*) 로 나가거나 default route 자체가 없으면 PASS.
//   3. WebRTC leak — 네트워크 레이어 단독 해결 불가 → 항상 GUIDANCE.
//   4. SNI fingerprint — ECH 가용성은 destination 서버 의존 → 항상 GUIDANCE.
//
// 호출 시점:
//   - broadcast tier 직전 (route.hexa::ghost_up sweep/broadcast_high_value 끝).
//   - 결과 verdict != "PASS" 면 wraith W4 broadcast 게이트가 거부 (cond.6).
//
// 계약 (cpre/contracts.ai.md):
//   G1 — outbound 프로브는 wrap_mullvad 가 up 일 때만. mullvad down → SKIP
//        (FAIL 아님 — 프로브 수행 자체가 불가능한 상태).
//   G2 — leak 검출 시 노출된 IP/qname/엔드포인트 절대 기록 금지. 라벨만
//        ("leak detected: <kind>"). state/leak_reports/<ts>.jsonl 도 PASS/FAIL
//        라벨만 + no_content:true.
//   G6 — 결과 sentinel `__GHOST_SELFTEST__ <kind> <PASS|FAIL|SKIP|GUIDANCE>`
//        per-probe + 마지막 `__GHOST_SELFTEST__ all <PASS|FAIL>`.
//   G8 — 프로브 통과 트래픽도 ghost route 통과 — 즉 mullvad tunnel 활성 시에만
//        의미. 미활성 시 SKIP.
//
// hexa stage1 caveat: bool/string mixed 표현식, regex match 미지원 — substring
// 검색 (str.contains 미존재 시 exec grep 사용) 으로 우회.
//
// 상태: ghost.cond.8 — 4 종 leak probe 활성화 (mk1 — DNS/IPv6 active, WebRTC/
// SNI guidance-only).

use "../../core/core"

let GHOST_SELFTEST_SENTINEL = "__GHOST_SELFTEST__"
let WRAP_MV_PATH = "modules/ghost/wrap_mullvad.hexa"
let LEAK_REPORTS_DIR = "state/leak_reports"

// ---------------------------------------------------------------------------
// 내부 — Mullvad 상태 게이트 (G1)
// 프로브는 mullvad up 일 때만 의미. 미활성 시 SKIP — FAIL 이 아님 (probe
// 수행 불가 ≠ leak 발견).
// ---------------------------------------------------------------------------

fn _mv_health() -> str {
    return exec("hexa run " + WRAP_MV_PATH + " health 2>/dev/null").trim()
}

fn _mv_available() -> bool {
    return exec("hexa run " + WRAP_MV_PATH + " available 2>/dev/null").trim() == "yes"
}

// ---------------------------------------------------------------------------
// Probe 1: DNS leak
//
// 검사: scutil --dns (mac) 또는 /etc/resolv.conf (linux) 의 첫 nameserver 가
// 공개 DNS / KR ISP DNS 패턴이면 leak.
//
// G2: leak 검출 시에도 실제 nameserver IP 는 우리 메모리/로그에 들이지 않음 —
// grep -c 카운트만 추출.
//
// 공개 DNS 패턴 (블랙리스트):
//   8.8.8.8 / 8.8.4.4         google
//   1.1.1.1 / 1.0.0.1         cloudflare
//   9.9.9.9                   quad9
//   208.67.220.220            opendns
//   168.126.63.1 / 210.220.   KR KT/SK telecom
//
// PASS 조건: 위 패턴 중 하나도 매치 안 됨.
// ---------------------------------------------------------------------------

fn _probe_dns_leak_kind() -> str {
    // mac: scutil --dns; linux: /etc/resolv.conf
    let cmd = "if [ \"$(uname)\" = \"Darwin\" ]; then scutil --dns 2>/dev/null | awk '/nameserver\\[0\\]/ {print $3; exit}'; else awk '/^nameserver/ {print $2; exit}' /etc/resolv.conf 2>/dev/null; fi"

    // G2: 검사를 한 줄 shell 안에서 끝내고 라벨만 stdout 으로 받음.
    // grep -c 만 사용 — 매치된 IP 자체는 hexa 메모리에 들어오지 않음.
    let leak_count = exec(cmd + " | grep -c -E '^(8\\.8\\.(8\\.8|4\\.4)|1\\.(1\\.1\\.1|0\\.0\\.1)|9\\.9\\.9\\.9|208\\.67\\.|168\\.126\\.|210\\.220\\.)' 2>/dev/null").trim()

    if leak_count == "0" {
        // 추가: nameserver 자체가 비어있으면 (DNS 없음) 보수적 PASS — 트래픽
        // 자체가 안 되니 leak 도 없음.
        return "PASS"
    }
    return "FAIL"
}

fn selftest_dns_leak() -> str {
    if !_mv_available() {
        return "SKIP"
    }
    let h = _mv_health()
    if h != "up" {
        return "SKIP"
    }
    return _probe_dns_leak_kind()
}

// ---------------------------------------------------------------------------
// Probe 2: IPv6 leak
//
// 검사: IPv6 default route 가 tunnel 인터페이스 (utun*, wg*, ipsec*) 로
// 향하는지. 물리 인터페이스 (en*, eth*, wlan*) 로 향하면 leak.
//
// PASS 조건:
//   (a) IPv6 default route 자체가 없음 (ifconfig 에 inet6 가 link-local /
//       loopback 외 없음) — 가장 안전.
//   (b) IPv6 default route 가 utun*/wg*/ipsec* 로 향함.
// FAIL: en*/eth*/wlan* 로 향함.
//
// G2: 인터페이스명만 카운트, 실제 IPv6 주소 / gateway 는 hexa 메모리에 안 들임.
// ---------------------------------------------------------------------------

fn _probe_ipv6_leak_kind() -> str {
    // mac: route -n get -inet6 default 의 'interface:' 라인
    // linux: ip -6 route show default 의 'dev <ifname>'
    let cmd_mac = "route -n get -inet6 default 2>/dev/null | awk '/interface:/ {print $2}'"
    let cmd_linux = "ip -6 route show default 2>/dev/null | awk '{for(i=1;i<=NF;i++) if($i==\"dev\") print $(i+1)}' | head -1"
    let cmd = "if [ \"$(uname)\" = \"Darwin\" ]; then " + cmd_mac + "; else " + cmd_linux + "; fi"

    // tunnel 인터페이스 카운트
    let tunnel_match = exec("(" + cmd + ") 2>/dev/null | grep -c -E '^(utun|wg|ipsec|tun)[0-9]*$'").trim()
    // 물리 인터페이스 카운트
    let phys_match = exec("(" + cmd + ") 2>/dev/null | grep -c -E '^(en|eth|wlan|wlp|enp)[0-9a-z]*$'").trim()
    // default route 자체가 없을 수도
    let any_iface = exec("(" + cmd + ") 2>/dev/null | wc -l | tr -d ' '").trim()

    if phys_match != "0" {
        return "FAIL"
    }
    if tunnel_match != "0" {
        return "PASS"
    }
    // default route 없음 — IPv6 자체 비활성. PASS (보수적).
    if any_iface == "0" {
        return "PASS"
    }
    // route 라인은 있지만 패턴 매치 안 됨 (lo0 등) — 보수적 PASS.
    return "PASS"
}

fn selftest_ipv6_leak() -> str {
    if !_mv_available() {
        return "SKIP"
    }
    let h = _mv_health()
    if h != "up" {
        return "SKIP"
    }
    return _probe_ipv6_leak_kind()
}

// ---------------------------------------------------------------------------
// Probe 3: WebRTC leak — application-layer (브라우저 STUN/ICE), 네트워크
// 레이어 단독 해결 불가. 항상 GUIDANCE 반환.
// ---------------------------------------------------------------------------

fn selftest_webrtc_leak() -> str {
    return "GUIDANCE: configure browser WebRTC settings"
}

fn _webrtc_guidance_text() -> str {
    return "Safari: Develop → WebRTC → Disable Non-Proxied UDP. Chrome: WebRTC Network Limiter ext or about:flags. Firefox: media.peerconnection.enabled=false (about:config)."
}

// ---------------------------------------------------------------------------
// Probe 4: SNI fingerprint — ECH (Encrypted Client Hello) 가용성은 destination
// 서버 의존. 항상 GUIDANCE 반환.
// ---------------------------------------------------------------------------

fn selftest_sni_fingerprint() -> str {
    return "GUIDANCE: verify ECH for sweep dest"
}

fn _sni_guidance_text() -> str {
    return "Verify Slipstream / sweep destinations support ECH (Encrypted Client Hello). Cloudflare-fronted endpoints honor ECH on TLS 1.3; bare origins typically do not."
}

// ---------------------------------------------------------------------------
// Run-all + sentinel emit + leak report write
// ---------------------------------------------------------------------------

fn _ts_compact() -> str {
    // 2026-05-04T11-23-45Z (콜론 → 하이픈, 파일명 안전)
    return exec("date -u +%Y-%m-%dT%H-%M-%SZ").trim()
}

fn _ts_iso() -> str {
    return exec("date -u +%Y-%m-%dT%H:%M:%SZ").trim()
}

fn _verdict(dns: str, ipv6: str) -> str {
    // PASS 조건: dns + ipv6 가 모두 PASS 또는 SKIP.
    // FAIL 조건: dns 또는 ipv6 가 FAIL.
    // webrtc / sni 는 GUIDANCE — verdict 에 영향 없음.
    if dns == "FAIL" { return "FAIL" }
    if ipv6 == "FAIL" { return "FAIL" }
    return "PASS"
}

fn _write_leak_report(ts_iso: str, dns: str, ipv6: str, webrtc: str, sni: str, verdict: str) -> str {
    let fname = LEAK_REPORTS_DIR + "/" + _ts_compact() + ".jsonl"
    // G2: payload 없음 — 라벨만. webrtc/sni 는 "GUIDANCE" 라벨로 단축.
    let webrtc_label = "GUIDANCE"
    let sni_label = "GUIDANCE"
    let json = "{\"ts\":\"" + ts_iso + "\",\"probes\":{\"dns\":\"" + dns + "\",\"ipv6\":\"" + ipv6 + "\",\"webrtc\":\"" + webrtc_label + "\",\"sni\":\"" + sni_label + "\"},\"verdict\":\"" + verdict + "\",\"no_content\":true}"
    let _r = exec("mkdir -p " + LEAK_REPORTS_DIR + " 2>/dev/null && printf '%s\\n' '" + json + "' >> " + fname)
    return fname
}

fn selftest_run_all() -> str {
    let dns = selftest_dns_leak()
    println(GHOST_SELFTEST_SENTINEL + " dns_leak " + dns)
    if dns == "FAIL" {
        println(GHOST_SELFTEST_SENTINEL + " note: leak detected: dns")
    }

    let ipv6 = selftest_ipv6_leak()
    println(GHOST_SELFTEST_SENTINEL + " ipv6_leak " + ipv6)
    if ipv6 == "FAIL" {
        println(GHOST_SELFTEST_SENTINEL + " note: leak detected: ipv6")
    }

    let webrtc = selftest_webrtc_leak()
    println(GHOST_SELFTEST_SENTINEL + " webrtc_leak " + webrtc)

    let sni = selftest_sni_fingerprint()
    println(GHOST_SELFTEST_SENTINEL + " sni_fingerprint " + sni)

    let verdict = _verdict(dns, ipv6)
    let path = _write_leak_report(_ts_iso(), dns, ipv6, webrtc, sni, verdict)

    println(GHOST_SELFTEST_SENTINEL + " all " + verdict)
    return verdict
}

fn selftest() -> void {
    let _v = selftest_run_all()
}

// ---------------------------------------------------------------------------
// CLI entrypoint
//   hexa run modules/ghost/selftest.hexa <sub>
//     self-test | run-all          (synonyms)
//     dns-leak | ipv6-leak | webrtc-leak | sni-fingerprint
// ---------------------------------------------------------------------------

fn main() -> void {
    let a = args()
    if len(a) < 3 {
        println("usage: hexa run modules/ghost/selftest.hexa <sub>")
        println("  self-test | run-all")
        println("  dns-leak | ipv6-leak | webrtc-leak | sni-fingerprint")
        return
    }
    let sub = a[2]
    if sub == "self-test" { selftest(); return }
    if sub == "--selftest" { selftest(); return }
    if sub == "run-all" { selftest(); return }
    if sub == "--run-all" { selftest(); return }
    if sub == "dns-leak" {
        let r = selftest_dns_leak()
        println(GHOST_SELFTEST_SENTINEL + " dns_leak " + r)
        return
    }
    if sub == "ipv6-leak" {
        let r = selftest_ipv6_leak()
        println(GHOST_SELFTEST_SENTINEL + " ipv6_leak " + r)
        return
    }
    if sub == "webrtc-leak" {
        let r = selftest_webrtc_leak()
        println(GHOST_SELFTEST_SENTINEL + " webrtc_leak " + r)
        println(GHOST_SELFTEST_SENTINEL + " webrtc_leak guidance: " + _webrtc_guidance_text())
        return
    }
    if sub == "sni-fingerprint" {
        let r = selftest_sni_fingerprint()
        println(GHOST_SELFTEST_SENTINEL + " sni_fingerprint " + r)
        println(GHOST_SELFTEST_SENTINEL + " sni_fingerprint guidance: " + _sni_guidance_text())
        return
    }
    println("unknown subcommand: " + sub)
}
