// modules/ghost/live_verify.hexa — ghost mk1 host-mode live verifier (.hexa-only)
//
// 책임:
//   1. 호스트에 mullvad / tor / nym CLI 설치 후 12 cond live PASS 검증.
//   2. sandbox SKIP vs host PASS 분리 — 호스트 PATH probe + sentinel parse.
//   3. cross-repo gate smoke test (wraith W4 + orpheus link adapter).
//
// 사용:
//   airgenome ghost live-verify
//   또는 직접: hexa run modules/ghost/live_verify.hexa run-all
//
// 운영 정책:
//   - sudo 절대 호출 X (cond.9 kernel pf 활성화는 별개 운영자 step).
//   - broadcast / upload / sign 절대 X.
//   - state/* 디렉토리는 read-only — audit/selftest 모듈이 자체 emit 하는
//     selftest row 는 그 모듈의 정상 동작 (verifier 가 직접 쓰는 게 아님).
//   - idempotent — 반복 실행 안전.
//
// hexa-lang stage1 caveat: import-as-alias void → 모든 cross-file 호출은
// hexa run subprocess 경유 (orpheus blk.3 / ghost cond.4 와 동일 패턴).
//
// 상태: ghost mk1 closure 시점 (2026-05-04) 의 .sh 버전을 .hexa 로 포팅.
//
// User mandate 2026-05-04: "use .hexa only".

use "../../core/core"

let GHOST_DIR = "modules/ghost"

// path 상대 — bin/airgenome cmd_ghost 가 cd $ag_root 후 호출. 또는 직접 hexa
// run 시 project root 에서 실행 가정.
let WRAP_MV_PATH    = GHOST_DIR + "/wrap_mullvad.hexa"
let WRAP_TOR_PATH   = GHOST_DIR + "/wrap_tor.hexa"
let WRAP_NYM_PATH   = GHOST_DIR + "/wrap_nym.hexa"
let POLICY_PATH     = GHOST_DIR + "/policy.hexa"
let AUDIT_PATH      = GHOST_DIR + "/audit.hexa"
let SELFTEST_PATH   = GHOST_DIR + "/selftest.hexa"
let ROUTE_PATH      = GHOST_DIR + "/route.hexa"

// cross-repo paths — env override 우선, fallback 은 home 표준 위치.
fn _wraith_root() -> str {
    let e = env("WRAITH_ROOT")
    if e != "" { return e }
    return env("HOME") + "/core/wraith-wallet"
}
fn _orpheus_root() -> str {
    let e = env("ORPHEUS_ROOT")
    if e != "" { return e }
    return env("HOME") + "/core/orpheus"
}

// ---------------------------------------------------------------------------
// 내부 — exec helpers
// ---------------------------------------------------------------------------

fn _have_bin(name: str) -> bool {
    return exec("command -v " + name + " 2>/dev/null").trim() != ""
}

fn _path_exists(p: str) -> bool {
    return exec("test -e " + p + " && echo y").trim() == "y"
}

fn _dir_exists(p: str) -> bool {
    return exec("test -d " + p + " && echo y").trim() == "y"
}

fn _run(script: str, args: str) -> str {
    return exec("hexa run " + script + " " + args + " 2>&1").trim()
}

fn _has(out: str, needle: str) -> bool {
    let r = exec("printf '%s' \"" + out + "\" | grep -F " + "'" + needle + "'" + " >/dev/null 2>&1 && echo y").trim()
    return r == "y"
}

// ---------------------------------------------------------------------------
// Per-cond probes — 각 fn 은 "PASS|FAIL|N/A: <detail>" 한 줄 반환
// ---------------------------------------------------------------------------

fn cond_0() -> str {
    let m = exec("ls docs/ghost_feature_design_inbox_*.ai.md 2>/dev/null | head -1").trim()
    if m == "" { return "FAIL: docs/ghost_feature_design_inbox missing" }
    let s = exec("grep -E '^status: (draft_inbox|draft|ready)' " + m + " 2>/dev/null | head -1").trim()
    if s == "" { return "FAIL: frontmatter status<draft_inbox" }
    return "PASS: " + m
}

fn cond_1() -> str {
    let req = "cpre/intent.ai.md cpre/scope.ai.md cpre/contracts.ai.md cpre/identity.ai.md module.ai.md route.hexa wrap_mullvad.hexa wrap_tor.hexa wrap_nym.hexa policy.hexa audit.hexa selftest.hexa .roadmap.ghost"
    let cmd = "missing=''; for f in " + req + "; do test -e " + GHOST_DIR + "/$f || missing=\"$missing $f\"; done; printf '%s' \"$missing\""
    let missing = exec(cmd).trim()
    if missing == "" { return "PASS: all 13 files present" }
    return "FAIL: missing" + missing
}

fn cond_2() -> str {
    if !_have_bin("mullvad") { return "N/A: mullvad CLI not installed" }
    let out = _run(WRAP_MV_PATH, "self-test")
    if _has(out, "__GHOST_WRAP_MULLVAD__ PASS") { return "PASS: mullvad CLI + selftest PASS" }
    if _has(out, "__GHOST_WRAP_MULLVAD__ SKIP") { return "PASS: mullvad on PATH; selftest SKIP under docker route" }
    return "FAIL: selftest sentinel missing"
}

fn cond_3() -> str {
    if !_have_bin("tor") { return "N/A: system tor not installed" }
    let out = _run(WRAP_TOR_PATH, "self-test")
    // G8 — KR exit deny presence in any torrc candidate
    let kr = exec("grep -lE 'ExcludeExitNodes|ExcludeNodes' /usr/local/etc/tor/torrc /opt/homebrew/etc/tor/torrc /etc/tor/torrc $HOME/.tor/torrc 2>/dev/null | head -1").trim()
    if _has(out, "__GHOST_WRAP_TOR__ PASS") {
        if kr == "" { return "PASS: tor reachable; G8 ExcludeExitNodes {kr} setting recommended in torrc" }
        return "PASS: tor + G8 KR exclude found in " + kr
    }
    if _has(out, "__GHOST_WRAP_TOR__ SKIP") { return "PASS: tor on PATH; selftest SKIP under docker route" }
    return "FAIL: selftest sentinel missing"
}

fn cond_4() -> str {
    // bin/airgenome 은 docker route 안에서 PATH 미도달 — 정적 grep 으로 cmd_ghost
    // 대시패치 구현 검증 (cond.4 evidence 의 핵심).
    let h = exec("grep -c 'tunnel-alive\\|cmd_ghost' bin/airgenome 2>/dev/null").trim()
    if h == "" { return "FAIL: bin/airgenome 미접근" }
    if h == "0" { return "FAIL: bin/airgenome 에 cmd_ghost / tunnel-alive 없음" }
    let out = _run(ROUTE_PATH, "self-test")
    if _has(out, "__GHOST_ROUTE__ PASS") { return "PASS: cmd_ghost wired + route selftest PASS" }
    if _has(out, "__GHOST_ROUTE__ SKIP") { return "PASS: cmd_ghost wired; route selftest SKIP under docker route" }
    return "FAIL: route selftest sentinel missing"
}

fn cond_5() -> str {
    let out = _run(POLICY_PATH, "self-test")
    if _has(out, "__GHOST_POLICY__ PASS") { return "PASS: 5 fns + selftest PASS" }
    return "FAIL: __GHOST_POLICY__ PASS sentinel missing"
}

fn cond_6() -> str {
    // docker route 안 — bin/airgenome 직접 호출 대신 route.hexa 직호출.
    // ghost-internal half: route.hexa tunnel-alive 가 yes|no 반환.
    let r = _run(ROUTE_PATH, "tunnel-alive")
    let valid_yes = _has(r, "yes")
    let valid_no = _has(r, "no")
    if !valid_yes {
        if !valid_no { return "FAIL: route tunnel-alive returned unexpected: " + r }
    }
    // wraith side (cross-repo) — 옵션.
    let wpath = _wraith_root() + "/modules/link/ghost.hexa"
    if !_path_exists(wpath) { return "PASS: ghost-internal (wraith repo absent)" }
    let wout = _run(wpath, "self-test")
    if _has(wout, "__WRAITH_LINK_GHOST__ PASS") { return "PASS: ghost-internal + wraith link selftest PASS" }
    if _has(wout, "__WRAITH_LINK_GHOST__ SKIP") { return "PASS: ghost-internal + wraith link SKIP" }
    return "FAIL: wraith link selftest sentinel missing"
}

fn cond_7() -> str {
    let out = _run(AUDIT_PATH, "self-test")
    if _has(out, "__GHOST_AUDIT__ PASS") { return "PASS: G2 + emit + reject + downgrade selftest PASS" }
    return "FAIL: __GHOST_AUDIT__ PASS sentinel missing"
}

fn cond_8() -> str {
    let out = _run(SELFTEST_PATH, "run-all")
    if _has(out, "__GHOST_SELFTEST__ all PASS") { return "PASS: leak preflight all PASS" }
    if _has(out, "__GHOST_SELFTEST__ all FAIL") { return "FAIL: leak detected (see state/leak_reports/)" }
    return "FAIL: __GHOST_SELFTEST__ all sentinel missing"
}

fn cond_9() -> str {
    // docker route 안 — bin/airgenome 호출 대신 policy.hexa 직호출.
    let st = _run(POLICY_PATH, "kernel-kill-switch-status")
    if _has(st, "enabled") { return "PASS: capability flag enabled (operator pf activation may be pending)" }
    if _has(st, "disabled") { return "PASS: status=disabled (operator opt-in by design — flag off until activated)" }
    return "FAIL: kernel-kill-switch-status returned: " + st
}

fn cond_10() -> str {
    let have = _have_bin("nym-vpn-cli") || _have_bin("nymvpn-cli") || _have_bin("nymvpn-x") || _have_bin("nym-vpnd")
    if !have { return "N/A: no nym-vpn-cli/nymvpn-cli/nymvpn-x/nym-vpnd on PATH" }
    let out = _run(WRAP_NYM_PATH, "self-test")
    if _has(out, "__GHOST_WRAP_NYM__ PASS") { return "PASS: NymVPN client + selftest PASS" }
    if _has(out, "__GHOST_WRAP_NYM__ SKIP") { return "PASS: NymVPN binary on PATH; selftest SKIP under docker route" }
    return "FAIL: __GHOST_WRAP_NYM__ sentinel missing"
}

fn cond_11() -> str {
    let opath = _orpheus_root() + "/modules/link/ghost.hexa"
    let wpath = _wraith_root() + "/modules/link/ghost.hexa"
    let oexists = _path_exists(opath)
    let wexists = _path_exists(wpath)
    if !oexists {
        if !wexists { return "N/A: neither orpheus nor wraith link/ghost.hexa present" }
    }
    let oresult = "skip"
    let wresult = "skip"
    if oexists {
        let o = _run(opath, "self-test")
        if _has(o, "__ORPHEUS_LINK_GHOST__ PASS") { oresult = "PASS" }
        if _has(o, "__ORPHEUS_LINK_GHOST__ SKIP") { oresult = "PASS-skip" }
    }
    if wexists {
        let w = _run(wpath, "self-test")
        if _has(w, "__WRAITH_LINK_GHOST__ PASS") { wresult = "PASS" }
        if _has(w, "__WRAITH_LINK_GHOST__ SKIP") { wresult = "PASS-skip" }
    }
    return "PASS: orpheus=" + oresult + " wraith=" + wresult
}

// ---------------------------------------------------------------------------
// run_all — 12 cond 순회, 결과 표 출력 + 최종 verdict
// ---------------------------------------------------------------------------

fn _line(num: str, label: str, result: str) -> str {
    // num: "0"-"11", label: 한 줄 짧은 라벨, result: "PASS|FAIL|N/A: detail"
    return "cond." + num + "  " + label + "  " + result
}

fn _count_prefix(rows: str, prefix: str) -> int {
    // rows = newline-joined "cond.X ... PASS|FAIL|N/A:" lines
    let cmd = "printf '%s' \"" + rows + "\" | grep -c '" + prefix + "'"
    let n = exec(cmd).trim()
    if n == "" { return 0 }
    return to_int(n)
}

fn run_all() -> int {
    println("🕶️  ghost mk1 live verifier — host-mode results")
    println("AIRGENOME_ROOT=" + exec("pwd").trim())
    println("WRAITH_ROOT=" + _wraith_root() + "  (" + (if _dir_exists(_wraith_root()) { "present" } else { "absent" }) + ")")
    println("ORPHEUS_ROOT=" + _orpheus_root() + "  (" + (if _dir_exists(_orpheus_root()) { "present" } else { "absent" }) + ")")
    println("─────────────────────────────────────────────────────────────────")

    let rows = ""
    rows = rows + _line("0",  "docs/ghost_feature_design_inbox             ", cond_0())  + "\n"
    rows = rows + _line("1",  "skeleton (cpre/4 + 7 stub.hexa)              ", cond_1())  + "\n"
    rows = rows + _line("2",  "wrap_mullvad (mullvad-cli)                   ", cond_2())  + "\n"
    rows = rows + _line("3",  "wrap_tor                                     ", cond_3())  + "\n"
    rows = rows + _line("4",  "route.hexa + airgenome ghost CLI             ", cond_4())  + "\n"
    rows = rows + _line("5",  "policy (exit/g5/kr-tor/payment/downgrade)    ", cond_5())  + "\n"
    rows = rows + _line("6",  "kill-switch (tunnel-alive + wraith W4)       ", cond_6())  + "\n"
    rows = rows + _line("7",  "audit (metadata-only emit + G2 reject)       ", cond_7())  + "\n"
    rows = rows + _line("8",  "selftest (DNS/IPv6/WebRTC/SNI)               ", cond_8())  + "\n"
    rows = rows + _line("9",  "capability flag (kernel kill-switch opt-in)  ", cond_9())  + "\n"
    rows = rows + _line("10", "wrap_nym (NymVPN client)                     ", cond_10()) + "\n"
    rows = rows + _line("11", "integration (orpheus + wraith link/ghost)    ", cond_11()) + "\n"

    print(rows)

    let pass = _count_prefix(rows, " PASS")
    let fail = _count_prefix(rows, " FAIL")
    let na   = _count_prefix(rows, " N/A")

    println("─────────────────────────────────────────────────────────────────")
    if fail > 0 {
        println("verdict: FAIL — " + to_string(pass) + " passed, " + to_string(fail) + " failed, " + to_string(na) + " N/A")
        return 1
    }
    if na > 0 {
        println("verdict: PARTIAL — " + to_string(pass) + " passed, 0 failed, " + to_string(na) + " N/A (install Tor/Nym for full coverage)")
        return 0
    }
    println("verdict: PASS — " + to_string(pass) + " passed, 0 failed, 0 N/A")
    return 0
}

// ---------------------------------------------------------------------------
// CLI entrypoint
// ---------------------------------------------------------------------------

fn main() -> void {
    let a = args()
    if len(a) < 3 {
        let _r = run_all()
        return
    }
    let sub = a[2]
    if sub == "run-all" || sub == "self-test" {
        let _r = run_all()
        return
    }
    if sub == "cond.0" { println(cond_0()); return }
    if sub == "cond.1" { println(cond_1()); return }
    if sub == "cond.2" { println(cond_2()); return }
    if sub == "cond.3" { println(cond_3()); return }
    if sub == "cond.4" { println(cond_4()); return }
    if sub == "cond.5" { println(cond_5()); return }
    if sub == "cond.6" { println(cond_6()); return }
    if sub == "cond.7" { println(cond_7()); return }
    if sub == "cond.8" { println(cond_8()); return }
    if sub == "cond.9" { println(cond_9()); return }
    if sub == "cond.10" { println(cond_10()); return }
    if sub == "cond.11" { println(cond_11()); return }
    println("usage: hexa run modules/ghost/live_verify.hexa { run-all | cond.0 .. cond.11 }")
}
