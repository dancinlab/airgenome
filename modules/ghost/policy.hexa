// modules/ghost/policy.hexa — exit allowlist + G5 knowledge guard + G10 downgrade matrix
//
// 책임:
//   1. tier 별 exit jurisdiction 화이트리스트 검증 (sweep / broadcast_high_value
//      = JP/SG/CH/SE 만, research = + KR 허용 — Korbit OTC / KR 학술자료).
//   2. KR Tor exit 절대 차단 (`ALLOW_KR_TOR_EXIT = false` 하드코딩).
//   3. G5 knowledge guard — caller 에서 puzzle/BIP39/tx-hex 등 recovery/wallet
//      payload 흔적 발견 시 explicit reject. 페이로드 자체는 절대 기록 X.
//   4. payment_source ↔ tier 호환성 게이트 — docs/ghost_payment_strategy_2026_05_04
//      §E. 카드 직판으로 broadcast 트리거 같은 운영자 실수 방지.
//   5. G10 downgrade decision — backend down 시 fall-back 허용 여부 분기.
//      audit 기록은 audit.hexa 의 audit_emit_downgrade() 가 담당 (cond.7).
//   6. capability flag — kernel pf/NE 활성화 여부 (cond.9 opt-in).
//
// 계약 (cpre/contracts.ai.md):
//   G4 — kill-switch 는 fail-closed. 의심스러운 상태 (tunnel down/degraded) 면
//        무조건 dependent op 거부. 본 파일은 status 라벨만 반환 — 실 enforcement
//        는 wraith/orpheus link 측 + cond.9 kernel pf.
//   G5 — payload_kind 가 화이트리스트 (tier_label/health_query/exit_jurisdiction)
//        외이면 reject. 위반 자체만 라벨로 반환, 실 페이로드는 안 봄.
//   G8 — exit_jurisdiction 인자가 화이트리스트에 없으면 reject. KR Tor exit 은
//        별도 함수로 hard-deny.
//   G10 — downgrade 는 매트릭스 명시 — broadcast_high_value→sweep,
//         sweep→research-degraded 만 허용. 그 외 (특히 upgrade) 모두 거부.
//
// 외부 의존성:
//   - 없음. 순수 정책 로직 — 외부 네트워크 호출 / 디스크 I/O / subprocess 모두 X.
//   - audit_emit_downgrade() 는 caller (route.hexa) 가 별도 호출.
//
// hexa stage1 caveat: try/catch / import-as-alias 미사용. let 은 mutable.
// args() 는 argv 배열 반환 (a[0]=hexa, a[1]=script, a[2..]=user args).
//
// 상태: ghost.cond.5 met candidate (selftest sentinel + 4 함수 + CLI surface).

use "../../core/core"

// ---------------------------------------------------------------------------
// Constants — externally observable invariants
// ---------------------------------------------------------------------------

// Sweep / broadcast_high_value 티어에 허용된 exit ISO-2 (uppercase, comma-sep).
// G8 hard invariant — KR 절대 X. 변경은 정책 결정 (.roadmap.ghost cond.5).
let SWEEP_EXIT_ALLOWLIST = "JP,SG,CH,SE"

// Research 티어 — Korbit OTC / KR 학술자료 접근 위해 KR 허용. + 일반 foreign.
// (US/DE 등은 mk1 단계에서 추가 필요 시 확장.)
let RESEARCH_EXIT_ALLOWLIST = "JP,SG,CH,SE,KR,US,DE,NL,FR,UK"

// G8 hard invariant — KR Tor exit 절대 차단. 코드 레벨 invariant. 절대 true 금지.
let ALLOW_KR_TOR_EXIT = false

// capability flag (cond.9) — kernel pf/NetworkExtension 활성화 여부.
// false = userland-only 협력 게이트. mk1 default.
//
// 컴파일 타임 default 는 false. 런타임 토글은 ~/.airgenome/ghost_capability
// (mode 0600, key=value 한 줄당) 에 operator 가 명시 opt-in 한 경우에만
// policy_kernel_kill_switch_enabled() 가 true 를 반환. 자동 활성화 절대 X.
let KERNEL_KILL_SWITCH_ENABLED = false

// capability flag 파일 — operator-private (HOME 기준).
// 라인 형식: kill_switch=on   |   kill_switch=off
// 파일 부재 / 키 부재 / 알 수 없는 값 → 모두 default false (fail-closed).
let CAPABILITY_FLAG_NAME = "kill_switch"

let AUDIT_PATH = "modules/ghost/audit.hexa"

let SELFTEST_SENTINEL = "__GHOST_POLICY__"

// ---------------------------------------------------------------------------
// Internal — comma-list 검색. fail-closed: 빈 토큰 / 빈 needle 거부.
// ---------------------------------------------------------------------------

fn _csv_contains(csv: str, needle: str) -> bool {
    if needle == "" { return false }
    if csv == "" { return false }
    let parts = csv.split(",")
    let mut i = 0
    while i < len(parts) {
        if parts[i] == needle { return true }
        i = i + 1
    }
    return false
}

// ---------------------------------------------------------------------------
// G8 — policy_check_exit
//   tier=research            → RESEARCH allowlist (KR 허용)
//   tier=sweep               → SWEEP allowlist (foreign-only)
//   tier=broadcast_high_value → SWEEP allowlist
//   tier=customer             → DEFER (Phase 2) — 항상 reject in mk1
//   기타 tier / 빈 jurisdiction → reject (fail-closed)
// jurisdiction 은 ISO-2 uppercase ("JP", "KR", ...).
// ---------------------------------------------------------------------------

fn policy_check_exit(tier: str, jurisdiction: str) -> bool {
    if jurisdiction == "" { return false }
    if tier == "" { return false }
    if tier == "customer" { return false }
    if tier == "research" {
        return _csv_contains(RESEARCH_EXIT_ALLOWLIST, jurisdiction)
    }
    if tier == "sweep" {
        return _csv_contains(SWEEP_EXIT_ALLOWLIST, jurisdiction)
    }
    if tier == "broadcast_high_value" {
        return _csv_contains(SWEEP_EXIT_ALLOWLIST, jurisdiction)
    }
    return false
}

// ---------------------------------------------------------------------------
// G5 — policy_check_g5_clean
//   허용 payload_kind: "tier_label", "health_query", "exit_jurisdiction".
//   거부 (recovery/wallet 흔적): "puzzle_id", "bip39_candidate", "owner_proof",
//     "tx_hex", "private_key", "wif", "xpub", "xprv", "seed_phrase", "address".
//   기타 unknown payload_kind → reject (fail-closed).
// 위반 사실만 boolean 반환 — caller 가 audit emit 시점에 라벨만 기록.
// ---------------------------------------------------------------------------

fn policy_check_g5_clean(payload_kind: str) -> bool {
    if payload_kind == "" { return false }
    if payload_kind == "tier_label" { return true }
    if payload_kind == "health_query" { return true }
    if payload_kind == "exit_jurisdiction" { return true }
    return false
}

// ---------------------------------------------------------------------------
// G8 — policy_check_kr_tor_exit
//   country (ISO-2 uppercase) 가 KR 이면 true (즉 차단해야 할 케이스).
//   false 면 KR 가 아니므로 KR-Tor-deny 룰 미적용.
// route.hexa 가 wrap_tor 호출 직전에 검사 → true 면 즉시 거부.
// ---------------------------------------------------------------------------

fn policy_check_kr_tor_exit(country: str) -> bool {
    if country == "KR" { return true }
    return false
}

// ---------------------------------------------------------------------------
// payment_source ↔ tier 호환성 — docs/ghost_payment_strategy_2026_05_04 §E.
//   payment_source ∈ { "card_direct" | "card_reseller" | "cash" | "monero" | "unknown" }
//   tier=research              → 모든 payment_source OK.
//   tier=sweep                 → !card_direct (최소 1-layer 분리 필요).
//   tier=broadcast_high_value  → cash | monero only (카드 link 0).
//   tier=customer (DEFER)      → 항상 reject in mk1.
//   unknown payment_source 또는 빈 값 → reject (fail-closed).
// ---------------------------------------------------------------------------

fn policy_payment_tier_compatible(payment_source: str, tier: str) -> bool {
    if payment_source == "" { return false }
    if tier == "" { return false }
    if payment_source == "unknown" { return false }
    if payment_source != "card_direct" {
        if payment_source != "card_reseller" {
            if payment_source != "cash" {
                if payment_source != "monero" {
                    return false
                }
            }
        }
    }
    if tier == "customer" { return false }
    if tier == "research" { return true }
    if tier == "sweep" {
        return payment_source != "card_direct"
    }
    if tier == "broadcast_high_value" {
        if payment_source == "cash" { return true }
        if payment_source == "monero" { return true }
        return false
    }
    return false
}

// ---------------------------------------------------------------------------
// G10 — policy_allow_downgrade
//   허용:
//     broadcast_high_value → sweep   (Nym down → Tor over Mullvad)
//     sweep                → research-degraded  (Tor down → Mullvad only, marker)
//   거부:
//     research → anything   (no downgrade — 그냥 down)
//     upgrade (research → sweep, sweep → broadcast_high_value, ...)
//     같은 tier 자기 자신
//     unknown 전이
// caller 는 audit_emit_downgrade(from, to, reason) 별도 호출 (G10).
// ---------------------------------------------------------------------------

fn policy_allow_downgrade(from_tier: str, to_tier: str, reason: str) -> bool {
    if from_tier == "" { return false }
    if to_tier == "" { return false }
    if reason == "" { return false }
    if from_tier == to_tier { return false }
    if from_tier == "broadcast_high_value" {
        if to_tier == "sweep" { return true }
        return false
    }
    if from_tier == "sweep" {
        if to_tier == "research-degraded" { return true }
        return false
    }
    return false
}

// ---------------------------------------------------------------------------
// userland 협력 게이트 status — cond.9 미충족 시 라벨만 반환.
// KERNEL_KILL_SWITCH_ENABLED 가 true 면 "engaged" — 실 pf 룰 적용은 cond.9.
// ---------------------------------------------------------------------------

fn policy_kill_switch_engage() -> str {
    if KERNEL_KILL_SWITCH_ENABLED { return "engaged" }
    return "disabled"
}

// ---------------------------------------------------------------------------
// cond.9 — capability flag accessor. operator opt-in 전용.
//
// 저장소: $HOME/.airgenome/ghost_capability (mode 0600, key=value 한 줄당).
// 형식 예: "kill_switch=on" 또는 "kill_switch=off".
//
// 부재 / 키 부재 / "off" / unknown 값 → 모두 false (fail-closed).
// "on" 만 true. operator 가 명시적으로 활성화한 경우.
// ---------------------------------------------------------------------------

fn _capability_flag_path() -> str {
    let home = env("HOME")
    if home == "" { return "" }
    return home + "/.airgenome/ghost_capability"
}

fn policy_kernel_kill_switch_enabled() -> bool {
    let path = _capability_flag_path()
    if path == "" { return false }
    // 파일 부재 → false. exec 의 grep 으로 한 줄 추출, awk 로 value 만.
    // grep -E '^kill_switch=' path | head -1 | sed 's/^kill_switch=//'
    let cmd = "test -f '" + path + "' && grep -E '^" + CAPABILITY_FLAG_NAME + "=' '" + path + "' 2>/dev/null | head -1 | sed 's/^" + CAPABILITY_FLAG_NAME + "=//'"
    let v = exec(cmd).trim()
    if v == "on" { return true }
    return false
}

// policy_capability_set — operator opt-in 토글.
//   name="kill_switch", value="on"|"off". 다른 값은 reject.
//   파일 미존재 시 mkdir -p + touch + chmod 0600 으로 생성.
//   기존 라인이 있으면 sed in-place 로 교체, 없으면 append.
//   audit_emit_capability(name, value) 호출 — 변경 즉시 ledger 기록.
//
// 반환:
//   "ok" — 성공
//   "rejected: invalid name"  — name 화이트리스트 외
//   "rejected: invalid value" — value 가 on|off 외
//   "rejected: HOME unset"    — HOME 환경변수 부재
fn policy_capability_set(name: str, value: str) -> str {
    if name == "" { return "rejected: invalid name" }
    if name != CAPABILITY_FLAG_NAME { return "rejected: invalid name" }
    if value == "" { return "rejected: invalid value" }
    if value != "on" {
        if value != "off" { return "rejected: invalid value" }
    }

    let path = _capability_flag_path()
    if path == "" { return "rejected: HOME unset" }

    // 디렉토리 + 파일 보장 (mode 0600).
    let _m = exec("mkdir -p \"$HOME/.airgenome\" && touch '" + path + "' && chmod 600 '" + path + "' 2>/dev/null").trim()

    // 기존 라인 제거 후 새 라인 append (sed -i 매크로 OS 차이 회피).
    // grep -v 로 해당 키 제거 → 임시파일 → mv. atomic.
    let tmp = path + ".tmp"
    let _w = exec("grep -v -E '^" + name + "=' '" + path + "' > '" + tmp + "' 2>/dev/null; printf '%s=%s\\n' '" + name + "' '" + value + "' >> '" + tmp + "'; mv '" + tmp + "' '" + path + "' && chmod 600 '" + path + "' 2>/dev/null").trim()

    // audit emit — 변경 즉시 별도 capability stream 에 기록.
    let _ae = exec("hexa run " + AUDIT_PATH + " emit-capability '" + name + "' '" + value + "' 2>/dev/null").trim()

    return "ok"
}

// ---------------------------------------------------------------------------
// Selftest — 모든 4 함수 positive + negative 케이스 inline 검증.
// G6 sentinel: __GHOST_POLICY__ <PASS|FAIL|SKIP>
// ---------------------------------------------------------------------------

fn _expect_bool(label: str, actual: bool, expected: bool) -> bool {
    if actual == expected { return true }
    println(SELFTEST_SENTINEL + " FAIL — case [" + label + "] expected=" + to_string(expected) + " actual=" + to_string(actual))
    return false
}

fn _expect_str(label: str, actual: str, expected: str) -> bool {
    if actual == expected { return true }
    println(SELFTEST_SENTINEL + " FAIL — case [" + label + "] expected=" + expected + " actual=" + actual)
    return false
}

fn selftest() -> void {
    let mut ok = true

    // policy_check_exit — sweep allowlist
    if !_expect_bool("exit:sweep:JP",  policy_check_exit("sweep", "JP"),  true)  { ok = false }
    if !_expect_bool("exit:sweep:SG",  policy_check_exit("sweep", "SG"),  true)  { ok = false }
    if !_expect_bool("exit:sweep:CH",  policy_check_exit("sweep", "CH"),  true)  { ok = false }
    if !_expect_bool("exit:sweep:SE",  policy_check_exit("sweep", "SE"),  true)  { ok = false }
    if !_expect_bool("exit:sweep:KR",  policy_check_exit("sweep", "KR"),  false) { ok = false }
    if !_expect_bool("exit:sweep:US",  policy_check_exit("sweep", "US"),  false) { ok = false }
    if !_expect_bool("exit:sweep:'' ", policy_check_exit("sweep", ""),    false) { ok = false }

    // policy_check_exit — broadcast_high_value (sweep allowlist 와 동일)
    if !_expect_bool("exit:bhv:JP",    policy_check_exit("broadcast_high_value", "JP"), true)  { ok = false }
    if !_expect_bool("exit:bhv:KR",    policy_check_exit("broadcast_high_value", "KR"), false) { ok = false }

    // policy_check_exit — research (KR 허용)
    if !_expect_bool("exit:research:KR", policy_check_exit("research", "KR"), true)  { ok = false }
    if !_expect_bool("exit:research:JP", policy_check_exit("research", "JP"), true)  { ok = false }
    if !_expect_bool("exit:research:CN", policy_check_exit("research", "CN"), false) { ok = false }

    // policy_check_exit — customer (Phase 2 — 항상 reject)
    if !_expect_bool("exit:customer:JP", policy_check_exit("customer", "JP"), false) { ok = false }

    // policy_check_exit — unknown tier
    if !_expect_bool("exit:unknown:JP",  policy_check_exit("foo", "JP"), false) { ok = false }

    // policy_check_g5_clean
    if !_expect_bool("g5:tier_label",       policy_check_g5_clean("tier_label"),       true)  { ok = false }
    if !_expect_bool("g5:health_query",     policy_check_g5_clean("health_query"),     true)  { ok = false }
    if !_expect_bool("g5:exit_jurisdiction",policy_check_g5_clean("exit_jurisdiction"),true)  { ok = false }
    if !_expect_bool("g5:tx_hex",           policy_check_g5_clean("tx_hex"),           false) { ok = false }
    if !_expect_bool("g5:puzzle_id",        policy_check_g5_clean("puzzle_id"),        false) { ok = false }
    if !_expect_bool("g5:bip39_candidate",  policy_check_g5_clean("bip39_candidate"),  false) { ok = false }
    if !_expect_bool("g5:private_key",      policy_check_g5_clean("private_key"),      false) { ok = false }
    if !_expect_bool("g5:owner_proof",      policy_check_g5_clean("owner_proof"),      false) { ok = false }
    if !_expect_bool("g5:''",               policy_check_g5_clean(""),                 false) { ok = false }

    // policy_check_kr_tor_exit
    if !_expect_bool("kr_tor:KR", policy_check_kr_tor_exit("KR"), true)  { ok = false }
    if !_expect_bool("kr_tor:JP", policy_check_kr_tor_exit("JP"), false) { ok = false }
    if !_expect_bool("kr_tor:''", policy_check_kr_tor_exit(""),   false) { ok = false }

    // ALLOW_KR_TOR_EXIT hard invariant — 절대 true 가 아니어야 함
    if ALLOW_KR_TOR_EXIT {
        println(SELFTEST_SENTINEL + " FAIL — ALLOW_KR_TOR_EXIT must be false (G8 invariant)")
        ok = false
    }

    // policy_payment_tier_compatible — research = 모든 source OK
    if !_expect_bool("pay:card_direct:research",        policy_payment_tier_compatible("card_direct",        "research"), true)  { ok = false }
    if !_expect_bool("pay:card_reseller:research",      policy_payment_tier_compatible("card_reseller",      "research"), true)  { ok = false }
    if !_expect_bool("pay:cash:research",               policy_payment_tier_compatible("cash",               "research"), true)  { ok = false }
    if !_expect_bool("pay:monero:research",             policy_payment_tier_compatible("monero",             "research"), true)  { ok = false }

    // policy_payment_tier_compatible — sweep = !card_direct
    if !_expect_bool("pay:card_direct:sweep",           policy_payment_tier_compatible("card_direct",        "sweep"), false) { ok = false }
    if !_expect_bool("pay:card_reseller:sweep",         policy_payment_tier_compatible("card_reseller",      "sweep"), true)  { ok = false }
    if !_expect_bool("pay:cash:sweep",                  policy_payment_tier_compatible("cash",               "sweep"), true)  { ok = false }
    if !_expect_bool("pay:monero:sweep",                policy_payment_tier_compatible("monero",             "sweep"), true)  { ok = false }

    // policy_payment_tier_compatible — broadcast_high_value = cash | monero only
    if !_expect_bool("pay:card_direct:bhv",             policy_payment_tier_compatible("card_direct",        "broadcast_high_value"), false) { ok = false }
    if !_expect_bool("pay:card_reseller:bhv",           policy_payment_tier_compatible("card_reseller",      "broadcast_high_value"), false) { ok = false }
    if !_expect_bool("pay:cash:bhv",                    policy_payment_tier_compatible("cash",               "broadcast_high_value"), true)  { ok = false }
    if !_expect_bool("pay:monero:bhv",                  policy_payment_tier_compatible("monero",             "broadcast_high_value"), true)  { ok = false }

    // policy_payment_tier_compatible — customer (Phase 2) = 모두 reject
    if !_expect_bool("pay:cash:customer",               policy_payment_tier_compatible("cash",               "customer"), false) { ok = false }

    // policy_payment_tier_compatible — fail-closed
    if !_expect_bool("pay:unknown:research",            policy_payment_tier_compatible("unknown",            "research"), false) { ok = false }
    if !_expect_bool("pay:'':research",                 policy_payment_tier_compatible("",                   "research"), false) { ok = false }
    if !_expect_bool("pay:cash:''",                     policy_payment_tier_compatible("cash",               ""),         false) { ok = false }
    if !_expect_bool("pay:bogus:research",              policy_payment_tier_compatible("paypal",             "research"), false) { ok = false }

    // policy_allow_downgrade — 허용
    if !_expect_bool("dg:bhv->sweep",                   policy_allow_downgrade("broadcast_high_value", "sweep",              "nym down"),  true)  { ok = false }
    if !_expect_bool("dg:sweep->research-degraded",     policy_allow_downgrade("sweep",                "research-degraded",  "tor down"),  true)  { ok = false }

    // policy_allow_downgrade — 거부 (upgrade)
    if !_expect_bool("dg:research->sweep",              policy_allow_downgrade("research",             "sweep",              "?"),         false) { ok = false }
    if !_expect_bool("dg:sweep->bhv",                   policy_allow_downgrade("sweep",                "broadcast_high_value","?"),        false) { ok = false }

    // policy_allow_downgrade — 거부 (no downgrade for research, same tier, unknown, empty reason)
    if !_expect_bool("dg:research->null",               policy_allow_downgrade("research",             "null",               "?"),         false) { ok = false }
    if !_expect_bool("dg:sweep->sweep",                 policy_allow_downgrade("sweep",                "sweep",              "?"),         false) { ok = false }
    if !_expect_bool("dg:bhv->research",                policy_allow_downgrade("broadcast_high_value", "research",           "?"),         false) { ok = false }
    if !_expect_bool("dg:empty-reason",                 policy_allow_downgrade("broadcast_high_value", "sweep",              ""),          false) { ok = false }

    // policy_kill_switch_engage — mk1 default disabled
    if !_expect_str("kill_switch:default", policy_kill_switch_engage(), "disabled") { ok = false }

    // cond.9 — capability_set 입력 검증 (실 파일 쓰기는 selftest 에서 회피).
    //   invalid name / invalid value / unsupported name 모두 reject 라벨 검증.
    if !_expect_str("cap:invalid_name",   policy_capability_set("",            "on"),   "rejected: invalid name")  { ok = false }
    if !_expect_str("cap:unknown_name",   policy_capability_set("foo",         "on"),   "rejected: invalid name")  { ok = false }
    if !_expect_str("cap:invalid_value",  policy_capability_set("kill_switch", ""),     "rejected: invalid value") { ok = false }
    if !_expect_str("cap:bogus_value",    policy_capability_set("kill_switch", "yes"),  "rejected: invalid value") { ok = false }

    if ok {
        println(SELFTEST_SENTINEL + " PASS — exit-allowlist + g5-guard + kr-tor-deny + payment-tier + downgrade-matrix all verified")
    } else {
        println(SELFTEST_SENTINEL + " FAIL — see case lines above")
    }
}

// ---------------------------------------------------------------------------
// CLI entrypoint — hexa run modules/ghost/policy.hexa <sub>
// ---------------------------------------------------------------------------

fn _allow_reject(b: bool) -> str {
    if b { return "allow" }
    return "reject"
}

fn _clean_reject(b: bool) -> str {
    if b { return "clean" }
    return "reject"
}

fn main() -> void {
    let a = args()
    if len(a) < 3 {
        println("usage: hexa run modules/ghost/policy.hexa <sub>")
        println("  self-test")
        println("  check-exit <tier> <jurisdiction>          # allow|reject")
        println("  check-g5 <payload_kind>                    # clean|reject")
        println("  check-payment <payment_source> <tier>      # allow|reject")
        println("  check-downgrade <from> <to> <reason>       # allow|reject")
        println("  check-kr-tor <country>                     # blocked|allowed")
        println("  kill-switch-status                         # engaged|disabled (compile-time flag)")
        println("  kernel-kill-switch-status                  # enabled|disabled (operator runtime flag, cond.9)")
        println("  capability-set <name> <value>              # name=kill_switch value=on|off (operator opt-in)")
        return
    }
    let sub = a[2]
    if sub == "self-test" { selftest(); return }
    if sub == "--selftest" { selftest(); return }

    if sub == "check-exit" {
        if len(a) >= 5 {
            println(_allow_reject(policy_check_exit(a[3], a[4])))
            return
        }
        println("check-exit: usage <tier> <jurisdiction-iso2-upper>")
        return
    }
    if sub == "check-g5" {
        if len(a) >= 4 {
            println(_clean_reject(policy_check_g5_clean(a[3])))
            return
        }
        println("check-g5: usage <payload_kind>")
        return
    }
    if sub == "check-payment" {
        if len(a) >= 5 {
            println(_allow_reject(policy_payment_tier_compatible(a[3], a[4])))
            return
        }
        println("check-payment: usage <payment_source> <tier>")
        return
    }
    if sub == "check-downgrade" {
        if len(a) >= 6 {
            println(_allow_reject(policy_allow_downgrade(a[3], a[4], a[5])))
            return
        }
        println("check-downgrade: usage <from_tier> <to_tier> <reason>")
        return
    }
    if sub == "check-kr-tor" {
        if len(a) >= 4 {
            if policy_check_kr_tor_exit(a[3]) { println("blocked") } else { println("allowed") }
            return
        }
        println("check-kr-tor: usage <country-iso2-upper>")
        return
    }
    if sub == "kill-switch-status" {
        println(policy_kill_switch_engage())
        return
    }
    if sub == "kernel-kill-switch-status" {
        if policy_kernel_kill_switch_enabled() { println("enabled") } else { println("disabled") }
        return
    }
    if sub == "capability-set" {
        if len(a) >= 5 {
            println(policy_capability_set(a[3], a[4]))
            return
        }
        println("capability-set: usage <name> <value>   # name=kill_switch value=on|off")
        return
    }
    println("unknown subcommand: " + sub)
}
