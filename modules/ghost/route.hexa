// modules/ghost/route.hexa — ghost orchestrator (mk1 — full integrated)
//
// 책임:
//   1. tier (research / sweep / broadcast_high_value / customer) → backend dispatch
//   2. tier-specific config 적용 후 백엔드 connect
//   3. policy.hexa (G5 + G8) 게이트 통과 검증
//   4. sweep / broadcast_high_value 시 selftest.hexa leak pre-flight
//   5. audit.hexa 에 모든 state 전이 기록 (G2 metadata-only)
//   6. G10 downgrade 시 audit_emit_downgrade + caller surface
//
// airgenome 레이어 공개 surface:
//   ghost_up(tier)         — 활성화 (정책-게이트 + leak preflight + audit)
//   ghost_down()           — 끊기 + audit
//   ghost_health()         — "up" | "connecting" | "down" | "unknown"
//   ghost_tunnel_alive()   — bool (G4 cross-repo gate, wraith W4)
//   ghost_selftest()       — sentinel __GHOST_ROUTE__ <PASS|FAIL|SKIP>
//
// mk1 정책:
//   research              → Mullvad MultiHop SE→JP + DAITA + Lockdown
//   sweep                 → Mullvad multihop+DAITA + Tor fresh circuit (cond.3)
//   broadcast_high_value  → 동일 sweep config (cond.10 Nym 은 Phase 2)
//   customer              → reject (Phase 2 only)
//
// G1 — 외부 mullvad/tor 호출은 wrap_*.hexa 만. 이 파일은 wrap/policy/audit/
//      selftest 를 `hexa run` subprocess 로 호출 — exec 'mullvad'/'tor' 직접 X.
// G3 — health 라벨만 caller 에 반환. IP / server hostname 노출 X.
// G4 — tunnel_alive() 가 cross-repo gate. wraith W4 broadcast policy gate 에서 호출.
// G5 — caller 가 tier_label 외 payload kind 보내면 reject (policy.hexa 검증).
// G8 — exit jurisdiction 검증 policy.hexa::policy_check_exit() 통과 후만 적용.
// G10 — Tor 미가용 시 sweep/bhv → research-degraded 로 fall-back, downgrade audit.
//
// hexa-lang stage1 caveat: import-as-alias / use cross-file resolution void
// (orpheus blk.3). 우회 — 모든 cross-file 호출은 hexa run subprocess.
//
// 상태: ghost.cond.4 met (cond.3/5/7/8 의 통합 표면).

// 경로는 CWD-relative (project root 기준). bin/airgenome cmd_ghost 가 cd 후 호출.
let WRAP_MV_PATH    = "modules/ghost/wrap_mullvad.hexa"
let WRAP_TOR_PATH   = "modules/ghost/wrap_tor.hexa"
let POLICY_PATH     = "modules/ghost/policy.hexa"
let AUDIT_PATH      = "modules/ghost/audit.hexa"
let SELFTEST_PATH   = "modules/ghost/selftest.hexa"

let SELFTEST_SENTINEL = "__GHOST_ROUTE__"

// mk1 default exit — JP (KR 인접 + 저지연 + 오프-KR jurisdiction).
// wrap_mullvad CLI 는 lowercase ISO-2, policy/audit 은 uppercase.
let MK1_DEFAULT_EXIT_LOWER = "jp"
let MK1_DEFAULT_EXIT_ISO   = "JP"
let MK1_DEFAULT_ENTRY_LOWER = "se"

// ---------------------------------------------------------------------------
// 내부 — wrap / policy / audit / selftest subprocess 호출 chokepoint
// ---------------------------------------------------------------------------

fn _wrap(args: str) -> str {
    return exec("hexa run " + WRAP_MV_PATH + " " + args + " 2>/dev/null").trim()
}

fn _wrap_tor(args: str) -> str {
    return exec("hexa run " + WRAP_TOR_PATH + " " + args + " 2>/dev/null").trim()
}

fn _policy(args: str) -> str {
    return exec("hexa run " + POLICY_PATH + " " + args + " 2>/dev/null").trim()
}

fn _audit(args: str) -> str {
    return exec("hexa run " + AUDIT_PATH + " " + args + " 2>/dev/null").trim()
}

fn _selftest_verdict() -> str {
    // selftest.hexa run-all → 마지막 sentinel 라인 파싱 ("__GHOST_SELFTEST__ all <verdict>")
    let cmd = "hexa run " + SELFTEST_PATH + " run-all 2>/dev/null | grep '__GHOST_SELFTEST__ all' | tail -1 | awk '{print $3}'"
    return exec(cmd).trim()
}

fn _wrap_available() -> bool {
    return _wrap("available") == "yes"
}

fn _tor_available() -> bool {
    return _wrap_tor("available") == "yes"
}

// ---------------------------------------------------------------------------
// 내부 — tier 별 config 적용
// ---------------------------------------------------------------------------

fn _apply_research_config() -> str {
    let _a = _wrap("multihop-set " + MK1_DEFAULT_ENTRY_LOWER + " on")
    let _b = _wrap("relay-set " + MK1_DEFAULT_EXIT_LOWER)
    let _c = _wrap("daita-set on")
    let _d = _wrap("lockdown-set on")
    let _e = _wrap("connect")
    return "applied"
}

fn _apply_sweep_config() -> str {
    // Mullvad inner — research config 동일.
    let _r = _apply_research_config()
    // Tor outer — operator-managed system tor reuse + fresh circuit.
    let _s = _wrap_tor("start")
    let _c = _wrap_tor("new-circuit")
    return "applied"
}

// ---------------------------------------------------------------------------
// 공개 surface
// ---------------------------------------------------------------------------

fn ghost_up(tier: str) -> str {
    // 1. Mullvad 가용성 (mk1 sole VPN backend)
    if !_wrap_available() {
        return "unavailable: mullvad CLI not installed (see docs/ghost_voucher_resellers_email_2026_05_04.ai.md)"
    }

    // 2. G5 — caller 는 tier_label 외 payload kind 절대 못 보냄
    let g5 = _policy("check-g5 tier_label")
    if g5 != "clean" {
        return "rejected: G5 guard failed (caller payload kind classification)"
    }

    // 3. G8 — tier 별 exit jurisdiction 화이트리스트
    let exit_check = _policy("check-exit " + tier + " " + MK1_DEFAULT_EXIT_ISO)
    if exit_check != "allow" {
        return "rejected: exit " + MK1_DEFAULT_EXIT_ISO + " not allowed for tier=" + tier
    }

    // 4. tier=customer 는 Phase 2
    if tier == "customer" {
        return "rejected: tier=customer is Phase 2 (KR ISMS/PIPA review pending)"
    }

    // 5. tier=research — Mullvad only
    if tier == "research" {
        let _x = _apply_research_config()
        let _ae = _audit("emit operator research mullvad " + MK1_DEFAULT_EXIT_ISO + " default_research_baseline up")
        return "ok: tier=research backend=mullvad multihop=" + MK1_DEFAULT_ENTRY_LOWER + "->" + MK1_DEFAULT_EXIT_LOWER + " daita=on lockdown=on"
    }

    // 6. tier=sweep / broadcast_high_value — Mullvad + Tor (cond.3)
    if tier == "sweep" || tier == "broadcast_high_value" {
        if !_tor_available() {
            // G10 downgrade — Tor 미설치/미실행 → research config 으로 fall-back
            let _x = _apply_research_config()
            let _ad = _audit("emit-downgrade " + tier + " research-degraded tor_unavailable")
            let _ae = _audit("emit operator " + tier + " mullvad-fallback " + MK1_DEFAULT_EXIT_ISO + " tor_unavailable_g10_downgrade degraded")
            return "ok degraded: tier=" + tier + " but tor unavailable -> research config (G10 downgrade)"
        }

        // Tor 가용 — sweep config 적용 (Mullvad inner + Tor outer + fresh circuit)
        let _x = _apply_sweep_config()

        // Leak pre-flight — DNS / IPv6 / WebRTC / SNI
        let v = _selftest_verdict()
        if v == "FAIL" {
            // 즉시 disconnect + caller 에 fail label
            let _d = _wrap("disconnect")
            let _ts = _wrap_tor("stop")
            let _ae = _audit("emit operator " + tier + " mullvad+tor " + MK1_DEFAULT_EXIT_ISO + " leak_preflight_failed down")
            return "fail: leak pre-flight FAILED — ghost layer untrusted, broadcast denied (see state/leak_reports/)"
        }

        let _ae = _audit("emit operator " + tier + " mullvad+tor " + MK1_DEFAULT_EXIT_ISO + " sweep_tier_active up")
        return "ok: tier=" + tier + " backend=mullvad+tor multihop=" + MK1_DEFAULT_ENTRY_LOWER + "->" + MK1_DEFAULT_EXIT_LOWER + " circuit=fresh leak_preflight=" + v
    }

    return "rejected: unknown tier=" + tier
}

fn ghost_down() -> str {
    if !_wrap_available() { return "unavailable" }
    let _r = _wrap("disconnect")
    // tier 가 sweep/bhv 였다면 tor stop 도 — 무해 (idempotent).
    if _tor_available() {
        let _t = _wrap_tor("stop")
    }
    let _ae = _audit("emit operator down mullvad " + MK1_DEFAULT_EXIT_ISO + " operator_disconnect down")
    return "ok"
}

fn ghost_health() -> str {
    return _wrap("health")
}

fn ghost_tunnel_alive() -> bool {
    return ghost_health() == "up"
}

// ---------------------------------------------------------------------------
// Selftest (route 자체) — wrap/policy/audit/selftest 모두 도달 가능?
// ---------------------------------------------------------------------------

fn selftest() -> void {
    if !_wrap_available() {
        println(SELFTEST_SENTINEL + " SKIP — mullvad CLI not installed (mk1 backend missing)")
        return
    }
    let h = ghost_health()
    if h == "unknown" {
        println(SELFTEST_SENTINEL + " FAIL — health parser hit unknown state")
        return
    }
    // policy / audit / selftest 도달 확인 (in-process check, fail-closed)
    let p = _policy("check-exit research JP")
    if p != "allow" {
        println(SELFTEST_SENTINEL + " FAIL — policy module unreachable or returns wrong (got '" + p + "')")
        return
    }
    println(SELFTEST_SENTINEL + " PASS — surface reachable, mk1=mullvad health=" + h + " policy=ok")
}

// ---------------------------------------------------------------------------
// CLI entrypoint — airgenome bash CLI (`airgenome ghost <subcmd>`) 가 호출.
// ---------------------------------------------------------------------------

fn main() -> void {
    let a = args()
    if len(a) < 3 {
        println("usage: hexa run modules/ghost/route.hexa { up [tier] | down | status | health | tunnel-alive | self-test }")
        return
    }
    let sub = a[2]
    if sub == "up" {
        if len(a) >= 4 {
            println(ghost_up(a[3]))
        } else {
            println(ghost_up("research"))
        }
        return
    }
    if sub == "down" { println(ghost_down()); return }
    if sub == "status" { println(ghost_health()); return }
    if sub == "health" { println(ghost_health()); return }
    if sub == "tunnel-alive" {
        if ghost_tunnel_alive() { println("yes") } else { println("no") }
        return
    }
    if sub == "self-test" { selftest(); return }
    if sub == "--selftest" { selftest(); return }
    println("unknown subcommand: " + sub)
}
