// modules/ghost/route.hexa — ghost orchestrator (mk1 — full integrated)
//
// 책임:
//   1. tier (research / sweep / broadcast_high_value / customer) → backend dispatch
//   2. tier-specific config 적용 후 백엔드 connect
//   3. policy.hexa (G5 + G8) 게이트 통과 검증
//   4. sweep / broadcast_high_value 시 selftest.hexa leak pre-flight
//   5. audit.hexa 에 모든 state 전이 기록 (G2 metadata-only)
//   6. G10 downgrade 시 audit_emit_downgrade + caller surface
//
// airgenome 레이어 공개 surface:
//   ghost_up(tier)         — 활성화 (정책-게이트 + leak preflight + audit)
//   ghost_down()           — 끊기 + audit
//   ghost_health()         — "up" | "connecting" | "down" | "unknown"
//   ghost_tunnel_alive()   — bool (G4 cross-repo gate, wraith W4)
//   ghost_selftest()       — sentinel __GHOST_ROUTE__ <PASS|FAIL|SKIP>
//
// mk1 정책:
//   research              → Mullvad MultiHop SE→JP + DAITA + Lockdown
//   sweep                 → Mullvad multihop+DAITA + Tor fresh circuit (cond.3)
//   broadcast_high_value  → Mullvad multihop+DAITA + Nym 5-hop NGM (cond.10).
//                           Nym 미가용 → sweep (Tor) 로 G10 downgrade.
//                           Nym+Tor 둘 다 미가용 → research-degraded 로 double downgrade.
//   customer              → reject (Phase 2 only)
//
// G1 — 외부 mullvad/tor/nym 호출은 wrap_*.hexa 만. 이 파일은 wrap/policy/audit/
//      selftest 를 `hexa run` subprocess 로 호출 — exec 'mullvad'/'tor'/'nym' 직접 X.
// G3 — health 라벨만 caller 에 반환. IP / server hostname / mixnet hop 노출 X.
// G4 — tunnel_alive() 가 cross-repo gate. wraith W4 broadcast policy gate 에서 호출.
// G5 — caller 가 tier_label 외 payload kind 보내면 reject (policy.hexa 검증).
// G8 — exit jurisdiction 검증 policy.hexa::policy_check_exit() 통과 후만 적용.
// G10 — Tor / Nym 미가용 시 명시적 downgrade audit + caller "degraded" surface.
//
// hexa-lang stage1 caveat: import-as-alias / use cross-file resolution void
// (orpheus blk.3). 우회 — 모든 cross-file 호출은 hexa run subprocess.
//
// 상태: ghost.cond.4 met (cond.3/5/7/8 의 통합 표면).

// 경로는 CWD-relative (project root 기준). bin/airgenome cmd_ghost 가 cd 후 호출.
let WRAP_MV_PATH    = "modules/ghost/wrap_mullvad.hexa"
let WRAP_TOR_PATH   = "modules/ghost/wrap_tor.hexa"
let WRAP_NYM_PATH   = "modules/ghost/wrap_nym.hexa"
let POLICY_PATH     = "modules/ghost/policy.hexa"
let AUDIT_PATH      = "modules/ghost/audit.hexa"
let SELFTEST_PATH   = "modules/ghost/selftest.hexa"

// cond.9 — capability flag pf anchor 자산.
let PF_TEMPLATE_PATH = "modules/ghost/capability_pf_template.txt"
let PF_ANCHOR_NAME   = "ghost-killswitch"
// 운영자가 검토 후 sudo pfctl 로 로드할 산출 anchor 파일 (operator-private state).
let PF_RENDERED_PATH = "state/ghost_capability_pf_anchor.conf"
// WireGuard 기본 포트 (Mullvad 표준).
let PF_WG_PORT_DEFAULT = "51820"

let SELFTEST_SENTINEL = "__GHOST_ROUTE__"

// mk1 default exit — JP (KR 인접 + 저지연 + 오프-KR jurisdiction).
// wrap_mullvad CLI 는 lowercase ISO-2, policy/audit 은 uppercase.
let MK1_DEFAULT_EXIT_LOWER = "jp"
let MK1_DEFAULT_EXIT_ISO   = "JP"
let MK1_DEFAULT_ENTRY_LOWER = "se"

// ---------------------------------------------------------------------------
// 내부 — wrap / policy / audit / selftest subprocess 호출 chokepoint
// ---------------------------------------------------------------------------

fn _wrap(args: str) -> str {
    return exec("hexa run " + WRAP_MV_PATH + " " + args + " 2>/dev/null").trim()
}

fn _wrap_tor(args: str) -> str {
    return exec("hexa run " + WRAP_TOR_PATH + " " + args + " 2>/dev/null").trim()
}

fn _wrap_nym(args: str) -> str {
    return exec("hexa run " + WRAP_NYM_PATH + " " + args + " 2>/dev/null").trim()
}

fn _policy(args: str) -> str {
    return exec("hexa run " + POLICY_PATH + " " + args + " 2>/dev/null").trim()
}

fn _audit(args: str) -> str {
    return exec("hexa run " + AUDIT_PATH + " " + args + " 2>/dev/null").trim()
}

fn _selftest_verdict() -> str {
    // selftest.hexa run-all → 마지막 sentinel 라인 파싱 ("__GHOST_SELFTEST__ all <verdict>")
    let cmd = "hexa run " + SELFTEST_PATH + " run-all 2>/dev/null | grep '__GHOST_SELFTEST__ all' | tail -1 | awk '{print $3}'"
    return exec(cmd).trim()
}

fn _wrap_available() -> bool {
    return _wrap("available") == "yes"
}

fn _tor_available() -> bool {
    return _wrap_tor("available") == "yes"
}

fn _nym_available() -> bool {
    return _wrap_nym("available") == "yes"
}

// ---------------------------------------------------------------------------
// 내부 — tier 별 config 적용
// ---------------------------------------------------------------------------

fn _apply_research_config() -> str {
    let _a = _wrap("multihop-set " + MK1_DEFAULT_ENTRY_LOWER + " on")
    let _b = _wrap("relay-set " + MK1_DEFAULT_EXIT_LOWER)
    let _c = _wrap("daita-set on")
    let _d = _wrap("lockdown-set on")
    let _e = _wrap("connect")
    return "applied"
}

fn _apply_sweep_config() -> str {
    // Mullvad inner — research config 동일.
    let _r = _apply_research_config()
    // Tor outer — operator-managed system tor reuse + fresh circuit.
    let _s = _wrap_tor("start")
    let _c = _wrap_tor("new-circuit")
    return "applied"
}

// broadcast_high_value (#135-class sweep ≥10 BTC) — Mullvad inner + Nym 5-hop NGM.
// Nym 미가용 시 G10 downgrade — sweep tier (Mullvad+Tor) 로 fall-back.
// Tor 마저 미가용 시 sweep tier 자체가 research-degraded 로 또-fall-back —
// ghost_up() 의 sweep 분기가 처리하므로 여기서는 1단계만.
fn _apply_broadcast_high_value_config() -> str {
    // Mullvad inner — research config 동일 (multihop+daita+lockdown+connect).
    let _r = _apply_research_config()
    if !_nym_available() {
        // G10 downgrade — Nym 미설치/미가동 → sweep tier (Tor) 로 fall-back.
        let _ad = _audit("emit-downgrade broadcast_high_value sweep nym_unavailable")
        let _s = _wrap_tor("start")
        let _c = _wrap_tor("new-circuit")
        return "applied-fallback-sweep"
    }
    // Nym 가용 — 5-hop NGM 모드 set + start.
    let _nm = _wrap_nym("mode-set ngm")
    let _ns = _wrap_nym("start")
    return "applied-nym-5hop"
}

// ---------------------------------------------------------------------------
// 공개 surface
// ---------------------------------------------------------------------------

fn ghost_up(tier: str) -> str {
    // 1. Mullvad 가용성 (mk1 sole VPN backend)
    if !_wrap_available() {
        return "unavailable: mullvad CLI not installed (see docs/ghost_voucher_resellers_email_2026_05_04.ai.md)"
    }

    // 2. G5 — caller 는 tier_label 외 payload kind 절대 못 보냄
    let g5 = _policy("check-g5 tier_label")
    if g5 != "clean" {
        return "rejected: G5 guard failed (caller payload kind classification)"
    }

    // 3. G8 — tier 별 exit jurisdiction 화이트리스트
    let exit_check = _policy("check-exit " + tier + " " + MK1_DEFAULT_EXIT_ISO)
    if exit_check != "allow" {
        return "rejected: exit " + MK1_DEFAULT_EXIT_ISO + " not allowed for tier=" + tier
    }

    // 4. tier=customer 는 Phase 2
    if tier == "customer" {
        return "rejected: tier=customer is Phase 2 (KR ISMS/PIPA review pending)"
    }

    // 5. tier=research — Mullvad only
    if tier == "research" {
        let _x = _apply_research_config()
        let _ae = _audit("emit operator research mullvad " + MK1_DEFAULT_EXIT_ISO + " default_research_baseline up")
        return "ok: tier=research backend=mullvad multihop=" + MK1_DEFAULT_ENTRY_LOWER + "->" + MK1_DEFAULT_EXIT_LOWER + " daita=on lockdown=on"
    }

    // 6. tier=sweep — Mullvad + Tor (cond.3)
    if tier == "sweep" {
        if !_tor_available() {
            // G10 downgrade — Tor 미설치/미실행 → research config 으로 fall-back
            let _x = _apply_research_config()
            let _ad = _audit("emit-downgrade sweep research-degraded tor_unavailable")
            let _ae = _audit("emit operator sweep mullvad-fallback " + MK1_DEFAULT_EXIT_ISO + " tor_unavailable_g10_downgrade degraded")
            return "ok degraded: tier=sweep but tor unavailable -> research config (G10 downgrade)"
        }

        // Tor 가용 — sweep config 적용 (Mullvad inner + Tor outer + fresh circuit)
        let _x = _apply_sweep_config()

        // Leak pre-flight — DNS / IPv6 / WebRTC / SNI
        let v = _selftest_verdict()
        if v == "FAIL" {
            // 즉시 disconnect + caller 에 fail label
            let _d = _wrap("disconnect")
            let _ts = _wrap_tor("stop")
            let _ae = _audit("emit operator sweep mullvad+tor " + MK1_DEFAULT_EXIT_ISO + " leak_preflight_failed down")
            return "fail: leak pre-flight FAILED — ghost layer untrusted, broadcast denied (see state/leak_reports/)"
        }

        let _ae = _audit("emit operator sweep mullvad+tor " + MK1_DEFAULT_EXIT_ISO + " sweep_tier_active up")
        return "ok: tier=sweep backend=mullvad+tor multihop=" + MK1_DEFAULT_ENTRY_LOWER + "->" + MK1_DEFAULT_EXIT_LOWER + " circuit=fresh leak_preflight=" + v
    }

    // 7. tier=broadcast_high_value — Mullvad + Nym 5-hop NGM (cond.10).
    //    Nym 미가용 → sweep tier (Tor) 로 fall-back; Tor 마저 미가용 → research-degraded.
    if tier == "broadcast_high_value" {
        // 7a. Nym 가용 — Mullvad inner + Nym 5-hop NGM
        if _nym_available() {
            let _x = _apply_broadcast_high_value_config()  // applied-nym-5hop

            // Leak pre-flight — DNS / IPv6 / WebRTC / SNI
            let v = _selftest_verdict()
            if v == "FAIL" {
                let _d = _wrap("disconnect")
                let _ns = _wrap_nym("stop")
                let _ae = _audit("emit operator broadcast_high_value mullvad+nym " + MK1_DEFAULT_EXIT_ISO + " leak_preflight_failed down")
                return "fail: leak pre-flight FAILED — ghost layer untrusted, broadcast denied (see state/leak_reports/)"
            }

            let _ae = _audit("emit operator broadcast_high_value mullvad+nym " + MK1_DEFAULT_EXIT_ISO + " bhv_5hop_ngm_active up")
            return "ok: tier=broadcast_high_value backend=mullvad+nym mode=ngm-5hop multihop=" + MK1_DEFAULT_ENTRY_LOWER + "->" + MK1_DEFAULT_EXIT_LOWER + " leak_preflight=" + v
        }

        // 7b. Nym 미가용 — sweep tier (Tor) 로 fall-back. G10 downgrade 기록.
        if _tor_available() {
            let _x = _apply_broadcast_high_value_config()  // applied-fallback-sweep (downgrade audit 이미 emit)
            let v = _selftest_verdict()
            if v == "FAIL" {
                let _d = _wrap("disconnect")
                let _ts = _wrap_tor("stop")
                let _ae = _audit("emit operator broadcast_high_value mullvad+tor " + MK1_DEFAULT_EXIT_ISO + " leak_preflight_failed down")
                return "fail: leak pre-flight FAILED — ghost layer untrusted, broadcast denied (see state/leak_reports/)"
            }
            let _ae = _audit("emit operator broadcast_high_value mullvad+tor " + MK1_DEFAULT_EXIT_ISO + " nym_unavailable_g10_downgrade_to_sweep degraded")
            return "ok degraded: tier=broadcast_high_value but nym unavailable -> sweep config (G10 downgrade) leak_preflight=" + v
        }

        // 7c. Nym 도 Tor 도 미가용 — double downgrade → research-degraded.
        let _x = _apply_research_config()
        let _ad1 = _audit("emit-downgrade broadcast_high_value sweep nym_unavailable")
        let _ad2 = _audit("emit-downgrade broadcast_high_value research-degraded tor_unavailable")
        let _ae = _audit("emit operator broadcast_high_value mullvad-fallback " + MK1_DEFAULT_EXIT_ISO + " nym_and_tor_unavailable_double_downgrade degraded")
        return "ok degraded: tier=broadcast_high_value but nym+tor unavailable -> research config (G10 double downgrade)"
    }

    return "rejected: unknown tier=" + tier
}

fn ghost_down() -> str {
    if !_wrap_available() { return "unavailable" }
    let _r = _wrap("disconnect")
    // tier 가 sweep 였다면 tor stop, bhv 였다면 nym stop — 무해 (idempotent).
    if _tor_available() {
        let _t = _wrap_tor("stop")
    }
    if _nym_available() {
        let _n = _wrap_nym("stop")
    }
    let _ae = _audit("emit operator down mullvad " + MK1_DEFAULT_EXIT_ISO + " operator_disconnect down")
    return "ok"
}

fn ghost_health() -> str {
    return _wrap("health")
}

fn ghost_tunnel_alive() -> bool {
    return ghost_health() == "up"
}

// ---------------------------------------------------------------------------
// cond.9 — capability flag pf integration (operator opt-in).
//
// 핵심 invariant: 이 .hexa 가 직접 sudo pf 룰 적용 절대 X. anchor 파일을
// 렌더링한 후 stdout 으로 sudo 명령을 출력 — operator 가 검토 후 직접 실행.
//
// engage:
//   1. policy_kernel_kill_switch_enabled() == false 면 즉시 noop (fail-safe).
//   2. capability_pf_template.txt → 변수 치환 → state/ghost_capability_pf_anchor.conf
//      __TUNNEL_ENDPOINT__ : `mullvad relay get` 결과 IPv4 (가용 시).
//                            미가용/파싱 실패 시 placeholder "<TUNNEL_ENDPOINT>" —
//                            operator 가 직접 채움.
//      __TUNNEL_PORT__     : 51820 (WireGuard 표준).
//      __TUNNEL_IFACE__    : utun 첫번째 (가용 시 ifconfig 로 inspect).
//                            미가용 시 placeholder "<TUNNEL_IFACE>".
//   3. stdout 으로 review + sudo 명령 출력.
//   4. audit_emit_capability("kill_switch", "on") 별도 호출 (정책 단에서 이미
//      기록되었으나 engage 시점은 별 이벤트 — 추가 기록 없이 stdout 만).
//
// disengage:
//   - operator opt-in 이 off 든 on 이든 stdout 으로 anchor flush 명령 출력.
//   - 룰 자체 제거는 sudo 가 필요 — 이 함수는 명령만 emit.
// ---------------------------------------------------------------------------

fn _detect_tunnel_endpoint() -> str {
    // mullvad relay get → 첫 IPv4 추출. 실패 시 "<TUNNEL_ENDPOINT>".
    // mullvad CLI 출력 포맷이 OS / 버전마다 다름 — 보수적으로 grep 으로 IPv4 만 catch.
    let cmd = "mullvad relay get 2>/dev/null | grep -oE '[0-9]+\\.[0-9]+\\.[0-9]+\\.[0-9]+' | head -1"
    let v = exec(cmd).trim()
    if v == "" { return "<TUNNEL_ENDPOINT>" }
    return v
}

fn _detect_tunnel_iface() -> str {
    // 활성 utun 인터페이스 첫번째. ifconfig | grep 'utun' | head -1.
    // Mullvad WireGuard 는 utun4-utun8 범주에서 동적 할당.
    let cmd = "ifconfig 2>/dev/null | grep -oE '^utun[0-9]+' | head -1"
    let v = exec(cmd).trim()
    if v == "" { return "<TUNNEL_IFACE>" }
    return v
}

fn _render_pf_anchor() -> str {
    let endpoint = _detect_tunnel_endpoint()
    let iface = _detect_tunnel_iface()
    // 템플릿 → state/ output. sed 두 번 (변수 별 1회).
    // mkdir state 보장 (audit 의 _ensure_state_dir 와 동일 정책 — 별 import 회피).
    let _m = exec("mkdir -p state").trim()
    let cmd = "sed -e 's|__TUNNEL_ENDPOINT__|" + endpoint + "|g' -e 's|__TUNNEL_PORT__|" + PF_WG_PORT_DEFAULT + "|g' -e 's|__TUNNEL_IFACE__|" + iface + "|g' '" + PF_TEMPLATE_PATH + "' > '" + PF_RENDERED_PATH + "' && chmod 600 '" + PF_RENDERED_PATH + "' 2>/dev/null && echo y"
    let r = exec(cmd).trim()
    if r != "y" { return "" }
    return PF_RENDERED_PATH
}

fn capability_engage_kill_switch() -> str {
    // operator opt-in 검사 — flag off 면 noop.
    let status = _policy("kernel-kill-switch-status")
    if status != "enabled" {
        return "noop: kernel kill-switch disabled (run `airgenome ghost capability set kill_switch on` first)"
    }

    let rendered = _render_pf_anchor()
    if rendered == "" {
        return "rejected: failed to render pf anchor (template missing or sed error)"
    }

    // stdout — operator review + sudo 명령. 함수 자체는 sudo 호출 X.
    println("# cond.9 — review pf anchor before activating:")
    println("cat " + rendered)
    println("")
    println("# then load into pf (requires sudo):")
    println("sudo pfctl -a " + PF_ANCHOR_NAME + " -f " + rendered)
    println("")
    println("# verify rules loaded:")
    println("sudo pfctl -a " + PF_ANCHOR_NAME + " -sr")
    println("")
    println("# enable pf if not already (idempotent):")
    println("sudo pfctl -E")
    println("")
    println("# persistence (optional, operator decides):")
    println("#   sudo cp " + rendered + " /etc/pf.anchors/ghost-killswitch")
    println("#   then add to /etc/pf.conf:")
    println("#     anchor \"ghost-killswitch\"")
    println("#     load anchor \"ghost-killswitch\" from \"/etc/pf.anchors/ghost-killswitch\"")
    println("#   sudo pfctl -f /etc/pf.conf")

    return "ready: review + run sudo command above"
}

fn capability_disengage_kill_switch() -> str {
    // disengage 는 always-emit — flag off 라도 operator 가 이전 잔여 룰 제거할 수 있어야 함.
    println("# cond.9 — flush ghost-killswitch anchor (requires sudo):")
    println("sudo pfctl -a " + PF_ANCHOR_NAME + " -F all")
    println("")
    println("# verify removal:")
    println("sudo pfctl -a " + PF_ANCHOR_NAME + " -sr")
    println("")
    println("# if persisted in /etc/pf.conf, also:")
    println("#   sudo rm /etc/pf.anchors/ghost-killswitch")
    println("#   edit /etc/pf.conf to remove the two anchor lines")
    println("#   sudo pfctl -f /etc/pf.conf")

    return "ready: review + run sudo command above"
}

// ---------------------------------------------------------------------------
// Selftest (route 자체) — wrap/policy/audit/selftest 모두 도달 가능?
// ---------------------------------------------------------------------------

fn selftest() -> void {
    if !_wrap_available() {
        println(SELFTEST_SENTINEL + " SKIP — mullvad CLI not installed (mk1 backend missing)")
        return
    }
    let h = ghost_health()
    if h == "unknown" {
        println(SELFTEST_SENTINEL + " FAIL — health parser hit unknown state")
        return
    }
    // policy / audit / selftest 도달 확인 (in-process check, fail-closed)
    let p = _policy("check-exit research JP")
    if p != "allow" {
        println(SELFTEST_SENTINEL + " FAIL — policy module unreachable or returns wrong (got '" + p + "')")
        return
    }
    println(SELFTEST_SENTINEL + " PASS — surface reachable, mk1=mullvad health=" + h + " policy=ok")
}

// ---------------------------------------------------------------------------
// CLI entrypoint — airgenome bash CLI (`airgenome ghost <subcmd>`) 가 호출.
// ---------------------------------------------------------------------------

fn main() -> void {
    let a = args()
    if len(a) < 3 {
        println("usage: hexa run modules/ghost/route.hexa { up [tier] | down | status | health | tunnel-alive | self-test | capability-engage | capability-disengage }")
        return
    }
    let sub = a[2]
    if sub == "up" {
        if len(a) >= 4 {
            println(ghost_up(a[3]))
        } else {
            println(ghost_up("research"))
        }
        return
    }
    if sub == "down" { println(ghost_down()); return }
    if sub == "status" { println(ghost_health()); return }
    if sub == "health" { println(ghost_health()); return }
    if sub == "tunnel-alive" {
        if ghost_tunnel_alive() { println("yes") } else { println("no") }
        return
    }
    if sub == "self-test" { selftest(); return }
    if sub == "--selftest" { selftest(); return }
    if sub == "capability-engage" {
        println(capability_engage_kill_switch())
        return
    }
    if sub == "capability-disengage" {
        println(capability_disengage_kill_switch())
        return
    }
    println("unknown subcommand: " + sub)
}
