// modules/ghost/wrap_tor.hexa — system Tor single edit point (G1)
//
// 책임:
//   1. system `tor` 데몬 (homebrew-services 또는 official binary) 의 모든 접근은
//      이 파일의 _tor_exec() / _tor_ctrl() 만 통과 (G1 single chokepoint).
//   2. 표면 — available / start / stop / health / new-circuit / socks-endpoint.
//   3. SOCKS5 endpoint 는 고정 라벨 ("127.0.0.1:9050") 만 노출 — 동작 중일 때.
//      caller 는 이 endpoint 를 SOCKS proxy 로 사용하며, **endpoint 를 통해 보내는
//      URL/host 를 ghost 측에 절대 알리지 않음** (G2 + G5 separation).
//   4. circuit isolation — sweep tier broadcast 마다 NEWNYM signal 로 fresh circuit.
//      control port (127.0.0.1:9051) cookie auth 경유.
//   5. KR exit hard-deny (G8) — operator 가 시스템 torrc 에 ExcludeExitNodes {kr}
//      를 명시했는지 검증 (operator-side responsibility, 자동 주입은 G7 + 권한
//      이슈로 회피). 미명시 시 selftest WARN.
//
// 계약 (cpre/contracts.ai.md):
//   G1 — 외부에서 `tor` / `torify` / SOCKS5 직접 호출 금지. 모든 진입은 이 모듈
//        의 _tor_exec / _tor_ctrl chokepoint 통과. command -v tor (availability
//        probe) 만 narrow utility 예외.
//   G2 — control port 응답 (CIRC <id> ..., GETINFO ip-to-country/<ip>) 의 raw
//        텍스트는 **caller 에 그대로 반환 금지**. 첫 토큰 / status code 만 추출,
//        나머지는 우리 메모리에도 두지 않음 (defense-in-depth, G3 leak 차단).
//        NEWNYM 응답 (250 OK) 은 라벨 "ok" / "fail" 로만 압축.
//   G3 — health 반환은 라벨만 ("up" / "bootstrapping" / "down" / "unknown").
//        SOCKS endpoint 는 SOCKS proxy 가 살아있는 경우에 한해 고정 문자열.
//        circuit ID / exit node nickname / hop IP 절대 caller 에 전달 금지.
//   G7 — `.py` 의존성 없음 (stem 라이브러리 회피). 모든 control port 통신은
//        nc(1) 1-shot pipe — `printf 'AUTHENTICATE\\nSIGNAL ...\\nQUIT\\n' | nc`.
//   G8 — KR Tor exit 절대 금지. 시스템 torrc 의 ExcludeExitNodes {kr} 또는
//        ExcludeNodes {kr} presence 를 selftest 단계에서 verify. 미설정 시
//        selftest 는 FAIL (정책 위반은 stop-the-line — G8 cpre).
//   G10 — system tor 부재 / SOCKS port unreach 시 silent fall-back 없음. 명시적
//         "down: ..." 라벨로 caller 에 전파. route.hexa 가 G10 downgrade audit
//         기록 (cond.7 활성 후).
//
// 외부 의존성:
//   - system `tor` 바이너리 (homebrew: `brew install tor`; debian: apt install tor).
//   - `nc` (BSD netcat — macOS / linux 둘 다 기본 탑재) — control port 통신용.
//   - 미설치 시: 모든 함수 fail-closed ("unavailable" / "down" / SKIP).
//
// 운영 모델:
//   - ghost 는 tor daemon 을 직접 spawn 하지 않음 (stateless). operator 가 미리
//     `brew services start tor` (mac) 또는 `systemctl start tor` (linux) 로 띄움.
//     이는 (a) elevated privilege 회피, (b) ghost 가 daemon 라이프사이클 책임을
//     지지 않아 G3 telemetry surface 최소화, (c) torrc 가 system path 에 있어야
//     OS 가 auto-restart 가능 — 의 세 가지 이유.
//   - tor_start() 는 "확인 후 reuse" 의미 — pgrep + nc -z 로 살아있으면 ok,
//     아니면 "down: please start system tor" 안내 라벨. 자동 spawn 안 함.
//
// 검증된 환경: tor 0.4.x (homebrew Tahoe-26 + debian 12).
//
// 상태: ghost.cond.3 met candidate (selftest sentinel + G1 grep test 통과).

use "../../core/core"

let TOR_BIN = "tor"
let TOR_SOCKS_HOST = "127.0.0.1"
let TOR_SOCKS_PORT = "9050"
let TOR_CTRL_HOST = "127.0.0.1"
let TOR_CTRL_PORT = "9051"
let SELFTEST_SENTINEL = "__GHOST_WRAP_TOR__"

// torrc 후보 경로 — homebrew + debian + 사용자 영역. operator 의 환경별 차이.
// ExcludeExitNodes {kr} verify 시 모두 grep.
let TORRC_CANDIDATES = "/usr/local/etc/tor/torrc /opt/homebrew/etc/tor/torrc /etc/tor/torrc $HOME/.tor/torrc"

// ---------------------------------------------------------------------------
// G1 chokepoint 1 — `tor` binary CLI invocation (start/stop 안 함; --version/
// --hash-password 같은 비침투 op 만 호출). 실 daemon 라이프사이클은 system 에 위임.
// ---------------------------------------------------------------------------

fn _tor_exec(args: str) -> str {
    return exec(TOR_BIN + " " + args + " 2>/dev/null").trim()
}

// ---------------------------------------------------------------------------
// G1 chokepoint 2 — control port 통신 (NEWNYM, GETINFO bootstrap, etc.).
//
// cookie auth 시도 (`AUTHENTICATE` no-arg 가 cookie 자동 사용; cookie 파일은
// system tor 가 0700 dir 에 둠 — 우리는 직접 읽지 않음, tor 가 인증 처리).
// 응답 전체는 절대 caller 에 반환 X — status code (첫 줄 첫 3 byte) 만.
// G2: caller 메모리에 raw 응답 두지 않음.
// ---------------------------------------------------------------------------

fn _tor_ctrl(signal: str) -> str {
    // printf '...' | nc -w 2 host port — 2초 timeout, 응답 첫 줄 첫 토큰 (status).
    // 응답 본문 (회로 ID, exit node) 은 head -1 + awk 로 폐기.
    let cmd = "printf 'AUTHENTICATE\\nSIGNAL " + signal + "\\nQUIT\\n' | nc -w 2 " + TOR_CTRL_HOST + " " + TOR_CTRL_PORT + " 2>/dev/null | head -1 | awk '{print $1}'"
    return exec(cmd).trim()
}

fn _tor_ctrl_getinfo(key: str) -> str {
    // GETINFO 의 응답 첫 줄 (250-key=value 형식) 의 status code 만 추출.
    // value 자체는 의도적으로 폐기 (G2 — 회로 메타 leak 회피).
    let cmd = "printf 'AUTHENTICATE\\nGETINFO " + key + "\\nQUIT\\n' | nc -w 2 " + TOR_CTRL_HOST + " " + TOR_CTRL_PORT + " 2>/dev/null | grep -E '^250' | head -1 | awk '{print $1}'"
    return exec(cmd).trim()
}

// ---------------------------------------------------------------------------
// availability — system PATH 에 tor 바이너리가 있는지.
// ---------------------------------------------------------------------------

fn tor_available() -> bool {
    let path = exec("command -v " + TOR_BIN + " 2>/dev/null").trim()
    return path != ""
}

// ---------------------------------------------------------------------------
// SOCKS port 가 listen 중인지 — `nc -z` 로 비침투 probe.
// 실제 traffic 안 흘려보내고 connect handshake 만.
// ---------------------------------------------------------------------------

fn _socks_listening() -> bool {
    let r = exec("nc -z -w 1 " + TOR_SOCKS_HOST + " " + TOR_SOCKS_PORT + " 2>/dev/null && echo y").trim()
    return r == "y"
}

fn _ctrl_listening() -> bool {
    let r = exec("nc -z -w 1 " + TOR_CTRL_HOST + " " + TOR_CTRL_PORT + " 2>/dev/null && echo y").trim()
    return r == "y"
}

// ---------------------------------------------------------------------------
// Health (G3) — label only. SOCKS port reachable + control port bootstrap done
// 이면 "up", SOCKS reachable 만 이면 "bootstrapping", 아니면 "down".
//
// G2 — bootstrap GETINFO 의 percent value (e.g. "85 done") 본문은 안 읽음.
// status code 250 (GETINFO 성공) + circuit-established=1 신호만 보고 판정.
// ---------------------------------------------------------------------------

fn tor_health() -> str {
    if !tor_available() { return "down" }
    if !_socks_listening() { return "down" }

    // SOCKS 는 떠 있음 — control port 로 circuit-established 확인.
    if !_ctrl_listening() {
        // SOCKS 는 살아있는데 control port 못 잡으면 "up" 으로 보수적 판정
        // (operator 가 ControlPort 를 의도적으로 끄는 경우; circuit isolation
        // 기능은 잃지만 egress 는 가능). caller 가 new_circuit() 호출하면 fail.
        return "up"
    }

    let s = _tor_ctrl_getinfo("status/circuit-established")
    if s == "250" { return "up" }
    if s == "" { return "bootstrapping" }
    return "bootstrapping"
}

// ---------------------------------------------------------------------------
// Lifecycle — start / stop. ghost 는 daemon 라이프사이클 책임 X (위 운영 모델
// 주석 참조). 단, "이미 살아있는지" 체크는 해서 caller 가 의도와 실 상태 align.
// ---------------------------------------------------------------------------

fn tor_start() -> str {
    if !tor_available() {
        return "unavailable: system tor not installed (try: brew install tor)"
    }
    if _socks_listening() {
        return "ok: already running"
    }
    // ghost 자체는 daemon 안 띄움 — operator 의 system service 책임.
    return "down: please start system tor (brew services start tor / systemctl start tor)"
}

fn tor_stop() -> str {
    if !tor_available() { return "unavailable" }
    if !_ctrl_listening() {
        return "noop: control port closed (no graceful shutdown path)"
    }
    // SIGNAL SHUTDOWN 은 daemon 즉시 종료. ghost 가 띄운 게 아니므로 신중.
    // operator 가 명시 호출했을 때만 효과. 응답 status code 만 회수.
    let s = _tor_ctrl("SHUTDOWN")
    if s == "250" { return "ok" }
    return "fail: control port did not ack shutdown"
}

// ---------------------------------------------------------------------------
// Fresh circuit — sweep tier broadcast 직전 호출. NEWNYM 은 다음 stream 부터
// 새 회로 사용 강제 (기존 stream 은 영향 X). 응답 본문 폐기 (G2).
// ---------------------------------------------------------------------------

fn tor_new_circuit() -> str {
    if !tor_available() { return "unavailable" }
    if !_ctrl_listening() {
        return "fail: control port not reachable"
    }
    let s = _tor_ctrl("NEWNYM")
    if s == "250" { return "ok" }
    return "fail: NEWNYM not acked"
}

// ---------------------------------------------------------------------------
// SOCKS endpoint — caller 가 자기 HTTP 클라이언트의 SOCKS5 proxy 로 사용.
// 살아있으면 고정 문자열 반환, 죽었으면 빈 문자열.
// G3 — endpoint 는 localhost 고정값이므로 deanonymizing info 아님.
// G2 — caller 는 이 endpoint 를 통해 보내는 URL/host 를 ghost 에 알리지 않음
// (separation, route.hexa 의 `_apply_*_config()` 가 endpoint 만 회수, traffic
// 본문은 caller 영역에서 처리).
// ---------------------------------------------------------------------------

fn tor_socks_endpoint() -> str {
    if !tor_available() { return "" }
    if !_socks_listening() { return "" }
    return TOR_SOCKS_HOST + ":" + TOR_SOCKS_PORT
}

// ---------------------------------------------------------------------------
// G8 — KR exit hard-deny verify. system torrc 의 candidates 에
// `ExcludeExitNodes` 또는 `ExcludeNodes` 가 `{kr}` 포함 명시되어 있는지 grep.
// 미명시 시 KR exit 가능성 — 정책 위반.
// ---------------------------------------------------------------------------

fn _kr_exit_excluded() -> bool {
    // 후보 경로 중 하나라도 매칭되면 ok. shell expansion 으로 $HOME/... 처리.
    let cmd = "for f in " + TORRC_CANDIDATES + "; do test -f $f && grep -E '^[[:space:]]*Exclude(Exit)?Nodes\\b.*\\{kr\\}' $f 2>/dev/null && break; done | head -1"
    let r = exec(cmd).trim()
    return r != ""
}

// ---------------------------------------------------------------------------
// Selftest — 비침투적. CLI / SOCKS / control port 도달성 + G8 KR 차단 verify.
//
// 단계:
//   1. tor 바이너리 존재 → SKIP if not (docker sandbox / no-tor host)
//   2. `tor --version` non-empty → FAIL if empty (binary corrupt)
//   3. tor_health() 가 unknown 외 정상 라벨 반환
//   4. SOCKS port listen → soft-info (operator 가 daemon 안 띄웠을 수도)
//   5. G8: torrc 에 ExcludeExitNodes {kr} 명시 → FAIL if missing (정책 위반)
//      단, daemon 자체가 죽어있을 땐 (3 에서 health=down) verify 스킵
//      (operator 가 아직 tor 를 셋업조차 안 한 상태 — SKIP 더 적절).
//
// G6 sentinel: __GHOST_WRAP_TOR__ <PASS|FAIL|SKIP>
// ---------------------------------------------------------------------------

fn selftest() -> void {
    if !tor_available() {
        println(SELFTEST_SENTINEL + " SKIP — system tor not installed")
        return
    }

    let v = _tor_exec("--version")
    if v == "" {
        println(SELFTEST_SENTINEL + " FAIL — `tor --version` empty (binary corrupt?)")
        return
    }

    let h = tor_health()
    if h == "unknown" {
        println(SELFTEST_SENTINEL + " FAIL — health parser hit unknown state")
        return
    }

    // daemon 안 떠있으면 G8 verify 는 의미없음 — SKIP 으로 surface (operator
    // 가 아직 brew services start tor 를 안 한 상태일 가능성).
    if h == "down" {
        println(SELFTEST_SENTINEL + " SKIP — tor binary present but daemon down (try: brew services start tor)")
        return
    }

    // G8 — daemon 살아있는데 KR exit 미차단 시 stop-the-line FAIL.
    if !_kr_exit_excluded() {
        println(SELFTEST_SENTINEL + " FAIL — G8 violation: torrc missing ExcludeExitNodes {kr} (add to /usr/local/etc/tor/torrc or /opt/homebrew/etc/tor/torrc)")
        return
    }

    println(SELFTEST_SENTINEL + " PASS — tor reachable, health=" + h + ", G8 KR-exit excluded")
}

// ---------------------------------------------------------------------------
// CLI entrypoint (hexa run modules/ghost/wrap_tor.hexa <subcmd>)
// ---------------------------------------------------------------------------

fn main() -> void {
    let a = args()
    if len(a) >= 3 {
        let sub = a[2]
        if sub == "self-test" { selftest(); return }
        if sub == "--selftest" { selftest(); return }
        if sub == "health" { println(tor_health()); return }
        if sub == "available" {
            if tor_available() { println("yes") } else { println("no") }
            return
        }
        if sub == "socks-endpoint" { println(tor_socks_endpoint()); return }
        if sub == "start" { println(tor_start()); return }
        if sub == "stop" { println(tor_stop()); return }
        if sub == "new-circuit" { println(tor_new_circuit()); return }
    }
    println("usage: hexa run modules/ghost/wrap_tor.hexa <sub>")
    println("  self-test | health | available | socks-endpoint")
    println("  start | stop | new-circuit")
}
