// modules/ghost/wrap_mullvad.hexa — Mullvad CLI single edit point (G1)
//
// 책임:
//   1. `mullvad` CLI 의 모든 subprocess 호출은 이 파일의 _mv_exec() 만 통과.
//   2. 표면 — connect / disconnect / health / relay-set / multihop / daita
//      / lockdown-mode 캡슐화.
//   3. mk1 sole VPN backend (locked 2026-05-04 per user mandate
//      "일단 Mullvad 마음에 들어서 mk1 을 이걸로 하자").
//
// 계약 (cpre/contracts.ai.md):
//   G1 — 외부에서 `mullvad` 직접 호출 금지. _mv_exec() 만 통과.
//   G2 — `mullvad status` 의 IP/지오 필드 절대 외부 노출 금지. 첫 토큰 (state
//        명) 만 awk 로 추출, 나머지는 우리 메모리에도 들이지 않음 (defense-in-
//        depth: G3 leak 가능성을 exec 레벨에서 차단).
//   G3 — health 반환은 라벨만 ("up" / "connecting" / "down" / "unknown").
//        IP / ASN / server hostname 절대 caller 에 전달 금지.
//   G8 — relay set location 호출 시 country 인자 검증은 policy.hexa 가 담당.
//        이 파일은 검증된 ISO-2 코드만 받음. mullvad CLI 자체는 KR 도 허용
//        하므로 cond.5 policy 게이트로 KR Tor exit 차단.
//
// 외부 의존성:
//   - Mullvad client (GPLv3) — 시스템 PATH `mullvad` 바이너리.
//   - 미설치 시: 모든 함수 fail-closed ("unavailable" / "down" / SKIP).
//
// 검증된 환경: mullvad-cli 2026.2 (Tahoe-26).
//
// 결제 경로: 직판 카드 또는 Cryptvice voucher (이메일/Signal 즉시 발송) —
// docs/ghost_payment_strategy_2026_05_04.ai.md.
//
// 상태: ghost.cond.2 met candidate (selftest sentinel + G1 grep test 통과).

use "../../core/core"

let MULLVAD_BIN = "mullvad"
let SELFTEST_SENTINEL = "__GHOST_WRAP_MULLVAD__"

// ---------------------------------------------------------------------------
// G1 chokepoint — every mullvad invocation goes through here.
// stdout 만 반환, stderr 는 /dev/null. 실패 시 빈 문자열.
// ---------------------------------------------------------------------------

fn _mv_exec(args: str) -> str {
    return exec(MULLVAD_BIN + " " + args + " 2>/dev/null").trim()
}

fn mullvad_available() -> bool {
    let path = exec("command -v " + MULLVAD_BIN + " 2>/dev/null").trim()
    return path != ""
}

// ---------------------------------------------------------------------------
// Health (G3) — return state label ONLY, never the IP/server line.
//
// `mullvad status` 출력은 보통 2 줄:
//   Connecting to wg0-jp1.relays.mullvad.net... | Disconnected | Connected ...
//   Visible location: ..., IPv4: 1.2.3.4    ← G3 위반 가능성, 절대 안 봄
//
// awk '{print $1}' 로 첫 줄 첫 토큰만 추출 → state 명만 우리 메모리에 들어옴.
// ---------------------------------------------------------------------------

fn mullvad_health() -> str {
    if !mullvad_available() { return "down" }
    let first = exec(MULLVAD_BIN + " status 2>/dev/null | head -1 | awk '{print $1}'").trim()
    if first == "Connected" { return "up" }
    if first == "Connecting" { return "connecting" }
    if first == "Disconnected" { return "down" }
    if first == "" { return "down" }
    return "unknown"
}

// ---------------------------------------------------------------------------
// Lifecycle — connect / disconnect.
// 반환값은 라벨만 ("ok" / "unavailable"). 상세 상태는 mullvad_health() 로 polling.
// ---------------------------------------------------------------------------

fn mullvad_connect() -> str {
    if !mullvad_available() { return "unavailable" }
    let _r = _mv_exec("connect")
    return "ok"
}

fn mullvad_disconnect() -> str {
    if !mullvad_available() { return "unavailable" }
    let _r = _mv_exec("disconnect")
    return "ok"
}

fn mullvad_reconnect() -> str {
    if !mullvad_available() { return "unavailable" }
    let _r = _mv_exec("reconnect")
    return "ok"
}

// ---------------------------------------------------------------------------
// Relay 설정 — country 인자는 ISO-2 lowercase (jp/se/ch/sg/...).
// G8 — caller (route.hexa) 가 policy.hexa::policy_check_exit() 통과 후 호출.
// ---------------------------------------------------------------------------

fn mullvad_relay_set_location(country: str) -> str {
    if !mullvad_available() { return "unavailable" }
    let _r = _mv_exec("relay set location " + country)
    return "ok"
}

// MultiHop — entry+exit 두 country. enabled=true 면 entry 도 함께 설정.
// Mullvad's MultiHop = WireGuard-in-WireGuard (entry-side ISP 도 exit 못 봄).
fn mullvad_multihop_set(entry_country: str, enabled: bool) -> str {
    if !mullvad_available() { return "unavailable" }
    if enabled {
        let _a = _mv_exec("relay set multihop on")
        let _b = _mv_exec("relay set entry location " + entry_country)
    } else {
        let _c = _mv_exec("relay set multihop off")
    }
    return "ok"
}

// DAITA (Defense Against AI-guided Traffic Analysis) — packet padding +
// timing dithering. Mullvad GotaTun 기능. tier=research 기본 ON.
fn mullvad_daita_set(enabled: bool) -> str {
    if !mullvad_available() { return "unavailable" }
    if enabled {
        let _r = _mv_exec("tunnel set daita on")
    } else {
        let _r = _mv_exec("tunnel set daita off")
    }
    return "ok"
}

// Lockdown mode — Mullvad 자체의 kernel-level kill-switch (mac 의 NE 경로).
// cond.9 의 ghost-managed pf 와 별개. Mullvad daemon 신뢰 시 lockdown 켜고
// pf 보완. 미신뢰 시 pf 단독 (cond.9).
fn mullvad_lockdown_set(enabled: bool) -> str {
    if !mullvad_available() { return "unavailable" }
    if enabled {
        let _r = _mv_exec("lockdown-mode set on")
    } else {
        let _r = _mv_exec("lockdown-mode set off")
    }
    return "ok"
}

// ---------------------------------------------------------------------------
// Selftest — 비침투적 (실 connect 안 함). CLI surface 도달성만 검증.
//
// 단계:
//   1. mullvad 바이너리 존재 → SKIP if not
//   2. `mullvad version` 응답 → FAIL if empty (daemon 죽은 상태)
//   3. mullvad_health() 가 unknown 외 정상 라벨 반환
//   4. `mullvad relay list` 첫 줄 non-empty (relay 카탈로그 도달)
//
// G6 sentinel: __GHOST_WRAP_MULLVAD__ <PASS|FAIL|SKIP>
// ---------------------------------------------------------------------------

fn selftest() -> void {
    if !mullvad_available() {
        println(SELFTEST_SENTINEL + " SKIP — mullvad CLI not installed")
        return
    }

    let v = _mv_exec("version")
    if v == "" {
        println(SELFTEST_SENTINEL + " FAIL — `mullvad version` empty (daemon down?)")
        return
    }

    let h = mullvad_health()
    if h == "unknown" {
        println(SELFTEST_SENTINEL + " FAIL — health parser hit unknown state")
        return
    }

    let relay_top = exec(MULLVAD_BIN + " relay list 2>/dev/null | head -1").trim()
    if relay_top == "" {
        println(SELFTEST_SENTINEL + " FAIL — `mullvad relay list` empty")
        return
    }

    println(SELFTEST_SENTINEL + " PASS — version+health+relay-list reachable, health=" + h)
}

// ---------------------------------------------------------------------------
// CLI entrypoint (hexa run modules/ghost/wrap_mullvad.hexa <subcmd>)
// ---------------------------------------------------------------------------

fn main() -> void {
    let a = args()
    if len(a) >= 3 {
        let sub = a[2]
        if sub == "self-test" { selftest(); return }
        if sub == "--selftest" { selftest(); return }
        if sub == "health" { println(mullvad_health()); return }
        if sub == "available" {
            if mullvad_available() { println("yes") } else { println("no") }
            return
        }
    }
    println("usage: hexa run modules/ghost/wrap_mullvad.hexa { self-test | health | available }")
}
