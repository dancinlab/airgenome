// modules/ghost/audit.hexa — G2 metadata-only ledger
//
// 책임:
//   1. 모든 route 결정 / 백엔드 전환 / downgrade / kill-switch trigger 기록.
//   2. 출력 = state/ghost_audit.jsonl (append-only).
//   3. 스키마: {ts, requester, tier, backend, exit_jurisdiction, rationale,
//              health, no_content: true}.
//   4. cleartext payload (URL path/query, DNS qname, request body, Tor circuit
//      목적지 IP 등) 절대 기록 금지 (G2).
//
// 계약:
//   G2 — payload 필드 (URL, DNS, body) 의 한 바이트도 기록 금지. metadata only.
//   G3 — 외부 노출 surface 는 health 라벨 (up/degraded/down) 만. 실 IP/ASN
//        절대 기록 금지.
//   G8 — exit_jurisdiction + rationale 필드 필수 — 빠지면 audit_emit 거부.
//   G10 — downgrade event 는 별도 record_kind="downgrade" 로 기록 + 호출자에
//         degraded 신호 반환.
//
// 상태: stub (ghost.cond.7 — JSONL emit + G2/G3/G8 필드 검증 활성화 시 구현)

use "../../core/core"

let GHOST_AUDIT_PATH = "state/ghost_audit.jsonl"

// 공개 emit — caller (route.hexa, policy.hexa) 가 호출.
// stub 단계: 호출은 가능하지만 디스크 미기록. 호출 자체는 G2 위반 페이로드 검사
// 시점이라서 실 구현 cond.7 까지는 형식만 유지.
fn audit_emit(requester: str, tier: str, backend: str, jurisdiction: str, rationale: str, health: str) -> str {
    return "audit.stub: ghost.cond.7 unmet — JSONL append 미구현"
}

// downgrade event — G10 fall-back 발생 시 호출.
fn audit_emit_downgrade(from_tier: str, to_tier: str, reason: str) -> str {
    return "audit.stub: ghost.cond.7 unmet — downgrade record 미구현"
}

// G2 invariant 검증 — 구현 시 audit_emit 안에서 호출.
// payload 에 cleartext URL / DNS / body 있을 가능성이 있으면 stop-the-line.
fn audit_g2_assert_metadata_only(field: str, value: str) -> bool {
    return false
}
