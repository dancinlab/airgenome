// displaylink/module/displaylink.hexa
// DisplayLink Manager 라이프사이클 — supervisor cadence 자기충족 reconcile.
//
// Run   : run_hexa_mod displaylink  (bin/airgenome cadence-10s, 매 10s)
// 경로규약: <name>/module/<name>.hexa — run_hexa_mod 가 이 경로로 해석.
//
// 책임 (모두 sudo 불필요, 사용자 GUI 세션 권한만, 매 호출 idempotent):
//   1. AppAutostart=0      — DL Manager 자기-자동시작 무력화
//   2. ShowMenuBarIcon=0   — DL Manager 메뉴바 아이콘 숨김 (headless).
//                            on/off 는 airgenome 자체 메뉴바에서만.
//   3. USB dock 부착 여부 검사 (Vendor=DisplayLink)
//   4. dock 있고 agent 미실행 → `open -gj` 로 launch
//   5. dock 없고 agent 실행 중 → SIGTERM (워처부터 → agent → xpc 순)
//   6. 그 외(이미 정합) → 침묵 (로그 스팸 방지)
//
// headless 노선:
//   코덱만 떼어 쓰는 건 불가능(정적링크·NDA). DL Manager 프로세스는 떠야
//   하지만 그 자체 메뉴바 UI 는 불필요 → ShowMenuBarIcon=0 으로 숨기고
//   on/off 제어는 airgenome 메뉴바로 일원화. 참고: defaults 키는
//   community/DisplayLink 공식 확인 (앱 재시작 시 반영).
//
// 제약:
//   - try/catch 미사용 (hexa-lang stage1)
//   - one-shot 실행, 데몬 아님 — supervisor cadence 가 주기 호출
//   - idempotent — 동일 상태에서 N번 호출해도 부작용 없음
//
// AG 원칙:
//   g1 real-limits-first — DL 코덱은 닫혀있고 인코딩 CPU는 물리적 하한.
//                          소프트웨어 절감 = "안 쓸 때 안 띄우기" 뿐.
//   g_single_process     — 별도 plist/앱 없이 supervisor cadence 흡수.

fn usb_displaylink_attached() -> bool {
    // ioreg는 충분히 빠르다 (~20ms). grep -c 로 매칭 개수만 반환.
    let cnt = exec("ioreg -p IOUSB -l -w 0 | grep -c '\"USB Vendor Name\" = \"DisplayLink\"'").trim()
    return cnt != "" && cnt != "0"
}

fn dl_agent_running() -> bool {
    return exec("pgrep -x DisplayLinkUserAgent").trim() != ""
}

fn ts_iso() -> str {
    return exec("date -u +%Y-%m-%dT%H:%M:%SZ").trim()
}

fn launch_dl() -> void {
    // -g: background, -j: hidden. UI는 LSUIElement=1이라 메뉴바만 뜸.
    let _ = exec("open -gj '/Applications/DisplayLink Manager.app'")
}

fn kill_dl() -> void {
    // 순서 중요: 워처(CrashRestartHelper)가 agent 종료를 감지하면 재시동하므로
    // 반드시 워처부터 죽인 뒤 agent → xpc 순으로 정리. -KILL이 아니라 -TERM이라
    // DL 측 cleanup hook은 보장.
    let _1 = exec("pkill -TERM -x CrashRestartHelper 2>/dev/null")
    let _2 = exec("pkill -TERM -x DisplayLinkUserAgent 2>/dev/null")
    let _3 = exec("pkill -TERM -x DisplayLinkXpcService 2>/dev/null")
}

fn ensure_autostart_off() -> void {
    // idempotent. 값이 이미 0이면 defaults가 no-op. 매 호출 적용해 두면
    // DL Manager가 무슨 경로로 자기 plist를 1로 되돌려도 다음 사이클에 잡힘.
    let _ = exec("defaults write com.displaylink.DisplayLinkUserAgent AppAutostart -bool false 2>/dev/null")
}

fn ensure_menubar_hidden() -> void {
    // ShowMenuBarIcon=0 → DL Manager 자체 메뉴바 아이콘 숨김 (headless).
    // 앱 재시작 시 반영되므로, 이후 launch_dl() 이 띄우는 인스턴스부터 적용.
    // idempotent — DL 이 값을 되돌려도 다음 cadence 에서 재적용.
    let _ = exec("defaults write com.displaylink.DisplayLinkUserAgent ShowMenuBarIcon -bool false 2>/dev/null")
}

fn reconcile() -> void {
    ensure_autostart_off()
    ensure_menubar_hidden()
    let attached = usb_displaylink_attached()
    let running = dl_agent_running()

    if attached {
        if running {
            return
        }
        launch_dl()
        println("[" + ts_iso() + "] launch — USB DisplayLink attached, agent down")
        return
    }

    // !attached
    if running {
        kill_dl()
        println("[" + ts_iso() + "] kill — USB DisplayLink absent, agent up")
        return
    }
    // no-op: 둘 다 false (보통 상태). 침묵.
}

reconcile()
