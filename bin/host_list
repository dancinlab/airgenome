#!/usr/bin/env bash
# bin/host_list — hosts.json SSOT 조회 helper. 하드코딩 박멸용.
#
# 사용:
#   host_list              enabled 호스트 키 (공백 구분)
#   host_list --all        disabled 포함 전체 키
#   host_list --remote     kind=lan|remote 만 (self 제외)
#   host_list --ssh        ssh_alias 만 (null 제외, enabled)
#   host_list --display    display_name 만 (순서 보존)
#   host_list --short      short_code 만
#   host_list --json       enabled 호스트 전체 JSON (jq 파이프용)
#   host_list --env        bash source-able env vars 생성
#                          예: HOSTS_ALL="ubu ubu2 htz mac"
#                              HOSTS_REMOTE="ubu ubu2 htz"
#                              HOST_ALIAS_ubu="ubu"   HOST_DISPLAY_ubu="U¹"
#                              HOST_HOME_ubu="/home/aiden"  HOST_SHORT_ubu="ubu1"
#   host_list resolve <X>  ubu1/U¹/ubu 아무거나 받아 canonical 키(ubu) 출력

set -euo pipefail

HOSTS_JSON="${HOSTS_JSON:-${AIRGENOME_ROOT:-$HOME/Dev/airgenome}/shared/config/hosts.json}"
[ -f "$HOSTS_JSON" ] || { echo "host_list: hosts.json not found: $HOSTS_JSON" >&2; exit 2; }

mode="${1:---enabled}"

case "$mode" in
    ""|--enabled)
        jq -r '.hosts | to_entries[] | select(.value.enabled==true) | .key' "$HOSTS_JSON" | tr '\n' ' ' | sed 's/ $/\n/'
        ;;
    --all)
        jq -r '.hosts | keys[]' "$HOSTS_JSON" | tr '\n' ' ' | sed 's/ $/\n/'
        ;;
    --remote)
        jq -r '.hosts | to_entries[] | select(.value.enabled==true and .value.kind!="self") | .key' "$HOSTS_JSON" | tr '\n' ' ' | sed 's/ $/\n/'
        ;;
    --ssh)
        jq -r '.hosts | to_entries[] | select(.value.enabled==true and .value.ssh_alias!=null) | .value.ssh_alias' "$HOSTS_JSON" | tr '\n' ' ' | sed 's/ $/\n/'
        ;;
    --display)
        jq -r '.hosts | to_entries[] | select(.value.enabled==true) | .value.display_name // .key' "$HOSTS_JSON" | tr '\n' ' ' | sed 's/ $/\n/'
        ;;
    --short)
        jq -r '.hosts | to_entries[] | select(.value.enabled==true) | .value.short_code // .key' "$HOSTS_JSON" | tr '\n' ' ' | sed 's/ $/\n/'
        ;;
    --json)
        jq '.hosts | to_entries | map(select(.value.enabled==true)) | from_entries' "$HOSTS_JSON"
        ;;
    --env)
        echo "# auto-generated by host_list --env at $(date -u +%FT%TZ)"
        echo "# SSOT: $HOSTS_JSON"
        echo
        keys=$(jq -r '.hosts | to_entries[] | select(.value.enabled==true) | .key' "$HOSTS_JSON" | tr '\n' ' ')
        remote=$(jq -r '.hosts | to_entries[] | select(.value.enabled==true and .value.kind!="self") | .key' "$HOSTS_JSON" | tr '\n' ' ')
        echo "export HOSTS_ALL=\"${keys%  }\""
        echo "export HOSTS_REMOTE=\"${remote%  }\""
        jq -r '.hosts | to_entries[] | select(.value.enabled==true) |
            "export HOST_ALIAS_\(.key)=\"\(.value.ssh_alias // "")\"\n" +
            "export HOST_DISPLAY_\(.key)=\"\(.value.display_name // .key)\"\n" +
            "export HOST_SHORT_\(.key)=\"\(.value.short_code // .key)\"\n" +
            "export HOST_HOME_\(.key)=\"\(.value.home // "")\"\n" +
            "export HOST_KIND_\(.key)=\"\(.value.kind)\"\n" +
            "export HOST_THREADS_\(.key)=\"\(.value.threads // 0)\""
        ' "$HOSTS_JSON"
        ;;
    resolve)
        query="${2:?usage: host_list resolve <name>}"
        # short_code, display_name, ssh_alias, or key match
        result=$(jq -r --arg q "$query" '.hosts | to_entries[] |
            select(.value.enabled==true) |
            select(
                .key == $q or
                .value.short_code == $q or
                .value.ssh_alias == $q or
                .value.display_name == $q
            ) | .key' "$HOSTS_JSON" | head -1)
        [ -n "$result" ] && echo "$result" || { echo "host_list: unresolved: $query" >&2; exit 1; }
        ;;
    -h|--help)
        sed -n '2,18p' "$0" | sed 's/^# \{0,1\}//'
        ;;
    *)
        echo "host_list: unknown mode '$mode'. --help 참조." >&2
        exit 2
        ;;
esac
