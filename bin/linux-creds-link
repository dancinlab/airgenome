#!/usr/bin/env bash
# bin/linux-creds-link — Linux 호스트의 .credentials.json 을 Mac mirror symlink 로 교체
#                        (Step B Phase 3, 2026-04-21)
#
# 전제:
#   - Mac: ~/.airgenome/creds_mirror/claudeN.json 이 creds-mirror daemon 으로 항상 fresh
#   - 원격 Linux: /mac_home 에 Mac $HOME 이 sshfs(rw, allow_other) 로 마운트됨
#
# 동작:
#   각 계정의 ~/.claude-claudeN/.credentials.json 을
#   → symlink → /mac_home/.airgenome/creds_mirror/claudeN.json
#
# 효과:
#   - Linux claude CLI 가 read 하면 Mac keychain 의 최신 OAuth
#   - Linux claude CLI 가 write (refresh) 해도 symlink 경유 Mac 파일 업데이트 →
#     creds-mirror daemon 다음 tick 에서 keychain write-back → 전체 호스트 일관
#   - token rotation 충돌 제거: SSOT 는 Mac keychain 뿐
#
# 사용:
#   linux-creds-link --host=ubu2-d                   # 단일 호스트 apply
#   linux-creds-link --host=all                      # enabled remote 전체
#   linux-creds-link --host=ubu2-d --revert          # symlink → regular file 로 복구
#   linux-creds-link --host=ubu2-d --dry-run         # 변경 없이 예정 동작 출력
#   linux-creds-link --status --host=ubu2-d          # 현재 링크 상태 매트릭스
#   linux-creds-link --install-guard --host=ubu2-d   # remote-creds-guard daemon 배포+기동
#   linux-creds-link --guard-status  --host=ubu2-d   # guard 프로세스/링크 상태
#   linux-creds-link --guard-stop    --host=ubu2-d   # guard daemon 종료
#
# 안전:
#   - 기존 파일은 .credentials.json.bak 으로 백업 (첫 실행에만; bak 있으면 skip)
#   - --revert 시 bak 이 있으면 복원, 없으면 Mac mirror 파일 내용 copy
#   - mount 가 끊긴 호스트에선 --status 만 가능, apply 는 거부

set -uo pipefail

ROOT="${AIRGENOME_ROOT:-$HOME/Dev/airgenome}"
ACCOUNTS="${ACCOUNTS:-/Users/ghost/Dev/nexus/shared/.runtime/accounts/accounts.json}"
MAC_MIRROR="/mac_home/.airgenome/creds_mirror"

ts()   { date '+%Y-%m-%dT%H:%M:%S'; }
log()  { printf '[linux-creds-link %s] %s\n' "$(ts)" "$*" >&2; }

_usage() { sed -n '2,30p' "$0" | sed 's/^# \{0,1\}//'; }

# ── args ─────────────────────────────────────────────────────────
target_host=""
do_revert=false
dry_run=false
do_status=false
do_install_guard=false
do_guard_status=false
do_guard_stop=false

while [ $# -gt 0 ]; do
    case "$1" in
        --host=*)          target_host="${1#--host=}"; shift ;;
        --host)            target_host="$2"; shift 2 ;;
        --revert)          do_revert=true; shift ;;
        --dry-run)         dry_run=true; shift ;;
        --status)          do_status=true; shift ;;
        --install-guard)   do_install_guard=true; shift ;;
        --guard-status)    do_guard_status=true; shift ;;
        --guard-stop)      do_guard_stop=true; shift ;;
        -h|--help)         _usage; exit 0 ;;
        *)                 echo "linux-creds-link: unknown '$1'" >&2; exit 2 ;;
    esac
done

[ -z "$target_host" ] && { echo "--host=<alias|all> 필요" >&2; exit 2; }

# ── host list 확장 ────────────────────────────────────────────────
hosts=()
if [ "$target_host" = "all" ]; then
    # /mac_home sshfs 마운트가 있는 docker 호스트 전용. host_list --ssh 는 bare-metal
    # alias(ubu, ubu2, hetzner) 를 반환해서 마운트 없는 호스트가 섞여 들어감 — 사용 X.
    # docker 호스트 목록은 현재 ubu2-d, htz-d 로 고정 (SSH config Host 정의).
    hosts=(ubu2-d htz-d)
else
    hosts=("$target_host")
fi

# ── 계정 이름 목록 (natural sort) ─────────────────────────────────
names=()
if [ -f "$ACCOUNTS" ]; then
    while IFS= read -r n; do names+=("$n"); done < <(jq -r '.accounts[].name' "$ACCOUNTS" | sort -V)
fi
[ ${#names[@]} -eq 0 ] && names=(claude1 claude2 claude3 claude4 claude5 claude6 claude7 claude8 claude9 claude10 claude11 claude12)

# ── 원격에서 실행될 스크립트 body 생성기 ──────────────────────────
_remote_apply_script() {
    local revert=$1 dry=$2
    cat <<REMOTE_EOF
set -uo pipefail
MIRROR_DIR="$MAC_MIRROR"
REVERT=$revert
DRY=$dry

# mount 활성 확인
if ! mountpoint -q /mac_home 2>/dev/null && ! ls "\$MIRROR_DIR" >/dev/null 2>&1; then
    echo "ERR: /mac_home sshfs mount 없음 — symlink 대상 접근 불가"
    exit 3
fi

ok=0; fail=0; skip=0
for n in $(printf '%s ' "${names[@]}"); do
    tgt="\$MIRROR_DIR/\$n.json"
    link="\$HOME/.claude-\$n/.credentials.json"

    if [ "\$REVERT" = "true" ]; then
        # symlink → regular file 복구
        if [ -L "\$link" ]; then
            if [ -f "\$link.bak" ]; then
                rm -f "\$link"; mv "\$link.bak" "\$link"
                echo "\$n: REVERTED (from .bak)"; ok=\$((ok+1))
            elif [ -r "\$tgt" ]; then
                rm -f "\$link"
                cp "\$tgt" "\$link"
                chmod 600 "\$link"
                echo "\$n: REVERTED (from mirror copy)"; ok=\$((ok+1))
            else
                echo "\$n: REVERT FAIL — bak 도 mirror 도 없음"; fail=\$((fail+1))
            fi
        else
            skip=\$((skip+1))
        fi
        continue
    fi

    # apply
    if [ ! -r "\$tgt" ]; then
        echo "\$n: SKIP — mirror 파일 없음 (\$tgt)"; skip=\$((skip+1)); continue
    fi
    if [ -L "\$link" ]; then
        current=\$(readlink "\$link" 2>/dev/null)
        if [ "\$current" = "\$tgt" ]; then
            skip=\$((skip+1)); continue
        fi
        [ "\$DRY" = "true" ] && { echo "\$n: DRY replace symlink → \$tgt"; continue; }
        rm -f "\$link"
    elif [ -e "\$link" ]; then
        # regular file — backup 후 symlink
        [ "\$DRY" = "true" ] && { echo "\$n: DRY backup + symlink → \$tgt"; continue; }
        [ ! -e "\$link.bak" ] && cp "\$link" "\$link.bak"
        rm -f "\$link"
    else
        [ "\$DRY" = "true" ] && { echo "\$n: DRY create symlink → \$tgt"; continue; }
        mkdir -p "\$(dirname "\$link")"
    fi
    ln -s "\$tgt" "\$link"
    echo "\$n: LINKED → \$tgt"; ok=\$((ok+1))
done
echo "summary: ok=\$ok skip=\$skip fail=\$fail"
REMOTE_EOF
}

# ── 원격 status 함수 ──────────────────────────────────────────────
_remote_status_script() {
    cat <<REMOTE_EOF
set -uo pipefail
MIRROR_DIR="$MAC_MIRROR"
printf '%-10s %s\n' "account" "state"
for n in $(printf '%s ' "${names[@]}"); do
    link="\$HOME/.claude-\$n/.credentials.json"
    tgt="\$MIRROR_DIR/\$n.json"
    if [ -L "\$link" ]; then
        cur=\$(readlink "\$link")
        if [ "\$cur" = "\$tgt" ]; then
            if [ -r "\$cur" ]; then
                printf '%-10s %s\n' "\$n" "SYMLINK_OK → mirror"
            else
                printf '%-10s %s\n' "\$n" "SYMLINK_BROKEN (target unreadable)"
            fi
        else
            printf '%-10s %s\n' "\$n" "SYMLINK_OTHER → \$cur"
        fi
    elif [ -f "\$link" ]; then
        printf '%-10s %s\n' "\$n" "REGULAR_FILE"
    else
        printf '%-10s %s\n' "\$n" "MISSING"
    fi
done
REMOTE_EOF
}

GUARD_LOCAL="$ROOT/bin/remote-creds-guard"
GUARD_REMOTE_DIR='$HOME/.airgenome/bin'
GUARD_REMOTE_PATH='$HOME/.airgenome/bin/creds-guard.sh'
GUARD_PID_FILE='$HOME/.airgenome/creds-guard.pid'

_install_guard_script() {
    # 원격에서 PID-lock 기반으로 이미 돌고 있으면 skip, 아니면 nohup 으로 기동.
    cat <<REMOTE_EOF
set -uo pipefail
mkdir -p $GUARD_REMOTE_DIR "\$HOME/.airgenome/logs"
# 이미 살아있는지 확인
if [ -f $GUARD_PID_FILE ]; then
    pid=\$(cat $GUARD_PID_FILE 2>/dev/null)
    if [ -n "\$pid" ] && kill -0 "\$pid" 2>/dev/null; then
        echo "already running pid=\$pid"
        # 스크립트 업그레이드 필요 여부 확인
        if [ -f $GUARD_REMOTE_PATH ] && ! diff -q /tmp/creds-guard.new $GUARD_REMOTE_PATH >/dev/null 2>&1; then
            echo "스크립트 변경 감지 → daemon 재시작"
            kill "\$pid" 2>/dev/null; sleep 1
        else
            cp /tmp/creds-guard.new $GUARD_REMOTE_PATH
            chmod +x $GUARD_REMOTE_PATH
            exit 0
        fi
    fi
fi
cp /tmp/creds-guard.new $GUARD_REMOTE_PATH
chmod +x $GUARD_REMOTE_PATH
# nohup 으로 기동 + PID 저장
nohup $GUARD_REMOTE_PATH >/dev/null 2>&1 &
echo \$! > $GUARD_PID_FILE
sleep 1
new_pid=\$(cat $GUARD_PID_FILE)
if kill -0 "\$new_pid" 2>/dev/null; then
    echo "guard started pid=\$new_pid"
else
    echo "guard FAIL to start"
    exit 1
fi
REMOTE_EOF
}

_guard_status_script() {
    cat <<REMOTE_EOF
set -uo pipefail
pid=\$(cat $GUARD_PID_FILE 2>/dev/null)
if [ -n "\$pid" ] && kill -0 "\$pid" 2>/dev/null; then
    echo "daemon: RUNNING pid=\$pid"
else
    echo "daemon: NOT RUNNING"
fi
if [ -x $GUARD_REMOTE_PATH ]; then
    $GUARD_REMOTE_PATH --status 2>&1
else
    echo "guard script 없음: $GUARD_REMOTE_PATH"
fi
REMOTE_EOF
}

_guard_stop_script() {
    cat <<REMOTE_EOF
set -uo pipefail
pid=\$(cat $GUARD_PID_FILE 2>/dev/null)
if [ -n "\$pid" ] && kill "\$pid" 2>/dev/null; then
    echo "killed pid=\$pid"
    rm -f $GUARD_PID_FILE
else
    echo "no running guard"
fi
REMOTE_EOF
}

# ── execute ──────────────────────────────────────────────────────
SSH_OPTS=(-o ConnectTimeout=8 -o BatchMode=yes -o ServerAliveInterval=10)
for host in "${hosts[@]}"; do
    log "=== $host ==="
    if [ "$do_status" = "true" ]; then
        ssh "${SSH_OPTS[@]}" "$host" "$(_remote_status_script)" 2>&1 || log "$host: status 실패"
        continue
    fi
    if [ "$do_guard_status" = "true" ]; then
        ssh "${SSH_OPTS[@]}" "$host" "$(_guard_status_script)" 2>&1 || log "$host: guard-status 실패"
        continue
    fi
    if [ "$do_guard_stop" = "true" ]; then
        ssh "${SSH_OPTS[@]}" "$host" "$(_guard_stop_script)" 2>&1 || log "$host: guard-stop 실패"
        continue
    fi
    if [ "$do_install_guard" = "true" ]; then
        if [ ! -f "$GUARD_LOCAL" ]; then
            log "$host: 로컬 guard 스크립트 없음 ($GUARD_LOCAL)"
            continue
        fi
        # scp 로 script 전송 → install script 호출
        scp -q -o ConnectTimeout=8 "$GUARD_LOCAL" "$host:/tmp/creds-guard.new" 2>&1 || {
            log "$host: scp 실패"; continue
        }
        ssh "${SSH_OPTS[@]}" "$host" "$(_install_guard_script)" 2>&1 || log "$host: install 실패"
        continue
    fi
    script=$(_remote_apply_script "$do_revert" "$dry_run")
    if [ "$dry_run" = "true" ]; then
        log "(dry-run)"
    fi
    ssh "${SSH_OPTS[@]}" "$host" "$script" 2>&1 || log "$host: apply 실패"
done
