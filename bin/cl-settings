#!/usr/bin/env bash
# L0 CORE — chflags uchg 후 수정 금지. 변경 시 `chflags nouchg`.
# bin/cl-settings — converge Claude Code settings.json on wildcard-allow +
# git-push-force-deny shape. Absorbs the sync_claude_settings() routine that
# lived in bin/airgenome-init per commit 760ae110 (2026-04-20).
#
# Contract:
#   cl-settings                 sync global ~/.claude/settings.json.
#   cl-settings --project       also sync ./.claude/settings.json (cwd).
#   cl-settings --project <dir> sync <dir>/.claude/settings.json in addition
#                               to global.
#   cl-settings --global-only   global only (explicit; same as no flag).
#   cl-settings --accounts      inject defaultMode:bypassPermissions +
#                               skipDangerousModePermissionPrompt into every
#                               ~/.claude-claude*/settings.json
#                               (no allow/deny injection — account dirs are
#                               auth dirs, not policy dirs).
#   cl-settings --sweep         inject defaultMode:bypassPermissions +
#                               skipDangerousModePermissionPrompt into every
#                               ~/core/*/.claude/settings.json and
#                               ~/etc/*/.claude/settings.json
#                               (allow/deny lists preserved — each project
#                               owns its own rules). Excludes ~/core/nexus/
#                               by default (unrelated upstream).
#   cl-settings --dry           print resulting JSON + diff, do not write.
#   cl-settings self-test       tmp-file sync + strip + idempotence check.
#
# Shape it enforces (merged via jq — preserves keys not listed):
#   .permissions.allow                    ⊇  wildcard list (below)
#   .permissions.deny                     ⊇  git push -f/--force 5 patterns
#   .permissions.defaultMode              =  "bypassPermissions"
#   .skipDangerousModePermissionPrompt    =  true
#
# Policy: no backups. airgenome convention is "don't keep .bak.* files" —
# settings.json is recoverable via git (project files) or by re-running
# this tool (wildcard defaults). Removed 2026-04-21 after user directive.
#
# Dependencies: bash, jq.
# State: writes settings.json (in place). Network: none.

set -uo pipefail

# --- expected shape (single source of truth) ------------------------------
_shape_json() {
    cat <<'JSON'
{
  "permissions": {
    "allow": [
      "Bash", "Bash(*)", "Bash(*:*)",
      "Read(//**)",
      "Write(//**)",
      "Edit(//**)"
    ],
    "deny": [
      "Bash(git push -f*)",
      "Bash(git push --force*)",
      "Bash(git push * -f*)",
      "Bash(git push * --force*)",
      "Bash(git push * +*)"
    ],
    "defaultMode": "bypassPermissions"
  },
  "skipDangerousModePermissionPrompt": true
}
JSON
}

# Merge SHAPE into TARGET, union-ing allow/deny, and enforcing
# defaultMode:bypassPermissions + skipDangerousModePermissionPrompt=true.
# Emits merged JSON on stdout.
_merged_for() {
    local target="$1"
    local current
    if [ -f "$target" ]; then
        current=$(cat "$target")
    else
        current='{}'
    fi
    local shape
    shape=$(_shape_json)
    jq -n --argjson cur "$current" --argjson sh "$shape" '
        def uniq_union(a; b): (a // []) + (b // []) | unique;
        ($cur + $sh)
        | .permissions = (($cur.permissions // {}) + ($sh.permissions // {}))
        | .permissions.allow = uniq_union($cur.permissions.allow; $sh.permissions.allow)
        | .permissions.deny  = uniq_union($cur.permissions.deny;  $sh.permissions.deny)
        | .permissions.defaultMode = "bypassPermissions"
        | .skipDangerousModePermissionPrompt = true
    '
}

_write() {
    local target="$1" new_content="$2"
    mkdir -p "$(dirname "$target")"
    printf '%s\n' "$new_content" > "$target"
}

# Inject-only pass — no allow/deny changes. Sets
# defaultMode:bypassPermissions + skipDangerousModePermissionPrompt=true.
# Emits result on stdout.
_injected_for() {
    local target="$1"
    local current
    if [ -f "$target" ]; then
        current=$(cat "$target")
    else
        echo "cl-settings: $target does not exist" >&2
        return 1
    fi
    jq '
        .permissions = ((.permissions // {}) | .defaultMode = "bypassPermissions")
        | .skipDangerousModePermissionPrompt = true
    ' <<< "$current"
}

_apply_inject() {
    local target="$1" dry="${2:-0}"
    local injected
    if ! injected=$(_injected_for "$target"); then
        return 1
    fi
    if [ "$dry" = "1" ]; then
        echo "--- inject only: $target ---"
        diff <(jq -S . "$target" 2>/dev/null) <(printf '%s\n' "$injected" | jq -S .) || true
        return 0
    fi
    if diff -q \
            <(jq -S . "$target" 2>/dev/null) \
            <(printf '%s\n' "$injected" | jq -S .) >/dev/null 2>&1; then
        return 0  # quiet — no change
    fi
    printf '%s\n' "$injected" > "$target"
    echo "cl-settings: injected bypass into $target"
}

_apply() {
    local target="$1" dry="${2:-0}"
    local merged
    if ! merged=$(_merged_for "$target"); then
        echo "cl-settings: jq merge failed for $target" >&2
        return 1
    fi
    if [ "$dry" = "1" ]; then
        echo "--- would write: $target ---"
        printf '%s\n' "$merged"
        if [ -f "$target" ]; then
            echo "--- diff vs current ---"
            diff <(jq -S . "$target" 2>/dev/null || cat "$target") <(printf '%s\n' "$merged" | jq -S .) || true
        else
            echo "--- (target did not exist) ---"
        fi
        return 0
    fi
    # Idempotence — skip write if already equal.
    if [ -f "$target" ] && diff -q \
            <(jq -S . "$target" 2>/dev/null) \
            <(printf '%s\n' "$merged" | jq -S .) >/dev/null 2>&1; then
        echo "cl-settings: $target already in shape (no write)"
        return 0
    fi
    _write "$target" "$merged"
    echo "cl-settings: synced $target"
}

# --- self-test ------------------------------------------------------------
_self_test() {
    local tmp rc=0
    tmp=$(mktemp -d -t cl-settings.XXXXXX)

    # 1. merge into empty
    _apply "$tmp/empty.json" >/dev/null
    if jq -e '(.permissions.allow | index("Bash(*)"))
              and (.permissions.allow | index("Read(//**)"))
              and (.permissions.deny  | index("Bash(git push --force*)"))
              and (.permissions.defaultMode == "bypassPermissions")
              and (.skipDangerousModePermissionPrompt == true)' \
            "$tmp/empty.json" >/dev/null; then
        echo "  ✓ merge into empty produces expected shape"
    else
        echo "  ✗ merge into empty missing fields" >&2; rc=1
    fi

    # 2. inject bypass into a plain file that lacks it
    cat > "$tmp/plain.json" <<'JSON'
{
  "permissions": {
    "allow": ["Read"],
    "deny": ["Bash(rm -rf /*)"]
  },
  "env": {"KEEP_ME": "1"}
}
JSON
    _apply "$tmp/plain.json" >/dev/null
    if jq -e '(.permissions.defaultMode == "bypassPermissions")
              and (.skipDangerousModePermissionPrompt == true)
              and (.env.KEEP_ME == "1")
              and (.permissions.allow | index("Read"))
              and (.permissions.allow | index("Bash(*)"))
              and (.permissions.deny  | index("Bash(rm -rf /*)"))
              and (.permissions.deny  | index("Bash(git push --force*)"))' \
            "$tmp/plain.json" >/dev/null; then
        echo "  ✓ bypass injected, unrelated keys preserved, unions taken"
    else
        echo "  ✗ inject/preserve/union broke" >&2; rc=1
    fi

    # 3. idempotence — second apply must not change the file
    cp "$tmp/plain.json" "$tmp/plain.snap"
    _apply "$tmp/plain.json" >/dev/null
    if diff -q <(jq -S . "$tmp/plain.snap") <(jq -S . "$tmp/plain.json") >/dev/null; then
        echo "  ✓ idempotent (second apply = no-op)"
    else
        echo "  ✗ not idempotent" >&2; rc=1
    fi

    # 4. no backups created (policy: airgenome convention).
    if ls "$tmp"/*.bak.* >/dev/null 2>&1; then
        echo "  ✗ backup files created (should be none)" >&2; rc=1
    else
        echo "  ✓ no backup files created"
    fi

    rm -rf "$tmp"
    [ $rc -eq 0 ] && echo "self-test: PASS" || echo "self-test: FAIL"
    return $rc
}

# --- cli ------------------------------------------------------------------
mode_global=1
project_dir=""
do_accounts=0
do_sweep=0
sweep_include_nexus=0
dry=0

while [ "$#" -gt 0 ]; do
    case "$1" in
        --project)
            mode_global=1
            if [ "${2:-}" ] && [ "${2:0:1}" != "-" ]; then
                project_dir="$2"; shift 2
            else
                project_dir="$PWD"; shift
            fi
            ;;
        --global-only)        mode_global=1; project_dir=""; shift ;;
        --accounts)           do_accounts=1; shift ;;
        --sweep)              do_sweep=1; shift ;;
        --sweep-include-nexus) do_sweep=1; sweep_include_nexus=1; shift ;;
        --dry)                dry=1; shift ;;
        -h|--help)            sed -n '3,38p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
        self-test)            _self_test; exit $? ;;
        *) echo "cl-settings: unknown arg '$1'" >&2; exit 2 ;;
    esac
done

command -v jq >/dev/null 2>&1 || {
    echo "cl-settings: jq required but not on PATH" >&2; exit 127;
}

rc_total=0
if [ "$mode_global" = "1" ] && [ "$do_accounts" = "0" ] && [ "$do_sweep" = "0" ]; then
    _apply "$HOME/.claude/settings.json" "$dry" || rc_total=1
fi
if [ -n "$project_dir" ]; then
    if [ ! -d "$project_dir" ]; then
        echo "cl-settings: --project dir not found: $project_dir" >&2
        exit 64
    fi
    _apply "$project_dir/.claude/settings.json" "$dry" || rc_total=1
fi
if [ "$do_accounts" = "1" ]; then
    shopt -s nullglob
    for d in "$HOME"/.claude-claude*; do
        [ -d "$d" ] || continue
        [ -f "$d/settings.json" ] || continue
        _apply_inject "$d/settings.json" "$dry" || rc_total=1
    done
    shopt -u nullglob
fi
if [ "$do_sweep" = "1" ]; then
    shopt -s nullglob
    # Include global too since it belongs to the same "strip policy" pass.
    [ -f "$HOME/.claude/settings.json" ] && _apply_inject "$HOME/.claude/settings.json" "$dry"
    for f in "$HOME"/core/*/.claude/settings.json "$HOME"/etc/*/.claude/settings.json; do
        [ -f "$f" ] || continue
        if [ "$sweep_include_nexus" = "0" ] && [[ "$f" == *"/core/nexus/"* ]]; then
            continue
        fi
        _apply_inject "$f" "$dry" || rc_total=1
    done
    shopt -u nullglob
fi
exit $rc_total
