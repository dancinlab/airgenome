#!/usr/bin/env bash
# L0 CORE — 수정 금지 (nexus/shared/L0.json 등록). 변경 시 PR + L0 갱신.
# bin/claudx — limit-resilient unified Claude launcher (airgenome M13, 2026-04-19)
#
# 책임:
#   1. pool.js 로 best 계정 pre-pick → CLAUDE_CONFIG_DIR export
#   2. NODE_OPTIONS 에 interceptor.js 주입 → in-process 자동 rotation 활성
#   3. cx 호출 → host routing 위임. cx 가 env 를 remote 로 forward (M13 패치).
#   4. TUI/print 모드 동일 처리. 429/rate_limit 은 SDK 가 보기 전 interceptor 가 선점.
#
# UI 완전 비가시:
#   - interceptor 가 SDK 앞에서 429/401/rate_limit_error 가로채 → TUI 는 성공 응답만 봄
#   - anthropic-ratelimit-* 헤더 스크럽 (CLAUDX_SCRUB=0 으로 끌 수 있음)
#   - 모든 rotation 이벤트는 ~/.airgenome/claudx/rotations.jsonl 파일 로그. stderr 아님.
#   - pre-launch acct/host 안내 1줄만 stderr 로 나감. CLAUDX_QUIET=1 이면 그것도 억제.
#
# usage:
#   claudx [args...]                # interactive/print — best acct+host 자동 pre-pick + rotation
#   claudx --status                 # 12계정 pool 건강 (가용/고갈/reset_at)
#   claudx --pick                   # best acct 1개 이름만 출력
#   claudx --clear-exhausted [name] # exhausted.json 전체/특정 계정 해제
#   claudx --force-acct claude5     # 특정 계정 고정
#   claudx --force-host mac         # cx --force-host 패스스루
#   claudx --no-rotate              # interceptor 비활성 (pre-pick 만)
#   claudx --show                   # acct/host 결정만 출력 후 종료 (실행 X)
#
# permission 프롬프트:
#   기본값 = --dangerously-skip-permissions 자동 주입 (전면 허용 · 프롬프트 0)
#   CLAUDX_SAFE=1 로 env 지정하면 자동 주입 안 함 — claude 의 기본 권한 검사 복원

set -uo pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
CX_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"
INTERCEPTOR="$CX_ROOT/shared/claudx/interceptor.js"
POOL_JS="$CX_ROOT/shared/claudx/pool.js"

# Mac production defaults. Override via env (e.g. Linux dev/test).
: "${CLAUDX_POOL:=$HOME/Dev/nexus/shared/.runtime/accounts/accounts.json}"
: "${CLAUDX_USAGE:=$HOME/Dev/nexus/shared/.runtime/accounts/usage-cache.json}"
: "${CLAUDX_STATE:=$HOME/.airgenome/claudx}"
: "${CLAUDX_QUIET:=0}"
export CLAUDX_POOL CLAUDX_USAGE CLAUDX_STATE

mkdir -p "$CLAUDX_STATE"

die() { echo "claudx: $*" >&2; exit 2; }
info() { [ "$CLAUDX_QUIET" = "1" ] || echo "claudx: $*" >&2; }

# prune expired exhausted entries (2026-04-19 M14_fix).
# 기존 v2 는 expired entry 가 쌓이면서 허위 pool 축소 → ABORT 재발.
# 진입 직후 jq 로 until<=now 인 엔트리 전수 제거. in-place rewrite.
_prune_exhausted() {
    local f="$CLAUDX_STATE/exhausted.json"
    [ -f "$f" ] || return 0
    local now
    now=$(date +%s) || return 0
    local cleaned orig
    orig=$(cat "$f" 2>/dev/null) || return 0
    cleaned=$(printf '%s' "$orig" | jq --argjson now "$now" 'with_entries(select(.value.until // 0 | tonumber > $now))' 2>/dev/null) || return 0
    if [ -n "$cleaned" ] && [ "$cleaned" != "$orig" ]; then
        printf '%s\n' "$cleaned" > "$f.tmp" && mv "$f.tmp" "$f"
        info "exhausted.json pruned (expired entries removed)"
    fi
}
_prune_exhausted

# loadgate — critical 이면 abort, danger 이면 60s hold, warn/ok 진행 (M13d)
_loadgate() {
    local g rc
    g=$("$CX_ROOT/shared/claudx/loadgate" 2>/dev/null)
    rc=$?
    case "$rc" in
        0|1) : ;;
        2)   info "loadgate=danger — 60s hold"; sleep 60 ;;
        3)   die "loadgate=critical — abort (CLAUDX_LOADGATE_OFF=1 로 우회)" ;;
    esac
}
_loadgate

# --- subcommands that never launch claude ---
case "${1:-}" in
    --status)
        node "$POOL_JS" status
        exit 0
        ;;
    --pick)
        node "$POOL_JS" pick
        exit 0
        ;;
    --clear-exhausted)
        node "$POOL_JS" clear "${2:-}"
        exit 0
        ;;
    --report)
        exec "$CX_ROOT/bin/claudx-idea" report
        ;;
    --cache-stats)
        exec "$CX_ROOT/bin/claudx-idea" cache-stats
        ;;
    --idea)
        shift
        exec "$CX_ROOT/bin/claudx-idea" "$@"
        ;;
    -h|--help)
        sed -n '2,27p' "$0" | sed 's/^# \{0,1\}//'
        exit 0
        ;;
esac

# --- arg split: claudx flags vs passthrough to cx/claude ---
force_acct=""
no_rotate=false
show_only=false
fwd=()
while [ $# -gt 0 ]; do
    case "$1" in
        --force-acct) force_acct=$2; shift 2 ;;
        --no-rotate)  no_rotate=true; shift ;;
        --show)       show_only=true; fwd+=("--show"); shift ;;
        *)            fwd+=("$1"); shift ;;
    esac
done

# --- pick acct ---
# 우선순위: --force-acct > upstream CLAUDE_CONFIG_DIR (cl 등) > pool.pickBest
picked_name=""
picked_dir=""

# 2026-04-21: CLAUDECODE=1 parent guard. 부모가 Claude Code 세션이면
# 상속된 CLAUDE_CONFIG_DIR 은 "부모의 pin" — 새 cl 세션은 rotation 대상이므로
# 무시하고 pickBest 경로로 보낸다. 이 가드가 없으면 Claude 내부 bash 에서 띄우는
# 모든 새 cl 이 부모와 같은 계정으로 고정되어 limit 소진 직격.
# 의도적 고정이 필요하면 CLAUDX_RESPECT_PIN=1 로 우회, 또는 --force-acct 사용.
if [ -n "${CLAUDE_CONFIG_DIR:-}" ] && [ "${CLAUDECODE:-0}" = "1" ] && [ "${CLAUDX_RESPECT_PIN:-0}" != "1" ]; then
    info "CLAUDECODE=1 parent → inherited pin 무시 ($CLAUDE_CONFIG_DIR) → pickBest"
    unset CLAUDE_CONFIG_DIR
fi

if [ -n "$force_acct" ]; then
    picked_name="$force_acct"
    if [ -f "$CLAUDX_POOL" ]; then
        picked_dir=$(jq -r --arg n "$force_acct" '.accounts[] | select(.name==$n) | .config_dir // empty' "$CLAUDX_POOL" 2>/dev/null)
    fi
    [ -n "$picked_dir" ] || die "--force-acct '$force_acct' not in pool ($CLAUDX_POOL)"
elif [ -n "${CLAUDE_CONFIG_DIR:-}" ]; then
    # upstream (cl, user env) 이 이미 선택함 — 존중
    picked_dir="$CLAUDE_CONFIG_DIR"
    picked_name=$(basename "$CLAUDE_CONFIG_DIR" | sed 's/^\.claude-//')
    # (2026-04-19 v2) upstream pin 전수 검증 — exhausted.json 만 보던 기존 로직은
    # session_pct=98% / _retry_at active / week=100% 계정이 그대로 통과하는 구멍.
    # pool.pickBest 가 적용하는 loadPool 필터와 동일 기준으로 pin 을 재검증.
    _now=$(date +%s)
    _reject_reason=""
    _exh_until=$(jq -r --arg n "$picked_name" '(.[$n].until // 0)' "$CLAUDX_STATE/exhausted.json" 2>/dev/null || echo 0)
    if [ "${_exh_until:-0}" -gt "${_now:-0}" ] 2>/dev/null; then
        _reject_reason="local_exhausted(until=$_exh_until)"
    fi
    if [ -z "$_reject_reason" ] && [ -f "$CLAUDX_USAGE" ]; then
        # session_pct>=95 / week_all_pct>=100 / _retry_at>now 전부 pool.js loadPool 과 동일
        _u=$(jq -r --arg n "$picked_name" '[(.[$n].session_pct // 0), (.[$n].week_all_pct // 0), (.[$n]._retry_at // 0)] | @tsv' "$CLAUDX_USAGE" 2>/dev/null)
        # bash arithmetic 은 float 미지원 → int 변환 (98.0 → 98)
        _sp=$(printf '%s' "$_u" | awk -F'\t' '{printf "%d", $1}')
        _wp=$(printf '%s' "$_u" | awk -F'\t' '{printf "%d", $2}')
        _ra=$(printf '%s' "$_u" | awk -F'\t' '{printf "%d", $3}')
        if [ "${_sp:-0}" -ge 95 ] 2>/dev/null; then _reject_reason="session_cap(${_sp}%)"; fi
        if [ -z "$_reject_reason" ] && [ "${_wp:-0}" -ge 100 ] 2>/dev/null; then _reject_reason="week_exhausted(${_wp}%)"; fi
        if [ -z "$_reject_reason" ] && [ "${_ra:-0}" -gt "${_now:-0}" ] 2>/dev/null; then _reject_reason="retry_at($_ra)"; fi
    fi
    if [ -n "$_reject_reason" ]; then
        info "upstream pin=$picked_name REJECT ($_reject_reason) → re-pick"
        unset CLAUDE_CONFIG_DIR
        picked_dir=""
        picked_name=""
        picked_line=$(node "$POOL_JS" pick 2>/dev/null)
        if [ -n "$picked_line" ]; then
            picked_name=$(printf '%s' "$picked_line" | awk -F'\t' '{print $1}')
            picked_dir=$(printf '%s' "$picked_line" | awk -F'\t' '{print $2}')
        fi
    fi
    unset _exh_until _now _reject_reason _u _sp _wp _ra
else
    # 완전히 비어있을 때만 자체 pick
    picked_line=$(node "$POOL_JS" pick 2>/dev/null)
    if [ -n "$picked_line" ]; then
        picked_name=$(printf '%s' "$picked_line" | awk -F'\t' '{print $1}')
        picked_dir=$(printf '%s' "$picked_line" | awk -F'\t' '{print $2}')
    fi
fi

if [ -n "$picked_dir" ]; then
    # apply CLAUDX_HOME_MAP 로 spawn 된 claude 가 local creds 읽게
    if [ -n "${CLAUDX_HOME_MAP:-}" ]; then
        from="${CLAUDX_HOME_MAP%%:*}"
        to="${CLAUDX_HOME_MAP##*:}"
        case "$picked_dir" in
            "$from"*) picked_dir="${to}${picked_dir#$from}" ;;
        esac
    fi
    export CLAUDE_CONFIG_DIR="$picked_dir"
    # status line (M13f): acct + cost_today + pool_active
    if [ "$CLAUDX_QUIET" != "1" ] && [ -x "$CX_ROOT/bin/claudx-idea" ]; then
        today_cost=$(jq -r --arg s "$(($(date +%s) - 86400))" '
            select((.ts | fromdateiso8601) >= ($s | tonumber)) | (.usd // 0)
          ' "$CLAUDX_STATE/cost.jsonl" 2>/dev/null | awk 'BEGIN{s=0}{s+=$1}END{printf "%.3f", s}')
        pool_ok=$(node "$POOL_JS" status 2>/dev/null | awk -F'\t' '$4=="ok"{c++} END{print c+0}')
        info "acct=$picked_name cfg=$picked_dir today=\$$today_cost pool_ok=$pool_ok"
    else
        info "acct=$picked_name cfg=$picked_dir"
    fi
else
    # (2026-04-21 v4) default ~/.claude 폴백 기본 차단. default 계정이 사용자 본인
    # 계정(~/.claude)이라 pool 비었을 때 무자각 소진 사고 재발. 이제는 ABORT 기본,
    # CLAUDX_ALLOW_EMPTY=1 로 명시적 opt-in 해야 폴백. (이전 v3 는 폴백 기본이었음.)
    if [ "$show_only" != true ] && [ "${CLAUDX_ALLOW_EMPTY:-0}" != "1" ]; then
        # earliest_available: usage-cache + exhausted 의 min(reset_at) + name
        _next=$(CLAUDX_POOL="$CLAUDX_POOL" CLAUDX_USAGE="$CLAUDX_USAGE" CLAUDX_STATE="$CLAUDX_STATE" \
            node -e '
            const fs=require("fs"),p=require("path");
            const r=(f,d)=>{try{return JSON.parse(fs.readFileSync(f,"utf8"))}catch{return d}};
            const acc=r(process.env.CLAUDX_POOL,{accounts:[]}).accounts||[];
            const u=r(process.env.CLAUDX_USAGE,{}); const e=r(p.join(process.env.CLAUDX_STATE,"exhausted.json"),{});
            const now=Math.floor(Date.now()/1000);
            let best=null;
            for(const a of acc){
              const uu=u[a.name]||{};const ee=e[a.name]||{};
              const cands=[];
              if(uu._retry_at&&uu._retry_at>now)cands.push(uu._retry_at);
              if(ee.until&&ee.until>now)cands.push(ee.until);
              if(uu.session_pct>=95&&uu.session_resets){const t=Math.floor(new Date(uu.session_resets).getTime()/1000);if(t>now)cands.push(t)}
              if(uu.week_all_pct>=100&&uu.week_resets){const t=Math.floor(new Date(uu.week_resets).getTime()/1000);if(t>now)cands.push(t)}
              if(cands.length===0)continue;
              const t=Math.min(...cands);
              if(!best||t<best.t)best={name:a.name,t};
            }
            if(!best)console.log("none\t0"); else console.log(best.name+"\t"+best.t);
            ' 2>/dev/null)
        _nname=$(printf '%s' "$_next" | awk -F'\t' '{print $1}')
        _ntime=$(printf '%s' "$_next" | awk -F'\t' '{print $2+0}')
        _delta=$((${_ntime:-0} - $(date +%s)))
        if [ "$_delta" -gt 0 ] 2>/dev/null; then
            _min=$((_delta / 60))
            _sec=$((_delta % 60))
            echo "claudx: ABORT — 모든 계정 한도/retry 상태" >&2
            echo "claudx: earliest=$_nname in ${_min}m${_sec}s (epoch=$_ntime)" >&2
        else
            echo "claudx: ABORT — pool empty (usage-cache/accounts.json 점검)" >&2
        fi
        echo "claudx: 우회: CLAUDX_ALLOW_EMPTY=1 cl ..." >&2
        exit 3
    fi
    info "no acct — using default ~/.claude (pool empty or unreachable)"
fi

# --- inject interceptor ---
# Linux (원격 ubu1 포함) 의 claude 는 node cli.js → NODE_OPTIONS 존중
# Mac 의 claude 는 Bun 컴파일 binary → BUN_OPTIONS 만 존중 (NODE_OPTIONS 무시)
# 양쪽 다 세팅해서 플랫폼 감지 없이 통일
if [ "$no_rotate" != true ] && [ -f "$INTERCEPTOR" ]; then
    if [ -n "${NODE_OPTIONS:-}" ]; then
        export NODE_OPTIONS="--require $INTERCEPTOR $NODE_OPTIONS"
    else
        export NODE_OPTIONS="--require $INTERCEPTOR"
    fi
    if [ -n "${BUN_OPTIONS:-}" ]; then
        export BUN_OPTIONS="--require $INTERCEPTOR $BUN_OPTIONS"
    else
        export BUN_OPTIONS="--require $INTERCEPTOR"
    fi
fi

# 2026-04-20: 기본값 뒤집기 — bypass 는 opt-in 전용 (CLAUDX_BYPASS=1).
# 이전 (M13f+): CLAUDX_SAFE != 1 이면 --dangerously-skip-permissions 자동 주입.
# 지금    : CLAUDX_BYPASS == 1 일 때만 주입. 기본은 프롬프트 정상 동작.
# 필요한 escape hatch 는 airgenome 서브커맨드 (e.g. airgenome fs-write) 로 통합.
# 이미 사용자가 같은 플래그를 줬다면 중복 방지.
if [ "${CLAUDX_BYPASS:-0}" = "1" ] && [ "$show_only" != true ]; then
    _has_dsp=0
    for a in ${fwd[@]+"${fwd[@]}"}; do
        case "$a" in --dangerously-skip-permissions|--allow-dangerously-skip-permissions) _has_dsp=1; break ;; esac
    done
    if [ $_has_dsp -eq 0 ]; then
        fwd=("--dangerously-skip-permissions" ${fwd[@]+"${fwd[@]}"})
    fi
fi

# M14 session_defaults 주입은 $AIRGENOME/bin/claude PATH shim 이 전담 (SSOT 단일화,
# 2026-04-19). claudx 는 host pick + rotate 만 책임. cx → command claude → shim 경로로
# 모든 진입점 (improve_loop/cl/engine_anima 등) 이 자동 포함됨.
# --- delegate to cx (host routing + ssh + env forward patched for claudx M13) ---
exec "$CX_ROOT/bin/cx" ${fwd[@]+"${fwd[@]}"}
