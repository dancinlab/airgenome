#!/usr/bin/env bash
# L0 CORE — 수정 금지 (nexus/shared/L0.json 등록). 변경 시 PR + L0 갱신.
# bin/cx — AI-native Claude CLI router (ubu1/ubu2 우선, mac fallback)
#
# v3 (2026-04-18, C안): tmux 완전 제거. ssh -t 직결.
#   - 세션 관리 레이어 폐기 → 세션 이름 충돌 / fork 이슈 원천 소멸
#   - 원격 ~/.airgenome/cx_remote_launch 미사용 (파일 남아있어도 무해)
#   - 트레이드오프: ssh 끊기면 원격 claude 가 SIGHUP. 집 LAN 전제로 수용.
#
# v4 (2026-04-19, score+slot):
#   - Score-based 호스트 선택: (threads-load)/threads*100 - slot_in_use*20 - p95_rtt_ms/100
#   - Per-host slot semaphore: mkdir atomic-mutex (macOS flock 부재 대응), PID liveness 로 stale 회수
#   - airgenome slots 서브커맨드 연동 (상태/청소/--watch)
#   - ENV override: CX_PICK_MODE=score|priority|priority_fallback (기본 score)
#
# v5 (2026-04-19 A+C, docker-ssh default):
#   - 컨테이너 내부 sshd (port 2222) 로 직결 → host sshd saturate 시에도 claude 접근 가능.
#   - hosts.json 의 docker_ssh_port 가 있는 호스트는 기본적으로 docker-ssh 시도, 실패시 host ssh 로 fallback.
#   - ~/.ssh/config 에 <alias>-d 블록이 있어야 함 (예: Host ubu-d, Port 2222, User root).
#   - opt-out: CX_NO_DOCKER_SSH=1 또는 --no-docker-ssh (모든 호스트에서 host ssh 만 사용).
#   - 일부 호스트만 배포된 경우: docker_ssh_port 없는 호스트는 자동으로 host ssh.
#
# 책임:
#   1. modules/claude_route.hexa select → best host
#   2. mac 이면 local `command claude`, remote 이면 `ssh -t <alias> <inner_cmd>`
#   3. SSH handshake RTT 측정 (remote only)
#   4. 세션 종료 후 genome 기록
#
# 사용:
#   cx                         # 기본 claude TUI (docker-ssh default on v5)
#   cx "~/Dev/foo"             # arg 전달 (forward)
#   cx --force-host mac        # 강제 라우팅
#   cx --show                  # 선택만, 실행 안 함
#   cx --no-docker-ssh         # 이번 호출만 host ssh 강제 (opt-out)
#   CX_NO_DOCKER_SSH=1 cx ...  # 셸 전체 opt-out
#   cx --resume-last           # 직전 세션 (host+cwd+args+env) 복원해 재실행
#   cx --resume <id>           # 특정 세션 ID 로 복원
#   cx --resume-last --show    # resume dry-run (복원만 확인)
#   cx --core [args...]        # L0 bypass — 지능레이어 skip, cx-core 로 직행 (local mac)
#                              #   cx 깨졌을 때 비상탈출. remote target 필요하면 cx-core 직접 호출.
#   cx --sessions [N]          # 최근 N (default 10) 세션 JSON lines
#   cx --session-show [id]     # 세션 상세 (id 생략 시 last)
#   cx --ignore-settings       # hooks/skills/CLAUDE.md/memory 전부 무시 — 깨끗한 세션
#                              #   (keychain/token rotation 은 유지. docker exec 모드 미지원)
#   CX_IGNORE_SETTINGS=1 cx ... # 셸 전체 ignore
#
# Why 별도 이름: Mac 의 `claude` 가 shell 함수 wrapper (터미널 제목 설정) 라 shadow 하면 충돌.

set -uo pipefail

CALLER_CWD="$(pwd)"
ROOT="$(cd "$(dirname "$0")/.." && pwd)"
cd "$ROOT"
MODULE="modules/claude_route.hexa"
REG="shared/config/hosts.json"
GENOME="$ROOT/forge/claude_genome.jsonl"
INFRA_STATE="$HOME/Dev/nexus/shared/infra_state.json"

# ─── cx session snapshot (host/cwd/args resume) ──────────────────────────────
# 목적: cx 종료 후 `cx --resume-last` / `cx --resume <id>` 로 직전 컨텍스트 복원.
#   - snapshot = host + alias + dssh_alias + cwd + fwd args + env whitelist + ts
#   - SSOT: ~/.airgenome/cx_sessions/<id>.json  (로컬 FS, sshfs 안전)
# 기존 `modules/session_snapshot_cmd.hexa` 는 일반 cmd-level snapshot 전용이라
# cx 전용 host/cwd 메타는 여기서 직접 관리 (R1 HEXA-FIRST 예외: cx 가 bash 래퍼).
CX_SESS_DIR="${CLAUDX_STATE:-$HOME/.airgenome}/cx_sessions"

_cx_sess_env_whitelist="CLAUDE_CONFIG_DIR CX_DOCKER CX_NO_DOCKER_SSH CX_DOCKER_SSH CX_PICK_MODE CX_DOCKER_WORKDIR CX_DOCKER_HOME CX_IGNORE_SETTINGS CLAUDX_STATE CLAUDX_POOL CLAUDX_USAGE CLAUDX_HOME_MAP CLAUDX_MAX_ROT CLAUDX_EXH_SEC"

# snapshot 저장: 인자 없이 호출, 현재 shell 의 변수에서 채움.
# `host` `alias` `dssh_alias` `CALLER_CWD` `fwd[]` 가 scope 에 있어야 함.
cx_sess_save() {
    mkdir -p "$CX_SESS_DIR" 2>/dev/null
    local id="$1" rc="$2" dur="$3" rtt="$4"
    local fp="$CX_SESS_DIR/$id.json"
    local tmp; tmp=$(mktemp "${fp}.XXXXXX") || return 1
    local ts; ts=$(date -u +%Y-%m-%dT%H:%M:%SZ)
    # fwd[] → JSON array
    local args_json
    if [ ${#fwd[@]} -gt 0 ]; then
        args_json=$(printf '%s\n' "${fwd[@]}" | jq -R . | jq -sc .)
    else
        args_json='[]'
    fi
    # env whitelist → object
    local env_json='{}' k v
    for k in $_cx_sess_env_whitelist; do
        eval "v=\${$k:-}"
        [ -n "$v" ] || continue
        env_json=$(printf '%s' "$env_json" | jq --arg k "$k" --arg v "$v" '. + {($k):$v}')
    done
    jq -n \
        --arg ts "$ts" \
        --arg id "$id" \
        --arg host "$host" \
        --arg alias "${alias:-}" \
        --arg dssh "${dssh_alias:-}" \
        --arg cwd "$CALLER_CWD" \
        --arg force_host "${force_host:-}" \
        --argjson rc "${rc:-0}" \
        --argjson dur "${dur:-0}" \
        --argjson rtt "${rtt:-0}" \
        --argjson args "$args_json" \
        --argjson env "$env_json" \
        '{ts:$ts,id:$id,host:$host,alias:$alias,dssh_alias:$dssh,cwd:$cwd,force_host:$force_host,exit:$rc,duration_s:$dur,rtt_ms:$rtt,args:$args,env:$env}' \
        > "$tmp" 2>/dev/null && mv "$tmp" "$fp" 2>/dev/null || rm -f "$tmp"
    # last pointer (symlink 대신 파일 — sshfs/탐색 안전)
    printf '%s' "$id" > "$CX_SESS_DIR/LAST" 2>/dev/null
}

# 최근 N (default 10) 세션 id 를 시간 내림차순으로 echo (jsonl 아님, 라인당 id).
cx_sess_list() {
    local limit=${1:-10}
    [ -d "$CX_SESS_DIR" ] || return 0
    # mtime 순 — ls -t; BSD/GNU 모두 호환.
    ls -t "$CX_SESS_DIR"/*.json 2>/dev/null | head -n "$limit" | while read -r fp; do
        [ -f "$fp" ] && basename "$fp" .json
    done
}

# last id — LAST pointer 먼저, 없으면 list 첫줄.
cx_sess_last_id() {
    if [ -r "$CX_SESS_DIR/LAST" ]; then
        cat "$CX_SESS_DIR/LAST" 2>/dev/null
        return 0
    fi
    cx_sess_list 1
}

# snapshot 로드 → 현재 shell 변수에 주입. resume 플래그 세팅 시 caller 가 호출.
# 반환: 0 = ok, 1 = 파일 없음.
cx_sess_load() {
    local id=$1 fp="$CX_SESS_DIR/$id.json" j k v
    [ -r "$fp" ] || return 1
    j=$(cat "$fp" 2>/dev/null) || return 1
    # host / cwd / args / env 복원 — force_host 는 resume 의도상 stored host 를 직접 지정.
    CALLER_CWD=$(printf '%s' "$j" | jq -r '.cwd // ""')
    [ -n "$CALLER_CWD" ] || CALLER_CWD=$(pwd)
    local stored_host; stored_host=$(printf '%s' "$j" | jq -r '.host // ""')
    # 기존 force_host 가 CLI 로 이미 주어져 있으면 우선.
    if [ -z "${force_host:-}" ] && [ -n "$stored_host" ]; then
        force_host="$stored_host"
    fi
    # args 복원 — 기존 fwd[] 가 empty 일 때만.
    if [ "${#fwd[@]}" -eq 0 ]; then
        local tmpf; tmpf=$(mktemp) || return 1
        printf '%s' "$j" | jq -r '.args[]? // empty' > "$tmpf"
        while IFS= read -r line; do
            fwd+=("$line")
        done < "$tmpf"
        rm -f "$tmpf"
    fi
    # env 복원 — whitelist 만, 기존 값이 있으면 유지.
    for k in $_cx_sess_env_whitelist; do
        eval "v=\${$k:-}"
        [ -z "$v" ] || continue
        v=$(printf '%s' "$j" | jq -r --arg k "$k" '.env[$k] // empty')
        [ -n "$v" ] && export "$k=$v"
    done
    echo "cx: resume session=$id host=$stored_host cwd=$CALLER_CWD args=$(printf '%s ' "${fwd[@]:-}")" >&2
    return 0
}

# sessions subcommand: 최근 N 세션 요약 (JSON lines: id ts host cwd exit dur).
cx_sess_show_list() {
    local limit=${1:-10} fp
    [ -d "$CX_SESS_DIR" ] || { echo "cx: no sessions ($CX_SESS_DIR)"; return 0; }
    cx_sess_list "$limit" | while read -r id; do
        fp="$CX_SESS_DIR/$id.json"
        [ -r "$fp" ] || continue
        jq -c '{id,ts,host,cwd,exit,duration_s,args}' "$fp" 2>/dev/null
    done
}

# snapshot 단건 show (dry-run 확인용).
cx_sess_show_one() {
    local id=${1:-} fp
    [ -n "$id" ] || id=$(cx_sess_last_id)
    [ -n "$id" ] || { echo "cx: no session found" >&2; return 1; }
    fp="$CX_SESS_DIR/$id.json"
    [ -r "$fp" ] || { echo "cx: session not found: $id" >&2; return 1; }
    jq . "$fp"
}

die() { echo "cx: $*" >&2; exit 2; }

# ms precision timer — Linux date %N 비호환 macOS → perl fallback
now_ms() {
    if command -v perl >/dev/null 2>&1; then
        perl -MTime::HiRes=time -e 'printf "%d\n", time()*1000'
    else
        echo $(( $(date +%s) * 1000 ))
    fi
}

jq_host() {
    local host=$1 expr=$2
    jq -r --arg h "$host" "$expr" "$REG" 2>/dev/null
}

ssh_target_user() {
    local alias=$1
    ssh -G "$alias" 2>/dev/null | awk '/^user /{print $2; exit}'
}

host_preload_enabled() {
    local host=$1 mode
    mode=$(jq_host "$host" '(.hosts[$h] // {}) | if has("claudx_preload") then .claudx_preload else true end')
    [ "$mode" = "true" ]
}

host_hot() {
    local host=$1
    [ -r "$INFRA_STATE" ] || return 1
    local line ts_s now_s age status load_s threads_s cap_s util
    line=$(jq -r --arg h "$host" '
        [(.ts // ""), (.hosts[$h].status // ""), (.hosts[$h].load // ""), (.hosts[$h].cpu_threads // ""), (.hosts[$h].ram_total_mb // "")]
        | @tsv
    ' "$INFRA_STATE" 2>/dev/null) || return 1
    IFS=$'\t' read -r ts_s status load_s threads_s _ <<< "$line"
    [ -n "$ts_s" ] || return 1
    now_s=$(date +%s)
    ts_s=$(jq -nr --arg ts "$ts_s" '$ts | fromdateiso8601' 2>/dev/null) || return 1
    age=$((now_s - ts_s))
    [ "$age" -le "${CLAUDX_INFRA_MAX_AGE_SEC:-180}" ] || return 1
    [ "$status" = "active" ] || return 1
    cap_s=$(jq_host "$host" '.hosts[$h].claude_limits.load_pct // empty')
    [ -n "$cap_s" ] || return 1
    [ -n "$load_s" ] || return 1
    [ -n "$threads_s" ] || threads_s=$(jq_host "$host" '.hosts[$h].threads // 0')
    [ "${threads_s:-0}" -gt 0 ] 2>/dev/null || return 1
    util=$(awk -v l="$load_s" -v t="$threads_s" 'BEGIN{ if (t<=0) print 0; else printf "%d", (l*100)/t }')
    [ "${util:-0}" -ge "${cap_s:-101}" ]
}

# ─── slot semaphore (macOS 용 mkdir 기반 atomic mutex) ───────────────────────
# Why mkdir: macOS 기본 bash 3.2 에 flock 미포함. `mkdir` 은 POSIX atomic —
#   성공 = exclusive, 실패 = 다른 cx 가 소유. 디렉토리 내 pid 파일로 stale detect.
# NFS 경고: $HOME/.airgenome 은 로컬 FS (Mac) 전제. sshfs mount 에는 쓰지 말 것.
CX_SLOT_DIR="${CLAUDX_STATE:-$HOME/.airgenome}/cx_slots"

# max_claude_concurrent 기본값 — hosts.json 미기입 시 kind 로 추정.
# 사용자 요구: 초기값을 넉넉히 (자원 놀림 방지). ubu1/ubu2=2, htz=4, mac=8.
slot_host_capacity() {
    local host=$1 n
    n=$(jq_host "$host" '.hosts[$h].max_claude_concurrent // empty' 2>/dev/null)
    if [ -n "$n" ] && [ "$n" != "null" ]; then
        echo "$n"; return
    fi
    local kind
    kind=$(jq_host "$host" '.hosts[$h].kind // empty' 2>/dev/null)
    case "$host" in
        mac)             echo 8; return ;;
        ubu1|ubu2)       echo 2; return ;;
        htz|hetzner)     echo 4; return ;;
    esac
    case "$kind" in
        self)   echo 8 ;;
        lan)    echo 2 ;;
        remote) echo 4 ;;
        *)      echo 2 ;;
    esac
}

# slot 파일 liveness — pid 기록 + 프로세스 살아있는지. 죽었으면 stale.
_slot_alive() {
    local dir=$1 pid
    [ -d "$dir" ] || return 1
    pid=$(cat "$dir/pid" 2>/dev/null)
    [ -n "$pid" ] || return 1
    kill -0 "$pid" 2>/dev/null
}

# 사용중 slot 개수 (stale 제외)
slot_used_count() {
    local host=$1 cap i used=0
    cap=$(slot_host_capacity "$host")
    i=1
    while [ "$i" -le "$cap" ]; do
        if _slot_alive "$CX_SLOT_DIR/${host}_${i}"; then
            used=$((used + 1))
        fi
        i=$((i + 1))
    done
    echo "$used"
}

# slot 획득 시도 — 성공시 디렉토리 경로 echo, 실패 시 empty + rc!=0.
# $$ 의 바깥 ssh process pid 를 저장해 stale detect 가능.
acquire_slot() {
    local host=$1 cap i dir
    cap=$(slot_host_capacity "$host")
    mkdir -p "$CX_SLOT_DIR" 2>/dev/null
    i=1
    while [ "$i" -le "$cap" ]; do
        dir="$CX_SLOT_DIR/${host}_${i}"
        # 선점돼 있지만 stale 이면 회수
        if [ -d "$dir" ] && ! _slot_alive "$dir"; then
            rm -rf "$dir" 2>/dev/null
        fi
        if mkdir "$dir" 2>/dev/null; then
            echo "$$" > "$dir/pid"
            echo "$host" > "$dir/host"
            date +%s > "$dir/ts"
            echo "$dir"
            return 0
        fi
        i=$((i + 1))
    done
    return 1
}

release_slot() {
    local dir=$1
    [ -n "$dir" ] && [ -d "$dir" ] && rm -rf "$dir" 2>/dev/null
    return 0
}

# Score: (threads-load)/threads*100 - slot_in_use*20 - p95_rtt_ms/100
#   - 아이들 capacity 비율 (높을수록 +)
#   - slot 하나당 -20 (reserved 가중치)
#   - rtt p95 ms 반영 (없으면 0)
# infra_state.json 이 stale (>180s) 이면 -1 리턴 → caller 가 score 모드 포기.
host_score() {
    local host=$1
    [ -r "$INFRA_STATE" ] || { echo "-1"; return; }
    local ts_s now_s age load_s threads_s
    ts_s=$(jq -r '.ts // ""' "$INFRA_STATE" 2>/dev/null)
    [ -n "$ts_s" ] || { echo "-1"; return; }
    ts_s=$(jq -nr --arg ts "$ts_s" '$ts | fromdateiso8601' 2>/dev/null) || { echo "-1"; return; }
    now_s=$(date +%s)
    age=$((now_s - ts_s))
    [ "$age" -le "${CLAUDX_INFRA_MAX_AGE_SEC:-180}" ] || { echo "-1"; return; }

    load_s=$(jq -r --arg h "$host" '.hosts[$h].load // empty' "$INFRA_STATE" 2>/dev/null)
    threads_s=$(jq -r --arg h "$host" '.hosts[$h].cpu_threads // empty' "$INFRA_STATE" 2>/dev/null)
    [ -n "$threads_s" ] || threads_s=$(jq_host "$host" '.hosts[$h].threads // 0')
    [ -n "$load_s" ] || load_s=0
    [ "${threads_s:-0}" -gt 0 ] 2>/dev/null || { echo "0"; return; }

    local slots_used rtt_p95
    slots_used=$(slot_used_count "$host")
    rtt_p95=$(jq_host "$host" '.hosts[$h].claude_limits.p95_rtt_ms // 0')
    [ -n "$rtt_p95" ] || rtt_p95=0

    awk -v l="$load_s" -v t="$threads_s" -v s="$slots_used" -v r="$rtt_p95" \
        'BEGIN{ idle=(t-l)/t*100; if (idle<0) idle=0;
                score = idle - s*20 - r/100;
                printf "%d", score }'
}

# infra_state 신선도 체크 — 0=fresh, 1=stale/missing
infra_state_fresh() {
    [ -r "$INFRA_STATE" ] || return 1
    local ts_s now_s age
    ts_s=$(jq -r '.ts // ""' "$INFRA_STATE" 2>/dev/null)
    [ -n "$ts_s" ] || return 1
    ts_s=$(jq -nr --arg ts "$ts_s" '$ts | fromdateiso8601' 2>/dev/null) || return 1
    now_s=$(date +%s)
    age=$((now_s - ts_s))
    [ "$age" -le "${CLAUDX_INFRA_MAX_AGE_SEC:-180}" ]
}

# ─── host blacklist (probe fail → N 분 skip) ─────────────────────────────────
# SSOT: $HOME/.airgenome/host_blacklist.json (Mac 로컬, sshfs 안전).
# Format: { "<host>": {"until": <epoch>, "reason": "<str>", "ts": "<iso>"}, ... }
# TTL: CX_BLACKLIST_TTL (sec, 기본 1800 = 30분). 0 이면 blacklist 비활성.
# CLI:
#   cx --blacklist-show        → 활성 엔트리 목록
#   cx --blacklist-clear [h]   → 특정/전체 엔트리 해제
# 정책: priority-first 원칙 유지 — 순위 변경 없이 blacklist 된 호스트만 skip.
CX_BL_FILE="${CLAUDX_STATE:-$HOME/.airgenome}/host_blacklist.json"
CX_BL_TTL="${CX_BLACKLIST_TTL:-1800}"

_bl_load_json() {
    if [ -r "$CX_BL_FILE" ]; then
        cat "$CX_BL_FILE"
    else
        echo '{}'
    fi
}

# blacklist 조회: 해당 host 가 현재 blacklisted 면 until(epoch) + reason 을 tab 으로 echo,
# 미기록/만료면 empty. 만료된 엔트리는 다음 기록 시 자동 prune 됨.
bl_check() {
    local host=$1 j now until reason
    [ "${CX_BL_TTL:-1800}" -gt 0 ] 2>/dev/null || return 1
    [ -r "$CX_BL_FILE" ] || return 1
    now=$(date +%s)
    j=$(_bl_load_json)
    until=$(printf '%s' "$j" | jq -r --arg h "$host" '.[$h].until // empty' 2>/dev/null)
    [ -n "$until" ] || return 1
    [ "$until" -gt "$now" ] 2>/dev/null || return 1
    reason=$(printf '%s' "$j" | jq -r --arg h "$host" '.[$h].reason // ""' 2>/dev/null)
    printf '%s\t%s\n' "$until" "$reason"
    return 0
}

# blacklist 기록: bl_mark <host> <reason>
#   - TTL=0 이면 기록 생략
#   - 기존 엔트리 merge (prune 포함)
bl_mark() {
    local host=$1 reason=$2 now until ttl j tmp
    ttl="${CX_BL_TTL:-1800}"
    [ "$ttl" -gt 0 ] 2>/dev/null || return 0
    now=$(date +%s)
    until=$((now + ttl))
    mkdir -p "$(dirname "$CX_BL_FILE")" 2>/dev/null
    j=$(_bl_load_json)
    tmp=$(mktemp "${CX_BL_FILE}.XXXXXX") || return 1
    printf '%s' "$j" | jq --arg h "$host" --arg r "$reason" \
        --argjson u "$until" --argjson n "$now" --arg ts "$(date -u +%Y-%m-%dT%H:%M:%SZ)" '
        # 1) prune expired   2) set/override host
        with_entries(select(.value.until > $n))
        | .[$h] = {until: $u, reason: $r, ts: $ts}
    ' > "$tmp" 2>/dev/null && mv "$tmp" "$CX_BL_FILE" 2>/dev/null || rm -f "$tmp"
}

# blacklist 해제: bl_clear [host]  (host 생략 시 전체)
bl_clear() {
    local host=${1:-} j tmp
    [ -r "$CX_BL_FILE" ] || { echo '{}' ; return 0 ; }
    if [ -z "$host" ]; then
        rm -f "$CX_BL_FILE" 2>/dev/null
        echo '{}'
        return 0
    fi
    j=$(_bl_load_json)
    tmp=$(mktemp "${CX_BL_FILE}.XXXXXX") || return 1
    printf '%s' "$j" | jq --arg h "$host" 'del(.[$h])' > "$tmp" 2>/dev/null \
        && mv "$tmp" "$CX_BL_FILE" 2>/dev/null || rm -f "$tmp"
    cat "$CX_BL_FILE" 2>/dev/null || echo '{}'
}

# blacklist 전체 표시 (사람 읽기용 + prune)
bl_show() {
    local now j
    now=$(date +%s)
    j=$(_bl_load_json)
    printf '%s' "$j" | jq --argjson n "$now" -r '
        with_entries(select(.value.until > $n))
        | to_entries | .[]
        | "\(.key)\tuntil=\(.value.until)\treason=\(.value.reason // "")\tts=\(.value.ts // "")"
    ' 2>/dev/null
}

# arg parsing — --force-host / --show / --docker 는 wrapper 전용, 나머지는 claude 로 forward
force_host=""
show_only=false
docker_mode=${CX_DOCKER:-0}
# docker-ssh: host sshd 우회용 직결 경로 (M14 P5, v5 기본 on).
#   컨테이너 내부 sshd (port 2222) 로 직접 접속 → docker exec / host sshd 레이어 생략 →
#   host sshd 포화 (A+C 배포 이후 핵심 시나리오) 에도 claude 접근 가능. opt-out:
#     - CX_NO_DOCKER_SSH=1   : 전체 호스트 docker-ssh 비활성
#     - --no-docker-ssh      : 이번 호출만 비활성
#   CX_DOCKER_SSH=1 / --docker-ssh 는 기존 호환 (강제 on).
#   hosts.json 의 docker_ssh_port 가 있는 호스트만 시도하며, 실패시 host ssh 로 자동 fallback.
if [ "${CX_NO_DOCKER_SSH:-0}" = "1" ]; then
    docker_ssh_mode=0
else
    docker_ssh_mode=${CX_DOCKER_SSH:-1}
fi
fwd=()
resume_id=""       # cx --resume <id>  또는 --resume-last
resume_requested=0
# --ignore-settings: hooks/skills/CLAUDE.md 무시. CX_IGNORE_SETTINGS=1 로도 on.
case "${CX_IGNORE_SETTINGS:-0}" in 1|true|yes|YES|TRUE) ignore_settings=1 ;; *) ignore_settings=0 ;; esac
while [ $# -gt 0 ]; do
    case "$1" in
        --core)
            # L0 bypass — 지능레이어 (pick/probe/slot/rotate) 전부 우회 → cx-core 로 직행 (local mac).
            # 비상탈출: cx 어딘가 깨졌을 때. remote target 이 필요하면 cx-core 를 직접 호출.
            shift
            _core_bin="$(dirname "$0")/cx-core"
            [ -x "$_core_bin" ] || { echo "cx: --core bypass failed — $_core_bin not found" >&2; exit 2; }
            exec "$_core_bin" local --cwd "${CALLER_CWD:-$PWD}" -- "$@"
            ;;
        --force-host)      force_host=$2; shift 2 ;;
        --show)            show_only=true; shift ;;
        --docker)          docker_mode=1; shift ;;
        --no-docker)       docker_mode=0; shift ;;
        --docker-ssh)      docker_ssh_mode=1; shift ;;
        --no-docker-ssh)   docker_ssh_mode=0; shift ;;
        --ignore-settings) ignore_settings=1; shift ;;
        --resume)          resume_id=$2; resume_requested=1; shift 2 ;;
        --resume-last)     resume_requested=1; shift ;;
        --sessions)
            # 최근 세션 목록 (JSON lines). 2번째 arg 가 숫자면 limit.
            _limit=10
            if [ $# -ge 2 ] && [ -n "$2" ] && [ "${2#[0-9]}" != "$2" ]; then
                _limit=$2; shift
            fi
            cx_sess_show_list "$_limit"
            unset _limit
            exit 0 ;;
        --session-show)
            # 특정 세션 상세 (없으면 last).
            _sid=""
            if [ $# -ge 2 ] && [ -n "$2" ] && [ "${2#--}" = "$2" ]; then
                _sid=$2; shift
            fi
            cx_sess_show_one "$_sid"
            unset _sid
            exit $? ;;
        --blacklist-show)
            bl_show
            exit 0 ;;
        --blacklist-clear)
            # 다음 arg 가 --* 로 시작하지 않으면 host 인자로 취급
            if [ $# -ge 2 ] && [ -n "$2" ] && [ "${2#--}" = "$2" ]; then
                bl_clear "$2" >/dev/null
                echo "cx: blacklist cleared for '$2'" >&2
                shift 2
            else
                bl_clear >/dev/null
                echo "cx: blacklist cleared (all)" >&2
                shift
            fi
            exit 0 ;;
        --)              shift; fwd+=("$@"); break ;;
        *)               fwd+=("$1"); shift ;;
    esac
done

# --force-host 입력 normalize — host_list resolve 로 ubu/U¹ 등 alias 를 canonical key 로.
# 실패 시 원값 유지 (사용자 직접 지정 가능성 존중). hosts.json SSOT 참조.
if [ -n "$force_host" ]; then
    _resolved=$("$ROOT/bin/host_list" resolve "$force_host" 2>/dev/null || true)
    if [ -n "$_resolved" ] && [ "$_resolved" != "$force_host" ]; then
        echo "cx: --force-host '$force_host' resolved → '$_resolved' (hosts.json)" >&2
        force_host="$_resolved"
    fi
    unset _resolved
fi

# ─── resume: snapshot 로드 (force_host/fwd/CALLER_CWD/env 복원) ───────────────
# --resume-last: LAST pointer 사용. --resume <id>: 명시.
# 복원 후 stored host 는 force_host 로 설정됨 → 이하 probe 단계가 해당 호스트 우선 시도.
# 단, 해당 호스트 probe 실패 시 `--show` 가 아니면 force_host 해제하고 score 재선정 fallback.
if [ "$resume_requested" = 1 ]; then
    if [ -z "$resume_id" ]; then
        resume_id=$(cx_sess_last_id)
    fi
    if [ -z "$resume_id" ]; then
        echo "cx: --resume-last: no prior session found ($CX_SESS_DIR)" >&2
        exit 2
    fi
    if ! cx_sess_load "$resume_id"; then
        echo "cx: resume failed — session not found: $resume_id" >&2
        exit 2
    fi
    # --show 모드에서는 복원만 확인하고 실행하지 않음 (dry-run).
    if [ "$show_only" = true ]; then
        echo "cx: [resume dry-run] id=$resume_id force_host=$force_host cwd=$CALLER_CWD"
        echo "cx: [resume dry-run] args=$(printf '%s ' "${fwd[@]:-}")"
        # 아래 probe/실행 단계로 계속 흘러가도록 두되 show_only 가 exit 시킴.
    fi
    # force_host probe 가 실패하면 re-pick 을 허용하기 위한 플래그.
    CX_RESUME_ALLOW_REPICK=1
fi

# host 후보 기본 순서:
#   1. JSON 순서 우선 (현재 사용자 지시: ubu1 우선)
#   2. probe 성공 첫 호스트 선택
# 기본 정책: 원격 후보가 전부 없으면 mac fallback 허용.
# 명시적으로 막고 싶으면 CLAUDX_ALLOW_MAC_FALLBACK=0.
if [ -n "$force_host" ] && [ "${CX_RESUME_ALLOW_REPICK:-0}" != "1" ]; then
    candidates=("$force_host")
elif [ -n "$force_host" ] && [ "${CX_RESUME_ALLOW_REPICK:-0}" = "1" ]; then
    # resume: stored host 를 맨 앞에 두고, probe 실패 시 다른 enabled 호스트로 fallback.
    # priority-first 원칙 유지 — stored host 가 1순위, 나머지는 JSON 순.
    candidates=("$force_host")
    while IFS= read -r h; do
        [ -n "$h" ] || continue
        [ "$h" = "$force_host" ] && continue
        candidates+=("$h")
    done < <(jq -r '.hosts | to_entries | map(select(.value.enabled==true and .value.kind!="self" and (.value.claudx_enabled != false))) | .[].key' "$REG" 2>/dev/null)
    if [ "${CLAUDX_ALLOW_MAC_FALLBACK:-1}" = "1" ]; then
        case " ${candidates[*]} " in *" mac "*) : ;; *) candidates+=("mac") ;; esac
    fi
    # force_host 는 이제 hint — blacklist/gate 필터는 돌지만 다른 호스트도 probe 대상.
    # probe 단계에서 force_host 가 ok 면 그대로 선택, 실패면 score fallback.
    echo "cx: resume hint — prefer=$force_host, fallback pool=${candidates[*]}" >&2
    force_host=""  # CLI 관점의 strict force 는 해제 (resume 은 soft hint).
else
    # enabled remote 를 JSON 순서대로 추출
    remote_cands=()
    # claudx_enabled=false 인 호스트는 auto-pick 에서 제외 (dispatch/worker 는 계속 사용).
    # --force-host 는 위 분기에서 우회되므로 사용자 명시 의도는 유지됨.
    while IFS= read -r h; do [ -n "$h" ] && remote_cands+=("$h"); done < <(jq -r '.hosts | to_entries | map(select(.value.enabled==true and .value.kind!="self" and (.value.claudx_enabled != false))) | .[].key' "$REG" 2>/dev/null)
    candidates=(${remote_cands[@]+"${remote_cands[@]}"})
    if [ "${CLAUDX_ALLOW_MAC_FALLBACK:-1}" = "1" ]; then
        candidates+=("mac")
    fi
    unset remote_cands
fi

# NODE_OPTIONS 에서 preload 경로 추출 (2026-04-19 htz preload 실패 대응):
#   --require /path/to/interceptor.js → 원격에도 이 파일이 있어야 claudx 가 뜬다.
#   sshfs 있는 host (ubu1/ubu2) 는 /Users/ghost 심볼릭으로 해결. htz 는 mount 없어 실패.
#   probe 단계에서 파일 존재까지 확인 → 없으면 다음 후보로.
cx_preload_path=""
if [ -n "${NODE_OPTIONS:-}" ]; then
    cx_preload_path=$(printf '%s' "$NODE_OPTIONS" | grep -oE -- '--require[= ][^ ]+' | head -1 | sed -E 's/^--require[= ]//')
fi

# parallel probe — 모든 remote 후보에 동시 발사, priority 순서로 첫 성공 선택.
# -o ControlPath=none 으로 stale mux bypass. `timeout` 래핑으로 banner-hang 도 강제 컷.
# Why 병렬: ubu1 sshd 가 과부하로 banner timeout 이면 sequential 은 ConnectTimeout(3s) 단위로 쌓이고
#        BannerTimeout 기본 120s 까지 대기 가능. 병렬+timeout 래핑 시 worst-case = max ConnectTimeout.
host=""
alias=""
# dssh_alias: docker-ssh 로 연결할 target (port 2222 컨테이너 sshd).
#   - 설정됨 → 최종 ssh 접속은 이 alias 로 (host sshd 우회, docker exec 레이어 없음)
#   - 비어 있음 → 기존 host ssh 경로 (필요시 docker exec wrap)
dssh_alias=""
rtt=0

# 분리: 원격 후보 + mac fallback 여부
remote_to_probe=()
has_mac_fallback=0
for cand in "${candidates[@]}"; do
    if [ "$cand" = "mac" ]; then
        has_mac_fallback=1
    else
        # blacklist 필터 (probe fail 로 최근 N분내 기록된 호스트 skip).
        # --force-host 는 우회 (사용자 명시 의도 존중). priority-first 원칙 유지 —
        # 순위 변경 없이 blacklist 된 호스트만 skip.
        if [ -z "$force_host" ]; then
            _bl=$(bl_check "$cand" 2>/dev/null)
            if [ -n "$_bl" ]; then
                _bl_until=$(printf '%s' "$_bl" | awk -F'\t' '{print $1}')
                _bl_reason=$(printf '%s' "$_bl" | awk -F'\t' '{print $2}')
                _bl_rem=$(( _bl_until - $(date +%s) ))
                _bl_min=$(( _bl_rem / 60 ))
                echo "cx: $cand blacklisted ${_bl_min}m (last fail: ${_bl_reason:-unknown}) — skip" >&2
                unset _bl _bl_until _bl_reason _bl_rem _bl_min
                continue
            fi
            unset _bl
        fi
        # gate hot 필터 (infra_state 기반)
        if [ -z "$force_host" ] && host_hot "$cand"; then
            _util=$(jq -r --arg h "$cand" '
                ((.hosts[$h].load // "0") | tonumber) * 100 / ((.hosts[$h].cpu_threads // 0) | tonumber)
                | floor
            ' "$INFRA_STATE" 2>/dev/null)
            _cap=$(jq_host "$cand" '.hosts[$h].claude_limits.load_pct // empty')
            echo "cx: gate hot → $cand (${_util:-?}% >= ${_cap:-?}%, next)" >&2
            unset _util _cap
            continue
        fi
        remote_to_probe+=("$cand")
    fi
done

if [ ${#remote_to_probe[@]} -gt 0 ]; then
    probe_dir=$(mktemp -d -t cx-probe.XXXXXX) || die "mktemp failed"
    probe_pids=()
    trap 'for p in "${probe_pids[@]}"; do kill "$p" 2>/dev/null; done; rm -rf "$probe_dir" 2>/dev/null' EXIT
    r0=$(now_ms)
    max_t=0
    # 병렬 발사 — 각 cand 별 background ssh + timeout 래핑.
    # v5 2단계 probe:
    #   1) docker-ssh port (host sshd 바이패스) — <host>-d alias 또는 -p<port>
    #   2) 실패 시 host ssh 로 fallback (기존 경로)
    # 결과 기록:
    #   $probe_dir/<cand>.ok       → 선택된 ssh target alias (host ssh)
    #   $probe_dir/<cand>.ok.dssh  → docker-ssh 성공 시 해당 alias (연결 단계에서 사용)
    # .ok 가 존재해야 선정 후보로 간주. .dssh 는 host 선정 후 경로 결정에 쓰임.
    for cand in "${remote_to_probe[@]}"; do
        cand_alias=$(jq -r --arg h "$cand" '.hosts[$h].ssh_alias // ""' "$REG")
        [ -n "$cand_alias" ] || { echo no_alias > "$probe_dir/$cand.fail"; continue; }
        _connect_t=$(jq_host "$cand" '.hosts[$h].probe_connect_timeout // 3')
        [ "${_connect_t:-3}" -gt "$max_t" ] 2>/dev/null && max_t=$_connect_t
        if [ -n "$cx_preload_path" ] && host_preload_enabled "$cand"; then
            _probe_cmd="test -f $(printf '%q' "$cx_preload_path")"
        else
            _probe_cmd="true"
        fi
        _cand_docker_port=$(jq_host "$cand" '.hosts[$h].docker_ssh_port // empty')
        # docker-ssh alias 후보:
        #   1) hosts.json 의 docker_ssh_alias (명시적 override)
        #   2) {ssh_alias}-d (기본 규칙, 예: ssh_alias=ubu → ubu-d)
        # 둘 다 없으면 <ssh_alias>-d 로 시도 → ssh -G 로 resolve 실패하면 skip.
        _cand_dssh_alias=$(jq_host "$cand" '.hosts[$h].docker_ssh_alias // empty')
        [ -n "$_cand_dssh_alias" ] || _cand_dssh_alias="${cand_alias}-d"
        _try_dssh=0
        if [ "$docker_ssh_mode" = 1 ] && [ -n "$_cand_docker_port" ] && [ "$_cand_docker_port" != "null" ]; then
            _try_dssh=1
        fi
        (
            # timeout: ConnectTimeout 은 TCP handshake 만 커버. banner-hang 차단용으로
            # 외부 timeout 래퍼 필수. macOS 는 gtimeout 이 있을 수도, 없으면 `timeout`(coreutils).
            _to=timeout
            command -v timeout >/dev/null 2>&1 || _to=gtimeout
            _ok=0
            if [ "$_try_dssh" = 1 ]; then
                # <alias>-d 가 ssh config 에 있고 port > 1 이면 docker-ssh 시도.
                # 없으면 조용히 host ssh fallback (A+C 미배포 호스트 보호).
                # bash 3.2 set -u 호환: 빈 배열 참조 회피 위해 두 케이스 분기 명령 분리.
                _dssh_port=$(ssh -G "$_cand_dssh_alias" 2>/dev/null | awk '/^port /{print $2; exit}')
                _dssh_ok=0
                if [ -n "$_dssh_port" ] && [ "$_dssh_port" -gt 1 ] 2>/dev/null; then
                    # <alias>-d 로 바로 접속
                    if "$_to" "$_connect_t" ssh -o ControlPath=none -o ControlMaster=no \
                        -o ConnectTimeout="$_connect_t" -o BatchMode=yes \
                        "$_cand_dssh_alias" "$_probe_cmd" 2>/dev/null; then
                        printf '%s' "$_cand_dssh_alias" > "$probe_dir/$cand.ok.dssh"
                        _dssh_ok=1
                    fi
                else
                    # <alias>-d 없으면 cand_alias + -p <port> -l root 로 override 시도
                    if "$_to" "$_connect_t" ssh -o ControlPath=none -o ControlMaster=no \
                        -o ConnectTimeout="$_connect_t" -o BatchMode=yes \
                        -p "$_cand_docker_port" -l root -o StrictHostKeyChecking=accept-new \
                        "$cand_alias" "$_probe_cmd" 2>/dev/null; then
                        # 이 경우 연결 단계에서도 같은 override 를 해야 함 — 지원 포기.
                        # 사용자에게 <alias>-d 블록 추가 권장 (A+C 배포가 기본 전제).
                        : # skip — host ssh fallback 로 흐름
                    fi
                fi
                if [ "$_dssh_ok" = 1 ]; then
                    printf '%s' "$cand_alias" > "$probe_dir/$cand.ok"
                    _ok=1
                fi
            fi
            if [ "$_ok" != 1 ]; then
                # host ssh fallback (또는 docker-ssh off 모드)
                if "$_to" "$_connect_t" ssh -o ControlPath=none -o ControlMaster=no \
                    -o ConnectTimeout="$_connect_t" -o BatchMode=yes \
                    "$cand_alias" "$_probe_cmd" 2>/dev/null; then
                    printf '%s' "$cand_alias" > "$probe_dir/$cand.ok"
                    _ok=1
                fi
            fi
            # fail reason: docker-ssh 시도 여부에 따라 분류 (blacklist 기록용).
            #   dssh+host 모두 실패 → "ssh_probe_fail" (host sshd 포화 or alias 오류)
            #   docker-ssh 만 시도 (host ssh 건너뜀) → "ssh_probe_fail"
            # 세밀한 banner/connect 구분은 ssh stderr 캡쳐 필요 — 현재는 요약 reason 으로 충분.
            [ "$_ok" = 1 ] || echo "ssh_probe_fail" > "$probe_dir/$cand.fail"
        ) >/dev/null 2>&1 &
        probe_pids+=($!)
        disown "$!" 2>/dev/null || true
    done
    unset _connect_t _probe_cmd cand_alias _cand_docker_port _cand_dssh_alias _try_dssh

    # CX_PICK_MODE: score (기본) | priority | priority_fallback
    #   score           → 모든 probe 결과를 기다린 뒤 score 최고. infra_state stale 이면 priority 로 폴백.
    #   priority        → 기존 2026-04-19 parallel + first-responder-wins (priority 는 tiebreak).
    #   priority_fallback → priority 우선이지만 infra_state stale 조건에서만 priority, fresh 면 score.
    _cx_pick_mode="${CX_PICK_MODE:-score}"
    if [ "$_cx_pick_mode" = "priority_fallback" ]; then
        if infra_state_fresh; then
            _cx_pick_mode=score
        else
            _cx_pick_mode=priority
        fi
    fi
    if [ "$_cx_pick_mode" = "score" ] && ! infra_state_fresh; then
        echo "cx: infra_state stale → pick_mode=priority fallback" >&2
        _cx_pick_mode=priority
    fi

    deadline=$(( $(date +%s) + max_t + 1 ))
    if [ "$_cx_pick_mode" = "score" ]; then
        # score 모드: 모든 probe done 또는 deadline 까지 기다린 뒤 ok 후보 중 score 최고 채택.
        #   - 아직 probing 중인 후보가 있으면 계속 대기
        #   - 모두 done (ok or fail) 되면 즉시 스코어링
        while [ "$(date +%s)" -lt "$deadline" ]; do
            all_done=1
            for cand in "${remote_to_probe[@]}"; do
                [ -f "$probe_dir/$cand.ok" ] || [ -f "$probe_dir/$cand.fail" ] || all_done=0
            done
            [ "$all_done" = 1 ] && break
            sleep 0.05
        done
        best_score=-999999
        best_cand=""
        best_alias=""
        _pick_scores=""
        for cand in "${remote_to_probe[@]}"; do
            if [ -f "$probe_dir/$cand.ok" ]; then
                _sc=$(host_score "$cand")
                _pick_scores="$_pick_scores $cand=$_sc"
                # "-1" = score N/A → 후순위 (큰 음수 로 취급 불필요, 그냥 스킵)
                if [ "$_sc" = "-1" ]; then continue; fi
                if [ -z "$best_cand" ] || [ "$_sc" -gt "$best_score" ] 2>/dev/null; then
                    best_score=$_sc
                    best_cand=$cand
                    best_alias=$(cat "$probe_dir/$cand.ok")
                fi
            fi
        done
        # 모든 candidate 가 score=-1 이면 첫 .ok 에 priority fallback
        if [ -z "$best_cand" ]; then
            for cand in "${remote_to_probe[@]}"; do
                if [ -f "$probe_dir/$cand.ok" ]; then
                    best_cand=$cand
                    best_alias=$(cat "$probe_dir/$cand.ok")
                    break
                fi
            done
        fi
        if [ -n "$best_cand" ]; then
            host=$best_cand
            alias=$best_alias
            if [ -f "$probe_dir/$best_cand.ok.dssh" ]; then
                dssh_alias=$(cat "$probe_dir/$best_cand.ok.dssh")
            fi
            [ -n "${CX_DEBUG:-}" ] && echo "cx: score picks →$_pick_scores → picked=$host score=$best_score${dssh_alias:+ dssh=$dssh_alias}" >&2
        fi
        unset best_score best_cand best_alias _sc _pick_scores
    else
        # priority 모드 (기존): first-responder-wins + priority tiebreak.
        while [ "$(date +%s)" -lt "$deadline" ]; do
            pick=""
            all_done=1
            for cand in "${remote_to_probe[@]}"; do
                if [ -f "$probe_dir/$cand.ok" ]; then
                    pick=$cand
                    break
                fi
                [ -f "$probe_dir/$cand.fail" ] || all_done=0
            done
            if [ -n "$pick" ]; then
                host=$pick
                alias=$(cat "$probe_dir/$pick.ok")
                if [ -f "$probe_dir/$pick.ok.dssh" ]; then
                    dssh_alias=$(cat "$probe_dir/$pick.ok.dssh")
                fi
                break
            fi
            [ "$all_done" = 1 ] && break
            sleep 0.05
        done
    fi

    # 실패 후보 로그 + AG7 blacklist 기록.
    # Priority 모드: first-responder-wins → 뒤쪽 후보는 probe 중단 가능성. host 이전까지만 기록.
    # Score 모드:   모든 후보 probe 완료까지 대기 → 모든 fail 기록 안전.
    # --force-host 는 skip. fail reason 은 파일 내용(no_alias/fail) 또는 "probe_timeout".
    for cand in "${remote_to_probe[@]}"; do
        if [ "$_cx_pick_mode" = "priority" ]; then
            [ "$cand" = "$host" ] && break
        fi
        if [ -f "$probe_dir/$cand.fail" ]; then
            echo "cx: probe fail → $cand (next)" >&2
            if [ -z "$force_host" ]; then
                _fail_reason=$(cat "$probe_dir/$cand.fail" 2>/dev/null)
                [ -n "$_fail_reason" ] || _fail_reason="probe_timeout"
                bl_mark "$cand" "$_fail_reason" 2>/dev/null || true
                unset _fail_reason
            fi
        fi
    done

    [ -n "$host" ] && rtt=$(( $(now_ms) - r0 ))

    # probe 성공 호스트 캡쳐 (probe_dir 삭제 전) — slot 획득 단계가 사용.
    # probe_ok_dssh: 동일 index 에 docker-ssh target (없으면 빈 문자열).
    probe_ok_hosts=()
    probe_ok_aliases=()
    probe_ok_dssh=()
    for cand in "${remote_to_probe[@]}"; do
        if [ -f "$probe_dir/$cand.ok" ]; then
            probe_ok_hosts+=("$cand")
            probe_ok_aliases+=("$(cat "$probe_dir/$cand.ok")")
            if [ -f "$probe_dir/$cand.ok.dssh" ]; then
                probe_ok_dssh+=("$(cat "$probe_dir/$cand.ok.dssh")")
            else
                probe_ok_dssh+=("")
            fi
        fi
    done

    # 잔여 프로브 즉시 kill (wait 하지 않음 — 선택 완료 직후 cx 진행)
    for _p in "${probe_pids[@]}"; do kill "$_p" 2>/dev/null; done
    rm -rf "$probe_dir" 2>/dev/null
    trap - EXIT
    unset _p
fi

if [ -z "$host" ] && [ "$has_mac_fallback" = 1 ]; then
    host=mac
fi

[ -n "$host" ] || die "no host reachable"

# ─── slot 획득 (per-host semaphore) ─────────────────────────────────────────
# CX_SLOT_DISABLE=1 로 전체 비활성화 (기존 동작 원할 때).
# 실패 시: 후보 풀에서 다른 best host 로 재시도 → 전부 full 이면 30s wait → 마지막에 abort or graceful.
slot_dir=""
if [ "${CX_SLOT_DISABLE:-0}" != "1" ] && [ "$show_only" != "true" ]; then
    # 사용 가능한 후보 풀: 이미 probe 성공한 원격 + mac fallback + force_host.
    slot_pool=()
    if [ -n "$force_host" ]; then
        slot_pool=("$force_host")
    else
        for cand in ${probe_ok_hosts[@]+"${probe_ok_hosts[@]}"}; do
            slot_pool+=("$cand")
        done
        # 선택된 host 는 무조건 포함 (원격 probe fail 후 mac fallback 된 경우 대비)
        # bash 3.2 + set -u 에서 빈 array + [*]/[@] 는 unbound → [*]- / [@]+ 로 우회.
        case " ${slot_pool[*]-} " in *" $host "*) : ;; *) slot_pool=("$host" ${slot_pool[@]+"${slot_pool[@]}"}) ;; esac
        [ "$has_mac_fallback" = 1 ] && case " ${slot_pool[*]-} " in *" mac "*) : ;; *) slot_pool+=("mac") ;; esac
    fi

    _slot_deadline=$(( $(date +%s) + ${CX_SLOT_WAIT_SEC:-30} ))
    _slot_first_pick=$host
    while :; do
        # 1. 현재 best host 시도
        slot_dir=$(acquire_slot "$host" 2>/dev/null || true)
        if [ -n "$slot_dir" ]; then
            break
        fi
        # 2. 다른 후보 중 slot 있는 호스트 탐색 (score 순 정렬)
        _alt_host=""
        _alt_alias=""
        _alt_best=-999999
        for cand in ${slot_pool[@]+"${slot_pool[@]}"}; do
            [ "$cand" = "$host" ] && continue
            _used=$(slot_used_count "$cand")
            _cap=$(slot_host_capacity "$cand")
            [ "$_used" -lt "$_cap" ] 2>/dev/null || continue
            if [ "$cand" = "mac" ]; then
                _sc=0  # mac 은 AG6 로 회피 대상 — 제일 마지막
            else
                _sc=$(host_score "$cand")
                [ "$_sc" = "-1" ] && _sc=0
            fi
            if [ -z "$_alt_host" ] || [ "$_sc" -gt "$_alt_best" ] 2>/dev/null; then
                _alt_best=$_sc
                _alt_host=$cand
                # alias 재조회 (probe 결과가 있으면 사용)
                if [ "$cand" = "mac" ]; then
                    _alt_alias=""
                else
                    _alt_alias=$(jq -r --arg h "$cand" '.hosts[$h].ssh_alias // ""' "$REG")
                fi
            fi
        done
        if [ -n "$_alt_host" ]; then
            slot_dir=$(acquire_slot "$_alt_host" 2>/dev/null || true)
            if [ -n "$slot_dir" ]; then
                host=$_alt_host
                alias=$_alt_alias
                # docker-ssh target 재조회 (probe_ok_dssh 병렬 배열)
                dssh_alias=""
                _i=0
                for _ph in ${probe_ok_hosts[@]+"${probe_ok_hosts[@]}"}; do
                    if [ "$_ph" = "$_alt_host" ]; then
                        dssh_alias="${probe_ok_dssh[$_i]:-}"
                        break
                    fi
                    _i=$((_i + 1))
                done
                unset _i _ph
                break
            fi
        fi
        # 3. 전부 full — deadline 까지 대기
        _now=$(date +%s)
        [ "$_now" -ge "$_slot_deadline" ] && break
        sleep 1
    done
    unset _alt_host _alt_alias _alt_best _used _cap _sc _now

    if [ -z "$slot_dir" ]; then
        if [ "${CX_SLOT_STRICT:-0}" = "1" ]; then
            die "all slots exhausted (pool: ${slot_pool[*]:-none}) after ${CX_SLOT_WAIT_SEC:-30}s"
        fi
        echo "cx: WARN all slots exhausted (pool: ${slot_pool[*]:-none}) → proceeding without slot reservation on $host" >&2
    fi

    # slot_dir 이 설정되면 cx exit 시 자동 해제.
    if [ -n "$slot_dir" ]; then
        trap 'release_slot "$slot_dir"' EXIT HUP INT TERM
    fi
fi
unset slot_pool _slot_deadline _slot_first_pick

if [ "$show_only" = true ]; then
    slot_info=""
    if [ -n "${slot_dir:-}" ]; then
        slot_info=" slot=$slot_dir"
    fi
    # score/pick debug 정보 포함
    _pscore=""
    if [ "$host" != "mac" ]; then
        _s=$(host_score "$host" 2>/dev/null)
        [ -n "$_s" ] && _pscore=" score=$_s"
    fi
    echo "cx → $host${alias:+ ($alias)}${dssh_alias:+ dssh=$dssh_alias}${_pscore}${slot_info}"
    exit 0
fi

echo "cx → $host${alias:+ ($alias)}${dssh_alias:+ dssh=$dssh_alias}${slot_dir:+ slot=$(basename "$slot_dir")}" >&2

# CLAUDE_CONFIG_DIR 매핑: cl 이 Mac 절대경로(/Users/ghost/.claude-claudeN)로 export 하므로
# 원격에는 basename 만 뽑아서 $HOME/<basename> 형태로 전달 (호스트별 HOME 상이: /home/aiden vs /home/summer).
remote_env_prefix=""
if [ "$host" != "mac" ] && [ -n "${CLAUDE_CONFIG_DIR:-}" ]; then
    base=$(basename "$CLAUDE_CONFIG_DIR")
    remote_env_prefix='CLAUDE_CONFIG_DIR="$HOME/'"$base"'" '
fi

# BROWSER inject — 원격 /login 의 OAuth URL 을 Mac 브라우저로 역송출.
if [ "$host" != "mac" ]; then
    remote_env_prefix='BROWSER="$HOME/bin/open-on-mac" '"$remote_env_prefix"
fi

# claudx integration (M13): forward NODE_OPTIONS + CLAUDX_* so the in-process
# rate-limit interceptor loads on the remote claude. sshfs /Users/ghost symlink
# lets Mac-absolute paths in NODE_OPTIONS resolve unchanged on the remote.
if [ "$host" != "mac" ] && host_preload_enabled "$host"; then
    if [ -n "${NODE_OPTIONS:-}" ]; then
        remote_env_prefix="NODE_OPTIONS=$(printf '%q' "$NODE_OPTIONS") $remote_env_prefix"
    fi
    if [ -n "${BUN_OPTIONS:-}" ]; then
        remote_env_prefix="BUN_OPTIONS=$(printf '%q' "$BUN_OPTIONS") $remote_env_prefix"
    fi
    for __cxv in CLAUDX_STATE CLAUDX_POOL CLAUDX_USAGE CLAUDX_HOME_MAP CLAUDX_MAX_ROT CLAUDX_EXH_SEC CLAUDX_DEBUG CLAUDX_SCRUB; do
        eval "__cxval=\${$__cxv:-}"
        if [ -n "$__cxval" ]; then
            remote_env_prefix="$__cxv=$(printf '%q' "$__cxval") $remote_env_prefix"
        fi
    done
    unset __cxv __cxval
    # (2026-04-19) interceptor rotation 경로 복구:
    # 원격 pool.js 가 accounts.json + .credentials.json 을 resolve 할 수 있도록
    # CLAUDX_POOL / CLAUDX_USAGE / CLAUDX_HOME_MAP 을 hosts.json 에 따라 자동주입.
    # 이미 env 에 세팅돼 있으면 위 루프가 먼저 기록했으므로 덮지 않음.
    case "$remote_env_prefix" in
        *CLAUDX_POOL=*) : ;;
        *) remote_env_prefix="CLAUDX_POOL=/Users/ghost/Dev/nexus/shared/.runtime/accounts/accounts.json $remote_env_prefix" ;;
    esac
    case "$remote_env_prefix" in
        *CLAUDX_USAGE=*) : ;;
        *) remote_env_prefix="CLAUDX_USAGE=/Users/ghost/Dev/nexus/shared/.runtime/accounts/usage-cache.json $remote_env_prefix" ;;
    esac
    case "$remote_env_prefix" in
        *CLAUDX_HOME_MAP=*) : ;;
        *)
            _host_home=$(jq_host "$host" '.hosts[$h].home // empty')
            if [ -n "$_host_home" ]; then
                remote_env_prefix="CLAUDX_HOME_MAP=$(printf '%q' "/Users/ghost:$_host_home") $remote_env_prefix"
            fi
            unset _host_home
            ;;
    esac
fi

# systemd-run/cgroup 격리는 2026-04-19 폐기: airgenome-claude.slice cgroup
# "Structure needs cleaning" (EUCLEAN) 손상으로 scope 생성 100% 실패 → claude 미실행.
# 결과적으로 리소스 한도는 호스트 수준/ulimit/cpulimit 등 후속 수단에 위임.
remote_scope_cmd=""

# cwd 매핑: 원격 /Users/ghost → $HOME/mac_home symlink 로 Mac 절대경로 그대로 resolve.
# fallback: Mac HOME 밖이면 상대 경로 추출 시도 후 최후 $HOME.
# docker-ssh 모드 (dssh_alias 설정): 컨테이너 compose mount 가 /mac_home — 경로 매핑 분기.
remote_cwd_prefix=""
if [ "$host" != "mac" ]; then
    caller_quoted=$(printf '%q' "$CALLER_CWD")
    if [ -n "$dssh_alias" ]; then
        if [ -n "${CX_DOCKER_WORKDIR:-}" ]; then
            remote_cwd_prefix='cd '"$(printf '%q' "$CX_DOCKER_WORKDIR")"' 2>/dev/null || cd /root; '
        else
            case "$CALLER_CWD" in
                /Users/ghost/*)
                    rel="${CALLER_CWD#/Users/ghost/}"
                    rel_quoted=$(printf '%q' "$rel")
                    remote_cwd_prefix='cd /mac_home/'"$rel_quoted"' 2>/dev/null || cd /workspace/'"$rel_quoted"' 2>/dev/null || cd /root; '
                    ;;
                *)
                    remote_cwd_prefix='cd '"$caller_quoted"' 2>/dev/null || cd /root; '
                    ;;
            esac
        fi
    else
        case "$CALLER_CWD" in
            /Users/ghost/*)
                rel="${CALLER_CWD#/Users/ghost/}"
                rel_quoted=$(printf '%q' "$rel")
                remote_cwd_prefix='cd '"$caller_quoted"' 2>/dev/null || cd "$HOME"/'"$rel_quoted"' 2>/dev/null || cd "$HOME"; '
                ;;
            *)
                remote_cwd_prefix='cd '"$caller_quoted"' 2>/dev/null || cd "$HOME"; '
                ;;
        esac
    fi
fi

if [ "$host" != "mac" ]; then
    # docker-ssh 는 항상 root. host ssh 면 alias 의 ssh user 기준.
    if [ -n "$dssh_alias" ]; then
        remote_user=root
    else
        remote_user=$(ssh_target_user "$alias")
    fi
    if [ "$remote_user" = "root" ]; then
        # (1) claudx-injected --dangerously-skip-permissions 제거 — root 에서 거부됨
        # (2) 프로젝트 settings.json 의 defaultMode: bypassPermissions 도 동일하게 거부되므로
        #     --permission-mode default 를 명시 주입하여 override. 이미 --permission-mode
        #     가 있으면 존중.
        _safe_fwd=()
        _has_pm=0
        for _arg in ${fwd[@]+"${fwd[@]}"}; do
            case "$_arg" in
                --dangerously-skip-permissions|--allow-dangerously-skip-permissions) ;;
                --permission-mode|--permission-mode=*) _has_pm=1; _safe_fwd+=("$_arg") ;;
                *) _safe_fwd+=("$_arg") ;;
            esac
        done
        fwd=(${_safe_fwd[@]+"${_safe_fwd[@]}"})
        if [ "$_has_pm" = 0 ]; then
            fwd=("--permission-mode" "default" ${fwd[@]+"${fwd[@]}"})
        fi
        unset _safe_fwd _arg _has_pm
    fi
    unset remote_user
fi

# -c/--continue 자동 주입 가드 (2026-04-19 cl 크래시 대응):
# zshrc 의 claude() 는 모든 호출에 -c 를 달아 cache hit 을 노리는데, 원격은 호스트마다
# .claude-<n>/.claude.json 이 달라 "No conversation found to continue" 로 즉시 종료된다.
# → 원격 remote_cwd 의 lastSessionId 가 없으면 -c/--continue 를 조용히 제거.
# 세션 존재 시에는 그대로 유지 (연속성 보존).
if [ "$host" != "mac" ]; then
    _has_c=0
    for _arg in ${fwd[@]+"${fwd[@]}"}; do
        case "$_arg" in -c|--continue) _has_c=1; break ;; esac
    done
    if [ "$_has_c" = 1 ]; then
        _cfg_base="${CLAUDE_CONFIG_DIR:+$(basename "$CLAUDE_CONFIG_DIR")}"
        _cfg_base="${_cfg_base:-.claude}"
        _caller_q=$(printf '%q' "$CALLER_CWD")
        # 원격 .claude.json 에서 project.lastSessionId 존재 여부만 확인. ~2 RTT.
        _sess_probe='python3 -c '"'"'import json,os,sys
p=os.path.expanduser("~/'"$_cfg_base"'/.claude.json")
if not os.path.exists(p): sys.exit(1)
try: d=json.load(open(p))
except Exception: sys.exit(1)
proj=d.get("projects",{}).get('"$_caller_q"',{}) if isinstance(d.get("projects",{}),dict) else {}
sys.exit(0 if proj.get("lastSessionId") else 1)'"'"' 2>/dev/null'
        _sess_probe_alias="${dssh_alias:-$alias}"
        if ! ssh -S none -o ControlPath=none -o ConnectTimeout=3 -o BatchMode=yes -T "$_sess_probe_alias" "$_sess_probe" >/dev/null 2>&1; then
            _new_fwd=()
            for _arg in ${fwd[@]+"${fwd[@]}"}; do
                case "$_arg" in -c|--continue) ;; *) _new_fwd+=("$_arg") ;; esac
            done
            fwd=(${_new_fwd[@]+"${_new_fwd[@]}"})
            echo "cx: no remote session → -c stripped (fresh start on $host)" >&2
            unset _new_fwd
        fi
        unset _cfg_base _caller_q _sess_probe _sess_probe_alias
    fi
    unset _has_c _arg
fi

# ─── --ignore-settings: hooks/skills/CLAUDE.md/memory 전부 bypass ─────────────
# 전략: 빈 settings.json 만 있는 임시 CLAUDE_CONFIG_DIR 로 교체 + cwd 중립화.
#   - hooks/skills = settings.json 소스 → {} 으로 무력화
#   - ~/.claude/CLAUDE.md, ~/.claude/projects/<p>/memory = CLAUDE_CONFIG_DIR 소속 → 경로 교체로 차단
#   - project CLAUDE.md = cwd 소속 → 중립 dir 로 cd 해서 차단
# 유지: keychain (Mac 은 system keychain, Linux 는 .credentials.json symlink) + claudx rotation
#   (CLAUDX_POOL/USAGE 는 CLAUDE_CONFIG_DIR 와 독립).
# 미지원: docker_mode=1 (native docker exec) — 컨테이너 내부에 tmp dir 주입 경로 별도 필요.
if [ "$ignore_settings" = "1" ]; then
    _cx_ig_orig_cwd="$CALLER_CWD"
    # airgenome/bin/claude shim 의 .session_defaults 주입도 함께 off — 완전한 clean 세션.
    export NEXUS_SESSION_LAX=1
    if [ "$host" = "mac" ]; then
        _cx_ig_dir=$(mktemp -d -t cx-ignore.XXXXXX)
        printf '{}\n' > "$_cx_ig_dir/settings.json"
        export CLAUDE_CONFIG_DIR="$_cx_ig_dir"
        CALLER_CWD="$_cx_ig_dir"
        trap 'rm -rf "$_cx_ig_dir" 2>/dev/null' EXIT
        echo "cx: --ignore-settings → CLAUDE_CONFIG_DIR=$_cx_ig_dir + NEXUS_SESSION_LAX=1 (local, keychain 유지)" >&2
    elif [ "$docker_mode" = "1" ] && [ -z "$dssh_alias" ]; then
        echo "cx: --ignore-settings 는 --docker (native docker exec) 모드 미지원 — skip" >&2
        ignore_settings=0
    else
        # Remote (ssh 또는 docker-ssh): remote-side 에서 tmp dir 생성 + .credentials 심링크.
        # cwd 는 tmp dir 로 교체, env 는 CLAUDE_CONFIG_DIR 덮어쓰기 + NEXUS_SESSION_LAX.
        remote_env_prefix=$(printf '%s' "$remote_env_prefix" | sed -E 's|CLAUDE_CONFIG_DIR="[^"]*" ||g')
        remote_env_prefix='CLAUDE_CONFIG_DIR="$_d" NEXUS_SESSION_LAX=1 '"$remote_env_prefix"
        remote_cwd_prefix='_d=$(mktemp -d -t cx-ignore.XXXXXX 2>/dev/null || mktemp -d); printf "{}\n" > "$_d/settings.json"; [ -f "$HOME/.claude/.credentials.json" ] && ln -sf "$HOME/.claude/.credentials.json" "$_d/.credentials.json"; trap '"'"'rm -rf "$_d" 2>/dev/null'"'"' EXIT; cd "$_d"; '
        echo "cx: --ignore-settings → remote tmp CLAUDE_CONFIG_DIR + NEXUS_SESSION_LAX=1 (credentials symlink 유지)" >&2
    fi
fi

# 실행 + duration
t0=$(date +%s)
if [ "$host" = "mac" ]; then
    # cx 초반 `cd "$ROOT"` 로 airgenome 에 들어간 상태 → CALLER_CWD 복원 후 실행.
    # 빠뜨리면 `~/Dev/hexa-lang % cl` 같이 다른 cwd 에서 띄워도 claude 가 airgenome 에서 열림.
    # 2026-04-20: non-interactive ssh 세션 (ubu aiden → ssh mac cx) 에서 ~/.local/bin
    #   미포함 → 'claude: command not found'. PATH 명시 보강.
    # airgenome/bin 을 **선두**에 둬야 bin/claude shim 이 `command claude` 호출 시 매칭
    #   → --append-system-prompt 로 .session_defaults 자동 주입 (project context 활성).
    export PATH="$HOME/Dev/airgenome/bin:$HOME/.local/bin:/opt/homebrew/bin:/usr/local/bin:$PATH"
    ( cd "$CALLER_CWD" && command claude ${fwd[@]+"${fwd[@]}"} )
    rc=$?
else
    # /login SSOT 경고 (하루 1회)
    _cx_today=$(date +%Y%m%d)
    _cx_marker="$HOME/.airgenome/cx-login-warning.$_cx_today"
    if [ ! -f "$_cx_marker" ]; then
        mkdir -p "$(dirname "$_cx_marker")" 2>/dev/null
        : > "$_cx_marker"
        echo "cx: /login 은 Mac 에서 'CLAUDE_CONFIG_DIR=\$HOME/.claude-<n> claude' — 원격 /login 은 Mac keychain 미반영 (오늘 1회)" >&2
    fi
    # ssh 직결. cd + env + claude. printf %q 로 args 안전 인코딩.
    # ServerAliveInterval=60 : 유휴 60s 마다 keep-alive, 3회 실패시 연결 종료 → 끊김 감지.
    # tty flag: stdin 이 tty 면 -t (TUI interactive), 아니면 -T (one-shot -p/--print, pipe-safe).
    #          Why: -t + 비-tty stdin 은 "Pseudo-terminal will not be allocated" + claude -p 입력 행.
    # docker 모드 해석 (M14 P4):
    #   1. CLI --docker / --no-docker 가 최우선
    #   2. hosts.json 의 per-host "docker": true 가 기본값
    #   Docker 모드면 ssh 이후 `sudo -n docker exec [-i] -t airgenome-claude claude ...` 로 wrap.
    #   컨테이너는 Mac $TMPDIR 접근 불가 → --add-dir /var/folders skip.
    #   env (CLAUDE_CONFIG_DIR/NODE_OPTIONS/CLAUDX_* 등) 는 docker exec -e 로 재전달.
    host_docker_default=$(jq_host "$host" '(.hosts[$h] // {}) | if has("docker") then .docker else false end')
    if [ "$docker_mode" = 0 ] && [ "$host_docker_default" = "true" ]; then
        docker_mode=1
    fi
    # --no-docker override via env is already consumed by arg parsing above.
    # docker-ssh (dssh_alias) 는 이미 컨테이너 내부 진입 → docker exec 레이어 불필요.
    # v5: docker_mode 를 강제로 0 으로 내려 native 경로 재사용 (단, ssh target 은 dssh_alias).
    if [ -n "$dssh_alias" ]; then
        docker_mode=0
    fi

    # --add-dir /var/folders: Mac $TMPDIR paste 이미지 경로 read 허용 (mac-tmp.service sshfs 경유).
    # (2026-04-19) mac-tmp sshfs mount 끊기면 --add-dir 가 있는 채로 Claude 가 해당 경로 stat 을
    # 시도 → sshfs EIO → 인증 실패로 오판 → 401 재인증 루프. 매 호출 사전 probe 해서
    # mount 살아있을 때만 주입. mount 복구되면 다음 호출에 자동 재활성.
    # docker 모드는 컨테이너에 /var/folders bind mount 가 없으므로 skip.
    add_dir_args=()
    if [ "$docker_mode" != 1 ] && [ -z "$dssh_alias" ]; then
        if ssh -S none -o ControlPath=none -o ConnectTimeout=3 -o BatchMode=yes -T "$alias" "test -d /var/folders" 2>/dev/null; then
            add_dir_args=(--add-dir /var/folders)
        else
            echo "cx: /var/folders mount unreachable → image paste disabled this session" >&2
        fi
    fi
    if [ "$docker_mode" = 1 ]; then
        # docker exec 용 command 조립:
        #   - env 는 remote_env_prefix 의 KEY=VAL 을 그대로 -e KEY=VAL 로 재매핑
        #   - stdin tty 여부에 따라 -it vs -t (-i 생략)
        #   - container name 은 고정 (airgenome-claude). 추후 per-host 변경 가능.
        # genome flag
        : > /tmp/airgenome.cx.docker-used 2>/dev/null || true
        docker_env_args=""
        # remote_env_prefix 는 `KEY="$HOME/..." ...` 형태. $HOME 은 컨테이너 기준(/root) 으로
        # resolve 해야 함. 서브셸에서 HOME=/root (CX_DOCKER_HOME override 가능) 로 eval.
        _container_home="${CX_DOCKER_HOME:-/root}"
        if [ -n "$remote_env_prefix" ]; then
            # HOME 을 임시로 컨테이너 기준으로 교체 후 eval. set-- 은 builtin 이라
            # env-prefix 로 주입되지 않음 → 명시 export 후 복구.
            _cx_save_home=$HOME
            HOME=$_container_home
            # shellcheck disable=SC2086
            eval "set -- $remote_env_prefix :"
            HOME=$_cx_save_home
            while [ $# -gt 0 ]; do
                case "$1" in
                    :) shift; break ;;
                    # BROWSER=Mac 전용 path → 컨테이너에서 의미 없음, skip
                    BROWSER=*) shift ;;
                    *=*)
                        docker_env_args="$docker_env_args -e $(printf '%q' "$1")"
                        shift
                        ;;
                    *) shift ;;
                esac
            done
        fi
        container_name="airgenome-claude"
        if [ -t 0 ]; then
            docker_tty_flags="-it"
        else
            docker_tty_flags="-t"
        fi
        # cwd 는 docker exec --workdir 로 전달. 컨테이너는 MAC_HOME 을 /home/<user>/mac_home 에
        # bind-mount. Mac /Users/ghost/... 를 컨테이너 mac_home 경로로 translate.
        # CX_DOCKER_WORKDIR 로 override 가능. 기본값 empty → 컨테이너 Dockerfile default 사용.
        docker_workdir=""
        if [ -n "${CX_DOCKER_WORKDIR:-}" ]; then
            docker_workdir="--workdir $(printf '%q' "$CX_DOCKER_WORKDIR")"
        else
            case "$CALLER_CWD" in
                /Users/ghost/*)
                    # /Users/ghost/Dev/foo → mac_home/Dev/foo (컨테이너 내부 bind path)
                    rel_from_home=${CALLER_CWD#/Users/ghost/}
                    # 컨테이너는 주로 root, mac_home 위치는 /root/mac_home 또는 /home/<u>/mac_home
                    # docker exec 는 cwd 실재 검증하므로 없으면 실패. 없으면 drop.
                    # 안전 default: --workdir 생략 (컨테이너 Dockerfile 기본 사용).
                    # user 가 명시하려면 CX_DOCKER_WORKDIR 로.
                    :
                    ;;
            esac
        fi
        # [AG-Q14 / 2026-04-20] Docker 컨테이너용 system prompt 자동 주입.
        # SSOT (Mac local cat — 원격 sync 없음, 매 호출 시 최신 Mac 본 참조):
        #   1) .session_defaults             — airgenome 행동규칙 (cl shim 과 동일 SSOT)
        #   2) docker_session_prompt.txt     — docker 컨테이너 환경 context (추가)
        # user 가 이미 --append-system-prompt 을 args 에 넣었거나 CX_DOCKER_NO_PROMPT=1 이면 skip.
        docker_prompt_args=""
        _cx_sd_file="${AIRGENOME:-$HOME/Dev/airgenome}/.session_defaults"
        _cx_dctx_file="${CX_DOCKER_PROMPT_FILE:-$(dirname "$0")/../shared/config/docker_session_prompt.txt}"
        _cx_user_set_asp=0
        for _a in "${fwd[@]:-}"; do
            case "$_a" in --append-system-prompt|--system-prompt|--bare) _cx_user_set_asp=1; break ;; esac
        done
        if [ "${CX_DOCKER_NO_PROMPT:-0}" != "1" ] && [ "$_cx_user_set_asp" = "0" ]; then
            _cx_prompt_content=""
            [ -r "$_cx_sd_file" ]   && _cx_prompt_content="$(cat "$_cx_sd_file")"
            [ -r "$_cx_dctx_file" ] && _cx_prompt_content="${_cx_prompt_content:+$_cx_prompt_content$'\n\n'}$(cat "$_cx_dctx_file")"
            if [ -n "$_cx_prompt_content" ]; then
                docker_prompt_args="--append-system-prompt $(printf '%q' "$_cx_prompt_content")"
            fi
        fi
        docker_cmd="sudo -n docker exec $docker_tty_flags $docker_workdir $docker_env_args $container_name "$(printf '%q ' claude)"$docker_prompt_args "$(printf '%q ' ${fwd[@]+"${fwd[@]}"})
        # fallback 안전망: native inner_cmd 도 미리 조립
        inner_cmd="$remote_cwd_prefix$remote_env_prefix"$(printf '%q ' claude ${add_dir_args[@]+"${add_dir_args[@]}"} ${fwd[@]+"${fwd[@]}"})
        remote_cmd="$docker_cmd; _rc=\$?; if [ \$_rc -eq 125 ] || [ \$_rc -eq 126 ] || [ \$_rc -eq 127 ]; then echo 'cx: docker exec rc='\$_rc' → native fallback' >&2; $inner_cmd; else exit \$_rc; fi"
    else
        inner_cmd="$remote_cwd_prefix$remote_env_prefix"$(printf '%q ' claude ${add_dir_args[@]+"${add_dir_args[@]}"} ${fwd[@]+"${fwd[@]}"})
        if [ -n "$remote_scope_cmd" ]; then
            remote_cmd="if command -v systemd-run >/dev/null 2>&1; then $remote_scope_cmd $(printf '%q' "$inner_cmd"); else $inner_cmd; fi"
        else
            remote_cmd="$inner_cmd"
        fi
    fi
    # KeepAlive 튜닝 (2026-04-19 stall observe): TCPKeepAlive=yes + ServerAliveInterval=15
    # 긴 응답 stream 중 TCP 버퍼 정체로 TUI freeze → 15s 마다 keepalive 로 버퍼 flush 유도.
    #
    # ssh target 선택 (v5):
    #   - dssh_alias 있음 → probe 에서 검증된 docker-ssh alias (host sshd bypass)
    #   - 없음 → 기존 host ssh alias (A+C 미배포 / docker-ssh probe 실패 fallback)
    _ssh_target="${dssh_alias:-$alias}"
    if [ -n "$dssh_alias" ]; then
        echo "cx: docker-ssh → $dssh_alias (host sshd bypass)" >&2
    fi
    if [ -t 0 ]; then
        ssh -S none -o ControlMaster=no -o ControlPath=none -o TCPKeepAlive=yes -o ServerAliveInterval=15 -o ServerAliveCountMax=6 -t "$_ssh_target" "$remote_cmd"
    else
        ssh -S none -o ControlMaster=no -o ControlPath=none -o TCPKeepAlive=yes -o ServerAliveInterval=15 -o ServerAliveCountMax=6 -T "$_ssh_target" "$remote_cmd"
    fi
    rc=$?
    unset _ssh_target
fi
t1=$(date +%s)
dur=$(( t1 - t0 ))

# genome 기록
mkdir -p "$(dirname "$GENOME")"
ts=$(date -u +%Y-%m-%dT%H:%M:%SZ)
printf '{"ts":"%s","host":"%s","duration_s":%d,"exit":%d,"rtt_ms":%d}\n' \
    "$ts" "$host" "$dur" "$rc" "$rtt" >> "$GENOME"

# cx session snapshot — 다음 호출의 --resume-last 를 위한 메타 기록.
# id = unix_ts + short host — 충돌 가능성 무시할 수준 (같은 second 연속 호출 희귀).
# 실패해도 cx rc 에 영향 주지 않음.
cx_sid="$(date +%s)-${host}-$$"
# --ignore-settings 의 tmp cwd 가 resume 에 들어가면 다음 --resume-last 가 엉뚱한 dir 로 → 원본 복원.
if [ "${ignore_settings:-0}" = "1" ] && [ -n "${_cx_ig_orig_cwd:-}" ]; then
    CALLER_CWD="$_cx_ig_orig_cwd"
fi
cx_sess_save "$cx_sid" "$rc" "$dur" "$rtt" 2>/dev/null || true
unset cx_sid

exit $rc
