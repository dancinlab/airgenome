#!/usr/bin/env bash
# bin/cx — AI-native Claude CLI router (ubu/ubu2 우선, mac fallback)
#
# v3 (2026-04-18, C안): tmux 완전 제거. ssh -t 직결.
#   - 세션 관리 레이어 폐기 → 세션 이름 충돌 / fork 이슈 원천 소멸
#   - 원격 ~/.airgenome/cx_remote_launch 미사용 (파일 남아있어도 무해)
#   - 트레이드오프: ssh 끊기면 원격 claude 가 SIGHUP. 집 LAN 전제로 수용.
#
# 책임:
#   1. modules/claude_route.hexa select → best host
#   2. mac 이면 local `command claude`, remote 이면 `ssh -t <alias> <inner_cmd>`
#   3. SSH handshake RTT 측정 (remote only)
#   4. 세션 종료 후 genome 기록
#
# 사용:
#   cx                         # 기본 claude TUI
#   cx "~/Dev/foo"             # arg 전달 (forward)
#   cx --force-host mac        # 강제 라우팅
#   cx --show                  # 선택만, 실행 안 함
#
# Why 별도 이름: Mac 의 `claude` 가 shell 함수 wrapper (터미널 제목 설정) 라 shadow 하면 충돌.

set -uo pipefail

CALLER_CWD="$(pwd)"
ROOT="$(cd "$(dirname "$0")/.." && pwd)"
cd "$ROOT"
MODULE="modules/claude_route.hexa"
REG="shared/config/hosts.json"
GENOME="$ROOT/forge/claude_genome.jsonl"
INFRA_STATE="$HOME/Dev/nexus/shared/infra_state.json"

die() { echo "cx: $*" >&2; exit 2; }

# ms precision timer — Linux date %N 비호환 macOS → perl fallback
now_ms() {
    if command -v perl >/dev/null 2>&1; then
        perl -MTime::HiRes=time -e 'printf "%d\n", time()*1000'
    else
        echo $(( $(date +%s) * 1000 ))
    fi
}

jq_host() {
    local host=$1 expr=$2
    jq -r --arg h "$host" "$expr" "$REG" 2>/dev/null
}

ssh_target_user() {
    local alias=$1
    ssh -G "$alias" 2>/dev/null | awk '/^user /{print $2; exit}'
}

host_preload_enabled() {
    local host=$1 mode
    mode=$(jq_host "$host" '(.hosts[$h] // {}) | if has("claudx_preload") then .claudx_preload else true end')
    [ "$mode" = "true" ]
}

host_hot() {
    local host=$1
    [ -r "$INFRA_STATE" ] || return 1
    local line ts_s now_s age status load_s threads_s cap_s util
    line=$(jq -r --arg h "$host" '
        [(.ts // ""), (.hosts[$h].status // ""), (.hosts[$h].load // ""), (.hosts[$h].cpu_threads // ""), (.hosts[$h].ram_total_mb // "")]
        | @tsv
    ' "$INFRA_STATE" 2>/dev/null) || return 1
    IFS=$'\t' read -r ts_s status load_s threads_s _ <<< "$line"
    [ -n "$ts_s" ] || return 1
    now_s=$(date +%s)
    ts_s=$(jq -nr --arg ts "$ts_s" '$ts | fromdateiso8601' 2>/dev/null) || return 1
    age=$((now_s - ts_s))
    [ "$age" -le "${CLAUDX_INFRA_MAX_AGE_SEC:-180}" ] || return 1
    [ "$status" = "active" ] || return 1
    cap_s=$(jq_host "$host" '.hosts[$h].claude_limits.load_pct // empty')
    [ -n "$cap_s" ] || return 1
    [ -n "$load_s" ] || return 1
    [ -n "$threads_s" ] || threads_s=$(jq_host "$host" '.hosts[$h].threads // 0')
    [ "${threads_s:-0}" -gt 0 ] 2>/dev/null || return 1
    util=$(awk -v l="$load_s" -v t="$threads_s" 'BEGIN{ if (t<=0) print 0; else printf "%d", (l*100)/t }')
    [ "${util:-0}" -ge "${cap_s:-101}" ]
}

# arg parsing — --force-host / --show / --docker 는 wrapper 전용, 나머지는 claude 로 forward
force_host=""
show_only=false
docker_mode=${CX_DOCKER:-0}
fwd=()
while [ $# -gt 0 ]; do
    case "$1" in
        --force-host) force_host=$2; shift 2 ;;
        --show)       show_only=true; shift ;;
        --docker)     docker_mode=1; shift ;;
        --no-docker)  docker_mode=0; shift ;;
        --)           shift; fwd+=("$@"); break ;;
        *)            fwd+=("$1"); shift ;;
    esac
done

# host 후보 기본 순서:
#   1. JSON 순서 우선 (현재 사용자 지시: ubu 우선)
#   2. probe 성공 첫 호스트 선택
# 기본 정책: 원격 후보가 전부 없으면 mac fallback 허용.
# 명시적으로 막고 싶으면 CLAUDX_ALLOW_MAC_FALLBACK=0.
if [ -n "$force_host" ]; then
    candidates=("$force_host")
else
    # enabled remote 를 JSON 순서대로 추출
    remote_cands=()
    while IFS= read -r h; do [ -n "$h" ] && remote_cands+=("$h"); done < <(jq -r '.hosts | to_entries | map(select(.value.enabled==true and .value.kind!="self")) | .[].key' "$REG" 2>/dev/null)
    candidates=(${remote_cands[@]+"${remote_cands[@]}"})
    if [ "${CLAUDX_ALLOW_MAC_FALLBACK:-1}" = "1" ]; then
        candidates+=("mac")
    fi
    unset remote_cands
fi

# NODE_OPTIONS 에서 preload 경로 추출 (2026-04-19 htz preload 실패 대응):
#   --require /path/to/interceptor.js → 원격에도 이 파일이 있어야 claudx 가 뜬다.
#   sshfs 있는 host (ubu/ubu2) 는 /Users/ghost 심볼릭으로 해결. htz 는 mount 없어 실패.
#   probe 단계에서 파일 존재까지 확인 → 없으면 다음 후보로.
cx_preload_path=""
if [ -n "${NODE_OPTIONS:-}" ]; then
    cx_preload_path=$(printf '%s' "$NODE_OPTIONS" | grep -oE -- '--require[= ][^ ]+' | head -1 | sed -E 's/^--require[= ]//')
fi

# parallel probe — 모든 remote 후보에 동시 발사, priority 순서로 첫 성공 선택.
# -o ControlPath=none 으로 stale mux bypass. `timeout` 래핑으로 banner-hang 도 강제 컷.
# Why 병렬: ubu sshd 가 과부하로 banner timeout 이면 sequential 은 ConnectTimeout(3s) 단위로 쌓이고
#        BannerTimeout 기본 120s 까지 대기 가능. 병렬+timeout 래핑 시 worst-case = max ConnectTimeout.
host=""
alias=""
rtt=0

# 분리: 원격 후보 + mac fallback 여부
remote_to_probe=()
has_mac_fallback=0
for cand in "${candidates[@]}"; do
    if [ "$cand" = "mac" ]; then
        has_mac_fallback=1
    else
        # gate hot 필터 (infra_state 기반)
        if [ -z "$force_host" ] && host_hot "$cand"; then
            _util=$(jq -r --arg h "$cand" '
                ((.hosts[$h].load // "0") | tonumber) * 100 / ((.hosts[$h].cpu_threads // 0) | tonumber)
                | floor
            ' "$INFRA_STATE" 2>/dev/null)
            _cap=$(jq_host "$cand" '.hosts[$h].claude_limits.load_pct // empty')
            echo "cx: gate hot → $cand (${_util:-?}% >= ${_cap:-?}%, next)" >&2
            unset _util _cap
            continue
        fi
        remote_to_probe+=("$cand")
    fi
done

if [ ${#remote_to_probe[@]} -gt 0 ]; then
    probe_dir=$(mktemp -d -t cx-probe.XXXXXX) || die "mktemp failed"
    probe_pids=()
    trap 'for p in "${probe_pids[@]}"; do kill "$p" 2>/dev/null; done; rm -rf "$probe_dir" 2>/dev/null' EXIT
    r0=$(now_ms)
    max_t=0
    # 병렬 발사 — 각 cand 별 background ssh + timeout 래핑
    for cand in "${remote_to_probe[@]}"; do
        cand_alias=$(jq -r --arg h "$cand" '.hosts[$h].ssh_alias // ""' "$REG")
        [ -n "$cand_alias" ] || { echo no_alias > "$probe_dir/$cand.fail"; continue; }
        _connect_t=$(jq_host "$cand" '.hosts[$h].probe_connect_timeout // 3')
        [ "${_connect_t:-3}" -gt "$max_t" ] 2>/dev/null && max_t=$_connect_t
        if [ -n "$cx_preload_path" ] && host_preload_enabled "$cand"; then
            _probe_cmd="test -f $(printf '%q' "$cx_preload_path")"
        else
            _probe_cmd="true"
        fi
        (
            # timeout: ConnectTimeout 은 TCP handshake 만 커버. banner-hang 차단용으로
            # 외부 timeout 래퍼 필수. macOS 는 gtimeout 이 있을 수도, 없으면 `timeout`(coreutils).
            _to=timeout
            command -v timeout >/dev/null 2>&1 || _to=gtimeout
            if "$_to" "$_connect_t" ssh -o ControlPath=none -o ControlMaster=no \
                -o ConnectTimeout="$_connect_t" -o BatchMode=yes \
                "$cand_alias" "$_probe_cmd" 2>/dev/null; then
                printf '%s' "$cand_alias" > "$probe_dir/$cand.ok"
            else
                echo fail > "$probe_dir/$cand.fail"
            fi
        ) >/dev/null 2>&1 &
        probe_pids+=($!)
        disown "$!" 2>/dev/null || true
    done
    unset _connect_t _probe_cmd cand_alias

    # first-responder-wins poll: 아무 후보라도 .ok 면 즉시 채택 (priority 는 동시-승리 시 tiebreak).
    # Why first-responder: 사용자 요청 "속도 우선". LAN 환경에서 priority-first 상위가 과부하면
    # 병렬의 의미가 사라짐 (상위 timeout 끝까지 대기). 병렬 중 상위와 하위가 모두 성공하면
    # for-iteration 순서 (priority) 로 이미 상위가 뽑힘.
    deadline=$(( $(date +%s) + max_t + 1 ))
    while [ "$(date +%s)" -lt "$deadline" ]; do
        pick=""
        all_done=1
        for cand in "${remote_to_probe[@]}"; do
            if [ -f "$probe_dir/$cand.ok" ]; then
                pick=$cand
                break
            fi
            [ -f "$probe_dir/$cand.fail" ] || all_done=0
        done
        if [ -n "$pick" ]; then
            host=$pick
            alias=$(cat "$probe_dir/$pick.ok")
            break
        fi
        [ "$all_done" = 1 ] && break
        sleep 0.05
    done

    # 실패 후보 로그 (선택된 것 이전의 fail 만)
    for cand in "${remote_to_probe[@]}"; do
        [ "$cand" = "$host" ] && break
        [ -f "$probe_dir/$cand.fail" ] && echo "cx: probe fail → $cand (next)" >&2
    done

    [ -n "$host" ] && rtt=$(( $(now_ms) - r0 ))

    # 잔여 프로브 즉시 kill (wait 하지 않음 — 선택 완료 직후 cx 진행)
    for _p in "${probe_pids[@]}"; do kill "$_p" 2>/dev/null; done
    rm -rf "$probe_dir" 2>/dev/null
    trap - EXIT
    unset _p
fi

if [ -z "$host" ] && [ "$has_mac_fallback" = 1 ]; then
    host=mac
fi

[ -n "$host" ] || die "no host reachable"

if [ "$show_only" = true ]; then
    echo "cx → $host${alias:+ ($alias)}"
    exit 0
fi

echo "cx → $host${alias:+ ($alias)}" >&2

# CLAUDE_CONFIG_DIR 매핑: cl 이 Mac 절대경로(/Users/ghost/.claude-claudeN)로 export 하므로
# 원격에는 basename 만 뽑아서 $HOME/<basename> 형태로 전달 (호스트별 HOME 상이: /home/aiden vs /home/summer).
remote_env_prefix=""
if [ "$host" != "mac" ] && [ -n "${CLAUDE_CONFIG_DIR:-}" ]; then
    base=$(basename "$CLAUDE_CONFIG_DIR")
    remote_env_prefix='CLAUDE_CONFIG_DIR="$HOME/'"$base"'" '
fi

# BROWSER inject — 원격 /login 의 OAuth URL 을 Mac 브라우저로 역송출.
if [ "$host" != "mac" ]; then
    remote_env_prefix='BROWSER="$HOME/bin/open-on-mac" '"$remote_env_prefix"
fi

# claudx integration (M13): forward NODE_OPTIONS + CLAUDX_* so the in-process
# rate-limit interceptor loads on the remote claude. sshfs /Users/ghost symlink
# lets Mac-absolute paths in NODE_OPTIONS resolve unchanged on the remote.
if [ "$host" != "mac" ] && host_preload_enabled "$host"; then
    if [ -n "${NODE_OPTIONS:-}" ]; then
        remote_env_prefix="NODE_OPTIONS=$(printf '%q' "$NODE_OPTIONS") $remote_env_prefix"
    fi
    if [ -n "${BUN_OPTIONS:-}" ]; then
        remote_env_prefix="BUN_OPTIONS=$(printf '%q' "$BUN_OPTIONS") $remote_env_prefix"
    fi
    for __cxv in CLAUDX_STATE CLAUDX_POOL CLAUDX_USAGE CLAUDX_HOME_MAP CLAUDX_MAX_ROT CLAUDX_EXH_SEC CLAUDX_DEBUG CLAUDX_SCRUB; do
        eval "__cxval=\${$__cxv:-}"
        if [ -n "$__cxval" ]; then
            remote_env_prefix="$__cxv=$(printf '%q' "$__cxval") $remote_env_prefix"
        fi
    done
    unset __cxv __cxval
    # (2026-04-19) interceptor rotation 경로 복구:
    # 원격 pool.js 가 accounts.json + .credentials.json 을 resolve 할 수 있도록
    # CLAUDX_POOL / CLAUDX_USAGE / CLAUDX_HOME_MAP 을 hosts.json 에 따라 자동주입.
    # 이미 env 에 세팅돼 있으면 위 루프가 먼저 기록했으므로 덮지 않음.
    case "$remote_env_prefix" in
        *CLAUDX_POOL=*) : ;;
        *) remote_env_prefix="CLAUDX_POOL=/Users/ghost/Dev/nexus/shared/.runtime/accounts/accounts.json $remote_env_prefix" ;;
    esac
    case "$remote_env_prefix" in
        *CLAUDX_USAGE=*) : ;;
        *) remote_env_prefix="CLAUDX_USAGE=/Users/ghost/Dev/nexus/shared/.runtime/accounts/usage-cache.json $remote_env_prefix" ;;
    esac
    case "$remote_env_prefix" in
        *CLAUDX_HOME_MAP=*) : ;;
        *)
            _host_home=$(jq_host "$host" '.hosts[$h].home // empty')
            if [ -n "$_host_home" ]; then
                remote_env_prefix="CLAUDX_HOME_MAP=$(printf '%q' "/Users/ghost:$_host_home") $remote_env_prefix"
            fi
            unset _host_home
            ;;
    esac
fi

# systemd-run/cgroup 격리는 2026-04-19 폐기: airgenome-claude.slice cgroup
# "Structure needs cleaning" (EUCLEAN) 손상으로 scope 생성 100% 실패 → claude 미실행.
# 결과적으로 리소스 한도는 호스트 수준/ulimit/cpulimit 등 후속 수단에 위임.
remote_scope_cmd=""

# cwd 매핑: 원격 /Users/ghost → $HOME/mac_home symlink 로 Mac 절대경로 그대로 resolve.
# fallback: Mac HOME 밖이면 상대 경로 추출 시도 후 최후 $HOME.
remote_cwd_prefix=""
if [ "$host" != "mac" ]; then
    caller_quoted=$(printf '%q' "$CALLER_CWD")
    case "$CALLER_CWD" in
        /Users/ghost/*)
            rel="${CALLER_CWD#/Users/ghost/}"
            rel_quoted=$(printf '%q' "$rel")
            remote_cwd_prefix='cd '"$caller_quoted"' 2>/dev/null || cd "$HOME"/'"$rel_quoted"' 2>/dev/null || cd "$HOME"; '
            ;;
        *)
            remote_cwd_prefix='cd '"$caller_quoted"' 2>/dev/null || cd "$HOME"; '
            ;;
    esac
fi

if [ "$host" != "mac" ]; then
    remote_user=$(ssh_target_user "$alias")
    if [ "$remote_user" = "root" ]; then
        _safe_fwd=()
        for _arg in ${fwd[@]+"${fwd[@]}"}; do
            case "$_arg" in
                --dangerously-skip-permissions|--allow-dangerously-skip-permissions) ;;
                *) _safe_fwd+=("$_arg") ;;
            esac
        done
        fwd=("${_safe_fwd[@]}")
        unset _safe_fwd _arg
    fi
    unset remote_user
fi

# -c/--continue 자동 주입 가드 (2026-04-19 cl 크래시 대응):
# zshrc 의 claude() 는 모든 호출에 -c 를 달아 cache hit 을 노리는데, 원격은 호스트마다
# .claude-<n>/.claude.json 이 달라 "No conversation found to continue" 로 즉시 종료된다.
# → 원격 remote_cwd 의 lastSessionId 가 없으면 -c/--continue 를 조용히 제거.
# 세션 존재 시에는 그대로 유지 (연속성 보존).
if [ "$host" != "mac" ]; then
    _has_c=0
    for _arg in ${fwd[@]+"${fwd[@]}"}; do
        case "$_arg" in -c|--continue) _has_c=1; break ;; esac
    done
    if [ "$_has_c" = 1 ]; then
        _cfg_base="${CLAUDE_CONFIG_DIR:+$(basename "$CLAUDE_CONFIG_DIR")}"
        _cfg_base="${_cfg_base:-.claude}"
        _caller_q=$(printf '%q' "$CALLER_CWD")
        # 원격 .claude.json 에서 project.lastSessionId 존재 여부만 확인. ~2 RTT.
        _sess_probe='python3 -c '"'"'import json,os,sys
p=os.path.expanduser("~/'"$_cfg_base"'/.claude.json")
if not os.path.exists(p): sys.exit(1)
try: d=json.load(open(p))
except Exception: sys.exit(1)
proj=d.get("projects",{}).get('"$_caller_q"',{}) if isinstance(d.get("projects",{}),dict) else {}
sys.exit(0 if proj.get("lastSessionId") else 1)'"'"' 2>/dev/null'
        if ! ssh -S none -o ControlPath=none -o ConnectTimeout=3 -o BatchMode=yes -T "$alias" "$_sess_probe" >/dev/null 2>&1; then
            _new_fwd=()
            for _arg in ${fwd[@]+"${fwd[@]}"}; do
                case "$_arg" in -c|--continue) ;; *) _new_fwd+=("$_arg") ;; esac
            done
            fwd=(${_new_fwd[@]+"${_new_fwd[@]}"})
            echo "cx: no remote session → -c stripped (fresh start on $host)" >&2
            unset _new_fwd
        fi
        unset _cfg_base _caller_q _sess_probe
    fi
    unset _has_c _arg
fi

# 실행 + duration
t0=$(date +%s)
if [ "$host" = "mac" ]; then
    command claude ${fwd[@]+"${fwd[@]}"}
    rc=$?
else
    # /login SSOT 경고 (하루 1회)
    _cx_today=$(date +%Y%m%d)
    _cx_marker="$HOME/.airgenome/cx-login-warning.$_cx_today"
    if [ ! -f "$_cx_marker" ]; then
        mkdir -p "$(dirname "$_cx_marker")" 2>/dev/null
        : > "$_cx_marker"
        echo "cx: /login 은 Mac 에서 'CLAUDE_CONFIG_DIR=\$HOME/.claude-<n> claude' — 원격 /login 은 Mac keychain 미반영 (오늘 1회)" >&2
    fi
    # ssh 직결. cd + env + claude. printf %q 로 args 안전 인코딩.
    # ServerAliveInterval=60 : 유휴 60s 마다 keep-alive, 3회 실패시 연결 종료 → 끊김 감지.
    # tty flag: stdin 이 tty 면 -t (TUI interactive), 아니면 -T (one-shot -p/--print, pipe-safe).
    #          Why: -t + 비-tty stdin 은 "Pseudo-terminal will not be allocated" + claude -p 입력 행.
    # docker 모드 해석 (M14 P4):
    #   1. CLI --docker / --no-docker 가 최우선
    #   2. hosts.json 의 per-host "docker": true 가 기본값
    #   Docker 모드면 ssh 이후 `sudo -n docker exec [-i] -t airgenome-claude claude ...` 로 wrap.
    #   컨테이너는 Mac $TMPDIR 접근 불가 → --add-dir /var/folders skip.
    #   env (CLAUDE_CONFIG_DIR/NODE_OPTIONS/CLAUDX_* 등) 는 docker exec -e 로 재전달.
    host_docker_default=$(jq_host "$host" '(.hosts[$h] // {}) | if has("docker") then .docker else false end')
    if [ "$docker_mode" = 0 ] && [ "$host_docker_default" = "true" ]; then
        docker_mode=1
    fi
    # --no-docker override via env is already consumed by arg parsing above.

    # --add-dir /var/folders: Mac $TMPDIR paste 이미지 경로 read 허용 (mac-tmp.service sshfs 경유).
    # (2026-04-19) mac-tmp sshfs mount 끊기면 --add-dir 가 있는 채로 Claude 가 해당 경로 stat 을
    # 시도 → sshfs EIO → 인증 실패로 오판 → 401 재인증 루프. 매 호출 사전 probe 해서
    # mount 살아있을 때만 주입. mount 복구되면 다음 호출에 자동 재활성.
    # docker 모드는 컨테이너에 /var/folders bind mount 가 없으므로 skip.
    add_dir_args=()
    if [ "$docker_mode" != 1 ]; then
        if ssh -S none -o ControlPath=none -o ConnectTimeout=3 -o BatchMode=yes -T "$alias" "test -d /var/folders" 2>/dev/null; then
            add_dir_args=(--add-dir /var/folders)
        else
            echo "cx: /var/folders mount unreachable → image paste disabled this session" >&2
        fi
    fi
    if [ "$docker_mode" = 1 ]; then
        # docker exec 용 command 조립:
        #   - env 는 remote_env_prefix 의 KEY=VAL 을 그대로 -e KEY=VAL 로 재매핑
        #   - stdin tty 여부에 따라 -it vs -t (-i 생략)
        #   - container name 은 고정 (airgenome-claude). 추후 per-host 변경 가능.
        # genome flag
        : > /tmp/airgenome.cx.docker-used 2>/dev/null || true
        docker_env_args=""
        # remote_env_prefix 는 `KEY="$HOME/..." ...` 형태. $HOME 은 컨테이너 기준(/root) 으로
        # resolve 해야 함. 서브셸에서 HOME=/root (CX_DOCKER_HOME override 가능) 로 eval.
        _container_home="${CX_DOCKER_HOME:-/root}"
        if [ -n "$remote_env_prefix" ]; then
            # HOME 을 임시로 컨테이너 기준으로 교체 후 eval. set-- 은 builtin 이라
            # env-prefix 로 주입되지 않음 → 명시 export 후 복구.
            _cx_save_home=$HOME
            HOME=$_container_home
            # shellcheck disable=SC2086
            eval "set -- $remote_env_prefix :"
            HOME=$_cx_save_home
            while [ $# -gt 0 ]; do
                case "$1" in
                    :) shift; break ;;
                    # BROWSER=Mac 전용 path → 컨테이너에서 의미 없음, skip
                    BROWSER=*) shift ;;
                    *=*)
                        docker_env_args="$docker_env_args -e $(printf '%q' "$1")"
                        shift
                        ;;
                    *) shift ;;
                esac
            done
        fi
        container_name="airgenome-claude"
        if [ -t 0 ]; then
            docker_tty_flags="-it"
        else
            docker_tty_flags="-t"
        fi
        # cwd 는 docker exec --workdir 로 전달. 컨테이너는 MAC_HOME 을 /home/<user>/mac_home 에
        # bind-mount. Mac /Users/ghost/... 를 컨테이너 mac_home 경로로 translate.
        # CX_DOCKER_WORKDIR 로 override 가능. 기본값 empty → 컨테이너 Dockerfile default 사용.
        docker_workdir=""
        if [ -n "${CX_DOCKER_WORKDIR:-}" ]; then
            docker_workdir="--workdir $(printf '%q' "$CX_DOCKER_WORKDIR")"
        else
            case "$CALLER_CWD" in
                /Users/ghost/*)
                    # /Users/ghost/Dev/foo → mac_home/Dev/foo (컨테이너 내부 bind path)
                    rel_from_home=${CALLER_CWD#/Users/ghost/}
                    # 컨테이너는 주로 root, mac_home 위치는 /root/mac_home 또는 /home/<u>/mac_home
                    # docker exec 는 cwd 실재 검증하므로 없으면 실패. 없으면 drop.
                    # 안전 default: --workdir 생략 (컨테이너 Dockerfile 기본 사용).
                    # user 가 명시하려면 CX_DOCKER_WORKDIR 로.
                    :
                    ;;
            esac
        fi
        docker_cmd="sudo -n docker exec $docker_tty_flags $docker_workdir $docker_env_args $container_name "$(printf '%q ' claude ${fwd[@]+"${fwd[@]}"})
        # fallback 안전망: native inner_cmd 도 미리 조립
        inner_cmd="$remote_cwd_prefix$remote_env_prefix"$(printf '%q ' claude ${add_dir_args[@]+"${add_dir_args[@]}"} ${fwd[@]+"${fwd[@]}"})
        remote_cmd="$docker_cmd; _rc=\$?; if [ \$_rc -eq 125 ] || [ \$_rc -eq 126 ] || [ \$_rc -eq 127 ]; then echo 'cx: docker exec rc='\$_rc' → native fallback' >&2; $inner_cmd; else exit \$_rc; fi"
    else
        inner_cmd="$remote_cwd_prefix$remote_env_prefix"$(printf '%q ' claude ${add_dir_args[@]+"${add_dir_args[@]}"} ${fwd[@]+"${fwd[@]}"})
        if [ -n "$remote_scope_cmd" ]; then
            remote_cmd="if command -v systemd-run >/dev/null 2>&1; then $remote_scope_cmd $(printf '%q' "$inner_cmd"); else $inner_cmd; fi"
        else
            remote_cmd="$inner_cmd"
        fi
    fi
    # KeepAlive 튜닝 (2026-04-19 stall observe): TCPKeepAlive=yes + ServerAliveInterval=15
    # 긴 응답 stream 중 TCP 버퍼 정체로 TUI freeze → 15s 마다 keepalive 로 버퍼 flush 유도.
    if [ -t 0 ]; then
        ssh -S none -o ControlMaster=no -o ControlPath=none -o TCPKeepAlive=yes -o ServerAliveInterval=15 -o ServerAliveCountMax=6 -t "$alias" "$remote_cmd"
    else
        ssh -S none -o ControlMaster=no -o ControlPath=none -o TCPKeepAlive=yes -o ServerAliveInterval=15 -o ServerAliveCountMax=6 -T "$alias" "$remote_cmd"
    fi
    rc=$?
fi
t1=$(date +%s)
dur=$(( t1 - t0 ))

# genome 기록
mkdir -p "$(dirname "$GENOME")"
ts=$(date -u +%Y-%m-%dT%H:%M:%SZ)
printf '{"ts":"%s","host":"%s","duration_s":%d,"exit":%d,"rtt_ms":%d}\n' \
    "$ts" "$host" "$dur" "$rc" "$rtt" >> "$GENOME"

exit $rc
