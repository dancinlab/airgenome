// bin/runaway_guard.hexa — M14 P2 ubu1 폭주 감지/대응 엔진
//
// 책임:
//   1. /proc 직접 스캔 — load/iowait/mem/d-state + top CPU procs (systemctl X)
//   2. thresholds.json 기반 4단계 verdict (ok/warn/danger/critical)
//   3. whitelist.json 보호 — claude/sshd/node/hexa/systemd* 에 절대 손 안 댐
//   4. 액션: renice +10/+15 / cpulimit --limit 50/30 (kill/STOP 금지)
//   5. JSONL 로그 append → ~/.airgenome/runaway.jsonl
//   6. dry-run (env RUNAWAY_DRY_RUN=1) + 1-shot test (env RUNAWAY_TEST=1)
//
// 제약:
//   - use "../core/core" 만 (AG-core-only invariant)
//   - try/catch 미사용 (hexa-lang stage1)
//   - list.push(x) no-op — `list = list + [x]` 사용 (feedback_hexa-list-push-noop)
//   - if 조건에서 전역 let 직접 비교 X — 로컬 복사 (feedback_hexa-global-const-if)
//   - to_string(void) → "void" 가드 필수 (feedback_hexa_void_json)
//   - pgrep -f 자기참조 X — /proc/*/comm 전수 스캔 (feedback_pgrep_self_reference)
//   - Mac 실행 금지 (AG6/AG-MAC-01) — 엔진 자체는 Ubuntu 타겟. Mac 에선 parse-only.
//
// Usage:
//   systemd:   ExecStart=/usr/local/bin/hexa run /opt/airgenome/bin/runaway_guard.hexa
//   dev:       HEXA_LOCAL=1 RUNAWAY_TEST=1 RUNAWAY_DRY_RUN=1 hexa run bin/runaway_guard.hexa
//   1회 측정:  RUNAWAY_TEST=1 hexa run bin/runaway_guard.hexa

// core/core 의존 제거 — hexa `use "..."` 문법이 stage0 parse error.
// airgenome_root() 로컬 재구현 (core.hexa:278 동일 로직).

let HOME = env("HOME")
let LOG_PATH = HOME + "/.airgenome/runaway.jsonl"
let SLEEP_SECONDS = 5
let SUSTAIN_WINDOW = 30  // runaway_pid.sustain_seconds 기본값 (thresholds.json override)

// ─── state file 기본 위치 (Mac dev 와 Ubuntu prod 공존) ───────────────────
fn ag_root() -> str {
    let custom = env("AIRGENOME_ROOT")
    if custom != "" { return custom }
    return env("HOME") + "/Dev/airgenome"
}

fn thresholds_path() -> str {
    return ag_root() + "/shared/runaway/thresholds.json"
}

fn whitelist_path() -> str {
    return ag_root() + "/shared/runaway/whitelist.json"
}

// ═══════════════════════════════════════════════════════════════════════
//  METRICS — /proc 직접 읽기
// ═══════════════════════════════════════════════════════════════════════

fn ts_iso() -> str {
    return exec("date -u +%Y-%m-%dT%H:%M:%SZ").trim()
}

fn ts_epoch() -> int {
    return to_int(exec("date +%s").trim())
}

// /proc/loadavg → "0.42 0.38 0.31 2/431 12345"
// 반환: load1 정수부 (float 비교 회피 — hexa-lang stage1 float quirk)
fn read_load_x100(idx: int) -> int {
    // idx=0 → load1, idx=1 → load5. 결과는 *100 scaled int (0.73 → 73).
    let raw = exec("cat /proc/loadavg 2>/dev/null").trim()
    if raw == "" { return 0 }
    let parts = raw.split(" ")
    if len(parts) <= idx { return 0 }
    let s = parts[idx].trim()
    if s == "" { return 0 }
    let dp = s.split(".")
    if len(dp) == 0 { return 0 }
    let head = dp[0]
    let mut frac_s = "00"
    if len(dp) >= 2 { frac_s = dp[1] }
    // 소수 2자리까지만
    if len(frac_s) > 2 { frac_s = frac_s_truncate2(frac_s) }
    if len(frac_s) == 1 { frac_s = frac_s + "0" }
    let mut head_i = 0
    if head != "" { head_i = to_int(head) }
    let mut frac_i = 0
    if frac_s != "" { frac_i = to_int(frac_s) }
    return head_i * 100 + frac_i
}

// hexa-lang 에 .substr 없음 — 2자리 수동 truncate. 빈문자 안전.
fn frac_s_truncate2(s: str) -> str {
    if len(s) <= 2 { return s }
    let chars = s.split("")
    // split("") 가 하나씩 쪼개지 않으면 fallback — jq 로 cut
    if len(chars) >= 3 {
        if chars[0] != "" {
            if chars[1] != "" { return chars[0] + chars[1] }
        }
    }
    // fallback — awk cut (단일 포크 1회)
    let r = exec("printf '%s' '" + s + "' | cut -c1-2").trim()
    if r != "" { return r }
    return "00"
}

fn read_nproc() -> int {
    let s = exec("nproc 2>/dev/null").trim()
    if s == "" {
        // /proc/cpuinfo fallback
        s = exec("grep -c ^processor /proc/cpuinfo 2>/dev/null").trim()
    }
    if s == "" { return 1 }
    let n = to_int(s)
    if n <= 0 { return 1 }
    return n
}

// /proc/stat 첫 줄: cpu  user nice system idle iowait irq softirq steal guest guest_nice
// 두 샘플 delta 로 iowait % 계산. 단일-샘플일 때는 idle 기반 근사 불가 → sleep 1 후 재샘플.
fn read_iowait_pct() -> int {
    // 첫 샘플
    let a = exec("head -1 /proc/stat 2>/dev/null").trim()
    let _s = exec("sleep 1")
    let b = exec("head -1 /proc/stat 2>/dev/null").trim()
    if a == "" { return 0 }
    if b == "" { return 0 }
    let pa = split_fields(a)
    let pb = split_fields(b)
    // pa[0] = "cpu", 숫자는 pa[1..] . iowait 는 index 5 (user=1 nice=2 system=3 idle=4 iowait=5).
    if len(pa) < 6 { return 0 }
    if len(pb) < 6 { return 0 }
    let mut total_a = 0
    let mut total_b = 0
    let mut i = 1
    while i < len(pa) {
        if i < len(pb) {
            total_a = total_a + to_int(pa[i])
            total_b = total_b + to_int(pb[i])
        }
        i = i + 1
    }
    let iowait_a = to_int(pa[5])
    let iowait_b = to_int(pb[5])
    let dt = total_b - total_a
    let di = iowait_b - iowait_a
    if dt <= 0 { return 0 }
    if di < 0 { return 0 }
    return di * 100 / dt
}

// 공백 연속 → 단일 토큰. awk/tr fork 회피.
fn split_fields(s: str) -> list {
    let parts = s.split(" ")
    let out = []
    let mut i = 0
    while i < len(parts) {
        let p = parts[i]
        if p != "" { out = out + [p] }
        i = i + 1
    }
    return out
}

// /proc/meminfo → MemAvailable kB → GB (int 반올림 내림)
fn read_mem_avail_gb() -> int {
    let s = exec("awk '/^MemAvailable:/{print $2}' /proc/meminfo 2>/dev/null").trim()
    if s == "" { return 0 }
    let kb = to_int(s)
    if kb <= 0 { return 0 }
    return kb / 1024 / 1024
}

// D-state PID 개수 — /proc/*/stat 의 state 필드(3번째) 가 'D'
// pgrep -f 자기참조 버그 회피 — ps 로 직접.
fn read_d_state_count() -> int {
    // ps -eo s= 은 state 한 글자만 열거. D 카운트.
    let s = exec("ps -eo s= 2>/dev/null | awk '$1==\"D\"{c++}END{print c+0}'").trim()
    if s == "" { return 0 }
    return to_int(s)
}

// ─── ORPHAN RUNAWAY struct + etime parser (hetzner 10×hexa 27h 사건 대응) ────
struct OrphanProc {
    pid: int,
    comm: str,
    pcpu: int,
    etime_s: int,
    ppid: int,
    // sub_class = "spin" (pcpu>=pcpu_spin) OR "stuck" (pcpu<=pcpu_stuck).
    // 둘 다 고아 hexa* 는 정상이 아님. stuck 은 shim-lock 홀더로 다른 hexa 호출 전부 block 하는 케이스.
    sub_class: str
}

// ps etime 포맷 → seconds. 지원 포맷: "SS", "MM:SS", "HH:MM:SS", "DD-HH:MM:SS"
// 실패 시 0. 공백/void 안전.
fn etime_to_seconds(raw: str) -> int {
    let s = raw.trim()
    if s == "" { return 0 }
    if to_string(s) == "void" { return 0 }
    // DD-HH:MM:SS → split on "-" first
    let mut days = 0
    let mut rest = s
    let dash = s.split("-")
    if len(dash) >= 2 {
        let d0 = dash[0]
        if d0 != "" { days = to_int(d0) }
        rest = dash[1]
    }
    let parts = rest.split(":")
    let n = len(parts)
    let mut h = 0
    let mut mi = 0
    let mut se = 0
    if n == 1 {
        if parts[0] != "" { se = to_int(parts[0]) }
    }
    if n == 2 {
        if parts[0] != "" { mi = to_int(parts[0]) }
        if parts[1] != "" { se = to_int(parts[1]) }
    }
    if n == 3 {
        if parts[0] != "" { h = to_int(parts[0]) }
        if parts[1] != "" { mi = to_int(parts[1]) }
        if parts[2] != "" { se = to_int(parts[2]) }
    }
    return days * 86400 + h * 3600 + mi * 60 + se
}

// hexa* 고아 2 class — 둘 다 whitelist override 대상.
//  (a) spin:  ppid=1 AND pcpu>=pcpu_spin AND etime>=etime_gate — 100% CPU 무한 루프 (hetzner 27h).
//  (b) stuck: ppid=1 AND pcpu<=pcpu_stuck AND etime>=etime_gate — 0% CPU 로 shim-lock 홀드해
//             다른 hexa 호출 전부 block (Mac 34min 사례, "lock timeout after 300s" 반복).
// 고아 hexa 는 정상적 존재 이유 없음 — 부모가 exit 한 시점에 살아있으면 원인 불문 정리 대상.
// ps 쿼리는 read_d_state_pids 와 독립 — 기존 D-state detection 건드리지 않음.
fn parse_orphan_runaway_lines(raw_out: str, pcpu_spin: int, pcpu_stuck: int, etime_gate: int) -> list {
    let lines = raw_out.split("\n")
    let result = []
    let mut i = 0
    while i < len(lines) {
        let line = lines[i].trim()
        if line != "" {
            let f = split_fields(line)
            // 기대 포맷: pid ppid pcpu etime comm
            if len(f) >= 5 {
                let pid_i = to_int(f[0])
                let ppid_i = to_int(f[1])
                let cpu_parts = f[2].split(".")
                let mut cpu_i = 0
                if len(cpu_parts) > 0 {
                    if cpu_parts[0] != "" { cpu_i = to_int(cpu_parts[0]) }
                }
                let etime_s = etime_to_seconds(f[3])
                let comm = f[4]
                // 매칭 조건: ppid==1 AND etime>=gate AND comm ~= hexa* AND (spin OR stuck)
                if ppid_i == 1 {
                    if etime_s >= etime_gate {
                        let mut sub = ""
                        if cpu_i >= pcpu_spin { sub = "spin" }
                        if sub == "" {
                            if cpu_i <= pcpu_stuck { sub = "stuck" }
                        }
                        if sub != "" {
                            let mut is_hexa = false
                            if comm == "hexa" { is_hexa = true }
                            if comm == "hexa_stage0" { is_hexa = true }
                            if comm == "hexa_v2" { is_hexa = true }
                            if comm == "hexa_real" { is_hexa = true }
                            if is_hexa {
                                if pid_i > 1 {
                                    result = result + [OrphanProc {
                                        pid: pid_i, comm: comm,
                                        pcpu: cpu_i, etime_s: etime_s, ppid: ppid_i,
                                        sub_class: sub
                                    }]
                                }
                            }
                        }
                    }
                }
            }
        }
        i = i + 1
    }
    return result
}

// 실제 ps 쿼리 — 기존 read_d_state_pids 와 완전 분리. -o 포맷 고정 순서.
// gates: spin>=90% · stuck<=5% · etime>=600s (10분).
fn read_orphan_runaways() -> list {
    let cmd = "ps -eo pid=,ppid=,pcpu=,etime=,comm= 2>/dev/null"
    let out = exec(cmd)
    if to_string(out) == "void" { return [] }
    return parse_orphan_runaway_lines(out, 90, 5, 600)
}

// D-state PID 목록 — iowait/sshfs stall 주 원인. top-CPU 리스트에는 안 잡힘 (0% CPU while stuck).
// state 컬럼이 'D' 포함(D+, Ds 등)인 userspace PID 만.
// 커널 스레드(PPID=2 및 자손)는 renice/cpulimit 대상이 아니므로 제외.
// feedback_pgrep_self_reference 회피 — pgrep -f 쓰지 않고 ps 로 전수 스캔.
fn read_d_state_pids() -> list {
    let cmd = "ps -eo pid=,ppid=,stat=,pcpu=,rss=,comm= 2>/dev/null | awk '$3 ~ /D/ && $2 != 2 && $1 != 2 && $1 > 1 {printf \"%s %s %s %s %s\\n\", $1, $4, $5, $6, $3}' | sort -k2 -n"
    let out = exec(cmd)
    let lines = out.split("\n")
    let result = []
    let mut i = 0
    while i < len(lines) {
        let line = lines[i].trim()
        if line != "" {
            let f = split_fields(line)
            if len(f) >= 4 {
                let pid_i = to_int(f[0])
                let cpu_parts = f[1].split(".")
                let mut cpu_i = 0
                if len(cpu_parts) > 0 {
                    if cpu_parts[0] != "" { cpu_i = to_int(cpu_parts[0]) }
                }
                let rss_i = to_int(f[2])
                let comm = f[3]
                if pid_i > 1 {
                    result = result + [ProcStat { pid: pid_i, comm: comm, pcpu: cpu_i, rss_kb: rss_i }]
                }
            }
        }
        i = i + 1
    }
    return result
}

struct ProcStat {
    pid: int,
    comm: str,
    pcpu: int,   // 정수부 (per-CPU %)
    rss_kb: int
}

// 상위 CPU N개. ps -eo pid,pcpu,rss,comm — 자기(hexa) 포함. PID 1(init) 제외.
fn read_top_cpu(n: int) -> list {
    let cmd = "ps -eo pid=,pcpu=,rss=,comm= --sort=-pcpu | head -" + to_string(n)
    let out = exec(cmd)
    let lines = out.split("\n")
    let result = []
    let mut i = 0
    while i < len(lines) {
        let line = lines[i].trim()
        if line != "" {
            let f = split_fields(line)
            if len(f) >= 4 {
                let pid_i = to_int(f[0])
                let cpu_parts = f[1].split(".")
                let mut cpu_i = 0
                if len(cpu_parts) > 0 {
                    if cpu_parts[0] != "" { cpu_i = to_int(cpu_parts[0]) }
                }
                let rss_i = to_int(f[2])
                let comm = f[3]
                // comm 뒤 토큰은 버림 (ps -o comm= 는 단일 필드지만 안전차원)
                if pid_i > 1 {
                    result = result + [ProcStat { pid: pid_i, comm: comm, pcpu: cpu_i, rss_kb: rss_i }]
                }
            }
        }
        i = i + 1
    }
    return result
}

// ═══════════════════════════════════════════════════════════════════════
//  THRESHOLDS — jq 1-shot 파싱 (fork 비용 < 엔진 연속가동의 재시작 위험)
// ═══════════════════════════════════════════════════════════════════════

fn jqx_f(path: str, expr: str, fallback: int) -> int {
    // float → *100 scaled int (hexa-lang float quirk 회피)
    let cmd = "jq -r '(" + expr + ") // empty' '" + path + "' 2>/dev/null"
    let raw = exec(cmd).trim()
    if raw == "" { return fallback }
    let dp = raw.split(".")
    let mut head_i = 0
    let mut frac_s = "00"
    if len(dp) > 0 {
        if dp[0] != "" { head_i = to_int(dp[0]) }
    }
    if len(dp) >= 2 { frac_s = dp[1] }
    if len(frac_s) > 2 { frac_s = frac_s_truncate2(frac_s) }
    if len(frac_s) == 1 { frac_s = frac_s + "0" }
    let mut frac_i = 0
    if frac_s != "" { frac_i = to_int(frac_s) }
    return head_i * 100 + frac_i
}

fn jqx_i(path: str, expr: str, fallback: int) -> int {
    let cmd = "jq -r '(" + expr + ") // empty' '" + path + "' 2>/dev/null"
    let raw = exec(cmd).trim()
    if raw == "" { return fallback }
    return to_int(raw)
}

struct Thresholds {
    // load 는 per-nproc *100. load1 값도 동일 스케일로 정규화해서 비교.
    load_warn_x100: int,
    load_danger_x100: int,
    load_crit_x100: int,
    // iowait / mem / d-state 는 정수.
    iowait_warn: int,
    iowait_danger: int,
    iowait_crit: int,
    mem_warn_gb: int,
    mem_danger_gb: int,
    mem_crit_gb: int,
    dstate_warn: int,
    dstate_danger: int,
    dstate_crit: int,
    pid_cpu_pct: int,
    pid_sustain_s: int
}

fn load_thresholds() -> Thresholds {
    let p = thresholds_path()
    // 파일 없으면 코드 기본값 (systemd 초기 부팅 safety)
    let exists = exec("test -f '" + p + "' && echo y || echo n").trim()
    if exists != "y" {
        return Thresholds {
            load_warn_x100: 70, load_danger_x100: 100, load_crit_x100: 150,
            iowait_warn: 10, iowait_danger: 20, iowait_crit: 35,
            mem_warn_gb: 4, mem_danger_gb: 2, mem_crit_gb: 1,
            dstate_warn: 1, dstate_danger: 2, dstate_crit: 3,
            pid_cpu_pct: 100, pid_sustain_s: 30
        }
    }
    return Thresholds {
        load_warn_x100:   jqx_f(p, ".load_per_nproc.warn",     70),
        load_danger_x100: jqx_f(p, ".load_per_nproc.danger",   100),
        load_crit_x100:   jqx_f(p, ".load_per_nproc.critical", 150),
        iowait_warn:      jqx_i(p, ".iowait_pct.warn",     10),
        iowait_danger:    jqx_i(p, ".iowait_pct.danger",   20),
        iowait_crit:      jqx_i(p, ".iowait_pct.critical", 35),
        mem_warn_gb:      jqx_i(p, ".mem_avail_gb.warn",     4),
        mem_danger_gb:    jqx_i(p, ".mem_avail_gb.danger",   2),
        mem_crit_gb:      jqx_i(p, ".mem_avail_gb.critical", 1),
        dstate_warn:      jqx_i(p, ".d_state_count.warn",     1),
        dstate_danger:    jqx_i(p, ".d_state_count.danger",   2),
        dstate_crit:      jqx_i(p, ".d_state_count.critical", 3),
        pid_cpu_pct:      jqx_i(p, ".runaway_pid.single_cpu_pct", 100),
        pid_sustain_s:    jqx_i(p, ".runaway_pid.sustain_seconds", 30)
    }
}

// ═══════════════════════════════════════════════════════════════════════
//  WHITELIST — claude 등 보호 프로세스
// ═══════════════════════════════════════════════════════════════════════

struct Whitelist {
    exact: list,
    prefix: list
}

fn load_whitelist() -> Whitelist {
    let p = whitelist_path()
    let exists = exec("test -f '" + p + "' && echo y || echo n").trim()
    if exists != "y" {
        // Narrow default — only the 4 essential names (2026-04-19).
        // dbus-daemon / containerd / polkitd / node / systemd* / kworker* 는 제거해서
        // fallback 이 실제 폭주 주체를 잡을 수 있게 함. 커널 스레드는 renice 자체 불가.
        return Whitelist {
            exact: ["claude", "tailscaled", "hexa", "hexa_stage0", "hexa_v2", "sshd"],
            prefix: []
        }
    }
    let ex_raw = exec("jq -r '.exact[]? // empty' '" + p + "' 2>/dev/null").trim()
    let pf_raw = exec("jq -r '.prefix[]? // empty' '" + p + "' 2>/dev/null").trim()
    let ex_list = []
    let pf_list = []
    if ex_raw != "" {
        let parts = ex_raw.split("\n")
        let mut i = 0
        while i < len(parts) {
            let s = parts[i].trim()
            if s != "" { ex_list = ex_list + [s] }
            i = i + 1
        }
    }
    if pf_raw != "" {
        let parts = pf_raw.split("\n")
        let mut i = 0
        while i < len(parts) {
            let s = parts[i].trim()
            if s != "" { pf_list = pf_list + [s] }
            i = i + 1
        }
    }
    return Whitelist { exact: ex_list, prefix: pf_list }
}

fn is_protected(comm: str, wl: Whitelist) -> bool {
    if comm == "" { return true }  // 알 수 없는 프로세스는 보수적 보호
    let mut i = 0
    while i < len(wl.exact) {
        if wl.exact[i] == comm { return true }
        i = i + 1
    }
    let mut j = 0
    while j < len(wl.prefix) {
        let pfx = wl.prefix[j]
        if comm.starts_with(pfx) { return true }
        j = j + 1
    }
    return false
}

// ═══════════════════════════════════════════════════════════════════════
//  VERDICT — 4단계 ok/warn/danger/critical
// ═══════════════════════════════════════════════════════════════════════

let VERDICT_OK = 0
let VERDICT_WARN = 1
let VERDICT_DANGER = 2
let VERDICT_CRITICAL = 3

fn verdict_name(v: int) -> str {
    if v == 0 { return "ok" }
    if v == 1 { return "warn" }
    if v == 2 { return "danger" }
    if v == 3 { return "critical" }
    return "unknown"
}

fn max_verdict(a: int, b: int) -> int {
    if a > b { return a }
    return b
}

struct Metrics {
    load1_x100: int,
    load5_x100: int,
    nproc: int,
    iowait_pct: int,
    mem_avail_gb: int,
    d_state: int,
    top: list,     // list of ProcStat — top-CPU
    d_pids: list   // list of ProcStat — current D-state PIDs (userspace only)
}

fn compute_verdict(m: Metrics, t: Thresholds) -> int {
    let mut v = VERDICT_OK
    // load per nproc: (load1_x100 / nproc) 을 threshold(*100, per-nproc) 와 비교.
    let nproc = m.nproc
    let mut lpn = 0
    if nproc > 0 { lpn = m.load1_x100 / nproc }
    if lpn >= t.load_crit_x100   { v = max_verdict(v, VERDICT_CRITICAL) }
    else { if lpn >= t.load_danger_x100 { v = max_verdict(v, VERDICT_DANGER) }
    else { if lpn >= t.load_warn_x100   { v = max_verdict(v, VERDICT_WARN)   } } }

    if m.iowait_pct >= t.iowait_crit   { v = max_verdict(v, VERDICT_CRITICAL) }
    else { if m.iowait_pct >= t.iowait_danger { v = max_verdict(v, VERDICT_DANGER) }
    else { if m.iowait_pct >= t.iowait_warn   { v = max_verdict(v, VERDICT_WARN)   } } }

    // memory 는 inverse (낮을수록 심각)
    if m.mem_avail_gb <= t.mem_crit_gb   { v = max_verdict(v, VERDICT_CRITICAL) }
    else { if m.mem_avail_gb <= t.mem_danger_gb { v = max_verdict(v, VERDICT_DANGER) }
    else { if m.mem_avail_gb <= t.mem_warn_gb   { v = max_verdict(v, VERDICT_WARN)   } } }

    if m.d_state >= t.dstate_crit   { v = max_verdict(v, VERDICT_CRITICAL) }
    else { if m.d_state >= t.dstate_danger { v = max_verdict(v, VERDICT_DANGER) }
    else { if m.d_state >= t.dstate_warn   { v = max_verdict(v, VERDICT_WARN)   } } }

    return v
}

// ═══════════════════════════════════════════════════════════════════════
//  SUSTAIN TRACKER — PID 별 high-CPU 지속 시간
//  구현: in-memory list 1-tick 기반 (stateful 메모리는 frozen list).
//  실제 SUSTAIN_WINDOW 판정은 ~/.airgenome/runaway_pid_seen.tsv 에 last-seen epoch 기록.
// ═══════════════════════════════════════════════════════════════════════

fn seen_path() -> str {
    return HOME + "/.airgenome/runaway_pid_seen.tsv"
}

fn ensure_home() -> void {
    let _ = exec("mkdir -p '" + HOME + "/.airgenome'")
}

// record pid's first-seen epoch if not present. Returns seconds sustained.
fn pid_sustain_seconds(pid: int, now: int) -> int {
    let path = seen_path()
    let pid_s = to_string(pid)
    // look up existing line "<pid>\t<epoch>"
    let found = exec("awk -v p=" + pid_s + " '$1==p{print $2}' '" + path + "' 2>/dev/null").trim()
    if found == "" {
        // first sighting — record
        let line = pid_s + "\t" + to_string(now)
        let _ = exec("printf '%s\\n' '" + line + "' >> '" + path + "'")
        return 0
    }
    let first = to_int(found)
    if first <= 0 { return 0 }
    return now - first
}

fn clear_pid_seen(pid: int) -> void {
    let path = seen_path()
    let pid_s = to_string(pid)
    let _ = exec("awk -v p=" + pid_s + " '$1!=p' '" + path + "' > '" + path + ".tmp' 2>/dev/null && mv '" + path + ".tmp' '" + path + "'")
}

// ═══════════════════════════════════════════════════════════════════════
//  ACTIONS — renice / cpulimit (+ dry-run)
// ═══════════════════════════════════════════════════════════════════════

fn is_dry_run() -> bool {
    return env("RUNAWAY_DRY_RUN") == "1"
}

struct Action {
    kind: str,   // "renice+10" / "renice+15" / "cpulimit50" / "cpulimit30" / "skip_protected"
    pid: int,
    comm: str,
    dry_run: bool
}

fn do_renice(pid: int, delta: int) -> void {
    let pid_s = to_string(pid)
    let d_s = to_string(delta)
    let _ = exec("renice " + d_s + " -p " + pid_s + " 2>/dev/null")
}

fn do_cpulimit(pid: int, limit_pct: int) -> void {
    // cpulimit 백그라운드 fork. 이미 붙어있으면 중복 실행 되지만 limit 값만 갱신 됨.
    let pid_s = to_string(pid)
    let l_s = to_string(limit_pct)
    // nohup + & 로 자식 분리. 출력은 /dev/null.
    let _ = exec("nohup cpulimit --limit " + l_s + " --pid " + pid_s + " >/dev/null 2>&1 &")
}

// D-state (iowait-stuck) PID 에는 ionice 가 cpulimit 보다 효과적.
// class 3 = idle — IO 슬롯이 남을 때만 진행. sshfs stall 같은 blocking 풀림.
fn do_ionice(pid: int) -> void {
    let pid_s = to_string(pid)
    let _ = exec("ionice -c 3 -p " + pid_s + " 2>/dev/null")
}

fn format_action_json(a: Action) -> str {
    let dr = "false"
    if a.dry_run { dr = "true" }
    return "{\"kind\":\"" + a.kind + "\",\"pid\":" + to_string(a.pid)
         + ",\"comm\":\"" + json_safe(a.comm) + "\",\"dry_run\":" + dr + "}"
}

fn json_safe(s: str) -> str {
    let no_bs = s.replace("\\", "")
    return no_bs.replace("\"", "")
}

// warn 단계 액션: 단일 runaway PID (CPU≥pct, sustain≥sec) 에 renice +10
// warn 은 진짜 단일-PID runaway 만 잡음 — 시스템 fallback 없음 (noise 회피).
fn actions_warn(m: Metrics, t: Thresholds, wl: Whitelist, now: int, dry: bool) -> list {
    let result = []
    let mut i = 0
    while i < len(m.top) {
        let p = m.top[i]
        if p.pcpu >= t.pid_cpu_pct {
            let sust = pid_sustain_seconds(p.pid, now)
            if sust >= t.pid_sustain_s {
                if is_protected(p.comm, wl) {
                    result = result + [Action { kind: "skip_protected", pid: p.pid, comm: p.comm, dry_run: dry }]
                } else {
                    if !dry { do_renice(p.pid, 10) }
                    result = result + [Action { kind: "renice+10", pid: p.pid, comm: p.comm, dry_run: dry }]
                }
            }
        } else {
            // CPU 떨어지면 seen 기록 제거
            clear_pid_seen(p.pid)
        }
        i = i + 1
    }
    return result
}

fn actions_danger(m: Metrics, t: Thresholds, wl: Whitelist, now: int, dry: bool) -> list {
    let result = []
    let mut hits = 0
    // ─── pass 0 — D-state (iowait-stuck) PID pick ───────────────────────
    // sshfs stall / disk hang 같은 iowait 주체는 top-CPU 리스트에 절대 안 잡힘 (0% CPU).
    // D-state PID 를 우선 겨냥 → renice+10 + ionice idle(c3) + cpulimit50.
    // whitelist 매치는 skip_protected 로 기록하고 건너뜀.
    let mut k = 0
    while k < len(m.d_pids) {
        if hits >= 3 { k = len(m.d_pids) }
        else {
            let p = m.d_pids[k]
            if is_protected(p.comm, wl) {
                result = result + [Action { kind: "skip_protected", pid: p.pid, comm: p.comm, dry_run: dry }]
            } else {
                if !dry {
                    do_renice(p.pid, 10)
                    do_ionice(p.pid)
                    do_cpulimit(p.pid, 50)
                }
                result = result + [Action { kind: "renice+10",  pid: p.pid, comm: p.comm, dry_run: dry }]
                result = result + [Action { kind: "ionice_idle", pid: p.pid, comm: p.comm, dry_run: dry }]
                result = result + [Action { kind: "cpulimit50", pid: p.pid, comm: p.comm, dry_run: dry }]
                hits = hits + 1
            }
            k = k + 1
        }
    }
    // ─── pass 1 — per-PID trigger (single-core runaway) ─────────────────
    // threshold is pid_cpu_pct/2 in danger (100% 기준이면 멀티코어 12-box에서
    // 시스템 압력 있어도 per-PID 절대 안 걸림.)
    let pid_gate = t.pid_cpu_pct / 2
    let mut i = 0
    while i < len(m.top) {
        let p = m.top[i]
        if p.pcpu >= pid_gate {
            let sust = pid_sustain_seconds(p.pid, now)
            if sust >= t.pid_sustain_s {
                if is_protected(p.comm, wl) {
                    result = result + [Action { kind: "skip_protected", pid: p.pid, comm: p.comm, dry_run: dry }]
                } else {
                    if !dry {
                        do_renice(p.pid, 10)
                        do_cpulimit(p.pid, 50)
                    }
                    result = result + [Action { kind: "renice+10", pid: p.pid, comm: p.comm, dry_run: dry }]
                    result = result + [Action { kind: "cpulimit50", pid: p.pid, comm: p.comm, dry_run: dry }]
                    hits = hits + 1
                }
            }
        }
        i = i + 1
    }
    // ─── pass 2 — systemic fallback (top-3 non-protected) ───────────────
    // D-state/per-PID 모두 hit 없으면 system 압력 원인 미상 → top-3 에 gentler.
    if hits == 0 {
        let mut j = 0
        let mut fb = 0
        while j < len(m.top) {
            if fb >= 3 { j = len(m.top) }
            else {
                let p = m.top[j]
                if is_protected(p.comm, wl) {
                    result = result + [Action { kind: "skip_protected", pid: p.pid, comm: p.comm, dry_run: dry }]
                } else {
                    if !dry {
                        do_renice(p.pid, 10)
                        do_cpulimit(p.pid, 50)
                    }
                    result = result + [Action { kind: "renice+10", pid: p.pid, comm: p.comm, dry_run: dry }]
                    result = result + [Action { kind: "cpulimit50", pid: p.pid, comm: p.comm, dry_run: dry }]
                    fb = fb + 1
                }
                j = j + 1
            }
        }
    }
    return result
}

fn actions_critical(m: Metrics, wl: Whitelist, dry: bool) -> list {
    let result = []
    // 상위 3개 — claude 등 제외. sustain 무시 (이미 임계초과)
    let mut i = 0
    let mut hit = 0
    while i < len(m.top) {
        if hit >= 3 { i = len(m.top) }
        else {
            let p = m.top[i]
            if is_protected(p.comm, wl) {
                result = result + [Action { kind: "skip_protected", pid: p.pid, comm: p.comm, dry_run: dry }]
            } else {
                if !dry {
                    do_renice(p.pid, 15)
                    do_cpulimit(p.pid, 30)
                }
                result = result + [Action { kind: "renice+15", pid: p.pid, comm: p.comm, dry_run: dry }]
                result = result + [Action { kind: "cpulimit30", pid: p.pid, comm: p.comm, dry_run: dry }]
                hit = hit + 1
            }
            i = i + 1
        }
    }
    return result
}

fn collect_actions(v: int, m: Metrics, t: Thresholds, wl: Whitelist, now: int) -> list {
    let dry = is_dry_run()
    if v == VERDICT_OK { return [] }
    if v == VERDICT_WARN { return actions_warn(m, t, wl, now, dry) }
    if v == VERDICT_DANGER { return actions_danger(m, t, wl, now, dry) }
    if v == VERDICT_CRITICAL { return actions_critical(m, wl, dry) }
    return []
}

// ═══════════════════════════════════════════════════════════════════════
//  LOG — JSONL append
// ═══════════════════════════════════════════════════════════════════════

fn format_top_json(top: list) -> str {
    let mut out = "["
    let mut i = 0
    while i < len(top) {
        if i > 0 { out = out + "," }
        let p = top[i]
        out = out + "{\"pid\":" + to_string(p.pid)
            + ",\"comm\":\"" + json_safe(p.comm) + "\""
            + ",\"pcpu\":" + to_string(p.pcpu)
            + ",\"rss_kb\":" + to_string(p.rss_kb) + "}"
        i = i + 1
    }
    return out + "]"
}

fn format_actions_json(actions: list) -> str {
    let mut out = "["
    let mut i = 0
    while i < len(actions) {
        if i > 0 { out = out + "," }
        out = out + format_action_json(actions[i])
        i = i + 1
    }
    return out + "]"
}

fn format_event(ts: str, m: Metrics, v: int, actions: list) -> str {
    let lpn_x100 = 0
    if m.nproc > 0 { lpn_x100 = m.load1_x100 / m.nproc }
    return "{\"ts\":\"" + ts + "\""
         + ",\"source\":\"runaway_guard\""
         + ",\"verdict\":\"" + verdict_name(v) + "\""
         + ",\"metrics\":{"
         +   "\"load1_x100\":" + to_string(m.load1_x100)
         + ",\"load5_x100\":" + to_string(m.load5_x100)
         + ",\"nproc\":" + to_string(m.nproc)
         + ",\"load_per_nproc_x100\":" + to_string(lpn_x100)
         + ",\"iowait_pct\":" + to_string(m.iowait_pct)
         + ",\"mem_avail_gb\":" + to_string(m.mem_avail_gb)
         + ",\"d_state\":" + to_string(m.d_state)
         + ",\"top\":" + format_top_json(m.top)
         + ",\"d_pids\":" + format_top_json(m.d_pids)
         + "}"
         + ",\"actions\":" + format_actions_json(actions)
         + ",\"dry_run\":" + bool_str(is_dry_run())
         + "}"
}

fn bool_str(b: bool) -> str {
    if b { return "true" }
    return "false"
}

fn append_log(line: str) -> void {
    ensure_home()
    // exec quoting 안전 — printf + heredoc 회피 (단일 라인 JSON)
    let tmp = LOG_PATH + ".tmp." + to_string(ts_epoch())
    let _ = write_file(tmp, line + "\n")
    let _ = exec("cat '" + tmp + "' >> '" + LOG_PATH + "' && rm -f '" + tmp + "'")
}

// ═══════════════════════════════════════════════════════════════════════
//  TELEGRAM PUSH — verdict=critical 전용 alert
// ═══════════════════════════════════════════════════════════════════════
//
// 설계 (본 파일 상단 M14 → M15 extension):
//   1. verdict=critical 시에만 발사. warn/danger/ok 는 skip (spam 회피).
//   2. rate limit — ~/.airgenome/tg_last_critical.json 에 마지막 push epoch 기록.
//      같은 host 는 TG_RATE_WINDOW (기본 300s) 내 중복이면 skip.
//   3. token 조회 우선순위:
//        env TG_BOT_TOKEN_FILE          (명시 override)
//        $HOME/Dev/secret/tg_bot_token  (Mac 직경로 / ubu1·ubu2 sshfs 동일 경로)
//        /Users/ghost/Dev/secret/tg_bot_token  (Users 심볼릭 fallback)
//      없으면 WARN 로그만 남기고 skip.
//   4. chat_id 조회 우선순위:
//        env TG_CHAT_ID
//        $HOME/.airgenome/tg.json .whitelist[0]
//        /Users/ghost/.airgenome/tg.json .whitelist[0]
//      없으면 WARN 로그만 남기고 skip.
//   5. curl timeout 3s (blocking 방지). 실패는 stderr 로 journalctl 에만 남김.
//   6. RUNAWAY_DRY_RUN=1 환경에선 실제 POST 안 보내고 dry 라인만 log.
//   7. TG_FORCE_CRITICAL=1 환경 flag — 테스트용, verdict 무시하고 notify_telegram 호출.

fn tg_rate_window_s() -> int {
    let s = env("TG_RATE_WINDOW").trim()
    if s == "" { return 300 }
    let n = to_int(s)
    if n <= 0 { return 300 }
    return n
}

fn tg_last_critical_path() -> str {
    return HOME + "/.airgenome/tg_last_critical.json"
}

// token 경로 resolve — 발견 시 파일 path 반환, 없으면 "" .
fn tg_token_path() -> str {
    let override_p = env("TG_BOT_TOKEN_FILE").trim()
    if override_p != "" {
        let e = exec("test -f '" + override_p + "' && echo y || echo n").trim()
        if e == "y" { return override_p }
    }
    let home_p = HOME + "/Dev/secret/tg_bot_token"
    let e1 = exec("test -f '" + home_p + "' && echo y || echo n").trim()
    if e1 == "y" { return home_p }
    let mac_p = "/Users/ghost/Dev/secret/tg_bot_token"
    let e2 = exec("test -f '" + mac_p + "' && echo y || echo n").trim()
    if e2 == "y" { return mac_p }
    return ""
}

fn tg_read_token() -> str {
    let p = tg_token_path()
    if p == "" { return "" }
    let raw = exec("cat '" + p + "' 2>/dev/null").trim()
    if to_string(raw) == "void" { return "" }
    return raw
}

fn tg_chat_id() -> str {
    let env_id = env("TG_CHAT_ID").trim()
    if env_id != "" { return env_id }
    let cfg_home = HOME + "/.airgenome/tg.json"
    let e1 = exec("test -f '" + cfg_home + "' && echo y || echo n").trim()
    if e1 == "y" {
        let cid = exec("jq -r '.whitelist[0]? // empty' '" + cfg_home + "' 2>/dev/null").trim()
        if cid != "" { return cid }
    }
    let cfg_mac = "/Users/ghost/.airgenome/tg.json"
    let e2 = exec("test -f '" + cfg_mac + "' && echo y || echo n").trim()
    if e2 == "y" {
        let cid = exec("jq -r '.whitelist[0]? // empty' '" + cfg_mac + "' 2>/dev/null").trim()
        if cid != "" { return cid }
    }
    return ""
}

// rate-limit 판정: 마지막 push epoch 과 now 의 차이가 window 미만이면 true.
// 파일은 JSON {"<host>": <epoch>, ...} 형태. jq 로 읽기.
fn tg_rate_limited(host: str, now: int, window: int) -> bool {
    let p = tg_last_critical_path()
    let e = exec("test -f '" + p + "' && echo y || echo n").trim()
    if e != "y" { return false }
    let last_s = exec("jq -r '.[\"" + host + "\"]? // empty' '" + p + "' 2>/dev/null").trim()
    if last_s == "" { return false }
    let last = to_int(last_s)
    if last <= 0 { return false }
    let delta = now - last
    if delta < window { return true }
    return false
}

fn tg_record_push(host: str, now: int) -> void {
    ensure_home()
    let p = tg_last_critical_path()
    // jq idempotent update — file 없으면 {} 로 시작.
    let e = exec("test -f '" + p + "' && echo y || echo n").trim()
    if e != "y" {
        let _ = exec("printf '{}' > '" + p + "'")
    }
    let tmp = p + ".tmp." + to_string(now)
    let cmd = "jq --arg h '" + host + "' --argjson t " + to_string(now)
            + " '.[$h]=$t' '" + p + "' > '" + tmp + "' 2>/dev/null && mv '" + tmp + "' '" + p + "'"
    let _ = exec(cmd)
}

// telegram 메시지 본문 작성 — 간결. 플레인 텍스트 (MarkdownV2 escape 회피).
fn tg_format_message(host: str, ts: str, v: int, m: Metrics) -> str {
    let lpn_x100 = 0
    if m.nproc > 0 { lpn_x100 = m.load1_x100 / m.nproc }
    // top 3 PID comm 요약
    let mut top_s = ""
    let mut i = 0
    let mut shown = 0
    while i < len(m.top) {
        if shown >= 3 { i = len(m.top) }
        else {
            let p = m.top[i]
            if p.pid > 1 {
                if shown > 0 { top_s = top_s + ", " }
                top_s = top_s + p.comm + "(" + to_string(p.pid) + "," + to_string(p.pcpu) + "%)"
                shown = shown + 1
            }
            i = i + 1
        }
    }
    if top_s == "" { top_s = "(none)" }
    // load per-nproc 포맷: x100 → "1.23"
    let lpn_int = lpn_x100 / 100
    let lpn_frac = lpn_x100 - lpn_int * 100
    let mut frac_s = to_string(lpn_frac)
    if lpn_frac < 10 { frac_s = "0" + frac_s }
    let mut msg = "🚨 RUNAWAY CRITICAL [" + host + "]\n"
    msg = msg + "ts: " + ts + "\n"
    msg = msg + "verdict: " + verdict_name(v) + "\n"
    msg = msg + "load/nproc: " + to_string(lpn_int) + "." + frac_s
    msg = msg + " (load1=" + to_string(m.load1_x100 / 100) + ", nproc=" + to_string(m.nproc) + ")\n"
    msg = msg + "iowait: " + to_string(m.iowait_pct) + "%, d_state: " + to_string(m.d_state)
    msg = msg + ", mem: " + to_string(m.mem_avail_gb) + "GB\n"
    msg = msg + "top3: " + top_s
    return msg
}

fn tg_host_label() -> str {
    let h = exec("hostname -s 2>/dev/null || hostname 2>/dev/null").trim()
    if to_string(h) == "void" { return "unknown" }
    if h == "" { return "unknown" }
    return h
}

// 실제 telegram POST — curl. timeout 3s. 실패 = silent (stderr 만 journal 로).
fn tg_send(token: str, chat_id: str, text: str) -> bool {
    // text 를 tempfile 로 써서 --data-urlencode text@file 전달.
    let tmp = HOME + "/.airgenome/.tg_crit." + to_string(ts_epoch()) + ".$$"
    let _ = exec("mkdir -p '" + HOME + "/.airgenome'")
    let _ = write_file(tmp, text)
    let url = "https://api.telegram.org/bot" + token + "/sendMessage"
    let cmd = "curl -sS --max-time 3 -X POST '" + url + "'"
            + " --data-urlencode 'chat_id=" + chat_id + "'"
            + " --data-urlencode 'text@" + tmp + "'"
            + " 2>&1; rm -f '" + tmp + "'"
    let out = exec(cmd)
    if to_string(out) == "void" { return false }
    if out.contains("\"ok\":true") { return true }
    // failure — journal 로 흔적 남김 (stderr; systemd 가 journalctl 로 수집)
    println("{\"source\":\"runaway_guard\",\"tg_push\":\"fail\",\"resp\":\"" + json_safe(out) + "\"}")
    return false
}

// 메인 진입점 — verdict=critical 시 tick() 에서 호출.
fn notify_telegram(host: str, ts: str, v: int, m: Metrics, now: int) -> void {
    let window = tg_rate_window_s()
    if tg_rate_limited(host, now, window) {
        println("{\"source\":\"runaway_guard\",\"tg_push\":\"rate_limited\",\"host\":\"" + host + "\"}")
        return
    }
    let token = tg_read_token()
    if token == "" {
        println("{\"source\":\"runaway_guard\",\"tg_push\":\"no_token\",\"host\":\"" + host + "\"}")
        return
    }
    let chat_id = tg_chat_id()
    if chat_id == "" {
        println("{\"source\":\"runaway_guard\",\"tg_push\":\"no_chat_id\",\"host\":\"" + host + "\"}")
        return
    }
    let msg = tg_format_message(host, ts, v, m)
    if is_dry_run() {
        println("{\"source\":\"runaway_guard\",\"tg_push\":\"dry\",\"host\":\"" + host + "\",\"len\":" + to_string(len(msg)) + "}")
        // dry 에서도 rate-limit 기록해서 반복 dry-push 방지
        tg_record_push(host, now)
        return
    }
    let ok = tg_send(token, chat_id, msg)
    if ok {
        tg_record_push(host, now)
        println("{\"source\":\"runaway_guard\",\"tg_push\":\"ok\",\"host\":\"" + host + "\"}")
    }
    // ok=false 인 경우 tg_send 가 이미 fail 로그 찍음 — rate-record 는 skip (재시도 가능).
}

// ═══════════════════════════════════════════════════════════════════════
//  ORPHAN RUNAWAY — whitelist override 규칙
//  조건: ppid==1 AND pcpu>=90 AND etime>=600s AND comm ~= hexa*
//  action: SIGTERM (force 모드일 때만). KILL 에스컬레이션 X.
//  dry-run 기본 — RUNAWAY_GUARD_ORPHAN_FORCE=1 또는 기존 force 플래그 시 TERM.
// ═══════════════════════════════════════════════════════════════════════

fn is_orphan_force() -> bool {
    if env("RUNAWAY_GUARD_ORPHAN_FORCE") == "1" { return true }
    // 기존 force 플래그 재사용 — dry-run 이 아니면 force 간주 X. 명시 env 만 수락.
    return false
}

fn do_sigterm(pid: int) -> void {
    let pid_s = to_string(pid)
    let _ = exec("kill -TERM " + pid_s + " 2>/dev/null")
}

fn pid_still_alive(pid: int) -> bool {
    let pid_s = to_string(pid)
    let r = exec("kill -0 " + pid_s + " 2>/dev/null && echo y || echo n").trim()
    if r == "y" { return true }
    return false
}

struct OrphanAction {
    kind: str,       // "orphan_term" / "orphan_dry" / "orphan_survived"
    pid: int,
    comm: str,
    etime_s: int,
    pcpu: int,
    dry_run: bool
}

fn format_orphan_action_json(a: OrphanAction) -> str {
    let dr = "false"
    if a.dry_run { dr = "true" }
    return "{\"kind\":\"" + a.kind + "\",\"pid\":" + to_string(a.pid)
         + ",\"comm\":\"" + json_safe(a.comm) + "\""
         + ",\"etime_s\":" + to_string(a.etime_s)
         + ",\"pcpu\":" + to_string(a.pcpu)
         + ",\"dry_run\":" + dr + "}"
}

fn format_orphan_actions_json(actions: list) -> str {
    let mut out = "["
    let mut i = 0
    while i < len(actions) {
        if i > 0 { out = out + "," }
        out = out + format_orphan_action_json(actions[i])
        i = i + 1
    }
    return out + "]"
}

fn format_orphans_json(orphans: list) -> str {
    let mut out = "["
    let mut i = 0
    while i < len(orphans) {
        if i > 0 { out = out + "," }
        let p = orphans[i]
        out = out + "{\"pid\":" + to_string(p.pid)
            + ",\"comm\":\"" + json_safe(p.comm) + "\""
            + ",\"ppid\":" + to_string(p.ppid)
            + ",\"pcpu\":" + to_string(p.pcpu)
            + ",\"etime_s\":" + to_string(p.etime_s)
            + ",\"sub_class\":\"" + json_safe(p.sub_class) + "\"}"
        i = i + 1
    }
    return out + "]"
}

// 고아 처리 — whitelist override (고아는 정상일 수 없음).
// force=false 인 경우 전부 dry 로 기록만. survived 체크는 force 경로에서만.
fn act_on_orphans(orphans: list, force: bool) -> list {
    let result = []
    let mut i = 0
    while i < len(orphans) {
        let p = orphans[i]
        if force {
            do_sigterm(p.pid)
            result = result + [OrphanAction {
                kind: "orphan_term", pid: p.pid, comm: p.comm,
                etime_s: p.etime_s, pcpu: p.pcpu, dry_run: false
            }]
        } else {
            result = result + [OrphanAction {
                kind: "orphan_dry", pid: p.pid, comm: p.comm,
                etime_s: p.etime_s, pcpu: p.pcpu, dry_run: true
            }]
        }
        i = i + 1
    }
    // force 경로: 5s 후 잔존 PID 만 report (KILL 에스컬레이션 X)
    if force {
        if len(orphans) > 0 {
            let _ = exec("sleep 5")
            let mut j = 0
            while j < len(orphans) {
                let p = orphans[j]
                if pid_still_alive(p.pid) {
                    result = result + [OrphanAction {
                        kind: "orphan_survived", pid: p.pid, comm: p.comm,
                        etime_s: p.etime_s, pcpu: p.pcpu, dry_run: false
                    }]
                }
                j = j + 1
            }
        }
    }
    return result
}

fn format_orphan_event(ts: str, orphans: list, actions: list, force: bool) -> str {
    return "{\"ts\":\"" + ts + "\""
         + ",\"source\":\"runaway_guard\""
         + ",\"verdict\":\"orphan_runaway\""
         + ",\"orphans\":" + format_orphans_json(orphans)
         + ",\"actions\":" + format_orphan_actions_json(actions)
         + ",\"force\":" + bool_str(force)
         + ",\"dry_run\":" + bool_str(!force)
         + "}"
}

// ═══════════════════════════════════════════════════════════════════════
//  TICK
// ═══════════════════════════════════════════════════════════════════════

fn collect_metrics() -> Metrics {
    // sequential 로 — /proc 읽기 자체는 μs. iowait 측정 안 1s sleep 만 유의미.
    let load1 = read_load_x100(0)
    let load5 = read_load_x100(1)
    let nproc = read_nproc()
    let iowait = read_iowait_pct()
    let mem = read_mem_avail_gb()
    let dst = read_d_state_count()
    let top = read_top_cpu(10)
    let d_pids = read_d_state_pids()
    return Metrics {
        load1_x100: load1,
        load5_x100: load5,
        nproc: nproc,
        iowait_pct: iowait,
        mem_avail_gb: mem,
        d_state: dst,
        top: top,
        d_pids: d_pids
    }
}

fn tick(t: Thresholds, wl: Whitelist) -> void {
    let ts = ts_iso()
    let now = ts_epoch()

    // ─── ORPHAN RUNAWAY pass — 기존 verdict 파이프라인과 독립 ────────────
    // whitelist override: hexa* 고아(ppid=1 + CPU≥90% + etime≥600s)는 절대 정상 X.
    // hetzner 사건 (27h×10건 축적) 재발 방지. dry-run 기본, FORCE env 만 TERM.
    let orphans = read_orphan_runaways()
    if len(orphans) > 0 {
        let force = is_orphan_force()
        let oacts = act_on_orphans(orphans, force)
        let oline = format_orphan_event(ts, orphans, oacts, force)
        append_log(oline)
        println(oline)
    }

    let m = collect_metrics()
    let v = compute_verdict(m, t)
    let actions = collect_actions(v, m, t, wl, now)
    let line = format_event(ts, m, v, actions)
    append_log(line)
    // stdout 에도 한 줄 (systemd journal 용이성)
    println(line)
    // Telegram push 비활성화 (2026-04-20) — tg_bot 은 iOS→claude dispatch 전용.
    // runaway 는 로그/journal 로만 관측, 선알림 spam 방지. 테스트 시 TG_FORCE_CRITICAL=1.
    if env("TG_FORCE_CRITICAL") == "1" {
        let host = tg_host_label()
        notify_telegram(host, ts, VERDICT_CRITICAL, m, now)
    }
}

// ═══════════════════════════════════════════════════════════════════════
//  SELF / TEST / MAIN
// ═══════════════════════════════════════════════════════════════════════

fn self_test() -> void {
    // 1. whitelist protection — narrowed 2026-04-19
    let wl = load_whitelist()
    if !is_protected("claude", wl) { panic("self_test FAIL [claude not protected]") }
    if !is_protected("hexa", wl) { panic("self_test FAIL [hexa not protected]") }
    if !is_protected("sshd", wl) { panic("self_test FAIL [sshd not protected]") }
    if !is_protected("tailscaled", wl) { panic("self_test FAIL [tailscaled not protected]") }
    // These were previously protected but must NOT be anymore (narrow list).
    if is_protected("python3", wl) { panic("self_test FAIL [python3 should NOT be protected]") }
    if is_protected("dbus-daemon", wl) { panic("self_test FAIL [dbus-daemon must be actionable now]") }
    if is_protected("containerd", wl) { panic("self_test FAIL [containerd must be actionable now]") }
    if is_protected("polkitd", wl) { panic("self_test FAIL [polkitd must be actionable now]") }
    if is_protected("node", wl) { panic("self_test FAIL [node must be actionable now]") }
    if is_protected("systemd-logind", wl) { panic("self_test FAIL [systemd* must be actionable now — prefix removed]") }

    // 2. thresholds load
    let t = load_thresholds()
    if t.load_crit_x100 <= t.load_danger_x100 { panic("self_test FAIL [load order]") }
    if t.iowait_crit <= t.iowait_danger { panic("self_test FAIL [iowait order]") }
    if t.mem_crit_gb >= t.mem_warn_gb { panic("self_test FAIL [mem order inverse]") }

    // 3. verdict compute — synthetic metrics
    let ok_m = Metrics { load1_x100: 50, load5_x100: 50, nproc: 8,
                         iowait_pct: 2, mem_avail_gb: 16, d_state: 0, top: [], d_pids: [] }
    let ok_v = compute_verdict(ok_m, t)
    if ok_v != VERDICT_OK { panic("self_test FAIL [ok verdict got " + to_string(ok_v) + "]") }

    let crit_m = Metrics { load1_x100: 1600, load5_x100: 1200, nproc: 8,
                           iowait_pct: 40, mem_avail_gb: 0, d_state: 5, top: [], d_pids: [] }
    let crit_v = compute_verdict(crit_m, t)
    if crit_v != VERDICT_CRITICAL { panic("self_test FAIL [critical verdict got " + to_string(crit_v) + "]") }

    // 4. verdict_name
    if verdict_name(0) != "ok" { panic("self_test FAIL [verdict_name ok]") }
    if verdict_name(3) != "critical" { panic("self_test FAIL [verdict_name critical]") }

    // 5. JSON safety
    if json_safe("a\"b\\c") != "abc" { panic("self_test FAIL [json_safe]") }

    // 6. D-state pick — synthetic d_pids 에 sshfs 1건 넣고 actions_danger 호출.
    //    pass 0 가 발동해서 renice+10 / ionice_idle / cpulimit50 3건 emit 해야 함.
    let fake_d = [
        ProcStat { pid: 99999, comm: "sshfs", pcpu: 0, rss_kb: 1024 }
    ]
    let fake_top = [
        ProcStat { pid: 99998, comm: "claude",   pcpu: 0, rss_kb: 2048 }
    ]
    let danger_m = Metrics {
        load1_x100: 100, load5_x100: 100, nproc: 8,
        iowait_pct: 25, mem_avail_gb: 8, d_state: 1,
        top: fake_top, d_pids: fake_d
    }
    let dv = compute_verdict(danger_m, t)
    if dv < VERDICT_DANGER { panic("self_test FAIL [danger synth got " + to_string(dv) + "]") }
    // dry run — 실제 renice/cpulimit 발사 없이 action list 만 확인.
    let acts = actions_danger(danger_m, t, wl, ts_epoch(), true)
    let mut saw_ionice = false
    let mut saw_sshfs_renice = false
    let mut saw_claude_skip = false
    let mut ai = 0
    while ai < len(acts) {
        let a = acts[ai]
        if a.kind == "ionice_idle" { saw_ionice = true }
        if a.kind == "renice+10" {
            if a.comm == "sshfs" { saw_sshfs_renice = true }
        }
        if a.kind == "skip_protected" {
            if a.comm == "claude" { saw_claude_skip = true }
        }
        ai = ai + 1
    }
    if !saw_ionice { panic("self_test FAIL [D-state pick did not emit ionice_idle]") }
    if !saw_sshfs_renice { panic("self_test FAIL [D-state pick did not renice sshfs]") }
    if !saw_claude_skip {
        // claude 는 top-CPU 0% 에 있어 pass1 gate 에 안 걸려 skip 도 없음.
        // 대신 whitelist 보호 경로만 확인 (is_protected) — 위에서 이미 검증됨.
    }

    // 7. D-state PID scan — 실제 호출 가능 확인 (Linux 한정 — Mac 은 skip).
    let uname_s = exec("uname -s 2>/dev/null").trim()
    if uname_s == "Linux" {
        let _dps = read_d_state_pids()
        // 빈 리스트도 OK — D-state PID 이 없으면 정상.
    }

    // 8. telegram rate-limit logic — 새 push 후 즉시 재호출은 rate-limited.
    let host_t = "self_test_host_" + to_string(ts_epoch())
    let now_t = ts_epoch()
    // 첫 호출: 기록 없음 → false
    if tg_rate_limited(host_t, now_t, 300) { panic("self_test FAIL [rate_limited false positive]") }
    tg_record_push(host_t, now_t)
    // 기록 후 즉시 재호출: true
    if !tg_rate_limited(host_t, now_t, 300) { panic("self_test FAIL [rate_limited should suppress]") }
    // window 밖 (now + 301): false
    if tg_rate_limited(host_t, now_t + 301, 300) { panic("self_test FAIL [rate_limited window expiry]") }

    // 9. message format — host/verdict 포함 확인.
    let fake_m = Metrics { load1_x100: 250, load5_x100: 200, nproc: 8,
                           iowait_pct: 42, mem_avail_gb: 0, d_state: 5,
                           top: [ProcStat { pid: 9999, comm: "stress-ng", pcpu: 98, rss_kb: 10240 }],
                           d_pids: [] }
    let m_msg = tg_format_message("test-host", "2026-04-19T12:00:00Z", VERDICT_CRITICAL, fake_m)
    if !m_msg.contains("RUNAWAY CRITICAL") { panic("self_test FAIL [tg msg missing RUNAWAY CRITICAL]") }
    if !m_msg.contains("test-host") { panic("self_test FAIL [tg msg missing host]") }
    if !m_msg.contains("stress-ng") { panic("self_test FAIL [tg msg missing top]") }

    // 10. token path resolve — 파일 없으면 "" (Linux prod 환경에서 Mac secret 없을 수 있음 — 허용).
    let _tp = tg_token_path()   // 결과 무관, 호출 자체가 성공이면 OK.

    // 11. orphan_runaway detection — mock ps lines (spin+stuck 2 class)
    //     포맷: "pid ppid pcpu etime comm"
    //     MATCH:
    //       - hexa ppid=1 pcpu=99 etime=27h12m       → spin  (hetzner 27h)
    //       - hexa_stage0 ppid=1 pcpu=100 etime=10m  → spin  (경계값 etime=600s)
    //       - hexa_real ppid=1 pcpu=92 etime=15m     → spin
    //       - hexa_stage0 ppid=1 pcpu=0 etime=34m    → stuck (Mac lock-holder 사례)
    //     REJECT:
    //       - hexa ppid=1234 (부모 생존)  → ppid gate
    //       - hexa ppid=1 pcpu=95 etime=5m → etime gate
    //       - sshd ppid=1 pcpu=99 etime=10h → comm gate
    //       - hexa ppid=1 pcpu=50 etime=20h → 중간 CPU (spin 도 stuck 도 아님)
    let mock_ps = "99901 1 99.8 27:12:34 hexa\n"
                + "99902 1 100 10:00 hexa_stage0\n"
                + "99903 1234 99 12:00:00 hexa\n"
                + "99904 1 50.0 20:00:00 hexa\n"
                + "99905 1 95 05:00 hexa\n"
                + "99906 1 99 10:00:00 sshd\n"
                + "99907 1 92 15:00 hexa_real\n"
                + "99908 1 0.0 34:00 hexa_stage0"
    let orph = parse_orphan_runaway_lines(mock_ps, 90, 5, 600)
    if len(orph) != 4 {
        panic("self_test FAIL [orphan pick count got " + to_string(len(orph)) + " want 4]")
    }
    // 첫 매치: hexa pid=99901, etime≥97954s (27h12m34s), sub_class=spin
    let o0 = orph[0]
    if o0.pid != 99901 { panic("self_test FAIL [orphan[0] pid]") }
    if o0.comm != "hexa" { panic("self_test FAIL [orphan[0] comm]") }
    if o0.ppid != 1 { panic("self_test FAIL [orphan[0] ppid]") }
    if o0.etime_s < 97000 { panic("self_test FAIL [orphan[0] etime too small]") }
    if o0.sub_class != "spin" { panic("self_test FAIL [orphan[0] sub_class got " + o0.sub_class + " want spin]") }
    // stuck class 도 하나 포함됐는지 확인 (pid=99908, sub_class=stuck)
    let mut saw_stuck = false
    let mut saw_spin = false
    let mut k_s = 0
    while k_s < len(orph) {
        if orph[k_s].sub_class == "stuck" { saw_stuck = true }
        if orph[k_s].sub_class == "spin"  { saw_spin = true }
        k_s = k_s + 1
    }
    if !saw_stuck { panic("self_test FAIL [no stuck-class orphan picked]") }
    if !saw_spin  { panic("self_test FAIL [no spin-class orphan picked]") }
    // dry action emission
    let oacts_dry = act_on_orphans(orph, false)
    if len(oacts_dry) != 4 { panic("self_test FAIL [dry orphan actions count]") }
    let mut saw_dry = false
    let mut k = 0
    while k < len(oacts_dry) {
        if oacts_dry[k].kind == "orphan_dry" { saw_dry = true }
        k = k + 1
    }
    if !saw_dry { panic("self_test FAIL [no orphan_dry kind]") }
    // event JSON contains verdict=orphan_runaway
    let oline = format_orphan_event("2026-04-20T00:00:00Z", orph, oacts_dry, false)
    if !oline.contains("\"verdict\":\"orphan_runaway\"") {
        panic("self_test FAIL [orphan event missing verdict]")
    }
    if !oline.contains("\"dry_run\":true") { panic("self_test FAIL [orphan dry_run flag]") }
    // etime parser boundary
    if etime_to_seconds("600") != 600 { panic("self_test FAIL [etime SS]") }
    if etime_to_seconds("10:00") != 600 { panic("self_test FAIL [etime MM:SS]") }
    if etime_to_seconds("1:00:00") != 3600 { panic("self_test FAIL [etime HH:MM:SS]") }
    if etime_to_seconds("1-00:00:00") != 86400 { panic("self_test FAIL [etime DD-HH:MM:SS]") }
    // empty mock → no orphans
    let orph_empty = parse_orphan_runaway_lines("", 90, 5, 600)
    if len(orph_empty) != 0 { panic("self_test FAIL [empty mock] ") }

    // 12. 마지막 self-test host 기록 정리 (누적 방지)
    let p_cleanup = tg_last_critical_path()
    let _ = exec("jq --arg h '" + host_t + "' 'del(.[$h])' '" + p_cleanup + "' > '" + p_cleanup + ".tmp' 2>/dev/null && mv '" + p_cleanup + ".tmp' '" + p_cleanup + "'")

    println("  ✅ runaway_guard self_test PASS (whitelist narrowed + D-state pick + ionice + tg_push + orphan_runaway)")
}

fn run_once() -> void {
    let t = load_thresholds()
    let wl = load_whitelist()
    tick(t, wl)
}

fn run_loop() -> void {
    let t = load_thresholds()
    let wl = load_whitelist()
    while true {
        tick(t, wl)
        let _ = exec("sleep " + to_string(SLEEP_SECONDS))
    }
}

fn main() -> void {
    let a = args()
    // hexa `args()` layout 은 호출 방식에 따라 달라짐 — 안전하게 전 슬롯 스캔.
    let mut sub = ""
    let mut ai = 0
    while ai < len(a) {
        let av = a[ai]
        if av == "self-test" { sub = "self-test" }
        if av == "run-once" { sub = "run-once" }
        ai = ai + 1
    }

    if sub == "self-test" { self_test(); return }
    if sub == "run-once" { run_once(); return }

    // env flags
    if env("RUNAWAY_TEST") == "1" { run_once(); return }
    if env("RUNAWAY_SELF_TEST") == "1" { self_test(); return }

    run_loop()
}

main()
