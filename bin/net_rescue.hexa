// bin/net_rescue.hexa — Tier 2 network-change stuck claude 자동 리스큐.
//
// 트리거: macOS LaunchEvents (com.apple.system.config.network_change notify).
//         com.airgenome.net-rescue.plist 가 매 change event 마다 본 스크립트
//         를 한 번 실행. 실행 빈도는 macOS 가 이벤트 coalesce 하므로 낮음.
//
// 로직:
//   1. Opt-in 게이트: ~/.airgenome/auto_rescue 파일 없으면 이벤트만 로깅 후 종료.
//   2. Transient flutter 필터: ping 1.1.1.1 을 3s 간격으로 3회. 첫 번째 또는
//      두 번째 시도에서 성공하면 "transient" (설정 변경 뿐, 실제 outage 아님)
//      → 종료.
//   3. 3번 연속 ping 실패 → 실제 outage 판정. 네트워크 복귀 대기 (최대 60s).
//   4. 복귀 확인 후 내 소유 모든 claude/claude.real 에 SIGTERM.
//      5s grace 후 여전히 살아있으면 SIGKILL.
//   5. JSONL 로그 남김.
//
// 안전장치:
//   - opt-in 기본 off (파일 존재로만 활성)
//   - transient 필터로 wifi 재연결 같은 보통 상황 보호
//   - SIGTERM 우선, grace 후에만 KILL
//   - uid 및 명령줄 경로 재검증 (TOCTOU)
//
// Usage (자동):
//   LaunchAgent: com.airgenome.net-rescue → WatchPaths 아님, LaunchEvents 트리거
// Manual:
//   hexa run bin/net_rescue.hexa              # 트리거 시뮬레이션
//   hexa run bin/net_rescue.hexa dry-run      # kill 생략
//   hexa run bin/net_rescue.hexa enable       # opt-in 켜기
//   hexa run bin/net_rescue.hexa disable      # opt-in 끄기
//   hexa run bin/net_rescue.hexa status       # 현재 상태

let HOME = env("HOME")
let FLAG_PATH = HOME + "/.airgenome/auto_rescue"
let LOG_PATH = HOME + "/.airgenome/net_rescue.jsonl"
let GRACE_MS = 5000          // SIGTERM → SIGKILL grace
let PING_HOST = "1.1.1.1"
let PING_ATTEMPTS = 3        // 3번 연속 fail 이면 outage
let PING_INTERVAL_S = 3      // 간격
let RECOVER_TIMEOUT_S = 60   // 네트워크 복귀 대기 최대

fn ts_iso() -> str {
    return exec("date -u +%Y-%m-%dT%H:%M:%SZ").trim()
}

fn shq(s: str) -> str {
    let parts = s.split("'")
    let mut out = "'"
    let mut i = 0
    while i < len(parts) {
        if i > 0 { out = out + "'\"'\"'" }
        out = out + parts[i]
        i = i + 1
    }
    return out + "'"
}

fn log_event(kind: str, detail: str) -> void {
    let _ = exec("mkdir -p " + shq(HOME + "/.airgenome"))
    let line = "{\"ts\":\"" + ts_iso() + "\",\"kind\":\"" + kind + "\",\"detail\":\"" + detail + "\"}"
    let _ = exec("printf '%s\\n' " + shq(line) + " >> " + shq(LOG_PATH))
}

fn file_exists(path: str) -> bool {
    let r = exec("[ -e " + shq(path) + " ] && echo y || echo n").trim()
    return r == "y"
}

fn ping_ok() -> bool {
    // -c 1 -W 2000 (2s timeout, macOS ms 단위)
    let rc = exec("ping -c 1 -W 2000 " + PING_HOST + " >/dev/null 2>&1 && echo y || echo n").trim()
    return rc == "y"
}

// outage 판정: 연속 3회 fail
fn detect_outage() -> bool {
    let mut i = 0
    while i < PING_ATTEMPTS {
        if ping_ok() {
            return false  // 한 번이라도 성공 = transient flutter
        }
        let _ = exec("sleep " + to_string(PING_INTERVAL_S))
        i = i + 1
    }
    return true
}

// 네트워크 복귀 대기
fn wait_recover() -> bool {
    let mut waited = 0
    while waited < RECOVER_TIMEOUT_S {
        if ping_ok() { return true }
        let _ = exec("sleep 2")
        waited = waited + 2
    }
    return false
}

// 내 소유 claude PID 목록
fn list_claude_pids() -> list {
    let myuid = exec("id -u").trim()
    // ps+awk: pgrep -f 는 long cmdline 에서 누락 (12KB .session_defaults)
    let raw = exec("ps -Ao uid=,pid=,command= 2>/dev/null | awk -v u=" + myuid + " '$1==u { cmd=\"\"; for (i=3;i<=NF;i++) cmd=cmd (i==3?\"\":\" \") $i; n=index(cmd,\" \"); exe=(n>0)?substr(cmd,1,n-1):cmd; m=split(exe,parts,\"/\"); base=parts[m]; if (base==\"claude\" || base==\"claude.real\") print $2 }'").trim()
    if raw == "" { return [] }
    return raw.split("\n")
}

// TOCTOU 재검증: pid 의 cmdline 이 여전히 claude 계열인지
fn verify_claude_pid(pid: str) -> bool {
    let cmd = exec("ps -o command= -p " + pid + " 2>/dev/null | head -1").trim()
    if cmd == "" { return false }
    // claude / claude.real 경로 포함?
    let rc = exec("printf '%s' " + shq(cmd) + " | grep -qE '/(\\.local/bin|airgenome/bin)/claude(\\.real)?( |$)' && echo y || echo n").trim()
    return rc == "y"
}

// 한 PID 종료: SIGTERM → grace → SIGKILL
fn kill_claude(pid: str, dry: bool) -> str {
    if !verify_claude_pid(pid) {
        return "skip_toctou"
    }
    if dry {
        return "dry_run"
    }
    let _ = exec("kill -TERM " + pid + " 2>/dev/null")
    // 최대 GRACE_MS 까지 500ms 간격으로 alive 체크
    let mut waited = 0
    while waited < GRACE_MS {
        let alive = exec("kill -0 " + pid + " 2>/dev/null && echo y || echo n").trim()
        if alive == "n" { return "term_ok" }
        let _ = exec("sleep 0.5")
        waited = waited + 500
    }
    let _ = exec("kill -KILL " + pid + " 2>/dev/null")
    return "kill_forced"
}

fn do_rescue(dry: bool) -> int {
    log_event("trigger", "received")

    if !file_exists(FLAG_PATH) {
        log_event("skip_optout", "flag=" + FLAG_PATH)
        return 0
    }

    // outage 판정
    if !detect_outage() {
        log_event("transient", "ping ok within first attempts")
        return 0
    }
    log_event("outage_confirmed", "consecutive_fail=" + to_string(PING_ATTEMPTS))

    // 복귀 대기
    if !wait_recover() {
        log_event("recover_timeout", "timeout_s=" + to_string(RECOVER_TIMEOUT_S))
        return 0
    }
    log_event("recovered", "now_online")

    // 모든 claude 리스큐
    let pids = list_claude_pids()
    if len(pids) == 0 {
        log_event("no_claude", "nothing to rescue")
        return 0
    }

    let mut i = 0
    let mut terminated = 0
    let mut killed = 0
    let mut skipped = 0
    while i < len(pids) {
        let pid = pids[i].trim()
        if pid != "" {
            let result = kill_claude(pid, dry)
            log_event("rescue_one", "pid=" + pid + " result=" + result)
            if result == "term_ok" { terminated = terminated + 1 }
            else if result == "kill_forced" { killed = killed + 1 }
            else { skipped = skipped + 1 }
        }
        i = i + 1
    }
    log_event("rescue_done", "total=" + to_string(len(pids)) + " term=" + to_string(terminated) + " kill=" + to_string(killed) + " skip=" + to_string(skipped))
    return 0
}

fn cmd_enable() -> int {
    let _ = exec("mkdir -p " + shq(HOME + "/.airgenome") + " && touch " + shq(FLAG_PATH))
    println("net_rescue: enabled (flag=" + FLAG_PATH + ")")
    return 0
}

fn cmd_disable() -> int {
    let _ = exec("rm -f " + shq(FLAG_PATH))
    println("net_rescue: disabled (flag 제거)")
    return 0
}

fn cmd_status() -> int {
    let on = file_exists(FLAG_PATH)
    println("net_rescue status:")
    println("  flag:     " + FLAG_PATH)
    println("  enabled:  " + to_string(on))
    println("  log:      " + LOG_PATH)
    let recent = exec("tail -5 " + shq(LOG_PATH) + " 2>/dev/null").trim()
    if recent != "" {
        println("  recent events:")
        let lines = recent.split("\n")
        let mut i = 0
        while i < len(lines) {
            println("    " + lines[i])
            i = i + 1
        }
    }
    return 0
}

fn main() -> void {
    let a = args()
    let mut sub = "rescue"
    let mut i = 0
    while i < len(a) {
        let t = a[i]
        if t == "rescue" || t == "dry-run" || t == "enable" || t == "disable" || t == "status" {
            sub = t
            i = len(a)
        } else {
            i = i + 1
        }
    }

    let mut rc = 0
    if sub == "rescue"   { rc = do_rescue(false) }
    else if sub == "dry-run" { rc = do_rescue(true) }
    else if sub == "enable"  { rc = cmd_enable() }
    else if sub == "disable" { rc = cmd_disable() }
    else if sub == "status"  { rc = cmd_status() }

    if rc != 0 { eprintln("[net_rescue] exit rc=" + to_string(rc)) }
}
