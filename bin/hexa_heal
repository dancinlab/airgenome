#!/usr/bin/env bash
# bin/hexa_heal — hexa_real binary 드리프트 감지 + 자동 복구 (ubu golden → ubu2/htz)
#
# 배경:
#   ubu2 (summer-B650M-K) 에서 stage0 재계산 또는 환경 이슈로 hexa_real 이
#   종종 깨지는 사례가 관찰됨 (size 8.8MB stripped 버전 → 실행 실패).
#   ubu 는 안정적 2.3MB 버전 보유. 두 호스트의 kernel/glibc ABI 가 같아
#   ubu 의 hexa_real 이 ubu2 에서 그대로 실행 가능함 (buildID sha1 동일).
#
# 전략:
#   1. ubu 의 ~/.hx/bin/hexa_real sha256 을 golden 으로 간주
#   2. ubu2/htz 의 hexa_real 과 비교
#   3. 드리프트 감지 시 rsync 로 ubu → 타깃 복제
#      - 파일 교체는 rm + cp (temp → rename) 패턴 (inode cache 회피)
#      - cp -f 금지 규칙 준수 (feedback_hexa_codesign_kill)
#   4. smoke test 5회 연속 성공해야 OK, 실패 시 이전 bak 롤백
#
# 재발 방지:
#   - cron 또는 cl 세션 시작 시 `hexa_heal check` 실행
#   - 드리프트 감지만 하고 리포트 (--heal 플래그로만 실제 교체)
#
# 사용:
#   hexa_heal check [host...]    # 드리프트 감지 only (exit 1 = drift)
#   hexa_heal heal  [host...]    # 드리프트 감지 + 자동 복구 (default: ubu2)
#   hexa_heal smoke [host...]    # 5회 smoke test 만
#   hexa_heal status             # 모든 호스트의 sha256 + size 표시
#
# 환경변수:
#   HEXA_HEAL_GOLDEN_HOST=ubu    golden source 호스트
#   HEXA_HEAL_TARGETS="ubu2 htz" default 타깃 (공백 구분)
#   HEXA_HEAL_DEBUG=1            상세 로그

set -euo pipefail

GOLDEN_HOST="${HEXA_HEAL_GOLDEN_HOST:-ubu}"
DEFAULT_TARGETS="${HEXA_HEAL_TARGETS:-ubu2}"
DEBUG="${HEXA_HEAL_DEBUG:-0}"

log() { echo "[hexa_heal] $*" >&2; }
dbg() { [ "$DEBUG" = "1" ] && echo "[hexa_heal:debug] $*" >&2 || true; }
die() { echo "[hexa_heal:FAIL] $*" >&2; exit 1; }

# --- ssh wrapper: 짧은 timeout + BatchMode, 조용히 실패 ---
remote() {
    local host="$1"; shift
    ssh -o ConnectTimeout=8 -o BatchMode=yes -o StrictHostKeyChecking=accept-new \
        "$host" "$@"
}

remote_home() {
    local host="$1"
    remote "$host" 'echo $HOME' 2>/dev/null
}

# --- 바이너리 해시/사이즈 조회 ---
get_sha256() {
    local host="$1"
    local home
    home=$(remote_home "$host") || { echo "ERR_SSH"; return 1; }
    remote "$host" "sha256sum $home/.hx/bin/hexa_real 2>/dev/null | awk '{print \$1}'" \
        || { echo "ERR_NO_BIN"; return 1; }
}

get_size() {
    local host="$1"
    local home
    home=$(remote_home "$host") || { echo 0; return 1; }
    remote "$host" "stat -c %s $home/.hx/bin/hexa_real 2>/dev/null" || echo 0
}

# --- 5회 smoke test ---
smoke() {
    local host="$1"
    local home
    home=$(remote_home "$host") || die "$host: ssh failed"
    local pass=0
    dbg "$host: smoke starting"
    # 작은 테스트 파일을 원격에 주입 (heredoc)
    remote "$host" 'cat > /tmp/hexa_heal_smoke.hexa' <<'HEXA'
fn main() {
    println("hexa_heal_smoke_ok")
}
HEXA
    for i in 1 2 3 4 5; do
        local out
        out=$(remote "$host" "$home/.hx/bin/hexa_real run /tmp/hexa_heal_smoke.hexa 2>&1" || echo "FAIL")
        if [ "$out" = "hexa_heal_smoke_ok" ]; then
            pass=$((pass+1))
            dbg "$host: run $i OK"
        else
            log "$host: run $i FAIL — out=\"$out\""
            return 1
        fi
    done
    remote "$host" 'rm -f /tmp/hexa_heal_smoke.hexa' || true
    [ "$pass" = "5" ] || return 1
    return 0
}

# --- ubu → target 복제 (rm+cp 패턴) ---
clone_from_golden() {
    local target="$1"
    local golden="$GOLDEN_HOST"
    local ghome thome
    ghome=$(remote_home "$golden") || die "golden $golden: ssh failed"
    thome=$(remote_home "$target") || die "target $target: ssh failed"

    local tmp_local
    tmp_local=$(mktemp -t hexa_heal.XXXXXX)
    trap 'rm -f "$tmp_local"' RETURN

    log "pulling golden from $golden:$ghome/.hx/bin/hexa_real"
    # rsync -z 압축 (LAN 이지만 2.3MB → 빠름), -t preserve mtime
    rsync -z -t "$golden:$ghome/.hx/bin/hexa_real" "$tmp_local" \
        || die "rsync from $golden failed"

    local local_sha
    local_sha=$(sha256sum "$tmp_local" | awk '{print $1}')
    dbg "downloaded sha256=$local_sha size=$(stat -f%z "$tmp_local" 2>/dev/null || stat -c%s "$tmp_local")"

    log "pushing to $target:$thome/.hx/bin/"
    rsync -z -t "$tmp_local" "$target:$thome/.hx/bin/hexa_real.new" \
        || die "rsync to $target failed"

    # 교체: 현재 파일 backup, rm, rename (inode 변경 강제)
    # cp -f 금지 규칙 준수 → mv 로 atomic rename
    local stamp
    stamp=$(date +%s)
    remote "$target" "
        set -e
        cd $thome/.hx/bin
        # 기존 backup 정리 (3일 이상 된 것)
        find . -maxdepth 1 -name 'hexa_real.bak.*' -mtime +3 -delete 2>/dev/null || true
        if [ -e hexa_real ]; then
            mv hexa_real hexa_real.bak.$stamp
        fi
        # rename atomic + chmod (0755 명시 — rsync 가 restrictive perm 전달하는 케이스 방어)
        mv hexa_real.new hexa_real
        chmod 0755 hexa_real
        # hexa shim 이 있는지 검증 (없으면 하드링크로 복원)
        if [ ! -e hexa ]; then
            echo 'hexa_heal: warn: hexa shim missing, copying real as hexa (non-shim mode)' >&2
            cp -p hexa_real hexa
        fi
    " || die "target $target: replace failed"

    log "verifying $target with 5-run smoke"
    if smoke "$target"; then
        log "$target: HEAL OK — sha256=$local_sha"
        return 0
    else
        log "$target: smoke FAILED after heal — rolling back"
        remote "$target" "
            cd $thome/.hx/bin
            if [ -e hexa_real.bak.$stamp ]; then
                rm -f hexa_real
                mv hexa_real.bak.$stamp hexa_real
                chmod +x hexa_real
            fi
        " || log "$target: rollback also failed"
        return 1
    fi
}

# --- 드리프트 감지 (golden 과 비교) ---
check_drift() {
    local target="$1"
    local golden_sha target_sha
    golden_sha=$(get_sha256 "$GOLDEN_HOST") || die "golden $GOLDEN_HOST: cannot read hexa_real"
    target_sha=$(get_sha256 "$target" 2>/dev/null || echo "MISSING")
    if [ "$target_sha" = "$golden_sha" ]; then
        echo "OK $target sha256=$target_sha"
        return 0
    else
        echo "DRIFT $target golden=$golden_sha target=$target_sha"
        return 1
    fi
}

# --- status: 모든 호스트 ---
cmd_status() {
    local golden_sha
    golden_sha=$(get_sha256 "$GOLDEN_HOST") || golden_sha="???"
    printf "%-8s %-64s %-10s\n" "host" "sha256" "size"
    printf "%-8s %-64s %-10s\n" "$GOLDEN_HOST(*)" "$golden_sha" "$(get_size "$GOLDEN_HOST")"
    for h in $DEFAULT_TARGETS; do
        local sha size tag
        sha=$(get_sha256 "$h" 2>/dev/null || echo "???")
        size=$(get_size "$h")
        if [ "$sha" = "$golden_sha" ]; then tag=""; else tag="  <-- DRIFT"; fi
        printf "%-8s %-64s %-10s%s\n" "$h" "$sha" "$size" "$tag"
    done
}

# --- main ---
cmd="${1:-status}"; shift || true
targets=("$@")
[ "${#targets[@]}" -eq 0 ] && targets=($DEFAULT_TARGETS)

case "$cmd" in
    status)
        cmd_status
        ;;
    check)
        any_drift=0
        for h in "${targets[@]}"; do
            check_drift "$h" || any_drift=1
        done
        exit "$any_drift"
        ;;
    heal)
        for h in "${targets[@]}"; do
            if check_drift "$h" >/dev/null 2>&1; then
                log "$h: no drift, skipping"
                continue
            fi
            log "$h: drift detected, healing"
            clone_from_golden "$h" || die "$h: heal failed"
        done
        log "all targets healed"
        ;;
    smoke)
        any_fail=0
        for h in "${targets[@]}"; do
            if smoke "$h"; then
                log "$h: smoke 5/5 OK"
            else
                log "$h: smoke FAILED"
                any_fail=1
            fi
        done
        exit "$any_fail"
        ;;
    -h|--help|help)
        sed -n '2,34p' "$0" | sed 's/^# \{0,1\}//'
        ;;
    *)
        echo "hexa_heal: unknown cmd '$cmd'. Try: status|check|heal|smoke" >&2
        exit 2
        ;;
esac
