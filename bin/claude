#!/usr/bin/env bash
# airgenome/bin/claude — PATH shim. 단일 주입점 for .session_defaults.
#
# 원리: $AIRGENOME/bin 이 PATH 에서 real claude (/opt/homebrew/bin/claude 등)
# 보다 앞에 있으므로, 모든 `claude`/`command claude`/`exec claude` 호출이
# 이 shim 을 먼저 찾음. shim 이 --append-system-prompt 를 prepend 한 후 real
# claude 로 exec.
#
# 효과: claudx 우회하는 모든 진입점 (improve_loop.sh, cl, cx mac fallback,
# engine_anima.hexa 의 exec("claude -p ...") 등) 이 자동으로 session_defaults
# 주입 받음. claudx 는 inject 제거 — shim 이 SSOT.
#
# 재귀 방지: path-based self-resolve (아래). env-based guard 는 제거됨 (2026-04-20) —
#   자식 claude 프로세스로 env 가 누출되어 서브프로세스가 모두 inject 를 skip 하던
#   근본 버그. path-based 가드만으로 shim→shim 재귀는 이미 차단됨.
# 우회: NEXUS_SESSION_LAX=1 또는 args 에 --append-system-prompt 이미 있을 때.

set -euo pipefail

# --- real claude 해석: PATH 순회하며 self 와 다른 첫 실행파일 ---
self=$(readlink -f "$0" 2>/dev/null || realpath "$0" 2>/dev/null || echo "$0")
real=""
IFS=':' read -ra _paths <<< "$PATH"
for p in "${_paths[@]}"; do
    cand="$p/claude"
    if [ -x "$cand" ]; then
        resolved=$(readlink -f "$cand" 2>/dev/null || realpath "$cand" 2>/dev/null || echo "$cand")
        if [ "$resolved" != "$self" ]; then
            real="$cand"
            break
        fi
    fi
done
if [ -z "$real" ]; then
    echo "claude(shim): real claude not found in PATH" >&2
    exit 127
fi

# --- inject 판정 ---
AGROOT="${AIRGENOME:-$HOME/Dev/airgenome}"
SD="$AGROOT/.session_defaults"
inject=1
[ "${NEXUS_SESSION_LAX:-0}" = "1" ] && inject=0
for a in "$@"; do
    if [ "$a" = "--append-system-prompt" ] || [ "$a" = "--system-prompt" ] || [ "$a" = "--bare" ]; then
        inject=0
        break
    fi
done

# 코드-수준 강제: AGROOT 가 airgenome 레포 (project.hexa 존재) 인데 .session_defaults
# 가 없으면 fail-fast. 기존엔 silent skip → 주입 누락 탐지 불가능했던 원인.
# 우회: NEXUS_SESSION_LAX=1 (의도적 clean 모드) 또는 --append-system-prompt 지정.
if [ "$inject" = "1" ] && [ ! -f "$SD" ]; then
    if [ -f "$AGROOT/project.hexa" ]; then
        echo "claude(shim): FATAL .session_defaults missing at $SD (airgenome repo detected)" >&2
        echo "claude(shim):  fix: restore file, or NEXUS_SESSION_LAX=1 for clean mode" >&2
        exit 2
    fi
    # non-airgenome 컨텍스트 — 조용히 skip
    inject=0
fi

if [ "$inject" = "1" ]; then
    exec "$real" --append-system-prompt "$(cat "$SD")" "$@"
else
    exec "$real" "$@"
fi
