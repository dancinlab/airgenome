#!/usr/bin/env bash
# tg_cx_md — cx-core 래퍼. Telegram 전송 시 markdown 코드블록으로 감싸
# parse_mode=Markdown 렌더링을 안정화. stdin=user text, stdout=reply.
#
# 왜: cx-core 출력은 markdown (bold/list/link) 인데 tg_bot-core 가
# parse_mode 없이 보내면 raw 로 보임. parse_mode=Markdown 을 켜면
# 특수문자 이스케이프 지뢰. 대신 전체를 triple-backtick pre 블록으로
# 감싸면 내부 텍스트가 그대로 등폭 고정 렌더 + 이스케이프 불필요.
#
# triple-backtick 충돌 방지: cx-core 출력 중 `^```` 로 시작하는 라인을
# u+200B (zero-width space) 로 깨뜨려 바깥 fence 와 충돌 차단.

set -uo pipefail

CX="${CX_CORE_BIN:-/Users/ghost/core/airgenome/bin/cx-core}"

# stdin → cx-core → 버퍼 → fence wrap → stdout
out=$("$CX" local -- -p 2>&1)
rc=$?

# inner triple-backtick 깨기
safe=$(printf '%s' "$out" | sed $'s/^```/\xe2\x80\x8b```/g')

printf '```\n%s\n```' "$safe"
exit "$rc"
