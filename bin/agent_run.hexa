// bin/agent_run.hexa — F7 AGENT_DIST prototype
//
// 목적:
//   "Task tool 로컬 Mac 누적" 회피. prompt 을 dispatch_state.json best-host 로
//   ssh 래핑 발사. Mac 은 오케스트레이션만, heavy compute 는 ubu1/ubu2/htz 로 분산.
//
// Usage:
//   airgenome agent-run --prompt="..." [--host=auto|mac|ubu1|ubu2|htz]
//                       [--kind=compute|heavy|gpu] [--timeout=300]
//                       [--output=file|stdout] [--dry-run] [--no-dry-run]
//                       [self-test]
//
// 안전:
//   - 기본 dry-run=true (실제 ssh 발사 안함 — 명령만 echo). 실제 실행은 --no-dry-run.
//   - AG6 gate 위반 (host=mac & kind=heavy/compute) 시 경고만, 강제 진행은 --no-dry-run.
//   - dispatch_state.json stale (>600s) 시 stderr 경고 후 fallback.
//
// hexa-lang 제약 (준수):
//   - stage0 파서 호환 — `use` 문법 금지. airgenome_root 로컬 재구현.
//   - 전역 let 을 if 조건 직접 비교 X — 로컬 복사 (feedback_hexa-global-const-if).
//   - list.push(x) no-op — `list = list + [x]` (feedback_hexa-list-push-noop).
//   - to_string(void) → "void" 가드 필요 시 삽입 (feedback_hexa_void_json).
//   - try/catch 미사용.

// ═══════════════════════════════════════════════════════════════════════
//  PATHS / HELPERS
// ═══════════════════════════════════════════════════════════════════════

fn ag_root() -> str {
    let custom = env("AIRGENOME_ROOT")
    if custom != "" { return custom }
    return env("HOME") + "/Dev/airgenome"
}

fn hosts_file() -> str {
    return ag_root() + "/shared/config/hosts.json"
}

fn nexus_root() -> str {
    let custom = env("NEXUS_ROOT")
    if custom != "" { return custom }
    return env("HOME") + "/Dev/nexus"
}

fn dispatch_state_file() -> str {
    return nexus_root() + "/shared/dispatch_state.json"
}

fn log_dir() -> str {
    return env("HOME") + "/.airgenome/agent_runs"
}

fn ts_compact() -> str {
    // 20260420T153501Z
    return exec("date -u +%Y%m%dT%H%M%SZ").trim()
}

fn ts_epoch() -> int {
    let s = exec("date +%s").trim()
    if s == "" { return 0 }
    return to_int(s)
}

fn shq(s: str) -> str {
    // single-quote wrap — prompt 에 single quote 없다고 가정. 있으면 escape.
    let safe = s.replace("'", "'\\''")
    return "'" + safe + "'"
}

fn eprintln(s: str) -> void {
    let _ = exec("printf '%s\n' " + shq(s) + " 1>&2")
}

// ═══════════════════════════════════════════════════════════════════════
//  OPTIONS
// ═══════════════════════════════════════════════════════════════════════

struct Opts {
    prompt: str,
    host: str,        // auto | mac | ubu1 | ubu2 | htz
    kind: str,        // compute | heavy | gpu
    timeout_s: int,
    output: str,      // file | stdout
    dry_run: bool,
    is_self_test: bool
}

fn parse_opts(argv: [str], from: int) -> Opts {
    let mut o = Opts {
        prompt: "",
        host: "auto",
        kind: "heavy",
        timeout_s: 300,
        output: "stdout",
        dry_run: true,      // 안전 기본 — 명시적 --no-dry-run 으로 opt-out
        is_self_test: false
    }
    let mut i = from
    while i < len(argv) {
        let t = argv[i]
        if t == "self-test" { o.is_self_test = true }
        else if t.starts_with("--prompt=") { o.prompt = t.substring(9, len(t)) }
        else if t == "--prompt" && i + 1 < len(argv) { o.prompt = argv[i + 1]; i = i + 1 }
        else if t.starts_with("--host=") { o.host = t.substring(7, len(t)) }
        else if t == "--host" && i + 1 < len(argv) { o.host = argv[i + 1]; i = i + 1 }
        else if t.starts_with("--kind=") { o.kind = t.substring(7, len(t)) }
        else if t == "--kind" && i + 1 < len(argv) { o.kind = argv[i + 1]; i = i + 1 }
        else if t.starts_with("--timeout=") { o.timeout_s = to_int(t.substring(10, len(t))) }
        else if t == "--timeout" && i + 1 < len(argv) { o.timeout_s = to_int(argv[i + 1]); i = i + 1 }
        else if t.starts_with("--output=") { o.output = t.substring(9, len(t)) }
        else if t == "--output" && i + 1 < len(argv) { o.output = argv[i + 1]; i = i + 1 }
        else if t == "--dry-run" { o.dry_run = true }
        else if t == "--no-dry-run" { o.dry_run = false }
        i = i + 1
    }
    if o.timeout_s <= 0 { o.timeout_s = 300 }
    return o
}

// ═══════════════════════════════════════════════════════════════════════
//  DISPATCH STATE — best host pick
// ═══════════════════════════════════════════════════════════════════════

// dispatch_state.json path override (self-test 용)
fn read_dispatch_selection(kind: str, ds_path: str) -> str {
    let chk = exec("[ -f " + shq(ds_path) + " ] && echo y || echo n").trim()
    if chk != "y" { return "none" }
    let k = kind
    let sel = exec("jq -r '.selection." + k + " // \"none\"' " + shq(ds_path) + " 2>/dev/null").trim()
    if sel == "" { return "none" }
    return sel
}

// ts age in seconds from dispatch_state.json (.ts). missing → 999999.
fn read_dispatch_age(ds_path: str) -> int {
    let chk = exec("[ -f " + shq(ds_path) + " ] && echo y || echo n").trim()
    if chk != "y" { return 999999 }
    let ts_str = exec("jq -r '.ts // empty' " + shq(ds_path) + " 2>/dev/null").trim()
    if ts_str == "" { return 999999 }
    let t = exec("date -u -j -f '%Y-%m-%dT%H:%M:%SZ' " + shq(ts_str) + " +%s 2>/dev/null").trim()
    let mut ts_epoch_v = 0
    if t != "" { ts_epoch_v = to_int(t) }
    else {
        // Linux fallback
        let t2 = exec("date -u -d " + shq(ts_str) + " +%s 2>/dev/null").trim()
        if t2 != "" { ts_epoch_v = to_int(t2) }
    }
    if ts_epoch_v == 0 { return 999999 }
    let now = ts_epoch()
    let age = now - ts_epoch_v
    if age < 0 { return 0 }
    return age
}

// fallback 우선순위 (task 지정): ubu2 → htz → ubu1 → mac
fn fallback_host() -> str { return "ubu2" }

fn next_fallback(cur: str) -> str {
    if cur == "ubu2" { return "htz" }
    if cur == "htz" { return "ubu1" }
    if cur == "ubu1" { return "mac" }
    return ""
}

// host key → ssh_alias. "mac" 은 self → "" 반환.
fn resolve_ssh_alias(host: str) -> str {
    let h = host
    if h == "mac" { return "" }
    let q = ".hosts.\"" + h + "\".ssh_alias // empty"
    let v = exec("jq -r '" + q + "' " + shq(hosts_file()) + " 2>/dev/null").trim()
    return v
}

fn host_enabled(host: str) -> bool {
    let q = ".hosts.\"" + host + "\".enabled // false"
    let v = exec("jq -r '" + q + "' " + shq(hosts_file()) + " 2>/dev/null").trim()
    return v == "true"
}

// ═══════════════════════════════════════════════════════════════════════
//  HOST SELECTION — auto 경로
// ═══════════════════════════════════════════════════════════════════════

// dispatch selection + stale 체크 + fallback chain 으로 host 결정.
// 반환: host key (ubu1/ubu2/htz/mac) or "" on fatal.
fn pick_host(requested: str, kind: str, ds_path: str) -> str {
    if requested != "auto" { return requested }

    let sel = read_dispatch_selection(kind, ds_path)
    let age = read_dispatch_age(ds_path)
    if age > 600 {
        eprintln("[agent-run] WARN — dispatch_state.json stale (" + to_string(age) + "s > 600s)")
    }
    if sel != "none" && sel != "" {
        // dispatch 는 'heavy' 에서 'htz' 같은 shortname 을 반환. hosts.json key 와 1:1.
        if host_enabled(sel) { return sel }
        eprintln("[agent-run] WARN — dispatch selection '" + sel + "' disabled, fallback")
    } else {
        eprintln("[agent-run] INFO — dispatch selection=none, fallback chain")
    }

    // fallback chain
    let mut cur = fallback_host()
    while cur != "" {
        if host_enabled(cur) { return cur }
        cur = next_fallback(cur)
    }
    return ""
}

// ═══════════════════════════════════════════════════════════════════════
//  COMMAND BUILD + EXECUTE
// ═══════════════════════════════════════════════════════════════════════

fn build_command(host: str, alias: str, prompt: str, timeout_s: int) -> str {
    let to_s = to_string(timeout_s)
    if host == "mac" {
        // 로컬 claudx — airgenome PATH 전제 (bin/claudx 가 PATH 에 있다고 가정).
        return "timeout " + to_s + " claudx -p " + shq(prompt)
    }
    // 원격 — ssh <alias> cx -p "..."
    // cx 는 bin/cx. 원격 쪽에 airgenome/bin 이 PATH 에 있다고 가정 (deploy 경로).
    // 실패 시 대체경로 $HOME/Dev/airgenome/bin/cx 도 시도.
    let inner = "cx -p " + shq(prompt)
    return "timeout " + to_s + " ssh " + alias + " " + shq(inner)
}

fn execute(cmd: str, log_path: str, to_file: bool) -> int {
    if to_file {
        let _ = exec("mkdir -p " + shq(log_dir()))
        // bash -lc 로 timeout exit code 보존
        let wrapped = cmd + " 2>&1 | tee " + shq(log_path) + "; exit ${PIPESTATUS[0]}"
        let rc_raw = exec("bash -lc " + shq(wrapped) + "; echo __rc=$?").trim()
        // __rc= 파싱
        let lines = rc_raw.split("\n")
        let last = lines[len(lines) - 1]
        if last.starts_with("__rc=") {
            return to_int(last.substring(5, len(last)))
        }
        return 0
    }
    // stdout 직접 — exec 가 stdout 캡처하므로 print 로 flush
    let out = exec(cmd + " 2>&1; echo __rc=$?")
    let lines = out.split("\n")
    let mut i = 0
    let mut rc = 0
    while i < len(lines) {
        let line = lines[i]
        if line.starts_with("__rc=") {
            rc = to_int(line.substring(5, len(line)))
        } else {
            // 마지막 줄이 아니면 출력
            if i < len(lines) - 1 { println(line) }
            else if !line.starts_with("__rc=") { println(line) }
        }
        i = i + 1
    }
    return rc
}

// ═══════════════════════════════════════════════════════════════════════
//  MAIN LOGIC
// ═══════════════════════════════════════════════════════════════════════

fn run_once(o: Opts) -> int {
    if o.prompt == "" {
        eprintln("[agent-run] ERROR — --prompt=... required")
        return 2
    }

    let host = pick_host(o.host, o.kind, dispatch_state_file())
    if host == "" {
        eprintln("[agent-run] ERROR — no host available (all disabled)")
        return 3
    }

    // AG6 gate — mac 에서 heavy/compute 는 위반
    let is_mac = host == "mac"
    let k = o.kind
    if is_mac {
        if k == "heavy" || k == "compute" || k == "gpu" {
            eprintln("[agent-run] WARN — AG6 violation: host=mac, kind=" + k + " (Mac heavy compute 금지)")
            if !o.dry_run {
                eprintln("[agent-run] WARN — --no-dry-run 임에도 실행 — 사용자 판단 책임")
            }
        }
    }

    let alias = resolve_ssh_alias(host)
    if !is_mac {
        if alias == "" {
            eprintln("[agent-run] ERROR — ssh_alias 없음 for host=" + host)
            return 4
        }
    }

    let cmd = build_command(host, alias, o.prompt, o.timeout_s)
    println("[agent-run] host=" + host + " kind=" + k + " timeout=" + to_string(o.timeout_s) + "s output=" + o.output + " dry_run=" + (if o.dry_run { "true" } else { "false" }))
    println("[agent-run] cmd: " + cmd)

    if o.dry_run {
        println("[agent-run] dry-run — 실제 실행 안함. --no-dry-run 으로 실행.")
        return 0
    }

    let to_file = o.output == "file"
    let log_path = log_dir() + "/" + ts_compact() + "-" + host + ".log"
    if to_file { println("[agent-run] log: " + log_path) }

    let rc = execute(cmd, log_path, to_file)
    if rc == 124 {
        eprintln("[agent-run] TIMEOUT — " + to_string(o.timeout_s) + "s 초과. host=" + host)
    }
    return rc
}

// ═══════════════════════════════════════════════════════════════════════
//  SELF-TEST — dry-run only, mock dispatch_state
// ═══════════════════════════════════════════════════════════════════════

fn self_test() -> int {
    println("[agent-run self-test] start")
    let mut pass = 0
    let mut fail = 0

    // T1 — mock dispatch_state with heavy=htz → pick htz
    let tmp1 = "/tmp/agent_run_test_ds_1.json"
    let _ = exec("printf '%s' '{\"ts\":\"" + exec("date -u +%Y-%m-%dT%H:%M:%SZ").trim() + "\",\"selection\":{\"compute\":\"ubu2\",\"heavy\":\"htz\",\"gpu\":\"none\"}}' > " + shq(tmp1))
    let p1 = pick_host("auto", "heavy", tmp1)
    if p1 == "htz" { pass = pass + 1; println("  [PASS] T1 dispatch heavy=htz pick") }
    else { fail = fail + 1; println("  [FAIL] T1 expected=htz got=" + p1) }

    // T2 — dispatch selection=none → fallback chain (ubu2 first since enabled)
    let tmp2 = "/tmp/agent_run_test_ds_2.json"
    let _ = exec("printf '%s' '{\"ts\":\"" + exec("date -u +%Y-%m-%dT%H:%M:%SZ").trim() + "\",\"selection\":{\"compute\":\"none\",\"heavy\":\"none\",\"gpu\":\"none\"}}' > " + shq(tmp2))
    let p2 = pick_host("auto", "heavy", tmp2)
    // ubu2 가 hosts.json 에 enabled=true 이면 ubu2 반환.
    if p2 == "ubu2" || p2 == "htz" || p2 == "ubu1" { pass = pass + 1; println("  [PASS] T2 fallback chain picked=" + p2) }
    else { fail = fail + 1; println("  [FAIL] T2 fallback expected=ubu2/htz/ubu1 got=" + p2) }

    // T3 — explicit host=mac bypass dispatch
    let p3 = pick_host("mac", "heavy", tmp1)
    if p3 == "mac" { pass = pass + 1; println("  [PASS] T3 explicit host=mac honored") }
    else { fail = fail + 1; println("  [FAIL] T3 expected=mac got=" + p3) }

    // T4 — resolve_ssh_alias("htz") == "hetzner"
    let a4 = resolve_ssh_alias("htz")
    if a4 == "hetzner" { pass = pass + 1; println("  [PASS] T4 resolve_ssh_alias(htz)=hetzner") }
    else { fail = fail + 1; println("  [FAIL] T4 expected=hetzner got=" + a4) }

    // T5 — resolve_ssh_alias("mac") == ""
    let a5 = resolve_ssh_alias("mac")
    if a5 == "" { pass = pass + 1; println("  [PASS] T5 resolve_ssh_alias(mac)=empty") }
    else { fail = fail + 1; println("  [FAIL] T5 expected=empty got=" + a5) }

    // T6 — build_command remote shape
    let c6 = build_command("htz", "hetzner", "hello world", 60)
    let ok6 = c6.contains("timeout 60") && c6.contains("ssh hetzner") && c6.contains("cx -p") && c6.contains("hello world")
    if ok6 { pass = pass + 1; println("  [PASS] T6 build_command remote shape") }
    else { fail = fail + 1; println("  [FAIL] T6 cmd=" + c6) }

    // T7 — build_command mac shape
    let c7 = build_command("mac", "", "hi", 30)
    let ok7 = c7.contains("timeout 30") && c7.contains("claudx -p") && c7.contains("hi")
    if ok7 { pass = pass + 1; println("  [PASS] T7 build_command mac (claudx local)") }
    else { fail = fail + 1; println("  [FAIL] T7 cmd=" + c7) }

    // T8 — stale dispatch_state (very old ts) triggers warn but still picks
    let tmp8 = "/tmp/agent_run_test_ds_8.json"
    let _ = exec("printf '%s' '{\"ts\":\"2020-01-01T00:00:00Z\",\"selection\":{\"heavy\":\"ubu1\"}}' > " + shq(tmp8))
    let age8 = read_dispatch_age(tmp8)
    if age8 > 600 { pass = pass + 1; println("  [PASS] T8 stale age=" + to_string(age8) + "s detected") }
    else { fail = fail + 1; println("  [FAIL] T8 expected age>600 got=" + to_string(age8)) }

    // T9 — dry-run default (no prompt → error; but with prompt, no ssh fired)
    let dry_opts = Opts { prompt: "selftest", host: "htz", kind: "heavy", timeout_s: 10, output: "stdout", dry_run: true, is_self_test: false }
    let rc9 = run_once(dry_opts)
    if rc9 == 0 { pass = pass + 1; println("  [PASS] T9 dry-run completes rc=0") }
    else { fail = fail + 1; println("  [FAIL] T9 dry-run rc=" + to_string(rc9)) }

    // cleanup
    let _ = exec("rm -f " + shq(tmp1) + " " + shq(tmp2) + " " + shq(tmp8))

    println("[agent-run self-test] pass=" + to_string(pass) + " fail=" + to_string(fail))
    if fail > 0 { return 1 }
    return 0
}

// ═══════════════════════════════════════════════════════════════════════
//  ENTRY
// ═══════════════════════════════════════════════════════════════════════

fn main() -> void {
    let a = args()
    // hexa run <file> [argv...] — tail starts at index 2.
    let o = parse_opts(a, 2)
    if o.is_self_test {
        let rc = self_test()
        // exit code 는 hexa-lang 에서 exit() 로 반환 — stage0 미지원시 print 만.
        if rc != 0 { eprintln("[agent-run] self-test FAIL rc=" + to_string(rc)) }
        return
    }
    let rc = run_once(o)
    if rc != 0 { eprintln("[agent-run] exit rc=" + to_string(rc)) }
}

main()
