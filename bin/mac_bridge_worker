#!/bin/bash
# bin/mac_bridge_worker — thin launchd transport glue.
# 실제 로직: modules/mac_bridge_worker.hexa (hexa-only).
# Mac 정식 hexa 는 /Users/ghost/Dev/hexa-lang/hexa (/opt/homebrew/bin/hexa 는
# 동명의 다른 프로젝트이므로 피함).
exec /Users/ghost/Dev/hexa-lang/hexa run /Users/ghost/Dev/airgenome/modules/mac_bridge_worker.hexa
