#!/usr/bin/env bash
# bin/claudx-rc — 상시연결 remote-control 세션 (M13g, 2026-04-19)
#
# iOS Claude 앱 페어링용 background claude1 세션.
# launchd 가 이 스크립트를 호출 → pidfile dedup 후 claudx-loop 기동.
# --force-acct claude1 로 rotation 차단 (RC 페어링 안정). /loop 안에서 smash/free
# 교대로 돌파 워크로드 지속.
#
# usage (직접):
#   claudx-rc           # foreground 실행 (디버깅)
#   claudx-rc --status  # pidfile + 프로세스 상태
#   claudx-rc --stop    # 종료 (SIGTERM)
#
# env:
#   CLAUDX_RC_ACCT      pinning 계정 (default claude1)
#   CLAUDX_RC_LOOP      /loop spec (default "1h /smash 돌파탐색 + /free 교대")
#   CLAUDX_RC_PREFIX    --remote-control-session-name-prefix (default mobile)

set -uo pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
CX_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"
CLAUDX_LOOP="$CX_ROOT/bin/claudx-loop"

: "${CLAUDX_STATE:=$HOME/.airgenome/claudx}"
: "${CLAUDX_RC_ACCT:=claude1}"
: "${CLAUDX_RC_LOOP:=1h /smash 돌파탐색 + /free 교대 — 현 컨텍스트 이어가며 실험}"
: "${CLAUDX_RC_PREFIX:=mobile}"
export CLAUDX_STATE

mkdir -p "$CLAUDX_STATE"
PIDFILE="$CLAUDX_STATE/rc.pid"
LOGFILE="$CLAUDX_STATE/rc.log"

info() { echo "[claudx-rc] $*" >&2; }

case "${1:-}" in
    --status)
        if [ -f "$PIDFILE" ]; then
            pid=$(cat "$PIDFILE")
            if kill -0 "$pid" 2>/dev/null; then
                echo "running pid=$pid"
                ps -o pid,ppid,etime,cmd -p "$pid" 2>/dev/null | head -5
                exit 0
            fi
            echo "stale pidfile (pid=$pid dead)"
            rm -f "$PIDFILE"
            exit 1
        fi
        echo "not running"
        exit 1
        ;;
    --stop)
        if [ -f "$PIDFILE" ]; then
            pid=$(cat "$PIDFILE")
            kill -TERM "$pid" 2>/dev/null && info "SIGTERM sent pid=$pid"
            rm -f "$PIDFILE"
        fi
        # child claude 도 정리
        pkill -TERM -f 'claudx-loop.*--force-acct '"$CLAUDX_RC_ACCT" 2>/dev/null || true
        exit 0
        ;;
    -h|--help)
        sed -n '2,20p' "$0" | sed 's/^# \{0,1\}//'
        exit 0
        ;;
esac

# single-instance guard
if [ -f "$PIDFILE" ]; then
    old_pid=$(cat "$PIDFILE" 2>/dev/null)
    if [ -n "$old_pid" ] && kill -0 "$old_pid" 2>/dev/null; then
        info "already running pid=$old_pid — exit"
        exit 0
    fi
    rm -f "$PIDFILE"
fi
echo "$$" > "$PIDFILE"
trap 'rm -f "$PIDFILE"' EXIT TERM INT HUP

# RC 전용 세팅:
#  - watch 제외 (main 작업과 분리)
#  - rotation 비활성 (claude1 pinning)
#  - autoloop 으로 smash/free 교대 돌파
export CLAUDX_NO_WATCH=1
export CLAUDX_MAX_ROT=0
export CLAUDX_AUTOLOOP="$CLAUDX_RC_LOOP"

info "starting claudx-loop (acct=$CLAUDX_RC_ACCT autoloop='$CLAUDX_RC_LOOP' rc_prefix=$CLAUDX_RC_PREFIX)"
info "log: $LOGFILE  · pidfile: $PIDFILE"

# claudx-loop 에 claude args forward (--force-acct + --remote-control-session-name-prefix)
exec "$CLAUDX_LOOP" \
    --force-acct "$CLAUDX_RC_ACCT" \
    -- \
    --remote-control-session-name-prefix "$CLAUDX_RC_PREFIX" \
    -c \
    >> "$LOGFILE" 2>&1
