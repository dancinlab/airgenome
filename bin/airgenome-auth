#!/usr/bin/env bash
# bin/airgenome-auth — airgenome 의 auth plane 통제자. 12 계정 headless sync.
# @convergence: auth-plane-phase1-refresh-defense, auth-plane-observability-ubu2-recovery, auth-plane-test-suite-36-45, health-stats-oauth-column
#
# 핵심: Mac keychain 의 path-hashed credentials entries (SHA256(path)[0:8])
# 전수 추출 → Mac 내 모든 CLAUDE_CONFIG_DIR (.claude + .claude-claude1..N) 에
# 로컬 .credentials.json 으로 materialize → 원격 4 호스트 (ubu2/-d, htz/-d)
# 에 per-account dir 구조 그대로 이식. 원격 rotation 지원.
#
# 제약: Anthropic OAuth 최초 consent 1회 per account = 브라우저 불가피.
# 이후 refreshToken 재사용 → headless 영구.
#
# subcommands:
#   sync                    keychain → Mac local files → 원격 이식 (기본 12 acct)
#   status [--json]         12 acct × {keychain, 4 remote} 매트릭스
#   login <name>            CLAUDE_CONFIG_DIR=.claude-<name> claude /login (private-window)
#   refresh [<name>|--all]  forced token refresh via `claude -p "ok" --max-turns 1`
#   refresh-expired         keychain.expiresAt < now 계정만 골라 refresh (Step B Phase 1)
#   refresh-safe <name>     flock + rotation capture + token-health 기록 (Phase 2 단일호스트)
#   guard                   expiresAt < now+600s 계정 선제 refresh-safe (launchd 주기용)
#   health-stats [days=7]   token-health.jsonl 이벤트 집계 (관측 증거)
#   cross-drift [host=ubu2] mac vs 원격 expiresAt 비교 (cross-host 관측)
#   drift [--json]          12계정 × file vs KC refresh_token 해시 비교 (읽기만)
#   doctor [--json]         12계정 × (source, alive, has_refresh, drift, session_pct, exhausted) 매트릭스
#   list                    /Users/ghost/.claude-* 디렉토리 발견된 계정 나열
#   self-test
#
# deps: bash, shasum, security, jq, ssh, scp, tar. (Mac 전용 — security, shasum -a 256)

set -uo pipefail

ROOT="${AIRGENOME_ROOT:-$HOME/Dev/airgenome}"
LOG_DIR="$HOME/Library/Logs"
LOG="$LOG_DIR/airgenome-auth.log"
mkdir -p "$LOG_DIR"

ts()   { date +'%Y-%m-%dT%H:%M:%S'; }
log()  { printf '[airgenome-auth %s] %s\n' "$(ts)" "$*" | tee -a "$LOG" >&2; }

SSH_OPTS=(-o ConnectTimeout=8 -o BatchMode=yes -o ServerAliveInterval=5)
REMOTE_HOSTS=(ubu2 ubu2-d hetzner htz-d)

_usage() {
    sed -n '2,18p' "$0" | sed 's/^# \{0,1\}//'
}

# ── hash: SHA256(path)[0:8] ──────────────────────────────────────
_hash_path() {
    printf '%s' "$1" | shasum -a 256 | awk '{print substr($1,1,8)}'
}

# ── 계정 목록 — /Users/ghost/.claude-* 디렉토리 존재 기준 ─────────
_list_accounts() {
    # default first, 이어서 per-account.
    if [ -d "$HOME/.claude" ]; then
        echo "default"
    fi
    for d in "$HOME"/.claude-*; do
        [ -d "$d" ] || continue
        name="${d##*/.claude-}"
        # skip false positives: .claude-env-* 류
        case "$name" in
            env-*|.*) continue ;;
        esac
        echo "$name"
    done
}

# ── 계정명 → dir 변환 ─────────────────────────────────────────────
_acct_dir() {
    if [ "$1" = "default" ]; then echo "$HOME/.claude"
    else echo "$HOME/.claude-$1"
    fi
}

# ── 계정명 → keychain service name ───────────────────────────────
_acct_keychain_service() {
    local dir; dir=$(_acct_dir "$1")
    if [ "$1" = "default" ]; then
        echo "Claude Code-credentials"
    else
        echo "Claude Code-credentials-$(_hash_path "$dir")"
    fi
}

# ── keychain → JSON (없으면 빈 문자열) ───────────────────────────
_fetch_json() {
    security find-generic-password -s "$1" -w 2>/dev/null || true
}

# ── Mac local materialize: keychain → .credentials.json ──────────
_materialize_local() {
    local name=$1 service json dir
    service=$(_acct_keychain_service "$name")
    json=$(_fetch_json "$service")
    [ -z "$json" ] && return 1
    # 유효성 — accessToken 있는지
    echo "$json" | jq -e '.claudeAiOauth.accessToken' >/dev/null 2>&1 || return 1
    dir=$(_acct_dir "$name")
    mkdir -p "$dir"
    printf '%s\n' "$json" > "$dir/.credentials.json.tmp"
    chmod 600 "$dir/.credentials.json.tmp"
    mv "$dir/.credentials.json.tmp" "$dir/.credentials.json"
    return 0
}

# ── 한 계정의 credentials 원격 이식 ──────────────────────────────
_sync_one_to_remote() {
    local name=$1 host=$2 local_file remote_dir
    local_file="$(_acct_dir "$name")/.credentials.json"
    [ -f "$local_file" ] || return 2
    # 원격 dir 은 ssh-user HOME 기준 상대 경로. ~ 경유 sh 확장.
    if [ "$name" = "default" ]; then
        remote_dir=".claude"
    else
        remote_dir=".claude-$name"
    fi
    # stream 이식 (tar 로 mtime + perm 보존). inline cleanup — trap RETURN 는
    # local 변수 scope 가 unwind 된 뒤 실행돼 set -u 와 충돌.
    local TMP; TMP=$(mktemp -d)
    mkdir -p "$TMP/$remote_dir"
    cp "$local_file" "$TMP/$remote_dir/.credentials.json"
    chmod 600 "$TMP/$remote_dir/.credentials.json"
    local rc=1
    if tar -C "$TMP" -cf - "$remote_dir" 2>/dev/null \
       | ssh "${SSH_OPTS[@]}" "$host" \
           "tar -C \"\$HOME\" -xf - --overwrite && chmod 600 \"\$HOME/$remote_dir/.credentials.json\"" \
           2>/dev/null; then
        rc=0
    fi
    rm -rf "$TMP"
    return $rc
}

# ── cmd: sync ────────────────────────────────────────────────────
cmd_sync() {
    local accts; accts=$(_list_accounts)
    local total_acct=0 ok_acct=0 miss_acct=0
    # 1) Mac local materialize
    log "step1: Mac local materialize"
    local ok_local=() missing_local=()
    while IFS= read -r name; do
        [ -z "$name" ] && continue
        total_acct=$((total_acct+1))
        if _materialize_local "$name"; then
            ok_local+=("$name")
            ok_acct=$((ok_acct+1))
        else
            missing_local+=("$name")
            miss_acct=$((miss_acct+1))
        fi
    done <<< "$accts"
    log "  local: OK=${#ok_local[@]} MISS=${#missing_local[@]}"
    [ ${#missing_local[@]} -gt 0 ] && log "  missing: ${missing_local[*]}"

    # 2) 원격 호스트 이식
    log "step2: remote sync (${#REMOTE_HOSTS[@]} hosts × ${#ok_local[@]} accts)"
    local REMOTE_OK=0 REMOTE_FAIL=0 REMOTE_SKIP=0
    for host in "${REMOTE_HOSTS[@]}"; do
        # 연결 check
        if ! ssh "${SSH_OPTS[@]}" "$host" true 2>/dev/null; then
            log "  SKIP $host — unreachable"
            REMOTE_SKIP=$((REMOTE_SKIP + ${#ok_local[@]}))
            continue
        fi
        local host_ok=0 host_fail=0
        for name in "${ok_local[@]}"; do
            if _sync_one_to_remote "$name" "$host"; then
                host_ok=$((host_ok+1))
            else
                host_fail=$((host_fail+1))
            fi
        done
        REMOTE_OK=$((REMOTE_OK + host_ok))
        REMOTE_FAIL=$((REMOTE_FAIL + host_fail))
        log "  $host: OK=$host_ok FAIL=$host_fail"
    done
    log "summary: local_ok=$ok_acct local_miss=$miss_acct remote_ok=$REMOTE_OK remote_fail=$REMOTE_FAIL remote_skip=$REMOTE_SKIP"
    # .convergence 기록 (V7)
    local CONV="$ROOT/.convergence"
    printf '%s airgenome-auth sync local_ok=%s remote_ok=%s remote_fail=%s remote_skip=%s\n' \
        "$(date '+%Y-%m-%d %H:%M:%S')" "$ok_acct" "$REMOTE_OK" "$REMOTE_FAIL" "$REMOTE_SKIP" >> "$CONV" 2>/dev/null || true
    [ "$REMOTE_OK" -eq 0 ] && [ "$REMOTE_FAIL" -gt 0 ] && return 1
    return 0
}

# ── cmd: status ──────────────────────────────────────────────────
cmd_status() {
    local as_json=0
    [ "${1:-}" = "--json" ] && as_json=1
    local accts; accts=$(_list_accounts)
    if [ "$as_json" = "1" ]; then
        echo "["; local first=1
        while IFS= read -r name; do
            [ -z "$name" ] && continue
            [ "$first" = "0" ] && echo ","
            first=0
            local svc; svc=$(_acct_keychain_service "$name")
            local has_kc=false has_local=false
            [ -n "$(_fetch_json "$svc")" ] && has_kc=true
            [ -f "$(_acct_dir "$name")/.credentials.json" ] && has_local=true
            printf '  {"account":"%s","keychain":%s,"local":%s}' \
                "$name" "$has_kc" "$has_local"
        done <<< "$accts"
        echo ""; echo "]"
        return 0
    fi
    # 사람 읽기 모드 — 매트릭스 간단본
    printf '%-10s %-8s %-8s %s\n' "account" "keychain" "local" "keychain-service"
    printf '%-10s %-8s %-8s %s\n' "-------" "--------" "-----" "----------------"
    while IFS= read -r name; do
        [ -z "$name" ] && continue
        local svc kc_mark local_mark
        svc=$(_acct_keychain_service "$name")
        [ -n "$(_fetch_json "$svc")" ] && kc_mark="OK" || kc_mark="MISS"
        [ -f "$(_acct_dir "$name")/.credentials.json" ] && local_mark="OK" || local_mark="MISS"
        printf '%-10s %-8s %-8s %s\n' "$name" "$kc_mark" "$local_mark" "$svc"
    done <<< "$accts"
}

# ── cmd: list ────────────────────────────────────────────────────
cmd_list() {
    _list_accounts
}

# ── cmd: login ───────────────────────────────────────────────────
# private-window 강제 → Safari 프로필 매핑 불필요.
cmd_login() {
    local name="${1:-}"
    [ -z "$name" ] && { echo "usage: airgenome-auth login <name>" >&2; return 2; }
    local dir; dir=$(_acct_dir "$name")
    mkdir -p "$dir"
    log "login: name=$name dir=$dir (private-window via oauth-bridge)"
    # OAUTH_TUNNEL_HOST=none — Mac-local login 이므로 tunnel 불필요.
    # claude /login 이 BROWSER 를 쓰지 않고 자기가 직접 브라우저 spawn — 한계.
    # 따라서 BROWSER=$ROOT/bin/open-on-mac → oauth-bridge 에서 private window.
    CLAUDE_CONFIG_DIR="$dir" BROWSER="$ROOT/bin/open-on-mac" \
        AIRGENOME_CLAUDE_SHIM=1 NO_CLAUDX=1 CL_NO_DOCKER=1 \
        claude /login
    local rc=$?
    [ $rc -eq 0 ] && log "  login OK name=$name — running sync..." || log "  login rc=$rc"
    cmd_sync
}

# ── cmd: refresh ─────────────────────────────────────────────────
cmd_refresh() {
    local target="${1:-}"
    if [ "$target" = "--all" ] || [ -z "$target" ]; then
        local accts; accts=$(_list_accounts)
        local n=0
        while IFS= read -r name; do
            [ -z "$name" ] && continue
            cmd_refresh "$name" || true
            n=$((n+1))
        done <<< "$accts"
        log "refresh --all: touched=$n"
        return 0
    fi
    local dir; dir=$(_acct_dir "$target")
    log "refresh: $target"
    if AIRGENOME_CLAUDE_SHIM=1 NO_CLAUDX=1 CL_NO_DOCKER=1 CLAUDE_CONFIG_DIR="$dir" \
        timeout 30 "${AIRGENOME_CLAUDE_CMD:-claude}" -p "ok" --max-turns 1 >/dev/null 2>&1; then
        return 0
    fi
    log "  refresh fail — token maybe revoked"
    return 1
}

# ── cmd: refresh-expired (Step B Phase 1) ────────────────────────
# keychain 의 expiresAt 이 현재 시각보다 과거인 계정만 골라서 refresh.
# --all 은 limit 걸린 계정까지 쿼터 소모시켜 위험 — 이 경량 변형이 creds-mirror
# daemon 보조용. launchd 주기 호출에 안전.
cmd_refresh_expired() {
    local accts; accts=$(_list_accounts)
    local now_ms=$(($(date +%s) * 1000))
    local refreshed=0 skipped_valid=0 skipped_empty=0 failed=0
    while IFS= read -r name; do
        [ -z "$name" ] && continue
        local service json exp
        service=$(_acct_keychain_service "$name")
        json=$(_fetch_json "$service")
        if [ -z "$json" ]; then
            skipped_empty=$((skipped_empty+1))
            continue
        fi
        exp=$(echo "$json" | jq -r '.claudeAiOauth.expiresAt // 0' 2>/dev/null)
        if [ -z "$exp" ] || [ "$exp" = "0" ]; then
            skipped_empty=$((skipped_empty+1))
            continue
        fi
        if [ "$exp" -gt "$now_ms" ] 2>/dev/null; then
            skipped_valid=$((skipped_valid+1))
            continue
        fi
        local age=$(( (now_ms - exp) / 1000 ))
        log "refresh-expired: $name (expired ${age}s ago)"
        if cmd_refresh_safe "$name"; then
            refreshed=$((refreshed+1))
        else
            failed=$((failed+1))
        fi
    done <<< "$accts"
    log "refresh-expired summary: refreshed=$refreshed valid_skipped=$skipped_valid empty_skipped=$skipped_empty failed=$failed"
    # mirror 쪽도 즉시 newest 반영 — creds-mirror daemon 이 곧 집어가지만 선제 호출.
    if [ -x "$ROOT/bin/creds-mirror" ] && [ "$refreshed" -gt 0 ]; then
        "$ROOT/bin/creds-mirror" --export >/dev/null 2>&1 && log "creds-mirror --export triggered"
    fi
    return 0
}

# ── cmd: guard — proactive refresh (launchd 10m 주기용) ──────────
# expiresAt 이 threshold_sec (기본 600s) 안에 도달한 계정을 refresh-safe 로 선제 갱신.
# race window 를 줄여 revoke 방지. refresh-safe 자체가 flock 을 가지므로 중복 실행 안전.
cmd_guard() {
    local threshold_sec="${GUARD_THRESHOLD_SEC:-600}"
    local accts; accts=$(_list_accounts)
    local now_ms=$(($(date +%s) * 1000))
    local cutoff_ms=$(( now_ms + threshold_sec * 1000 ))
    local refreshed=0 skipped=0 failed=0
    while IFS= read -r name; do
        [ -z "$name" ] && continue
        [ "$name" = "default" ] && continue
        local service json exp
        service=$(_acct_keychain_service "$name")
        json=$(_fetch_json "$service")
        [ -z "$json" ] && { skipped=$((skipped+1)); continue; }
        exp=$(echo "$json" | jq -r '.claudeAiOauth.expiresAt // 0' 2>/dev/null)
        if [ -z "$exp" ] || [ "$exp" = "0" ]; then
            skipped=$((skipped+1))
            continue
        fi
        if [ "$exp" -lt "$cutoff_ms" ] 2>/dev/null; then
            local delta=$(( (exp - now_ms) / 1000 ))
            log "guard: $name expires_in=${delta}s → refresh-safe"
            if cmd_refresh_safe "$name"; then
                refreshed=$((refreshed+1))
            else
                failed=$((failed+1))
            fi
        else
            skipped=$((skipped+1))
        fi
    done <<< "$accts"
    log "guard summary: refreshed=$refreshed skipped=$skipped failed=$failed threshold=${threshold_sec}s"
    return 0
}

# ── cmd: health-stats — token-health.jsonl 이벤트 집계 ───────────
# Phase 2 관측 증거 수집: N일간 refresh/rotate/revoke/drift 카운트 per acct.
cmd_health_stats() {
    local days="${1:-7}"
    local logfile="${CLAUDX_STATE:-$HOME/.airgenome/claudx}/token-health.jsonl"
    if [ ! -f "$logfile" ]; then
        echo "no token-health.jsonl — run refresh-safe first"
        return 0
    fi
    local cutoff; cutoff=$(($(date +%s) - days * 86400))
    printf '%-12s %-8s %-8s %-8s %-8s %-8s\n' "acct" "refresh" "rotate" "revoke" "drift" "oauth"
    jq -rs --argjson cutoff "$cutoff" '
      [ .[] | select(((.ts // "1970-01-01T00:00:00Z") | sub("\\.[0-9]+Z$"; "Z") | fromdateiso8601) >= $cutoff) ]
      | group_by(.acct // "<none>")
      | map({
          acct: (.[0].acct // "<none>"),
          refresh: (map(select(.event=="refresh")) | length),
          rotate:  (map(select(.event=="rotate"))  | length),
          revoke:  (map(select(.event=="revoke"))  | length),
          drift:   (map(select(.event=="drift"))   | length),
          oauth:   (map(select(.event=="oauth_request")) | length)
        })
      | sort_by(.acct)
      | .[] | "\(.acct)\t\(.refresh)\t\(.rotate)\t\(.revoke)\t\(.drift)\t\(.oauth)"
    ' "$logfile" 2>/dev/null | while IFS=$'\t' read -r a r o v d oa; do
        printf '%-12s %-8s %-8s %-8s %-8s %-8s\n' "$a" "$r" "$o" "$v" "$d" "$oa"
    done
    return 0
}

# ── cmd: cross-drift — 원격 host 의 expiresAt 과 mac 비교 ──────────
# Phase 2 관측: mac 과 원격의 .credentials.json expiresAt mismatch 검출.
cmd_cross_drift() {
    local host="${1:-ubu2}"
    local remote_raw
    remote_raw=$(ssh -o ConnectTimeout=5 -o BatchMode=yes "$host" '
        for f in ~/mac_home/.claude-*/.credentials.json; do
            [ -f "$f" ] || continue
            name=$(basename $(dirname "$f") | sed "s/^\\.claude-//")
            exp=$(jq -r ".claudeAiOauth.expiresAt // 0" "$f" 2>/dev/null)
            echo "$name $exp"
        done
    ' 2>/dev/null)
    if [ -z "$remote_raw" ]; then
        echo "cross-drift: $host 에서 결과 없음 (unreachable | no creds)" >&2
        return 1
    fi
    echo "cross-drift: mac vs $host"
    printf '%-12s %-18s %-18s %-12s\n' "acct" "mac_exp_ms" "remote_exp_ms" "status"
    local accts; accts=$(_list_accounts)
    while IFS= read -r name; do
        [ -z "$name" ] || [ "$name" = "default" ] && continue
        local mac_exp remote_exp status
        mac_exp=$(jq -r '.claudeAiOauth.expiresAt // 0' "$HOME/.claude-$name/.credentials.json" 2>/dev/null || echo 0)
        remote_exp=$(echo "$remote_raw" | awk -v n="$name" '$1==n {print $2; exit}')
        [ -z "$remote_exp" ] && remote_exp=0
        if [ "$remote_exp" = "0" ]; then
            status="remote_missing"
        elif [ "$mac_exp" = "$remote_exp" ]; then
            status="sync"
        elif [ "$mac_exp" -gt "$remote_exp" ] 2>/dev/null; then
            status="remote_stale"
        else
            status="mac_stale"
        fi
        printf '%-12s %-18s %-18s %-12s\n' "$name" "$mac_exp" "$remote_exp" "$status"
    done <<< "$accts"
    return 0
}

# ── cmd: refresh-safe — flock + rotation capture + audit ─────────
# 계정별 단일 refresh 보장 (mkdir atomic lock). 전/후 refresh_token 해시 비교
# 로 rotation 감지, 결과 token-health.jsonl 에 기록.
#
# Phase 1 한계:
# - rotation 은 claude CLI 의 write 에 위임 — 우리는 관측만.
# - lock 은 mac 단일호스트 유효. cross-host race 방어는 Phase 2 (coordinator).
cmd_refresh_safe() {
    local target="${1:-}"
    [ -z "$target" ] && { echo "usage: refresh-safe <name>" >&2; return 2; }
    local dir; dir=$(_acct_dir "$target")
    [ -z "$dir" ] && { log "refresh-safe: unknown acct $target"; return 2; }

    local lock_dir="$HOME/.airgenome/claudx/locks/refresh-${target}.lockd"
    mkdir -p "$(dirname "$lock_dir")"
    # stale lock: 5분 이상이면 강제 제거 (프로세스 크래시 복구)
    if [ -d "$lock_dir" ]; then
        local age
        age=$(( $(date +%s) - $(stat -f %m "$lock_dir" 2>/dev/null || echo 0) ))
        if [ "$age" -gt 300 ]; then
            log "refresh-safe $target: stale lock ${age}s → reclaim"
            rmdir "$lock_dir" 2>/dev/null || true
        fi
    fi
    if ! mkdir "$lock_dir" 2>/dev/null; then
        log "refresh-safe $target: lock busy — skip"
        return 2
    fi

    local old_rt new_rt refresh_result event
    old_rt=$(node "$ROOT/shared/claudx/token-core.js" probe "$dir" 2>/dev/null | jq -r '.fp.file.rt // ""')

    log "refresh-safe $target: begin (old_rt=${old_rt:-<none>})"
    if AIRGENOME_CLAUDE_SHIM=1 NO_CLAUDX=1 CL_NO_DOCKER=1 CLAUDE_CONFIG_DIR="$dir" \
        timeout 30 "${AIRGENOME_CLAUDE_CMD:-claude}" -p "ok" --max-turns 1 >/dev/null 2>&1; then
        refresh_result="ok"
    else
        refresh_result="failed"
    fi

    new_rt=$(node "$ROOT/shared/claudx/token-core.js" probe "$dir" 2>/dev/null | jq -r '.fp.file.rt // ""')

    if [ "$refresh_result" = "ok" ] && [ -n "$new_rt" ] && [ "$old_rt" != "$new_rt" ]; then
        event="rotate"
    elif [ "$refresh_result" = "ok" ]; then
        event="refresh"
    else
        event="revoke"
    fi

    AG_WRITER=airgenome-auth node "$ROOT/shared/claudx/token-health.js" append \
        "{\"acct\":\"$target\",\"event\":\"$event\",\"old_rt_sha8\":\"$old_rt\",\"new_rt_sha8\":\"$new_rt\",\"result\":\"$refresh_result\",\"reason\":\"airgenome-auth refresh-safe\"}" >/dev/null

    log "refresh-safe $target: $event ($refresh_result) old=$old_rt new=$new_rt"
    rmdir "$lock_dir" 2>/dev/null || true
    [ "$refresh_result" = "ok" ]
}

# ── cmd: drift — file vs KC refresh_token 해시 비교 (읽기만) ──────
cmd_drift() {
    local json_mode=0
    [ "${1:-}" = "--json" ] && json_mode=1
    local out
    out=$(node "$ROOT/shared/claudx/token-core.js" probe-all) || {
        log "drift: token-core probe-all 실패"
        return 1
    }
    if [ $json_mode -eq 1 ]; then
        printf '%s\n' "$out"
        return 0
    fi
    # 테이블 포맷 + drift 이벤트 기록
    printf '%-10s %-12s %-6s %-10s %-20s\n' "acct" "source" "alive" "drift" "file_exp"
    printf '%s\n' "$out" | jq -r '.[] | [.name, .source, (.alive|tostring), .drift, (.file_exp//"-")] | @tsv' | \
        while IFS=$'\t' read -r name source alive drift fexp; do
            printf '%-10s %-12s %-6s %-10s %-20s\n' "$name" "$source" "$alive" "$drift" "$fexp"
            if [ "$drift" != "in_sync" ] && [ "$drift" != "both_missing" ]; then
                AG_WRITER=airgenome-auth node "$ROOT/shared/claudx/token-health.js" append \
                    "{\"acct\":\"$name\",\"event\":\"drift\",\"result\":\"$drift\",\"reason\":\"airgenome-auth drift\"}" >/dev/null
            fi
        done
    return 0
}

# ── cmd: doctor — 12계정 전체 매트릭스 ──────────────────────────
cmd_doctor() {
    local json_mode=0
    [ "${1:-}" = "--json" ] && json_mode=1
    local probe exhausted usage
    probe=$(node "$ROOT/shared/claudx/token-core.js" probe-all) || return 1
    exhausted=$(cat "$HOME/.airgenome/claudx/exhausted.json" 2>/dev/null || echo '{}')
    usage=$(cat "$HOME/Dev/nexus/shared/.runtime/accounts/usage-cache.json" 2>/dev/null || echo '{}')
    local merged
    merged=$(node --input-type=module -e '
        import fs from "fs";
        const probe = JSON.parse(process.argv[1]);
        const ex = JSON.parse(process.argv[2]);
        const u = JSON.parse(process.argv[3]);
        const now = Math.floor(Date.now()/1000);
        const rows = probe.map(p => ({
          name: p.name,
          source: p.source,
          alive: p.alive,
          has_refresh: p.has_refresh,
          drift: p.drift,
          session_pct: (u[p.name]||{}).session_pct || 0,
          week_pct: (u[p.name]||{}).week_all_pct || 0,
          exhausted_until: (ex[p.name]||{}).until || null,
          exh_active: !!((ex[p.name]||{}).until > now),
          file_exp: p.file_exp,
        }));
        process.stdout.write(JSON.stringify(rows, null, 2));
    ' "$probe" "$exhausted" "$usage" 2>&1) || { log "doctor: merge 실패: $merged"; return 1; }
    if [ $json_mode -eq 1 ]; then
        printf '%s\n' "$merged"
        return 0
    fi
    printf '%-10s %-12s %-6s %-8s %-7s %-6s %-6s %-8s\n' "acct" "source" "alive" "refresh" "drift" "sess%" "week%" "exh"
    printf '%s\n' "$merged" | jq -r '.[] | [.name, .source, (.alive|tostring), (.has_refresh|tostring), .drift, .session_pct, .week_pct, (.exh_active|tostring)] | @tsv' | \
        while IFS=$'\t' read -r name source alive refr drift sess week exh; do
            printf '%-10s %-12s %-6s %-8s %-7s %-6s %-6s %-8s\n' "$name" "$source" "$alive" "$refr" "$drift" "$sess" "$week" "$exh"
        done
    return 0
}

# ── cmd: self-test ───────────────────────────────────────────────
_self_test() {
    local rc=0
    echo "  ✓ bash parse"
    for c in shasum security jq ssh scp tar; do
        if command -v "$c" >/dev/null 2>&1; then
            echo "  ✓ $c available"
        else
            echo "  ✗ $c missing" >&2
            rc=1
        fi
    done
    # hash 검증 — 알려진 값
    h=$(_hash_path "/Users/ghost/.claude-claude5")
    if [ "$h" = "7f9319ca" ]; then
        echo "  ✓ _hash_path 정상 (claude5=7f9319ca)"
    else
        echo "  ✗ _hash_path 오동작 (claude5=$h, expected 7f9319ca)" >&2
        rc=1
    fi
    local accts; accts=$(_list_accounts | wc -l | tr -d ' ')
    echo "  ✓ accounts discovered: $accts"
    # auth-plane 단위/통합 스위트 실행 (tests/auth-plane/run-all.sh)
    # 재진입 가드: suite 내부 테스트가 self-test 를 다시 부를 수 있으므로 env flag 로 skip.
    if [ "${AIRGENOME_AUTH_IN_SUITE:-0}" = "1" ]; then
        echo "  ▸ auth-plane suite (nested) — skipped"
    else
        local suite="$ROOT/tests/auth-plane/run-all.sh"
        if [ -f "$suite" ]; then
            echo "  ▸ running auth-plane suite"
            if AIRGENOME_AUTH_IN_SUITE=1 bash "$suite" >/dev/null 2>&1; then
                echo "  ✓ auth-plane suite ALL GREEN"
            else
                echo "  ✗ auth-plane suite FAIL — run '$suite' for details" >&2
                rc=1
            fi
        else
            echo "  ⚠ auth-plane suite not found at $suite" >&2
        fi
    fi
    [ $rc -eq 0 ] && echo "self-test: PASS" || echo "self-test: FAIL"
    return $rc
}

# ── dispatch ─────────────────────────────────────────────────────
sub="${1:-}"
shift || true
case "$sub" in
    -h|--help|help|"") _usage; exit 0 ;;
    self-test)         _self_test; exit $? ;;
    sync)              cmd_sync; exit $? ;;
    status)            cmd_status "$@"; exit $? ;;
    list)              cmd_list; exit $? ;;
    login)             cmd_login "$@"; exit $? ;;
    refresh)           cmd_refresh "$@"; exit $? ;;
    refresh-expired)   cmd_refresh_expired; exit $? ;;
    refresh-safe)      cmd_refresh_safe "$@"; exit $? ;;
    guard)             cmd_guard "$@"; exit $? ;;
    health-stats)      cmd_health_stats "$@"; exit $? ;;
    cross-drift)       cmd_cross_drift "$@"; exit $? ;;
    drift)             cmd_drift "$@"; exit $? ;;
    doctor)            cmd_doctor "$@"; exit $? ;;
    *)                 echo "airgenome-auth: unknown '$sub'" >&2; exit 2 ;;
esac
