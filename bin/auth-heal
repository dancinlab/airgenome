#!/usr/bin/env bash
# airgenome/bin/auth-heal — thin wrapper 로 축소 (2026-04-20).
#
# v2 이전: 단일 default credentials 만 Mac → 3호스트 이식.
# v2 현재: bin/airgenome-auth 가 SHA256 path-hash 로 12 계정 전수 sync.
#   auth-heal 는 launchd 스케줄 호환용 wrapper — `airgenome-auth sync` 실행만.
#
# 직접 수정 금지 — airgenome-auth 가 SSOT.

set -euo pipefail
ROOT="${AIRGENOME_ROOT:-$HOME/Dev/airgenome}"
exec "$ROOT/bin/airgenome-auth" sync
