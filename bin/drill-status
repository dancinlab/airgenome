#!/bin/bash
# drill-status — quick view of current drill from live log + remote process state
LOG="${DRILL_LIVE_LOG:-$HOME/.airgenome/drill.live.log}"
echo "=== Mac log (last 8 lines) ==="
tail -8 "$LOG" 2>/dev/null || echo "  (log not found: $LOG)"
echo ""
echo "=== hetzner drill processes ==="
ssh -o ConnectTimeout=5 hetzner 'ps axo etimes,rss,comm,args | grep -E "(blowup|nexus_cli/run.hexa drill|hexa_real run)" | grep -v grep | head -5; echo "---"; free -h | head -2' 2>&1 | head -10
echo ""
echo "=== Mac state ==="
ls /tmp/nexus_heavy_dispatch.slot*.lock 2>/dev/null | head -3
ls /tmp/hexa_remote.blacklist.* 2>/dev/null | head -3 | sed 's|^|  blacklist: |'
