// bin/tg_bot.hexa — M15 Telegram bot (iOS → Mac/ubu claude dispatcher)
//
// 책임:
//   1. ~/.airgenome/tg.json 로드 → bot_token_file 에서 token 읽기
//   2. primary_host == hostname 검증 (아니면 STANDBY 종료 — dual-host 안전)
//   3. single-instance lock (~/.airgenome/tg_leader.lock, mkdir atomic)
//   4. Long-poll getUpdates (timeout=25s)
//   5. whitelist chat_id filter (아니면 WARN 만)
//   6. message.text → claude -p "<text>" 디스패치 (NO_CLAUDX=1), stdout → sendMessage
//   7. 4096자 chunk 분할 전송
//   8. offset 영속 (~/.airgenome/tg_offset.json)
//   9. 에러 백오프 5s
//
// hexa-lang quirks 회피:
//   - list.push(x) no-op → `list = list + [x]`
//   - to_string(void) → "void" JSON 오염 가드 (숫자 함수 void 반환 금지)
//   - 전역 let 상수 if 비교 X (로컬 복사)
//   - exec() 결과 trim
//   - use "..." import 금지 (stage0 parse error)
//   - try/catch 없음
//
// Usage:
//   포그라운드:  ~/.hx/bin/hexa run bin/tg_bot.hexa
//   ONCE:        TG_ONCE=1 ~/.hx/bin/hexa run bin/tg_bot.hexa  (한 번 poll 후 exit)
//   self-test:   ~/.hx/bin/hexa run bin/tg_bot.hexa self-test
//   dry dispatch: TG_DRY=1 ~/.hx/bin/hexa run bin/tg_bot.hexa  (claude 호출 대신 echo)

let HOME = env("HOME")
let CONFIG_PATH = HOME + "/.airgenome/tg.json"
let OFFSET_PATH = HOME + "/.airgenome/tg_offset.json"
let LOCK_DIR = HOME + "/.airgenome/tg_leader.lock"
let LOG_PATH = HOME + "/.airgenome/tg_bot.log"
let POLL_TIMEOUT = 25
let HTTP_TIMEOUT = 40
let BACKOFF = 5
let CHUNK_SIZE = 4000   // < telegram 4096 limit, safe margin for JSON-escape inflation

// ═══════════════════════════════════════════════════════════════════════
//  UTIL
// ═══════════════════════════════════════════════════════════════════════

fn ts_iso() -> str {
    return exec("date -u +%Y-%m-%dT%H:%M:%SZ").trim()
}

fn ts_epoch() -> int {
    return to_int(exec("date +%s").trim())
}

fn json_safe(s: str) -> str {
    // Telegram sendMessage accepts plain text — we only need to escape for
    // our own JSON log lines. Strip control chars + quotes + backslash.
    let a = s.replace("\\", "\\\\")
    let b = a.replace("\"", "\\\"")
    let c = b.replace("\n", "\\n")
    let d = c.replace("\r", "")
    let e = d.replace("\t", " ")
    return e
}

fn log_line(level: str, msg: str) -> void {
    let _ = exec("mkdir -p '" + HOME + "/.airgenome'")
    let line = "{\"ts\":\"" + ts_iso() + "\",\"level\":\"" + level + "\",\"msg\":\"" + json_safe(msg) + "\"}"
    let _ = exec("printf '%s\\n' " + shell_quote(line) + " >> '" + LOG_PATH + "'")
    println("[" + level + "] " + msg)
}

fn shell_quote(s: str) -> str {
    // single-quote wrap + escape embedded single-quote with '\''
    let esc = s.replace("'", "'\\''")
    return "'" + esc + "'"
}

fn host_name() -> str {
    return exec("hostname").trim()
}

// hexa-lang has no string slice — use `awk` on a temp file (heredoc leaks via exec).
// start/end are 0-based, end-exclusive.
fn str_sub(s: str, start: int, end: int) -> str {
    let e = end
    let mut st = start
    if st < 0 { st = 0 }
    if e <= st { return "" }
    let len_n = e - st
    let tmp = HOME + "/.airgenome/.tg_sub." + to_string(ts_epoch())
    let _ = write_file(tmp, s)
    // awk substr is 1-based; read whole file (RS=\0) so newlines preserved. ORS="" → no trailing NL.
    let prog = "BEGIN{RS=\"\\0\";ORS=\"\"} {print substr($0," + to_string(st + 1) + "," + to_string(len_n) + ")}"
    let cmd = "awk " + shell_quote(prog) + " '" + tmp + "' 2>/dev/null; rm -f '" + tmp + "'"
    let out = exec(cmd)
    if to_string(out) == "void" { return "" }
    return out
}

fn truncate(s: str, n: int) -> str {
    // Safe prefix of up to n chars for log messages.
    if len(s) <= n { return s }
    return str_sub(s, 0, n)
}

// ═══════════════════════════════════════════════════════════════════════
//  CONFIG
// ═══════════════════════════════════════════════════════════════════════

struct Config {
    token: str,
    whitelist: list,      // list of int
    primary_host: str,
    dispatch: str,        // "cl" or "cx"
    claude_bin: str,
    cx_bin: str,
    dispatch_timeout: int,
    bot_username: str
}

fn load_config() -> Config {
    let exists = exec("test -f '" + CONFIG_PATH + "' && echo y || echo n").trim()
    if exists != "y" {
        panic("config missing: " + CONFIG_PATH)
    }
    let token_file = exec("jq -r '.bot_token_file // empty' '" + CONFIG_PATH + "' 2>/dev/null").trim()
    if token_file == "" { panic("tg.json missing bot_token_file") }
    let tok_exists = exec("test -f '" + token_file + "' && echo y || echo n").trim()
    if tok_exists != "y" { panic("bot token file missing: " + token_file) }
    let tok = exec("cat '" + token_file + "' 2>/dev/null").trim()
    if tok == "" { panic("bot token empty") }

    // whitelist array of ints
    let wl_raw = exec("jq -r '.whitelist[]? // empty' '" + CONFIG_PATH + "' 2>/dev/null").trim()
    let wl = []
    let mut wl_list = wl
    if wl_raw != "" {
        let parts = wl_raw.split("\n")
        let mut i = 0
        while i < len(parts) {
            let s = parts[i].trim()
            if s != "" { wl_list = wl_list + [to_int(s)] }
            i = i + 1
        }
    }

    let ph = exec("jq -r '.primary_host // empty' '" + CONFIG_PATH + "' 2>/dev/null").trim()
    let dispatch = exec("jq -r '.dispatch // \"cl\"' '" + CONFIG_PATH + "' 2>/dev/null").trim()
    let cb = exec("jq -r '.claude_bin // empty' '" + CONFIG_PATH + "' 2>/dev/null").trim()
    let xb = exec("jq -r '.cx_bin // empty' '" + CONFIG_PATH + "' 2>/dev/null").trim()
    let dt_s = exec("jq -r '.dispatch_timeout // 180' '" + CONFIG_PATH + "' 2>/dev/null").trim()
    let bu = exec("jq -r '.bot_username // empty' '" + CONFIG_PATH + "' 2>/dev/null").trim()

    let mut dt = 180
    if dt_s != "" { dt = to_int(dt_s) }
    if dt <= 0 { dt = 180 }

    let mut claude_fallback = cb
    if claude_fallback == "" { claude_fallback = "claude" }
    let mut cx_fallback = xb
    if cx_fallback == "" { cx_fallback = "cx" }

    return Config {
        token: tok,
        whitelist: wl_list,
        primary_host: ph,
        dispatch: dispatch,
        claude_bin: claude_fallback,
        cx_bin: cx_fallback,
        dispatch_timeout: dt,
        bot_username: bu
    }
}

fn in_whitelist(chat_id: int, wl: list) -> bool {
    let mut i = 0
    while i < len(wl) {
        if wl[i] == chat_id { return true }
        i = i + 1
    }
    return false
}

// ═══════════════════════════════════════════════════════════════════════
//  LOCK (mkdir-based — works on Mac without flock)
// ═══════════════════════════════════════════════════════════════════════

fn acquire_lock() -> bool {
    // mkdir is atomic on POSIX; succeeds only if dir not yet exist.
    let r = exec("mkdir '" + LOCK_DIR + "' 2>&1; echo RC=$?").trim()
    if r.contains("RC=0") { return true }
    // Stale detection — if mtime older than 60s, remove and retry once.
    let age = exec("stat -f %m '" + LOCK_DIR + "' 2>/dev/null || stat -c %Y '" + LOCK_DIR + "' 2>/dev/null").trim()
    if age == "" { return false }
    let now = ts_epoch()
    let m = to_int(age)
    if (now - m) > 60 {
        let _ = exec("rmdir '" + LOCK_DIR + "' 2>/dev/null || rm -rf '" + LOCK_DIR + "'")
        let r2 = exec("mkdir '" + LOCK_DIR + "' 2>&1; echo RC=$?").trim()
        if r2.contains("RC=0") { return true }
    }
    return false
}

fn touch_lock() -> void {
    // Use a sentinel file INSIDE the lock dir — `touch` of the dir-itself would
    // (harmlessly) update dir mtime on Linux but the dir must exist first.
    // We also touch the dir itself for Mac stat -f %m.
    let _ = exec("[ -d '" + LOCK_DIR + "' ] && touch '" + LOCK_DIR + "/heartbeat' 2>/dev/null && touch '" + LOCK_DIR + "' 2>/dev/null || true")
}

fn release_lock() -> void {
    let _ = exec("rm -rf '" + LOCK_DIR + "' 2>/dev/null")
}

// ═══════════════════════════════════════════════════════════════════════
//  OFFSET PERSISTENCE
// ═══════════════════════════════════════════════════════════════════════

fn load_offset() -> int {
    let exists = exec("test -f '" + OFFSET_PATH + "' && echo y || echo n").trim()
    if exists != "y" { return 0 }
    let s = exec("jq -r '.offset // 0' '" + OFFSET_PATH + "' 2>/dev/null").trim()
    if s == "" { return 0 }
    return to_int(s)
}

fn save_offset(off: int) -> void {
    let _ = exec("mkdir -p '" + HOME + "/.airgenome'")
    let line = "{\"offset\":" + to_string(off) + ",\"ts\":\"" + ts_iso() + "\"}"
    let tmp = OFFSET_PATH + ".tmp"
    let _ = exec("printf '%s\\n' " + shell_quote(line) + " > '" + tmp + "' && mv '" + tmp + "' '" + OFFSET_PATH + "'")
}

// ═══════════════════════════════════════════════════════════════════════
//  TELEGRAM API
// ═══════════════════════════════════════════════════════════════════════

fn api_base(token: str) -> str {
    return "https://api.telegram.org/bot" + token
}

// Poll with long timeout. Returns raw JSON response or "" on failure.
fn get_updates(token: str, offset: int) -> str {
    let url = api_base(token) + "/getUpdates?offset=" + to_string(offset) + "&timeout=" + to_string(POLL_TIMEOUT)
    let cmd = "curl -sS --max-time " + to_string(HTTP_TIMEOUT) + " '" + url + "' 2>/dev/null || true"
    let out = exec(cmd)
    // hexa-lang to_string(void) → "void" guard
    if to_string(out) == "void" { return "" }
    return out
}

// send plain text. returns true on ok.
fn send_message(token: str, chat_id: int, text: str) -> bool {
    let url = api_base(token) + "/sendMessage"
    // Write text to temp file and use --data-urlencode text@<file> (curl reads the file).
    let tmp = HOME + "/.airgenome/.tg_out." + to_string(ts_epoch()) + "." + to_string(chat_id)
    let _ = write_file(tmp, text)
    let cmd = "curl -sS --max-time " + to_string(HTTP_TIMEOUT)
            + " -X POST '" + url + "'"
            + " --data-urlencode 'chat_id=" + to_string(chat_id) + "'"
            + " --data-urlencode 'text@" + tmp + "'"
            + " 2>&1; rm -f '" + tmp + "'"
    let out = exec(cmd)
    if to_string(out) == "void" { return false }
    if out.contains("\"ok\":true") { return true }
    return false
}

fn send_chunks(token: str, chat_id: int, text: str) -> void {
    let total = len(text)
    if total == 0 {
        let _ = send_message(token, chat_id, "(빈 응답)")
        return
    }
    let mut pos = 0
    let mut part = 1
    while pos < total {
        let remaining = total - pos
        let mut take = CHUNK_SIZE
        if take > remaining { take = remaining }
        let piece = str_sub(text, pos, pos + take)
        let _ = send_message(token, chat_id, piece)
        pos = pos + take
        part = part + 1
        // tiny gap to avoid 429
        if pos < total { let _ = exec("sleep 1") }
    }
}

// ═══════════════════════════════════════════════════════════════════════
//  DISPATCH — claude/cx
// ═══════════════════════════════════════════════════════════════════════

fn dispatch_claude(cfg: Config, text: str) -> str {
    if env("TG_DRY") == "1" {
        return "[DRY] 디스패치 예정: " + text
    }
    let timeout_s = to_string(cfg.dispatch_timeout)
    let dispatch_mode = cfg.dispatch
    let claude = cfg.claude_bin
    let cx = cfg.cx_bin
    // Write text to temp file (hexa exec heredoc quirk — the shell body leaks
    // into captured stdout when using <<'TAG'\n...\nTAG\n patterns).
    let tmp = HOME + "/.airgenome/.tg_in." + to_string(ts_epoch())
    let _ = write_file(tmp, text)
    let mut cmd = ""
    if dispatch_mode == "cx" {
        cmd = "NO_CLAUDX=1 timeout " + timeout_s + " " + cx
            + " --docker --force-host ubu -p \"$(cat '" + tmp + "')\" 2>&1"
    } else {
        cmd = "NO_CLAUDX=1 timeout " + timeout_s + " " + claude
            + " -p \"$(cat '" + tmp + "')\" --max-turns 1 2>&1"
    }
    cmd = cmd + "; rm -f '" + tmp + "'"
    let out = exec(cmd)
    if to_string(out) == "void" { return "(디스패치 결과 void)" }
    return out
}

// ═══════════════════════════════════════════════════════════════════════
//  UPDATE PARSING — jq per update
// ═══════════════════════════════════════════════════════════════════════

struct Update {
    update_id: int,
    chat_id: int,
    from_id: int,
    text: str,
    ok: bool
}

// Use jq to extract structured updates from raw response → newline-separated TSV.
// Fields: update_id\tchat_id\tfrom_id\ttext
// text is JSON-unescaped by jq; tabs/newlines stripped to keep 1-record-per-line.
fn parse_updates(raw: str) -> list {
    let out_list = []
    let mut acc = out_list
    if raw == "" { return acc }
    // jq filter: select only updates with message.text
    let filter = ".result[]? | select(.message.text != null) | [(.update_id|tostring), (.message.chat.id|tostring), (.message.from.id|tostring), (.message.text|gsub(\"\\t\";\" \")|gsub(\"\\n\";\" \"))] | @tsv"
    // Write raw to temp file (hexa exec heredoc streams shell body to stdout — bug workaround).
    let tmp = HOME + "/.airgenome/.tg_raw." + to_string(ts_epoch())
    let _ = write_file(tmp, raw)
    let cmd = "jq -r " + shell_quote(filter) + " '" + tmp + "' 2>/dev/null; rm -f '" + tmp + "'"
    let tsv = exec(cmd).trim()
    if tsv == "" { return acc }
    let lines = tsv.split("\n")
    let mut i = 0
    while i < len(lines) {
        let line = lines[i]
        if line != "" {
            let f = line.split("\t")
            if len(f) >= 4 {
                let uid = to_int(f[0].trim())
                let cid = to_int(f[1].trim())
                let fid = to_int(f[2].trim())
                let txt = f[3]
                acc = acc + [Update {
                    update_id: uid, chat_id: cid, from_id: fid, text: txt, ok: true
                }]
            }
        }
        i = i + 1
    }
    return acc
}

// ═══════════════════════════════════════════════════════════════════════
//  SLASH COMMANDS — host health / service control / log tail / drill
// ═══════════════════════════════════════════════════════════════════════
//
// Design:
//   - every command runs in the tg_bot process (Mac) and shells out via ssh
//     to reach ubu/ubu2/hetzner. Mac self-state via direct exec.
//   - destructive commands (/deploy) require `confirm <token>` second arg
//     and only from whitelisted chat_id.
//   - shell injection blocked by whitelisting tokens BEFORE interpolation.
//
// Host map (bin/cx hosts.json SSOT):
//   ubu  → ssh alias `ubu`,  slice: airgenome-claude.service
//   ubu2 → ssh alias `ubu2`, slice: airgenome-claude.service
//   htz  → ssh alias `hetzner`
//   mac  → local (launchctl com.airgenome.tg-bot etc.)

let CMD_TIMEOUT_SHORT = 15   // /status /drill — quick polls
let CMD_TIMEOUT_MED   = 30   // /logs /tail
// /soak: user-specified duration + margin

// Whitelisted ssh aliases — anything not in this list is rejected.
fn ssh_alias_allowed(h: str) -> bool {
    if h == "ubu" { return true }
    if h == "ubu2" { return true }
    if h == "hetzner" { return true }
    if h == "htz" { return true }
    return false
}

// Whitelisted services for /deploy — anything not in this list is rejected.
fn service_allowed(s: str) -> bool {
    if s == "airgenome-claude" { return true }
    if s == "airgenome-runaway" { return true }
    if s == "tg-bot" { return true }
    return false
}

// Canonical mac-only alias → actual ssh Host entry.
fn ssh_host_of(h: str) -> str {
    if h == "htz" { return "hetzner" }
    return h
}

// Safe string token check — only [A-Za-z0-9_.-], empty allowed=false.
// hexa-lang has no working string < / > / <= / >= — delegate to awk regex.
fn safe_token(s: str) -> bool {
    if s == "" { return false }
    if len(s) > 64 { return false }
    // awk -v s="$s" 'BEGIN{ if (s ~ /^[A-Za-z0-9_.-]+$/) print 1; else print 0 }'
    let cmd = "awk -v s=" + shell_quote(s) + " 'BEGIN{ if (s ~ /^[A-Za-z0-9_.-]+$/) print 1; else print 0 }' 2>/dev/null"
    let out = exec(cmd).trim()
    if out == "1" { return true }
    return false
}

// Split "command arg1 arg2..." by whitespace — collapses runs.
fn split_ws(s: str) -> list {
    let out = []
    let mut acc = out
    let tr = s.trim()
    if tr == "" { return acc }
    // Normalize tabs to spaces then split.
    let norm = tr.replace("\t", " ")
    let parts = norm.split(" ")
    let mut i = 0
    while i < len(parts) {
        let p = parts[i].trim()
        if p != "" { acc = acc + [p] }
        i = i + 1
    }
    return acc
}

// Run a command with timeout and return combined stdout/stderr (trimmed).
fn run_remote(alias: str, remote_cmd: str, timeout_s: int) -> str {
    let host = ssh_host_of(alias)
    if !ssh_alias_allowed(host) { return "(rejected alias: " + alias + ")" }
    // ssh -o BatchMode=yes + ConnectTimeout + remote timeout wrapper.
    let cmd = "timeout " + to_string(timeout_s + 5)
            + " ssh -o BatchMode=yes -o ConnectTimeout=5 -o ServerAliveInterval=5"
            + " " + host + " "
            + shell_quote("timeout " + to_string(timeout_s) + " bash -lc " + shell_quote(remote_cmd))
            + " 2>&1"
    let out = exec(cmd)
    if to_string(out) == "void" { return "(void)" }
    return out.trim()
}

fn run_local(local_cmd: str, timeout_s: int) -> str {
    let cmd = "timeout " + to_string(timeout_s) + " bash -lc " + shell_quote(local_cmd) + " 2>&1"
    let out = exec(cmd)
    if to_string(out) == "void" { return "(void)" }
    return out.trim()
}

// ─── /help ────────────────────────────────────────────────────────────
fn cmd_help() -> str {
    let b = ""
    let mut s = b + "airgenome tg bot — 명령어 목록\n"
    s = s + "\n"
    s = s + "/status           — 전체 호스트 건강 요약 (uptime, load, docker, claude/hexa 수)\n"
    s = s + "/wake             — 최근 30분 에이전트/백그라운드 활동 요약\n"
    s = s + "/soak <min>       — runaway guard soak 실행 (기본 15분, 최대 120분)\n"
    s = s + "/deploy <svc>     — 서비스 재기동 (confirm 토큰 필요)\n"
    s = s + "                    svc: airgenome-claude | airgenome-runaway | tg-bot\n"
    s = s + "/logs <host> [N]  — journalctl 최근 N줄 (기본 20)\n"
    s = s + "                    host: ubu | ubu2 | hetzner\n"
    s = s + "/tail             — airgenome 1분 상태 요약\n"
    s = s + "/drill            — 고부하 프로세스 점검 (CPU 상위)\n"
    s = s + "/help             — 이 도움말\n"
    s = s + "\n"
    s = s + "(/로 시작하지 않는 메시지는 claude -p 로 디스패치됩니다)\n"
    return s
}

// ─── /status ──────────────────────────────────────────────────────────
fn host_status_block(alias: str) -> str {
    let up = run_remote(alias, "uptime 2>&1 | tr -s ' '", CMD_TIMEOUT_SHORT)
    let load = run_remote(alias, "awk '{print $1\" \"$2\" \"$3}' /proc/loadavg 2>/dev/null", CMD_TIMEOUT_SHORT)
    let docker = run_remote(alias, "command -v docker >/dev/null && docker ps --format '{{.Names}}' 2>/dev/null | wc -l || echo 0", CMD_TIMEOUT_SHORT)
    let claude_n = run_remote(alias, "pgrep -x claude 2>/dev/null | wc -l || echo 0", CMD_TIMEOUT_SHORT)
    let hexa_n = run_remote(alias, "pgrep -x hexa 2>/dev/null | wc -l || echo 0", CMD_TIMEOUT_SHORT)
    let mut s = "[" + alias + "]\n"
    s = s + "  up:     " + truncate(up, 120) + "\n"
    s = s + "  load:   " + truncate(load, 80) + "\n"
    s = s + "  docker: " + truncate(docker, 20) + " 컨테이너\n"
    s = s + "  claude: " + truncate(claude_n, 20) + "  hexa: " + truncate(hexa_n, 20) + "\n"
    return s
}

fn mac_status_block() -> str {
    let up = run_local("uptime 2>&1 | tr -s ' '", CMD_TIMEOUT_SHORT)
    let load = run_local("sysctl -n vm.loadavg 2>/dev/null | tr -d '{}' | awk '{print $1\" \"$2\" \"$3}'", CMD_TIMEOUT_SHORT)
    let tg_running = run_local("launchctl list 2>/dev/null | awk '$3==\"com.airgenome.tg-bot\"{print $1}'", CMD_TIMEOUT_SHORT)
    let claude_n = run_local("pgrep -x claude 2>/dev/null | wc -l | tr -d ' '", CMD_TIMEOUT_SHORT)
    let hexa_n = run_local("pgrep -x hexa 2>/dev/null | wc -l | tr -d ' '", CMD_TIMEOUT_SHORT)
    let mut s = "[mac]\n"
    s = s + "  up:     " + truncate(up, 120) + "\n"
    s = s + "  load:   " + truncate(load, 80) + "\n"
    s = s + "  tg-bot pid: " + truncate(tg_running, 20) + "\n"
    s = s + "  claude: " + truncate(claude_n, 20) + "  hexa: " + truncate(hexa_n, 20) + "\n"
    return s
}

fn cmd_status() -> str {
    let b = ""
    let mut s = b + "# 호스트 상태 (" + ts_iso() + ")\n\n"
    s = s + mac_status_block() + "\n"
    s = s + host_status_block("ubu") + "\n"
    s = s + host_status_block("ubu2") + "\n"
    s = s + host_status_block("hetzner") + "\n"
    return s
}

// ─── /wake — recent activity ─────────────────────────────────────────
fn cmd_wake() -> str {
    let b = ""
    let mut s = b + "# 최근 활동 (" + ts_iso() + ", 최근 30분)\n\n"
    // Mac: recent tg_bot log + executor.jsonl + dispatch log tail
    let tg_tail = run_local("tail -n 8 " + HOME + "/.airgenome/tg_bot.log 2>/dev/null", CMD_TIMEOUT_SHORT)
    s = s + "[mac tg_bot 최근]\n" + truncate(tg_tail, 800) + "\n\n"
    let exec_tail = run_local("tail -n 6 " + HOME + "/.airgenome/executor.jsonl 2>/dev/null", CMD_TIMEOUT_SHORT)
    s = s + "[mac executor 최근]\n" + truncate(exec_tail, 800) + "\n\n"
    // Remote: journalctl --since 30min ago airgenome-claude
    let ubu_log = run_remote("ubu", "journalctl --user -u airgenome-claude --since '30 min ago' -n 5 --no-pager 2>&1 | tail -n 5", CMD_TIMEOUT_MED)
    s = s + "[ubu claude 최근]\n" + truncate(ubu_log, 800) + "\n\n"
    let ubu2_log = run_remote("ubu2", "journalctl --user -u airgenome-claude --since '30 min ago' -n 5 --no-pager 2>&1 | tail -n 5", CMD_TIMEOUT_MED)
    s = s + "[ubu2 claude 최근]\n" + truncate(ubu2_log, 800) + "\n"
    return s
}

// ─── /soak <min> — runaway guard soak ────────────────────────────────
fn cmd_soak(mins: int) -> str {
    let mut m = mins
    if m <= 0 { m = 15 }
    if m > 120 { m = 120 }   // cap to protect tg bot loop
    let b = ""
    let mut s = b + "# soak " + to_string(m) + "분 시작 (" + ts_iso() + ")\n"
    // Kick off runaway_guard RUNAWAY_TEST=1 (single measurement) repeatedly
    // on ubu — collect summary via journalctl at end.
    let before = run_remote("ubu", "date +%s", CMD_TIMEOUT_SHORT)
    let start_epoch = to_int(before.trim())
    // Spawn soak in background on ubu; tg waits by sleeping locally.
    let soak_cmd = "nohup bash -lc '"
        + "end=$(( $(date +%s) + " + to_string(m * 60) + " )); "
        + "while [ $(date +%s) -lt $end ]; do "
        + "  RUNAWAY_TEST=1 RUNAWAY_DRY_RUN=1 hexa run /opt/airgenome/bin/runaway_guard.hexa >> /tmp/tg_soak.log 2>&1; "
        + "  sleep 5; "
        + "done' >/dev/null 2>&1 &"
    let _ = run_remote("ubu", "echo '' > /tmp/tg_soak.log 2>/dev/null; " + soak_cmd + " echo started", CMD_TIMEOUT_SHORT)
    s = s + "ubu 에서 시작됨 — 5초 간격 polling, 결과: /tmp/tg_soak.log\n"
    // Wait locally (cap at 120m already).
    let _ = exec("sleep " + to_string(m * 60))
    // Summarize
    let after = run_remote("ubu", "date +%s", CMD_TIMEOUT_SHORT)
    let end_epoch = to_int(after.trim())
    let lines_s = run_remote("ubu", "wc -l < /tmp/tg_soak.log 2>/dev/null | tr -d ' '", CMD_TIMEOUT_SHORT)
    let verdict_tail = run_remote("ubu",
        "grep -oE '\"verdict\":\"[a-z]+\"' /tmp/tg_soak.log 2>/dev/null | sort | uniq -c | sort -rn | head -5",
        CMD_TIMEOUT_SHORT)
    let last5 = run_remote("ubu", "tail -n 5 /tmp/tg_soak.log 2>/dev/null", CMD_TIMEOUT_SHORT)
    s = s + "\nsoak 완료 — 경과 " + to_string(end_epoch - start_epoch) + "초\n"
    s = s + "샘플 수: " + truncate(lines_s, 20) + " 줄\n"
    s = s + "\nverdict 히스토그램:\n" + truncate(verdict_tail, 400) + "\n"
    s = s + "\n최근 5개 샘플:\n" + truncate(last5, 1000) + "\n"
    return s
}

// ─── /deploy <svc> [confirm <token>] ─────────────────────────────────
//
// token generation: sha1(chat_id + service + minute bucket) — bot prints a
// 4-char hex prompt, user replies "/deploy svc confirm <token>".
fn deploy_token(chat_id: int, service: str) -> str {
    // minute bucket so token is short-lived (~1-2 min window)
    let bucket = ts_epoch() / 60
    let seed = to_string(chat_id) + ":" + service + ":" + to_string(bucket)
    // shasum first 4 hex chars
    let h = exec("printf '%s' " + shell_quote(seed) + " | shasum -a 256 2>/dev/null | awk '{print $1}'").trim()
    if to_string(h) == "void" { return "0000" }
    return str_sub(h, 0, 4)
}

// Accept current or previous minute to absorb boundary races.
fn deploy_token_valid(chat_id: int, service: str, supplied: str) -> bool {
    let bucket = ts_epoch() / 60
    let seeds = [
        to_string(chat_id) + ":" + service + ":" + to_string(bucket),
        to_string(chat_id) + ":" + service + ":" + to_string(bucket - 1)
    ]
    let mut i = 0
    while i < len(seeds) {
        let h = exec("printf '%s' " + shell_quote(seeds[i]) + " | shasum -a 256 2>/dev/null | awk '{print $1}'").trim()
        if to_string(h) != "void" {
            let prefix = str_sub(h, 0, 4)
            if prefix == supplied { return true }
        }
        i = i + 1
    }
    return false
}

fn do_restart_service(service: str) -> str {
    if service == "tg-bot" {
        // Mac — launchd kickstart (self-restart). This will terminate us; log first.
        log_line("WARN", "self-restart via launchctl kickstart -k com.airgenome.tg-bot")
        let r = run_local("launchctl kickstart -k gui/$(id -u)/com.airgenome.tg-bot 2>&1; echo RC=$?", CMD_TIMEOUT_SHORT)
        return "✅ tg-bot 재기동 시작 (self-restart)\n" + truncate(r, 400)
    }
    // Remote systemd user service — restart on ubu AND ubu2 when applicable.
    if service == "airgenome-claude" {
        let r1 = run_remote("ubu",  "systemctl --user restart airgenome-claude 2>&1; systemctl --user is-active airgenome-claude 2>&1", CMD_TIMEOUT_MED)
        let r2 = run_remote("ubu2", "systemctl --user restart airgenome-claude 2>&1; systemctl --user is-active airgenome-claude 2>&1", CMD_TIMEOUT_MED)
        return "✅ airgenome-claude 재기동 완료:\n[ubu]  " + truncate(r1, 200) + "\n[ubu2] " + truncate(r2, 200)
    }
    if service == "airgenome-runaway" {
        // Runs on ubu under root systemd
        let r = run_remote("ubu", "sudo -n systemctl restart airgenome-runaway 2>&1; systemctl is-active airgenome-runaway 2>&1", CMD_TIMEOUT_MED)
        return "✅ airgenome-runaway 재기동 완료 (ubu):\n" + truncate(r, 400)
    }
    return "❌ 알 수 없는 서비스"
}

fn cmd_deploy(chat_id: int, argv: list) -> str {
    if len(argv) < 2 {
        return "사용법: /deploy <service>\n  service: airgenome-claude | airgenome-runaway | tg-bot\n  1단계: /deploy <svc>  → bot 이 confirm 토큰 발급\n  2단계: /deploy <svc> confirm <token>"
    }
    let svc = argv[1].trim()
    if !safe_token(svc) { return "❌ 서비스 이름이 올바르지 않습니다" }
    if !service_allowed(svc) { return "❌ 허용되지 않은 서비스: " + svc }
    if len(argv) >= 4 {
        let kw = argv[2].trim()
        if kw != "confirm" { return "❌ 알 수 없는 옵션 — 'confirm <token>' 형식이 필요합니다" }
        let tok = argv[3].trim()
        if !safe_token(tok) { return "❌ 토큰 형식이 올바르지 않습니다" }
        if !deploy_token_valid(chat_id, svc, tok) {
            return "❌ 토큰이 유효하지 않거나 만료됨 — `/deploy " + svc + "` 로 새 토큰을 발급받으세요"
        }
        log_line("WARN", "deploy EXEC chat=" + to_string(chat_id) + " svc=" + svc)
        return do_restart_service(svc)
    }
    // 1-step: issue token and instructions.
    let tok = deploy_token(chat_id, svc)
    let b = ""
    let mut s = b + "⚠️  " + svc + " 재기동을 확인해 주세요\n"
    s = s + "회신: /deploy " + svc + " confirm " + tok + "\n"
    s = s + "(토큰 유효 시간: 약 2분)"
    return s
}

// ─── /logs <host> [lines] ─────────────────────────────────────────────
fn cmd_logs(argv: list) -> str {
    if len(argv) < 2 {
        return "사용법: /logs <host> [lines]\n  host: ubu | ubu2 | hetzner"
    }
    let h = argv[1].trim()
    if !safe_token(h) { return "❌ 호스트 이름이 올바르지 않습니다" }
    if !ssh_alias_allowed(h) { return "❌ 허용되지 않은 호스트: " + h }
    let mut n = 20
    if len(argv) >= 3 {
        let ns = argv[2].trim()
        if safe_token(ns) { n = to_int(ns) }
    }
    if n <= 0 { n = 20 }
    if n > 200 { n = 200 }
    // Try user-unit claude first (ubu/ubu2 has it), fall back to system journal.
    let rcmd = "(journalctl --user -u airgenome-claude -n " + to_string(n) + " --no-pager 2>/dev/null"
            + " || journalctl -u airgenome-claude -n " + to_string(n) + " --no-pager 2>/dev/null"
            + " || journalctl -n " + to_string(n) + " --no-pager 2>&1)"
            + " | tail -n " + to_string(n)
    let out = run_remote(h, rcmd, CMD_TIMEOUT_MED)
    let b = ""
    let mut s = b + "# " + h + " journal 최근 " + to_string(n) + "줄\n"
    s = s + truncate(out, 3500)
    return s
}

// ─── /tail — 1-min airgenome status summary ──────────────────────────
fn cmd_tail(argv: list) -> str {
    // optional tag filter: /tail <tag> — if present, only lines matching tag.
    let mut tag = ""
    if len(argv) >= 2 { tag = argv[1].trim() }
    // Mac-side: recent tg + executor + dashboard stderr (cheap)
    let b = ""
    let mut s = b + "# 1분 요약 (" + ts_iso() + ")\n\n"
    let grep_part = ""
    let mut grep_cmd = grep_part
    if tag != "" {
        if !safe_token(tag) { return "❌ 태그 형식이 올바르지 않습니다" }
        grep_cmd = " | grep -E " + shell_quote(tag) + " | tail -n 8"
    } else {
        grep_cmd = " | tail -n 8"
    }
    let mac_tg = run_local("tail -n 30 " + HOME + "/.airgenome/tg_bot.log 2>/dev/null" + grep_cmd, CMD_TIMEOUT_SHORT)
    s = s + "[mac tg]\n" + truncate(mac_tg, 700) + "\n\n"
    let ubu_sum = run_remote("ubu", "journalctl --user -u airgenome-claude --since '1 min ago' --no-pager 2>&1 | wc -l | tr -d ' '", CMD_TIMEOUT_SHORT)
    let ubu2_sum = run_remote("ubu2", "journalctl --user -u airgenome-claude --since '1 min ago' --no-pager 2>&1 | wc -l | tr -d ' '", CMD_TIMEOUT_SHORT)
    s = s + "[최근 1분 journal 줄수]  ubu=" + truncate(ubu_sum, 10) + "  ubu2=" + truncate(ubu2_sum, 10) + "\n"
    let ubu_claude = run_remote("ubu", "pgrep -x claude 2>/dev/null | wc -l | tr -d ' '", CMD_TIMEOUT_SHORT)
    let ubu2_claude = run_remote("ubu2", "pgrep -x claude 2>/dev/null | wc -l | tr -d ' '", CMD_TIMEOUT_SHORT)
    let htz_claude = run_remote("hetzner", "pgrep -x claude 2>/dev/null | wc -l | tr -d ' '", CMD_TIMEOUT_SHORT)
    s = s + "[claude 프로세스 수]     ubu=" + truncate(ubu_claude, 10) + "  ubu2=" + truncate(ubu2_claude, 10) + "  htz=" + truncate(htz_claude, 10) + "\n"
    return s
}

// ─── /drill — heavy processes ────────────────────────────────────────
fn cmd_drill() -> str {
    let b = ""
    let mut s = b + "# 고부하 프로세스 점검 (" + ts_iso() + ")\n\n"
    // Top heavy on ubu — top CPU processes excluding idle kernel threads
    let heavy_cmd = "ps -eo pid,pcpu,pmem,comm --sort=-pcpu 2>/dev/null | awk 'NR==1 || $2>5' | head -10"
    let u1 = run_remote("ubu", heavy_cmd, CMD_TIMEOUT_SHORT)
    s = s + "[ubu 고부하]\n" + truncate(u1, 900) + "\n\n"
    let u2 = run_remote("ubu2", heavy_cmd, CMD_TIMEOUT_SHORT)
    s = s + "[ubu2 고부하]\n" + truncate(u2, 900) + "\n\n"
    let h1 = run_remote("hetzner", heavy_cmd, CMD_TIMEOUT_SHORT)
    s = s + "[htz 고부하]\n" + truncate(h1, 900) + "\n\n"
    // Local: top CPU Mac-side (ps sort by cpu)
    let mac_top = run_local("ps -Aceo pid,pcpu,pmem,comm -r 2>/dev/null | head -10", CMD_TIMEOUT_SHORT)
    s = s + "[mac 고부하]\n" + truncate(mac_top, 900) + "\n"
    return s
}

// ─── ROUTER ──────────────────────────────────────────────────────────
//
// Returns handled=true if text was a recognized /slash command (even if it
// errored with a message). handled=false falls through to claude dispatch.
struct CmdResult {
    handled: bool,
    reply: str
}

fn route_command(cfg: Config, chat_id: int, text: str) -> CmdResult {
    let r_default = CmdResult { handled: false, reply: "" }
    let tr = text.trim()
    if tr == "" { return r_default }
    let first = str_sub(tr, 0, 1)
    if first != "/" { return r_default }

    // Strip leading "/" and optional "@botname" suffix on first token.
    let body = str_sub(tr, 1, len(tr))
    let argv = split_ws(body)
    if len(argv) == 0 { return r_default }
    let mut cmd0 = argv[0]
    // Telegram appends @bot_username to commands from groups — strip.
    if cmd0.contains("@") {
        let parts = cmd0.split("@")
        cmd0 = parts[0]
    }
    // Only handle recognized commands. Unknown /foo → fall through to claude.
    if cmd0 == "start" {
        return CmdResult { handled: true, reply: "airgenome tg bot 준비 완료 — /help 로 명령어 목록 확인" }
    }
    if cmd0 == "help" {
        return CmdResult { handled: true, reply: cmd_help() }
    }
    if cmd0 == "status" {
        return CmdResult { handled: true, reply: cmd_status() }
    }
    if cmd0 == "wake" {
        return CmdResult { handled: true, reply: cmd_wake() }
    }
    if cmd0 == "soak" {
        let mut m = 15
        if len(argv) >= 2 {
            let ms = argv[1].trim()
            if safe_token(ms) { m = to_int(ms) }
        }
        return CmdResult { handled: true, reply: cmd_soak(m) }
    }
    if cmd0 == "deploy" {
        return CmdResult { handled: true, reply: cmd_deploy(chat_id, argv) }
    }
    if cmd0 == "logs" {
        return CmdResult { handled: true, reply: cmd_logs(argv) }
    }
    if cmd0 == "tail" {
        return CmdResult { handled: true, reply: cmd_tail(argv) }
    }
    if cmd0 == "drill" {
        return CmdResult { handled: true, reply: cmd_drill() }
    }
    // Unknown slash command — be explicit (don't silently dispatch to claude).
    return CmdResult {
        handled: true,
        reply: "❌ 알 수 없는 명령: /" + cmd0 + "\n/help 로 명령어 목록을 확인하세요"
    }
}

// ═══════════════════════════════════════════════════════════════════════
//  MAIN LOOP
// ═══════════════════════════════════════════════════════════════════════

fn handle_update(cfg: Config, u: Update) -> void {
    let wl = cfg.whitelist
    if !in_whitelist(u.chat_id, wl) {
        log_line("WARN", "drop unauthorized chat_id=" + to_string(u.chat_id) + " from=" + to_string(u.from_id) + " text=" + u.text)
        return
    }
    log_line("INFO", "handle uid=" + to_string(u.update_id) + " chat=" + to_string(u.chat_id) + " text=" + u.text)

    // Slash-command router — runs in tg_bot, no claude call.
    let cr = route_command(cfg, u.chat_id, u.text)
    if cr.handled {
        let mut body = cr.reply
        if body == "" { body = "(응답 없음)" }
        if body == "void" { body = "(void)" }
        send_chunks(cfg.token, u.chat_id, body)
        log_line("INFO", "cmd_reply uid=" + to_string(u.update_id) + " len=" + to_string(len(body)))
        return
    }

    // Freeform text → claude dispatch (original behavior).
    let _ = send_message(cfg.token, u.chat_id, "⏳ 디스패치 중…")
    let reply = dispatch_claude(cfg, u.text).trim()
    let mut body = reply
    if body == "" { body = "(빈 응답)" }
    if body == "void" { body = "(void)" }   // to_string(void) guard
    send_chunks(cfg.token, u.chat_id, body)
    log_line("INFO", "replied uid=" + to_string(u.update_id) + " len=" + to_string(len(body)))
}

fn poll_once(cfg: Config) -> int {
    let off = load_offset()
    let raw = get_updates(cfg.token, off)
    if raw == "" {
        log_line("WARN", "empty getUpdates response — backoff")
        let _ = exec("sleep " + to_string(BACKOFF))
        return off
    }
    // check ok:true — if not, log and back off
    if !raw.contains("\"ok\":true") {
        log_line("ERROR", "telegram getUpdates not ok: " + truncate(raw, 200))
        let _ = exec("sleep " + to_string(BACKOFF))
        return off
    }
    let ups = parse_updates(raw)
    let mut max_uid = off
    let mut i = 0
    while i < len(ups) {
        let u = ups[i]
        handle_update(cfg, u)
        if u.update_id >= max_uid { max_uid = u.update_id + 1 }
        i = i + 1
    }
    if max_uid > off {
        save_offset(max_uid)
    }
    return max_uid
}

fn run_loop(cfg: Config) -> void {
    let mut last_touch = ts_epoch()
    while true {
        touch_lock()
        let _off = poll_once(cfg)
        let now = ts_epoch()
        // periodic heartbeat log (every 5 min)
        if (now - last_touch) >= 300 {
            log_line("INFO", "heartbeat offset=" + to_string(_off))
            last_touch = now
        }
    }
}

// ═══════════════════════════════════════════════════════════════════════
//  SELF TEST
// ═══════════════════════════════════════════════════════════════════════

fn self_test() -> void {
    // 1. config load
    let cfg = load_config()
    if cfg.token == "" { panic("self_test FAIL [token empty]") }
    if len(cfg.whitelist) == 0 { panic("self_test FAIL [whitelist empty]") }

    // 2. whitelist check
    if !in_whitelist(cfg.whitelist[0], cfg.whitelist) {
        panic("self_test FAIL [whitelist self-check]")
    }
    if in_whitelist(99, cfg.whitelist) {
        panic("self_test FAIL [whitelist unexpected match]")
    }

    // 3. json_safe
    if json_safe("a\"b\\c") != "a\\\"b\\\\c" {
        panic("self_test FAIL [json_safe]")
    }

    // 4. shell_quote
    let q = shell_quote("a'b")
    if q != "'a'\\''b'" { panic("self_test FAIL [shell_quote got " + q + "]") }

    // 5. offset roundtrip
    save_offset(42)
    let o = load_offset()
    if o != 42 { panic("self_test FAIL [offset roundtrip got " + to_string(o) + "]") }
    save_offset(0)   // reset

    // 6. safe_token whitelist
    if !safe_token("ubu") { panic("self_test FAIL [safe_token ubu]") }
    if safe_token("ubu; rm -rf /") { panic("self_test FAIL [safe_token injection]") }
    if safe_token("") { panic("self_test FAIL [safe_token empty]") }

    // 7. ssh_alias_allowed / service_allowed
    if !ssh_alias_allowed("ubu") { panic("self_test FAIL [ssh ubu]") }
    if ssh_alias_allowed("evilhost") { panic("self_test FAIL [ssh evilhost]") }
    if !service_allowed("tg-bot") { panic("self_test FAIL [svc tg-bot]") }
    if service_allowed("rm-rf") { panic("self_test FAIL [svc rm-rf]") }

    // 8. split_ws
    let parts = split_ws("  /deploy  tg-bot  confirm  abcd  ")
    if len(parts) != 4 { panic("self_test FAIL [split_ws len=" + to_string(len(parts)) + "]") }
    if parts[0] != "/deploy" { panic("self_test FAIL [split_ws[0]=" + parts[0] + "]") }

    // 9. deploy_token roundtrip (current bucket)
    let tok = deploy_token(42, "tg-bot")
    if len(tok) != 4 { panic("self_test FAIL [deploy_token len=" + to_string(len(tok)) + "]") }
    if !deploy_token_valid(42, "tg-bot", tok) { panic("self_test FAIL [deploy_token_valid]") }
    if deploy_token_valid(42, "tg-bot", "0000") && tok != "0000" {
        panic("self_test FAIL [deploy_token accepts bad token]")
    }

    // 10. router — /help is handled, freeform is not
    let dummy_cfg = Config {
        token: "t", whitelist: [1], primary_host: "", dispatch: "cl",
        claude_bin: "claude", cx_bin: "cx", dispatch_timeout: 180, bot_username: ""
    }
    let r_help = route_command(dummy_cfg, 1, "/help")
    if !r_help.handled { panic("self_test FAIL [router /help not handled]") }
    let r_free = route_command(dummy_cfg, 1, "hello world")
    if r_free.handled { panic("self_test FAIL [router freeform handled]") }
    let r_unk = route_command(dummy_cfg, 1, "/doesnotexist")
    if !r_unk.handled { panic("self_test FAIL [router unknown not handled]") }

    // 11. telegram getMe (non-critical — logs but doesn't fail)
    let getme = exec("curl -sS --max-time 5 '" + api_base(cfg.token) + "/getMe' 2>&1")
    if !getme.contains("\"ok\":true") {
        println("  getMe not ok (network?): " + truncate(getme, 100))
    } else {
        println("  ✓ getMe ok")
    }

    println("  ✅ tg_bot self_test PASS")
}

// ═══════════════════════════════════════════════════════════════════════
//  MAIN
// ═══════════════════════════════════════════════════════════════════════

fn main() -> void {
    let a = args()
    // Scan argv for known subcommands (argv offset varies:
    //   `hexa run bin/tg_bot.hexa self-test` → a[2]="self-test"
    //   `hexa_stage0.real bin/tg_bot.hexa self-test` → a[2]="self-test"
    // We just grep the list.
    let mut sub = ""
    let mut i = 0
    while i < len(a) {
        let tok = a[i]
        if tok == "self-test" { sub = "self-test" }
        i = i + 1
    }

    if sub == "self-test" { self_test(); return }

    let cfg = load_config()

    // primary-host guard
    let hn = host_name()
    if cfg.primary_host != "" {
        if hn != cfg.primary_host {
            log_line("INFO", "STANDBY host=" + hn + " primary=" + cfg.primary_host + " — exiting")
            return
        }
    }

    // lock
    if !acquire_lock() {
        log_line("INFO", "another instance holds lock — exit")
        return
    }
    // NOTE: hexa has no atexit — release on normal exit only. Stale detected
    //       by mtime (60s) in acquire_lock().

    log_line("INFO", "tg_bot starting host=" + hn + " primary=" + cfg.primary_host + " dispatch=" + cfg.dispatch)

    if env("TG_ONCE") == "1" {
        let _ = poll_once(cfg)
        release_lock()
        return
    }

    run_loop(cfg)
    release_lock()
}

main()
