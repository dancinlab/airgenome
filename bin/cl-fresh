#!/usr/bin/env bash
# L0 CORE — chflags uchg 후 수정 금지. 변경 시 `chflags nouchg`.
# bin/cl-fresh — filter cooling-down accounts out of stdin dir list.
#
# Contract:
#   echo "$dir" | cl-fresh     stdin dir per line → stdout dirs where
#                              <dir>/.cooldown-until is missing OR <= now.
#   cl-fresh self-test         exit 0 if logic correct (uses tmp scratch).
#
# Cooldown marker format: single line, epoch seconds (output of `date +%s`).
# Expired markers are also deleted opportunistically.
#
# Dependencies: bash. State: reads per-dir marker, deletes expired. Network: none.

set -euo pipefail

_filter() {
    local now
    now=$(date +%s)
    local dir
    while IFS= read -r dir; do
        [ -n "$dir" ] || continue
        local m="$dir/.cooldown-until"
        if [ -f "$m" ]; then
            local until
            until=$(head -c 20 "$m" 2>/dev/null | tr -d '[:space:]' || echo 0)
            [[ "$until" =~ ^[0-9]+$ ]] || until=0
            if [ "$until" -gt "$now" ]; then
                continue
            fi
            rm -f "$m" 2>/dev/null || true
        fi
        echo "$dir"
    done
}

_self_test() {
    local tmp
    tmp=$(mktemp -d -t cl-fresh.XXXXXX)
    local a="$tmp/a" b="$tmp/b" c="$tmp/c"
    mkdir -p "$a" "$b" "$c"
    # b is cooling (future), c is expired (past)
    echo $(( $(date +%s) + 3600 )) > "$b/.cooldown-until"
    echo $(( $(date +%s) - 3600 )) > "$c/.cooldown-until"
    local out
    out=$(printf '%s\n%s\n%s\n' "$a" "$b" "$c" | _filter | tr '\n' ' ')
    rm -rf "$tmp"
    if [ "$out" = "$a $c " ]; then
        echo "self-test: PASS"; return 0
    fi
    echo "self-test: FAIL (got: $out, expected: $a $c )" >&2
    return 1
}

case "${1:-}" in
    self-test) _self_test; exit $? ;;
    -h|--help) sed -n '3,14p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
    "") _filter ;;
    *) echo "cl-fresh: unknown arg '$1'" >&2; exit 2 ;;
esac
