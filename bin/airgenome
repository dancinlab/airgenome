#!/bin/bash
# bin/airgenome — 단일 진입점 (M14) + inline runtime-guard (M13)
#
# 책임:
#   1. 서브커맨드: init / start / stop / status / arm / disarm / logs / run
#   2. run = supervisor (비동기 cadence 구조, 2026-05-15~):
#      - guard_loop() 백그라운드 fork (2s 샘플 CPU/RSS watchdog, bash native)
#      - cadence-60s : probe · dispatch · harvest · label
#      - cadence-300s: forecast
#      (displaylink 은 네이티브 앱으로 이관 — 2026-05-15)
#      - main loop   : guard + cadence health respawn (30s)
#   3. LaunchAgent 하나만 (com.airgenome.plist) → launchd 가 'airgenome run' 호출
#      → 신규 launchd plist 도입 금지 (governance: g_single_supervisor_plist)
#
# guard 설계 (bash, hexa_stage0 lock 우회):
#   CPU ≥ 85% × 15s → WARN / × 30s → SIGTERM / × 45s → SIGKILL
#   RSS ≥ 1.5GB × 30s → SIGTERM / ≥ 3GB 즉시 SIGKILL
#   exclude: pid 1, kernel_task, WindowServer, loginwindow, launchd, guard 자신
#   arm: ~/.airgenome/guard_armed 존재 시 실제 kill. 없으면 dry-run.
#   off: ~/.airgenome/guard_off 존재 시 즉시 종료.

set -eu

# Defaults: derive AIRGENOME_ROOT from script location, look up HEXA on PATH.
# Override via env (AIRGENOME_ROOT=... HEXA=...) for non-canonical layouts.
# Resolve symlinks (e.g. ~/.hx/bin/airgenome → ~/.hx/packages/airgenome/bin/airgenome).
_ag_self="${BASH_SOURCE[0]}"
while [ -L "$_ag_self" ]; do
    _ag_link="$(readlink "$_ag_self")"
    case "$_ag_link" in
        /*) _ag_self="$_ag_link" ;;
        *)  _ag_self="$(cd "$(dirname "$_ag_self")" && pwd)/$_ag_link" ;;
    esac
done
AIRGENOME_ROOT="${AIRGENOME_ROOT:-$(cd "$(dirname "$_ag_self")/.." && pwd)}"
unset _ag_self _ag_link
HEXA="${HEXA:-$(command -v hexa 2>/dev/null || echo hexa)}"
LOG_DIR="$HOME/.airgenome"
PLIST_SRC="$AIRGENOME_ROOT/launchd/com.airgenome.plist"
PLIST_DST="$HOME/Library/LaunchAgents/com.airgenome.plist"
LABEL="com.airgenome"
UID_VAL="$(id -u)"

PID_FILE="$LOG_DIR/supervisor.pid"
GUARD_PID_FILE="$LOG_DIR/guard.pid"
SUPER_LOG="$LOG_DIR/supervisor.log"
GUARD_LOG="$LOG_DIR/runtime-guard.jsonl"
ARMED_FLAG="$LOG_DIR/guard_armed"
OFF_FLAG="$LOG_DIR/guard_off"
PLUGINS_DIR="$LOG_DIR/plugins"

# airgenome_tap (CGEventTap + AX shim — unified mouse buttons + scroll inversion +
# 8-zone window magnet + native tiling lockout). Single binary, single Accessibility
# grant. Supersedes ~/core/mouse_remap and ~/core/window_magnet (kept as archive).
AIRGENOME_TAP_ROOT="${AIRGENOME_TAP_ROOT:-$HOME/core/airgenome/native}"
AIRGENOME_TAP_LABEL="com.airgenome.tap"
# legacy LaunchAgent labels — bootout on migration
LEGACY_TAP_LABELS="com.user.mouse-remap com.user.window-magnet"

mkdir -p "$LOG_DIR"

log() {
    printf '[airgenome] %s %s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$*" | tee -a "$SUPER_LOG" >&2
}
die() { log "ERROR: $*"; exit 1; }

# ============================================================
# runtime-guard (bash inline, hexa_stage0 lock 밖에서 실행)
# ============================================================

# 임계치
GUARD_CPU_PCT=85
GUARD_CPU_WARN_SEC=15
GUARD_CPU_TERM_SEC=30
GUARD_CPU_KILL_SEC=45
GUARD_RSS_SOFT_MB=1500
GUARD_RSS_SOFT_TERM_SEC=30
GUARD_RSS_HARD_MB=3000
GUARD_SAMPLE_SEC=2
GUARD_MAX_ITER=1800   # 1h; supervisor 가 재spawn

_guard_ts() { date -u +%Y-%m-%dT%H:%M:%SZ; }

_guard_comm_safe() { printf '%s' "$1" | tr -d '"\\'; }

_guard_is_excluded() {
    local pid="$1" comm="$2" self_pid="$3"
    [ "$pid" = "$self_pid" ] && return 0
    [ "$pid" = "1" ] && return 0
    case "$comm" in
        kernel_task|WindowServer|loginwindow|launchd) return 0 ;;
    esac
    return 1
}

_guard_lookup() {
    # args: pid, tracks
    # stdout: "cpu_since:rss_since" (default "0:0")
    local pid="$1" tracks="$2"
    local entry
    for entry in $tracks; do
        case "$entry" in
            "$pid":*) printf '%s' "${entry#*:}"; return ;;
        esac
    done
    printf '0:0'
}

_guard_emit_start() {
    local self_pid="$1"
    local mode="dry-run"
    [ -e "$ARMED_FLAG" ] && mode="armed"
    printf '{"ts":"%s","event":"start","pid":%s,"mode":"%s","cpu_pct":%s,"cpu_warn_sec":%s,"cpu_term_sec":%s,"cpu_kill_sec":%s,"rss_soft_mb":%s,"rss_hard_mb":%s,"sample_sec":%s}\n' \
        "$(_guard_ts)" "$self_pid" "$mode" \
        "$GUARD_CPU_PCT" "$GUARD_CPU_WARN_SEC" "$GUARD_CPU_TERM_SEC" "$GUARD_CPU_KILL_SEC" \
        "$GUARD_RSS_SOFT_MB" "$GUARD_RSS_HARD_MB" "$GUARD_SAMPLE_SEC" \
        >> "$GUARD_LOG"
}

_guard_emit_stop() {
    local reason="$1"
    printf '{"ts":"%s","event":"stop","reason":"%s"}\n' "$(_guard_ts)" "$reason" >> "$GUARD_LOG"
}

_guard_act_kill() {
    local pid="$1" sig="$2" reason="$3" comm="$4" armed="$5"
    local action="dry-run"
    if [ "$armed" = "1" ]; then
        action="sent"
        kill -"$sig" "$pid" 2>/dev/null || true
    fi
    printf '{"ts":"%s","action":"%s","sig":"%s","pid":%s,"comm":"%s","reason":"%s"}\n' \
        "$(_guard_ts)" "$action" "$sig" "$pid" "$(_guard_comm_safe "$comm")" "$reason" \
        >> "$GUARD_LOG"
}

_guard_act_warn() {
    local pid="$1" comm="$2" reason="$3"
    printf '{"ts":"%s","action":"warn","pid":%s,"comm":"%s","reason":"%s"}\n' \
        "$(_guard_ts)" "$pid" "$(_guard_comm_safe "$comm")" "$reason" >> "$GUARD_LOG"
}

_guard_tick() {
    local self_pid="$1" armed="$2" prior="$3"
    local now; now=$(date +%s)
    local new_tracks=""
    local pid cpu_raw rss_kb comm cpu rss_mb
    local prior_entry cpu_since rss_since dur

    while IFS= read -r line; do
        read -r pid cpu_raw rss_kb comm <<< "$line"
        [ -z "${pid:-}" ] && continue
        cpu="${cpu_raw%%.*}"
        [ -z "$cpu" ] && cpu=0
        rss_mb=$((rss_kb / 1024))

        if _guard_is_excluded "$pid" "$comm" "$self_pid"; then
            continue
        fi

        prior_entry="$(_guard_lookup "$pid" "$prior")"
        cpu_since="${prior_entry%%:*}"
        rss_since="${prior_entry##*:}"

        # CPU 누적 추적
        if [ "$cpu" -ge "$GUARD_CPU_PCT" ]; then
            [ "$cpu_since" = "0" ] && cpu_since=$now
        else
            cpu_since=0
        fi
        # RSS 누적 추적
        if [ "$rss_mb" -ge "$GUARD_RSS_SOFT_MB" ]; then
            [ "$rss_since" = "0" ] && rss_since=$now
        else
            rss_since=0
        fi

        # Action: RSS hard → 즉시 SIGKILL
        if [ "$rss_mb" -ge "$GUARD_RSS_HARD_MB" ]; then
            _guard_act_kill "$pid" KILL "rss_hard=${rss_mb}MB" "$comm" "$armed"
            cpu_since=0; rss_since=0
        fi

        # Action: CPU 단계
        if [ "$cpu_since" != "0" ]; then
            dur=$((now - cpu_since))
            if [ "$dur" -ge "$GUARD_CPU_KILL_SEC" ]; then
                _guard_act_kill "$pid" KILL "cpu=${cpu}%_for_${dur}s" "$comm" "$armed"
                cpu_since=0
            elif [ "$dur" -ge "$GUARD_CPU_TERM_SEC" ]; then
                _guard_act_kill "$pid" TERM "cpu=${cpu}%_for_${dur}s" "$comm" "$armed"
            elif [ "$dur" -ge "$GUARD_CPU_WARN_SEC" ]; then
                _guard_act_warn "$pid" "$comm" "cpu=${cpu}%_for_${dur}s"
            fi
        fi

        # Action: RSS soft → TERM
        if [ "$rss_since" != "0" ]; then
            dur=$((now - rss_since))
            if [ "$dur" -ge "$GUARD_RSS_SOFT_TERM_SEC" ]; then
                _guard_act_kill "$pid" TERM "rss=${rss_mb}MB_for_${dur}s" "$comm" "$armed"
                rss_since=0
            fi
        fi

        new_tracks="$new_tracks $pid:$cpu_since:$rss_since"
    done < <(ps -Ao pid=,%cpu=,rss=,comm=)

    printf '%s' "${new_tracks# }"
}

# interruptible sleep — SIGTERM 즉시 반응 (sleep 를 fg 대신 wait 으로 기다림).
_isleep() {
    local secs="$1"
    sleep "$secs" & local sp=$!
    wait "$sp" 2>/dev/null || true
}

guard_loop() {
    # self_pid: caller 가 _ENVAR 로 주입한 값 우선 (supervisor fork 시 정확).
    # 없으면 $$ fallback (standalone 실행 시 올바름).
    local self_pid="${AIRGENOME_GUARD_SELF_PID:-$$}"
    # caller 가 pid 파일 관리한 경우 덮어쓰지 않음. 관리 안 한 경우만 기록.
    if [ ! -s "$GUARD_PID_FILE" ]; then
        echo "$self_pid" > "$GUARD_PID_FILE" 2>/dev/null || true
    fi
    trap '_guard_emit_stop "signal"; exit 0' TERM INT

    _guard_emit_start "$self_pid"

    local tracks=""
    local iter=0
    local armed
    while [ "$iter" -lt "$GUARD_MAX_ITER" ]; do
        if [ -e "$OFF_FLAG" ]; then
            _guard_emit_stop "guard_off_flag"
            return 0
        fi
        armed=0
        [ -e "$ARMED_FLAG" ] && armed=1
        tracks="$(_guard_tick "$self_pid" "$armed" "$tracks")"
        _isleep "$GUARD_SAMPLE_SEC"
        iter=$((iter + 1))
    done
    _guard_emit_stop "iter_cap"
}

# ============================================================
# 서브커맨드
# ============================================================

# HUSH — macOS 시스템 부하 완화 (idempotent).
# user-level 작업 → 항상 적용. sudo 작업 → 단일 sudo -v prompt 후 묶음 실행.
# 자세한 배경: ARCHITECTURE.json (Domains → HUSH node)
cmd_hush() {
    log "hush: applying macOS load mitigations"

    # --- user-level (sudo 없음) ---
    local hcache="$HOME/.hexa-cache"
    if [ -d "$hcache" ]; then
        touch "$hcache/.metadata_never_index" 2>/dev/null || true
        touch "$hcache/.metadata_never_index_unless_rootfs" 2>/dev/null || true
        xattr -cr "$hcache" 2>/dev/null || true
    fi
    [ -d "$HOME/Downloads" ] && xattr -dr com.apple.quarantine "$HOME/Downloads" 2>/dev/null || true

    # Mission Control: 'Displays have separate Spaces' ON (spans-displays=false).
    # 풀스크린 시 외 모니터 암전 방지. 사용자 도메인 (sudo 불필요). 적용에 logout 필요.
    local span_cur
    span_cur="$(defaults read com.apple.spaces spans-displays 2>/dev/null || echo "1")"
    if [ "$span_cur" != "0" ]; then
        defaults write com.apple.spaces spans-displays -bool false \
            && log "hush: Displays have separate Spaces ON (로그아웃 후 다음 로그인부터 적용 — 풀스크린 시 외 모니터 정상 사용)"
    fi

    if command -v mullvad >/dev/null 2>&1; then
        local st
        st="$(mullvad split-tunnel get 2>/dev/null | awk -F': ' '/Split tunneling state/{print $2; exit}')"
        if [ "$st" = "on" ]; then
            mullvad split-tunnel set off >/dev/null 2>&1 \
                && log "hush: mullvad split-tunnel OFF (ESF hook 부하 1차 감축)"
        fi
    fi

    # --- sudo (단일 prompt 로 묶음, sudo -v 미리 갱신) ---
    if ! sudo -n true 2>/dev/null; then
        log "hush: sudo 권한 필요 (XProtect 정의·Spotlight·Find My 비활성)"
        sudo -v || die "hush: sudo 거부 — 부분 적용 상태"
    fi

    sudo defaults write /Library/Preferences/com.apple.SoftwareUpdate ConfigDataInstall -bool false 2>/dev/null \
        && log "hush: XProtect 정의 자동갱신 OFF (ConfigDataInstall=false)"
    sudo defaults write /Library/Preferences/com.apple.SoftwareUpdate CriticalUpdateInstall -bool false 2>/dev/null \
        && log "hush: 보안 응답 자동설치 OFF (CriticalUpdateInstall=false)"
    sudo defaults write /Library/Preferences/com.apple.SoftwareUpdate AutomaticDownload -bool false 2>/dev/null \
        && log "hush: macOS 자동 다운로드 OFF (AutomaticDownload=false)"
    sudo defaults write /Library/Preferences/com.apple.SoftwareUpdate AutomaticallyInstallMacOSUpdates -bool false 2>/dev/null \
        && log "hush: macOS 자동 설치 OFF (AutomaticallyInstallMacOSUpdates=false)"
    sudo defaults write /Library/Preferences/com.apple.SoftwareUpdate AutoInstallProductKeys -array 2>/dev/null \
        && log "hush: AutoInstallProductKeys 비움 (예약된 업데이트 시도 중단)"

    if mdutil -as 2>/dev/null | grep -q 'Indexing enabled'; then
        sudo mdutil -a -i off >/dev/null 2>&1 \
            && log "hush: Spotlight 전역 인덱싱 OFF (검색 UI는 파일명 폴백)"
    fi
    sudo killall mds mds_stores 2>/dev/null || true
    sudo killall -m mdworker_shared 2>/dev/null || true

    # Find My / Continuity (사용 안 하면 부하만)
    sudo launchctl bootout "gui/$UID_VAL/com.apple.searchpartyuseragent" 2>/dev/null \
        && log "hush: searchpartyuseragent (Find My) OFF for this session"

    # Siri / Apple Intelligence / Biome / Suggestions / CoreSpotlight knowledge —
    # user has Siri disabled (Assistant Enabled = 0). These satellite daemons are
    # SIP-protected so bootout is impossible (= zero zombie risk by construction);
    # we only `disable` them, effect applies on next login.
    local idle_label disabled_n=0
    for idle_label in \
        com.apple.BiomeAgent \
        com.apple.biomesyncd \
        com.apple.suggestd \
        com.apple.corespotlightd; do
        if launchctl print-disabled "gui/$UID_VAL" 2>/dev/null | grep -q "\"$idle_label\" => disabled"; then
            continue
        fi
        launchctl disable "gui/$UID_VAL/$idle_label" 2>/dev/null && disabled_n=$((disabled_n + 1))
    done
    [ $disabled_n -gt 0 ] && log "hush: Siri/Biome/Suggest/CoreSpotlight 데몬 $disabled_n 개 disable (다음 로그인부터 적용)"

    # UniversalControl (Mac ↔ iPad 마우스/키보드 공유) — defaults only, no kill.
    defaults write com.apple.universalcontrol Disable -bool true 2>/dev/null || true
    defaults -currentHost write com.apple.universalcontrol Disable -bool true 2>/dev/null || true

    # WindowServer GPU 부하 — Reduce Transparency + Reduce Motion.
    # com.apple.universalaccess 는 cfprefsd 독점 관리라 일반 `defaults write` 가
    # 거부됨 → plutil 로 plist 직접 수정 후 cfprefsd flush. 이미 ON 이면 skip.
    local ua_plist="$HOME/Library/Preferences/com.apple.universalaccess.plist"
    local ua_key ua_changed=0
    for ua_key in reduceTransparency reduceMotion; do
        if [ "$(defaults read com.apple.universalaccess "$ua_key" 2>/dev/null || echo 0)" != "1" ]; then
            plutil -replace "$ua_key" -bool true "$ua_plist" 2>/dev/null && ua_changed=1
        fi
    done
    if [ "$ua_changed" = "1" ]; then
        killall cfprefsd 2>/dev/null || true
        log "hush: Reduce Transparency + Motion ON (WindowServer GPU 부하 감축)"
    fi

    log "hush: done — XprotectService/mds idle 진입까지 수십초 소요"
}

# cmd_display_override — writes EDID override plists under
#   /Library/Displays/Contents/Resources/Overrides/DisplayVendorID-XXXX/
#       DisplayProductID-XXXX
# for the LG UltraFine portrait monitors discovered via DisplayLink USB
# (CGDisplay reports vendor=0x1e6d model=0x5cbb). The override exposes
# additional HiDPI scale modes that macOS hides by default for DisplayLink
# attached monitors. CPU-pump reduction is NOT guaranteed — DisplayLink
# firmware fixes panel native at 2160x3840 regardless of this override —
# but adds System Settings scale options + locks "looks like" choice across
# reboots. Effect applies only after reboot. Rollback = `sudo rm` the file.
# sudo required (writes under /Library/Displays/).
cmd_display_override() {
    local vendor_hex="1e6d"   # LG Electronics
    local product_hex="5cbb"  # UltraFine (portrait 4K via DisplayLink USB)
    local overrides_root="/Library/Displays/Contents/Resources/Overrides"
    local vdir="$overrides_root/DisplayVendorID-$vendor_hex"
    local pfile="$vdir/DisplayProductID-$product_hex"

    # idempotent — skip when our marker is already present
    if [ -f "$pfile" ] && grep -q "airgenome-override" "$pfile" 2>/dev/null; then
        log "display-override: $pfile already airgenome-managed (skip)"
        return 0
    fi

    if ! sudo -n true 2>/dev/null; then
        log "display-override: sudo required to write under $overrides_root"
        sudo -v || { log "display-override: sudo refused — skipped"; return 0; }
    fi

    sudo mkdir -p "$vdir" 2>/dev/null || {
        log "display-override: cannot mkdir $vdir (SIP may be enforcing $overrides_root)"
        return 1
    }

    # scale-resolutions binary entries (16 bytes each, big-endian):
    #   bytes [0..4)  width  (uint32 BE)
    #   bytes [4..8)  height (uint32 BE)
    #   bytes [8..12) scale flag — 0x00000001 = HiDPI 2x · 0x00000000 = native
    #   bytes [12..16) enable — 0x00000001 = enabled
    # python base64 used for clarity vs raw bash printf (avoids encoding bugs).
    python3 - "$pfile" <<'PY' >/tmp/airgenome-display.plist
import sys, struct, base64, plistlib

def entry(w, h, hidpi=1, enabled=1):
    return struct.pack(">IIII", w, h, hidpi, enabled)

scaled = [
    entry(1080, 1920, 1, 1),  # default looks-like (current)
    entry( 960, 1707, 1, 1),  # tighter HiDPI
    entry( 864, 1536, 1, 1),  # smaller HiDPI
    entry( 810, 1440, 1, 1),  # smallest practical HiDPI
    entry(2160, 3840, 0, 1),  # 1:1 native (no scale — biggest workspace)
    entry(1620, 2880, 0, 1),  # 1:1 reduced
    entry(1080, 1920, 0, 1),  # 1:1 small (smallest practical, framebuffer 1/4)
]

doc = {
    "DisplayProductName": "LG UltraFine (airgenome-override)",
    "DisplayVendorID": 0x1e6d,
    "DisplayProductID": 0x5cbb,
    "scale-resolutions": scaled,
}

with open("/tmp/airgenome-display.plist", "wb") as f:
    plistlib.dump(doc, f, fmt=plistlib.FMT_XML)
PY

    sudo install -m 644 /tmp/airgenome-display.plist "$pfile" \
        && log "display-override: wrote $pfile (LG UltraFine — 7 scaled-resolutions + native modes)" \
        && log "  → reboot required for new options to appear in System Settings → Displays" \
        || log "display-override: install failed — check sudo + SIP status"
    rm -f /tmp/airgenome-display.plist
}

cmd_init() {
    [ -f "$PLIST_SRC" ] || die "plist source missing: $PLIST_SRC"
    [ -x "$HEXA" ] || die "hexa binary missing: $HEXA"
    cp "$PLIST_SRC" "$PLIST_DST"
    launchctl bootout "gui/$UID_VAL/$LABEL" 2>/dev/null || true
    if ! launchctl bootstrap "gui/$UID_VAL" "$PLIST_DST" 2>/dev/null; then
        # raw 197 strengthening 2026-04-30 F-MON-1: gui/UID service slot
        # saturation (~499/500). Emit raw 66 ai-native trailer with concrete
        # fix path. Foreground-app fallback via `open` keeps menubar UX live
        # without launchd persistence (raw 91 honest C3: no auto-restore on
        # next reboot until saturation clears via re-login or stale-plist sweep).
        local active_count
        active_count="$(launchctl print "gui/$UID_VAL" 2>/dev/null | awk -F'= ' '/active count =/{print $2; exit}' || echo "?")"
        echo "[airgenome] launchctl bootstrap FAILED (gui/$UID_VAL active count = $active_count, Apple limit = 500)" >&2
        echo "  reason: launchctl-gui-domain-saturation (raw 197 strengthening 2026-04-30 F-MON-1)" >&2
        echo "  fix: 1) re-login to drop session services  2) 'launchctl bootout' redundant agents in ~/Library/LaunchAgents/  3) reboot" >&2
        echo "  fallback: launching foreground via 'open /Applications/airgenome.app' (no launchd persistence until #1-#3 clears)" >&2
        if [ -d "/Applications/airgenome.app" ]; then
            open /Applications/airgenome.app && log "fallback: airgenome.app launched in foreground"
        else
            die "launchctl bootstrap failed AND /Applications/airgenome.app missing"
        fi
    else
        log "installed + bootstrapped: $LABEL"
    fi

    # airgenome tap 동행 설치 (통합 CGEventTap+AX shim — mouse 버튼 + 스크롤 반전
    # + 8-zone 윈도우 자석 + native tiling lockout). 별도 LaunchAgent 라 supervisor 와
    # 독립적으로 살지만 init/stop 라이프사이클은 묶음 — daemon 종료 시 자체 signal
    # handler 가 com.apple.WindowManager.{EnableTiling*} 원래 값을 복구한다.
    # opt-out: AIRGENOME_NO_TAP=1 (구 AIRGENOME_NO_MAGNET 도 호환)
    if [ -z "${AIRGENOME_NO_TAP:-${AIRGENOME_NO_MAGNET:-}}" ] && [ -d "$AIRGENOME_TAP_ROOT" ]; then
        # 1회 마이그레이션: 구 mouse_remap / window_magnet LaunchAgent 정리
        local label
        for label in $LEGACY_TAP_LABELS; do
            if launchctl print "gui/$UID_VAL/$label" >/dev/null 2>&1; then
                launchctl bootout "gui/$UID_VAL/$label" 2>/dev/null || true
                rm -f "$HOME/Library/LaunchAgents/$label.plist"
                log "airgenome tap migrate: bootout + plist removed for $label"
            fi
        done
        # make install: build → bundle → /Applications/airgenome.app + bootstrap
        ( cd "$AIRGENOME_TAP_ROOT" && make install ) >>"$SUPER_LOG" 2>&1 \
            && log "airgenome tap: /Applications/airgenome.app installed + bootstrapped" \
            || log "WARN airgenome tap install failed (see $SUPER_LOG)"
        log "  Accessibility 권한 1회 부여 필요: System Settings → Privacy & Security → Accessibility → '+' /Applications/airgenome.app → 토글 → airgenome tap restart"
    fi

    # HUSH — macOS 부하 완화 동행 적용 (idempotent)
    cmd_hush

    # DISPLAY-OVERRIDE — EDID override for DisplayLink portrait monitors
    # (additional HiDPI scale modes; reboot required to take effect)
    cmd_display_override

    log "next: airgenome status (확인) → airgenome arm (live kill on) 필요 시"
}

cmd_stop() {
    launchctl bootout "gui/$UID_VAL/$LABEL" 2>/dev/null || true
    local pid
    if [ -f "$PID_FILE" ]; then
        pid="$(cat "$PID_FILE" 2>/dev/null || true)"
        if [ -n "${pid:-}" ] && kill -0 "$pid" 2>/dev/null; then
            kill -TERM "$pid" 2>/dev/null || true
            log "supervisor signaled: $pid"
        fi
        rm -f "$PID_FILE"
    fi
    if [ -f "$GUARD_PID_FILE" ]; then
        pid="$(cat "$GUARD_PID_FILE" 2>/dev/null || true)"
        if [ -n "${pid:-}" ] && kill -0 "$pid" 2>/dev/null; then
            kill -TERM "$pid" 2>/dev/null || true
        fi
        rm -f "$GUARD_PID_FILE"
    fi

    # airgenome tap 동행 종료. SIGTERM → daemon signal handler 가 native tiling
    # defaults 원래 값으로 복구 후 정상 종료.
    if [ -z "${AIRGENOME_NO_TAP:-${AIRGENOME_NO_MAGNET:-}}" ]; then
        if launchctl print "gui/$UID_VAL/$AIRGENOME_TAP_LABEL" >/dev/null 2>&1; then
            launchctl bootout "gui/$UID_VAL/$AIRGENOME_TAP_LABEL" 2>/dev/null || true
            log "airgenome tap: stopped (native tiling restored by daemon)"
        fi
    fi

    log "stopped"
}

cmd_status() {
    echo "=== LaunchAgent ==="
    launchctl print "gui/$UID_VAL/$LABEL" 2>/dev/null | grep -E '^[[:space:]]*(state|pid|last exit code)' | head -5 || echo "  (not loaded)"

    echo "=== Supervisor ==="
    local pid=""
    [ -f "$PID_FILE" ] && pid="$(cat "$PID_FILE" 2>/dev/null || true)"
    if [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null; then
        echo "  PID=$pid RUNNING"
    else
        echo "  (not running)"
    fi

    echo "=== runtime-guard ==="
    local gpid=""
    [ -f "$GUARD_PID_FILE" ] && gpid="$(cat "$GUARD_PID_FILE" 2>/dev/null || true)"
    if [ -n "$gpid" ] && kill -0 "$gpid" 2>/dev/null; then
        echo "  PID=$gpid RUNNING"
    else
        echo "  (not running)"
    fi
    if [ -e "$ARMED_FLAG" ]; then echo "  mode: ARMED (live kill)"; else echo "  mode: dry-run"; fi
    if [ -e "$OFF_FLAG" ]; then echo "  ** OFF flag set"; fi

    echo "=== airgenome tap (mouse + scroll + magnet) ==="
    if [ -n "${AIRGENOME_NO_TAP:-${AIRGENOME_NO_MAGNET:-}}" ]; then
        echo "  (disabled via AIRGENOME_NO_TAP=1)"
    elif [ ! -d "$AIRGENOME_TAP_ROOT" ]; then
        echo "  (root missing: $AIRGENOME_TAP_ROOT)"
    else
        local tprint
        tprint="$(launchctl print "gui/$UID_VAL/$AIRGENOME_TAP_LABEL" 2>/dev/null || true)"
        if [ -z "$tprint" ]; then
            echo "  (not loaded — airgenome init 또는 airgenome tap install)"
        else
            echo "$tprint" | grep -E '^[[:space:]]*(state|pid|last exit code)' | head -3
        fi
        # legacy LaunchAgents — warn if still loaded (should be 0 post-migration)
        local llabel ltrace=""
        for llabel in $LEGACY_TAP_LABELS; do
            if launchctl print "gui/$UID_VAL/$llabel" >/dev/null 2>&1; then
                ltrace="$ltrace $llabel"
            fi
        done
        if [ -n "$ltrace" ]; then
            echo "  ** legacy LaunchAgent(s) still loaded:$ltrace — run: airgenome tap migrate"
        fi
    fi

    echo "=== 최근 guard 이벤트 (last 5) ==="
    tail -5 "$GUARD_LOG" 2>/dev/null || echo "  (log 없음)"

    echo "=== 산출물 freshness ==="
    local f
    for f in \
        "$HOME/Dev/nexus/infra_state.json" \
        "$HOME/Dev/nexus/dispatch_state.json" \
        "$AIRGENOME_ROOT/forge/genomes.ring" \
        "$AIRGENOME_ROOT/forge/forecast.jsonl"
    do
        if [ -e "$f" ]; then
            stat -f '  %Sm  %N' -t '%Y-%m-%dT%H:%M:%SZ' "$f" 2>/dev/null
        else
            echo "  (missing) $f"
        fi
    done
}

cmd_arm() {
    touch "$ARMED_FLAG"
    rm -f "$OFF_FLAG"
    log "guard ARMED (live kill enabled)"
}

cmd_disarm() {
    rm -f "$ARMED_FLAG"
    log "guard disarmed (dry-run)"
}

cmd_logs() {
    local which="${1:-list}"
    case "$which" in
        guard)    tail -F "$GUARD_LOG" ;;
        probe)    tail -F "$LOG_DIR/probe.stderr.log" ;;
        dispatch) tail -F "$LOG_DIR/dispatch.stderr.log" ;;
        harvest)  tail -F "$LOG_DIR/harvest.stderr.log" ;;
        label)    tail -F "$LOG_DIR/label.stderr.log" ;;
        forecast) tail -F "$LOG_DIR/forecast.stderr.log" ;;
        super)    tail -F "$SUPER_LOG" ;;
        list|*)
            ls -lat "$LOG_DIR"/*.log "$LOG_DIR"/*.jsonl 2>/dev/null | head -15
            ;;
    esac
}

run_hexa_mod() {
    local mod="$1"
    local t="${HEXA_MOD_TIMEOUT:-30}"
    # fg 가 아닌 bg + wait 패턴: SIGTERM 이 supervisor 에 도달 시 wait 이 즉시 interrupt 된다.
    # 모듈 경로 규약: <name>/module/<name>.hexa (probe/module/probe.hexa 등).
    # 과거 modules/<name>.hexa 는 존재하지 않는 경로 → hexa 가 조용히 exit 0
    # (no-op) 라서 probe·dispatch·harvest·label·forecast 가 수주간 dormant
    # 였음. 2026-05-15 경로 교정.
    timeout "$t" "$HEXA" run "$AIRGENOME_ROOT/${mod}/module/${mod}.hexa" \
        >>"$LOG_DIR/${mod}.stdout.log" \
        2>>"$LOG_DIR/${mod}.stderr.log" &
    local mpid=$!
    # set -e 가 wait 의 124(timeout)/137(SIGKILL) 반환에 발화해서 bin/airgenome
    # 전체를 죽이지 않도록 `|| rc=$?` 패턴으로 흡수. 이전엔 모듈 timeout 마다
    # 'run' child 가 죽고 supervisor 가 재spawn → 매주 ~수백개 stale 누적이었다.
    local rc=0
    wait "$mpid" 2>/dev/null || rc=$?
    if [ "$rc" -ne 0 ] && [ "$rc" -lt 128 ]; then
        log "module ${mod} exit=$rc (timeout=${t}s)"
    fi
}

# hexa_stage0 lock 홀더가 살아있으면 true. 모듈 실행 skip 판단용.
_hexa_lock_busy() {
    local pidfile="/tmp/hexa_stage0.lock.d/pid"
    [ -f "$pidfile" ] || return 1
    local holder
    holder="$(cat "$pidfile" 2>/dev/null)"
    [ -n "$holder" ] && kill -0 "$holder" 2>/dev/null
}

spawn_guard() {
    # subshell 에서 guard_loop 실행. $! 는 실제 subshell pid.
    guard_loop >>"$LOG_DIR/runtime-guard.stdout.log" 2>>"$LOG_DIR/runtime-guard.stderr.log" &
    local pid=$!
    # caller (supervisor) 가 guard pid 파일 관리. 또한 env 로 주입해 guard_loop 내 self_pid 정확화.
    echo "$pid" > "$GUARD_PID_FILE"
    # 환경변수 주입은 fork 이후라 불가 — guard_loop 는 $$ fallback 사용. 대신 start 이벤트 후 pid 파일이 덮어쓰이지 않도록 보호됨.
    echo "$pid"
}

# spawn_cadence — 비동기 cadence 서브쉘 fork.
#   args : label interval mod [mod ...]
#   stdout: subshell pid (caller 가 health check + respawn)
#   동작 : while true; do (lock 없으면) mod 순차 실행; _isleep interval; done
#   trap : 부모의 pkill -TERM -P $$ 가 SIGTERM 시 같이 정리.
#
# CRITICAL: 백그라운드 subshell 의 stdout/stderr 를 반드시 파일로 redirect 한다.
# `cad=$(spawn_cadence ...)` 형태로 호출되므로, redirect 가 없으면 subshell 이
# command-substitution 파이프 fd 를 상속 → `while true` 라 영원히 안 닫힘 →
# `$(...)` 가 영구 hang (cmd_run 이 첫 cadence 에서 멈춰 60s/300s/main loop
# 자체가 시작 안 됨). spawn_guard 가 guard_loop 출력을 파일로 보내 무사했던
# 것과 동일한 이유. → fd 를 파일로 분리해 파이프를 즉시 닫는다.
spawn_cadence() {
    local label="$1" interval="$2"; shift 2
    local mods="$*"
    (
        while true; do
            if _hexa_lock_busy; then
                log "$label: hexa_stage0 lock held — skip"
            else
                local m
                for m in $mods; do
                    run_hexa_mod "$m"
                done
            fi
            _isleep "$interval"
        done
    ) >>"$LOG_DIR/${label}.stdout.log" 2>>"$LOG_DIR/${label}.stderr.log" &
    echo $!
}

cmd_run() {
    echo $$ > "$PID_FILE"
    log "supervisor starting PID=$$"

    local guard_pid
    guard_pid="$(spawn_guard)"
    log "runtime-guard forked PID=$guard_pid"

    # 비동기 cadence — 모듈별 독립 sleep, 60s 공유 tick 제거.
    #   60s : probe · dispatch · harvest · label
    #   300s: forecast
    # NOTE: displaylink 는 bash cadence 에서 제거됨 (2026-05-15). 매 10s
    # `timeout`(gtimeout) spawn 이 macOS TCC 폴더접근 프롬프트를 반복 유발 +
    # bash 는 잘못된 레이어. → airgenome 네이티브 앱 메뉴바 토글로 이관
    # ([@c_displaylink_lifecycle] · g_single_process).
    local cad60_pid cad300_pid
    cad60_pid="$(spawn_cadence cadence-60s 60 probe dispatch harvest label)"
    log "cadence-60s forked PID=$cad60_pid (probe·dispatch·harvest·label)"
    cad300_pid="$(spawn_cadence cadence-300s 300 forecast)"
    log "cadence-300s forked PID=$cad300_pid (forecast)"

    # 시그널 시 guard + 모든 cadence + 하위 프로세스 전부 TERM, pid 파일 정리.
    trap '
        log "supervisor SIGTERM/SIGINT";
        for _p in "${guard_pid:-}" "${cad60_pid:-}" "${cad300_pid:-}"; do
            [ -n "$_p" ] && kill -TERM "$_p" 2>/dev/null || true
        done
        pkill -TERM -P $$ 2>/dev/null || true;
        rm -f "$PID_FILE" "$GUARD_PID_FILE";
        exit 0
    ' TERM INT

    # main loop — guard + cadence health check (30s tick).
    # 모듈 실행은 위 cadence 서브쉘이 담당, 여기는 supervision 만.
    while true; do
        if ! kill -0 "$guard_pid" 2>/dev/null; then
            log "runtime-guard PID=$guard_pid died — respawning"
            guard_pid="$(spawn_guard)"
            log "runtime-guard respawned PID=$guard_pid"
        fi
        if ! kill -0 "$cad60_pid" 2>/dev/null; then
            log "cadence-60s PID=$cad60_pid died — respawning"
            cad60_pid="$(spawn_cadence cadence-60s 60 probe dispatch harvest label)"
            log "cadence-60s respawned PID=$cad60_pid"
        fi
        if ! kill -0 "$cad300_pid" 2>/dev/null; then
            log "cadence-300s PID=$cad300_pid died — respawning"
            cad300_pid="$(spawn_cadence cadence-300s 300 forecast)"
            log "cadence-300s respawned PID=$cad300_pid"
        fi
        _isleep 30
    done
}

# ============================================================
# list / offload — .workspace 기반 자원 조회 + 원격 dispatch (2026-04-21)
# ============================================================
INFRA_STATE="$HOME/core/nexus/infra_state.json"
WORKSPACE_SRC="$HOME/core/.workspace"

_offload_ssh_host() {
    case "$1" in
        ubu1|ubu)     echo "ubu" ;;
        ubu2)         echo "ubu2" ;;
        htz|hetzner)  echo "hetzner" ;;
        *)            echo "" ;;
    esac
}

_offload_state_key() {
    case "$1" in
        ubu1|ubu)     echo "ubu" ;;
        ubu2)         echo "ubu2" ;;
        htz|hetzner)  echo "htz" ;;
        *)            echo "" ;;
    esac
}

cmd_list() {
    local kind="${1:-hosts}"
    case "$kind" in
        hosts|h|"")
            if [ ! -f "$INFRA_STATE" ]; then
                echo "[airgenome-list] infra_state.json 부재: $INFRA_STATE" >&2
                return 1
            fi
            printf '%-10s %-10s %-10s %-8s %s\n' HOST STATUS LOAD CPU RAM
            jq -r '.hosts | to_entries[] | [.key,(.value.status//"?"),((.value.load//((.value.cpu_pct|tostring)+"%"))|tostring),((.value.cpu_threads|tostring)+"T"),((.value.ram_used_mb|tostring)+"/"+(.value.ram_total_mb|tostring)+"MB")] | @tsv' "$INFRA_STATE" 2>/dev/null \
              | awk -F'\t' '{printf "%-10s %-10s %-10s %-8s %s\n",$1,$2,$3,$4,$5}'
            local ts
            ts=$(jq -r '.ts // "?"' "$INFRA_STATE" 2>/dev/null)
            echo "(probe ts: $ts)"
            ;;
        workspace|ws)
            [ -f "$WORKSPACE_SRC" ] || { echo "[airgenome-list] .workspace 부재: $WORKSPACE_SRC" >&2; return 1; }
            grep -E '^(resource|command) ' "$WORKSPACE_SRC"
            ;;
        projects|p)
            grep -E '^member ' "$WORKSPACE_SRC" 2>/dev/null || echo "no projects"
            ;;
        *)
            echo "usage: airgenome list [hosts|workspace|projects]" >&2
            return 2
            ;;
    esac
}

cmd_offload() {
    local target="${1:-}"
    shift || true
    if [ -z "$target" ] || [ $# -eq 0 ]; then
        cat >&2 <<'HELP'
usage: airgenome offload <target> <command...>

targets:
  ubu1 | ubu    — ssh alias: ubu     (12T CPU, GPU)
  ubu2          — ssh alias: ubu2    (12T CPU)
  htz | hetzner — ssh alias: hetzner (32T CPU)

env:
  AIRG_OFFLOAD_TIMEOUT=5   ssh ConnectTimeout seconds
  AIRG_OFFLOAD_FORCE=1     skip offline-status pre-check

examples:
  airgenome offload ubu2 'uname -a && free -h'
  airgenome offload htz  'bash ~/jobs/train.sh'
  airgenome offload ubu1 'nvidia-smi'
HELP
        return 2
    fi
    local ssh_host state_key
    ssh_host=$(_offload_ssh_host "$target")
    state_key=$(_offload_state_key "$target")
    if [ -z "$ssh_host" ]; then
        echo "[airgenome-offload] unknown target: $target (ubu1|ubu2|htz)" >&2
        return 2
    fi
    if [ -z "${AIRG_OFFLOAD_FORCE:-}" ] && [ -f "$INFRA_STATE" ] && command -v jq >/dev/null 2>&1; then
        local status reason
        status=$(jq -r ".hosts[\"$state_key\"].status // \"unknown\"" "$INFRA_STATE" 2>/dev/null)
        if [ "$status" = "offline" ]; then
            reason=$(jq -r ".hosts[\"$state_key\"].reason // \"\"" "$INFRA_STATE" 2>/dev/null)
            echo "[airgenome-offload] REFUSE: $target=offline ($reason) — AIRG_OFFLOAD_FORCE=1 로 우회 가능" >&2
            return 3
        fi
    fi
    local to="${AIRG_OFFLOAD_TIMEOUT:-5}"
    # Pass args joined with spaces — remote sh parses shell metacharacters naturally.
    # Callers quote the full command as a single arg (examples in usage).
    # ControlMaster/ControlPath=none — sandboxed harnesses (e.g. Claude Code)
    # block socket link in ~/.ssh/cm/; avoid mux entirely for offload robustness.
    exec ssh -o ConnectTimeout="$to" -o BatchMode=yes \
             -o ControlMaster=no -o ControlPath=none \
             "$ssh_host" "$*"
}

# ============================================================
# airgenome tap subcommand (unified CGEventTap + AX @ airgenome/native/)
# ============================================================
#
# Combines mouse buttons (4/5 → Cmd+[/]) + scroll inversion + 8-zone window
# magnet + native tiling lockout into a single binary so Accessibility / TCC
# only needs one permission grant for the entire airgenome input stack.

cmd_tap() {
    local sub="${1:-status}"
    shift || true
    if [ ! -d "$AIRGENOME_TAP_ROOT" ]; then
        echo "[airgenome-tap] not found: $AIRGENOME_TAP_ROOT" >&2
        echo "  set AIRGENOME_TAP_ROOT or check airgenome/native/ exists" >&2
        return 2
    fi
    case "$sub" in
        build)      ( cd "$AIRGENOME_TAP_ROOT" && make build ) ;;
        install)    ( cd "$AIRGENOME_TAP_ROOT" && make install ) ;;
        uninstall)  ( cd "$AIRGENOME_TAP_ROOT" && make uninstall ) ;;
        status)     ( cd "$AIRGENOME_TAP_ROOT" && make status ) ;;
        logs)       ( cd "$AIRGENOME_TAP_ROOT" && make logs ) ;;
        selftest)   ( cd "$AIRGENOME_TAP_ROOT" && make selftest ) ;;
        restart)    launchctl kickstart -k "gui/$UID_VAL/$AIRGENOME_TAP_LABEL" ;;
        rebuild)
            ( cd "$AIRGENOME_TAP_ROOT" && make install ) || return $?
            cat >&2 <<'NOTE'

[airgenome-tap] rebuild + install done. NEW BINARY = NEW cdhash → macOS revoked Accessibility.
  fix: System Settings → Privacy & Security → Accessibility →
       remove the existing 'airgenome' entry → re-add /Applications/airgenome.app → toggle on
  then: airgenome tap restart
NOTE
            ;;
        clean)      ( cd "$AIRGENOME_TAP_ROOT" && make clean ) ;;
        migrate)
            # one-time migration: bootout legacy mouse_remap + window_magnet
            # LaunchAgents (replaced by single com.airgenome.tap).
            local label
            for label in $LEGACY_TAP_LABELS; do
                if launchctl print "gui/$UID_VAL/$label" >/dev/null 2>&1; then
                    launchctl bootout "gui/$UID_VAL/$label" 2>/dev/null || true
                    rm -f "$HOME/Library/LaunchAgents/$label.plist"
                    echo "[airgenome-tap] migrated: bootout + plist removed for $label"
                fi
            done
            ;;
        restore-native)
            # Manual recovery if SIGKILL prevented the daemon from restoring
            # the native tiling defaults.
            for k in EnableTilingByEdgeDrag EnableTopTilingByEdgeDrag EnableTilingOptionAccelerator; do
                defaults delete com.apple.WindowManager "$k" 2>/dev/null || true
            done
            killall WindowManager 2>/dev/null || true
            echo "[airgenome-tap] native tiling defaults deleted (back to macOS defaults). re-run airgenome tap restart to re-disable."
            ;;
        help|-h|--help|"")
            cat >&2 <<'HELP'
usage: airgenome tap <subcommand>

  build           clang → native/build/airgenome (raw binary)
  app             build + 🧬 .icns + .app 번들 (native/build/airgenome.app)
  install         app + /Applications/airgenome.app 배포 + LaunchAgent + log dir
  uninstall       bootout + plist + /Applications/airgenome.app 제거
  status          launchctl print + bundle/log path + 현재 native-tiling defaults
  logs            tail ~/Library/Logs/airgenome.app/airgenome.{log,err}
  selftest        2s foreground 실행 → sentinel 검증
  restart         launchctl kickstart -k (Accessibility 재grant 후)
  rebuild         build + app + install + 재grant 안내
  clean           rm -rf native/build/
  migrate         legacy mouse_remap/window_magnet LaunchAgent bootout (1회 마이그레이션)
  restore-native  daemon SIGKILL 후 native 설정 복구 (delete + WindowManager kick)

기능 (3-feature 단일 binary, 1 Accessibility grant):
  (a) mouse button 4/5  →  Cmd+[ / Cmd+]   (Finder/Safari 뒤로/앞으로)
  (b) mouse-wheel scroll 방향 반전          (트랙패드는 macOS 기본 유지)
  (c) 8-zone 드래그-스냅:
        ┌────┬────┬────┐  T  = 상단 절반   TL/TR = 좌·우상단 1/4
        │ TL │ T  │ TR │  B  = 하단 절반   BL/BR = 좌·우하단 1/4
        ├────┴────┴────┤  L  = 좌 절반     edge=20px / corner=40px
        │ L  │    │ R  │  R  = 우 절반     (corner > edge priority)
        ├────┬────┬────┤
        │ BL │ B  │ BR │
        └────┴────┴────┘

  daemon 가동 중 macOS 기본 tiling 비활성화 (3-key flip + restore on exit):
    com.apple.WindowManager.{EnableTilingByEdgeDrag,
                             EnableTopTilingByEdgeDrag,
                             EnableTilingOptionAccelerator}

env (per-feature toggle, default 모두 1):
  AIRGENOME_TAP_ROOT=$HOME/core/airgenome/native
  AIRG_TAP_MOUSE_BUTTONS=1     button4/5 매핑
  AIRG_TAP_MOUSE_SCROLL=1      mouse-wheel 반전
  AIRG_TAP_MAGNET=1            8-zone 드래그-스냅
  AIRG_TAP_DISABLE_NATIVE=1    macOS 기본 tiling 비활성화
  AIRG_TAP_EDGE_PX=20          edge 임계 px
  AIRG_TAP_CORNER_PX=40        corner 임계 px
  AIRG_TAP_DRAG_MIN_PX=8       click-vs-drag 거리

examples:
  airgenome tap install         # 첫 설치 (Accessibility grant 필요)
  airgenome tap migrate         # 구 mouse_remap/window_magnet LaunchAgent 정리
  airgenome tap status          # 현재 state + native defaults
  airgenome tap rebuild         # 코드 수정 후 재빌드 + 재grant 안내
HELP
            ;;
        *)
            echo "[airgenome-tap] unknown: $sub" >&2
            echo "  airgenome tap help" >&2
            return 2
            ;;
    esac
}

# ============================================================
# overload-check subcommand — in-process load watcher (live in airgenome.app)
# ============================================================
#
# 단일 launchd 진입점 정책: 별도 plist 없음. airgenome.app 안의
# 60s dispatch_source_t timer 가 sysctl vm.loadavg + ps 를 보고
#   - load1>80      → "macOS overload" 알림 + 가장 무거운 non-claude / non-system
#                     PID 상위 N개를 taskpolicy -b (Darwin background tier) 강등 →
#                     claude code CLI (…/claude.real wrapping + 실 CLI) 가 P-core 독식.
#                     load 회복 시 전부 default 로 원복.
#   - 단일 PID CPU>80% × 10min  → "runaway PID" 알림 + 해당 PID background 강등
#   - 매 tick: claude code CLI PID 들을 taskpolicy -B (not-background) 유지 (상시 약-부스트)
# 메뉴바 "Overload watch (...)" 토글로 on/off (off 시 강등 PID 원복).
#
# 본 CLI 는 status/test/logs 만 — 실 토글은 메뉴바에서. 메커니즘은 taskpolicy
# 만 사용 (renice 상향은 root 없이 되돌릴 수 없어 회피). kill 미수행.

cmd_overload_check() {
    local sub="${1:-status}"
    shift || true
    local airg_dir="$HOME/.airgenome"
    local state_file="$airg_dir/menubar.state"
    local log_file="$airg_dir/overload_check.log"
    local queue_file="$airg_dir/notify_queue.jsonl"
    case "$sub" in
        status)
            local on="(default ON)"
            if [ -f "$state_file" ]; then
                local v
                v=$(grep -E '^overload=' "$state_file" 2>/dev/null | head -1 | cut -d= -f2)
                [ -n "$v" ] && on="$v"
            fi
            echo "overload-check:"
            echo "  toggle:    $on  (menubar: 'Overload watch (load>80 → claude priority)' 항목)"
            echo "  state:     $state_file"
            echo "  log:       $log_file"
            echo "  queue:     $queue_file"
            if [ -f "$log_file" ]; then
                echo
                echo "recent log (tail 5):"
                tail -n 5 "$log_file" | sed 's/^/  /'
            fi
            ;;
        test)
            mkdir -p "$airg_dir"
            local title="${1:-macOS overload (test)}"
            local info="${2:-airgenome overload-check test fire @ $(date '+%H:%M:%S')}"
            # JSON-escape: backslash + double-quote
            local t i
            t=${title//\\/\\\\}; t=${t//\"/\\\"}
            i=${info//\\/\\\\}; i=${i//\"/\\\"}
            printf '{"title":"%s","subtitle":"","info":"%s"}\n' "$t" "$i" >> "$queue_file"
            echo "queued → $queue_file"
            echo "  airgenome.app 가 10s 안에 drain → NSUserNotification 발사."
            ;;
        logs)
            if [ ! -f "$log_file" ]; then
                echo "(no log yet — airgenome.app 미실행 또는 첫 tick 전)"
                return 0
            fi
            tail -n 40 "$log_file"
            ;;
        run-once)
            # 외부 워처 호환: scripts/overload_check.sh 1회 실행 (in-process timer
            # 와 별개로 동일 로직을 ad-hoc 실행 — 디버그/CI 용).
            "$AIRGENOME_ROOT/scripts/overload_check.sh"
            ;;
        help|-h|--help|"")
            cat >&2 <<'HELP'
usage: airgenome overload-check <subcommand>

  status     menubar 토글 상태 + 로그 경로 + 최근 5줄
  test [title] [info]  큐에 알림 한 건 enqueue (airgenome.app 가 10s 내 drain)
  logs       tail ~/.airgenome/overload_check.log
  run-once   scripts/overload_check.sh 1회 실행 (in-process 와 별개의 ad-hoc check)

토글 (live):
  airgenome.app 메뉴바 → "Overload watch (load>80 → claude priority)"
  체크/해제 즉시 반영 + ~/.airgenome/menubar.state 에 persist (off → 강등 PID 원복)

설정 (컴파일 시 상수, 2026-05-10 — idle 직전 조기 경보 + claude 우선 게이트):
  load 임계:   1min loadavg > 80
  CPU 임계:    단일 PID > 80% × 10min sustained → runaway 알림 + 해당 PID 강등
  강등 대상:   load>80 시 CPU>15% non-claude / non-system PID 상위 12개 → taskpolicy -b
  claude 보호: …/claude.real (wrapping) + 실 claude CLI → 매 tick taskpolicy -B
  복원:        load 회복 / watcher off / app 종료 시 강등 PID 전부 default 로
  Tick:        60s
  쿨다운:      load 알림 10min (같은 조건 재발화 차단)
HELP
            ;;
        *)
            echo "[overload-check] unknown: $sub" >&2
            echo "  airgenome overload-check help" >&2
            return 2
            ;;
    esac
}

# ============================================================
# governance — raw 91 cross-repo cli-coverage parity (2026-04-30)
# ============================================================
# Mirrors hive_governance.hexa Tier-A surface via tool/governance.hexa
# wrapper. backends are cross-repo siblings (../hexa-lang, ../hive) so
# airgenome owns no local copies. canonical entry: `airgenome governance ...`.
cmd_governance() {
    local mod="$AIRGENOME_ROOT/tool/governance.hexa"
    if [ ! -f "$mod" ]; then
        # fallback: $HOME/core/airgenome (dev workspace)
        mod="$HOME/core/airgenome/tool/governance.hexa"
    fi
    if [ ! -f "$mod" ]; then
        echo "[airgenome-governance] tool/governance.hexa missing: $mod" >&2
        return 1
    fi
    # resolve hexa with fallback ($HOME/.hx/bin/hexa is canonical post-2026-04)
    # Prefer hexa.real over the ~/.hx/bin/hexa routing shim. The shim
    # unconditionally dispatches `hexa run` to a remote resource host (ubu-1)
    # which breaks Mac-local orchestrator semantics (tool/governance.hexa
    # manages launchd plists + guard logic local to this Mac).
    local hexa_bin="$HEXA"
    if [ ! -x "$hexa_bin" ]; then
        if [ -x "$HOME/.hx/packages/hexa/hexa.real" ]; then
            hexa_bin="$HOME/.hx/packages/hexa/hexa.real"
        elif [ -x "$HOME/.hx/bin/hexa" ]; then
            hexa_bin="$HOME/.hx/bin/hexa"
        else
            hexa_bin="$(command -v hexa 2>/dev/null || true)"
        fi
    fi
    [ -x "$hexa_bin" ] || die "hexa binary missing (tried HEXA + ~/.hx/bin/hexa + PATH)"
    exec "$hexa_bin" run "$mod" "$@"
}

