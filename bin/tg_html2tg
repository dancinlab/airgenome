#!/usr/bin/env python3
"""tg_html2tg — HTML → Telegraph nodes JSON. stdin=HTML. stdout=JSON node array.
Upload is done by the bash caller via curl (more reliable than urllib)."""
import html.parser, json, sys

ALLOWED = {"a","aside","b","blockquote","br","code","em","figcaption","figure",
           "h3","h4","hr","i","iframe","img","li","ol","p","pre","s",
           "strong","u","ul","video"}
REMAP = {"h1":"h3","h2":"h3","h5":"h4","h6":"h4","div":"p"}
VOID = {"br","hr","img"}

class H2T(html.parser.HTMLParser):
    def __init__(self):
        super().__init__(convert_charrefs=True)
        self.root=[]; self.stack=[self.root]; self._skip=0; self._tbl=None
    def _push(self,n):
        if self._skip: return
        self.stack[-1].append(n)
    def handle_starttag(self,tag,attrs):
        tag = REMAP.get(tag,tag)
        if tag=="table":
            self._tbl=[]; self._skip+=1; return
        if tag not in ALLOWED:
            self._skip+=1; return
        n={"tag":tag}
        a={k:v for k,v in attrs if v is not None}
        if a: n["attrs"]=a
        if tag not in VOID:
            n["children"]=[]; self._push(n); self.stack.append(n["children"])
        else:
            self._push(n)
    def handle_endtag(self,tag):
        tag = REMAP.get(tag,tag)
        if tag=="table":
            self._skip-=1
            txt="".join(self._tbl or []).strip(); self._tbl=None
            if txt: self._push({"tag":"pre","children":[txt]})
            return
        if tag not in ALLOWED:
            self._skip=max(0,self._skip-1); return
        if tag in VOID: return
        if len(self.stack)>1: self.stack.pop()
    def handle_data(self,data):
        if self._tbl is not None:
            self._tbl.append(data); return
        if self._skip: return
        if data: self.stack[-1].append(data)

p=H2T(); p.feed(sys.stdin.read()); p.close()
nodes=p.root or [{"tag":"pre","children":["(empty)"]}]
json.dump(nodes, sys.stdout, ensure_ascii=False)
