    if sub == "remote" {
        println("airgenome remote <ubu1|htz|hetzner> <sub> [args...]")
        println("  예:  airgenome remote ubu1 harvest")
        println("       airgenome remote htz ring-count")
        return
    }
    if sub == "help" {
        println("airgenome help [sub] — 도움말. sub 생략시 전체 트리.")
        return
    }
    if sub == "session-defaults" || sub == "session_defaults" || sub == "sd" {
        println("airgenome session-defaults — .session_defaults SSOT 진단 + 강제")
        println("  source: bin/airgenome-session-defaults")
        println("  SSOT:   $AIRGENOME/.session_defaults (단일 파일)")
        println("  subs:")
        println("    show            파일 내용")
        println("    status          1줄 요약 (hash/lines/shim_first/AIRGENOME)")
        println("    doctor          전수 점검 (파일/shim/PATH/env/Dockerfile)")
        println("    doctor --remote 위 + 원격 호스트 (ubu1/ubu2/htz) hash drift")
        println("    verify          실제 주입 재현 테스트 (PASS/FAIL)")
        println("    sync            원격 호스트로 .session_defaults 전파")
        println("  주입 누락 탐지 포인트:")
        println("    · AIRGENOME_CLAUDE_SHIM env 누출 (삭제된 env guard regression)")
        println("    · PATH[first claude] != shim")
        println("    · Dockerfile COPY/ENV/fence 누락")
        println("    · 원격 호스트 hash drift")
        return
    }
    println("airgenome help: unknown subcommand '" + sub + "'")
    println("try 'airgenome help' for the full list.")
}

// argv tail slice — a[from..] 을 [str] 로 복사.
fn argv_tail(a: [str], from: int) -> [str] {
    let mut out = []
    let mut i = from
    while i < len(a) {
        out = out + [a[i]]
        i = i + 1
    }
    return out
}

fn main() -> void {
    let a = args()
    if len(a) < 3 {
        print_help()
        return
    }
    let sub = a[2]
    if sub == "help" {
        if len(a) >= 4 { print_help_sub(a[3]) } else { print_help() }
        return
    }
    // status: 새로운 3-host module 을 기본. --legacy 는 구 launchd 뷰.
    if sub == "status" {
        if len(a) >= 4 && a[3] == "--legacy" { cmd_status(); return }
        let _ = run_module_args("status", argv_tail(a, 3))
        return
    }
    if sub == "install" {
        let mut mode = "all"
        if len(a) >= 4 { mode = a[3] }
        cmd_install(mode)
        return
    }
    if sub == "init" {
        // airgenome init [--target=X] [--dry-run]
        let mut tgt = "all"
        let mut dry = false
        let mut ii = 3
        while ii < len(a) {
            let tok = a[ii]
            if tok.starts_with("--target=") { tgt = tok.substring(9, len(tok)) }
            else if tok == "--target" && ii + 1 < len(a) { tgt = a[ii + 1]; ii = ii + 1 }
            else if tok == "--dry-run" { dry = true }
            else if tok == "mac" || tok == "all" || tok == "ubu1" || tok == "ubu" || tok == "ubu2" || tok == "htz" { tgt = tok }
            ii = ii + 1
        }
        cmd_init(tgt, dry)
        return
    }
    if sub == "uninstall" { cmd_uninstall(); return }
    if sub == "self-test" { cmd_self_test_all(); return }
    if sub == "menubar" { cmd_menubar(); return }
    if sub == "build-menubar" { cmd_build_menubar(); return }
    if sub == "doctor" { cmd_doctor(); return }
    if sub == "logs" {
        let mut ag = ""
        let mut n = 20
        if len(a) >= 4 { ag = a[3] }
        if len(a) >= 5 { n = to_int(a[4]) }
        cmd_logs(ag, n)
        return
    }
    if sub == "remote" {
        if len(a) < 5 {
            println("usage: airgenome remote <ubu1|htz> <sub> [args...]")
            return
        }
        let host = a[3]
        // 나머지 args 를 공백 join
        let mut rest = a[4]
        let mut i = 5
        while i < len(a) {
            rest = rest + " " + a[i]
            i = i + 1
        }
        cmd_remote(host, rest)
        return
    }
    if sub == "cli" { cmd_cli(); return }
    if sub == "watch" {
        let mut ival = 2
        if len(a) >= 4 { ival = to_int(a[3]) }
        cmd_watch(ival)
        return
    }
    if sub == "slots" {
        // airgenome slots                 → JSON (used/total/stale)
        // airgenome slots --human         → table
        // airgenome slots --reset         → stale lock 청소
        // airgenome slots --watch [sec]   → 5s 간격 실시간
        let mut arg = ""
        let mut ival = 5
        if len(a) >= 4 { arg = a[3] }
        if len(a) >= 5 { ival = to_int(a[4]) }
        if arg == "--reset" { cmd_slots_reset(); return }
        if arg == "--watch" { cmd_slots_watch(ival); return }
        if arg == "--human" { cmd_slots_show(false); return }
        if arg == "" || arg == "--json" { cmd_slots_show(true); return }
        println("usage: airgenome slots [--json|--human|--reset|--watch [sec]]")
        return
    }
    if sub == "harvest" { let _ = run_module("harvest"); return }
    if sub == "label" { let _ = run_module("label"); return }
    if sub == "forecast" { let _ = run_module("forecast"); return }
    if sub == "dispatch" { let _ = run_module("dispatch"); return }
    if sub == "probe" { let _ = run_module("probe"); return }
    if sub == "merge" { let _ = run_module("genome_merge"); return }
    if sub == "throttle" { let _ = run_module("predictive_throttle"); return }
    // ── 신규 서브커맨드 (M12~M15 추가 모듈 연결) ──
    if sub == "forecast-eval" {
        let _ = run_module_args("forecast_eval", argv_tail(a, 3))
        return
    }
    if sub == "dashboard" {
        let _ = run_module_args("dashboard", argv_tail(a, 3))
        return
    }
    if sub == "claude-route" {
        let _ = run_module_args("claude_route", argv_tail(a, 3))
        return
    }
    if sub == "worker" {
        let _ = run_module_args("worker", argv_tail(a, 3))
        return
    }
    if sub == "session-snapshot" {
        let _ = run_module_args("session_snapshot_cmd", argv_tail(a, 3))
        return
    }
    if sub == "runaway-guard" || sub == "runaway_guard" || sub == "runaway" {
        let _ = run_bin_hexa("runaway_guard", argv_tail(a, 3))
        return
    }
    if sub == "tg-bot" || sub == "tg_bot" {
        let _ = run_bin_hexa("tg_bot", argv_tail(a, 3))
        return
    }
    if sub == "deploy" {
        let _ = run_bin_hexa("deploy", argv_tail(a, 3))
        return
    }
    if sub == "install-agents" || sub == "install_agents" {
        let _ = run_bin_hexa("install_agents", argv_tail(a, 3))
        return
    }
    if sub == "agent-run" || sub == "agent_run" {
        // F7 AGENT_DIST — prompt 을 dispatch_state best host 로 ssh 래핑 발사.
        //   --prompt=... [--host=auto|mac|ubu1|ubu2|htz] [--kind=compute|heavy|gpu]
        //   [--timeout=300] [--output=file|stdout] [--dry-run|--no-dry-run]
        let _ = run_bin_hexa("agent_run", argv_tail(a, 3))
        return
    }
    if sub == "netlat" {
        // airgenome netlat [probe|tail|stats|watch|alert-check] [args]
        let _ = run_bin_sh("airgenome-netlat", argv_tail(a, 3))
        return
    }
    if sub == "session-defaults" || sub == "session_defaults" || sub == "sd" {
        // airgenome session-defaults [show|status|doctor|verify|sync]
        let _ = run_bin_sh("airgenome-session-defaults", argv_tail(a, 3))
        return
    }
    println("airgenome: unknown subcommand '" + sub + "'. try 'airgenome help'.")
}

main()
