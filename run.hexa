    if sub == "init" {
        println("airgenome init [--target=T] [--dry-run] — 수작업 없는 one-shot 배포")
        println("  target: mac | ubu1 | ubu2 | htz | all(기본)")
        println("  mac:    shared/launchagents/*.plist 17개 → ~/Library/LaunchAgents + launchctl bootstrap")
        println("  원격:   shared/systemd/* → /etc/systemd/system + daemon-reload + enable --now")
        println("          docker airgenome-claude 있으면 pull + restart + authorized_keys 배포")
        println("  SSOT:   hosts.json 의 ip/ssh_user/ssh_key (fallback key=$HOME/.ssh/id_ed25519)")
        println("  fallback: rsync 부재 환경은 tar|ssh|tar pipe 로 전송 (컨테이너 호환)")
        println("  self-test: 완료 후 자동 systemctl is-active / launchctl list 검증")
        return
    }
    if sub == "uninstall" {
        println("airgenome uninstall — com.airgenome.* LaunchAgent 전부 bootout + plist 제거")
        return
    }
    if sub == "self-test" {
        println("airgenome self-test — 모든 module + runaway_guard + core self-test 일괄")
        return
    }
    if sub == "menubar" || sub == "build-menubar" {
        println("airgenome build-menubar — bin/menubar.hexa → native binary (hexa_v2 + clang)")
        println("airgenome menubar       — built binary foreground 실행")
        println("  binary: build/artifacts/airgenome-menubar")
