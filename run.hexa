// cmd_logs — ~/.airgenome/<agent>.{stdout,stderr}.log 최근 tail.
// 사용: airgenome logs [agent_short_name] [N=20]
//   airgenome logs             → 전 agent summary (각 5줄)
//   airgenome logs menubar     → menubar stdout+stderr tail 20
//   airgenome logs throttle 50 → predictive_throttle 50줄
fn cmd_logs(agent: str, lines: int) -> void {
    let log_dir = env_var("HOME") + "/.airgenome"
    let n = if lines < 1 { 20 } else { lines }
    if agent == "" || agent == "all" {
        println("⬡ airgenome logs — all agents (each last 5)")
        let list = exec("ls -1 '" + log_dir + "'/*.log 2>/dev/null | head -20").trim()
        if list == "" { println("  (no logs under " + log_dir + ")"); return }
        let bulk = exec("for f in '" + log_dir + "'/*.log; do echo \"=== $(basename $f) ===\"; tail -5 \"$f\" 2>/dev/null; echo; done")
        print(bulk)
        return
    }
    // agent short name → underscore 허용 (ring-sync → ring_sync)
    let short = agent
    let patterns = [short + ".stdout.log", short + ".stderr.log", short + "_stdout.log"]
    let mut i = 0
    let mut any = 0
    while i < len(patterns) {
        let p = log_dir + "/" + patterns[i]
        let exists = exec("[ -f '" + p + "' ] && echo y || echo n").trim()
        if exists == "y" {
            println("=== " + patterns[i] + " (last " + to_string(n) + ") ===")
            let out = exec("tail -" + to_string(n) + " '" + p + "' 2>/dev/null")
            print(out)
            println("")
            any = any + 1
        }
        i = i + 1
    }
    if any == 0 {
        println("❌ no logs for agent '" + agent + "' under " + log_dir)
        println("   try: airgenome logs all")
    }
}

// cmd_remote — ssh ubu1/htz 에 airgenome 모듈 원격 실행.
// 사용: airgenome remote <host> <module> [args...]
//   airgenome remote ubu1 harvest       (legacy 'ubu' 도 수용)
//   airgenome remote htz probe
//   airgenome remote ubu1 ring-count    — 간편 명령 (forge/genomes.ring wc -l)
fn cmd_remote(host: str, rest: str) -> void {
    if host != "ubu" && host != "ubu1" && host != "htz" && host != "hetzner" {
        println("❌ unknown host: " + host + " (ubu1 | htz | hetzner)")
        return
    }
    // ssh_alias: ubu1 host key 의 ssh_alias 는 여전히 'ubu' (Mac ssh config legacy)
    let ssh_host = if host == "htz" { "hetzner" } else { if host == "ubu1" { "ubu" } else { host } }
    let is_ubu = host == "ubu" || host == "ubu1"
    // ring 경로: forge/genomes.ring — ubu1 = $AIRGENOME, htz = /root/Dev/airgenome
    let ring_root = if is_ubu { "$AIRGENOME" } else { "/root/Dev/airgenome" }
    // modules 경로: 원격 deploy 구조가 다름 — ubu1 = ~/airgenome-v2, htz = /root/Dev/airgenome
    let module_root = if is_ubu { "~/airgenome-v2" } else { "/root/Dev/airgenome" }

    // 간편 명령 ring-count — 모듈 실행 없이 ring 개수만
    if rest == "ring-count" {
        println("⬡ remote " + ssh_host + " ring-count")
        let out = exec("ssh -o ConnectTimeout=5 " + ssh_host + " 'wc -l " + ring_root + "/forge/genomes.ring 2>/dev/null' 2>&1")
        print(out)
        return
    }

    // 모듈 직접 실행 — modules/<rest>.hexa
    let parts = rest.split(" ")
    let module_name = parts[0]
    let mut mod_args = ""
    let mut i = 1
    while i < len(parts) {
        mod_args = mod_args + " " + parts[i]
        i = i + 1
    }
    let module_path = module_root + "/modules/" + module_name + ".hexa"

    // 원격 hexa resolver (non-interactive ssh shell PATH 없음)
    let hexa_resolver = "HEXA=\"\"; for c in \\$NEXUS/shared/bin/hexa /tmp/hexa-build/hexa-lang/target/release/hexa /root/Dev/nexus/shared/bin/hexa; do [ -x \\\"\\$c\\\" ] && HEXA=\\\"\\$c\\\" && break; done; [ -n \\\"\\$HEXA\\\" ] || { echo 'remote: hexa not found' >&2; exit 1; }; "
    let remote_cmd = "cd " + module_root + " && " + hexa_resolver + " \\$HEXA run " + module_path + mod_args
    println("⬡ remote " + ssh_host + " " + module_name + mod_args)
    println("---")
    let out = exec("ssh -o ConnectTimeout=10 " + ssh_host + " \"" + remote_cmd + "\" 2>&1")
    print(out)
}

// cmd_slots — bin/cx 의 per-host slot 상태 조회/청소/watch.
// SSOT: ${CLAUDX_STATE:-$HOME/.airgenome}/cx_slots/<host>_<i>/pid
// used = pid 파일 프로세스 살아있는 slot 수, total = hosts.json 의 max_claude_concurrent
//        (누락 시 kind 기본값 self=8/lan=2/remote=4).
//
// 사용:
//   airgenome slots                — JSON (host/used/total/stale)
//   airgenome slots --reset        — stale lock 일괄 청소
//   airgenome slots --watch [sec]  — 실시간 표시 (기본 5초)
fn slots_dir() -> str {
    let state = env("CLAUDX_STATE")
    let base = if state == "" { env("HOME") + "/.airgenome" } else { state }
    return base + "/cx_slots"
}

fn host_capacity_default(host: str, kind: str) -> int {
    if host == "mac" { return 8 }
    if host == "ubu" || host == "ubu1" || host == "ubu2" { return 2 }
    if host == "htz" || host == "hetzner" { return 4 }
    if kind == "self" { return 8 }
    if kind == "lan" { return 2 }
    if kind == "remote" { return 4 }
    return 2
}

fn hosts_registry_path() -> str {
    return ag_root() + "/shared/config/hosts.json"
}

// 한 host 에 대해 used/stale count 반환 — output 은 "used\tstale" tsv.
fn slot_counts_tsv(host: str, cap: int) -> str {
    let dir = slots_dir()
    let script = "u=0; s=0; for i in $(seq 1 " + to_string(cap) + "); do d='" + dir + "/" + host + "_'$i; [ -d \"$d\" ] || continue; p=$(cat \"$d/pid\" 2>/dev/null); if [ -n \"$p\" ] && kill -0 \"$p\" 2>/dev/null; then u=$((u+1)); else s=$((s+1)); fi; done; printf '%s\\t%s' \"$u\" \"$s\""
    return exec(script).trim()
}

fn slot_reset_host(host: str, cap: int) -> int {
    let dir = slots_dir()
    let script = "removed=0; for i in $(seq 1 " + to_string(cap) + "); do d='" + dir + "/" + host + "_'$i; [ -d \"$d\" ] || continue; p=$(cat \"$d/pid\" 2>/dev/null); if [ -z \"$p\" ] || ! kill -0 \"$p\" 2>/dev/null; then rm -rf \"$d\" && removed=$((removed+1)); fi; done; printf '%s' \"$removed\""
    let out = exec(script).trim()
    return to_int(out)
}

fn slots_hosts_list() -> str {
    // hosts.json 순서 보존 — jq 의 to_entries 는 순서 유지
    return exec("jq -r '.hosts | to_entries | .[] | \"\\(.key)\\t\\(.value.kind // \"\")\\t\\(.value.max_claude_concurrent // \"\")\"' '" + hosts_registry_path() + "' 2>/dev/null").trim()
}

fn cmd_slots_show(as_json: bool) -> void {
    let dir = slots_dir()
    let _ = exec("mkdir -p '" + dir + "' 2>/dev/null")
    let rows = slots_hosts_list()
    if rows == "" {
        if as_json { println("{\"error\":\"hosts.json read failed\"}") }
        else { println("❌ hosts.json 읽기 실패: " + hosts_registry_path()) }
        return
    }
    let lines = rows.split("\n")
    let mut i = 0
    let mut json_parts = ""
    if as_json {
        json_parts = "{\"ts\":\"" + exec("date -u +%Y-%m-%dT%H:%M:%SZ").trim() + "\",\"dir\":\"" + dir + "\",\"hosts\":["
    } else {
        println("⬡ airgenome slots  (dir=" + dir + ")")
        println("────────────────────────────────────────────────")
        println("host    used / total   stale")
    }
    let mut first = true
    while i < len(lines) {
        let row = lines[i]
        i = i + 1
        if row == "" { continue }
        let parts = row.split("\t")
        if len(parts) < 2 { continue }
        let host = parts[0]
        let kind = parts[1]
        let max_raw = if len(parts) >= 3 { parts[2] } else { "" }
        let cap = if max_raw == "" { host_capacity_default(host, kind) } else { to_int(max_raw) }
        let tsv = slot_counts_tsv(host, cap)
        let uparts = tsv.split("\t")
        let used = if len(uparts) >= 1 { to_int(uparts[0]) } else { 0 }
        let stale = if len(uparts) >= 2 { to_int(uparts[1]) } else { 0 }
        if as_json {
            if !first { json_parts = json_parts + "," }
            first = false
            json_parts = json_parts + "{\"host\":\"" + host + "\",\"used\":" + to_string(used) + ",\"total\":" + to_string(cap) + ",\"stale\":" + to_string(stale) + "}"
        } else {
            let bar = if used >= cap { "FULL" } else if used == 0 { "idle" } else { "    " }
            println("  " + host + "\t" + to_string(used) + " / " + to_string(cap) + "\t   " + to_string(stale) + "\t" + bar)
        }
    }
    if as_json {
        json_parts = json_parts + "]}"
        println(json_parts)
    }
}

fn cmd_slots_reset() -> void {
    let rows = slots_hosts_list()
    if rows == "" { println("❌ hosts.json 읽기 실패"); return }
    let lines = rows.split("\n")
    let mut i = 0
    let mut total_removed = 0
    while i < len(lines) {
        let row = lines[i]
        i = i + 1
        if row == "" { continue }
        let parts = row.split("\t")
        if len(parts) < 2 { continue }
        let host = parts[0]
        let kind = parts[1]
        let max_raw = if len(parts) >= 3 { parts[2] } else { "" }
        let cap = if max_raw == "" { host_capacity_default(host, kind) } else { to_int(max_raw) }
        let removed = slot_reset_host(host, cap)
        if removed > 0 {
            println("[reset] " + host + " — removed " + to_string(removed) + " stale lock(s)")
        }
        total_removed = total_removed + removed
    }
    println("⬡ airgenome slots --reset — removed " + to_string(total_removed) + " stale lock(s)")
}

fn cmd_slots_watch(interval_s: int) -> void {
    let sec = if interval_s < 1 { 5 } else { interval_s }
    let clear_seq = exec("printf '\\033[2J\\033[H'")
    let mut tick = 0
    while true {
        print(clear_seq)
        let ts = exec("date '+%Y-%m-%d %H:%M:%S %Z'").trim()
        println("⬡ airgenome slots watch  " + ts + "  tick=" + to_string(tick) + "  refresh=" + to_string(sec) + "s  (ctrl-C exit)")
        cmd_slots_show(false)
        tick = tick + 1
        let _ = exec("sleep " + to_string(sec))
    }
}

// cmd_doctor — 통합 진단. 문제 있으면 ❌ 마크, 정상이면 ✅.
// 체크: hexa bin / core self-test / launchd health / ring freshness / throttle sanity
fn doctor_check(label: str, ok: bool, detail: str) -> int {
    let mark = if ok { "✅" } else { "❌" }
    println("  " + mark + " " + label + "  " + detail)
    if ok { return 0 } else { return 1 }
}

fn cmd_doctor() -> void {
    println("⬡ airgenome doctor")
    println("")
    let mut fails = 0

    // 1. hexa binary
    let hb = hexa_bin()
    let hb_ok = exec("[ -x '" + hb + "' ] && echo y || echo n").trim() == "y"
    fails = fails + doctor_check("hexa binary", hb_ok, hb)

    // 2. core self-test
    let core_out = exec(hb + " run '" + ag_root() + "/core/test/core_test.hexa' 2>&1 | tail -1").trim()
    let core_ok = core_out == "" || exec("echo '" + core_out + "' | grep -c 'PASS'").trim() != "0"
    fails = fails + doctor_check("core self-test", core_ok, core_out)

    // 3. launchd
    let agent_count = to_int(exec("launchctl list 2>/dev/null | awk '$3 ~ /^com\\.airgenome\\./' | wc -l | tr -d ' '").trim())
    let ld_ok = agent_count > 0
    let ld_detail = to_string(agent_count) + " com.airgenome.* agent(s) loaded"
    fails = fails + doctor_check("launchd", ld_ok, ld_detail)

    // 4. ring freshness — unified/ubu1/htz 중 하나라도 5분 이내 수정이면 OK
    let now = to_int(exec("date +%s").trim())
    let mut freshest = 0
    let rings = ["genomes.ring", "genomes.ubu1.ring", "genomes.htz.ring", "genomes.unified.ring"]
    let mut i = 0
    while i < len(rings) {
        let p = ag_forge() + "/" + rings[i]
        let mt = to_int(exec("stat -f %m '" + p + "' 2>/dev/null || echo 0").trim())
        if mt > freshest { freshest = mt }
        i = i + 1
    }
    let age = now - freshest
    let ring_ok = age < 300
    let ring_detail = "freshest ring age = " + to_string(age) + "s"
    fails = fails + doctor_check("ring freshness", ring_ok, ring_detail)

    // 5. throttle sanity — state 존재 + level != STRESS
    let st = exec("cat '" + ag_ring("predictive_throttle_state.json") + "' 2>/dev/null").trim()
    let lvl = exec("echo '" + st + "' | sed -E 's/.*\"level\":\"([^\"]+)\".*/\\1/'").trim()
    let th_ok = lvl == "CALM" || lvl == "WARM"
    let th_detail = if st == "" { "no state file" } else { "level=" + lvl }
    fails = fails + doctor_check("throttle sanity", th_ok, th_detail)

    println("")
    if fails == 0 {
        println("⬡ all checks passed.")
    } else {
        println("⬡ " + to_string(fails) + " check(s) failed — see ❌ above.")
    }
}

// cmd_cli — 인터랙티브 터미널 TUI. 숫자 입력 → subcommand dispatch. q 로 종료.
fn cli_menu() -> void {
    let clear = exec("printf '\\033[2J\\033[H'")
    print(clear)
    println("⬡ airgenome CLI (interactive)")
    println("")
    println("  1) watch         실시간 HUD")
    println("  2) doctor        통합 진단")
    println("  3) status        한눈에 상태")
    println("  4) self-test     모든 module self-test")
    println("  5) harvest       harvest 1회 (Mac)")
    println("  6) throttle      throttle 1회 실행")
    println("  7) merge         genome_merge 1회")
    println("  8) install       install mac-safe (ring-sync+throttle)")
    println("  9) install-all   install all 7 agents (AG6 주의)")
    println(" 10) uninstall     모든 agent bootout + plist 제거")
    println("  h) help          subcommand 도움말")
    println("  q) quit")
    println("")
}

fn cmd_cli() -> void {
    while true {
        cli_menu()
        let raw = input("choice: ").trim()
        if raw == "q" || raw == "quit" || raw == "exit" { println("bye."); return }
        if raw == "" { continue }

        if raw == "1" { cmd_watch(2); return }  // watch 는 자체 loop — 복귀 X
        if raw == "2" { cmd_doctor() }
        else if raw == "3" { cmd_status() }
        else if raw == "4" { cmd_self_test_all() }
        else if raw == "5" { let _ = run_module("harvest") }
        else if raw == "6" { let _ = run_module("predictive_throttle") }
        else if raw == "7" { let _ = run_module("genome_merge") }
        else if raw == "8" { cmd_install("mac-safe") }
        else if raw == "9" { cmd_install("all") }
        else if raw == "10" { cmd_uninstall() }
        else if raw == "h" || raw == "help" { print_help() }
        else { println("❔ unknown: '" + raw + "' — q 로 종료") }

        println("")
        let _ = input("(press Enter to return to menu) ")
    }
}

// cmd_watch — terminal HUD. compact multi-block view refreshed every `sec` seconds.
// menubar 의 90% 효과 (실시간 visibility) 를 hexa-only 로 제공.
// 표시: load / throttle pred+level / launchd agents / ring counts with Δ / last 3 history
fn ring_count(path: str) -> int {
    let out = exec("wc -l '" + path + "' 2>/dev/null | awk '{print $1}'").trim()
    if out == "" { return 0 }
    return to_int(out)
}

fn cmd_watch(interval_s: int) -> void {
    let sec = if interval_s < 1 { 2 } else { interval_s }
    let sleep_cmd = "sleep " + to_string(sec)
    let clear_seq = exec("printf '\\033[2J\\033[H'")
    let fd = ag_forge()
    let r_mac = fd + "/genomes.ring"
    let r_ubu = fd + "/genomes.ubu1.ring"
    let r_htz = fd + "/genomes.htz.ring"
    let r_uni = fd + "/genomes.unified.ring"
    let mut prev_mac = ring_count(r_mac)
    let mut prev_ubu = ring_count(r_ubu)
    let mut prev_htz = ring_count(r_htz)
    let mut prev_uni = ring_count(r_uni)
    let mut tick = 0
    while true {
        print(clear_seq)
        let ts = exec("date '+%Y-%m-%d %H:%M:%S %Z'").trim()
        let load = exec("uptime | sed 's/.*load average[s]*: //'").trim()
        println("⬡ airgenome watch  " + ts + "  tick=" + to_string(tick) + "  refresh=" + to_string(sec) + "s  (ctrl-C exit)")
        println("────────────────────────────────────────────────────────────────")
        println("Load:        " + load)

        // Throttle state + last level
        let st_raw = exec("cat '" + ag_ring("predictive_throttle_state.json") + "' 2>/dev/null").trim()
        if st_raw == "" {
            println("Throttle:    (no state — not yet run)")
        } else {
            let lvl = exec("echo '" + st_raw + "' | sed -E 's/.*\"level\":\"([^\"]+)\".*/\\1/'").trim()
            let pcpu = exec("echo '" + st_raw + "' | sed -E 's/.*\"pred_cpu\":([0-9]+).*/\\1/'").trim()
            let pram = exec("echo '" + st_raw + "' | sed -E 's/.*\"pred_ram\":([0-9]+).*/\\1/'").trim()
            let act = exec("echo '" + st_raw + "' | sed -E 's/.*\"action\":\"([^\"]+)\".*/\\1/'").trim()
            println("Throttle:    level=" + lvl + "  pred cpu=" + pcpu + "%  ram=" + pram + "%  action=" + act)
        }

        println("")
        println("Agents (launchd):")
        let agents = exec("launchctl list 2>/dev/null | awk '$3 ~ /^com\\.airgenome\\./{printf \"  %-36s pid=%-8s rc=%s\\n\", $3, $1, $2}'")
        if agents.trim() == "" { println("  (none)") } else { print(agents) }

        println("")
        let c_mac = ring_count(r_mac)
        let c_ubu = ring_count(r_ubu)
        let c_htz = ring_count(r_htz)
        let c_uni = ring_count(r_uni)
        println("Rings (entries, Δ since last tick):")
        println("  mac      " + to_string(c_mac) + "\t(Δ " + to_string(c_mac - prev_mac) + ")")
        println("  ubu1     " + to_string(c_ubu) + "\t(Δ " + to_string(c_ubu - prev_ubu) + ")")
        println("  htz      " + to_string(c_htz) + "\t(Δ " + to_string(c_htz - prev_htz) + ")")
        println("  unified  " + to_string(c_uni) + "\t(Δ " + to_string(c_uni - prev_uni) + ")")

        println("")
        println("Throttle history (last 3):")
        let hist = exec("tail -3 '" + ag_ring("throttle_history.jsonl") + "' 2>/dev/null | sed 's/^/  /'")
        if hist.trim() == "" { println("  (no history)") } else { print(hist) }

        prev_mac = c_mac
        prev_ubu = c_ubu
        prev_htz = c_htz
        prev_uni = c_uni
        tick = tick + 1
        let _ = exec(sleep_cmd)
    }
}

// print_help — 카테고리 그루핑 + 1줄 설명.
// 상세 도움말은 `airgenome help <sub>` 로 dispatch.
fn print_help() -> void {
    println("airgenome — OS hexagon genome scanner + distributed Claude dispatcher")
    println("")
    println("usage: airgenome <subcommand> [args...]")
    println("       airgenome help <subcommand>   — 상세 도움말")
    println("")
    println("GENOME PIPELINE")
    println("  harvest                  /proc 스캔 → forge/genomes.ring append (Mac 금지, ubu1/htz)")
    println("  label                    anomaly label 부여 (labeled_anomaly.jsonl)")
    println("  merge                    genomes.{mac,ubu1,htz} → genomes.unified.ring")
    println("  forecast                 Holt's linear 1-step 예측 (forge/forecast_state.json)")
    println("  forecast-eval            held-out MAE 평가 (forge/forecast_eval_report.json)")
    println("")
    println("INFRA / DISPATCH")
    println("  probe                    infra_state.json 갱신 (vitals + blowup 감지)")
    println("  dispatch                 AG7 load balancer — best_host 계산 → dispatch_state.json")
    println("  claude-route <sub>       AI Claude 호스트 선택 (select|record|self-test)")
    println("  worker <sub>             분산 Claude 워커 (run|spawn|list|stop|status|dispatch)")
    println("  throttle                 Mac 자가보호 — predictive_throttle (AG6)")
    println("  session-snapshot <sub>   명령 레벨 snapshot/resume (list|save|tick|end|resume)")
    println("  session-defaults <sub>   .session_defaults SSOT 진단/강제 (show|status|doctor|verify|sync)")
    println("")
    println("OBSERVABILITY")
    println("  status [--json]          3-host 통합 상태 (uptime/load/docker/runaway/dispatch)")
    println("  doctor                   통합 진단 (hexa/core/launchd/ring/throttle)")
    println("  watch [sec]              터미널 HUD — 초단위 refresh (기본 2s)")
    println("  slots [--reset|--watch]  bin/cx per-host claude slot 상태")
    println("  dashboard                forge/dashboard.html 정적 페이지 생성")
    println("  logs [agent] [N]         ~/.airgenome/*.log 최근 tail (기본 all, N=20)")
    println("  cli                      인터랙티브 TUI — 숫자 선택 dispatch")
    println("")
    println("PROTECTION / BOT")
    println("  runaway-guard [sub]      ubu1 폭주 감지/대응 (self-test|run-once|loop)")
    println("  tg-bot                   Telegram bot (iOS → claude dispatcher, M15)")
    println("  agent-run --prompt=...   F7 AGENT_DIST — dispatch best host 로 prompt ssh 래핑 (기본 dry-run)")
    println("")
    println("DEPLOY / LIFECYCLE")
    println("  init [--target=T] [--dry-run]  수작업 없는 완정성 배포 (mac/ubu1/ubu2/htz/all)")
    println("  deploy [sub]             전 hosts 에 stack 배포 (self-test|status|verify)")
    println("  install-agents [sub]     AG6-safe LaunchAgent 설치 (mac-safe 기본)")
    println("  install [mode]           legacy install (mode=all|mac-safe, 권장: install-agents)")
    println("  uninstall                모든 com.airgenome.* LaunchAgent 제거")
    println("  self-test                모든 module self-test 일괄")
    println("  build-menubar            bin/menubar.hexa → native binary")
    println("  menubar                  Mac menubar 실행 (built binary 필요)")
    println("")
    println("REMOTE / META")
    println("  remote <host> <sub>      ubu1/htz 원격 airgenome subcommand 실행")
    println("  help [sub]               이 도움말 — sub 지정시 상세")
    println("")
    println("EXTERNAL TOOLS (bash, PATH=$AIRGENOME/bin)")
    println("  cx [args]                Claude CLI router (ubu1/ubu2 우선, docker-ssh 기본)")
    println("  cx-core <mode> [args]    L0 minimal Claude exec primitive (local|remote|self-test, probe/slot 0)")
    println("  tg_bot-core <sub>        L0 minimal Telegram bot primitive (run|send|self-test, hexa/claudx 의존 0)")
    println("  claudx [args]            limit-resilient Claude launcher (12 account pool)")
    println("  claudx-observe           rotation/usage 실시간 추적")
    println("  enq <kind> -- <cmd>      AI-native queue frontend (compute|heavy|gpu slots)")
    println("  host_list [--json|...]   hosts.json SSOT 조회 (enabled/remote/ssh/display)")
    println("  container_manage <sub>   docker compose wrapper (status|start|logs|exec|pull)")
    println("  rtt_probe <host>         keystroke RTT 측정 (menubar V6 + cx auto-switch)")
    println("  stability_monitor        Mac tick-based 감시자 (claude 절대 보호)")
    println("  hexa_heal [check|heal]   hexa_real binary drift 감지/복구 (ubu1 golden)")
    println("  airgenome-logs <sub>     통합 로그 tail/grep/rotate (~/.airgenome/*.log)")
    println("  airgenome-build          daily docker image build (htz timer)")
    println("  airgenome-claude-run     docker run for airgenome-claude service (직접 호출 X)")
    println("")
    println("ENV")
    println("  AIRGENOME_ROOT           기본 $HOME/Dev/airgenome")
    println("  AIRGENOME_RING_NAME      기본 genomes.ring (unified 시 genomes.unified.ring)")
    println("  AIRGENOME_DISPATCH_ROOT  worker queue 디렉토리 override")
    println("  CLAUDX_STATE             기본 ~/.airgenome (slot/rotation state)")
    println("  CX_PICK_MODE             score|priority|priority_fallback (기본 score)")
}

// print_help_sub — 특정 subcommand 의 상세 도움말.
// SSOT 정책: 모듈 파일 상단 주석이 있으면 그걸 표시, 없으면 1줄 요약 반복.
fn print_help_sub(sub: str) -> void {
    // 카탈로그 — one-liner + source path
    if sub == "harvest" {
        println("airgenome harvest — /proc 스캔해 호스트 hexagon genome 을 ring 에 append")
        println("  source: modules/harvest.hexa")
        println("  출력:   forge/genomes.ring (호스트별)")
        println("  주의:   Mac 금지 (AG6) — ubu1/htz 에서만 timer 로 실행")
        return
    }
    if sub == "label" {
        println("airgenome label — genomes.ring 의 최근 anomaly 에 라벨 부여")
        println("  source: modules/label.hexa")
        println("  출력:   forge/labeled_anomaly.jsonl")
        return
    }
    if sub == "merge" {
        println("airgenome merge — genomes.{mac,ubu1,htz}.ring → genomes.unified.ring")
        println("  source: modules/genome_merge.hexa")
        println("  호출:   ring-sync timer 직후 실행")
        return
    }
    if sub == "forecast" {
        println("airgenome forecast — Holt's linear 1-step ahead 예측 (CPU/RAM)")
        println("  source: modules/forecast.hexa")
        println("  출력:   forge/forecast_state.json")
        return
    }
    if sub == "forecast-eval" {
        println("airgenome forecast-eval — held-out MAE 평가")
        println("  source: modules/forecast_eval.hexa")
        println("  출력:   forge/forecast_eval_report.json (pass=avg_mae<15)")
        return
    }
    if sub == "probe" {
        println("airgenome probe — host vitals + blowup 감지")
        println("  source: modules/probe.hexa")
        println("  출력:   $NEXUS/shared/infra_state.json")
        return
    }
    if sub == "dispatch" {
        println("airgenome dispatch — AG7 load balancer, best_host 계산")
        println("  source: modules/dispatch.hexa")
        println("  출력:   $NEXUS/shared/dispatch_state.json")
        return
    }
    if sub == "claude-route" {
        println("airgenome claude-route <select|record|self-test>")
        println("  source: modules/claude_route.hexa")
        println("  select:    best claude host name 을 stdout 단일 라인")
        println("  record:    <host> <duration_s> <exit> <rtt_ms> — claude_genome.jsonl append")
        return
    }
    if sub == "worker" {
        println("airgenome worker <run|spawn|list|stop|status|dispatch>")
        println("  source: modules/worker.hexa (queue: modules/worker_queue.hexa)")
        println("  dispatch -p <prompt> [--host X] [--account claudeN] [--timeout N]")
        println("  spawn <host> [--count N]          N 워커 원격 기동 (ssh)")
        println("  run --id <wid> --host <host>      단일 워커 루프 (내부용)")
        println("  env:    AIRGENOME_DISPATCH_ROOT=~/.airgenome/dispatch")
        return
    }
    if sub == "throttle" {
        println("airgenome throttle — Mac predictive_throttle 1회 실행")
        println("  source: modules/predictive_throttle.hexa")
        println("  출력:   forge/predictive_throttle_state.json + throttle_history.jsonl")
        return
    }
    if sub == "session-snapshot" {
        println("airgenome session-snapshot <list|save|tick|end|show|resume|gc>")
