// hooks/user_prompt.hexa — UserPromptSubmit handler
//
// Responsibility: keyword-match on user prompt, emit systemMessage on risky patterns.
// Deterministic regex/contains — no LLM. Never blocks (observability only).
//
// Matched keywords (literal contains, case-insensitive via lowercase compare):
//   "rm -rf /"     → warn (irreversible fs delete)
//   "force push"   → warn (history rewrite)
//   "secrets"      → hint (consider env/secret manager)
//
// Pattern list is local to this file — add/remove freely without touching dispatcher.

use "lib/event"

struct KwRule {
    needle: str
    level: str   // "warn" | "hint"
    advice: str
}

fn rules() -> [KwRule] {
    return [
        KwRule { needle: "rm -rf /",   level: "warn", advice: "irreversible filesystem delete detected in prompt — double-check target path" },
        KwRule { needle: "force push", level: "warn", advice: "force-push requested — confirm branch is not shared and history rewrite is intended" },
        KwRule { needle: "secrets",    level: "hint", advice: "prompt mentions secrets — prefer env vars / secret manager over inline values" }
    ]
}

// In-process entry for hook_main dispatcher. See universal_audit.hexa notes.
pub fn user_prompt_entry(p: str) -> str {
    let prompt = event_prompt(p).to_lower()
    let rs = rules()
    let mut i = 0
    while i < rs.len() {
        let r = rs[i]
        if prompt.contains(r.needle) {
            return system_message_json("[" + r.level + "] " + r.advice)
        }
        i = i + 1
    }
    return allow_json()
}

fn main() -> void {
    let raw = read_event_json()
    let p = dump_json(raw)
    let out = user_prompt_entry(p)
    let _ = exec("rm -f '" + p + "'")
    println(out)
    exit(0)
}
