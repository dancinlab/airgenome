// install.hexa — hx build hook for airgenome.
//
// Invoked by `hx install airgenome` (hexa-lang package manager) right
// after the GitHub checkout lands in $HX_PKG_DIR. hx passes:
//   HX_PKG_DIR   — absolute path to the checked-out package root
//
// Responsibility: build + deploy the native airgenome.app menubar tap.
//   - cd native && make install
//   - clang → build/airgenome → codesign + bundle → /Applications/airgenome.app
//   - launchctl bootout + bootstrap com.airgenome.tap
//     (hx install = explicit user consent for the bootstrap)
//
// After this hook returns, hx generates the $HX_BIN_DIR/airgenome shim
// from run.hexa, so `airgenome <cmd>` works immediately.

fn main() -> void {
    let mut root = env("HX_PKG_DIR")
    if root == "" { root = exec("pwd").trim() }
    println("[airgenome/install] HX_PKG_DIR=" + root)

    let native_dir = root + "/native"
    if file_exists(native_dir + "/Makefile") == false {
        println("[airgenome/install] ERROR: native/Makefile not found — aborting")
        exit(1)
    }

    println("[airgenome/install] building + installing airgenome.app ...")
    let native_out = exec("cd '" + native_dir + "' && make install 2>&1")
    println(native_out.trim())

    // make install exposes the launchctl bootstrap exit code but it does not
    // surface cleanly through exec(); verify by artifact existence instead.
    let app_bin = "/Applications/airgenome.app/Contents/MacOS/airgenome"
    let plist  = env("HOME") + "/Library/LaunchAgents/com.airgenome.tap.plist"
    if file_exists(app_bin) == false {
        println("[airgenome/install] ERROR: " + app_bin + " missing post-install")
        exit(1)
    }
    if file_exists(plist) == false {
        println("[airgenome/install] ERROR: " + plist + " missing post-install")
        exit(1)
    }

    // hush — macOS load mitigations (single source of truth: bin/airgenome cmd_hush).
    // Idempotent; same call used by `airgenome init`.
    println("[airgenome/install] running hush mitigations ...")
    let hush_out = exec("'" + root + "/bin/airgenome' hush 2>&1")
    println(hush_out.trim())

    println("[airgenome/install] done — airgenome.app tap installed + bootstrapped")
}
